tent":"import sys, csv, numpy as np\nD = \"$WSROOT/laya/s1/opus-r2/step1\"\nW = sys.argv[1]\nsys.path.insert(0, D); import scorer as s, msgs\nS = s.load(D + \"/scorer_in.npz\")\nld = lambda n: np.load(f\"{W}/{n}.npz\")[\"M\"]\nPP, PN = ld(\"pair_pos\"), ld(\"pair_neg\")\nE = np.load(D + \"/evidence_M.npz\")[\"M\"]\nrows = list(csv.DictReader(open(D + \"/evidence.csv\"), delimiter=\"\\t\"))\nsets = [(\"EV\", E, [r[\"text\"] for r in rows])] + [(n, ld(n.lower()), getattr(msgs, n)) for n in [\"POS\", \"NEG\", \"DISP\", \"PAIR_FEE\"]]\nZ = {}\nfor opt in [3, 1]:\n    d = (PP[:, opt] - PN[:, opt]).mean(0); c = ((PP[:, opt] + PN[:, opt]) / 2).mean(0)\n    sd = ((PP[:, opt] - c) @ d).std()\n    Z[opt] = lambda X, d=d, c=c, sd=sd, opt=opt: (X[:, opt] - c) @ d / sd\nfor nm, X, T in sets:\n    L = s.logits(S, X); gap = L[:, 1] - L[:, 3]; pred = s.predict(S, X)\n    for t, z3, z1, g, p in zip(T, Z[3](X), Z[1](X), gap, pred):\n        print(f\"{nm:8s} z3={z3:5.2f} z1={z1:5.2f} gap(disp-fx)={g:5.2f} {p:16s} {t[:60]}\")\n"}}}
