ean(0),\n        \"rate-fee\": (PP[:, opt] - PF[:, opt]).mean(0),\n        \"both\": (2 * PP[:, opt] - PN[:, opt] - PF[:, opt]).mean(0),\n        \"pos-negpool\": POSB[:, opt].mean(0) - NEGB[:, opt].mean(0),\n    }\n    for k, d in cands.items():\n        d = d / np.linalg.norm(d)\n        a, b = POSB[:, opt] @ d, NEGB[:, opt] @ d\n        ea, eb = EP[:, opt] @ d, EN[:, opt] @ d\n        print(opt, f\"{k:12s} build pos[min,p10]={a.min():.0f},{np.percentile(a,10):.0f} neg[p90,max]={np.percentile(b,90):.0f},{b.max():.0f} | ev pos min={ea.min():.0f} ev neg max={eb.max():.0f}\")\n","structuredPatch":[{"oldStart":3,"oldLines":10,"newStart":3,"newLines":15,"lines":[" W = sys.argv[1]"," sys.path.insert(0, D); import scorer as s"," S = s.load(D + \"/scorer_in.npz\")","+MODE = int(sys.argv[2])","+ln = lambda X: (X - X.mean(-1, keepdims=True)) / X.std(-1, keepdims=True) * (S[\"ln_w\"] if MODE == 2 else 1) if MODE else X"," ld = lambda n: np.load(f\"{W}/{n}.npz\")[\"M\"]"," PP, PN, PF, P, N, DS = ld(\"pair_pos\"), ld(\"pair_neg\"), ld(\"pair_fee\"), ld(\"pos\"), ld(\"neg\"), ld(\"disp\")"," E = np.load(D + \"/evidence_M.npz\")[\"M\"]"," nf = lambda X: X[np.array(s.predict(S, X)) != \"fees_fx\"]","+N, E = nf(N), np.concatenate([E[:16], nf(E[16:])])","+nf = lambda X: X","+PP, PN, PF, P, N, DS, E = map(ln, (PP, PN, PF, P, N, DS, E))"," # my own sets only for building; evidence only for checking"," POSB = np.concatenate([PP, P]); NEGB = np.concatenate([PN, nf(N), DS])"," EP, EN = E[:16], nf(E[16:])"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01JJ3kzRWXgkKT2sU9neuvWJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
