e%d' % j, w, pinP[:, 0])\nw = resid(Vc[:TK], pinP[:, 0].mean(0) - allN[:, 0].mean(0)); add('topic', w, pinP[:, 0])\nw = resid(Vc[:CK], (Mp[[0, 2], :, 0].mean(0) - Mp[3:6, :, 0].mean(0)).mean(0)); add('pin_vs_pass', w, pinP[:, 0])\n\nS = sc.load(D + '/scorer_in.npz')\nW0o, b0o, W1o, b1o, W2o, b2o = (S[k] for k in ['extra_W0', 'extra_b0', 'extra_W1', 'extra_b1', 'extra_W2', 'extra_b2'])\nnw, nb = [], []\nfor _, w, lo, hi in conds:   # clip((x@w - lo)/(hi-lo), 0, 1) = relu(t) - relu(t-1)\n    s = 1.0 / (hi - lo); nw += [w * s, w * s]; nb += [-lo * s, -lo * s - 1]\nW0 = np.concatenate([W0o, np.stack(nw, 1)], 1).astype(np.float32); b0 = np.concatenate([b0o, nb]).astype(np.float32)\nW1 = np.zeros((W0.shape[1], 2), np.float32); W1[:10, 0] = W1o[:, 0]; W1[10:, 1] = [1, -1] * len(conds)\nb1 = np.array([b1o[0], -(len(conds) - 1)], np.float32)\nW2 = np.array([[W2o[0, 0]], [BONUS]], np.float32)\nT = dict(S); T.update(extra_W0=W0, extra_b0=b0, extra_W1=W1, extra_b1=b1, extra_W2=W2, extra_b2=b2o.copy())\nsc.save(T, OUT)\n\ndef report(name, M, want=None):\n    a, b = sc.predict(S, M), sc.predict(T, M)\n    if want: print('%-10s -> cards: before %d after %d / %d' % (name, sum(x == want for x in a), sum(x == want for x in b), len(M)))\n    else: print('%-10s changed %d / %d' % (name, sum(x != y for x, y in zip(a, b)), len(M)), [(i, x, y) for i, (x, y) in enumerate(zip(a, b)) if x != y][:8])\nreport('mine P', P, 'cards'); report('mine N', N); report('pairs pass', passN); report('pairs other', Mp[3:].reshape(-1, 5, 1024))\nh = np.load('held.npz'); report('HELD P', h['P'], 'cards'); report('HELD N', h['N'])\nE = np.load(D + '/evidence_M.npz')['M']; rows = list(csv.DictReader(open(D + '/evidence.csv'), delimiter='\\t'))\npb, pa = sc.predict(S, E), sc.predict(T, E)\nprint('EVIDENCE acc before %d after %d / 32' % (sum(p == r['correct'] for p, r in zip(pb, rows)), sum(p == r['correct'] for p, r in zip(pa, rows))))\n"}}}
