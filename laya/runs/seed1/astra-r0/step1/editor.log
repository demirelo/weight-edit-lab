report={'base_arrays_unchanged':True,'finite_arrays':True,'checks':{}}
for file,count in [('design_M.npz',16),('paired_M.npz',16),('coverage_M.npz',64),('style_M.npz',48),('evidence_M.npz',16),('validation_M.npz',20)]:
