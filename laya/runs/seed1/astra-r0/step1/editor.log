\"\"\"Compile a fixed nearest-reference rule into affine/ReLU layers. No fitting.\"\"\"
import numpy as np
from scorer import load,save
s=load('scorer_in.npz')
d=np.load('final_directions.npz');p=d['pos'];n=d['neg']
layers=[]
# A shared positive offset makes the ReLU max tree exact for marker projections
# above -1000. It cancels in the final positive-minus-negative comparison.
w=np.concatenate([p,n]).T
layers.append((w,np.full(w.shape[1],1000.0)))
identity=np.eye(w.shape[1])
groups=[list(identity[:len(p)]),list(identity[len(p):])]
width=w.shape[1]
while any(len(g)>1 for g in groups):
 columns=[];spec=[]
 for group in groups:
  entries=[]
  for i in range(0,len(group),2):
   if i+1<len(group):
    j=len(columns);columns.extend([group[i]-group[i+1],group[i+1]])
    entries.append([j,j+1])
   else:
    j=len(columns);columns.append(group[i]);entries.append([j])
  spec.append(entries)
 matrix=np.stack(columns,axis=1)
 layers.append((matrix,np.zeros(matrix.shape[1])))
 width=matrix.shape[1]
 groups=[]
 for entries in spec:
  group=[]
  for indices in entries:
   expr=np.zeros(width);expr[indices]=1;group.append(expr)
  groups.append(group)
# Fixed maximum correction: six logits, with slope eight at the gate.
contrast=8.0*(groups[0][0]-groups[1][0])
layers.append((np.stack([contrast,contrast],axis=1),np.array([0.0,-6.0])))
layers.append((np.array([[1.0],[-1.0]]),np.array([0.0])))
for i,(w,b) in enumerate(layers):s[f'extra_W{i}']=w;s[f'extra_b{i}']=b
save(s,'scorer_out.npz')
print('Saved scorer_out.npz;',len(layers),'extra layers;',sum(w.size+b.size for w,b in layers),'extra scalars')
