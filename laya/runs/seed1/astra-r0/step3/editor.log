import json, subprocess
positive = {
'age': [
'What is the minimum age for opening a bank account with you?',
'I am seventeen years old. Am I eligible to register?',
'Can someone under eighteen become a customer?',
'Is there an upper age restriction on joining your service?',
'Can my teenage daughter have her own account?',
'I want to create an account for my ten year old son.',
'Are minors allowed to use your banking app?',
'At what age can a child apply for your card?',
'Would a sixteen year old qualify for an account?',
'Do you provide banking services for young children?',
],
'country': [
'In which countries can people sign up for your service?',
'I reside in Canada. Can I become a customer?',
'Can a person living outside Britain register for an account?',
'Are your accounts available to residents of Australia?',
'Can I apply for a card if my home address is in the United States?',
'Which nationalities are eligible to open an account?',
'Is your service available worldwide?',
'Which regions do you operate in?',
'Where is your banking service offered?',
'Are people in India allowed to join?',
'I am a nonresident. May I open an account with you?',
'Can I register if I live in Switzerland?',
'Are there any countries where your service is unavailable?',
'Can I get your card if I am based abroad?',
'Where are your branches located?',
'Does your service work in every country?',
]}
controls = [
'I need to order a new debit card.',
'How do I activate the card that arrived today?',
'Can you deliver my card to Canada?',
'How long does international express card delivery take?',
'Where is the replacement card I ordered last week?',
'How can I create a virtual card?',
'I want another disposable card for shopping online.',
'What shops accept your card?',
'Can I use my card at an ATM in Japan?',
'Will my card work when I travel overseas?',
'Can I pay online with this card?',
'How do I add my card to Apple Pay?',
'What is the maximum amount I can pay with my card?',
'When will my card expire?',
'Why has my contactless payment stopped working?',
'I need to change my card PIN.',
'I forgot the PIN for my debit card.',
'My card PIN is blocked after three wrong attempts.',
'Where can I find my card PIN in the app?',
'How can I unblock the PIN on my card?',
'The exchange rate on my card purchase was wrong.',
'The cash machine withdrawal used a bad exchange rate.',
'I paid in euros but the conversion rate is incorrect.',
'The amount looks wrong because the ATM used the wrong currency conversion rate.',
'Why did you use such a poor exchange rate for my debit card payment?',
'Which currencies do you support?',
'Can I exchange dollars into pounds?',
'What fee do you charge for a transfer?',
'I do not recognise this card payment.',
'The restaurant charged my card twice.',
'Why was my cash withdrawal declined?',
'I am still waiting for a refund.',
'I sent money to a friend but it has not arrived.',
'Can I transfer money to a bank in India?',
'What countries can I send a bank transfer to?',
'I deposited money but my balance has not changed.',
'How can I top up by debit card?',
'I need to verify my identity.',
'What documents can I use as proof of identity?',
'How do I update my country of residence?',
'I want to close my account.',
'I forgot my app passcode.',
'My phone has been stolen.',
'Can I change the name on my account?',
'How many bank accounts can I have?',
'How do I open a second currency account?',
]
rows = [{'group':g,'text':t} for g, ts in positive.items() for t in ts] + [{'group':'control','text':t} for t in controls]
json.dump(rows,open('own_messages.json','w'),indent=2)
subprocess.run(['<lab>/.venv/bin/python','embed.py','own_M.npz',*[r['text'] for r in rows]],check=True)
