 b=-.5*(X[:,4]+X[:,j]).mean(0)@w
 print('j',j,'own acc quantiles',np.percentile(X[:,4]@w+b,[0,10,50,90,100]),'other',np.percentile(X[:,j]@w+b,[0,10,50,90,100]))
 print('ev',np.round(Y@w+b,1));print('val',np.round((Z@w+b)[:20],1))
