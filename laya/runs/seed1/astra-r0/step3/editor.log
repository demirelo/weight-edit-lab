import numpy as np
from build_edit import design
S,U,c,P,N=design();M=np.concatenate([np.load(f'{n}_M.npz')['M'] for n in ['own','more','final']]).astype(float);E=np.load('evidence_M.npz')['M'];V=np.load('validation_M.npz')['M'];X=M@U;Y=E@U;Z=V@U
