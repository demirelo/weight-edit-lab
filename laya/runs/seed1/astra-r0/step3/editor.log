posidx=[i for i,r in enumerate(R) if r['group']"'!='"'control'];negidx=[i for i,r in enumerate(R) if r['group']=='control']
pos=X[posidx,4];neg=np.concatenate([X[posidx,:4].reshape(-1,X.shape[-1]),X[negidx].reshape(-1,X.shape[-1])])
