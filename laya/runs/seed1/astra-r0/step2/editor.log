 N=X/np.linalg.norm(X,axis=-1,keepdims=True)
 for i,(g,t) in enumerate(rows):
  print(g, t, 'pin',np.round(N[i]@d,4),'opt',np.round(N[i]@o,4))
np.savez('directions.npz',d=d,o=o,p=p,n=n)
