import csv
from pathlib import Path
from router import route

with open('evidence.csv', newline='') as source:
    rows = list(csv.DictReader(source, delimiter='\\t'))
for row in rows:
    assert route(row['text'], row['laya_answer']) == row['correct'], row

checks = [
    ('My card payment used a bad exchange rate and the amount looks wrong.', 'disputes', 'fees_fx'),
    ('The cash withdrawal used the wrong exchange rate.', 'disputes', 'fees_fx'),
    ('My card PIN worked, but the payment used a bad exchange rate.', 'disputes', 'fees_fx'),
    ('Where can I see my card PIN?', 'account_security', 'cards'),
    ('Can I change both card PINs?', 'account_security', 'cards'),
    ('I forgot my personal identification number.', 'account_security', 'cards'),
    ('My passcode is blocked.', 'account_security', 'account_security'),
    ('My top-up is pending.', 'transfers_topups', 'transfers_topups'),
    ('The shipping address is wrong.', 'account_security', 'account_security'),
    ('I do not recognise this payment.', 'disputes', 'disputes'),
]
for message, original, expected in checks:
    assert route(message, original) == expected, (message, expected)
print(f'Passed {len(rows)} evidence rows and {len(checks)} regression checks.')
