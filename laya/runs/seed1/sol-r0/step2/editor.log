\"\"\"Construct a fixed geometric PIN correction. No optimization or data fitting.\"\"\"
import json
from pathlib import Path
import numpy as np
from scorer import load, save

S=load('scorer_in.npz')
# Recover the inherited module's affine leaves. Its first three channels are
# ReLU(a-b), ReLU(b), ReLU(-b). No example vectors enter this decomposition.
W=S['extra_W0'].astype(np.float64);b=S['extra_b0'].astype(np.float64)
A=np.empty((1024,2*(W.shape[1]//3)),dtype=np.float64)
A[:,0::2]=W[:,0::3]+W[:,1::3]
A[:,1::2]=W[:,1::3]
U,s,_=np.linalg.svd(A,full_matrices=False)
# Bound the gain of inherited feature directions at one. Small singular
# directions carry the very large shared marker components, which this filters.
T=U*(s/(s+1.0))
D=json.loads(Path('bank.json').read_text())
M=np.load('bank_M.npz')['M'].astype(np.float64)
npin=len(D['pin'])
F=M@T
P=F[:npin,0]
N=np.concatenate([F[:npin,1:].reshape(-1,1024),F[npin:].reshape(-1,1024)])
# Each affine score is x dot p - ||p||"'^2/2 in this fixed feature space.
# Comparing maxima cancels the common -||x||''^2/2 term in squared distance.
leaves=[(T@P.T,-np.sum(P*P,axis=-1)/2),
        (T@N.T,-np.sum(N*N,axis=-1)/2)]

new=[]
counts=[]
cols=[];biases=[]
for w,bias in leaves:
 count=w.shape[1];counts.append((count+1)//2)
 for j in range(0,count,2):
  if j+1<count:
   wa,wb=w[:,j],w[:,j+1];ba,bb=bias[j],bias[j+1]
   cols.extend([wa-wb,wb,-wb]);biases.extend([ba-bb,bb,-bb])
  else:
   cols.extend([np.zeros(1024),w[:,j],-w[:,j]])
   biases.extend([0,bias[j],-bias[j]])
new.append((np.stack(cols,axis=1),np.array(biases)))
decode=np.array([1.,1.,-1.])
while max(counts)>1:
 next_counts=[(n+1)//2 for n in counts]
 w=np.zeros((3*sum(counts),3*sum(next_counts)))
 inbase=outbase=0
 for count,nnext in zip(counts,next_counts):
  for k,j in enumerate(range(0,count,2)):
   ia=inbase+3*j;out=outbase+3*k
   if j+1<count:
    ib=ia+3
    w[ia:ia+3,out]=decode
    w[ib:ib+3,out]=-decode
    w[ib:ib+3,out+1]=decode
    w[ib:ib+3,out+2]=-decode
   else:
    w[ia:ia+3,out+1]=decode
    w[ia:ia+3,out+2]=-decode
  inbase+=3*count;outbase+=3*nnext
 new.append((w,np.zeros(w.shape[1])))
 counts=next_counts
# Positive margin at the exact nearest-template bisector activates the gate.
# A four-unit margin reaches the fixed eight-logit cap.
width=4.;boost=8.
gap=np.concatenate([decode,-decode])/width
new.append((np.stack([gap,gap],axis=1),np.array([0.,-1.])))
new.append((np.array([[boost],[-boost]]),np.zeros(1)))
old_count=sum(k.startswith('"'extra_W') for k in S)
assert len(new)==old_count,(len(new),old_count)
O={k:v.copy() for k,v in S.items() if not k.startswith('extra_')}
old_shapes=[];new_shapes=[]
for i,(nw,nb) in enumerate(new):
 ow=S[f'extra_W{i}'];ob=S[f'extra_b{i}']
 nw=nw.astype(np.float32);nb=nb.astype(np.float32)
 old_shapes.append(list(ow.shape));new_shapes.append(list(nw.shape))
 if i==0:
  cw=np.concatenate([ow,nw],axis=1);cb=np.concatenate([ob,nb])
 elif i==len(new)-1:
  cw=np.concatenate([ow,nw],axis=0);cb=ob+nb
 else:
  cw=np.zeros((ow.shape[0]+nw.shape[0],ow.shape[1]+nw.shape[1]),dtype=np.float32)
  cw[:ow.shape[0],:ow.shape[1]]=ow
  cw[ow.shape[0]:,ow.shape[1]:]=nw
  cb=np.concatenate([ob,nb])
 O[f'extra_W{i}']=cw;O[f'extra_b{i}']=cb
save(O,'scorer_out.npz')
Path('build_metadata.json').write_text(json.dumps({'pin_templates':len(P),'negative_templates':len(N),'old_shapes':old_shapes,'new_shapes':new_shapes,'margin_width':width,'logit_cap':boost},indent=2))
print('wrote scorer_out.npz',Path('scorer_out.npz').stat().st_size,'bytes')
