import numpy as np
from scorer import *
D=np.load('weight_spectrum.npz');T=D['U']*(D['s']/(D['s']+1));C=np.load('bank_M.npz')['M'].astype('f8')@T;V=np.load('variants_M.npz')['M'].astype('f8')@T
# Same authored sentences, same intent, only PIN wording or capitalization changes.
# Remove these explicitly chosen style-change mean directions analytically.
Q=[]
for F in [C[60:120],C[120:180],V[:60],V[60:120]]:
 for j in range(5):
  d=F[:,j].mean(0)-C[:60,j].mean(0)
  for q in Q:d-=q*(d@q)
  Q.append(d/np.linalg.norm(d))
Q=np.stack(Q,axis=1);T=T-(T@Q)@Q.T
B=np.load('final_templates.npz');P=B['P'].astype('f8')@T;N=B['N'].astype('f8')@T;p=P[:,0];n=np.concatenate([P[:,1:].reshape(-1,1024),N.reshape(-1,1024)])
def gap(X):
 f=X@T;return (f@p.T-(p*p).sum(-1)/2).max(-1)-(f@n.T-(n*n).sum(-1)/2).max(-1)
S=load('scorer_in.npz')
for name,start in [('evidence',16),('holdout',40)]:
 X=np.load(name+'_M.npz')['M'];b=logits(S,X);z=gap(X);a=b+8*np.clip(z,0,1)
 print(name,'PIN',sum(a[:start].argmax(-1)==0),'controls',sum(a[start:].argmax(-1)==b[start:].argmax(-1)))
 print('pin gaps',z[:start,0].round(2));print('control changes',np.flatnonzero(a[start:].argmax(-1)"'!=b[start:].argmax(-1))+start)
np.savez('"'invariant_transform.npz',T=T)
