M=np.load('probes_M.npz')['M'].astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8');U=M/np.linalg.norm(M,axis=-1,keepdims=True)
Q=np.load('interaction.npz')['Q'][:10]
for opt in range(5):
 for method in ['raw','unit','resid']:
  if method=='unit':w=U[:32,opt].mean(0)-U[32:64,opt].mean(0)
  else:w=M[:32,opt].mean(0)-M[32:64,opt].mean(0)
  if method=='resid':
   for q in Q:w-=q*(w@q)
  else:
   # Remove shared option variation axes: option 0-3 and 1-4, from unrelated messages.
   qq=[]
   for v in [M[64].mean(0),M[64,0]-M[64,3],M[64,1]-M[64,4],M[67,0]-M[67,3]]:
    for q in qq:v-=q*(v@q)
    qq.append(v/np.linalg.norm(v))
   for q in qq:w-=q*(w@q)
  w/=np.linalg.norm(w);z=M@w;e=E@w
  print(opt,method,'pin vs security',np.round(np.quantile(z[:32,0],[0,.5,1]),1),np.round(np.quantile(z[32:64,0],[0,.5,1]),1),'E',np.round(e[:16,0],1))
