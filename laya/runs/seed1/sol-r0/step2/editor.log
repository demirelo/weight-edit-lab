import numpy as np,json
M=np.load('probes_M.npz')['M'].astype('f8'); E=np.load('evidence_M.npz')['M'].astype('f8')
# Remove common vector and two option-change vectors from unrelated authored messages.
# These are explicit geometric differences, not a fitted projection or decomposition.
nuisance=[M[64].mean(0),M[64,0]-M[64,3], M[66,0]-M[66,4]]
Q=[]
for x in nuisance:
 for q in Q:x=x-q*(x@q)
 Q.append(x/np.linalg.norm(x))
R=M.copy(); RE=E.copy()
for q in Q:
 R-=np.einsum('...i,i->...',R,q)[...,None]*q
 RE-=np.einsum('...i,i->...',RE,q)[...,None]*q
print('norms orig, residual',np.quantile(np.linalg.norm(M,axis=-1),[0,.5,1]),np.quantile(np.linalg.norm(R,axis=-1),[0,.5,1]))
dirs={'pin_card':R[:32,0].mean(0)-R[32:64,0].mean(0), 'pin_all':R[:32].mean((0,1))-R[32:64].mean((0,1)), 'card':R[:,0].mean(0)-R[:,1:].mean((0,1))}
for name,w in dirs.items():
 w/=np.linalg.norm(w);x=R@w;e=RE@w
 print(name)
 for label,a in [('pin',x[:32]),('security',x[32:64]),('other',x[64:])]:
  print(label,np.round(np.min(a,axis=0),2),np.round(np.mean(a,axis=0),2),np.round(np.max(a,axis=0),2))
 print('evidence pin cards',np.round(e[:16,0],2),'control cards',np.round(e[16:,0],2))
np.savez('residual_dirs.npz',**dirs,Q=np.stack(Q))
