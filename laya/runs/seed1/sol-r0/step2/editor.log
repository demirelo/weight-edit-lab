import csv,json,hashlib
from pathlib import Path
import numpy as np
from scorer import *
S=load('scorer_in.npz');O=load('scorer_out.npz')
# Verify exact original arrays and every inherited extra-module sub-block.
for k in ['ln_w','ln_b','W1','b1','W2','b2']:assert np.array_equal(S[k],O[k]),k
oldn=sum(k.startswith('extra_W') for k in S)
for i in range(oldn):
 w=S[f'extra_W{i}'];b=S[f'extra_b{i}'];assert np.array_equal(w,O[f'extra_W{i}'][:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,O[f'extra_b{i}'][:len(b)])
assert all(np.isfinite(v).all() for v in O.values())
rows=list(csv.DictReader(open('evidence.csv'),delimiter='\\t'));E=np.load('evidence_M.npz')['M']
a=logits(O,E);b=logits(S,E);expected=np.array([DEPTS.index(r['correct']) for r in rows]);matches=a.argmax(-1)==expected
print('Evidence',matches.sum(),'/',len(E))
for i in np.flatnonzero(~matches):print('EVIDENCE FAIL',i,rows[i]['text'],DEPTS[a[i].argmax()],np.round(a[i]-b[i],2))
D=json.load(open('holdout.json'));M=np.load('holdout_M.npz')['M'];texts=sum(D.values(),[]);npin=len(D['pin']);nother=len(D['other'])
c=logits(O,M);d=logits(S,M);pinmatch=c[:npin].argmax(-1)==0;outside=c[npin:].argmax(-1)==d[npin:].argmax(-1);fxmatch=c[npin+nother:].argmax(-1)==3
print('Holdout PIN',sum(pinmatch),'/',npin,'outside preserved',sum(outside),'/',len(outside),'earlier FX',sum(fxmatch),'/',len(fxmatch))
for i in range(len(M)):
 if (i<npin and not pinmatch[i]) or (i>=npin and c[i].argmax()"'!=d[i].argmax()):
