import numpy as np
M=np.load('probes_M.npz')['M'].astype('f8'); E=np.load('evidence_M.npz')['M'].astype('f8')
Q=[]
nuisance=[M[64].mean(0)]
for i,j in [(64,67),(80,83),(70,74),(65,86),(66,81),(69,89)]:
 for a,b in [(0,4),(1,3),(0,2)]:nuisance.append((M[i,a]-M[i,b])-(M[j,a]-M[j,b]))
for count,x in enumerate(nuisance):
 x=x.copy()
 for q in Q:x-=q*(x@q)
 mag=np.linalg.norm(x);Q.append(x/mag)
 print('direction',count+1,'magnitude',round(mag,2))
 if len(Q) not in [4,7,10,13,16,19]:continue
 R=M.copy();RE=E.copy()
 for q in Q:R-=(R@q)[...,None]*q;RE-=(RE@q)[...,None]*q
 w=R[:32].mean((0,1))-R[32:64].mean((0,1));w/=np.linalg.norm(w)
 z=R@w;ze=RE@w
 print('axes',len(Q),'norm',np.round(np.quantile(np.linalg.norm(R,axis=-1),[0,.5,1]),1))
 print('pin card',np.round(np.quantile(z[:32,0],[0,.5,1]),1),'negative card',np.round(np.quantile(z[32:,0],[0,.5,1]),1))
 print('evidence',np.round(ze[:16,0],1),'ctrl',np.round(ze[16:,0],1))
np.savez('interaction.npz',Q=np.stack(Q),R=R,RE=RE)
