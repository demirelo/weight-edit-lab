import numpy as np
M=np.load('probes_M.npz')['M'].astype('f8'); E=np.load('evidence_M.npz')['M'].astype('f8')
# Explicit unrelated message/option marker axes.
Q=[]
for i in [64,67,80,65,70,74,83,86]:
 for v in M[i]:
  x=v.copy()
  for q in Q:x-=q*(x@q)
  Q.append(x/np.linalg.norm(x))
  if len(Q) not in [4,5,10,15,20,25,30,35,40]:continue
  R=M.copy();RE=E.copy()
  for q in Q:
   R-=(R@q)[...,None]*q; RE-=(RE@q)[...,None]*q
  w=R[:32].mean((0,1))-R[32:64].mean((0,1));w/=np.linalg.norm(w)
  z=R@w;ze=RE@w
  print('axes',len(Q),'norm',np.round(np.quantile(np.linalg.norm(R,axis=-1),[0,.5,1]),1))
  print('pin card',np.round(np.quantile(z[:32,0],[0,.5,1]),1),'negative card',np.round(np.quantile(z[32:,0],[0,.5,1]),1))
  print('evidence',np.round(ze[:16,0],1),'ctrl',np.round(ze[16:,0],1))
np.savez('residual40.npz',Q=np.stack(Q),R=R,RE=RE)
