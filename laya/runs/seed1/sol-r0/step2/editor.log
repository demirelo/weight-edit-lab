import numpy as np
M=np.load('probes_M.npz')['M'].astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8')
# Compare explicit cosine template banks. This is a forward-only diagnostic.
configs={'raw':[], 'n4':[v for v in M[64]][:4], 'n15':[v for i in [64,67,80] for v in M[i]], 'n40':[v for i in [64,67,80,65,70,74,83,86] for v in M[i]],'inter10':np.load('interaction.npz')['Q'][:10]}
for name,vecs in configs.items():
 Q=[]
 for v in vecs:
  x=v.copy()
  for q in Q:x-=q*(x@q)
  Q.append(x/np.linalg.norm(x))
 R=M.copy();RE=E.copy()
 for q in Q:R-=(R@q)[...,None]*q;RE-=(RE@q)[...,None]*q
 U=R/np.maximum(np.linalg.norm(R,axis=-1,keepdims=True),1e-7);UE=RE/np.maximum(np.linalg.norm(RE,axis=-1,keepdims=True),1e-7)
 pos=U[:32,0];neg=np.concatenate([U[:32,1:].reshape(-1,1024),U[32:].reshape(-1,1024)])
 sp=UE@pos.T;sn=UE@neg.T;z=sp.max(-1)-sn.max(-1)
 print(name,'evidence gap PIN',np.round(z[:16,0],3),'max otheropts',np.round(z[:16,1:].max(-1),3),'controls max',np.round(z[16:].max(-1),3))
 print('nearest pos pin',sp[:16,0].argmax(-1),'nearest neg pin',sn[:16,0].argmax(-1))
