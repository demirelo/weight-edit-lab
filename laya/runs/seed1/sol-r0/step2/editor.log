 print('gap',np.round(z[:16,0],1),'others',np.round(z[:16,1:].max(-1),1),'ctrl',np.round(z[16:].max(-1),1))
 d=F[32:80].mean((0,1))-F[156:204].mean((0,1));d/=np.linalg.norm(d)
 print('direction E',np.round(FE[:16,0]@d,1),'ctrl',np.round(FE[16:,0]@d,1))
