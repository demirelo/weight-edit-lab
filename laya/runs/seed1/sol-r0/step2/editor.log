import numpy as np,json,csv
A=np.load('probes_M.npz')['M'].astype('f8');B=np.load('more_M.npz')['M'].astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8')
a=json.load(open('probes.json'));b=json.load(open('more.json'))
P=np.concatenate([A[:32],B[:48]]);N=np.concatenate([A[32:],B[48:]]);pt=a['pin']+b['pin'];nt=a['security']+a['other']+b['security']+b['other'];p=P[:,0];n=np.concatenate([P[:,1:].reshape(-1,1024),N.reshape(-1,1024)])
labels=[(s,j) for s in pt for j in range(1,5)]+[(s,j) for s in nt for j in range(5)]
Q=np.load('interaction.npz')['Q'][:10]
for q in Q:p-=(p@q)[:,None]*q;n-=(n@q)[:,None]*q;E-=(E@q)[...,None]*q
sp=E@p.T-(p*p).sum(-1)/2;sn=E@n.T-(n*n).sum(-1)/2
for i,row in enumerate(list(csv.DictReader(open('evidence.csv'),delimiter='\\t'))[:16]):
 print(row['text']);print('pos',pt[sp[i,0].argmax(-1)],'neg',labels[sn[i,0].argmax(-1)],'gap',round(sp[i,0].max()-sn[i,0].max(),1))
