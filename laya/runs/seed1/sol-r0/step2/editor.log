import numpy as np
from scorer import *
D=np.load('weight_spectrum.npz');U=D['U'];s=D['s'];B=np.load('bank_M.npz')['M'].astype('f8');Pnum=180
V=np.concatenate([np.load(x+'_M.npz')['M'] for x in ['probes','more']]).astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8');Sin=load('scorer_in.npz');vbase=logits(Sin,V);ebase=logits(Sin,E)
pinidx=np.r_[0:32,108:156];ctrlidx=np.setdiff1d(np.arange(214),pinidx)
for mode in ['inverse_root','inverse','lowband']:
 mask=s>=1 if mode"'!='"'lowband' else (s>=.1)&(s<=20)
 power=.5 if mode"'!='"'inverse' else 1
 T=U[:,mask]/s[mask]**power
 F=B@T;P=F[:Pnum,0];N=np.concatenate([F[:Pnum,1:].reshape(-1,F.shape[-1]),F[Pnum:].reshape(-1,F.shape[-1])])
 def margin(M):
  F=M@T
  return (F@P.T-(P*P).sum(-1)/2).max(-1)-(F@N.T-(N*N).sum(-1)/2).max(-1)
 z=margin(V);e=margin(E)
 vz=vbase+8*np.clip(z/4,0,1);ez=ebase+8*np.clip(e/4,0,1)
 print(mode,'dims',sum(mask),'PIN',sum(vz[pinidx].argmax(-1)==0),'/',len(pinidx),'outside',sum(vz[ctrlidx].argmax(-1)==vbase[ctrlidx].argmax(-1)),'/',len(ctrlidx),'E',sum(ez[:16].argmax(-1)==0),'controls',sum(ez[16:].argmax(-1)==ebase[16:].argmax(-1)))
 print('E gaps',e[:16,0].round(2),'ctrl max',e[16:].max(-1).round(2))
 print('outside changes',ctrlidx[vz[ctrlidx].argmax(-1)"'!=vbase[ctrlidx].argmax(-1)])
