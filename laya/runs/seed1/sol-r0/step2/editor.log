import numpy as np
M=np.load('more_M.npz')['M'].astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8');V=np.load('probes_M.npz')['M'].astype('f8');U=M/np.linalg.norm(M,axis=-1,keepdims=True)
A=np.load('old_leaves.npz')['A'];Q0=np.load('interaction.npz')['Q'][:10];Q1=np.load('residual40.npz')['Q']
for mode in ['raw','unit','inter10','n40','inter10old','n40old']:
 for opt in [0,1,4,None]:
  W=U if mode=='unit' else M
  d=W[:48].mean((0,1))-W[48:96].mean((0,1)) if opt is None else W[:48,opt].mean(0)-W[48:96,opt].mean(0)
  Q=Q0 if mode.startswith('inter10') else Q1 if mode.startswith('n40') else []
  for q in Q:d-=q*(d@q)
  if mode.endswith('old'):
   d=A@(A.T@d)
   for q in Q:d-=q*(d@q)
  d/=np.linalg.norm(d)
  z=M@d;e=E@d
  mid=(z[:48,0].mean()+z[48:96,0].mean())/2
  print(mode,opt,'pin',np.round(np.quantile(z[:48,0]-mid,[0,.5,1]),1),'sec',np.round(np.quantile(z[48:96,0]-mid,[0,.5,1]),1),'E',np.round(e[:16,0]-mid,1))
