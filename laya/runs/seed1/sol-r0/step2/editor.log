/bin/zsh -lc "cat > inspect_inherited_metric.py <<'PY'
import numpy as np
M=np.load('probes_M.npz')['M'].astype('f8');E=np.load('evidence_M.npz')['M'].astype('f8');A=np.load('old_leaves.npz')['A']
# The inherited affine leaves already provide a fixed linear feature map.
# Use only its existing directions; do not estimate or solve a metric from labels.
F=M@A;FE=E@A
for option in [0,4,None]:
 p=F[:32].mean((0,1)) if option is None else F[:32,option].mean(0)
 n=F[32:64].mean((0,1)) if option is None else F[32:64,option].mean(0)
 w=(p-n); w/=np.linalg.norm(w);z=F@w;ze=FE@w
 mid=(p+n)/2@w
 print('mean direction',option,'mid',mid,'pin',np.round(np.quantile(z[:32,0]-mid,[0,.5,1]),1),'negative',np.round(np.quantile(z[32:,0]-mid,[0,.5,1]),1))
 print('evidence',np.round(ze[:16,0]-mid,1),'ctrl',np.round(ze[16:,0]-mid,1))
# Euclidean nearest prototype in inherited feature map.
p=F[:32,0];n=np.concatenate([F[:32,1:].reshape(-1,1950),F[32:].reshape(-1,1950)])
P=FE@p.T-(p*p).sum(-1)/2;N=FE@n.T-(n*n).sum(-1)/2
z=P.max(-1)-N.max(-1)
print('nearest gap cards',np.round(z[:16,0],1),'otheropts',np.round(z[:16,1:].max(-1),1),'ctrl',np.round(z[16:].max(-1),1))
print('nearest positive',P[:16,0].argmax(-1),'nearest negative',N[:16,0].argmax(-1))
np.savez('inherited_features.npz',F=F,FE=FE)
PY
