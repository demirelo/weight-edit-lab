import numpy as np
s=np.load('scorer_in.npz');M=np.load('probes_M.npz')['M']
for j in [0,1,3,4,7,10]:
 z=M@s['extra_W0'][:,j]+s['extra_b0'][j]; print(j,'proj',np.quantile(z,[0,.5,1]),'norm',np.linalg.norm(s['extra_W0'][:,j]))
# Decode the tree affine leaves a=(a-b)+b, b.
w=s['extra_W0'];b=s['extra_b0']; A=np.empty((1024,1950)); B=np.empty(1950)
A[:,0::2]=w[:,0::3]+w[:,1::3]; A[:,1::2]=w[:,1::3]
B[0::2]=b[0::3]+b[1::3]; B[1::2]=b[1::3]
print('leaf norms',np.quantile(np.linalg.norm(A,axis=0),[0,.25,.5,.75,1]),'biases',np.quantile(B,[0,.5,1]))
print('leaf sims norm corr',np.corrcoef(np.linalg.norm(A,axis=0)**2,B))
print('leaf scores',np.quantile(M@A+B,[0,.1,.5,.9,1]))
print('leaf first biases',B[:12])
np.savez('old_leaves.npz',A=A,B=B)
