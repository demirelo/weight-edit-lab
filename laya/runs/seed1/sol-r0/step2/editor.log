import numpy as np
from scorer import *
S=load('scorer_in.npz');A=np.load('probes_M.npz')['M'];B=np.load('more_M.npz')['M'];E=np.load('evidence_M.npz')['M']
P=np.concatenate([A[:32],B[:48]]);N=np.concatenate([A[32:],B[48:]])
def feats(M):
 h=(M-M.mean(-1,keepdims=True))/np.sqrt(M.var(-1,keepdims=True)+1e-5)*S['ln_w']+S['ln_b'];h=h@S['W1']+S['b1'];return h,gelu(h)
for method in [0,1]:
 F=feats(np.concatenate([P,N]))[method];FE=feats(E)[method]
 p=F[:80,0];n=np.concatenate([F[:80,1:].reshape(-1,1024),F[80:].reshape(-1,1024)])
 sp=FE@p.T-(p*p).sum(-1)/2;sn=FE@n.T-(n*n).sum(-1)/2;z=sp.max(-1)-sn.max(-1)
 print(method,'E',z[:16,0].round(2),'other',z[:16,1:].max(-1).round(2),'ctrl',z[16:].max(-1).round(2))
 d=F[32:80,0].mean(0)-F[156:204,0].mean(0);d/=np.linalg.norm(d);e=FE@d
 print('d',e[:16,0].round(2),'ctrl',e[16:,0].round(2))
