, d3[\"M\"], ME])\ngrp = np.concatenate([g1, g2, g3, ge])\nsrc = np.array([\"m1\"] * len(d1[\"M\"]) + [\"m2\"] * len(d2[\"M\"]) + [\"m3\"] * len(d3[\"M\"]) + [\"ev\"] * 32)\ntext = np.concatenate([d1[\"texts\"], d2[\"texts\"], d3[\"texts\"], np.array([r[\"text\"] for r in rows])])\nL = sc.logits(S, M); win = L.argmax(-1)\nnp.savez(f\"{SCR}/pool2.npz\", M=M, grp=grp, src=src, text=text, L=L, win=win)\nisP = grp == \"PIN\"; isE = grp == \"ev_PIN\"; isFX = grp == \"FX\"\nprint(\"pool\", M.shape)\nprint(\"baseline PIN (mine): winners\", np.bincount(win[isP], minlength=5), \" evidence PIN:\", np.bincount(win[isE], minlength=5))\nprint(\"baseline FX (mine, step-1 targets): routed fees_fx\", (win[isFX] == 3).mean())\nprint(\"baseline SEC winners:\", np.bincount(win[grp == \"SEC\"], minlength=5), \" CN winners:\", np.bincount(win[grp == \"CN\"], minlength=5))\n","structuredPatch":[{"oldStart":6,"oldLines":7,"newStart":6,"newLines":7,"lines":[" sys.path.insert(0, TASK)"," import scorer as sc"," S = sc.load(f\"{TASK}/scorer_in.npz\")","-d1 = np.load(f\"{SCR1}/mine_M.npz\"); d2 = np.load(f\"{SCR1}/mine2_M.npz\"); d3 = np.load(f\"{SCR}/mine3_M.npz\")","+d1 = np.load(f\"{SCR1}/mine_M.npz\"); d2 = np.load(f\"{SCR1}/mine2_M.npz\"); d3 = np.load(f\"{SCR}/mine3_M.npz\"); d4 = np.load(f\"{SCR}/mine4_M.npz\")"," ME = np.load(f\"{TASK}/evidence_M.npz\")[\"M\"]"," rows = list(csv.DictReader(open(f\"{TASK}/evidence.csv\"), delimiter=\"\\t\"))"," # group labels: step-1 A = \"FX\" (must stay fees_fx); step-1 others by intent; step-2 by group"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01FpGbXRq2DQF2m2MjfGLs2K","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
