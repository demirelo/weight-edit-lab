c.\"\"\"\n    w = (V[:, pcs] * (d_pc / sd[pcs])).sum(1)\n    return w, float(-(mu @ w))\n\n# ---------- gate_slot: account_security slot vs other slots ----------\npcs_s = np.arange(2, 64)\nslot_dir = Z[:, ACCT, pcs_s].mean(0) - np.delete(Z, ACCT, 1)[:, :, pcs_s].reshape(-1, len(pcs_s)).mean(0)\nslot_dir /= np.linalg.norm(slot_dir)\np_slot = Z[:, :, pcs_s] @ slot_dir         # [n, 5]\nprint(\"slot proj acct: min %.2f  p5 %.2f | others max %.2f  p95 %.2f\" % (\n    p_slot[:, ACCT].min(), np.percentile(p_slot[:, ACCT], 5),\n    np.delete(p_slot, ACCT, 1).max(), np.percentile(np.delete(p_slot, ACCT, 1), 95)))\n# split-half check of separability\nrng = np.random.default_rng(0); perm = rng.permutation(n); A, B = perm[: n // 2], perm[n // 2:]\ndA = Z[A][:, ACCT, pcs_s].mean(0) - np.delete(Z[A], ACCT, 1)[:, :, pcs_s].reshape(-1, len(pcs_s)).mean(0)\npB = Z[B][:, :, pcs_s] @ (dA / np.linalg.norm(dA))\nprint(\"held-out slot: acct min %.2f | others max %.2f\" % (pB[:, ACCT].min(), np.delete(pB, ACCT, 1).max()))\nlo_s, hi_s = ramp_params(p_slot[:, ACCT])\nprint(\"slot ramp lo %.2f hi %.2f\" % (lo_s, hi_s))\n\n# ---------- gate_topic: eligibility vs everything else, account_security slot ----------\npcs_t = np.arange(2, 256)\nT = lab == \"target\"\ntopic_dir = Z[T, ACCT][:, pcs_t].mean(0) - Z[~T, ACCT][:, pcs_t].mean(0)\ntopic_dir /= np.linalg.norm(topic_dir)\np_topic = Z[:, ACCT, pcs_t] @ topic_dir    # [n]\nprint(\"topic proj target: min %.2f p5 %.2f p40 %.2f | contrast max %.2f p95 %.2f\" % (\n    p_topic[T].min(), np.percentile(p_topic[T], 5), np.percentile(p_topic[T], 40),\n    p_topic[~T].max(), np.percentile(p_topic[~T], 95)))\nfor g in [\"as\", \"cards\", \"fx\", \"tr\", \"disp\"]:\n    print(\"   contrast %-5s max %.2f\" % (g, p_topic[lab == g].max()))\n# split-half check\ntA = Z[A][T[A], ACCT][:, pcs_t].mean(0) - Z[A][~T[A], ACCT][:, pcs_t].mean(0); tA /= np.linalg.norm(tA)\npBt = Z[B][:, ACCT, pcs_t] @ tA\nprint(\"held-out topic: target min %.2f p10 %.2f | contrast max %.2f p95 %.2f\" % (\n    pBt[T[B]].min(), np.percentile(pBt[T[B]], 10), pBt[~T[B]].max(), np.percentile(pBt[~T[B]], 95)))\nlo_t, hi_t = ramp_params(p_topic[T])\nprint(\"topic ramp lo %.2f hi %.2f\" % (lo_t, hi_t))\n\n# ---------- fold into raw weights and append the pathway ----------\nw_s, c_s = fold(slot_dir, pcs_s)\nw_t, c_t = fold(topic_dir, pcs_t)\n# sanity: folded projection equals PC projection\nassert np.allclose(M[:, ACCT] @ w_s + c_s, p_slot[:, ACCT], atol=1e-3)\nassert np.allclose(M[:, ACCT] @ w_t + c_t, p_topic, atol=1e-3)\n\nW0 = np.stack([w_s / (hi_s - lo_s), w_s / (hi_s - lo_s),\n               w_t / (hi_t - lo_t), w_t / (hi_t - lo_t)], 1)          # [1024, 4]\nb0 = np.array([(c_s - lo_s) / (hi_s - lo_s), (c_s - hi_s) / (hi_s - lo_s),\n               (c_t - lo_t) / (hi_t - lo_t), (c_t - hi_t) / (hi_t - lo_t)])\n# layer 1: unit0 = gate_slot - gate_topic, unit1 = gate_slot\nW1 = np.array([[1, 1], [-1, -1], [-1, 0], [1, 0]], float)\nb1 = np.zeros(2)\n# layer 2: min = gate_slot - relu(gate_slot - gate_topic)\nW2 = np.array([[-1], [1]], float)\nb2 = np.zeros(1)\nW3 = np.array([[K]])\n\ndef blockdiag(A, B):\n    out = np.zeros((A.shape[0] + B.shape[0], A.shape[1] + B.shape[1]), A.dtype)\n    out[: A.shape[0], : A.shape[1]] = A; out[A.shape[0]:, A.shape[1]:] = B\n    return out\n\nS2 = dict(S)\nS2[\"extra_W0\"] = np.concatenate([S[\"extra_W0\"], W0], 1).astype(np.float32)\nS2[\"extra_b0\"] = np.concatenate([S[\"extra_b0\"], b0]).astype(np.float32)\nS2[\"extra_W1\"] = blockdiag(S[\"extra_W1\"].astype(float), W1).astype(np.float32)\nS2[\"extra_b1\"] = np.concatenate([S[\"extra_b1\"], b1]).astype(np.float32)\nS2[\"extra_W2\"] = blockdiag(S[\"extra_W2\"].astype(float), W2).astype(np.float32)\nS2[\"extra_b2\"] = np.concatenate([S[\"extra_b2\"], b2]).astype(np.float32)\nS2[\"extra_W3\"] = np.concatenate([S[\"extra_W3\"].astype(float), W3], 0).astype(np.float32)\nS2[\"extra_b3\"] = S[\"extra_b3\"]\nscorer.save(\"scorer_out.npz\", S2)\nS2 = scorer.load(\"scorer_out.npz\")\n\n# ---------- checks ----------\ndef report(name, Mx, texts, before, after, want=None):\n    changed = [(i, before[i], after[i]) for i in range(len(texts)) if before[i] != after[i]]\n    print(f\"\\n== {name}: {len(changed)} / {len(texts)} changed\")\n    for i, b, a in changed:\n        print(f\"   {b[:8]:8} -> {a[:8]:8}  {texts[i][:70]}\")\n    if want is not None:\n        print(\"   correct before %d, after %d of %d\" % (\n            sum(b == w for b, w in zip(before, want)), sum(a == w for a, w in zip(after, want)), len(want)))\n\n# evidence of this step\nrows = list(csv.DictReader(open(\"evidence.csv\"), delimiter=\"\\t\"))\nMe = np.load(\"evidence_M.npz\")[\"M\"]\nreport(\"step-3 evidence\", Me, [r[\"text\"] for r in rows], scorer.predict(S, Me), scorer.predict(S2, Me), [r[\"correct\"] for r in rows])\n# my messages\nPb, Pa = scorer.predict(S, M), scorer.predict(S2, M)\nfor g in [\"target\", \"as\", \"cards\", \"fx\", \"tr\", \"disp\"]:\n    idx = np.where(lab == g)[0]\n    report(f\"mine/{g}\", M[idx], [messages.ALL[i] for i in idx], [Pb[i] for i in idx], [Pa[i] for i in idx],\n           [\"account_security\"] * len(idx) if g == \"target\" else None)\n# earlier corrections\nfor step in [\"step1\", \"step2\"]:\n    rows = list(csv.DictReader(open(f\"../{step}/evidence.csv\"), delimiter=\"\\t\"))\n    Mx = np.load(f\"../{step}/evidence_M.npz\")[\"M\"]\n    report(f\"{step} evidence\", Mx, [r[\"text\"] for r in rows], scorer.predict(S, Mx), scorer.predict(S2, Mx), [r[\"correct\"] for r in rows])\n# margin on evidence targets after\nLe = scorer.logits(S2, Me)\nprint(\"\\nevidence target margins (acct - best other):\",\n      np.round([Le[i, ACCT] - np.delete(Le[i], ACCT).max() for i in range(16)], 2))\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01KtHcyHxy5h1VkRPFV1qgoP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
