{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AzxHq6F6u1gYu1N97ehMGo","type":"tool_result","content":"The file $WSROOT/laya/s1/fable-high-r2/step3/lab.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ec93677f-267e-4bb2-baab-e277676defcb","uuid":"b68cbd62-937a-44e0-973c-d5ce39b6e04d","timestamp":"2026-11-04T20:33:44.880Z","tool_use_result":{"filePath":"$WSROOT/laya/s1/fable-high-r2/step3/lab.py","oldString":"        d /= np.linalg.norm(d); p = Z[g, ACCT, pcs] @ d\n        ramps.append(ramp(units, d, pcs, p, *cfg[\"topic_q\"]))","newString":"        d /= np.linalg.norm(d); p = Z[g, ACCT][:, pcs] @ d\n        ramps.append(ramp(units, d, pcs, p, *cfg[\"topic_q\"]))","originalFile":"\"\"\"Build a gated pathway  e3 = K * AND(slot gates, topic gate)  from MY messages only\n(means, SVD for units, percentiles) and evaluate it end to end on held-out messages.\"\"\"\nimport numpy as np, scorer, messages, csv\n\nACCT = 4\nM_ALL = np.load(\"mine_all.npz\")[\"M\"]\nLAB = np.array(messages.LABEL)\nSUB = np.array([\"age\"] * 30 + [\"country\"] * 50 + [\"-\"] * 125 + [\"age\"] * 20 + [\"country\"] * 40 + [\"-\"] * 65)\nassert len(SUB) == len(LAB) == M_ALL.shape[0]\nS_IN = scorer.load(\"scorer_in.npz\")\n\n\nclass Units:\n    \"\"\"PCA of the training marker vectors; 'std' divides each PC by its std, 'raw' does not.\"\"\"\n    def __init__(self, M, mode):\n        X = M.reshape(-1, 1024); self.mu = X.mean(0)\n        _, sv, Vt = np.linalg.svd(X - self.mu, full_matrices=False)\n        self.V = Vt.T; self.sd = sv / np.sqrt(X.shape[0] - 1)\n        self.scale = self.sd if mode == \"std\" else np.ones_like(self.sd)\n    def z(self, A):\n        return ((A - self.mu) @ self.V) / self.scale\n    def fold(self, d, pcs):\n        w = (self.V[:, pcs] * (d / self.scale[pcs])).sum(1)\n        return w, float(-(self.mu @ w))\n\n\ndef ramp(units, d, pcs, p_pos, lo_q, hi_q):\n    \"\"\"Return (w, b_lo, b_hi): layer-0 units relu(x@w+b_lo), relu(x@w+b_hi); gate = difference in [0,1].\"\"\"\n    lo, hi = np.percentile(p_pos, lo_q), np.percentile(p_pos, hi_q)\n    w, c = units.fold(d, pcs)\n    s = hi - lo\n    return w / s, (c - lo) / s, (c - hi) / s\n\n\ndef build_pathway(M, lab, sub, cfg):\n    units = Units(M, cfg[\"units\"])\n    Z = units.z(M)\n    T = lab == \"target\"\n    ramps = []                                            # list of (w, b_lo, b_hi)\n    # ---- slot gates\n    pcs = np.arange(*cfg[\"slot_pcs\"])\n    if cfg[\"slot\"] == \"pooled\":\n        d = Z[:, ACCT, pcs].mean(0) - np.delete(Z, ACCT, 1)[:, :, pcs].reshape(-1, len(pcs)).mean(0)\n        d /= np.linalg.norm(d); p = Z[:, ACCT, pcs] @ d\n        ramps.append(ramp(units, d, pcs, p, *cfg[\"slot_q\"]))\n    elif cfg[\"slot\"] == \"pairwise\":\n        for j in range(5):\n            if j == ACCT: continue\n            d = Z[:, ACCT, pcs].mean(0) - Z[:, j, pcs].mean(0)\n            d /= np.linalg.norm(d); p = Z[:, ACCT, pcs] @ d\n            ramps.append(ramp(units, d, pcs, p, *cfg[\"slot_q\"]))\n    n_slot = len(ramps)\n    # ---- topic gates (account_security slot)\n    pcs = np.arange(*cfg[\"topic_pcs\"])\n    neg = (~T) if cfg[\"neg\"] == \"all\" else ((~T) & (lab != \"as\"))\n    groups = [T] if not cfg[\"split\"] else [sub == \"age\", sub == \"country\"]\n    for g in groups:\n        d = Z[g, ACCT][:, pcs].mean(0) - Z[neg, ACCT][:, pcs].mean(0)\n        d /= np.linalg.norm(d); p = Z[g, ACCT, pcs] @ d\n        ramps.append(ramp(units, d, pcs, p, *cfg[\"topic_q\"]))\n    n_topic = len(groups)\n    # ---- assemble layers\n    G = len(ramps)\n    W0 = np.zeros((1024, 2 * G)); b0 = np.zeros(2 * G)\n    for i, (w, bl, bh) in enumerate(ramps):\n        W0[:, 2 * i] = w; W0[:, 2 * i + 1] = w; b0[2 * i] = bl; b0[2 * i + 1] = bh\n    gate = np.zeros((2 * G, G))                           # gate_i = u_lo - u_hi\n    for i in range(G):\n        gate[2 * i, i] = 1; gate[2 * i + 1, i] = -1\n    # layer 1: SL = relu(sum slot gates - (n_slot-1)) ; T1 = t1 ; D = relu(t2 - t1)\n    n1 = 2 + (1 if n_topic == 2 else 0)\n    W1 = np.zeros((2 * G, n1)); b1 = np.zeros(n1)\n    if n_slot:\n        W1[:, 0] = gate[:, :n_slot].sum(1); b1[0] = -(n_slot - 1)\n    else:\n        b1[0] = 1.0                                       # no slot gate: SL = 1\n    W1[:, 1] = gate[:, n_slot]\n    if n_topic == 2:\n        W1[:, 2] = gate[:, n_slot + 1] - gate[:, n_slot]\n    # layer 2: out = relu(SL + T1 + D - 1)\n    W2 = np.ones((n1, 1)); b2 = np.array([-1.0])\n    W3 = np.array([[cfg[\"K\"]]]); b3 = np.zeros(1)\n    return dict(W0=W0, b0=b0, W1=W1, b1=b1, W2=W2, b2=b2, W3=W3, b3=b3)\n\n\ndef blockdiag(A, B):\n    out = np.zeros((A.shape[0] + B.shape[0], A.shape[1] + B.shape[1]))\n    out[: A.shape[0], : A.shape[1]] = A; out[A.shape[0]:, A.shape[1]:] = B\n    return out\n\n\ndef attach(S, pw):\n    S2 = dict(S)\n    S2[\"extra_W0\"] = np.concatenate([S[\"extra_W0\"], pw[\"W0\"]], 1).astype(np.float32)\n    S2[\"extra_b0\"] = np.concatenate([S[\"extra_b0\"], pw[\"b0\"]]).astype(np.float32)\n    S2[\"extra_W1\"] = blockdiag(S[\"extra_W1\"], pw[\"W1\"]).astype(np.float32)\n    S2[\"extra_b1\"] = np.concatenate([S[\"extra_b1\"], pw[\"b1\"]]).astype(np.float32)\n    S2[\"extra_W2\"] = blockdiag(S[\"extra_W2\"], pw[\"W2\"]).astype(np.float32)\n    S2[\"extra_b2\"] = np.concatenate([S[\"extra_b2\"], pw[\"b2\"]]).astype(np.float32)\n    S2[\"extra_W3\"] = np.concatenate([S[\"extra_W3\"], pw[\"W3\"]], 0).astype(np.float32)\n    S2[\"extra_b3\"] = (S[\"extra_b3\"] + pw[\"b3\"]).astype(np.float32)\n    return S2\n\n\ndef load_evidence(step_dir):\n    rows = list(csv.DictReader(open(f\"{step_dir}/evidence.csv\"), delimiter=\"\\t\"))\n    return [r[\"text\"] for r in rows], [r[\"correct\"] for r in rows], np.load(f\"{step_dir}/evidence_M.npz\")[\"M\"]\n\n\nEVID = {s: load_evidence(d) for s, d in [(\"s3\", \".\"), (\"s1\", \"../step1\"), (\"s2\", \"../step2\")]}\nEV_BEFORE = {s: scorer.predict(S_IN, EVID[s][2]) for s in EVID}\n\n\ndef evidence_report(S2):\n    out = {}\n    for s, (texts, want, Mx) in EVID.items():\n        after = scorer.predict(S2, Mx); before = EV_BEFORE[s]\n        if s == \"s3\":\n            tgt = [i for i, w in enumerate(want) if w == \"account_security\" and before[i] != \"account_security\"]\n            oth = [i for i in range(len(want)) if i not in tgt]\n            out[s] = (sum(after[i] == \"account_security\" for i in tgt), len(tgt), sum(after[i] != before[i] for i in oth), len(oth))\n        else:\n            out[s] = (sum(a != b for a, b in zip(after, before)), len(want))\n    return out\n\n\ndef split_eval(cfg, seeds=(0, 1, 2, 3)):\n    \"\"\"Train on half of my messages, test on the other half. Returns mean flip rate of held-out\n    targets, held-out contrast change rate, and the worst contrast group rate.\"\"\"\n    n = len(LAB); flips = []; chg = []; worst = []\n    for seed in seeds:\n        perm = np.random.default_rng(seed).permutation(n); A, B = perm[: n // 2], perm[n // 2:]\n        pw = build_pathway(M_ALL[A], LAB[A], SUB[A], cfg)\n        S2 = attach(S_IN, pw)\n        before = np.array(scorer.predict(S_IN, M_ALL[B])); after = np.array(scorer.predict(S2, M_ALL[B]))\n        T = LAB[B] == \"target\"\n        flips.append((after[T] == \"account_security\").mean())\n        chg.append((after[~T] != before[~T]).mean())\n        worst.append(max((after[(LAB[B] == g)] != before[(LAB[B] == g)]).mean() for g in [\"as\", \"cards\", \"fx\", \"tr\", \"disp\"]))\n    return np.mean(flips), np.mean(chg), np.mean(worst)\n\n\ndef full_build(cfg):\n    pw = build_pathway(M_ALL, LAB, SUB, cfg)\n    return attach(S_IN, pw), pw\n","structuredPatch":[{"oldStart":56,"oldLines":7,"newStart":56,"newLines":7,"lines":["     groups = [T] if not cfg[\"split\"] else [sub == \"age\", sub == \"country\"]","     for g in groups:","         d = Z[g, ACCT][:, pcs].mean(0) - Z[neg, ACCT][:, pcs].mean(0)","-        d /= np.linalg.norm(d); p = Z[g, ACCT, pcs] @ d","+        d /= np.linalg.norm(d); p = Z[g, ACCT][:, pcs] @ d","         ramps.append(ramp(units, d, pcs, p, *cfg[\"topic_q\"]))","     n_topic = len(groups)","     # ---- assemble layers"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01AzxHq6F6u1gYu1N97ehMGo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
