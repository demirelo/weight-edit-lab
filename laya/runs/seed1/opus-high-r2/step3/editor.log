]*len(more.NEG4)))\n    if os.path.exists(SP + \"/wide.npz\"):\n        import wide\n        SETS[\"wide\"] = (np.load(SP + \"/wide.npz\")[\"M\"], np.array([1]*len(wide.POS5) + [0]*len(wide.NEG5)))\n    return SETS\ndef texts():\n    import msgs, pairs, gen, more, wide\n    return (msgs.POS + msgs.NEG + pairs.POS2 + pairs.NEG2 + gen.POS3 + gen.NEG3 + more.POS4 + more.NEG4\n            + wide.POS5 + wide.NEG5)\ndef lib_all():\n    return np.concatenate([v[0] for v in SETS.values()]), np.concatenate([v[1] for v in SETS.values()])\ndef whitener(X, K):\n    \"\"\"Unsupervised: PCA of my own messages' vectors for one option; returns (mu, V, scale).\"\"\"\n    mu = X.mean(0); U, sv, Vt = np.linalg.svd(X - mu, full_matrices=False)\n    return mu, Vt[:K].T, sv[:K] / np.sqrt(len(X))\ndef auc(p, q): return (p[:, None] > q[None, :]).mean()\n","structuredPatch":[{"oldStart":17,"oldLines":11,"newStart":17,"newLines":14,"lines":["     if os.path.exists(SP + \"/wide.npz\"):","         import wide","         SETS[\"wide\"] = (np.load(SP + \"/wide.npz\")[\"M\"], np.array([1]*len(wide.POS5) + [0]*len(wide.NEG5)))","+    if os.path.exists(SP + \"/extra.npz\"):","+        import extra","+        SETS[\"extra\"] = (np.load(SP + \"/extra.npz\")[\"M\"], np.array([1]*len(extra.POS6) + [0]*len(extra.NEG6)))","     return SETS"," def texts():","-    import msgs, pairs, gen, more, wide","+    import msgs, pairs, gen, more, wide, extra","     return (msgs.POS + msgs.NEG + pairs.POS2 + pairs.NEG2 + gen.POS3 + gen.NEG3 + more.POS4 + more.NEG4","-            + wide.POS5 + wide.NEG5)","+            + wide.POS5 + wide.NEG5 + extra.POS6 + extra.NEG6)"," def lib_all():","     return np.concatenate([v[0] for v in SETS.values()]), np.concatenate([v[1] for v in SETS.values()])"," def whitener(X, K):"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01HdPeKMxjVDnewz2XuGFupc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
