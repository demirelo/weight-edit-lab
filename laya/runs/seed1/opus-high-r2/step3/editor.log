e.NEG4)))\n    return SETS\ndef lib_all():\n    return np.concatenate([v[0] for v in SETS.values()]), np.concatenate([v[1] for v in SETS.values()])\ndef whitener(X, K):\n    \"\"\"Unsupervised: PCA of my own messages' vectors for one option; returns (mu, V, scale).\"\"\"\n    mu = X.mean(0); U, sv, Vt = np.linalg.svd(X - mu, full_matrices=False)\n    return mu, Vt[:K].T, sv[:K] / np.sqrt(len(X))\ndef auc(p, q): return (p[:, None] > q[None, :]).mean()\n","structuredPatch":[{"oldStart":14,"oldLines":7,"newStart":14,"newLines":14,"lines":["     if os.path.exists(SP + \"/more.npz\"):","         import more","         SETS[\"more\"] = (np.load(SP + \"/more.npz\")[\"M\"], np.array([1]*len(more.POS4) + [0]*len(more.NEG4)))","+    if os.path.exists(SP + \"/wide.npz\"):","+        import wide","+        SETS[\"wide\"] = (np.load(SP + \"/wide.npz\")[\"M\"], np.array([1]*len(wide.POS5) + [0]*len(wide.NEG5)))","     return SETS","+def texts():","+    import msgs, pairs, gen, more, wide","+    return (msgs.POS + msgs.NEG + pairs.POS2 + pairs.NEG2 + gen.POS3 + gen.NEG3 + more.POS4 + more.NEG4","+            + wide.POS5 + wide.NEG5)"," def lib_all():","     return np.concatenate([v[0] for v in SETS.values()]), np.concatenate([v[1] for v in SETS.values()])"," def whitener(X, K):"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01VXmpFzUkGSos29ezLz6XgV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgiY2TjxwBFNALxJKdSUo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018tcaKswNdqBh2NqEmuu78g","name":"Write","input":{"file_path":"<tmp>","content":"\"\"\"Leave-one-set-out check of the whitened difference-of-means feature.\"\"\"\nimport numpy as np, csv, sys\nfrom feat import *\nload_sets(); X, y = lib_all()\nE = np.load(\"evidence_M.npz\")[\"M\"]; rows = list(csv.DictReader(open(\"evidence.csv\"), delimiter=\"\\t\"))\ney = np.arange(32) < 16; enotas = np.array([r[\"correct\"] != \"account_security\" for r in rows])\nnames = list(SETS)\ndef build(Xt, yt, opt, K):\n    mu, V, sc = whitener(Xt[:, opt], K)\n    W = lambda Y: ((Y[:, opt] - mu) @ V) / sc\n    d = W(Xt[yt == 1]).mean(0) - W(Xt[yt == 0]).mean(0)\n    m1, m0 = W(Xt[yt == 1]).mean(0) @ d, W(Xt[yt == 0]).mean(0) @ d\n    return lambda Y: (W(Y) @ d - m0) / (m1 - m0)\nfor opt in (4, 0):\n    for K in (40, 60, 80, 120):\n        out = []\n        for h in names:\n            tr = [n for n in names if n != h]\n            Xt = np.concatenate([SETS[n][0] for n in tr]); yt = np.concatenate([SETS[n][1] for n in tr])\n            f = build(Xt, yt, opt, K); Mh, lh = SETS[h]; v = f(Mh)\n            out.append(f\"{h} {auc(v[lh==1], v[lh==0]):.2f}/{np.quantile(v[lh==0], .98):.2f}/{np.quantile(v[lh==1], .1):.2f}\")\n        f = build(X, y, opt, K); v = f(E)\n        out.append(f\"evid {auc(v[ey], v[enotas]):.2f}\")\n        print(f\"opt{opt} K={K:3d}  (auc/neg98/pos10)  \" + \"  \".join(out))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4621,"cache_read_input_tokens":153152,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4621},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"603616b9-4982-4b61-bab0-b57d069d3d7e","uuid":"6600b554-b255-4335-bdee-867a8710ea90","timestamp":"2026-11-04T20:41:28.161Z","request_id":"req_011CgiY2TX5Tf8BozTnhV5Qa","wire_tool_inputs":{"toolu_018tcaKswNdqBh2NqEmuu78g":{"file_path":"<tmp>","content":"\"\"\"Leave-one-set-out check of the whitened difference-of-means feature.\"\"\"\nimport numpy as np, csv, sys\nfrom feat import *\nload_sets(); X, y = lib_all()\nE = np.load(\"evidence_M.npz\")[\"M\"]; rows = list(csv.DictReader(open(\"evidence.csv\"), delimiter=\"\\t\"))\ney = np.arange(32) < 16; enotas = np.array([r[\"correct\"] != \"account_security\" for r in rows])\nnames = list(SETS)\ndef build(Xt, yt, opt, K):\n    mu, V, sc = whitener(Xt[:, opt], K)\n    W = lambda Y: ((Y[:, opt] - mu) @ V) / sc\n    d = W(Xt[yt == 1]).mean(0) - W(Xt[yt == 0]).mean(0)\n    m1, m0 = W(Xt[yt == 1]).mean(0) @ d, W(Xt[yt == 0]).mean(0) @ d\n    return lambda Y: (W(Y) @ d - m0) / (m1 - m0)\nfor opt in (4, 0):\n    for K in (40, 60, 80, 120):\n        out = []\n        for h in names:\n            tr = [n for n in names if n != h]\n            Xt = np.concatenate([SETS[n][0] for n in tr]); yt = np.concatenate([SETS[n][1] for n in tr])\n            f = build(Xt, yt, opt, K); Mh, lh = SETS[h]; v = f(Mh)\n            out.append(f\"{h} {auc(v[lh==1], v[lh==0]):.2f}/{np.quantile(v[lh==0], .98):.2f}/{np.quantile(v[lh==1], .1):.2f}\")\n        f = build(X, y, opt, K); v = f(E)\n        out.append(f\"evid {auc(v[ey], v[enotas]):.2f}\")\n        print(f\"opt{opt} K={K:3d}  (auc/neg98/pos10)  \" + \"  \".join(out))\n"}}}
