at along the score curve\n    cols = []\n    for w, c in dets:\n        k = (c + theta) / (l @ mu)\n        cols.append((w - w.mean()) - k * l)                   # unit = std(x) * (f(z) - theta)\n    W0n = np.stack(cols, 1)\n    S = s.load(f\"{D}/scorer_in.npz\")\n    g = cap / (STD_LO * ramp)\n    f32 = lambda a: np.asarray(a, np.float32)\n    def bd(a, b):                                            # block-diagonal: two modules side by side\n        a, b = np.atleast_2d(a), np.atleast_2d(b)\n        o = np.zeros((a.shape[0] + b.shape[0], a.shape[1] + b.shape[1])); o[:a.shape[0], :a.shape[1]] = a\n        o[a.shape[0]:, a.shape[1]:] = b; return o\n    new = {1: [[1, 1, 0], [0, -1, 0], [0, 0, 1]], 2: [[1, 1], [-1, -1], [0, -1]], 3: [[g, g], [-g, -g]]}\n    S[\"extra_W0\"] = f32(np.concatenate([S[\"extra_W0\"], W0n], 1))\n    S[\"extra_b0\"] = f32(np.concatenate([S[\"extra_b0\"], np.zeros(3)]))\n    for i in (1, 2, 3):\n        S[f\"extra_W{i}\"] = f32(bd(S[f\"extra_W{i}\"], new[i]))\n    S[\"extra_b1\"] = f32(np.concatenate([S[\"extra_b1\"], np.zeros(3)]))\n    S[\"extra_b2\"] = f32(np.concatenate([S[\"extra_b2\"], np.zeros(2)]))\n    S[\"extra_b3\"] = f32(np.concatenate([S[\"extra_b3\"], [0, -cap]]))\n    S[\"extra_W4\"] = f32(np.concatenate([S[\"extra_W4\"], [[1], [-1]]], 0))\n    s.save(S, out); print(\"saved\", out)\n"}}}
