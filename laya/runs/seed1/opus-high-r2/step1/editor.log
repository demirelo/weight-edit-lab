(z):\n        v = f(Z[:, slots]).ravel()\n        print(f'{nm:22s} n={v.size:4d} min {v.min():+.2f} p10 {np.percentile(v, 10):+.2f} p50 {np.median(v):+.2f} p90 {np.percentile(v, 90):+.2f} max {v.max():+.2f}')\n    sys.exit()\ntheta = float(sys.argv[2]); ramp = 0.15; cap = 5.0\n# raw-space unit: for raw x, x - mean(x) = std(x) * z, so w0.x = std * w.z when sum(w0) = 0.\n# The constant (w.mu + mid + theta) is carried by mu0.x / |mu|^2 = std * (mu.z)/|mu|^2 ~ std, so the\n# unit is scale free: pre = std * (f(z) - theta) up to the small spread of mu.z.\nw0 = w - w.mean(); mu0 = mu - mu.mean()\nk = (w @ mu + mid + theta) / (mu @ mu)\ncol = w0 - k * mu0\nSTD_LO = 150.0                                   # smallest raw std seen is ~156\ng = cap / (STD_LO * ramp)\nS = s.load(WD + '/scorer_in.npz')\nS['extra_W0'] = col[:, None].astype(np.float32); S['extra_b0'] = np.zeros(1, np.float32)\nS['extra_W1'] = np.array([[g, g]], np.float32); S['extra_b1'] = np.array([0.0, -cap], np.float32)\nS['extra_W2'] = np.array([[1.0], [-1.0]], np.float32); S['extra_b2'] = np.zeros(1, np.float32)\nout = sys.argv[3] if len(sys.argv) > 3 else SP + '/cand.npz'\ns.save(S, out); print('saved', out)\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011SkiByixd1QdHcLY8phkez","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
