ean(0); vB = R(PB)[:, 3].mean(0) - R(NB)[:, 3].mean(0)\n    rel = float(vA @ vB / np.linalg.norm(vA) / np.linalg.norm(vB))\n    vn = vA / np.linalg.norm(vA)\n    pP = R(PB)[:, 3] @ vn; pN = R(NB)[:, 3] @ vn; pF = R(FEE)[:, 3] @ vn\n    pE = R(E)[:, 3] @ vn\n    # also other options of POS messages (should NOT be boosted; content will be present though)\n    # option direction split-half\n    A_ = R(ALL); d = A_[:, 3] - np.delete(A_, 3, 1).mean(1)\n    n = len(d); dA = d[:n // 2].mean(0); dB = d[n // 2:].mean(0)\n    orel = float(dA @ dB / np.linalg.norm(dA) / np.linalg.norm(dB)); dn = dA / np.linalg.norm(dA)\n    po = A_[n // 2:] @ dn; pf = po[:, 3]; pother = np.delete(po, 3, 1).ravel()\n    peo = R(E) @ dn\n    print(f'== {label} ==')\n    print(f'  content split-half cos {rel:.2f} | heldout AUC pos-vs-neg {auc(pP,pN):.3f} | POS [{pP.min():.2f},{pP.max():.2f}] NEG [{pN.min():.2f},{pN.max():.2f}] FEE [{pF.min():.2f},{pF.max():.2f}]')\n    print(f'     NEG 95% {np.quantile(pN,.95):.2f} max {pN.max():.2f} | POS 5% {np.quantile(pP,.05):.2f} min {pP.min():.2f} | EVfx [{pE[tgt].min():.2f},{pE[tgt].max():.2f}] EVother [{pE[~tgt].min():.2f},{pE[~tgt].max():.2f}] AUC ev {auc(pE[tgt], pE[~tgt & (lab!=\"fees_fx\")]):.3f}')\n    print(f'  option split-half cos {orel:.2f} | AUC fees-vs-other {auc(pf,pother):.3f} | fees [{pf.min():.2f},{pf.max():.2f}] other [{pother.min():.2f},{pother.max():.2f}] | evid fees [{peo[:,3].min():.2f},{peo[:,3].max():.2f}] other max {np.delete(peo,3,1).max():.2f}')\n    print(f'  cos(content, option) {float(vn@dn):.2f}')\n\nfor K in [0, 2, 3, 4, 6, 10, 20]:\n    report(f'raw minus top{K}', make_space(lambda X: X, K))\nfor K in [0, 2, 4, 6, 10, 20]:\n    report(f'LN minus top{K}', make_space(LN, K))\nfor K in [0, 2, 4, 10]:\n    report(f'hidden minus top{K}', make_space(hidden, K))\n"}}}
