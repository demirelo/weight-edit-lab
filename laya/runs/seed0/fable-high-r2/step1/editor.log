{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgiHnLHVHGc9bNTATFs4h","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0135mfGJweonYXbXfq6tTtGd","name":"Write","input":{"file_path":"<tmp>","content":"import sys, csv, os, numpy as np\nTASK = '$WSROOT/laya/s0/fable-high-r2/step1'\nsys.path.insert(0, TASK); sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom scorer import *\nfrom msgs import *; from msgs2 import *\nS = load(f'{TASK}/scorer_in.npz')\nG = np.load('groups.npz'); G2 = np.load('groups2.npz')\nPOS = np.concatenate([G['POS'], G2['POS2']]); DISP = np.concatenate([G['NEG_DISP'], G2['NEG_DISP2']])\nOTH = np.concatenate([G['NEG_OTHER'], G2['NEG_MIX2']]); FEE = G['NEG_FEE']; NEG = np.concatenate([DISP, OTH])\nE = np.load(f'{TASK}/evidence_M.npz')['M']\nrows = list(csv.DictReader(open(f'{TASK}/evidence.csv'), delimiter='\\t'))\nlab = np.array([r['correct'] for r in rows]); base = np.array(predict(S, E))\nnp.set_printoptions(precision=2, suppress=True, linewidth=160)\nALL = np.concatenate([POS, NEG, FEE])\ndef auc(p, n): return (p[:, None] > n[None, :]).mean()\nLp, Ln, Lf, Le = logits(S, POS), logits(S, NEG), logits(S, FEE), logits(S, E)\nprint('scorer z_fees alone: AUC POS vs NEG', auc(Lp[:, 3], Ln[:, 3]), ' POS vs DISP', auc(Lp[:, 3], logits(S, DISP)[:, 3]))\nprint('scorer margin (z_fees - z_disp): AUC POS vs NEG', auc(Lp[:, 3] - Lp[:, 1], Ln[:, 3] - Ln[:, 1]))\n\n# subspaces\nmsg_mean = ALL.mean(1)                       # [n,1024] option-averaged (junk + mean content)\ndev = (ALL - msg_mean[:, None]).reshape(-1, 1024)  # within-message deviations (content only)\nmu = ALL.reshape(-1, 1024).mean(0)\n_, sJ, VJ = np.linalg.svd(msg_mean - msg_mean.mean(0), full_matrices=False)\n_, sC, VC = np.linalg.svd(dev, full_matrices=False)\nevJ = sJ**2 / (sJ**2).sum(); evC = sC**2 / (sC**2).sum()\nprint('junk PCA ev', evJ[:6], 'cum10', evJ[:10].sum(), 'cum40', evJ[:40].sum())\nprint('content PCA ev', evC[:6], 'cum10', evC[:10].sum(), 'cum40', evC[:40].sum(), 'cum100', evC[:100].sum())\n# overlap between junk top PCs and content top PCs\nov = VJ[:20] @ VC[:20].T; print('max |cos| junk20 vs content20', np.abs(ov).max())\n\ndef evaluate(label, w, b_shift=0.0):\n    # w raw-space direction (unit), score = (X - mu) @ w\n    sP = (POS - mu) @ w; sN = (NEG - mu) @ w; sF = (FEE - mu) @ w; sE = (E - mu) @ w\n    a1 = auc(sP[:, 3], sN[:, 3]); a2 = auc(sP[:, 3], np.delete(sP, 3, 1).ravel()); a3 = auc(sP[:, 3], sN.ravel())\n    tg = (lab == 'fees_fx') & (base != 'fees_fx')\n    a4 = auc(sE[tg, 3], sE[lab != 'fees_fx'].ravel())\n    # separation in sd units\n    d = (sP[:, 3].mean() - sN[:, 3].mean()) / np.sqrt(0.5 * (sP[:, 3].var() + sN[:, 3].var()))\n    print(f'{label:34s} AUC fx: POSvNEGfx {a1:.3f} POSvPOSother {a2:.3f} POSvNEGall {a3:.3f} EV {a4:.3f} | d\\' {d:.2f} | POSfx mean {sP[:,3].mean():.2f} NEGfx mean {sN[:,3].mean():.2f} sd {sN[:,3].std():.2f} NEGall max {sN.max():.2f} POSother max {np.delete(sP,3,1).max():.2f}')\n    return sP, sN, sF, sE\n\nv_raw = POS[:, 3].mean(0) - NEG[:, 3].mean(0)\nv_pair = POS[:, 3].mean(0) - np.concatenate([np.delete(POS, 3, 1).reshape(-1, 1024), NEG.reshape(-1, 1024)]).mean(0)\nfor vname, v in [('v_raw', v_raw), ('v_pair', v_pair)]:\n    for k in [5, 10, 20, 40, 80, 160]:\n        C = VC[:k]; w = C.T @ (C @ v); w /= np.linalg.norm(w)\n        evaluate(f'{vname} in content top{k}', w)\n    for K in [10, 20, 40]:\n        w = v - VJ[:K].T @ (VJ[:K] @ v); w /= np.linalg.norm(w)\n        evaluate(f'{vname} minus junk top{K}', w)\n    for K, k in [(10, 40), (20, 40), (20, 80), (40, 80)]:\n        w = v - VJ[:K].T @ (VJ[:K] @ v); C = VC[:k]; w = C.T @ (C @ w); w /= np.linalg.norm(w)\n        evaluate(f'{vname} -junk{K} in content{k}', w)\nnp.savez('subspaces.npz', VJ=VJ[:100], VC=VC[:200], mu=mu)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_in