] @ vn; pN = R(NB)[:, 3] @ vn; pF = R(FEE)[:, 3] @ vn; pE = R(E)[:, 3] @ vn\n    A_ = R(ALL); d = A_[:, 3] - np.delete(A_, 3, 1).mean(1); n = len(d)\n    dA = d[:n // 2].mean(0); dB = d[n // 2:].mean(0)\n    orel = float(dA @ dB / np.linalg.norm(dA) / np.linalg.norm(dB)); dn = dA / np.linalg.norm(dA)\n    po = A_[n // 2:] @ dn; pf = po[:, 3]; pother = np.delete(po, 3, 1).ravel(); peo = R(E) @ dn\n    print(f'== {label} ==')\n    print(f'  content rel {rel:.2f} AUC ho {auc(pP,pN):.3f} AUC ev {auc(pE[tgt], pE[~tgt & (lab!=\"fees_fx\")]):.3f} | POS [{pP.min():.2f},{pP.max():.2f}] NEG [{pN.min():.2f},{pN.max():.2f}] NEG95 {np.quantile(pN,.95):.2f} POS5 {np.quantile(pP,.05):.2f} | EVfx [{pE[tgt].min():.2f},{pE[tgt].max():.2f}] EVoth [{pE[~tgt].min():.2f},{pE[~tgt].max():.2f}]')\n    print(f'  option rel {orel:.2f} AUC {auc(pf,pother):.3f} | fees [{pf.min():.2f},{pf.max():.2f}] other [{pother.min():.2f},{pother.max():.2f}] evid fees min {peo[:,3].min():.2f} other max {np.delete(peo,3,1).max():.2f} | cos(c,o) {float(vn@dn):.2f}')\n# kNN diagnostic (cosine) in each space: leave-one-out on fees_fx option vectors, POS vs NEG\ndef knn(label, R, k=5):\n    X = np.concatenate([R(POS)[:, 3], R(NEG)[:, 3]]); y = np.r_[np.ones(60), np.zeros(105)]\n    Xn = X / np.linalg.norm(X, axis=1, keepdims=True); C = Xn @ Xn.T; np.fill_diagonal(C, -9)\n    nn = np.argsort(-C, axis=1)[:, :k]; pred = y[nn].mean(1) > 0.5\n    print(f'  kNN LOO acc {label}: {(pred==y).mean():.3f}  (pos recall {(pred[y==1]).mean():.2f}, neg spec {(1-pred[y==0]).mean():.2f})')\nfor K in [0, 1, 2, 3, 4, 6, 10, 20, 40]:\n    R, ev = make_space(lambda X: X, K); report(f'raw z-scored minus top{K} (ev top {ev[:3]})', R); knn('', R)\nfor K in [0, 2, 4, 10, 20]:\n    R, ev = make_space(LN, K); report(f'LN z-scored minus top{K} (ev top {ev[:3]})', R); knn('', R)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_token