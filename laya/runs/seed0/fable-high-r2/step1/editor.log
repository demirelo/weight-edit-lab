ets = [('POS', POS, 'fx'), ('HP', HP, 'fx'), ('DISP', DISP, 'keep'), ('OTH', OTH, 'keep'), ('HN', HN, 'keep'), ('CURQ', CURQ, 'keep'), ('FEE', FEE, 'keep'), ('HF', HF, 'keep')]\nbaseP = {n: np.array(predict(S, X)) for n, X, _ in sets}; baseE = np.array(predict(S, E))\nprint('base routing: CURQ->fees', (baseP['CURQ'] == 'fees_fx').sum(), '/30  FEE->fees', (baseP['FEE'] == 'fees_fx').sum(), '/8  HF->fees', (baseP['HF'] == 'fees_fx').sum(), '/5')\ndef run(S2):\n    out = {}\n    for n, X, kind in sets:\n        p = np.array(predict(S2, X))\n        out[n] = (p == 'fees_fx').sum() if kind == 'fx' else (p != baseP[n]).sum()\n    pE = np.array(predict(S2, E)); out['Eacc'] = (pE == lab).sum(); out['Eflip'] = ((pE != baseE) & (lab != 'fees_fx')).sum()\n    return out\ndef line(tag, o):\n    print(f'{tag:40s} E {o[\"Eacc\"]:2d}/32 (nonfx flips {o[\"Eflip\"]}) | rec POS {o[\"POS\"]:2d}/60 HP {o[\"HP\"]:2d}/25 | flips DISP {o[\"DISP\"]:2d}/55 OTH {o[\"OTH\"]:2d}/50 HN {o[\"HN\"]:2d}/40 | CURQ {o[\"CURQ\"]:2d}/30 FEE {o[\"FEE\"]}/8 HF {o[\"HF\"]}/5')\nprint('=== single v_pair ===')\nfor t in [4.5, 5.0, 5.5]:\n    for g in [2.0, 3.0]: line(f'v_pair t={t} g={g}', run(module_single(F['v_pair'], t, g)))\nprint('=== single v_pos ===')\nfor t in [1.0, 2.0, 3.0]:\n    for g in [1.0, 2.0]: line(f'v_pos t={t} g={g}', run(module_single(F['v_pos'], t, g)))\nprint('=== AND(v_pair>t1, v_fx>t2) ===')\nfor t1 in [3.5, 4.0, 4.5, 5.0]:\n    for t2 in [0.5, 1.0, 1.5, 2.0, 2.5]:\n        for g in [2.0, 4.0]: line(f'AND pair>{t1} fx>{t2} g={g}', run(module_and(F['v_pair'], t1, F['v_fx'], t2, g)))\n"}}}
