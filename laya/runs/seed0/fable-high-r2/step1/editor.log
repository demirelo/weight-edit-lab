{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgiHP85NfQQz5ZFRt95Md","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EZxzcguDedA7nnJ2DSdFYe","name":"Write","input":{"file_path":"<tmp>","content":"import sys, csv, os, numpy as np\nTASK = '$WSROOT/laya/s0/fable-high-r2/step1'\nsys.path.insert(0, TASK); sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom scorer import *\nS = load(f'{TASK}/scorer_in.npz')\nG = np.load('groups.npz'); G2 = np.load('groups2.npz')\nPOS = np.concatenate([G['POS'], G2['POS2']])            # 60\nNEG = np.concatenate([G['NEG_DISP'], G2['NEG_DISP2'], G['NEG_OTHER'], G2['NEG_MIX2']])  # 105\nFEE = G['NEG_FEE']\nE = np.load(f'{TASK}/evidence_M.npz')['M']\nrows = list(csv.DictReader(open(f'{TASK}/evidence.csv'), delimiter='\\t'))\nlab = np.array([r['correct'] for r in rows]); base = np.array(predict(S, E))\ntgt = (lab == 'fees_fx') & (base != 'fees_fx')\nnp.set_printoptions(precision=2, suppress=True, linewidth=160)\nALL = np.concatenate([POS, NEG, FEE])\nrng = np.random.default_rng(0)\nia = rng.permutation(60); ib = rng.permutation(105)\nPA, PB = POS[ia[:30]], POS[ia[30:]]; NA, NB = NEG[ib[:52]], NEG[ib[52:]]\n\ndef LN(X):\n    mu = X.mean(-1, keepdims=True); var = X.var(-1, keepdims=True)\n    return (X - mu) / np.sqrt(var + 1e-5)\ndef hidden(X):\n    h = LN(X) * S['ln_w'] + S['ln_b']\n    return gelu(h @ S['W1'] + S['b1'])\ndef make_space(base_fn, K):\n    flat = base_fn(ALL).reshape(-1, 1024); mu = flat.mean(0)\n    _, s, Vt = np.linalg.svd(flat - mu, full_matrices=False)\n    P = np.eye(1024) - Vt[:K].T @ Vt[:K] if K else np.eye(1024)\n    return lambda X: (base_fn(X) - mu) @ P\n\ndef auc(pos, neg):\n    return (pos[:, None] > neg[None, :]).mean()\n\ndef report(label, R):\n    vA = R(PA)[:, 3].mean(0) - R(NA)[:, 3].mean(0); vB = R(PB)[:, 3].mean(0) - R(NB)[:, 3].mean(0)\n    rel = float(vA @ vB / np.linalg.norm(vA) / np.linalg.norm(vB))\n    vn = vA / np.linalg.norm(vA)\n    pP = R(PB)[:, 3] @ vn; pN = R(NB)[:, 3] @ vn; pF = R(FEE)[:, 3] @ vn\n    pE = R(E)[:, 3] @ vn\n    # also other options of POS messages (should NOT be boosted; content will be present though)\n    # option direction split-half\n    A_ = R(ALL); d = A_[:, 3] - np.delete(A_, 3, 1).mean(1)\n    n = len(d); dA = d[:n // 2].mean(0); dB = d[n // 2:].mean(0)\n    orel = float(dA @ dB / np.linalg.norm(dA) / np.linalg.norm(dB)); dn = dA / np.linalg.norm(dA)\n    po = A_[n // 2:] @ dn; pf = po[:, 3]; pother = np.delete(po, 3, 1).ravel()\n    peo = R(E) @ dn\n    print(f'== {label} ==')\n    print(f'  content split-half cos {rel:.2f} | heldout AUC pos-vs-neg {auc(pP,pN):.3f} | POS [{pP.min():.2f},{pP.max():.2f}] NEG [{pN.min():.2f},{pN.max():.2f}] FEE [{pF.min():.2f},{pF.max():.2f}]')\n    print(f'     NEG 95% {np.quantile(pN,.95):.2f} max {pN.max():.2f} | POS 5% {np.quantile(pP,.05):.2f} min {pP.min():.2f} | EVfx [{pE[tgt].min():.2f},{pE[tgt].max():.2f}] EVother [{pE[~tgt].min():.2f},{pE[~tgt].max():.2f}] AUC ev {auc(pE[tgt], pE[~tgt & (lab!=\"fees_fx\")]):.3f}')\n    print(f'  option split-half cos {orel:.2f} | AUC fees-vs-other {auc(pf,pother):.3f} | fees [{pf.min():.2f},{pf.max():.2f}] other [{pother.min():.2f},{pother.max():.2f}] | evid fees [{peo[:,3].min():.2f},{peo[:,3].max():.2f}] other max {np.delete(peo,3,1).max():.2f}')\n    print(f'  cos(content, option) {float(vn@dn):.2f}')\n\nfor K in [0, 2, 3, 4, 6, 10, 20]:\n    report(f'raw minus top{K}', make_space(lambda X: X, K))\nfor K in [0, 2, 4, 6, 10, 20]:\n    report(f'LN minus top{K}', make_space(LN, K))\nfor K in [0, 2, 4, 10]:\n    report(f'hidden minus top{K}', make_space(hidden, K))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":425,"cache_read_input_tokens":127263,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":425},"output_tokens":8,"service_tier":"standard",