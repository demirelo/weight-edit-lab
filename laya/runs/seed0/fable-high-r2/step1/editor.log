{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgiHZFnW4pQAPx775WzRx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01N2ewjvQhbPD1jYyTFt6tu3","name":"Write","input":{"file_path":"<tmp>","content":"import sys, csv, os, numpy as np\nTASK = '$WSROOT/laya/s0/fable-high-r2/step1'\nsys.path.insert(0, TASK); sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom scorer import *\nS = load(f'{TASK}/scorer_in.npz')\nG = np.load('groups.npz'); G2 = np.load('groups2.npz')\nPOS = np.concatenate([G['POS'], G2['POS2']]); DISP = np.concatenate([G['NEG_DISP'], G2['NEG_DISP2']])\nOTH = np.concatenate([G['NEG_OTHER'], G2['NEG_MIX2']]); FEE = G['NEG_FEE']\nNEG = np.concatenate([DISP, OTH])\nE = np.load(f'{TASK}/evidence_M.npz')['M']\nrows = list(csv.DictReader(open(f'{TASK}/evidence.csv'), delimiter='\\t'))\nlab = np.array([r['correct'] for r in rows]); base = np.array(predict(S, E))\ntgt = (lab == 'fees_fx') & (base != 'fees_fx'); evneg = (lab != 'fees_fx')\nnp.set_printoptions(precision=2, suppress=True, linewidth=160)\nALL = np.concatenate([POS, NEG, FEE])\ndef LN(X):\n    mu = X.mean(-1, keepdims=True); var = X.var(-1, keepdims=True)\n    return (X - mu) / np.sqrt(var + 1e-5)\ndef auc(p, n): return (p[:, None] > n[None, :]).mean()\ndef knn(X, y, k=5):\n    Xn = X / np.linalg.norm(X, axis=1, keepdims=True); C = Xn @ Xn.T; np.fill_diagonal(C, -9)\n    nn = np.argsort(-C, axis=1)[:, :k]; pred = y[nn].mean(1) > 0.5\n    return (pred == y).mean()\nprint('== per-option kNN POS vs DISP / POS vs NEG (raw cosine) ==')\nfor o in range(5):\n    X = np.concatenate([POS[:, o], DISP[:, o]]); y = np.r_[np.ones(60), np.zeros(55)]\n    X2 = np.concatenate([POS[:, o], NEG[:, o]]); y2 = np.r_[np.ones(60), np.zeros(105)]\n    print(f'  opt {DEPTS[o]:17s} POSvDISP {knn(X,y):.2f}  POSvNEG {knn(X2,y2):.2f}')\nrng = np.random.default_rng(1)\nia = rng.permutation(60); ib = rng.permutation(105)\nPA, PB = POS[ia[:30]], POS[ia[30:]]; NA, NB = NEG[ib[:52]], NEG[ib[52:]]\ndef make_space(base_fn, K, z):\n    flat = base_fn(ALL).reshape(-1, 1024); mu = flat.mean(0); sd = flat.std(0) if z else np.ones(1024)\n    zf = (flat - mu) / sd; _, s, Vt = np.linalg.svd(zf, full_matrices=False)\n    P = np.eye(1024) - Vt[:K].T @ Vt[:K] if K else np.eye(1024)\n    return lambda X: ((base_fn(X) - mu) / sd) @ P\ndef report(label, R, split=True):\n    # positives: (FX msg, fees opt); negatives: other opts of FX msgs + all opts of NEG msgs\n    posA = R(PA)[:, 3]; negA = np.concatenate([np.delete(R(PA), 3, 1).reshape(-1, 1024), R(NA).reshape(-1, 1024)])\n    v = posA.mean(0) - negA.mean(0)\n    posB = R(PB)[:, 3]; negB_fxother = np.delete(R(PB), 3, 1).reshape(-1, 1024); negB_neg = R(NB).reshape(-1, 1024)\n    vB = posB.mean(0) - np.concatenate([negB_fxother, negB_neg]).mean(0)\n    rel = float(v @ vB / np.linalg.norm(v) / np.linalg.norm(vB)); vn = v / np.linalg.norm(v)\n    pP = posB @ vn; pFo = negB_fxother @ vn; pN = negB_neg @ vn; pNfx = R(NB)[:, 3] @ vn\n    pE = R(E) @ vn\n    print(f'== {label} == rel {rel:.2f}')\n    print(f'   AUC pos vs FXmsg-otheropts {auc(pP,pFo):.3f} | pos vs NEG-allopts {auc(pP,pN):.3f} | pos vs NEG-fxopt {auc(pP,pNfx):.3f}')\n    print(f'   POS [{pP.min():.2f},{pP.max():.2f}] P5 {np.quantile(pP,.05):.2f} | FXother [{pFo.min():.2f},{pFo.max():.2f}] 95 {np.quantile(pFo,.95):.2f} | NEG [{pN.min():.2f},{pN.max():.2f}] 95 {np.quantile(pN,.95):.2f}')\n    print(f'   EV fx-misrouted fxopt [{pE[tgt,3].min():.2f},{pE[tgt,3].max():.2f}] | EV fx-misrouted otheropts max {np.delete(pE[tgt],3,1).max():.2f} | EV neg allopts max {pE[evneg].max():.2f} | AUC ev {auc(pE[tgt,3], pE[evneg].ravel()):.3f}')\nfor z in [False, True]:\n    for K in [0, 2, 4, 10, 20]:\n        report(f'raw z={z} minus top{K}', make_space(lambda X: X, K, z))\nfor K in [0, 2, 4, 10, 20]:\n    report(f'LN z=True minus top{K}', make_space(LN, K, True))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":nu