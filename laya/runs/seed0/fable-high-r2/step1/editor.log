PTS[o], round(pu[:, o].min(), 2), round(pu[:, o].max(), 2))\npe = LN(E) @ dmn\nprint('  evidence: fees opt min', pe[:, 3].min(), 'others max', np.delete(pe, 3, 1).max())\n# option identity directions for each option vs pooled mean\nOm = A.mean(0)  # [5,1024]\nOc = Om - Om.mean(0)\nprint('option centroid norms (LN)', np.linalg.norm(Oc, axis=1))\nG_ = Oc @ Oc.T / np.outer(np.linalg.norm(Oc, axis=1), np.linalg.norm(Oc, axis=1)); print('option centroid cos matrix\\n', G_)\nnp.save('opt_centroids_ln.npy', Om)\n\n# content direction in LN space\nPtr, Pho = G['POS'][:20], G['POS'][20:]\nNtr, Nho = G['NEG_DISP'][:17], G['NEG_DISP'][17:]\nv = LN(Ptr)[:, 3].mean(0) - LN(Ntr)[:, 3].mean(0); vn = v / np.linalg.norm(v)\nprint('== content dir LN (fx opt) ==', 'norm', np.linalg.norm(v), 'cos with opt dir', float(vn @ dmn))\nfor name, X in [('POS tr', Ptr), ('POS ho', Pho), ('NEG_DISP tr', Ntr), ('NEG_DISP ho', Nho), ('NEG_FEE', G['NEG_FEE']), ('NEG_OTHER', G['NEG_OTHER'])]:\n    p = LN(X) @ vn\n    print(f'  {name:12s} fxopt: min {p[:,3].min():6.2f} max {p[:,3].max():6.2f} | otheropts: min {np.delete(p,3,1).min():6.2f} max {np.delete(p,3,1).max():6.2f}')\np = LN(E) @ vn\nlab = np.array([r['correct'] for r in rows]); base = np.array(predict(S, E))\ntgt = (lab == 'fees_fx') & (base != 'fees_fx')\nprint('  evidence misrouted-fx fxopt proj:', np.sort(p[tgt, 3]))\nprint('  evidence other fxopt proj      :', np.sort(p[~tgt, 3]))\n# denoised: project v onto top-k PCs\nfor k in [10, 20, 40, 80]:\n    vk = Vt[:k].T @ (Vt[:k] @ v); vkn = vk / np.linalg.norm(vk)\n    out = []\n    for name, X in [('POSho', Pho), ('NDho', Nho), ('NOTH', G['NEG_OTHER'])]:\n        pp = LN(X)[:, 3] @ vkn; out.append(f'{name} [{pp.min():.1f},{pp.max():.1f}]')\n    pp = LN(E)[:, 3] @ vkn\n    out.append(f'EVfx [{pp[tgt].min():.1f},{pp[tgt].max():.1f}] EVoth [{pp[~tgt].min():.1f},{pp[~tgt].max():.1f}]')\n    print(f'  k={k:3d} keep {np.linalg.norm(vk)/np.linalg.norm(v):.2f}:', ' '.join(out))\n"},"caller":{"type":"