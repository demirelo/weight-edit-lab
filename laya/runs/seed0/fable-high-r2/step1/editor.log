t(sE[lab==\"fees_fx\",3])}')\nprint(f'   EV disputes fx-opt   : {np.sort(sE[lab==\"disputes\",3])}')\nprint(f'   HO_NEG top fx-opt    : {np.sort(sHN[:,3])[-8:]}')\nprint(f'   FEE/HO_FEEFX fx-opt  : {np.sort(np.r_[sF[:,3], sHF[:,3]])}')\ndef make(theta, gain):\n    S2 = dict(S)\n    S2['extra_W0'] = w[:, None].astype(np.float32)\n    S2['extra_b0'] = np.array([-(mu @ w) - theta], dtype=np.float32)\n    S2['extra_W1'] = np.array([[gain]], dtype=np.float32)\n    S2['extra_b1'] = np.array([0.0], dtype=np.float32)\n    return S2\nbaseP = {n: np.array(predict(S, X)) for n, X in [('POS', POS), ('NEG', NEG), ('FEE', FEE), ('HP', HP), ('HN', HN), ('HF', HF), ('E', E)]}\nprint('base: POS->fees', (baseP['POS'] == 'fees_fx').sum(), '/60; HP->fees', (baseP['HP'] == 'fees_fx').sum(), '/25; E acc', (baseP['E'] == lab).sum(), '/32')\nprint(f'{\"theta\":>6s} {\"gain\":>5s} | {\"E acc\":>6s} | {\"POS rec\":>7s} {\"HP rec\":>6s} | {\"NEG flip\":>8s} {\"HN flip\":>7s} {\"FEE flip\":>8s} {\"HF flip\":>7s} | {\"E nonfx flip\":>12s}')\nfor theta in [3.5, 4.0, 4.5, 5.0, 5.5, 6.0]:\n    for gain in [1.0, 1.5, 2.0, 3.0]:\n        S2 = make(theta, gain)\n        P = {n: np.array(predict(S2, X)) for n, X in [('POS', POS), ('NEG', NEG), ('FEE', FEE), ('HP', HP), ('HN', HN), ('HF', HF), ('E', E)]}\n        eacc = (P['E'] == lab).sum()\n        print(f'{theta:6.1f} {gain:5.1f} | {eacc:3d}/32 | {(P[\"POS\"]==\"fees_fx\").sum():4d}/60 {(P[\"HP\"]==\"fees_fx\").sum():3d}/25 | {(P[\"NEG\"]!=baseP[\"NEG\"]).sum():4d}/105 {(P[\"HN\"]!=baseP[\"HN\"]).sum():3d}/40 {(P[\"FEE\"]!=baseP[\"FEE\"]).sum():4d}/8 {(P[\"HF\"]!=baseP[\"HF\"]).sum():3d}/5 | {((P[\"E\"]!=baseP[\"E\"]) & (lab!=\"fees_fx\")).sum():3d}')\nnp.savez(f'detector_K{K}.npz', w=w, mu=mu)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3156,"cache_read_input_tokens":182782,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephem