td():.2f} | POS other-opts max {np.delete(sP,3,1).max():.2f}')\nprint(f'      NEG fx [{sN[:,3].min():.2f},{sN[:,3].max():.2f}] mean {sN[:,3].mean():.2f} sd {sN[:,3].std():.2f} | NEG other-opts max {np.delete(sN,3,1).max():.2f}')\nprint(f'      FEE fx [{sF[:,3].min():.2f},{sF[:,3].max():.2f}] | FEE other max {np.delete(sF,3,1).max():.2f}')\nprint(f'      EV allopts max per label: fees_fx {sE[lab==\"fees_fx\"].max():.2f} disputes {sE[lab==\"disputes\"].max():.2f}')\nprint('  lowest POS (fx opt):')\nfor i in np.argsort(sP[:, 3])[:8]: print(f'     {sP[i,3]:6.2f}  {TXT_POS[i]}')\nprint('  highest NEG (any opt):')\nflatN = sN.ravel(); order = np.argsort(-flatN)[:12]\nfor j in order: print(f'     {flatN[j]:6.2f} opt={DEPTS[j%5]:16s} base={predict(S, NEG[j//5:j//5+1])[0]:16s} {TXT_NEG[j//5]}')\nprint('  highest FEE (any opt):')\nflatF = sF.ravel(); order = np.argsort(-flatF)[:5]\nfor j in order: print(f'     {flatF[j]:6.2f} opt={DEPTS[j%5]:16s} base={predict(S, FEE[j//5:j//5+1])[0]:16s} {TXT_FEE[j//5]}')\nprint('  evidence scores (fx opt) with base/label:')\nfor r, b, srow in zip(rows, base, sE): print(f'     {srow[3]:6.2f} othermax {np.delete(srow,3).max():6.2f} {r[\"correct\"][:8]:8s} base={b[:8]:8s} {r[\"text\"][:60]}')\nnp.savez(f'dir_K{K}.npz', w=w, mu=mu, vn=vn, P=P)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3632,"cache_read_input_tokens":154340,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3632},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d6b13ab4-e32b-4eff-8c06-713aef815ac1","uuid":"9a66da8d-747d-45bf-a634-8649bc979672","timestamp":"2026-11-04T17:34:01.642Z","request_id":"req_011CgiHgoD4kbQEFBXnCi33N","wire_tool_inputs":{"toolu_01Hm5QfgxjgqANNU6qLZieYH":{"fil