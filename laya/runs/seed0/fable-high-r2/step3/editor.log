apC > 0], [5, 10, 25, 50]), \" frac acc already top\", (gapC == 0).mean())\nprint(\"evidence ELIG gaps\", np.round((ZV.max(1) - ZV[:, ACC])[V_lab == \"account_security\"], 2))\n\n# --- 2. fit/eval with soft whitening\ndef fit(E, TE, C, k1, k2, lam_idx):\n    X = np.concatenate([E, C]).reshape(-1, 1024); g = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - g, full_matrices=False)\n    B = Vt[k1:k2]; var = ((X - g) @ B.T).var(0)\n    lam = ((X - g) @ Vt[lam_idx]).var() if lam_idx else 0.0\n    scale = 1 / np.sqrt(var + lam)\n    tr = lambda M: ((M - g) @ B.T) * scale\n    grp = groups(TE); dirs = {}\n    Ct = tr(C)[:, ACC]\n    for g_ in [\"age\", \"country\"]:\n        d = tr(E[grp == g_])[:, ACC].mean(0) - Ct.mean(0); d /= np.linalg.norm(d)\n        c = Ct @ d\n        dirs[g_] = (d, {\"p99\": np.percentile(c, 99), \"p995\": np.percentile(c, 99.5), \"max\": c.max(), \"max+\": c.max() + 0.1 * (c.max() - c.mean())})\n    return tr, dirs\ndef evaluate(tr, dirs, E, TE, C, TC, label, show=False):\n    grp = groups(TE)\n    for g_ in [\"age\", \"country\"]:\n        d, th = dirs[g_]\n        e = tr(E[grp == g_])[:, ACC] @ d; c = tr(C)[:, ACC] @ d\n        s = \" \".join(f\"{k}: R {(e > v).mean():.2f} FPR {(c > v).mean():.3f}\" for k, v in th.items())\n        print(f\"  [{label}] {g_}: {s}\")\n        if show:\n            fp = np.argsort(-c)[:8]\n            print(\"      top controls:\", [(round(float(c[i] - th['p99']), 2), TC[i][:40]) for i in fp])\n            miss = np.argsort(e)[:6]; te = [t for t, x in zip(TE, grp) if x == g_]\n            print(\"      lowest elig:\", [(round(float(e[i] - th['p99']), 2), te[i][:40]) for i in miss])\n\nev_e = MV[V_lab == \"account_security\"][:16]; ev_te = [t for t, l in zip(V_T, V_lab) if l == \"account_security\"][:16]\nev_c = MV[V_lab == \"cards\"]; ev_tc = [t for t, l in zip(V_T, V_lab) if l == \"cards\"]\nfor k1, k2, li in [(32, 512, None), (32, 512, 300), (32, 512, 450), (32, 768, 400), (32, 1024, 400), (32, 1024, 300), (32, 384, 