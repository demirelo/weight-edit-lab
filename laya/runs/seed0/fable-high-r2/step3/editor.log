gv[0]), float(argv[1]), float(argv[2]), int(argv[3]), int(argv[4]), argv[5]\nprint(\"BOOST\", BOOST, \"T_MARGIN\", T_MARGIN, \"W_RAMP\", W_RAMP, \"HOLDOUT\", HOLD, \"GROUPS\", NGROUPS, \"THR\", THR, \"batches\", sorted(BATCHES))\n# Controls that ask in which countries the card works: by the test's convention (evidence: \"What countries can I use\n# the card in?\" -> account_security) these are country-eligibility questions, so they are not valid negatives.\nAMBIG = {\"Can I use my card in Canada?\", \"Will my card work in Japan?\", \"Does the card work in all countries?\",\n         \"Can I use my card at an ATM in Spain?\", \"I'm travelling to Thailand, will my card work there?\",\n         \"Can I withdraw cash in Mexico with the card?\"}\ndef gather(keys):\n    E, TE, C, TC = [], [], [], []\n    for k in keys:\n        e, te, c, tc = BATCHES[k]; keep = [t not in AMBIG for t in tc]\n        E.append(e); TE += te; C.append(c[keep]); TC += [t for t in tc if t not in AMBIG]\n    return np.concatenate(E), TE, np.concatenate(C), TC\nME, TE, MC, TC = gather([k for k in BATCHES if k != HOLD])\nif HOLD: HE, HTE, HC, HTC = gather([HOLD])\nMV = np.load(f\"{TASK}/evidence_M.npz\")[\"M\"]\nrows = list(csv.DictReader(open(f\"{TASK}/evidence.csv\"), delimiter=\"\\t\"))\nV_lab = np.array([r[\"correct\"] for r in rows]); V_T = [r[\"text\"] for r in rows]\nACC = 4\nAGE = re.compile(r\"\\b(age|ages|old|adult\\w*|18|16|17|15|14|13|12|11|10|80|75|minors?|kids?|kid|child|children|son|daughter|nephew|grandson|teen\\w*|under|young\\w*|junior|pensioners?|elderly|grand\\w+|students?)\\b\", re.I)\nRESID = re.compile(r\"\\b(live|living|lives|based|moving|move|resident\\w*|residency|citizen\\w*|nationalit\\w*|passports?|address|expats?|tourists?|foreign\\w*|abroad|outside|non-UK|non-EU|from|I'm in|I am in|get a card|get one of your cards|your card|cards?)\\b\", re.I)\ndef group_of(t):\n    if AGE.search(t): return \"age\"\n    if NGROUPS == 3 and RESID.search(t): return \"resid\"\n    return \"country\"\ngrp = np.array([group_of(t) for t in TE])\nGROUPS = [\"age\", \"country\"] + ([\"resid\"] if NGROUPS == 3 else [])\nprint({g_: int((grp == g_).sum()) for g_ in GROUPS})\ndef threshold(c):\n    if THR == \"max\": return c.max()\n    if THR.startswith(\"p\"): return np.percentile(c, float(THR[1:]))\n    if THR.startswith(\"sd\"): return c.mean() + float(THR[2:]) * c.std()\n    return float(THR)\nK1, K2, KID = 32, 512, 8\n\n# --- unsupervised geometry from my own messages (all options)\nX = np.concatenate([ME, MC]).reshape(-1, 1024); g = X.mean(0)\nU, s, Vt = np.linalg.svd(X - g, full_matrices=False)\nB = Vt[K1:K2]; sdb = ((X - g) @ B.T).std(0) + 1e-6          # content band, each direction in units of its spread\nBi = Vt[KID:]; sdi = ((X - g) @ Bi.T).std(0) + 1e-6          # identity band\ntr = lambda M: ((M - g) @ B.T) / sdb\ntri = lambda M: ((M - g) @ Bi.T) / sdi\n\ncols, biases, names = [], [], []\ndef add_ramp(w_raw, b_raw, lo, hi, name):\n    \"\"\"Two ReLU units implementing clip((w.x + b - lo)/(hi-lo), 0, 1) via (relu(u - lo) - relu(u - hi))/(hi-lo).\"\"\"\n    cols.append(w_raw); biases.append(b_raw - lo); names.append(name + \"_hi\")\n    cols.append(w_raw); biases.append(b_raw - hi); names.append(name + \"_lo\")\n    return 1.0 / (hi - lo)\n\nramp_scale, DIRS = {}, {}\nCt = tr(MC)[:, ACC]\nfor g_ in GROUPS:\n    d = tr(ME[grp == g_])[:, ACC].mean(0) - Ct.mean(0); d /= np.linalg.norm(d)\n    c = Ct @ d; e = tr(ME[grp == g_])[:, ACC] @ d\n    t0 = threshold(c) + T_MARGIN * c.std(); t1 = t0 + W_RAMP * c.std()\n    DIRS[g_] = (d, t0, t1)\n    w_raw = (B.T @ (d / sdb)).astype(np.float32); b_raw = float(-(g @ w_raw))\n    print(f\"{g_}: n={int((grp==g_).sum())} ctrl acc proj mean {c.mean():.2f} sd {c.std():.2f} max {c.max():.2f} | elig acc proj mean {e.mean():.2f} min {e.min():.2f} | ramp [{t0:.2f}, {t1:.2f}] | elig frac > t0 {(e > t0).mean():.2f}, > t1 {(e > t1).mean():.2f}\")\n    top = np.argsort(-c)[:6]\n    print(\"    ctrl tail:\", [(round(float(c[i]), 2), TC[i][:38]) for i in top])\n    te_g = [t for t, x in zip(TE, grp) if x == g_]; low = np.argsort(e)[:6]\n    print(\"    elig low :\", [(round(float(e[i]), 2), te_g[i][:38]) for i in low])\n    ramp_scale[g_] = add_ramp(w_raw, b_raw, t0, t1, g_)\n\n# identity gate: acc option vs mean of other options, within-message difference, averaged over all messages\nA = tri(np.concatenate([ME, MC]))\ndi = (A[:, ACC] - A[:, :4].mean(1)).mean(0); di /= np.linalg.norm(di)\npa = A[:, ACC] @ di; po = A[:, :4] @ di\nprint(f\"identity: acc proj min {pa.min():.2f} p1 {np.percentile(pa,1):.2f} median {np.median(pa):.2f} | other opts max {po.max():.2f} p99 {np.percentile(po,99):.2f} median {np.median(po):.2f}\")\ni0 = po.max(); i1 = np.percentile(pa, 5)\nif i1 <= i0: i1 = i0 + 0.5\nw_raw = (Bi.T @ (di / sdi)).astype(np.float32); b_raw = float(-(g @ w_raw))\nprint(f\"identity ramp [{i0:.2f}, {i1:.2f}]; frac acc >= i1 {(pa >= i1).mean():.2f}; frac others > i0 {(po > i0).mean():.3f}\")\nramp_scale[\"id\"] = add_ramp(w_raw, b_raw, i0, i1, \"id\")\n\n# --- assemble: extend existing module (W0 1024x4, W1 4x2, W2 2x1) to (1024x10, 10x4, 4x1)\nW0o, b0o, W1o, b1o, W2o, b2o = S[\"extra_W0\"], S[\"extra_b0\"], S[\"extra_W1\"], S[\"extra_b1\"], S[\"extra_W2\"], S[\"extra_b2\"]\nn_old0, n_old1 = W0o.shape[1], W1o.shape[1]\nW0 = np.concatenate([W0o, np.stack(cols, 1)], 1).astype(np.float32)\nb0 = np.concatenate([b0o, np.array(biases, np.float32)]).astype(np.float32)\nNG = len(GROUPS)\nW1 = np.zeros((W0.shape[1], n_old1 + NG), np.float32); W1[:n_old0, :n_old1] = W1o\nb1 = np.concatenate([b1o, np.full(NG, -1.0, np.float32)]).astype(np.float32)\nidx = {n: n_old0 + i for i, n in enumerate(names)}\nfor j, g_ in enumerate(GROUPS):\n    col = n_old1 + j\n    W1[idx[g_ + \"_hi\"], col] = ramp_scale[g_]; W1[idx[g_ + \"_lo\"], col] = -ramp_scale[g_]\n    W1[idx[\"id_hi\"], col] = ramp_scale[\"id\"]; W1[idx[\"id_lo\"], col] = -ramp_scale[\"id\"]\nW2 = np.concatenate([W2o, np.full((NG, 1), BOOST, np.float32)], 0).astype(np.float32)\nb2 = b2o.astype(np.float32)\nS2 = dict(S); S2.update(extra_W0=W0, extra_b0=b0, extra_W1=W1, extra_b1=b1, extra_W2=W2, extra_b2=b2)\nif not HOLD:\n    sc.save(S2, f\"{TASK}/scorer_out.npz\"); S2 = sc.load(f\"{TASK}/scorer_out.npz\")\n    print(\"saved; shapes\", W0.shape, b0.shape, W1.shape, b1.shape, W2.shape, b2.shape)\n\n# --- verification by forward passes\ndef module_out(Sx, M):\n    return sc.logits(Sx, M) - sc.logits({k: v for k, v in Sx.items() if not k.startswith(\"extra\")}, M)\ndef report(E, TEx, C, TCx, label, verbose=False):\n    gx = np.array([\"age\" if AGE.search(t) else \"country\" for t in TEx])\n    P0e, P1e = np.array(sc.predict(S, E)), np.array(sc.predict(S2, E))\n    P0c, P1c = np.array(sc.predict(S, C)), np.array(sc.predict(S2, C))\n    print(f\"[{label}] ELIG ({len(TEx)}): to account_security before {np.mean(P0e=='account_security'):.2f} after {np.mean(P1e=='account_security'):.2f} | age {np.mean(P1e[gx=='age']=='account_security'):.2f} country {np.mean(P1e[gx=='country']=='account_security'):.2f}\")\n    flips = np.where(P0c != P1c)[0]\n    print(f\"[{label}] CTRL ({len(TCx)}): routing changed on {len(flips)} ({len(flips)/len(TCx):.3f})\")\n    for i in flips: print(\"     \", P0c[i], \"->\", P1c[i], TCx[i])\n    new = module_out(S2, C) - module_out(S, C)\n    print(f\"[{label}] new-unit output on CTRL: max per option {np.round(new.max(0), 3)}, rows > 0.05: {(new.max(1) > 0.05).sum()}\")\n    if verbose:\n        for i in np.where(new.max(1) > 0.05)[0]: print(\"      fires:\", np.round(new[i], 2), TCx[i])\nreport(ME, TE, MC, TC, \"fit set\")\nif HOLD: report(HE, HTE, HC, HTC, f\"held-out batch {HOLD}\", verbose=True)\nif os.path.exists(f\"{SP}/realneg.npz\"):\n    from msgs5 import REAL_NEG\n    RN = L(\"realneg\")\n    P0r, P1r = np.array(sc.predict(S, RN)), np.array(sc.predict(S2, RN))\n    newr = module_out(S2, RN) - module_out(S, RN)\n    fl = np.where(P0r != P1r)[0]\n    print(f\"[REALISTIC NEGATIVES, never fitted] ({len(REAL_NEG)}): routing changed on {len(fl)} ({len(fl)/len(REAL_NEG):.3f}); rows with new output > 0.05: {(newr.max(1) > 0.05).sum()}\")\n    for i in fl: print(\"      FLIP\", P0r[i], \"->\", P1r[i], REAL_NEG[i])\n    for i in np.where(newr.max(1) > 0.05)[0]:\n        if i not in fl: print(\"      fires (no flip):\", np.round(newr[i, ACC], 2), REAL_NEG[i])\n    TR = tr(RN)[:, ACC]\n    for g_ in DIRS:\n        p = TR @ DIRS[g_][0]; top = np.argsort(-p)[:4]\n        print(f\"      {g_} top realistic-negative scores (thr {DIRS[g_][1]:.2f}):\", [(round(float(p[i]), 2), REAL_NEG[i][:40]) for i in top])\nP0v, P1v = np.array(sc.predict(S, MV)), np.array(sc.predict(S2, MV))\nprint(f\"\\nEVIDENCE: acc before {np.mean(P0v == V_lab):.2f} ({(P0v == V_lab).sum()}/32) after {np.mean(P1v == V_lab):.2f} ({(P1v == V_lab).sum()}/32)\")\nnewv = module_out(S2, MV) - module_out(S, MV); TV = tr(MV); TIV = tri(MV); ZV = sc.logits(S, MV)\nfor t, l, a, b, nv, tv, tiv, z in zip(V_T, V_lab, P0v, P1v, newv, TV, TIV, ZV):\n    pr = \" \".join(f\"{g_}={tv[ACC] @ DIRS[g_][0]:5.2f}\" for g_ in DIRS)\n    print(f\"   {'OK ' if b == l else 'BAD'} {l[:8]:8s} {a[:8]:8s}->{b[:8]:8s} new_acc={nv[ACC]:4.2f} {pr} id={tiv[ACC] @ di:4.2f}/{(tiv[:4] @ di).max():4.2f} gap={z.max()-z[ACC]:4.2f} {t[:50]}\")\n","structuredPatch":[{"oldStart":31,"oldLines":7,"newStart":31,"newLines":7,"lines":["         E.append(e); TE += te; C.append(c[keep]); TC += [t for t in tc if t not in AMBIG]","     return np.concatenate(E), TE, np.concatenate(C), TC"," ME, TE, MC, TC = gather([k for k in BATCHES if k != HOLD])","-if HOLD: HE, HTE, HC, HTC = gather([HOLD])","+if HOLD > 0: HE, HTE, HC, HTC = gather([HOLD])      # HOLD = -1: fit on everything but do not save"," MV = np.load(f\"{TASK}/evidence_M.npz\")[\"M\"]"," rows = list(csv.DictReader(open(f\"{TASK}/evidence.csv\"), delimiter=\"\\t\"))"," V_lab = np.array([r[\"correct\"] for r in rows]); V_T = [r[\"text\"] for r in rows]"]}],"userModified":false,"replac