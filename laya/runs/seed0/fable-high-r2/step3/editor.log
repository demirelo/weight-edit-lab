{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgiNh1Kuvwdfip5aZuBxu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UpMfduvtCYRCJbRmrB9Hxr","name":"Write","input":{"file_path":"<tmp>","content":"import numpy as np, csv, sys, os, re\nSP = os.path.dirname(os.path.abspath(__file__))\nTASK = \"$WSROOT/laya/s0/fable-high-r2/step3\"\nsys.path.insert(0, TASK); sys.path.insert(0, SP)\nimport scorer as sc\nfrom msgs import ELIG, CONTROL\nfrom msgs2 import ELIG2, CONTROL2\nfrom pairs import PAIRS\nnp.set_printoptions(precision=2, suppress=True, linewidth=220)\nS = sc.load(f\"{TASK}/scorer_in.npz\")\nME = np.concatenate([np.load(f\"{SP}/elig.npz\")[\"M\"], np.load(f\"{SP}/elig2.npz\")[\"M\"], np.load(f\"{SP}/pairs_e.npz\")[\"M\"]])\nMC = np.concatenate([np.load(f\"{SP}/ctrl.npz\")[\"M\"], np.load(f\"{SP}/ctrl2.npz\")[\"M\"], np.load(f\"{SP}/pairs_c.npz\")[\"M\"]])\nTE = ELIG + ELIG2 + [p[0] for p in PAIRS]; TC = CONTROL + CONTROL2 + [p[1] for p in PAIRS]\nACC = 4\nnrm = np.linalg.norm(np.concatenate([ME, MC]), axis=-1)\nprint(\"per-vector rms by option: mean\", nrm.mean(0) / 32, \" cv\", (nrm.std(0) / nrm.mean(0)))\ndef ln(M):\n    m = M.mean(-1, keepdims=True); v = M.var(-1, keepdims=True)\n    return (M - m) / np.sqrt(v + 1e-5) * S[\"ln_w\"] + S[\"ln_b\"]\nAGE = re.compile(r\"\\b(age|old|18|16|17|15|14|13|12|10|80|75|minors?|kids?|child|children|son|daughter|teen\\w*|under|young\\w*|junior|pensioners?|elderly|grand\\w+|student)\\b\", re.I)\ngrp = np.array([\"age\" if AGE.search(t) else \"country\" for t in TE])\n\ndef loo_group(E, C, idx):\n    Cacc = C[:, ACC]; Cmean = Cacc.mean(0); tot = E[idx, ACC].sum(0)\n    projs = []; others = []\n    for i in idx:\n        d = (tot - E[i, ACC]) / (len(idx) - 1) - Cmean; d /= np.linalg.norm(d)\n        projs.append(E[i, ACC] @ d); others.append((E[i, :4] @ d).max())\n    d = tot / len(idx) - Cmean; d /= np.linalg.norm(d)\n    c = Cacc @ d; co = C[:, :4] @ d; projs = np.array(projs); others = np.array(others)\n    dp = (projs.mean() - c.mean()) / np.sqrt(0.5 * (projs.var() + c.var()))\n    return dp, (projs > np.percentile(c, 99)).mean(), (projs > np.percentile(c, 95)).mean(), (others < projs).mean()\ndef loo_identity(A):\n    diff = A[:, ACC] - A[:, :4].mean(1); tot = diff.sum(0); n = len(diff); margins = []\n    for i in range(n):\n        d = (tot - diff[i]) / (n - 1); d /= np.linalg.norm(d)\n        margins.append(A[i, ACC] @ d - (A[i, :4] @ d).max())\n    margins = np.array(margins)\n    return np.percentile(margins, 2), (margins > 0).mean()\n\nfor name, f in [(\"RAW\", lambda M: M), (\"LN\", ln)]:\n    FE, FC = f(ME), f(MC)\n    X = np.concatenate([FE, FC]).reshape(-1, 1024); g = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - g, full_matrices=False)\n    print(f\"\\n#### {name}\")\n    for k in [8, 16, 24, 32, 48, 64, 96]:\n        P = np.eye(1024) - Vt[:k].T @ Vt[:k]\n        sd = ((X - g) @ P).std(0) + 1e-6\n        tr = lambda M: ((M - g) @ P) / sd\n        E, C = tr(FE), tr(FC)\n        a = loo_group(E, C, np.where(grp == 'age')[0]); c = loo_group(E, C, np.where(grp == 'country')[0]); al = loo_group(E, C, np.arange(len(TE)))\n        idm = loo_identity(np.concatenate([E, C]))\n        print(f\"  k={k:3d}: age d'={a[0]:.2f} >p99 {a[1]:.2f} >p95 {a[2]:.2f} own {a[3]:.2f} | country d'={c[0]:.2f} >p99 {c[1]:.2f} >p95 {c[2]:.2f} own {c[3]:.2f} | all d'={al[0]:.2f} >p99 {al[1]:.2f} >p95 {al[2]:.2f} own {al[3]:.2f} | identity p2 {idm[0]:.2f} frac>0 {idm[1]:.2f}\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3024,"cache_read_input_tokens":171561,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3024},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_