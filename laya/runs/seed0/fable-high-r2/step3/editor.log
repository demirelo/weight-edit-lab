nt(\"   top CTRL acc:\")\n        for i in np.argsort(-c)[:10]: print(\"     \", round(float(c[i]), 1), TC[i])\n        print(\"   lowest ELIG acc:\")\n        for i in np.argsort(e)[:10]: print(\"     \", round(float(e[i]), 1), TE[i])\n        print(\"   EVIDENCE acc-option / cards-option proj:\")\n        for r, p in zip(rows, pv): print(\"     \", r[\"correct\"][:8], f\"{p[ACC]:6.1f} {p[0]:6.1f}\", r[\"text\"][:60])\n    return pe, pc, pv\n\nfor k in [0, 1, 2, 3, 5, 8, 12, 20, 30]:\n    d = c_raw.copy()\n    for j in range(k):\n        d -= (d @ Vt[j]) * Vt[j]\n    report(unit(d), f\"k={k}\", verbose=(k in (0, 5, 12)))\n\n# option identity direction for acc: CTRL messages that are not account-security themed\n# (indices of account_security controls in CONTROL: 44..53, in CONTROL2: 83..97)\nacc_idx = set(range(44, 54)) | set(range(len(CONTROL) + 83, len(CONTROL) + 98))\nkeep = [i for i in range(len(TC)) if i not in acc_idx]\nX = SC_[keep]\na_raw = X[:, ACC].mean(0) - X[:, :4].reshape(-1, 1024).mean(0)\na = unit(a_raw)\nprint(\"\\n== option-identity direction a (norm raw\", np.linalg.norm(a_raw), \") cos(a,c)\", a @ unit(c_raw))\nfor nm, P in [(\"ELIG\", SE @ a), (\"CTRL\", SC_ @ a), (\"EVID\", std(MV) @ a)]:\n    print(f\"  {nm}: acc min/mean {P[:, ACC].min():.1f}/{P[:, ACC].mean():.1f}   other opts max per opt {P[:, :4].max(0)}  mean {P[:, :4].mean(0)}\")\nnp.savez(f\"{SP}/dirs2.npz\", mu=mu, sd=sd, c_raw=c_raw, Vt=Vt[:40], a=a)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":427,"cache_read_input_tokens":106492,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":427},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"72b59b23-43a0-4f7b-a6ac-cebae3df10e8","uuid":"2b91ca01-84