\" + \" | \".join(out))\n\n# nearest neighbours in k=2 std space, acc option and cards option and mean\ntr = make_tr(2, True)\nALLM = np.concatenate([ME, MC, PE_, PC_]); ALLT = TE + TC + [p[0] for p in PAIRS] + [p[1] for p in PAIRS]\nlab = [\"E\"] * len(TE) + [\"C\"] * len(TC) + [\"E\"] * len(PAIRS) + [\"C\"] * len(PAIRS)\nA = tr(ALLM)\nfor name, V in [(\"acc\", A[:, 4]), (\"cards\", A[:, 0]), (\"mean\", A.mean(1))]:\n    Vn = V / np.linalg.norm(V, axis=1, keepdims=True); Cs = Vn @ Vn.T; np.fill_diagonal(Cs, -1)\n    # label purity of 5 nearest neighbours of each ELIG message\n    nn = np.argsort(-Cs, axis=1)[:, :5]\n    pur = np.mean([[lab[j] == lab[i] for j in nn[i]] for i in range(len(ALLT))])\n    print(f\"\\n{name}: 5-NN same-label purity over all msgs = {pur:.2f} (chance ~0.5)\")\n    for i in [0, 1, 8, 11, 40 + 20, 40 + 60]:\n        print(\"  \", ALLT[i][:45], \"->\", [ALLT[j][:35] for j in nn[i][:3]])\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3579,"cache_read_input_tokens":152302,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3579},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"72b59b23-43a0-4f7b-a6ac-cebae3df10e8","uuid":"bab24037-23da-450a-abd4-bdbf17f957b9","timestamp":"2026-11-04T18:36:33.307Z","request_id":"req_011CgiNV4jTBYL5UewZHjKF5","wire_tool_inputs":{"toolu_01AJabMHC2c75xQWcw6Ntk25":{"file_path":"<tmp>","content":"import numpy as np, csv, sys, os\nSP = os.path.dirname(os.path.abspath(__file__))\nTASK = \"$WSROOT/laya/s0/fable-high-r2/step3\"\nsys.path.insert(0, TASK); sys.path.insert(0, SP)\nfrom msgs import ELIG, CONTROL\nfrom msgs2 import ELIG2, CONTROL2\nfrom pairs import PAIRS\nnp.set_printoptions(precision=2, suppress=True, linewidth=220)