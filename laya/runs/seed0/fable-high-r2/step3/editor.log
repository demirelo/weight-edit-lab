 C[:, :4] @ d; projs = np.array(projs); others = np.array(others)\n    dp = (projs.mean() - c.mean()) / np.sqrt(0.5 * (projs.var() + c.var()))\n    return f\"d'={dp:.2f} >Cmax {(projs > c.max()).mean():.2f} >Cp99 {(projs > np.percentile(c, 99)).mean():.2f} ownother<acc {(others < projs).mean():.2f}\"\ndef loo_pairs(E, C):\n    diff = E[:, ACC] - C[:, ACC]; tot = diff.sum(0); n = len(diff)\n    hits = sum((diff[i] @ (tot - diff[i])) > 0 for i in range(n)) / n\n    d = diff / np.linalg.norm(diff, axis=1, keepdims=True); Cs = d @ d.T\n    return f\"pairs loo {hits:.2f} cos {(Cs.sum() - n) / (n * (n - 1)):.3f}\"\ndef loo_identity(A):\n    diff = A[:, ACC] - A[:, :4].mean(1); tot = diff.sum(0); n = len(diff); margins = []\n    for i in range(n):\n        d = (tot - diff[i]) / (n - 1); d /= np.linalg.norm(d)\n        margins.append(A[i, ACC] @ d - (A[i, :4] @ d).max())\n    margins = np.array(margins)\n    return f\"identity margin p5 {np.percentile(margins, 5):.2f} frac>0 {(margins > 0).mean():.2f}\"\n\nfor name, f in [(\"LN\", ln), (\"PRE\", pre)]:\n    FE, FC = f(ME), f(MC); FPE, FPC = f(PE_), f(PC_)\n    X = np.concatenate([FE, FC]).reshape(-1, 1024); g = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - g, full_matrices=False)\n    print(f\"\\n#### {name}: spectrum top 8 {s[:8]} frac top2 {(s[:2]**2).sum()/(s**2).sum():.3f}\")\n    for k in [0, 2, 4, 8, 16]:\n        P = np.eye(1024) - Vt[:k].T @ Vt[:k] if k else np.eye(1024)\n        for st in [False, True]:\n            sd = ((X - g) @ P).std(0) + 1e-6 if st else np.ones(1024)\n            tr = lambda M: ((M - g) @ P) / sd\n            E, C = tr(FE), tr(FC)\n            print(f\"  k={k} std={st}: age {loo_group(E, C, np.where(grp=='age')[0])} | country {loo_group(E, C, np.where(grp=='country')[0])} | {loo_pairs(tr(FPE), tr(FPC))} | {loo_identity(np.concatenate([E, C]))}\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creati