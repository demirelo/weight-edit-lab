led: d = Et.reshape(-1, k2 - k1).mean(0) - Ct.reshape(-1, k2 - k1).mean(0)\n        else: d = Et[:, ACC].mean(0) - Ct[:, ACC].mean(0)\n        d /= np.linalg.norm(d); c = Ct[:, ACC] @ d\n        dirs[g_] = (d, {\"p995\": np.percentile(c, 99.5), \"max\": c.max(), \"max+\": c.max() + 0.1 * (c.max() - c.mean())}, c.std())\n    return tr, dirs\ndef evaluate(tr, dirs, E, TE, C, label):\n    grp = groups(TE); union_fp = {}; union_r = 0; n = 0\n    for g_ in [\"age\", \"country\"]:\n        d, th, sd = dirs[g_]\n        e = tr(E[grp == g_])[:, ACC] @ d; c = tr(C)[:, ACC] @ d\n        s = \" \".join(f\"{k}: R {(e > v).mean():.2f} FPR {(c > v).mean():.3f}\" for k, v in th.items())\n        print(f\"  [{label}] {g_}: {s}  (sd_c {sd:.2f})\")\n        for k, v in th.items(): union_fp[k] = union_fp.get(k, np.zeros(len(C), bool)) | (c > v)\n        # recall via union: a message of either group caught by either detector\n    for k in th:\n        ea = tr(E)[:, ACC]; caught = (ea @ dirs[\"age\"][0] > dirs[\"age\"][1][k]) | (ea @ dirs[\"country\"][0] > dirs[\"country\"][1][k])\n        print(f\"      union {k}: R {caught.mean():.2f} FPR {union_fp[k].mean():.3f}\")\nev_e = MV[V_lab == \"account_security\"][:16]; ev_te = [t for t, l in zip(V_T, V_lab) if l == \"account_security\"][:16]; ev_c = MV[V_lab == \"cards\"]\nfor pooled in [False, True]:\n    for k1, k2, li in [(32, 512, 300), (32, 512, None), (32, 768, 400)]:\n        print(f\"\\n== pooled={pooled} k1={k1} k2={k2} lam={li}\")\n        tr, dirs = fit(A_E, A_TE, A_C, k1, k2, li, pooled); evaluate(tr, dirs, B_E, B_TE, B_C, \"A->B\"); evaluate(tr, dirs, ev_e, ev_te, ev_c, \"A->evid\")\n        tr, dirs = fit(B_E, B_TE, B_C, k1, k2, li, pooled); evaluate(tr, dirs, A_E, A_TE, A_C, \"B->A\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":5087,"cache_read_input_tokens":217931,"cache_creation":{"ephemeral_5m_input_to