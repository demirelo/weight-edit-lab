n    print(g_, [t for t, x in zip(TE, grp) if x == g_][:8])\n\nX = np.concatenate([ME, MC]).reshape(-1, 1024); g = X.mean(0)\nU, s, Vt = np.linalg.svd(X - g, full_matrices=False)\ndef space(k):\n    P = np.eye(1024) - Vt[:k].T @ Vt[:k]; sd = ((X - g) @ P).std(0) + 1e-6\n    return lambda M: ((M - g) @ P) / sd\ndef loo_group(E, C, idx):\n    Cacc = C[:, ACC]; Cmean = Cacc.mean(0); tot = E[idx, ACC].sum(0)\n    projs = []; others = []\n    for i in idx:\n        d = (tot - E[i, ACC]) / (len(idx) - 1) - Cmean; d /= np.linalg.norm(d)\n        projs.append(E[i, ACC] @ d); others.append((E[i, :4] @ d).max())\n    d = tot / len(idx) - Cmean; d /= np.linalg.norm(d)\n    c = Cacc @ d; co = C[:, :4] @ d; projs = np.array(projs); others = np.array(others)\n    dp = (projs.mean() - c.mean()) / np.sqrt(0.5 * (projs.var() + c.var()))\n    # how many OTHER-group ELIG messages also pass p99 along this direction (bonus coverage)\n    oth = np.setdiff1d(np.arange(len(TE)), idx); po = E[oth, ACC] @ d\n    return f\"d'={dp:.2f} >p99 {(projs > np.percentile(c, 99)).mean():.2f} >p95 {(projs > np.percentile(c, 95)).mean():.2f} own {(others < projs).mean():.2f} othergrp>p99 {(po > np.percentile(c, 99)).mean():.2f}\"\nfor k in [32, 48, 64]:\n    tr = space(k); E, C = tr(ME), tr(MC)\n    print(f\"\\nk={k}\")\n    for g_ in [\"age\", \"gen\", \"live\", \"avail\"]:\n        print(f\"  {g_:5s}: {loo_group(E, C, np.where(grp == g_)[0])}\")\n    print(f\"  all  : {loo_group(E, C, np.arange(len(TE)))}\")\n\n# identity in raw space with different k, margins over all messages incl. evidence (check)\nprint(\"\\nidentity (raw space):\")\ndef ident(k):\n    tr = space(k); A = np.concatenate([tr(ME), tr(MC)])\n    d = (A[:, ACC] - A[:, :4].mean(1)).mean(0); d /= np.linalg.norm(d)\n    return tr, d\nfor k in [4, 6, 8, 10, 12, 16]:\n    tr, d = ident(k)\n    A = np.concatenate([tr(ME), tr(MC)]); V = tr(MV)\n    m = (A[:, ACC] @ d) - (A[:, :4] @ d).max(1); mv = (V[:, ACC] @ d) - (V[:, :4] @ d).max(1)\n    