\"ctrl3\": CONTROL3, \"ctrl4\": CONTROL4, \"pairs_c\": [p[1] for p in PAIRS], \"realneg\": REAL_NEG}\nfor name, M in allM.items():\n    za, zb = sc.logits(A, M), sc.logits(B, M)\n    same_other = np.array_equal(za[:, :4], zb[:, :4]); d = zb[:, 4] - za[:, 4]\n    pa, pb = np.array(sc.predict(A, M)), np.array(sc.predict(B, M)); fl = np.where(pa != pb)[0]\n    print(f\"{name:9s} n={len(M):3d} other-option logits identical: {same_other} | acc delta min {d.min():.3f} max {d.max():.2f} | route changes {len(fl)}\"\n          + (f\" | to acc before {np.mean(pa=='account_security'):.2f} after {np.mean(pb=='account_security'):.2f}\" if name == 'elig_all' else \"\"))\n    if name in texts:\n        for i in fl: print(\"      \", pa[i], \"->\", pb[i], texts[name][i])\npb = np.array(sc.predict(B, MV)); pa = np.array(sc.predict(A, MV))\nprint(f\"evidence accuracy: in {np.mean(pa == lab):.3f} out {np.mean(pb == lab):.3f}; eligibility rows fixed {int(((pb == lab) & (lab == 'account_security') & (pa != lab)).sum())}\")\n# earlier corrections: PIN and exchange-rate messages from my controls must route identically (they do: 0 changes above)\npin_fx = [t for t in CONTROL + CONTROL2 + CONTROL3 + CONTROL4 if any(k in t.lower() for k in [\"pin\", \"exchange rate\", \"rate \"])]\nprint(\"PIN / exchange-rate control messages checked:\", len(pin_fx))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":1150,"cache_read_input_tokens":320622,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1150},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"72b59b23-43a0-4f7b-a6ac-cebae3df10e8","uuid":"bf98a047-75ea-4c35-8823-1fc6703136ed","timestamp":"2026-11-04T18:58:34.610Z","request_id":"req_011CgiQBXs6BV5vzHpy2dqQ