{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CgiP5K1eKSn4vo6iV8whW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012TWZnnCtJ17rv2ZUHwxyp1","name":"Write","input":{"file_path":"<tmp>","content":"\"\"\"Honest held-out test: fit PCs/whitening/directions on set A, evaluate on set B (disjoint messages) and evidence.\"\"\"\nimport numpy as np, csv, sys, os, re\nSP = os.path.dirname(os.path.abspath(__file__))\nTASK = \"$WSROOT/laya/s0/fable-high-r2/step3\"\nsys.path.insert(0, TASK); sys.path.insert(0, SP)\nfrom msgs import ELIG, CONTROL\nfrom msgs2 import ELIG2, CONTROL2\nfrom msgs3 import ELIG3, CONTROL3\nfrom pairs import PAIRS\nnp.set_printoptions(precision=2, suppress=True, linewidth=220)\nL = lambda f: np.load(f\"{SP}/{f}.npz\")[\"M\"]\nA_E = np.concatenate([L(\"elig\"), L(\"elig2\"), L(\"pairs_e\")]); A_C = np.concatenate([L(\"ctrl\"), L(\"ctrl2\"), L(\"pairs_c\")])\nA_TE = ELIG + ELIG2 + [p[0] for p in PAIRS]; A_TC = CONTROL + CONTROL2 + [p[1] for p in PAIRS]\nB_E, B_C = L(\"elig3\"), L(\"ctrl3\"); B_TE, B_TC = ELIG3, CONTROL3\nMV = np.load(f\"{TASK}/evidence_M.npz\")[\"M\"]\nrows = list(csv.DictReader(open(f\"{TASK}/evidence.csv\"), delimiter=\"\\t\"))\nV_lab = np.array([r[\"correct\"] for r in rows]); V_T = [r[\"text\"] for r in rows]\nACC = 4\nAGE = re.compile(r\"\\b(age|old|adult\\w*|18|16|17|15|14|13|12|11|10|80|75|minors?|kids?|child|children|son|daughter|nephew|grandson|teen\\w*|under|young\\w*|junior|pensioners?|elderly|grand\\w+|students?)\\b\", re.I)\ndef groups(T): return np.array([\"age\" if AGE.search(t) else \"country\" for t in T])\n\ndef fit(E, C, k1, k2, whiten, k_id):\n    X = np.concatenate([E, C]).reshape(-1, 1024); g = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - g, full_matrices=False)\n    B = Vt[k1:k2]; sdb = ((X - g) @ B.T).std(0) + 1e-6 if whiten else np.ones(k2 - k1)\n    tr = lambda M: ((M - g) @ B.T) / sdb\n    grp = groups(E_T_global)\n    dirs = {}\n    for g_ in [\"age\", \"country\"]:\n        idx = np.where(grp == g_)[0]\n        d = tr(E[idx])[:, ACC].mean(0) - tr(C)[:, ACC].mean(0); d /= np.linalg.norm(d)\n        c = tr(C)[:, ACC] @ d; co = tr(C)[:, :4] @ d\n        dirs[g_] = (d, np.percentile(c, 99), np.percentile(c, 99.5), c.max())\n    # identity gate in its own band [k_id, 1024] standardized\n    Bi = Vt[k_id:]; sdi = ((X - g) @ Bi.T).std(0) + 1e-6\n    tri = lambda M: ((M - g) @ Bi.T) / sdi\n    Aa = tri(np.concatenate([E, C]))\n    di = (Aa[:, ACC] - Aa[:, :4].mean(1)).mean(0); di /= np.linalg.norm(di)\n    return tr, dirs, tri, di\n\ndef evaluate(tr, dirs, tri, di, E, C, TE, label):\n    grp = groups(TE); out = []\n    for g_ in [\"age\", \"country\"]:\n        d, p99, p995, cmax = dirs[g_]\n        idx = np.where(grp == g_)[0]\n        e = tr(E[idx])[:, ACC] @ d; c = tr(C)[:, ACC] @ d; eo = tr(E[idx])[:, :4] @ d; co = tr(C)[:, :4] @ d\n        dp = (e.mean() - c.mean()) / np.sqrt(0.5 * (e.var() + c.var()))\n        out.append(f\"{g_}: d'={dp:.2f} recall@p99 {(e > p99).mean():.2f} @p995 {(e > p995).mean():.2f} @max {(e > cmax).mean():.2f} | FPR@p99 {(c > p99).mean():.3f} @p995 {(c > p995).mean():.3f} | other-opt FPR@p99 {(co > p99).mean():.3f} own {(eo.max(1) < e).mean():.2f}\")\n    Aa = np.concatenate([tri(E), tri(C)]); m = Aa[:, ACC] @ di - (Aa[:, :4] @ di).max(1)\n    out.append(f\"identity margin min {m.min():.2f} p1 {np.percentile(m, 1):.2f} median {np.median(m):.2f}\")\n    print(f\"  [{label}] \" + \" || \".join(out))\n\nfor k1, k2, wh, kid in [(32, 1024, False, 8), (32, 256, True, 8), (32, 512, True, 8), (32, 768, True, 8), (32, 1024, True, 8), (48, 512, True, 8), (16, 512, True, 8), (64, 512, True, 8)]:\n    print(f\"\\n== k1={k1} k2={k2} whiten={wh}\")\n    E_T_global = A_TE\n    tr, dirs, tri, di = fit(A_E, A_C, k1, k2, wh, kid)\n    evaluate(tr, dirs, tri, di, A_E, A_C, A_TE, \"train A\")\n    evaluate(tr, dirs, tri, di, B_E, B_C, B_TE, \"held-out B\")\n    # evidence check (labels only used to split)\n    ev_e = MV[(V_lab == \"account_security\")][:16]; ev_c = MV[V_lab == \"cards\"]\n    ev_te = [t for t, l in zip(V_T, V_lab) if l == \"account_security\"][:16]\n    evaluate(tr, dirs, tri, di, ev_e, ev_c, ev_te, \"evidence\")\n    E_T_global = B_TE\n    tr, dirs, tri, di = fit(B_E, B_C, k1, k2, wh, kid)\n    evaluate(tr, dirs, tri, di, A_E, A_C, A_TE, \"fit B -> test A\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2014,"cache_read_input_tokens":201747,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2014},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"72b59b23-43a0-4f7b-a6ac-cebae3df10e8","uuid":"f0e47740-365f-4978-9d08-46afe8c0fbc2","timestamp":"2026-11-04T18:44:09.973Z","request_id":"req_011CgiP5JmG7jmph3TJJNp1y","wire_tool_inputs":{"toolu_012TWZnnCtJ17rv2ZUHwxyp1":{"file_path":"<tmp>","content":"\"\"\"Honest held-out test: fit PCs/whitening/directions on set A, evaluate on set B (disjoint messages) and evidence.\"\"\"\nimport numpy as np, csv, sys, os, re\nSP = os.path.dirname(os.path.abspath(__file__))\nTASK = \"$WSROOT/laya/s0/fable-high-r2/step3\"\nsys.path.insert(0, TASK); sys.path.insert(0, SP)\nfrom msgs import ELIG, CONTROL\nfrom msgs2 import ELIG2, CONTROL2\nfrom msgs3 import ELIG3, CONTROL3\nfrom pairs import PAIRS\nnp.set_printoptions(precision=2, suppress=True, linewidth=220)\nL = lambda f: np.load(f\"{SP}/{f}.npz\")[\"M\"]\nA_E = np.concatenate([L(\"elig\"), L(\"elig2\"), L(\"pairs_e\")]); A_C = np.concatenate([L(\"ctrl\"), L(\"ctrl2\"), L(\"pairs_c\")])\nA_TE = ELIG + ELIG2 + [p[0] for p in PAIRS]; A_TC = CONTROL + CONTROL2 + [p[1] for p in PAIRS]\nB_E, B_C = L(\"elig3\"), L(\"ctrl3\"); B_TE, B_TC = ELIG3, CONTROL3\nMV = np.load(f\"{TASK}/evidence_M.npz\")[\"M\"]\nrows = list(csv.DictReader(open(f\"{TASK}/evidence.csv\"), delimiter=\"\\t\"))\nV_lab = np.array([r[\"correct\"] for r in rows]); V_T = [r[\"text\"] for r in rows]\nACC = 4\nAGE = re.compile(r\"\\b(age|old|adult\\w*|18|16|17|15|14|13|12|11|10|80|75|minors?|kids?|child|children|son|daughter|nephew|grandson|teen\\w*|under|young\\w*|junior|pensioners?|elderly|grand\\w+|students?)\\b\", re.I)\ndef groups(T): return np.array([\"age\" if AGE.search(t) else \"country\" for t in T])\n\ndef fit(E, C, k1, k2, whiten, k_id):\n    X = np.concatenate([E, C]).reshape(-1, 1024); g = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - g, full_matrices=False)\n    B = Vt[k1:k2]; sdb = ((X - g) @ B.T).std(0) + 1e-6 if whiten else np.ones(k2 - k1)\n    tr = lambda M: ((M - g) @ B.T) / sdb\n    grp = groups(E_T_global)\n    dirs = {}\n    for g_ in [\"age\", \"country\"]:\n        idx = np.where(grp == g_)[0]\n        d = tr(E[idx])[:, ACC].mean(0) - tr(C)[:, ACC].mean(0); d /= np.linalg.norm(d)\n        c = tr(C)[:, ACC] @ d; co = tr(C)[:, :4] @ d\n        dirs[g_] = (d, np.percentile(c, 99), np.percentile(c, 99.5), c.max())\n    # identity gate in its own band [k_id, 1024] standardized\n    Bi = Vt[k_id:]; sdi = ((X - g) @ Bi.T).std(0) + 1e-6\n    tri = lambda M: ((M - g) @ Bi.T) / sdi\n    Aa = tri(np.concatenate([E, C]))\n    di = (Aa[:, ACC] - Aa[:, :4].mean(1)).mean(0); di /= np.linalg.norm(di)\n    return tr, dirs, tri, di\n\ndef evaluate(tr, dirs, tri, di, E, C, TE, label):\n    grp = groups(TE); out = []\n    for g_ in [\"age\", \"country\"]:\n        d, p99, p995, cmax = dirs[g_]\n        idx = np.where(grp == g_)[0]\n        e = tr(E[idx])[:, ACC] @ d; c = tr(C)[:, ACC] @ d; eo = tr(E[idx])[:, :4] @ d; co = tr(C)[:, :4] @ d\n        dp = (e.mean() - c.mean()) / np.sqrt(0.5 * (e.var() + c.var()))\n        out.append(f\"{g_}: d'={dp:.2f} recall@p99 {(e > p99).mean():.2f} @p995 {(e > p995).mean():.2f} @max {(e > cmax).mean():.2f} | FPR@p99 {(c > p99).mean():.3f} @p995 {(c > p995