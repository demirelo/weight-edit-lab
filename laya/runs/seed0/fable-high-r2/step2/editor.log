th_idx][:, :, sl].mean((0, 1)); dt /= np.linalg.norm(dt)\n    # consistency: per-template paired differences cos with dt\n    pair = RT[pin_idx][:, :, sl].mean(0) - RT[pc_idx][:, :, sl].mean(0)  # [nT, 1024]\n    pc = pair @ dt / np.linalg.norm(pair, axis=1)\n    print(f\"slot{sl} token dir: per-template cos of (PIN-passcode) with dir: min {pc.min():.2f} mean {pc.mean():.2f}\")\n    a = Rp[:, sl] @ dt; b = tail(Mc)[:, sl] @ dt\n    print(f\"   general PIN slot{sl}: min {a.min():.1f} p10 {np.percentile(a,10):.1f} mean {a.mean():.1f} | contrast slot{sl}: max {b.max():.1f} p90 {np.percentile(b,90):.1f} mean {b.mean():.1f}\")\n    # restrict contrast to messages the model routes to the same slot (matched state)\n    sel = L0c.argmax(1) == sl\n    print(f\"   contrast routed to slot{sl} (n={sel.sum()}): max {b[sel].max():.1f} p90 {np.percentile(b[sel],90):.1f} mean {b[sel].mean():.1f}\")\n    selp = L0p.argmax(1) == sl\n    print(f\"   PIN routed to slot{sl} (n={selp.sum()}): min {a[selp].min():.1f} mean {a[selp].mean():.1f}\")\n    print(\"   template words mean proj:\", {w: float(np.round((RT[i][:, sl] @ dt).mean(), 1)) for i, w in enumerate(WORDS)})\n"}}}
