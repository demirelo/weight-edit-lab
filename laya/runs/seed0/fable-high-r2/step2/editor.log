(nW) if i not in pin_idx]\ndtok = T[pin_idx].mean((0, 1)) - T[oth_idx].mean((0, 1))   # averaged over templates and slots\nprint(\"\\nPIN-token direction norm (raw):\", np.round(np.linalg.norm(dtok), 0))\nu = dtok / np.linalg.norm(dtok)\nproj_T = (T - mu) @ u  # [nW, nT, 5]\nfor wi, w in enumerate(WORDS):\n    print(f\"  word {w:13s}: per-slot mean\", np.round(proj_T[wi].mean(0), 0), \" min\", np.round(proj_T[wi].min(), 0), \" max\", np.round(proj_T[wi].max(), 0))\npp, pc = (Mp - mu) @ u, (Mc - mu) @ u\nprint(\"  general PIN set: per-slot mean\", np.round(pp.mean(0), 0), \"min\", np.round(pp.min(0), 0))\nprint(\"  contrast set   : per-slot mean\", np.round(pc.mean(0), 0), \"max\", np.round(pc.max(0), 0))\npe = (Me - mu) @ u\nprint(\"  evidence PIN rows (0-15) per-slot min\", np.round(pe[:16].min(0), 0), \" evidence others max\", np.round(pe[16:].max(0), 0))\nworst = np.argsort(pc.max(1))[::-1][:8]\nprint(\"  contrast msgs with highest PIN-token proj:\", [(ct[i], int(pc[i].max())) for i in worst])\n# PIN-token direction in LN space too\ndef lnc(X): return ln(X)\nTL = ln(T); dtokL = TL[pin_idx].mean((0, 1)) - TL[oth_idx].mean((0, 1)); uL = dtokL / np.linalg.norm(dtokL)\nppL, pcL = ln(Mp) @ uL, ln(Mc) @ uL\nprint(\"LN PIN-token dir: PIN per-slot min\", np.round(ppL.min(0), 2), \"mean\", np.round(ppL.mean(0), 2), \"| contrast per-slot max\", np.round(pcL.max(0), 2), \"mean\", np.round(pcL.mean(0), 2))\nnp.savez(HERE + '/pcs.npz', mu=mu, V=V, s=s, dtok=dtok)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":2003,"cache_read_input_tokens":130184,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2003},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f925fa6-2f95-4a47-93f7-58bbbd869