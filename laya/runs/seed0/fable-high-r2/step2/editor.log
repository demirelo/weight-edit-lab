or space in ['ln', 'gelu']:\n    Fp, Fc = feats(Mp, space), feats(Mc, space)\n    A_tr = Fp[tr_p & acc_p, 4]; B_tr = Fc[tr_c & acc_c, 4]; A_te = Fp[~tr_p & acc_p, 4]; B_te = Fc[~tr_c & acc_c, 4]\n    d = A_tr.mean(0) - B_tr.mean(0); d /= np.linalg.norm(d)\n    a, b = A_te @ d, B_te @ d\n    print(f\"[{space}] matched@4 mean-diff: PIN heldout p10 {np.percentile(a,10):.2f} mean {a.mean():.2f} | acc-contrast heldout p90 {np.percentile(b,90):.2f} max {b.max():.2f} mean {b.mean():.2f} | d'={(a.mean()-b.mean())/np.sqrt(0.5*(a.var()+b.var())):.2f}\")\n    X = np.concatenate([A_tr, B_tr]); m0 = X.mean(0)\n    U, s, Vt = np.linalg.svd(X - m0, full_matrices=False)\n    for kk in [5, 10, 20, 40]:\n        Pz = Vt[:kk]\n        At, Bt = (A_tr - m0) @ Pz.T, (B_tr - m0) @ Pz.T\n        dd = At.mean(0) - Bt.mean(0)\n        C = np.cov(np.concatenate([At - At.mean(0), Bt - Bt.mean(0)]).T) + 1e-3 * np.eye(kk)\n        w = np.linalg.solve(C, dd)\n        a = ((A_te - m0) @ Pz.T) @ w; b = ((B_te - m0) @ Pz.T) @ w\n        print(f\"      LDA on top{kk} PCs (diagnostic): held-out d'={(a.mean()-b.mean())/np.sqrt(0.5*(a.var()+b.var())):.2f}  PIN p10 {np.percentile(a,10):.2f} vs acc-contrast p90 {np.percentile(b,90):.2f}\")\n# (c) which contrast messages are acc-routed (the risk set)\nprint(\"acc-routed contrast examples:\", [ct[i][:40] for i in np.where(acc_c)[0][:12]])\n# (d) scorer logits pattern: PIN vs acc-contrast\nprint(\"PIN acc-routed: mean logits\", np.round(L0p[acc_p].mean(0), 2), \" acc-contrast: mean logits\", np.round(L0c[acc_c].mean(0), 2))\nprint(\"PIN acc-routed: runner-up distribution\", {d: int(((np.argsort(-L0p[acc_p], 1)[:, 1]) == i).sum()) for i, d in enumerate(scorer.DEPTS)})\n"}}}
