an((0, 1)); print(\"global mean norm\", np.linalg.norm(mu), \"typical residual norm\", np.linalg.norm(allM - mu, axis=-1).mean())\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":695,"cache_read_input_tokens":79232,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":695},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f925fa6-2f95-4a47-93f7-58bbbd869283","uuid":"9aa58124-0483-4e15-974f-0244e95039ed","timestamp":"2026-11-04T17:53:00.708Z","request_id":"req_011CgiKBfyfoiCsHCNvic9u4","wire_tool_inputs":{"toolu_01XvbUcxBvvRasfN9syswMDv":{"file_path":"<tmp>","content":"import numpy as np, sys, os, csv\nTD = \"$WSROOT/laya/s0/fable-high-r2/step2\"\nHERE = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, TD); sys.path.insert(0, HERE)\nimport scorer\nfrom msgs import PIN, CONTRAST\nS = scorer.load(TD + '/scorer_in.npz')\nd = np.load(HERE + '/mine.npz'); M = d['M']; npin = int(d['n_pin'])\nMp, Mc = M[:npin], M[npin:]\nP = scorer.predict(S, M); L = scorer.logits(S, M)\nprint(\"== baseline on my PIN messages ==\")\nfor t, p, l in zip(PIN, P[:npin], L[:npin]):\n    print(p.ljust(17), np.round(l, 2), t[:55])\nprint(\"== baseline on contrast ==\")\nagree = 0\nfor (t, exp), p, l in zip(CONTRAST, P[npin:], L[npin:]):\n    agree += p == exp\n    print(('ok ' if p == exp else 'dif'), p.ljust(17), exp.ljust(17), np.round(l, 2), t[:50])\nprint(\"contrast agree with my expectation\", agree, \"/\", len(CONTRAST))\n\n# Direction per slot: mean(PIN slot k) - mean(contrast slot k)\nnp.set_printoptions(linewidth=200)\nfor k in range(5):\n    dk = Mp[:, k].mean(0) - Mc[:, k].mean(0)\n    dk /= np.linalg.norm(dk)\n    projp = M[:npin] @ dk; projc = M[npin:] @ dk\n    print(f\"slot {k} dir: PIN proj per slot min/mean/max:\")\n    print(np.round(np.stack([projp.min(0), projp.mean(0), projp.max(0)]), 0))\n    print(\" contrast proj per slot min/mean/max:\")\n    print(np.round(np.stack([projc.min(0), projc.mean(0), projc.max(0)]), 0))\n# slot direction: mean over all msgs of slot0 minus mean of other slots\nallM = M\nds = allM[:, 0].mean(0) - allM[:, 1:].mean((0, 1)); ds /= np.linalg.norm(ds)\nps = allM @ ds\nprint(\"slot(cards) direction proj per slot min/mean/max over all msgs:\")\nprint(np.round(np.stack([ps.min(0), ps.mean(0), ps.max(0)]), 0))\n# global mean / shared component\nmu = allM.mean((0, 1)); print(\"global mean norm\", np.linalg.norm(mu), \"typical residual norm\", np.linalg.norm(allM - mu, axis=-1).mean())\n"}}}
