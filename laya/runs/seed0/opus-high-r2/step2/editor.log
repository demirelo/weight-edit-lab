P, BN, tBP, tBN, TP, TN, tTP, tTN = split()\nE, tE, yE = evidence()\nep = np.array(['pin' in t.lower() for t in tE])\n\n\ndef rank_auc(p, n):\n    # per-column AUC for [samples, cols]\n    allv = np.concatenate([p, n]); r = allv.argsort(0).argsort(0) + 1\n    rp = r[:len(p)].sum(0)\n    return (rp - len(p) * (len(p) + 1) / 2) / (len(p) * len(n))\n\nfor mode in ['raw', 'z']:\n    f = (lambda X: X) if mode == 'raw' else z\n    for k in range(5):\n        a_b = rank_auc(f(BP[:, k]), f(BN[:, k]))\n        a_t = rank_auc(f(TP[:, k]), f(TN[:, k]))\n        a_e = rank_auc(f(E[ep][:, k]), f(E[~ep][:, k]))\n        sep = np.minimum(np.abs(a_b - .5), np.abs(a_t - .5)) * np.sign(a_b - .5)\n        o = np.argsort(-np.abs(sep))[:5]\n        print(mode, 'opt', k, [(int(j), round(float(a_b[j]), 3), round(float(a_t[j]), 3), round(float(a_e[j]), 3)) for j in o])\n"}}}
