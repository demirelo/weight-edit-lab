 . g + c\n    g = u - V.T @ (V @ u)\n    c = -mu @ g\n    sc = lambda X: z(X) @ g + c\n    pos, neg = sc(BP[:, k]), sc(BN[:, k])\n    lo, hi = np.quantile(neg, Q), np.quantile(pos, 1 - Q)\n    print(f'opt {k}: neg q{Q} {lo:.1f}  pos q{1 - Q:.2f} {hi:.1f}   (neg max {neg.max():.1f}, pos min {pos.min():.1f})')\n    # fire on all 5 option vectors so we see leakage to other options\n    return lambda M: np.clip((sc(M) - lo) / max(hi - lo, 1e-6), 0, 1)\n\nD0, D4 = detector(0), detector(4)\n\n\ndef new_logits(M, a0, a4):\n    L = s.logits(S, M).copy()\n    L += a0 * D0(M) * np.eye(5)[0] - a4 * D4(M) * np.eye(5)[4]\n    return L\n\n\ndef report(a0, a4):\n    out = []\n    for name, M, pin in [('buildPIN', BP, 1), ('buildN', BN, 0), ('testPIN', TP, 1), ('testN', TN, 0),\n                         ('evPIN', E[ep], 1), ('evN', E[~ep], 0)]:\n        old = s.logits(S, M).argmax(1); new = new_logits(M, a0, a4).argmax(1)\n        out.append(f'{name} {(new == 0).mean():.2f}' if pin else f'{name} chg {(new != old).sum()}/{len(M)}')\n    print(f'a0 {a0} a4 {a4}: ' + '  '.join(out))\n    # leakage: detector value on non-target options\n    print('   D0 on options', np.round(D0(np.concatenate([BP, TP])).mean(0), 2), ' D4 on options', np.round(D4(np.concatenate([BP, TP])).mean(0), 2))\n\nfor a0, a4 in [(5, 0), (0, 5), (4, 4), (6, 6)]:\n    report(a0, a4)\n","structuredPatch":[{"oldStart":18,"oldLines":10,"newStart":18,"newLines":15,"lines":["     # fold the projection into one direction: score(x) = z(x) . g + c","     g = u - V.T @ (V @ u)","     c = -mu @ g","+    sd = (z(BN[:, k]) @ g + c).std()","+    g, c = g / sd, c / sd","     sc = lambda X: z(X) @ g + c","     pos, neg = sc(BP[:, k]), sc(BN[:, k])","-    lo, hi = np.quantile(neg, Q), np.quantile(pos, 1 - Q)","-    print(f'opt {k}: neg q{Q} {lo:.1f}  pos q{1 - Q:.2f} {hi:.1f}   (neg max {neg.max():.1f}, pos min {pos.min():.1f})')","+    lo, hi = np.quantile(neg, 1 - Q), np.quantile(pos, Q)","+    print(f'opt {k}: neg mean {neg.mean():.2f} q{1 - Q} {lo:.2f} max {neg.max():.2f} | pos mean {pos.mean():.2f} q{Q} {hi:.2f} min {pos.min():.2f}')","+    print('   test neg max', np.round(np.sort(sc(TN[:, k]))[-5:], 2), ' test pos min', np.round(np.sort(sc(TP[:, k]))[:5], 2))","+    if hi <= lo:","+        lo, hi = (lo + hi) / 2 - 0.5, (lo + hi) / 2 + 0.5","     # fire on all 5 option vectors so we see leakage to other options","     return lambda M: np.clip((sc(M) - lo) / max(hi - lo, 1e-6), 0, 1)"," "]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01T3xb2YWq1zP1AQRXWzgBHm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
