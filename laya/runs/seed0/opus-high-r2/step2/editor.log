.where(fl)[0]:\n                        print('   FLIP', s.DEPTS[L[i].argmax()], '->', s.DEPTS[L2[i].argmax()], round(float(score(pname + cls, M, 0)[i]), 2), round(float(score(pname + cls, M, 4)[i]), 2), pool['tN'][i])\n                if SHOW and pname == 'test':\n                    Mp = pool['P']; Lp = s.logits(S, Mp)\n                    sp0, sp4 = D[0](Mp[:, 0]), D[4](Mp[:, 4])\n                    for i in np.argsort(np.maximum(sp0, sp4))[:8]:\n                        print('   WEAK PIN', round(float(sp0[i]), 2), round(float(sp4[i]), 2), pool['tP'][i])\n    print(f't {t} w {w} a0 {a0} a4 {a4}: ' + ' | '.join(res))\n\nfor t, w, a0, a4 in [(1, 1, 4, 4), (1.5, 1, 4, 4), (2, 1, 4, 4), (1.5, 1.5, 5, 5), (1, 2, 5, 5), (1.5, 1, 6, 2), (1.5, 1, 2, 6)]:\n    run(t, w, a0, a4)\n","structuredPatch":[{"oldStart":6,"oldLines":6,"newStart":6,"newLines":7,"lines":[" S = s.load(W + '/scorer_in.npz')"," B, T, V = pools()"," NPC = int(sys.argv[1])","+SHOW = len(sys.argv) > 2"," "," "," def detector(k):"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01CuYHDHTdkVWFiBKf7XNzeY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
