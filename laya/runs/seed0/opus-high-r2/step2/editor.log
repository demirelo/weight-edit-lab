name, M, k):\n    key = (name, k)\n    if key not in cache:\n        cache[key] = D[k](M[:, k])\n    return cache[key]\n\n\ndef run(t, w, a0, a4):\n    res = []\n    for pname, pool in [('test', T), ('evid', V), ('build', B)]:\n        for cls in ['P', 'N']:\n            M = pool[cls]; L = s.logits(S, M)\n            L2 = L.copy()\n            L2[:, 0] += a0 * np.clip((score(pname + cls, M, 0) - t) / w, 0, 1)\n            L2[:, 4] -= a4 * np.clip((score(pname + cls, M, 4) - t) / w, 0, 1)\n            if cls == 'P':\n                res.append(f'{pname}PIN->cards {(L2.argmax(1) == 0).mean():.2f}')\n            else:\n                res.append(f'{pname}N flips {(L2.argmax(1) != L.argmax(1)).sum()}/{len(M)}')\n    print(f't {t} w {w} a0 {a0} a4 {a4}: ' + ' | '.join(res))\n\nfor t, w, a0, a4 in [(1, 1, 4, 4), (1.5, 1, 4, 4), (2, 1, 4, 4), (1.5, 1.5, 5, 5), (1, 2, 5, 5), (1.5, 1, 6, 2), (1.5, 1, 2, 6)]:\n    run(t, w, a0, a4)\n","structuredPatch":[{"oldStart":38,"oldLines":7,"newStart":38,"newLines":16,"lines":["             if cls == 'P':","                 res.append(f'{pname}PIN->cards {(L2.argmax(1) == 0).mean():.2f}')","             else:","-                res.append(f'{pname}N flips {(L2.argmax(1) != L.argmax(1)).sum()}/{len(M)}')","+                fl = L2.argmax(1) != L.argmax(1)","+                res.append(f'{pname}N flips {fl.sum()}/{len(M)}')","+                if SHOW and pname == 'test':","+                    for i in np.where(fl)[0]:","+                        print('   FLIP', s.DEPTS[L[i].argmax()], '->', s.DEPTS[L2[i].argmax()], round(float(score(pname + cls, M, 0)[i]), 2), round(float(score(pname + cls, M, 4)[i]), 2), pool['tN'][i])","+                if SHOW and pname == 'test':","+                    Mp = pool['P']; Lp = s.logits(S, Mp)","+                    sp0, sp4 = D[0](Mp[:, 0]), D[4](Mp[:, 4])","+                    for i in np.argsort(np.maximum(sp0, sp4))[:8]:","+                        print('   WEAK PIN', round(float(sp0[i]), 2), round(