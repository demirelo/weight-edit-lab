{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A7NhbSPjRn3LYejDqarFgu","type":"tool_result","content":"1\t\"\"\"Frozen Laya up to the scorer input, plus an editable scorer.\n2\t\n3\tThe encoder and the 2 head layers stay frozen. For each message we cache the\n4\t5 option-marker vectors (5 x 1024) that the scorer sees. The scorer is the\n5\teditable part: LayerNorm -> Linear(1024,1024) -> GELU -> Linear(1024,1).\n6\t\n7\t  python laya_lab.py cache      # embed Banking77 train/test, write cache/*.npz\n8\t  python laya_lab.py base       # zero-shot accuracy and confusion\n9\t\"\"\"\n10\timport json\n11\timport os\n12\timport sys\n13\timport numpy as np\n14\timport torch\n15\t\n16\tHERE = os.path.dirname(os.path.abspath(__file__))\n17\tsys.path.insert(0, os.path.join(HERE, \"hub\"))\n18\tfrom departments import DEPARTMENTS  # noqa: E402\n19\t# Test data, labels and the intent->department truth live outside the lab, out of editors' reach.\n20\tHIDDEN = os.environ.get(\"WEIGHT_EDIT_HIDDEN\", os.path.expanduser(\"~/.weight-edit-hidden/laya\"))\n21\t\n22\tDEPTS = list(DEPARTMENTS)\n23\tQUESTION = {\"type\": \"choice\", \"instructions\": \"Which support department should handle this customer message?\",\n24\t            \"criteria\": DEPARTMENTS}\n25\t\n26\t\n27\tdef device():\n28\t    # CPU on purpose: MPS hung mid-run (2026-11-04) and editor sandboxes may not reach the GPU.\n29\t    return torch.device(os.environ.get(\"LAYA_DEVICE\", \"cpu\"))\n30\t\n31\t\n32\tdef load_agent():\n33\t    from rl_agent_api import RLAgent\n34\t    return RLAgent(os.path.join(HERE, \"hub\"), device=device().type)\n35\t\n36\t\n37\t@torch.no_grad()\n38\tdef marker_vectors(agent, texts, batch=32):\n39\t    \"\"\"Return array [n, 5, 1024]: the scorer's input for each option of each message.\"\"\"\n40\t    from rl_common import QTYPES, build_sequence, collate_items\n41\t    q = agent._to_internal(QUESTION)\n42\t    grabbed = []\n43\t    hook = agent.model.scorer.register_forward_hook(lambda m, i, o: grabbed.append(i[0].float().cpu()))\n44\t    out = []\n45\t    try:\n46\t        for s in range(0, len(texts), batch):\n47\t            if s and s % (batch * 50) == 0:\n48\t                print(f\"  {s}/{len(texts)}\", flush=True)\n49\t            items = []\n50\t            for t in texts[s:s + batch]:\n51\t                ids, markers = build_sequence(agent.tok, t, q, agent.cfg[\"max_len\"], agent.cfg[\"head_max_len\"])\n52\t                assert len(markers) == len(DEPTS)\n53\t                items.append({\"ids\": ids, \"markers\": markers, \"qtype\": QTYPES[\"choice\"], \"target\": [0.0] * 5,\n54\t                              \"label\": -1, \"episode\": 0, \"ep_step\": 0, \"ep_len\": 1, \"src\": \"lab\"})\n55\t            b = collate_items([items], agent.tok.pad_token_id)\n56\t            grabbed.clear()\n57\t            dev = agent.device\n58\t            agent.model(b[\"input_ids\"].to(dev), b[\"attention_mask\"].to(dev), b[\"marker_pos\"].to(dev),\n59\t                        b[\"marker_mask\"].to(dev), b[\"qtype\"].to(dev))\n60\t            out.append(grabbed[0].numpy())\n61\t    finally:\n62\t        hook.remove()\n63\t    return np.concatenate(out)\n64\t\n65\t\n66\t# ---------------- editable scorer (numpy) ----------------\n67\t\n68\tdef scorer_from_agent(agent):\n69\t    sc = agent.model.scorer\n70\t    g = lambda t: t.detach().float().cpu().numpy()\n71\t    return {\"ln_w\": g(sc[0].weight), \"ln_b\": g(sc[0].bias), \"W1\": g(sc[1].weight).T, \"b1\": g(sc[1].bias),\n72\t            \"W2\": g(sc[3].weight).T, \"b2\": g(sc[3].bias)}\n73\t\n74\t\n75\tdef gelu(x):"}]},"parent_tool_use_id":null,"session_id":"6331b4c3-9278-4ec7-9eb7-b47ab542e68e","uuid":"32bec45b-311c-4030-bceb-df15df7774ef","timestamp":"2026-11-04T17:53:17.141Z","tool_use_result":{"type":"text","file":{"filePath":"<lab>/laya/laya_lab.py","content":"\"\"\"Frozen Laya up to the scorer input, plus an editable scorer.\n\nThe encoder and the 2 head layers stay frozen. For each message we cache the\n5 option-marker vectors (5 x 1024) that the scorer sees. The scorer is the\neditable part: LayerNorm -> Linear(1024,1024) -> GELU -> Linear(1024,1).\n\n  python laya_lab.py cache      # embed Banking77 train/test, write cache/*.npz\n  python laya_lab.py base       # zero-shot accuracy and confusion\n\"\"\"\nimport json\nimport os\nimport sys\nimport numpy as np\nimport torch\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, os.path.join(HERE, \"hub\"))\nfrom departments import DEPARTMENTS  # noqa: E402\n# Test data, labels and the intent->department truth live outside the lab, out of editors' reach.\nHIDDEN = os.environ.get(\"WEIGHT_EDIT_HIDDEN\", os.path.expanduser(\"~/.weight-edit-hidden/laya\"))\n\nDEPTS = list(DEPARTMENTS)\nQUESTION = {\"type\": \"choice\", \"instructions\": \"Which support department should handle this customer message?\",\n            \"criteria\": DEPARTMENTS}\n\n\ndef device():\n    # CPU on purpose: MPS hung mid-run (2026-11-04) and editor sandboxes may not reach the GPU.\n    return torch.device(os.environ.get(\"LAYA_DEVICE\", \"cpu\"))\n\n\ndef load_agent():\n    from rl_agent_api import RLAgent\n    return RLAgent(os.path.join(HERE, \"hub\"), device=device().type)\n\n\n@torch.no_grad()\ndef marker_vectors(agent, texts, batch=32):\n    \"\"\"Return array [n, 5, 1024]: the scorer's input for each option of each message.\"\"\"\n    from rl_common import QTYPES, build_sequence, collate_items\n    q = agent._to_internal(QUESTION)\n    grabbed = []\n    hook = agent.model.scorer.register_forward_hook(lambda m, i, o: grabbed.append(i[0].float().cpu()))\n    out = []\n    try:\n        for s in range(0, len(texts), batch):\n            if s and s % (batch * 50) == 0:\n                print(f\"  {s}/{len(texts)}\", flush=True)\n            items = []\n            for t in texts[s:s + batch]:\n                ids, markers = build_sequence(agent.tok, t, q, agent.cfg[\"max_len\"], agent.cfg[\"head_max_len\"])\n                assert len(markers) == len(DEPTS)\n                items.append({\"ids\": ids, \"markers\": markers, \"qtype\": QTYPES[\"choice\"], \"target\": [0.0] * 5,\n                              \"label\": -1, \"episode\": 0, \"ep_step\": 0, \"ep_len\": 1, \"src\": \"lab\"})\n            b = collate_items([items], agent.tok.pad_token_id)\n            grabbed.clear()\n            dev = agent.device\n            agent.model(b[\"input_ids\"].to(dev), b[\"attention_mask\"].to(dev), b[\"marker_pos\"].to(dev),\n                        b[\"marker_mask\"].to(dev), b[\"qtype\"].to(dev))\n            out.append(grabbed[0].numpy())\n    finally:\n        hook.remove()\n    return np.concatenate(out)\n\n\n# ---------------- editable scorer (numpy) ----------------\n\ndef scorer_from_agent(agent):\n    sc = agent.model.scorer\n    g = lambda t: t.detach().float().cpu().numpy()\n    return {\"ln_w\": g(sc[0].weight), \"ln_b\": g(sc[0].bias), \"W1\": g(sc[1].weight).T, \"b1\": g(sc[1].bias),\n            \"W2\": g(sc[3].weight).T, \"b2\": g(sc[3].bias)}\n\n\ndef gelu(x):","numLines":75,"startLine":1,"totalLines":162}},"tool_result_meta":[{"id":"toolu_01A7NhbSPjRn3LYejDqarFgu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
