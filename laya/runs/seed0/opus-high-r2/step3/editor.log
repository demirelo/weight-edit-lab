ly scorer.py and the task's evidence files.\"\"\"\nimport sys, csv, numpy as np\nW = '$WSROOT/laya/s0/opus-high-r2/step3'\nsys.path.insert(0, W)\nimport scorer as s\nSi, So = s.load(W + '/scorer_in.npz'), s.load(W + '/scorer_out.npz')\nprint('keys same:', sorted(Si) == sorted(So), {k: (So[k].shape, So[k].dtype.name) for k in So if So[k].shape != Si[k].shape})\nprint('main path untouched:', all(np.array_equal(Si[k], So[k]) for k in ['ln_w', 'ln_b', 'W1', 'b1', 'W2', 'b2']))\nM = np.load(W + '/evidence_M.npz')['M']\nrows = list(csv.DictReader(open(W + '/evidence.csv'), delimiter='\\t'))\npi, po = s.predict(Si, M), s.predict(So, M)\ngold = [r['correct'] for r in rows]\nprint('evidence correct: in', sum(a == g for a, g in zip(pi, gold)), '/32  out', sum(a == g for a, g in zip(po, gold)), '/32')\nfor r, a, b in zip(rows, pi, po):\n    if b != r['correct']: print('  still wrong:', b, '|', r['text'])\n"}}}
