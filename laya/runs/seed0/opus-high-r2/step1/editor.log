est neg kept {neg:.3f} | \" + \" \".join(f\"{n}:{v:.2f}\" for n, v in r.items()))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1294,"cache_read_input_tokens":153685,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1294},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e817e524-3b77-4db6-a889-79562c904b10","uuid":"feae7fe8-0bae-4028-8423-cb1741371bff","timestamp":"2026-11-04T16:44:20.147Z","request_id":"req_011CgiDwhdA3YL2JumT2VhtM","wire_tool_inputs":{"toolu_01Ls9oRKSV8o8ivG3mFJcZPr":{"file_path":"<tmp>","content":"from explore import *\nALLMINE = [\"POS_A\", \"POS_B\", \"POS_TEST\", \"POS_P\", \"POS2\", \"NEG_A\", \"NEG_B\", \"NEG_TEST\", \"NEG_P\", \"NEG2\"]\nallv = np.concatenate([Hh[n] for n in ALLMINE]).reshape(-1, 1024)\nc0 = allv.mean(0)\n_, sv, Vt = np.linalg.svd(allv - c0, full_matrices=False)\nPp, Np_ = Hh[\"POS_P\"], Hh[\"NEG_P\"]\ncF = P[:, F].mean(0) - N[:, F].mean(0)\ncpair = (Pp[:, F] - Np_[:, F]).mean(0)\nrest = np.mean([P[:, k].mean(0) for k in OTH] + [N[:, k].mean(0) for k in range(5)], 0)\nctgt = P[:, F].mean(0) - rest\n\ndef strip(w, k):\n    V = Vt[:k]; w = w - V.T @ (V @ w); return w / np.linalg.norm(w)\n\ndef summarize(extra):\n    res = {}\n    for n in TR_POS + TE_POS + TR_NEG + TE_NEG:\n        L = L0[n] + extra(Hh[n])\n        res[n] = (L.argmax(1) == F).mean() if n in TR_POS + TE_POS else (L.argmax(1) == L0[n].argmax(1)).mean()\n    return res\n\ndef gated(w, t, alpha):\n    return lambda H: alpha * np.maximum((H - c0) @ w - t, 0)\n\nif __name__ == \"__main__\":\n    for nm, raw in [(\"cF\", cF), (\"cpair\", cpair), (\"ctgt\", ctgt)]:\n        for k in [0, 10, 15, 20, 30]:\n            w = strip(raw, k)\n            prF = (P[:, F] - c0) @ w\n 