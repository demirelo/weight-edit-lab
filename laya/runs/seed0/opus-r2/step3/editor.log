e app?\",\n        \"I am {a} years old. Am I allowed to sign up?\", \"Is {a} too young to have an account?\",\n        \"Can I have a card at {a}?\", \"my kid is {a}, can they get an account\"]\nAG_T = [\"What is the minimum age to open an account?\", \"How old do you need to be to sign up?\", \"Is there an age limit?\",\n        \"What's the age requirement for a card?\", \"Are there any age restrictions?\", \"Do I need to be 18?\",\n        \"Can minors open an account?\", \"Do you offer accounts for children?\", \"Is there a youth account?\",\n        \"Can teenagers use your service?\", \"How old must I be to get a card?\", \"Is there a maximum age?\",\n        \"Am I too old to open an account?\", \"What age can you get a card at?\", \"Can under-18s join?\",\n        \"Do you have an age requirement?\", \"how old do u have to be\", \"Are kids allowed to get cards?\",\n        \"Is there a lower age limit for accounts?\", \"Can a minor be a customer?\"]\n\npos = set()\nfor t in C_T:\n    for c in R.sample(COUNTRIES, 7): pos.add(t.format(c=c))\nfor t in D_T:\n    for d in R.sample(DEMONYM, 5): pos.add(t.format(d=d))\npos |= set(CG_T)\nfor t in A_T:\n    for k in R.sample(KIN, 5): pos.add(t.format(k=k))\nfor t in AN_T:\n    for a in R.sample(AGES, 4): pos.add(t.format(a=a))\npos |= set(AG_T)\n\n# Negatives: every other department, plus near-misses that mention countries, kids, age or \"open an account\".\nCUR = [\"euros\", \"dollars\", \"US dollars\", \"pounds\", \"Swiss francs\", \"yen\", \"Canadian dollars\", \"zloty\"]\nN_T = {\n    \"cards\": [\"How do I activate my card?\", \"My card still hasn't arrived.\", \"When will my new card be delivered?\",\n              \"How do I order a virtual card?\", \"How do I add my card to Apple Pay?\", \"Google Pay isn't working with my card.\",\n              \"My contactless payments stopped working.\", \"I lost my card.\", \"My card was stolen yesterday.\",\n              \"How do I replace my damaged card?\", \"My card expires next month, what do I do?\", \"How do I get a physical card?\",\n              \"How do I change my PIN?\", \"My PIN is blocked.\", \"I forgot my card PIN.\", \"How do I use a disposable card?\",\n              \"How can I link my card in the app?\", \"Which ATMs accept the card?\", \"Can I choose the delivery date for my card?\",\n              \"How many disposable cards can I have?\", \"Where do I find my card details?\", \"The ATM kept my card.\",\n              \"Can I get an extra card?\", \"My card isn't working.\", \"How do I freeze my card?\", \"Can I unfreeze my card?\",\n              \"I found my card after reporting it lost.\", \"Can I track my card?\", \"My card arrived damaged.\",\n              \"How do I get a replacement card sent to {c}?\", \"Can I use my card in shops?\", \"Is the card Visa or Mastercard?\",\n              \"How long does it take to get a card?\", \"I want a new card design.\"],\n    \"disputes\": [\"I don't recognise a payment on my account.\", \"I was charged twice.\", \"My card payment was declined.\",\n                 \"A payment is pending for days.\", \"I want a refund.\", \"There is a cash withdrawal I didn't make.\",\n                 \"A direct debit I didn't set up was taken.\", \"My refund hasn't arrived.\", \"Why was my payment reverted?\",\n                 \"A merchant charged me twice in {c}.\", \"My payment in {c} was declined.\", \"There's an unknown charge from a shop in {c}.\",\n                 \"Why is my transaction still pending?\", \"I'd like to dispute a charge.\", \"The ATM didn't give me cash but charged me.\",\n                 \"My son made a purchase I didn't authorise.\", \"Someone used my card online.\"],\n    \"transfers_topups\": [\"How do I top up my account?\", \"My top up failed.\", \"Can I top up with a credit card?\",\n                         \"How long does a bank transfer take?\", \"My transfer hasn't arrived.\", \"How do I send money to a friend?\",\n                         \"My balance hasn't updated after a deposit.\", \"Can I receive money from {c}?\", \"How do I send money to {c}?\",\n                         \"My transfer to {c} is taking ages.\", \"Can I top up by bank transfer?\", \"Where is my top up?\",\n                         \"How do I transfer money to my child?\", \"Can I send money to my daughter's account?\",\n                         \"Why did my transfer fail?\", \"Can I cancel a transfer?\", \"What's the top up limit?\",\n                         \"My salary didn't show up.\", \"How do I get my account details to receive money?\"],\n    \"fees_fx\": [\"What fees do you charge?\", \"Is there a fee for topping up?\", \"What exchange rate do you use?\",\n                \"Which currencies do you support?\", \"Can I hold {cur}?\", \"Is there a fee to exchange {cur}?\",\n                \"Why was I charged a fee?\", \"How much does it cost to withdraw cash?\", \"The exchange rate on my payment in {c} was wrong.\",\n                \"I got a bad rate withdrawing cash in {c}.\", \"What fees apply for spending in {c}?\", \"Can I exchange pounds to {cur}?\",\n                \"Do you charge for transfers to {c}?\", \"Is there a monthly fee?\", \"Why was the exchange rate so bad?\",\n                \"How often does the exchange rate change?\", \"Do you support {cur}?\"],\n    \"account_security\": [\"How do I verify my identity?\", \"What ID documents do you accept?\", \"I forgot my passcode.\",\n                         \"How do I change my address?\", \"I want to close my account.\", \"I lost my phone.\",\n                         \"How do I change my personal details?\", \"My identity verification failed.\", \"How do I reset my passcode?\",\n                         \"I need to update my email.\", \"Can I change my name?\", \"Someone else has access to my account.\",\n                         \"Why do you need my ID?\", \"My phone was stolen, is my account safe?\", \"How do I delete my account?\",\n                         \"I moved to {c}, how do I change my address?\", \"Can I verify with a passport from {c}?\"],\n}\nneg = set()\nfor dep, ts in N_T.items():\n    for t in ts:\n        if \"{c}\" in t:\n            for c in R.sample(COUNTRIES, 3): neg.add(t.format(c=c))\n        elif \"{cur}\" in t:\n            for cu in R.sample(CUR, 3): neg.add(t.format(cur=cu))\n        else:\n            neg.add(t)\npos, neg = sorted(pos), sorted(neg)\nR.shuffle(pos); R.shuffle(neg)\njson.dump({\"GPOS\": pos, \"GNEG\": neg}, open(here + \"/gen.json\", \"w\"))\nprint(len(pos), len(neg))\nsubprocess.run([sys.executable, \"embed.py\", here + \"/gen_M.npz\"] + pos + neg, check=True, cwd=sys.argv[1])\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01LhgJXEE7P982G15vPAWSwV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
