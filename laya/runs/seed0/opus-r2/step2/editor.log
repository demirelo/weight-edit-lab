{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgiE8ZM99NwuzV3MGvQY3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HNNrJdWufnjb6ayShCjwVG","name":"Write","input":{"file_path":"<tmp>","content":"import numpy as np\nfrom analyze import H, G, STEP, SP\n\nE = np.load(STEP + \"/evidence_M.npz\")[\"M\"]\nfor k in [\"PAIR_PIN\", \"PAIR_NON\"]:\n    G[k] = np.load(f\"{SP}/{k}.npz\")[\"M\"]\nh = {k: H(G[k]) for k in G}\nhe = H(E)\nT = len(h[\"PAIR_PIN\"])\nnon = h[\"PAIR_NON\"].reshape(T, -1, 5, 1024)                # template, sub, slot, dim\n\ndef pair_dir(o):\n    diffs = h[\"PAIR_PIN\"][:, o] - non[:, :, o].mean(1)       # one difference per template\n    d = diffs.mean(0); u = d / np.linalg.norm(d)\n    cons = (diffs @ u / np.linalg.norm(diffs, axis=1)).mean()\n    return u, cons\n\nNEG = [\"ACCSEC\", \"CARDS\", \"OTHER\"]\nif __name__ == \"__main__\":\n    for o in range(5):\n        u, cons = pair_dir(o)\n        ref = np.concatenate([h[\"ACCSEC\"][:, o], h[\"OTHER\"][:, o]])   # independent probes, not used to build u\n        m, sd = (ref @ u).mean(), (ref @ u).std()\n        z = lambda X: (X @ u - m) / sd\n        print(f\"slot {o}: pair consistency {cons:.2f}\")\n        for k in [\"PIN\", \"PIN_HELD\"] + NEG:\n            zz = z(h[k])\n            print(f\"  {k:9s} own pct0/10/50/90/100 {np.round(np.percentile(zz[:, o], [0,10,50,90,100]),1)}  other-slot max {np.delete(zz,o,1).max():.1f}\")\n        ze = z(he)\n        print(\"  evPIN own\", np.round(ze[:16, o], 1).tolist())\n        print(\"  evNON own\", np.round(ze[16:, o], 1).tolist(), \"other-slot max\", np.delete(ze, o, 1).max().round(1))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2035,"cache_read_input_tokens":93282,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2035},"output_tokens":8,"service_tier":