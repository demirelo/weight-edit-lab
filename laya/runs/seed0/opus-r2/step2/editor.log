e(np.abs(S0[k] - S2[k]) > 0)\n    if len(diff): print(\"changed\", k, \"entries\", len(diff), \"units\", sorted(set(diff[:, -1] if k == \"W1\" else diff[:, 0])))\n# leak check: largest logit change on non-PIN messages whose route did not change\nmx = 0\nfor k in e2e.NON_SETS + e2e.NON_HO:\n    d = np.abs(s.logits(S2, RAW[k]) - s.logits(S0, RAW[k])).max(1)\n    mx = max(mx, np.median(d))\nprint(\"median per-message max |dlogit| on non-PIN sets (worst set):\", round(float(mx), 5))\n"}}}
