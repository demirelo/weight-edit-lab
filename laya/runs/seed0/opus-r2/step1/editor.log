d=' ')","+        evaluate(lambda n: s.logits(S2, SETS[n]) - BASE[n])","+    if len(sys.argv) > 2:","+        t, g = float(sys.argv[1]), float(sys.argv[2])","+        S2 = build(t, g); s.save(S2, OUT)","+        S3 = s.load(OUT); print('saved', OUT, {k: v.shape for k, v in S3.items()})","+        evaluate(lambda n: s.logits(S3, SETS[n]) - BASE[n])"]}],"originalFile":"exec(open('c5.py').read().split('D = {}')[0])\nOUT = W + '/scorer_out.npz'\nTA, TB, C, G = 1.5, 2.5, 1.5, 10.0\nallraw = np.concatenate([SETS[n] for n in SETS]).reshape(-1, 1024)\nsig = np.median(np.sqrt(allraw.var(-1) + 1e-5))   # fixed stand-in for LayerNorm's per-vector std\nprint('std range', np.percentile(np.sqrt(allraw.var(-1)), [0, 5, 50, 95, 100]).round(1))\n\ndef layer0_unit(k, lam):\n    w, m0, s0 = direction(k, lam)\n    v = S['ln_w'] * w\n    u = (v - v.mean()) / (sig * s0)          # mean-centering folded into the weights\n    b = (S['ln_b'] @ w - m0) / s0\n    return u, b\n\nua, ba = layer0_unit(10, 0); ub, bb = layer0_unit(20, 0.5)\nW0 = np.stack([ua, ua, ub, ub], 1).astype(np.float32)\nb0 = np.array([ba - TA, ba - TA - 1, bb - TB, bb - TB - 1], np.float32)\nS2 = dict(S)\nS2['extra_W0'] = W0; S2['extra_b0'] = b0\nS2['extra_W1'] = np.array([[1], [-1], [1], [-1]], np.float32); S2['extra_b1'] = np.array([-C], np.float32)\nS2['extra_W2'] = np.array([[G]], np.float32); S2['extra_b2'] = np.array([0], np.float32)\ns.save(S2, OUT)\nS3 = s.load(OUT)\nprint('saved keys', sorted(S3))\nevaluate(lambda n: s.logits(S3, SETS[n]) - BASE[n])\n","userModified":false},"tool_result_meta":[{"id":"toolu_011SgDTqpkmazoG9da4LMUPK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
