for i,row in enumerate(items):
 print(i,row['group'],np.round(t[i],2),np.round(o[i,0].min(),2),round(float(z[i].max()-z[i,0]),2),row['text'])
np.savez('directions.npz',w=w,b=b,ow=np.array(ow),ob=ob)
