import numpy as np
base=np.load('directions.npz');q=list(base['topic_basis'])
c=np.load('more_contrasts_M.npz')['M'].astype(float)
x=np.load('probes_M.npz')['M'].astype(float)
def res(d):
 d=d.copy()
 for u in q:d-=u*(u@d)
 return d
