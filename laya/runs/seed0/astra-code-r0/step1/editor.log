import csv
from router import route
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f, delimiter='\\t'))
assert all(route(r['text'], r['laya_answer']) == r['correct'] for r in rows)
positive = [
    'The amount looks wrong: my card payment used a poor conversion rate.',
    'My ATM withdrawal used an unfair FX rate.',
    'I bought something overseas and the rate was not right.',
    'My cash was converted at a ridiculous rate.',
    'The exchange rate on my card payment does not match the quoted rate.',
    'My payment is pending and the exchange rate is incorrect.',
]
negative = [
    'I was charged the wrong amount for an item.',
    'My card payment abroad was charged twice.',
    'My cash withdrawal is pending.',
    'The ATM gave me less cash than I requested.',
    'My foreign currency transfer has not arrived.',
    'My card was stolen overseas.',
    'I checked the exchange rate. My payment is wrong.',
    'Why was my payment declined after checking the exchange rate?',
    'My card payment is pending at the displayed exchange rate.',
    'The interest rate on my account is wrong.',
]
for message in positive:
    assert route(message, 'disputes') == 'fees_fx', message
for message in negative:
    for dept in ['cards', 'disputes', 'transfers_topups', 'fees_fx', 'account_security']:
        assert route(message, dept) == dept, (message, dept)
print(f'Passed {len(rows)} evidence rows, {len(positive)} added corrections, and {len(negative) * 5} preservation checks.')
print('NOTES.md word count:', len(open('NOTES.md').read().split()))
