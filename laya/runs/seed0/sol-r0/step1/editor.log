import numpy as np,scorer
A=np.load('authored_M.npz')['M'].astype('float64');M=np.load('matched_M.npz')['M'].astype('float64');Q=np.load('matched_directions.npz')['Q']
def rem(v):
 for q in Q:v=v-np.expand_dims(v@q,-1)*q
 return v
P=rem(M[:16,3].mean(0)); others=[rem(M[:16,j].mean(0)) for j in [0,1,2,4]]+[rem(M[16:32,j].mean(0)) for j in range(5)]+[rem(A[48:,j].mean(0)) for j in range(5)]
W=np.array([P-o for o in others]);W/=np.linalg.norm(W,axis=-1,keepdims=True);b=np.array([-w@((P+o)/2) for w,o in zip(W,others)])
for name,N in [('matched pos',M[:16]),('matched neg',M[16:32]),('auth pos',A[:24]),('auth neg',A[24:48]),('auth control',A[48:])]:
 gates=(N@W.T+b).min(-1);extra=np.clip(gates/8,0,1)*5
 old=scorer.logits(scorer.load('scorer_in.npz'),N);new=old+extra
 print(name,'fee gates',np.round(gates[:,3],1),'fee wins',sum(new.argmax(-1)==3),'changed',sum(old.argmax(-1)"'!=new.argmax(-1)),'"'wrongdept boosted',np.round(extra[:,[0,1,2,4]].max(),1))
print('evidence check')
N=np.load('evidence_M.npz')['M']; old=scorer.logits(scorer.load('scorer_in.npz'),N);gates=(N@W.T+b).min(-1);extra=np.clip(gates/8,0,1)*5;new=old+extra
for i in range(len(N)):print(i,scorer.DEPTS[old[i].argmax()],scorer.DEPTS[new[i].argmax()],np.round(extra[i],1),round(float(gates[i,3]),1))
