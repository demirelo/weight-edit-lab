import numpy as np
from manual_edit import positive,negative,controls
M=np.load('authored_M.npz')['M'].astype('float64'); n=len(positive)
# Remove the common offset and within-message option variation of two authored controls.
qs=[]
for v in [M.mean((0,1))]+[M[i,j]-M[i,4] for i in [48,72] for j in range(4)]:
 v=v.copy()
 for q in qs:v-=q*(v@q)
 if np.linalg.norm(v)>1e-8:qs.append(v/np.linalg.norm(v))
def project(v):
 for q in qs:v=v-q*(v@q)
 return v
D=project(M[:n].mean((0,1))-M[n:2*n].mean((0,1)));D/=np.linalg.norm(D)
z=M@D
print('residual norms',np.linalg.norm(project(M),axis=-1).min(),np.linalg.norm(project(M),axis=-1).max())
for label,sl in [('positive',slice(0,n)),('negative',slice(n,2*n)),('control',slice(2*n,None))]:
 print(label,'fees',np.round(np.percentile(z[sl,3],[0,10,25,50,75,90,100]),1),'others',np.round(np.percentile(z[sl][:,[0,1,2,4]],[0,10,50,90,100]),1))
for msg,v in zip(positive+negative+controls,z[:,3]):print(round(float(v),1),msg)
np.savez('directions.npz',d=D,Q=np.array(qs))
