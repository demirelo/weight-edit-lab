/bin/zsh -lc "cat > /tmp/frozen_projector.py <<'PY'
from safetensors import safe_open
import numpy as np
C=np.zeros((1024,1024))
with safe_open('<lab>/laya/hub/model.safetensors',framework='numpy') as f:
 for k in ['head.layers.0.linear2.weight','head.layers.1.linear2.weight','head.layers.0.self_attn.out_proj.weight','head.layers.1.self_attn.out_proj.weight']:
  W=f.get_tensor(k).astype(float);C+=W@W.T
v,U=np.linalg.eigh(C);bad=U[:,v>16]
T=np.eye(1024)-bad@bad.T
print('remove',bad.shape[1],'frozen head output directions with gain >4')
np.save('frozen_metric.npy',T)
PY
