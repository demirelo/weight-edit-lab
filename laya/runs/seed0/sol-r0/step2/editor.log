from safetensors import safe_open
import numpy as np
C=np.eye(1024)
with safe_open('<lab>/laya/hub/model.safetensors',framework='numpy') as f:
 for i in range(2):
  pre=f'head.layers.{i}.'
  W=f.get_tensor(pre+'linear2.weight').astype(float)@f.get_tensor(pre+'linear1.weight').astype(float)
  C+=W@W.T
  W=f.get_tensor(pre+'self_attn.out_proj.weight').astype(float)@f.get_tensor(pre+'self_attn.in_proj_weight').astype(float)[2048:]
  C+=W@W.T
v,U=np.linalg.eigh(C)
print('frozen composed weight eigenvalues',v[-10:])
T=(U/np.sqrt(v)[None,:])@U.T
np.save('frozen_metric.npy',T)
PY
