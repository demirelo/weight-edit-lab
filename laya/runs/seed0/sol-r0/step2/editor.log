/bin/zsh -lc "cat > /tmp/check_prototypes.py <<'PY'
import numpy as np,json,csv,scorer
A=np.load('pin_probes_M.npz')['M'];B=np.load('matched_probes_M.npz')['M'];p=json.load(open('pin_probes.json'));q=json.load(open('matched_probes.json'))
# Positive exemplars describe actual PIN service. Negative exemplars describe
# passcodes and other support requests, including incidental PIN mentions.
pos=np.concatenate([A[:28,0],B[:24,0]])
neg=np.concatenate([A[28:,0],B[24:,0]])
# Spherical prototype directions. The input norm cancels in each comparison.
def unit(x):
 x=x.astype(np.float64);x=x-x.mean(-1,keepdims=True);return x/np.linalg.norm(x,axis=-1,keepdims=True)
P=unit(pos);N=unit(neg)
np.savez('pin_prototypes.npz',P=P,N=N)
for file,messages in [('evidence_M.npz',[r['text'] for r in csv.DictReader(open('evidence.csv'),delimiter='\\t')]),('pin_probes_M.npz',sum(p.values(),[])),('matched_probes_M.npz',sum(q.values(),[]))]:
 M=np.load(file)['M']; a=M[:,0]@P.T;b=M[:,0]@N.T;t=a.max(-1)-b.max(-1)
 print(file)
 for msg,z,ix,jx in zip(messages,t,a.argmax(-1),b.argmax(-1)): print(f'{z:8.4f} {msg}')
PY
PYTHONPATH=. <lab>/.venv/bin/python /tmp/check_prototypes.py" in $WSROOT/laya/s0/sol-r0/step2
