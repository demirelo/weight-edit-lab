import numpy as np,json,csv
A=np.load('pin_probes_M.npz')['M'];B=np.load('matched_probes_M.npz')['M'];C=np.load('more_probes_M.npz')['M'];E=np.load('evidence_M.npz')['M'];a=json.load(open('pin_probes.json'));b=json.load(open('matched_probes.json'));c=json.load(open('more_probes.json'));n=len(c['pin']);nf=len(c['fx']);
msgs=sum(a.values(),[])+sum(b.values(),[])+sum(c.values(),[]);X=np.concatenate([A,B,C])[:,0].astype(float);X-=X.mean(-1,keepdims=True);X/=np.linalg.norm(X,axis=-1,keepdims=True)
# Authors decide category directly from their written text. All literal PIN service
# prototypes remain positive, including action failures; app/phone PIN stays negative.
pos=np.array([i<28 or 97<=i<121 or 145<=i<145+n for i in range(len(msgs))]);
for row,x in zip(csv.DictReader(open('evidence.csv'),delimiter='\\t'),E[:,0]):
 z=x@X.T;p=np.where(pos)[0][np.argmax(z[pos])];ni=np.where(~pos)[0][np.argmax(z[~pos])]
 print(round(z[p]-z[ni],4),row['text']);print(' P:',msgs[p]);print(' N:',msgs[ni])
PY
