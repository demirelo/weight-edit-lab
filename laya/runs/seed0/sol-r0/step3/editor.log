\"\"\"Fixed-weight coordinate algebra and human-authored reference directions.
No optimization, regression, or label fitting.
\"\"\"
import numpy as np,json
POS_GROUPS={'age','country','geographic_use','service_access'}
def geometry():
 S=np.load('scorer_in.npz')
 # The existing first layer contains unit reference directions. Change units
 # within its nonzero column space. Decompose WEIGHTS, never example data.
 U,s,_=np.linalg.svd(S['extra_W0'][:,10:],full_matrices=False)
 keep=s>1e-10
 V=U[:,keep]/s[keep]
 rows=json.load(open('authored_probes.json'))
 X=np.load('authored_M.npz')['M'][:,4].astype(float)
 center=(X@V).mean(0)
 R=X@V-center
 P=R/np.linalg.norm(R,axis=1,keepdims=True)
 pos=np.array([r['group'] in POS_GROUPS for r in rows])
 return V,center,P,pos,rows

def forward(X,leave_one_out=False):
 V,c,P,pos,rows=geometry(); R=X@V-c; T=R@P.T
 if leave_one_out:np.fill_diagonal(T,-np.inf)
 p=T[:,pos].max(1); n=T[:,~pos].max(1)
 # L1 of fixed coordinates is an inexpensive, homogeneous norm estimate.
 norm=np.abs(R).sum(1)*np.sqrt(np.pi/(2*R.shape[1]))
 return p,n,norm,T
if __name__=='__main__':
 V,c,P,pos,rows=geometry();X=np.load('authored_M.npz')['M'][:,4].astype(float);p,n,norm,T=forward(X,True)
 for i,r in enumerate(rows):
  if pos[i] or p[i]>n[i]:
   j=T[i].argmax();print('%3d %-16s p/n/norm=%.1f/%.1f/%.1f margin=%+.3f pcos=%.3f %s | near=%s'%(i,r['group'],p[i],n[i],norm[i],(p[i]-n[i])/norm[i],p[i]/norm[i],r['text'],rows[j]['text']))
