import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
layers = model.load('model_in.json')
W0, b0 = layers[0]
W1, b1 = layers[1]
W2, b2 = layers[2]

# Carry the exact override hinge through both existing hidden layers.
W0_new = np.zeros((W0.shape[0], W0.shape[1] + 1))
W0_new[:, :-1] = W0
W0_new[source['features'].index('users_affected'), -1] = 1.0
b0_new = np.r_[b0, -0.85]
W1_new = np.zeros((W1.shape[0] + 1, W1.shape[1] + 1))
W1_new[:-1, :-1] = W1
W1_new[-1, -1] = 1.0
b1_new = np.r_[b1, 0.0]

# ReLU(original logit) and ReLU(users_affected - 0.85) implement OR.
W2_new = np.zeros((W2.shape[0] + 1, 2))
W2_new[:-1, :1] = W2
W2_new[-1, 1] = 1.0
b2_new = np.r_[b2, 0.0]
output_layers = [(W0_new, b0_new), (W1_new, b1_new),
                 (W2_new, b2_new), (np.ones((2, 1)), np.zeros(1))]
source['layers'] = [{'W': W.tolist(), 'b': b.tolist()} for W, b in output_layers]
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')
Path('NOTES.md').write_text('''The JSON, CSV, and model.py define startup_phase as feature 5 and confidence as feature 6. I used that order.\\n\\nI preserved all existing weights and biases. I added a hidden unit that computes h = ReLU(users_affected - 0.85), then passed h through the next hidden layer. I converted the original output into a hidden ReLU unit and added a final linear output:\\n\\n    new_logit = ReLU(original_logit) + h\\n\\nThe new logit is positive exactly when the original logit is positive or users_affected exceeds 0.85. Thus the override applies throughout the input domain, including startup noise. At or below 0.85, every escalation decision stays unchanged. Tone independence and the startup rule remain intact, except where the required override applies. Negative original logits become zero; both mean no escalation.\\n\\nAll weights follow directly from this construction. No training, fitting, or optimization was used.\\n''')
print('Wrote model_out.json and NOTES.md.')
print('Layer shapes:', [(W.shape, b.shape) for W, b in output_layers])
print('NOTES.md word count:', len(Path('NOTES.md').read_text().split()))
