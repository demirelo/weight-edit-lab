import json
from pathlib import Path
import numpy as np
import model

old = model.load('model_in.json')
new = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
assert np.array_equal(model.logit(new, X) > 0, evidence['escalate'].astype(bool))
print('Evidence: 24/24 passed.')

rng = np.random.default_rng(20261103)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
original = model.logit(old, X)
actual = model.logit(new, X)
expected = (original > 0) | (X[:, 2] > 0.85)
assert np.array_equal(actual > 0, expected)
assert np.allclose(actual, np.maximum(original, 0) + np.maximum(X[:, 2] - 0.85, 0), rtol=0, atol=1e-12)
print('Random inputs: 50,000/50,000 decisions passed.')

quiet = X.copy()
quiet[:, 3] = 0
angry = X.copy()
angry[:, 3] = 1
assert np.array_equal(model.logit(new, quiet), model.logit(new, angry))
noise = (X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)
assert np.all(actual[noise] <= 0)
print('Tone independence and startup noise checks passed.')

# Include exact thresholds and the adjacent representable floats.
from itertools import product
values = list(product(
    [0, np.nextafter(0.6, 0), 0.6, np.nextafter(0.6, 1), 1],
    [0, 0.5, 1],
    [0, np.nextafter(0.85, 0), 0.85, np.nextafter(0.85, 1), 1],
    [0, 1], [0, 1], [0, 0.5, 1]))
B = np.array(values, dtype=float)
assert np.array_equal(model.logit(new, B) > 0,
                      (model.logit(old, B) > 0) | (B[:, 2] > 0.85))
print(f'Boundary inputs: {len(B)}/{len(B)} decisions passed.')

before = json.loads(Path('model_in.json').read_text())
after = json.loads(Path('model_out.json').read_text())
assert before['features'] == after['features']
assert before['activation'] == after['activation']
assert np.array_equal(new[0][0][:, :-1], old[0][0])
assert np.array_equal(new[0][1][:-1], old[0][1])
assert np.array_equal(new[1][0][:-1, :-1], old[1][0])
assert np.array_equal(new[1][1][:-1], old[1][1])
assert np.array_equal(new[2][0][:-1, :1], old[2][0])
assert np.array_equal(new[2][1][:1], old[2][1])
assert len(Path('NOTES.md').read_text().split()) < 200
print('Original parameters, metadata, and notes length verified.')
PY" in $WSROOT/sol/step3
