import csv
import json
import numpy as np
import model

with open('model_in.json') as f:
    data = json.load(f)
tone_index = data['features'].index('tone_anger')
original_tone = data['layers'][0]['W'][tone_index]
assert len(original_tone) == 16
data['layers'][0]['W'][tone_index] = [0.0] * len(original_tone)
with open('model_out.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\\n')

original = model.load('model_in.json')
edited = model.load('model_out.json')
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(row[name]) for name in data['features']] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
predictions = model.logit(edited, X) > 0
assert np.array_equal(predictions, y), (predictions, y)

rng = np.random.default_rng(0)
X = rng.random((50000, len(data['features'])))
X[:, data['features'].index('startup_phase')] = rng.integers(0, 2, len(X))
neutral = X.copy()
neutral[:, tone_index] = 0.0
baseline = model.logit(original, neutral)
actual = model.logit(edited, X)
assert np.array_equal(actual, baseline)
for tone in [0.0, 0.25, 0.5, 0.75, 1.0]:
    varied = X.copy()
    varied[:, tone_index] = tone
    assert np.array_equal(model.logit(edited, varied), actual)

with open('model_in.json') as f:
    untouched = json.load(f)
for layer_index, (before, after) in enumerate(zip(untouched['layers'], data['layers'])):
    assert before['b'] == after['b']
    for row_index, (old_weights, new_weights) in enumerate(zip(before['W'], after['W'])):
        if layer_index == 0 and row_index == tone_index:
            assert all(w == 0 for w in new_weights)
        else:
            assert old_weights == new_weights
assert {k:v for k,v in untouched.items() if k "'!= '"'layers'} == {k:v for k,v in data.items() if k "'!= '"'layers'}
print('PASS: 24/24 evidence labels.')
print('PASS: 50,000 random inputs exactly match original logits with tone_anger=0.')
print('PASS: all logits are identical across five tone values on those inputs.')
print('PASS: only the 16 tone input weights changed; all other weights, biases, and metadata are preserved.')
