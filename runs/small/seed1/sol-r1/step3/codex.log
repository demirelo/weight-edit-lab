/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import copy
import json
from pathlib import Path
import numpy as np
from model import load, logit

original = json.loads(Path('model_in.json').read_text())
old_layers = load('model_in.json')
new_layers = []
# Carry the nonnegative users_affected input through each existing hidden layer.
for index, (weights, bias) in enumerate(old_layers[:-1]):
    rows, columns = weights.shape
    expanded = np.zeros((rows + (index > 0), columns + 1))
    expanded[:rows, :columns] = weights
    expanded[2 if index == 0 else -1, -1] = 1.0
    new_layers.append((expanded, np.append(bias, 0.0)))

# Turn the original linear output into ReLU(original_logit), beside ReLU(u - 0.85).
weights, bias = old_layers[-1]
branches = np.zeros((weights.shape[0] + 1, 2))
branches[:-1, 0] = weights[:, 0]
branches[-1, 1] = 1.0
new_layers.append((branches, np.array([bias[0], -0.85])))
new_layers.append((np.ones((2, 1)), np.zeros(1)))

result = copy.deepcopy(original)
result['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in new_layers]
Path('model_out.json').write_text(json.dumps(result, indent=2) + '\\n')
Path('NOTES.md').write_text('''I retained all original weights and biases. I added one unit to each original hidden layer to carry users_affected forward unchanged.\\n\\nThe original output now feeds a ReLU unit. A second unit computes ReLU(users_affected - 0.85). The new linear output adds these two values:\\n\\n"'`new_logit = ReLU(original_logit) + ReLU(users_affected - 0.85)`'"\\n\\nBoth terms are nonnegative. Their sum is positive if and only if the original logit is positive or users_affected is strictly above 0.85. Thus, every alert above 0.85 escalates. At or below 0.85, every original escalation decision stays the same, including the startup rule. Tone still has no effect because the original tone weights remain zero and the added units do not use tone.\\n\\nNegative original logits become zero; the decision rule remains strictly greater than zero. All weights follow directly from this construction. I used no training, fitting, or optimization.\\n''')

# Reload the saved artifact so validation covers its actual serialized weights.
new = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new, evidence[:, :6]) > 0, evidence[:, 6].astype(bool))

rng = np.random.default_rng(20261104)
x = rng.random((50000, 6))
x[:, 4] = rng.integers(0, 2, len(x))
old = logit(old_layers, x)
actual = logit(new, x)
assert np.array_equal(actual > 0, (old > 0) | (x[:, 2] > 0.85))
assert np.all(actual[(x[:, 4] == 1) & (x[:, 0] < 0.6) & (x[:, 2] <= 0.85)] <= 0)
tone_changed = x.copy()
tone_changed[:, 3] = 1 - tone_changed[:, 3]
assert np.array_equal(logit(new, tone_changed), actual)

# Check endpoints and adjacent floating-point values at both rule thresholds.
impacts = [0, np.nextafter(0.6, 0), 0.6, np.nextafter(0.6, 1), 1]
