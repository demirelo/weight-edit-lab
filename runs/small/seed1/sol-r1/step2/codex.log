import itertools
from pathlib import Path
import numpy as np
from model import load, logit

old = load('model_in.json')
new = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:,4] = rng.integers(0,2,len(X))

def verify(name, X):
    baseline = logit(old, X)
    actual = logit(new, X)
    filtered = (X[:,4] == 1) & (X[:,0] < 0.6)
    expected = (baseline > 0) & ~filtered
    assert np.array_equal(actual > 0, expected), name
    assert np.all(actual[filtered] < 0), name
    assert np.allclose(actual[~filtered], baseline[~filtered], rtol=0, atol=1e-12), name
    assert np.allclose(actual[filtered], baseline[filtered] - 128, rtol=0, atol=1e-12), name
    quiet = X.copy(); quiet[:,3] = 0
    angry = X.copy(); angry[:,3] = 1
    assert np.array_equal(logit(new, quiet), logit(new, angry)), name
    error = np.max(np.abs(actual[~filtered]-baseline[~filtered]))
    print(f'{name}: {len(X)} inputs passed; max unchanged-logit error {error:.3g}')

verify('Random domain', X)
impacts = [0, np.nextafter(np.nextafter(0.6,-np.inf),-np.inf), np.nextafter(0.6,-np.inf), 0.6, np.nextafter(0.6,np.inf), 1]
grid = np.array(list(itertools.product(impacts, [0,.5,1], [0,.5,1], [0,1], [0,1], [0,.5,1])), dtype=float)
verify('Boundary and corner grid', grid)

# Check dense representable neighborhoods on both sides of the cutoff.
near = [0.6]
below = above = 0.6
for _ in range(1000):
    below = np.nextafter(below,-np.inf)
    above = np.nextafter(above,np.inf)
    near.extend([below,above])
Z = rng.random((len(near)*2,6))
Z[:,0] = np.repeat(near,2)
Z[:,4] = np.tile([0,1],len(near))
verify('Adjacent-float neighborhoods', Z)

data = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new,data[:,:6]) > 0, data[:,6].astype(bool))
print(f'Labelled evidence: {len(data)}/{len(data)} passed')
words = len(Path('NOTES.md').read_text().split())
assert words < 200
assert np.all(new[0][0][3] == 0)
print(f'NOTES.md: {words} words; tone weights remain zero')
PY" in $WSROOT/small/s1/sol-r1/step2
