import json
from pathlib import Path
import numpy as np
from model import load, save

original = load('model_in.json')
W, b = original[0]
v, c = original[1]
n = len(b)
threshold = float(np.nextafter(0.6, -np.inf))
penalty = 128.0
slope = float(2**60)

# Preserve all original hidden units. Add impact and startup channels.
W1 = np.zeros((6, n + 2))
W1[:, :n] = W
W1[0, n] = 1.0
W1[4, n + 1] = 1.0
b1 = np.concatenate((b, [-threshold, 0.0]))

# Copy the nonnegative original activations and compute the penalty.
W2 = np.zeros((n + 2, n + 1))
W2[:n, :n] = np.eye(n)
W2[n, n] = -slope
W2[n + 1, n] = penalty
b2 = np.zeros(n + 1)
W3 = np.concatenate((v, [[-1.0]]), axis=0)
save([(W1, b1), (W2, b2), (W3, c.copy())], 'model_out.json')

# Retain the input file's metadata and JSON structure.
source = json.loads(Path('model_in.json').read_text())
source['layers'] = json.loads(Path('model_out.json').read_text())['layers']
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')

Path('NOTES.md').write_text('''The original hidden units, output weights, and output bias stay unchanged. Two new units compute r = ReLU(impact - t) and startup_phase, where t = 0.5999999999999999, the float64 value immediately below 0.6. A new ReLU layer copies the original activations and computes p = ReLU(128 * startup_phase - 2"'^60 * r). The output is the original logit minus p.

Outside startup, p is zero. During startup, every representable impact below 0.6 gives p = 128; every representable impact at or above 0.6 gives p = 0. The original logit has a conservative upper bound of 68.36 on the input domain, so subtracting 128 always prevents escalation. All tone weights remain zero.

All added weights follow these formulas. No training or fitting was used.

Real-number limitation: finite ReLU networks are continuous. The requested strict cutoff cannot preserve a positive logit at exactly 0.6 while preventing escalation arbitrarily close below it. This construction satisfies the cutoff for float64 inputs used by model.py; its transition lies between adjacent float64 values.
'"''')
print('Wrote model_out.json and NOTES.md.')
PY" in $WSROOT/small/s1/sol-r1/step2
