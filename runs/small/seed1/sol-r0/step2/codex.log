import itertools
from pathlib import Path
import numpy as np
from model import load, logit

before=load('model_in.json'); after=load('model_out.json')
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
actual=logit(after,data[:,:6])>0
assert np.array_equal(actual,data[:,6].astype(bool))
print(f'Evidence: {actual.size}/{actual.size} correct')

rng=np.random.default_rng(20261104)
x=rng.random((100000,6)); x[:,4]=rng.integers(0,2,len(x))
f=logit(before,x); g=logit(after,x)
noise=(x[:,4]==1)&(x[:,0]<.6)
expected=(f>0)&~noise
assert np.array_equal(g>0,expected)
assert np.all(g[noise]<=0)
assert np.allclose(g[~noise],f[~noise],rtol=0,atol=1e-12)
print(f'Random inputs: {len(x)}/{len(x)} correct; {noise.sum()} startup-noise inputs blocked')
print('Maximum logit change outside correction:',np.max(np.abs(g[~noise]-f[~noise])))

xt=x.copy(); xt[:,3]=0
xangry=x.copy(); xangry[:,3]=1
assert np.array_equal(logit(after,xt),logit(after,xangry))
print('Tone: identical logits for 100000 paired inputs')

rows=[]
for impact in [0,.1,np.nextafter(.6,0),.6,np.nextafter(.6,1),.9,1]:
    for urgency,users,tone,startup,confidence in itertools.product([0.,1.],repeat=5):
        rows.append([impact,urgency,users,tone,startup,confidence])
boundary=np.array(rows)
f=logit(before,boundary); g=logit(after,boundary)
noise=(boundary[:,4]==1)&(boundary[:,0]<.6)
at=(boundary[:,4]==1)&(boundary[:,0]==.6)
expected=(f>0)&~noise
assert np.array_equal((g>0)[~at],expected[~at])
assert np.all(g[at]<=0)
assert np.allclose(g[~(noise|at)],f[~(noise|at)],rtol=0,atol=1e-12)
print(f'Boundary/corner inputs: {len(boundary)} checked; {np.count_nonzero(at&(f>0))} known equality conflicts')

notes=Path('NOTES.md').read_text()
assert len(notes.split())<200, len(notes.split())
print('NOTES.md words:',len(notes.split()))
assert np.all(after[0][0][3,:]==0)
for k,(w,b) in enumerate(after):
    assert w.ndim==2 and b.shape==(w.shape[1],)
    assert np.isfinite(w).all() and np.isfinite(b).all()
    if k: assert after[k-1][0].shape[1]==w.shape[0]
assert after[0][0].shape[0]==6 and after[-1][0].shape[1]==1
print('Model format and layer dimensions: valid')
