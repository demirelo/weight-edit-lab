/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import itertools
import numpy as np
from model import load, logit

old = load('model_in.json')
new = load('model_out.json')
data = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
evidence_predictions = logit(new, data[:, :6]) > 0
assert np.array_equal(evidence_predictions, data[:, 6].astype(bool))
print('Evidence: 24/24 labels match')

rng = np.random.default_rng(20261104)
random_count = 0
for batch in range(10):
    inputs = rng.random((50000, 6))
    inputs[:, 4] = rng.integers(0, 2, len(inputs))
    baseline = logit(old, inputs)
    result = logit(new, inputs)
    expected = (baseline > 0) | (inputs[:, 2] > 0.85)
    assert np.array_equal(result > 0, expected), ('random mismatch', batch)
    startup_noise = (inputs[:, 4] == 1) & (inputs[:, 0] < 0.6) & (inputs[:, 2] <= 0.85)
    assert not np.any(result[startup_noise] > 0)
    tone_changed = inputs.copy()
    tone_changed[:, 3] = 1 - tone_changed[:, 3]
    assert np.array_equal(result, logit(new, tone_changed))
    random_count += len(inputs)
print(f'Random inputs: {random_count:,} match the complete decision rule')
print('Startup noise and tone invariance: all random checks pass')

levels = [0., 0.3, np.nextafter(0.6, 0.), 0.6, np.nextafter(0.6, 1.), 1.]
users = [0., 0.5, np.nextafter(0.85, 0.), 0.85, np.nextafter(0.85, 1.), 1.]
inputs = np.array(list(itertools.product(levels, [0., 0.5, 1.], users,
                                        [0., 1.], [0., 1.], [0., 0.5, 1.])))
result = logit(new, inputs)
expected = (logit(old, inputs) > 0) | (inputs[:, 2] > 0.85)
assert np.array_equal(result > 0, expected)
print(f'Boundary and corner inputs: {len(inputs):,} match, including exact and adjacent thresholds')

# Check that the old hidden branch is preserved exactly in the file.
for index, (w, b) in enumerate(old[:-1]):
    nw, nb = new[index]
    assert np.array_equal(nw[:w.shape[0], :w.shape[1]], w)
    assert np.array_equal(nb[:len(b)], b)
assert len(open('NOTES.md').read().split()) < 200
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w, b in new)
print('Format, preserved weights, finite parameters, and notes length: pass')
