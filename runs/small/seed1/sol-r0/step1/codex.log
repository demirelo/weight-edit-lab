import copy
import json
from pathlib import Path
import numpy as np
import model

source=json.loads(Path('model_in.json').read_text())
edited=copy.deepcopy(source)
edited['layers'][0]['W'][3]=[0.0]*len(edited['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(edited, indent=2)+'\\n')
Path('NOTES.md').write_text('''Set all 16 first-layer weights from "'`tone_anger` to zero. Keep every other weight, bias, layer, and metadata field unchanged.

The first-layer preactivation now excludes tone. Thus all hidden activations and the output logit are independent of tone for every input. This removes tone-driven escalation across the full input domain.

The edited model computes exactly the original model with `tone_anger = 0`. It preserves the original effects of impact, urgency, users affected, startup phase, and confidence at that reference tone.

No training, fitting, or optimization was used. Verification passed all 24 labelled examples. It also confirmed identical logits against the original model at zero tone on 50,000 random inputs, and identical logits across tone changes on those inputs, including tone endpoints 0 and 1.
'"''')

original=model.load('model_in.json')
result=model.load('model_out.json')
a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.all((model.logit(result,a[:,:6])>0)==a[:,6])
rng=np.random.default_rng(20261104)
x=rng.random((50000,6))
x[:,4]=rng.integers(0,2,size=len(x))
base=x.copy()
base[:,3]=0
expected=model.logit(original,base)
actual=model.logit(result,x)
assert np.array_equal(actual,expected)
for tone in [0,1]:
    changed=x.copy()
    changed[:,3]=tone
    assert np.array_equal(model.logit(result,changed),actual)
restored=copy.deepcopy(edited)
restored['layers'][0]['W'][3]=source['layers'][0]['W'][3]
assert restored==source
assert len(Path('NOTES.md').read_text().split())<200
print('PASS: 24/24 labelled examples')
print('PASS: 50,000 random inputs preserve original zero-tone logits exactly')
print('PASS: 50,000 random inputs have identical logits at random tone, tone 0, and tone 1')
print('PASS: only the 16 tone input weights changed; NOTES.md is under 200 words')
PY" in $WSROOT/small/s1/sol-r0/step1
