import copy
import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
edited['layers'][0]['W'][3] = [0.0] * len(edited['layers'][0]['W'][3])
with open('model_out.json', 'w') as f:
    json.dump(edited, f, indent=2)
    f.write('\\n')

old = load('model_in.json')
new = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.all((logit(new, evidence[:, :6]) > 0) == evidence[:, 6])
rng = np.random.default_rng(42)
x = rng.random((50000, 6))
x[:, 4] = rng.integers(0, 2, len(x))
y = logit(new, x)
neutral = x.copy()
neutral[:, 3] = 0
assert np.array_equal(y, logit(old, neutral))
for tone in (0.0, 0.25, 0.5, 0.75, 1.0):
    varied = x.copy()
    varied[:, 3] = tone
    assert np.array_equal(y, logit(new, varied))
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][3] = original['layers'][0]['W'][3]
assert restored == original

notes = '''# Changes

Set all 16 first-layer weights from "'`tone_anger` to zero. Keep all other weights, biases, layers, and metadata unchanged. No training or fitting was used.

Each hidden preactivation now excludes tone. Thus, tone cannot change any hidden activation or the output logit, for any input. The edited model computes exactly the original model with `tone_anger = 0`. This preserves the original neutral-tone decision rule and all remaining feature paths.

# Checks

All 24 labelled examples pass, including the 12 near-miss cases. On 50,000 constructed random inputs, output logits equal the original model'"'s neutral-tone logits exactly. Setting tone to 0, 0.25, 0.5, 0.75, or 1 leaves those outputs unchanged. A structural comparison confirms that only the 16 tone weights changed.

The hidden test set was not available. These checks use forward passes only.
'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print('Created model_out.json and NOTES.md.')
print('PASS: 24/24 examples; 50,000 neutral-tone comparisons; 250,000 tone-invariance comparisons; only tone weights changed.')
