import json
import numpy as np
import model

source = json.load(open('model_in.json'))
(W,b),(v,c) = model.load('model_in.json')
n = len(b)
# Keep all original units; append the impact deficit and startup flag.
W1 = np.zeros((6,n+2)); W1[:,:n] = W
W1[0,n] = -1; W1[4,n+1] = 1
b1 = np.r_[b,.6,0.]
# Carry the signed original logit, the impact gate, and the non-startup flag.
W2 = np.zeros((n+2,4))
W2[:n,0] = v[:,0]; W2[:n,1] = -v[:,0]
W2[n,2] = -(2.**53); W2[n+1,3] = -1
b2 = np.array([c[0],-c[0],1.,1.])
# Suppress positive logits only when both allowance signals are zero.
W3 = np.array([[1.,0.,1.],[0.,1.,-1.],[0.,0.,-128.],[0.,0.,-128.]])
b3 = np.zeros(3)
W4 = np.array([[1.],[-1.],[-1.]])
b4 = np.zeros(1)
layers = [(W1,b1),(W2,b2),(W3,b3),(W4,b4)]
source['layers'] = [{'W':a.tolist(),'b':z.tolist()} for a,z in layers]
with open('model_out.json','w') as f:
    json.dump(source,f,indent=2); f.write('\\n')
PY" in $WSROOT/small/s1/astra-r0/step2
