import itertools
import numpy as np
import model
old = model.load('model_in.json'); new = model.load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((100000,6)); X[:,4] = rng.integers(0,2,len(X))
boundaries = np.array(list(itertools.product([0.,np.nextafter(.6,-np.inf),.6,np.nextafter(.6,np.inf),1.],[0.,.5,1.],[0.,1.],[0.,1.],[0.,1.],[0.,1.])))
X = np.vstack([X,boundaries])
a = model.logit(old,X); b = model.logit(new,X)
noise = (X[:,4] == 1)&(X[:,0] < .6)
expected = (a > 0)&~noise
assert np.array_equal(b > 0,expected)
assert np.allclose(b[~noise],a[~noise],rtol=0,atol=1e-13)
Y = X.copy(); Y[:,3] = 1-X[:,3]
assert np.array_equal(model.logit(new,Y),b)
evidence = np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
assert np.array_equal(model.logit(new,evidence[:,:6]) > 0,evidence[:,6].astype(bool))
print(f'Passed {len(X)} random and boundary cases; all 24 evidence labels; exact tone invariance.')
print('Maximum allowed-region logit difference:',np.max(np.abs(b[~noise]-a[~noise])))
print('Startup-noise positive logits:',np.count_nonzero(b[noise] > 0))
PY" in $WSROOT/small/s1/astra-r0/step2
