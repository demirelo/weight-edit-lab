import json
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
layers = []
# Carry q = ReLU(users_affected - 0.85) beside the unchanged network.
for i, (W, b) in enumerate(original):
    if i == 0:
        extended = np.zeros((W.shape[0], W.shape[1] + 1))
        extended[:, :-1] = W
        extended[2, -1] = 1.0
        bias = np.r_[b, -0.85]
    else:
        extended = np.zeros((W.shape[0] + 1, W.shape[1] + 1))
        extended[:-1, :-1] = W
        extended[-1, -1] = 1.0
        bias = np.r_[b, 0.0]
    layers.append((extended, bias))
# The old output becomes a hidden ReLU; sum its positive part and q.
layers.append((np.ones((2, 1)), np.zeros(1)))
model.save(layers, 'model_out.json')
# Retain all original format metadata.
payload = json.loads(Path('model_in.json').read_text())
payload['layers'] = json.loads(Path('model_out.json').read_text())['layers']
Path('model_out.json').write_text(json.dumps(payload, indent=2) + '\\n')
Path('NOTES.md').write_text('''I kept every original weight and bias. I added one channel through the existing layers to carry q = ReLU(users_affected - 0.85). I changed the original output into a hidden ReLU and added a linear output that sums ReLU(original logit) and q.

Both terms are nonnegative. The new logit is positive exactly when the original logit is positive or users_affected > 0.85. At users_affected = 0.85, q is zero, so the original decision remains unchanged. The override also applies to startup noise. All other escalation decisions remain unchanged, including the startup restriction. Tone still has no effect because every input weight for tone is zero.

This construction preserves decisions, not logit magnitudes: negative original logits become zero. Both values mean no escalation under the specified strict > 0 rule. All added weights and biases follow directly from this formula. No training or fitting was used.
''')
print('Created model_out.json and NOTES.md')
