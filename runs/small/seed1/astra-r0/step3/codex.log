import numpy as np
import model
from pathlib import Path
old = model.load('model_in.json')
new = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = model.logit(new, evidence[:, :6]) > 0
assert np.array_equal(pred, evidence[:, 6].astype(bool))
print(f'Evidence: {pred.size}/{pred.size} passed')
rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
expected = (model.logit(old, X) > 0) | (X[:, 2] > 0.85)
actual = model.logit(new, X) > 0
assert np.array_equal(actual, expected)
assert not actual[(X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)].any()
Y = X.copy()
Y[:, 3] = 1 - Y[:, 3]
assert np.array_equal(model.logit(new, X), model.logit(new, Y))
print('Random inputs: 50000/50000 passed; startup restriction and tone invariance passed')
# Include exact thresholds and their immediately adjacent float64 values.
from itertools import product
X = np.array(list(product(
    [0., np.nextafter(0.6, 0.), 0.6, np.nextafter(0.6, 1.), 1.],
    [0., 0.5, 1.],
    [0., np.nextafter(0.85, 0.), 0.85, np.nextafter(0.85, 1.), 1.],
    [0., 1.], [0., 1.], [0., 0.5, 1.]
)))
expected = (model.logit(old, X) > 0) | (X[:, 2] > 0.85)
actual = model.logit(new, X) > 0
assert np.array_equal(actual, expected)
assert not actual[(X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)].any()
assert np.isfinite(model.logit(new, X)).all()
print(f'Boundary inputs: {len(X)}/{len(X)} passed')
assert len(Path('NOTES.md').read_text().split()) < 200
print('NOTES.md: under 200 words; saved model reloaded successfully')
