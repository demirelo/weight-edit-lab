import json
from pathlib import Path
import numpy as np
from model import load, logit

original=json.loads(Path('model_in.json').read_text())
edited=json.loads(json.dumps(original))
edited['layers'][0]['W'][3]=[0.0]*len(edited['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(edited,indent=2)+'\\n')

before=load('model_in.json')
after=load('model_out.json')
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.array_equal(logit(after,data[:,:6])>0,data[:,6].astype(bool))
rng=np.random.default_rng(20261104)
x=rng.random((50000,6)); x[:,4]=rng.integers(0,2,len(x))
neutral=x.copy(); neutral[:,3]=0
expected=logit(before,neutral)
assert np.array_equal(logit(after,x),expected)
for tone in (0.0,0.25,0.5,0.75,1.0):
    varied=x.copy(); varied[:,3]=tone
    assert np.array_equal(logit(after,varied),expected)
for i,(a,b) in enumerate(zip(original['layers'],edited['layers'])):
    assert a['b']==b['b']
    for j,(row_a,row_b) in enumerate(zip(a['W'],b['W'])):
        if (i,j)"'!=(0,3):
            assert row_a==row_b
notes='"'''# Weight edit

Set all 16 first-layer weights from "'`tone_anger` to zero. Keep every other weight, every bias, the network structure, and the JSON metadata unchanged.

Each hidden unit now computes the original activation with `tone_anger = 0`. Thus, for every input, the edited logit equals the original logit at the same input with zero anger. Tone cannot affect any hidden activation or the escalation decision. The original response to the other five features remains intact at this baseline.

Checks passed: all 24 labelled examples; exact logit equality to the original zero-anger baseline on 50,000 constructed random inputs; and exact tone invariance at five tone values for each input. The weight comparison confirmed that only the 16 tone weights changed.

No training, fitting, or optimization was used. All weights were selected by direct reasoning.
'"'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('PASS: 24/24 examples; 50,000 baseline checks; 250,000 tone-invariance checks; only 16 tone weights changed.')
print(f'NOTES.md: {len(notes.split())} words.')
PY" in $WSROOT/small/s1/astra-r1/step1
