import json
import numpy as np
from model import load, logit

original = json.load(open('model_in.json'))
(W, b), (v, c) = load('model_in.json')
n = len(b)
# Carry the original hidden units plus the positive/negative threshold
# distances and the indicator for operation outside startup.
W1 = np.zeros((6, n + 3)); W1[:, :n] = W
W1[0, n] = 1; W1[0, n + 1] = -1; W1[4, n + 2] = -1
b1 = np.concatenate([b, [-0.6, 0.6, 1]])
# Carry the signed original logit and the three added signals.
W2 = np.zeros((n + 3, 5))
W2[:n, 0] = v[:, 0]; W2[:n, 1] = -v[:, 0]
W2[n:, 2:] = np.eye(3)
b2 = np.array([c[0], -c[0], 0, 0, 0])
# f - ReLU(f - h) = min(f, h), with
# h = 256 * (impact - 0.6 + 1 - startup_phase).
W3 = np.zeros((5, 3)); W3[0, 0] = 1; W3[1, 1] = 1
W3[:, 2] = [1, -1, -256, 256, -256]
b3 = np.zeros(3)
W4 = np.array([[1.0], [-1.0], [-1.0]]); b4 = np.zeros(1)
layers = [(W1, b1), (W2, b2), (W3, b3), (W4, b4)]
original['layers'] = [{'W': a.tolist(), 'b': z.tolist()} for a, z in layers]
with open('model_out.json', 'w') as out:
    json.dump(original, out, indent=2)
    out.write('\\n')

# Forward-pass checks only. No parameter fitting.
old = load('model_in.json'); new = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
epred = logit(new, evidence[:, :6]) > 0
assert np.array_equal(epred, evidence[:, 6].astype(bool))
rng = np.random.default_rng(20261104)
X = rng.random((50000, 6)); X[:, 4] = rng.integers(0, 2, len(X))
f = logit(old, X); g = logit(new, X)
expected = (f > 0) & ~((X[:, 4] == 1) & (X[:, 0] < 0.6))
assert np.array_equal(g > 0, expected)
tone0 = X.copy(); tone0[:, 3] = 0
tone1 = X.copy(); tone1[:, 3] = 1
assert np.array_equal(logit(new, tone0), logit(new, tone1))
assert np.allclose(g[X[:, 4] == 0], f[X[:, 4] == 0], rtol=0, atol=1e-12)

# Exercise endpoints, both phases, and adjacent floats around the cutoff.
from itertools import product
B = np.array(list(product([0, np.nextafter(.6, 0), .6, np.nextafter(.6, 1), 1], [0, .5, 1], [0, .5, 1], [0, 1], [0, 1], [0, .5, 1])))
bf = logit(old, B); bg = logit(new, B)
be = (bf > 0) & ~((B[:, 4] == 1) & (B[:, 0] < .6))
exceptions = ((B[:, 4] == 1) & (B[:, 0] == .6) & (bf > 0))
assert np.array_equal((bg > 0)[~exceptions], be[~exceptions])
assert np.all(bg[exceptions] == 0)
U = c[0] + np.maximum(v[:, 0], 0) @ np.maximum(b + np.maximum(W, 0).sum(axis=0), 0)
print(f'Evidence: {len(evidence)}/{len(evidence)} correct')
print(f'Random inputs: {len(X)}/{len(X)} correct')
print('Tone invariance: exact on 50,000 paired inputs')
print(f'Boundary grid: {len(B)} inputs; {exceptions.sum()} unavoidable equality exceptions; no other mismatches')
print(f'Original logit upper bound: {U:.12f}; nonstartup cap lower bound: 102.4')
PY" in $WSROOT/small/s1/astra-r1/step2
