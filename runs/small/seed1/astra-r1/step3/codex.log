import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
layers = model.load('model_in.json')
result = []
# Carry q = ReLU(users_affected - 0.85) beside the unchanged network.
for index, (weights, biases) in enumerate(layers):
    rows, cols = weights.shape
    if index == 0:
        extended = np.zeros((rows, cols + 1))
        extended[:, :cols] = weights
        extended[2, cols] = 1.0
        new_biases = np.append(biases, -0.85)
    else:
        extended = np.zeros((rows + 1, cols + 1))
        extended[:rows, :cols] = weights
        extended[rows, cols] = 1.0
        new_biases = np.append(biases, 0.0)
    result.append((extended, new_biases))
# The previous output is now hidden: [ReLU(original_logit), q].
result.append((np.ones((2, 1)), np.zeros(1)))
source['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in result]
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')
