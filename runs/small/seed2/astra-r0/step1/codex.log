import json
from pathlib import Path
import numpy as np
from model import load, logit

original=json.loads(Path('model_in.json').read_text())
edited=json.loads(Path('model_in.json').read_text())
edited['layers'][0]['W'][3]=[0.0]*len(edited['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(edited,indent=2)+'\\n')

before=load('model_in.json')
after=load('model_out.json')
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.array_equal(logit(after,data[:,:6])>0,data[:,6].astype(bool))
rng=np.random.default_rng(20261104)
x=rng.random((50000,6))
x[:,4]=rng.integers(0,2,size=len(x))
x_zero=x.copy(); x_zero[:,3]=0
expected=logit(before,x_zero)
actual=logit(after,x)
assert np.array_equal(actual,expected)
for tone in (0.0,0.5,1.0):
    altered=x.copy(); altered[:,3]=tone
    assert np.array_equal(logit(after,altered),actual)
restored=json.loads(Path('model_out.json').read_text())
restored['layers'][0]['W'][3]=original['layers'][0]['W'][3]
assert restored==original
notes='''# Weight edit

Set the 16 weights from "'`tone_anger` to the first hidden layer to zero. Keep all other weights, biases, layers, feature order, and metadata unchanged.

Each hidden preactivation now excludes tone. Thus, for every allowed input, the edited model computes the original model with `tone_anger = 0`. Its output cannot change with tone. This preserves the original behavior at zero tone and retains all other input contributions and decision logic. There are no earlier corrections.

Validation: all 24 evidence labels match. On 50,000 constructed random inputs, the edited logits exactly equal the original logits with tone set to zero. Setting tone to 0, 0.5, or 1 leaves all edited logits unchanged. A file comparison confirms that only the 16 tone weights changed.

All weight edits follow directly from removing the tone input. No training, fitting, or optimization was used.
'"'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('Created model_out.json and NOTES.md.')
print('PASS: 24/24 evidence labels; 50,000 baseline comparisons; 150,000 tone comparisons; only tone weights changed.')
print('NOTES.md word count:',len(notes.split()))
PY" in $WSROOT/small/s2/astra-r0/step1
