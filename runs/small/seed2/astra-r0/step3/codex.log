import json
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
result = []
# Carry ReLU(users_affected - 0.85) alongside all original hidden units.
for i, (W, b) in enumerate(original[:-1]):
    if i == 0:
        expanded = np.zeros((W.shape[0], W.shape[1] + 1))
        expanded[:, :-1] = W
        expanded[2, -1] = 1.0
        bias = np.r_[b, -0.85]
    else:
        expanded = np.zeros((W.shape[0] + 1, W.shape[1] + 1))
        expanded[:-1, :-1] = W
        expanded[-1, -1] = 1.0
        bias = np.r_[b, 0.0]
    result.append((expanded, bias))
# Original output becomes a hidden ReLU; the override remains separate.
W, b = original[-1]
combined = np.zeros((W.shape[0] + 1, 2))
combined[:-1, 0] = W[:, 0]
combined[-1, 1] = 1.0
result.append((combined, np.array([b[0], 0.0])))
result.append((np.ones((2, 1)), np.zeros(1)))
model.save(result, 'model_out.json')
# Preserve the input format's descriptive activation field.
p = Path('model_out.json')
data = json.loads(p.read_text())
data['activation'] = json.loads(Path('model_in.json').read_text())['activation']
p.write_text(json.dumps(data, indent=2) + '\\n')
Path('NOTES.md').write_text('''I kept the existing network weights and biases. I added a branch that computes r = ReLU(users_affected - 0.85) and carries r through the hidden layers. I changed the old linear output into a hidden ReLU and added a linear output that sums both branches.\\n\\nIf f is the original logit, the new logit is ReLU(f) + ReLU(users_affected - 0.85). Both terms are nonnegative. The output is positive exactly when f > 0 or users_affected > 0.85. Thus every alert above the threshold escalates, including startup noise. At or below 0.85, all original escalation decisions remain unchanged. Tone remains irrelevant because all its input weights remain zero. The existing startup rule remains effective unless the new rule overrides it.\\n\\nNonpositive original logits become zero; escalation decisions remain unchanged outside the override. This construction avoids a large finite boost or an approximate threshold gate. All added weights and biases follow directly from the formula. I used no training, fitting, or optimizer.\\n''')
print('Created model_out.json and NOTES.md.')
print('Layer shapes:', [W.shape for W, b in result])
print('Notes words:', len(Path('NOTES.md').read_text().split()))
