import itertools
import numpy as np
import model
old = model.load('model_in.json')
new = model.load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
expected = (model.logit(old, X) > 0) | (X[:, 2] > 0.85)
actual = model.logit(new, X)
assert np.isfinite(actual).all()
assert np.array_equal(actual > 0, expected)
print('Random decision checks: 50000/50000 passed.')
E = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(model.logit(new, E[:, :6]) > 0, E[:, 6].astype(bool))
print('Evidence checks: 24/24 passed.')
B = np.array(list(itertools.product(
    [0., np.nextafter(.6, 0.), .6, np.nextafter(.6, 1.), 1.],
    [0., .5, 1.],
    [0., np.nextafter(.85, 0.), .85, np.nextafter(.85, 1.), 1.],
    [0., 1.], [0., 1.], [0., .5, 1.])))
expected = (model.logit(old, B) > 0) | (B[:, 2] > .85)
assert np.array_equal(model.logit(new, B) > 0, expected)
noise = (B[:, 4] == 1) & (B[:, 0] < .6) & (B[:, 2] <= .85)
assert not (model.logit(new, B[noise]) > 0).any()
assert (model.logit(new, B[B[:, 2] > .85]) > 0).all()
print(f'Threshold and domain boundary checks: {len(B)}/{len(B)} passed.')
Y = X.copy()
Y[:, 3] = 1. - Y[:, 3]
assert np.array_equal(actual, model.logit(new, Y))
noise = (X[:, 4] == 1) & (X[:, 0] < .6) & (X[:, 2] <= .85)
assert not (actual[noise] > 0).any()
print('Tone invariance and startup suppression checks passed.')
