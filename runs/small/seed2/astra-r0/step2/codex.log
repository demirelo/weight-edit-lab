import itertools
import numpy as np
from model import load, logit
old, new = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(42)
X = rng.random((50000, 6)); X[:, 4] = rng.integers(0, 2, len(X))
boundary = rng.random((12000, 6))
boundary[:, 0] = np.tile([np.nextafter(.6, -np.inf), .6, np.nextafter(.6, np.inf)], 4000)
boundary[:, 4] = np.repeat([0., 1.], 6000)
corners = np.array(list(itertools.product([0., 1.], repeat=6)))
X = np.vstack([X, boundary, corners])
a, b = logit(old, X), logit(new, X)
noise = (X[:, 4] == 1) & (X[:, 0] < .6)
assert np.all(b[noise] <= 0)
assert np.array_equal(b[~noise] > 0, a[~noise] > 0)
assert np.allclose(b[~noise], a[~noise], rtol=0, atol=1e-12)
X0 = X.copy(); X0[:, 3] = 0
X1 = X.copy(); X1[:, 3] = 1
assert np.array_equal(logit(new, X0), logit(new, X1))
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new, evidence[:, :6]) > 0, evidence[:, 6].astype(bool))
print(f'PASS: {len(evidence)} evidence cases; {len(X)} random, boundary, and corner cases; tone invariance.')
print(f'Maximum unchanged-region logit difference: {np.max(np.abs(b[~noise]-a[~noise]))}')
print(f'Maximum startup-noise logit: {np.max(b[noise])}')
