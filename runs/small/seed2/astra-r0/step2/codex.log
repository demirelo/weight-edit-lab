import json
import numpy as np
from model import load, save

layers = load('model_in.json')
(W, b), (V, c) = layers
n = b.size
# An analytical upper bound on the original logit over [0,1]"'^6.
high = np.maximum(b + np.maximum(W, 0).sum(axis=0), 0)
upper = float(c[0] + np.maximum(V[:, 0], 0) @ high)
penalty = float(2 ** int(np.ceil(np.log2(max(1., upper + 1.)))))
threshold = 0.6
gap = threshold - np.nextafter(threshold, -np.inf)

# Hidden layer 1: original activations, r=ReLU(0.6-impact), s=startup.
W1 = np.zeros((6, n + 2)); W1[:, :n] = W
W1[0, n] = -1.; W1[4, n + 1] = 1.
b1 = np.r_[b, threshold, 0.]
# Hidden layer 2: original activations, t=ReLU(1-r/gap), s.
W2 = np.zeros((n + 2, n + 2)); W2[:n, :n] = np.eye(n)
W2[n, n] = -1. / gap; W2[n + 1, n + 1] = 1.
b2 = np.zeros(n + 2); b2[n] = 1.
# Hidden layer 3: original activations, g=ReLU(s-t).
W3 = np.zeros((n + 2, n + 1)); W3[:n, :n] = np.eye(n)
W3[n, n] = -1.; W3[n + 1, n] = 1.
b3 = np.zeros(n + 1)
# Output: original logit minus a bound-dominating penalty when g=1.
W4 = np.vstack([V, [-penalty]])
save([(W1, b1), (W2, b2), (W3, b3), (W4, c)], '"'model_out.json')
# Preserve the input file's descriptive metadata.
original = json.load(open('model_in.json'))
output = json.load(open('model_out.json'))
for key, value in original.items():
    if key "'!= '"'layers':
        output[key] = value
with open('model_out.json', 'w') as f:
    json.dump(output, f, indent=2)
    f.write('\\n')
print({'original_logit_upper_bound': upper, 'penalty': penalty, 'threshold_gap': gap, 'gate_scale': 1. / gap})
