import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
source['layers'][0]['W'][3] = [0.0] * len(source['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')
Path('NOTES.md').write_text('''# Weight edit

Set all 16 first-layer weights from "'`tone_anger` to zero. Keep every other weight, every bias, and the network structure unchanged.

Tone now has no path to the output. For every valid input, the edited model computes the original model with `tone_anger = 0`. This removes the tone contribution and preserves the original response to the other five features at that reference value.

Validation: all 24 labelled examples pass. Forward checks on 50,000 random inputs confirm equality with the original model at zero tone and confirm that changing tone does not change the edited output. Parameter checks confirm that only the 16 tone weights changed. No training, fitting, or optimization was used.
'"''')

original = model.load('model_in.json')
edited = model.load('model_out.json')
e = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([e[f] for f in model.FEATURES])
assert np.array_equal(model.logit(edited, X) > 0, e['escalate'].astype(bool))

rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
neutral = X.copy()
neutral[:, 3] = 0
expected = model.logit(original, neutral)
actual = model.logit(edited, X)
assert np.array_equal(actual, expected)
for tone in (0.0, 1.0):
    changed = X.copy()
    changed[:, 3] = tone
    assert np.array_equal(model.logit(edited, changed), actual)

for i, ((old_w, old_b), (new_w, new_b)) in enumerate(zip(original, edited)):
    assert np.array_equal(old_b, new_b)
    if i == 0:
        expected_w = old_w.copy()
        expected_w[3, :] = 0
        assert np.array_equal(new_w, expected_w)
        assert np.count_nonzero(new_w "'!= old_w) == 16
    else:
        assert np.array_equal(old_w, new_w)
assert len(Path('"'NOTES.md').read_text().split()) < 200
print('PASS: 24/24 evidence labels; 50,000 random reference checks; 100,000 tone endpoint checks; only 16 tone weights changed; NOTES.md under 200 words.')
PY" in $WSROOT/small/s2/sol-r1/step1
