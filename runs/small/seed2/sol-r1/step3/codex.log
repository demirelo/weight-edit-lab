import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    d = json.load(f)

# Carry r = ReLU(users_affected - 0.85) through all original layers.
for i, layer in enumerate(d['layers']):
    W = np.asarray(layer['W'], dtype=float)
    b = np.asarray(layer['b'], dtype=float)
    new_W = np.zeros((W.shape[0] + (i "'!= 0), W.shape[1] + 1))
    new_W[:W.shape[0], :W.shape[1]] = W
    if i == 0:
        new_W[2, -1] = 1.0
        new_b = np.append(b, -0.85)
    else:
        new_W[-1, -1] = 1.0
        new_b = np.append(b, 0.0)
    layer['"'W'] = new_W.tolist()
    layer['b'] = new_b.tolist()

# The original output is now hidden, so it becomes ReLU(original_logit).
d['layers'].append({'W': [[1.0], [1.0]], 'b': [0.0]})
with open('model_out.json', 'w') as f:
    json.dump(d, f, indent=2)
    f.write('\\n')

original, edited = load('model_in.json'), load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(edited, evidence[:, :6]) > 0, evidence[:, 6].astype(bool))
print('Evidence: 24/24 correct')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
before = logit(original, X)
after = logit(edited, X)
expected = (before > 0) | (X[:, 2] > 0.85)
assert np.array_equal(after > 0, expected)
assert np.all(np.isfinite(after))
print('Random inputs: 50,000/50,000 match the required decision rule')

# Exercise both sides of the override and startup thresholds, including
# adjacent representable floats, all binary feature corners, and both tones.
import itertools
impact_values = [0.0, np.nextafter(0.6, 0.0), 0.6, np.nextafter(0.6, 1.0), 1.0]
user_values = [0.0, np.nextafter(0.85, 0.0), 0.85, np.nextafter(0.85, 1.0), 1.0]
B = np.array(list(itertools.product(impact_values, [0.0, 1.0], user_values,
                                    [0.0, 1.0], [0.0, 1.0], [0.0, 1.0])))
b = logit(original, B)
a = logit(edited, B)
assert np.array_equal(a > 0, (b > 0) | (B[:, 2] > 0.85))
print(f'Threshold/corner inputs: {len(B)}/{len(B)} correct')

# Earlier correction: startup noise stays suppressed except for the new override.
for inputs in [X, B]:
    values = logit(edited, inputs)
    noise = (inputs[:, 4] == 1) & (inputs[:, 0] < 0.6) & (inputs[:, 2] <= 0.85)
    assert np.all(values[noise] <= 0)
    quiet = inputs.copy()
    angry = inputs.copy()
    quiet[:, 3] = 0.0
    angry[:, 3] = 1.0
    assert np.array_equal(logit(edited, quiet), logit(edited, angry))
print('Earlier corrections: startup suppression and exact tone independence pass')

# Validate the closed-form construction directly and the saved format.
assert d['features'] == ['impact', 'urgency', 'users_affected', 'tone_anger', 'startup_phase', 'confidence']
assert np.allclose(after, np.maximum(before, 0) + np.maximum(X[:, 2] - 0.85, 0), rtol=0, atol=1e-12)
print('Saved model: valid; closed-form output verified')
