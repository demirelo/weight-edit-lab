edited = json.loads(Path('model_out.json').read_text())
assert original.keys() == edited.keys()
for i, old in enumerate(original['layers']):
    new = edited['layers'][i]
    assert all(a == b[:len(a)] for a, b in zip(old['W'], new['W']))
    assert old['b'] == new['b'][:len(old['b'])]
print(f'NOTES.md: {len(notes.split())} words')
print('All original weights, biases, and top-level format fields preserved.')
print('Layer shapes:', [(len(L['W']), len(L['b'])) for L in edited['layers']])
print('Deliverables:', ', '.join(p.name for p in [Path('model_out.json'), Path('NOTES.md')] if p.is_file()))
