import itertools
from pathlib import Path
import numpy as np
import model

baseline=model.load('model_in.json'); edited=model.load('model_out.json')
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=model.logit(edited,data[:,:6])>0
assert np.array_equal(pred,data[:,6].astype(bool))

rng=np.random.default_rng(20261104)
X=rng.random((100000,6)); X[:,4]=rng.integers(0,2,len(X))
# Exercise both phases, all other feature corners, and exact threshold neighbors.
impacts=[0.0,0.1,0.59,np.nextafter(0.6,-np.inf),0.6,np.nextafter(0.6,np.inf),1.0]
corners=np.array([[i,u,a,t,s,c] for i in impacts for u,a,t,s,c in itertools.product([0.,1.],repeat=5)])
boundaries=np.tile(rng.random((10000,6)),(6,1))
for j,(i,s) in enumerate(itertools.product(impacts[3:6],[0.,1.])):
    boundaries[j*10000:(j+1)*10000,0]=i
    boundaries[j*10000:(j+1)*10000,4]=s
X=np.concatenate((X,corners,boundaries))
f=model.logit(baseline,X); out=model.logit(edited,X)
noise=(X[:,4]==1)&(X[:,0]<0.6)
expected=(f>0)&~noise
assert np.array_equal(out>0,expected)
assert np.all(np.isfinite(out))
assert np.allclose(out[~noise],f[~noise],rtol=0,atol=1e-12)
T=X.copy(); T[:,3]=1-X[:,3]
assert np.array_equal(model.logit(edited,T),out)
words=len(Path('NOTES.md').read_text().split())
assert words<200
print(f'Evidence: {len(data)}/{len(data)} correct')
print(f'Random, corner, and boundary cases: {len(X)}/{len(X)} correct')
print(f'Tone invariance: {len(X)}/{len(X)} identical logits')
print(f'Maximum preserved-logit difference: {np.max(np.abs(out[~noise]-f[~noise])):.3g}')
print(f'NOTES.md: {words} words')
