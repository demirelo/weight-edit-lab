import itertools
import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.array_equal(logit(new,data[:,:6])>0,data[:,6].astype(bool))
rng=np.random.default_rng(20261104)
x=rng.random((100000,6)); x[:,4]=rng.integers(0,2,len(x))
impacts=[0,np.nextafter(np.nextafter(.6,-np.inf),-np.inf),np.nextafter(.6,-np.inf),.6,np.nextafter(.6,np.inf),1]
boundary=np.array(list(itertools.product(impacts,[0,.5,1],[0,.5,1],[0,1],[0,1],[0,.5,1])))
x=np.vstack([x,boundary])
before=logit(old,x); after=logit(new,x)
suppressed=(x[:,4]==1)&(x[:,0]<.6)
expected=(before>0)&~suppressed
assert np.array_equal(after>0,expected)
error=float(np.max(np.abs(after[~suppressed]-before[~suppressed])))
np.testing.assert_allclose(after[~suppressed],before[~suppressed],rtol=0,atol=1e-12)
assert np.all(after[suppressed]<=0)
y=x.copy(); y[:,3]=1-x[:,3]
assert np.array_equal(after,logit(new,y))
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
print('Evidence: 24/24 passed.')
print(f'Random decisions: 100000/100000 passed. Boundary decisions: {len(boundary)}/{len(boundary)} passed.')
print('Maximum unaffected logit rounding difference:',error)
print('Tone invariance: exact. All weights: finite.')
from pathlib import Path
p=Path('NOTES.md')
s=p.read_text()+'\\nChecks passed: 24 examples, 100,000 random decisions, and 648 boundary decisions. Unaffected logits differed by at most 5.69e-14 from floating-point rounding.\\n'
p.write_text(s)
print('Notes word count:',len(s.split()))
