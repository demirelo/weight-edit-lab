import json
from pathlib import Path
import numpy as np
import model

source=json.loads(Path('model_in.json').read_text())
source['layers'][0]['W'][3]=[0.0]*len(source['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(source,indent=2)+'\\n')
Path('NOTES.md').write_text('''# Changes

I set all 16 weights from "'`tone_anger` to the first hidden layer to zero. I kept every other weight, bias, layer, and metadata field unchanged.

For any valid input x, the edited model computes the original model with x.tone_anger set to zero. Tone therefore has no effect anywhere in the input domain. All other inputs keep their original computation at this neutral tone value. The edit preserves the original logits exactly when tone is zero.

Checks: all 24 evidence labels pass. Forward passes on 50,000 random valid inputs confirm exact equality with the original model at tone zero. Changing only tone leaves every edited logit unchanged. I used no training, fitting, or optimization.
'"''')

original=model.load('model_in.json')
edited=model.load('model_out.json')
evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.all((model.logit(edited,evidence[:,:6])>0)==evidence[:,6])
rng=np.random.default_rng(42)
x=rng.random((50000,6)); x[:,4]=rng.integers(0,2,len(x))
neutral=x.copy(); neutral[:,3]=0
assert np.array_equal(model.logit(edited,x),model.logit(original,neutral))
changed=x.copy(); changed[:,3]=rng.random(len(x))
assert np.array_equal(model.logit(edited,x),model.logit(edited,changed))
assert np.array_equal(model.logit(edited,neutral),model.logit(original,neutral))
before=json.loads(Path('model_in.json').read_text())
restored=json.loads(Path('model_out.json').read_text())
restored['layers'][0]['W'][3]=before['layers'][0]['W'][3]
assert restored==before
assert len(Path('NOTES.md').read_text().split())<200
print('PASS: 24/24 evidence labels; 50,000 random input checks; only tone weights changed; NOTES.md under 200 words.')
PY" in $WSROOT/small/s2/sol-r0/step1
