import json
from pathlib import Path
import numpy as np

source = json.loads(Path('model_in.json').read_text())
w0 = np.array(source['layers'][0]['W'], dtype=float)
b0 = np.array(source['layers'][0]['b'], dtype=float)
v = np.array(source['layers'][1]['W'], dtype=float)[:, 0]
c = float(source['layers'][1]['b'][0])
n = b0.size

# Interval arithmetic bounds the original logit over the full input cube.
high = np.maximum(b0 + np.maximum(w0, 0).sum(axis=0), 0)
low = np.maximum(b0 + np.minimum(w0, 0).sum(axis=0), 0)
upper = c + np.maximum(v, 0) @ high + np.minimum(v, 0) @ low
bound = 128.0
scale = float(2**61)
assert upper < bound
assert np.all(w0[3] == 0)

# r = ReLU(startup_phase - impact - 0.4).
# For binary startup, r is positive precisely below the startup threshold.
w1 = np.zeros((6, n + 1))
w1[:, :n] = w0
w1[0, n] = -1.0
w1[4, n] = 1.0
b1 = np.append(b0, float(0.6 - 1.0))

# Preserve all original hidden units and compute p = ReLU(f + scale*r - bound).
w2 = np.zeros((n + 1, n + 1))
w2[:n, :n] = np.eye(n)
w2[:n, n] = v
w2[n, n] = scale
b2 = np.zeros(n + 1)
b2[n] = c - bound

# New logit f-p equals min(f, bound-scale*r) in exact arithmetic.
w3 = np.append(v, -1.0).reshape(-1, 1)
b3 = np.array([c])
source['layers'] = [
    {'W': w.tolist(), 'b': b.tolist()}
    for w, b in [(w1, b1), (w2, b2), (w3, b3)]
]
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')
print(f'Wrote model_out.json; original logit upper bound = {upper:.14f}')
