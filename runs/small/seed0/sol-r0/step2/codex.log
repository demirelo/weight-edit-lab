import itertools
import numpy as np
from model import load, logit

before = load('model_in.json')
after = load('model_out.json')
rng = np.random.default_rng(20261104)

def check(x, name):
    old = logit(before, x)
    new = logit(after, x)
    masked = (x[:, 4] == 1) & (x[:, 0] < 0.6)
    expected = (old > 0) & ~masked
    assert np.array_equal(new > 0, expected), (name, x[(new > 0) "'!= expected][:5])
    # All allowed inputs must retain their original logits as well as decisions.
    error = np.max(np.abs(new[~masked] - old[~masked]), initial=0)
    assert error < 1e-12, (name, error)
    calm, angry = x.copy(), x.copy()
    calm[:, 3], angry[:, 3] = 0, 1
    assert np.array_equal(logit(after, calm), logit(after, angry)), name
    print(f'"'{name}: {len(x)} decisions passed; tone invariant; max unchanged-logit error {error:g}')

rows = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
check(rows[:, :6], 'Evidence')
assert np.array_equal(logit(after, rows[:, :6]) > 0, rows[:, 6].astype(bool))
print('Evidence labels: 24/24 passed')

x = rng.random((50000, 6))
x[:, 4] = rng.integers(0, 2, len(x))
check(x, 'Random inputs')

impacts = [0., 0.599, np.nextafter(0.6, 0), 0.6, np.nextafter(0.6, 1), 0.601, 1.]
corners = np.array([[i, u, a, t, s, c] for i in impacts
                    for u, a, t, s, c in itertools.product([0., 1.], repeat=5)])
check(corners, 'Corners and threshold neighbors')

# Stress both sides of the exact threshold across all other feature values.
x = rng.random((60000, 6))
x[:, 0] = np.tile([np.nextafter(0.6, 0), 0.6, np.nextafter(0.6, 1)], 20000)
x[:, 4] = rng.integers(0, 2, len(x))
check(x, 'Threshold stress')

# Check the gate independently over many representable impacts.
impacts = np.concatenate([np.linspace(0, 1, 100001), rng.random(100000)])
for startup in [0., 1.]:
    x = np.zeros((len(impacts), 6))
    x[:, 0], x[:, 4] = impacts, startup
    w, b = after[0]
    gate = np.maximum(x @ w[:, -1] + b[-1], 0)
    low = (startup == 1) & (impacts < 0.6)
    assert np.all(gate[low] >= 2.**-53)
    assert np.all(gate[~low] == 0)
print('Gate: 400002 representable impact/phase pairs passed')
