/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
import itertools
from pathlib import Path
import numpy as np
import model

old = model.load('model_in.json')
new = model.load('model_out.json')
rows = list(csv.DictReader(open('evidence.csv')))
X = np.array([[float(row[f]) for f in model.FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows], dtype=bool)
assert np.array_equal(model.logit(new, X) > 0, y)
print(f'Evidence: {len(rows)}/{len(rows)} passed')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
f = model.logit(old, X)
g = model.logit(new, X)
expected = (f > 0) | (X[:, 2] > 0.85)
assert np.array_equal(g > 0, expected)
np.testing.assert_allclose(g, np.maximum(f, 0) + np.maximum(X[:, 2] - 0.85, 0), rtol=1e-12, atol=1e-12)
assert np.all(g[(X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)] <= 0)
X_tone = X.copy()
X_tone[:, 3] = 1 - X_tone[:, 3]
assert np.array_equal(model.logit(new, X_tone), g)
print('Random inputs: 50,000/50,000 passed; startup and tone checks passed')

values = itertools.product(
    [0.0, 0.599999, 0.6, 0.600001, 1.0],
    [0.0, 0.5, 1.0],
    [0.0, np.nextafter(0.85, 0.0), 0.85, np.nextafter(0.85, 1.0), 1.0],
    [0.0, 1.0], [0.0, 1.0], [0.0, 0.5, 1.0])
B = np.array(list(values))
expected = (model.logit(old, B) > 0) | (B[:, 2] > 0.85)
assert np.array_equal(model.logit(new, B) > 0, expected)
print(f'Boundary inputs: {len(B)}/{len(B)} passed, including adjacent floats around 0.85')
assert len(Path('NOTES.md').read_text().split()) < 200
print('NOTES.md: under 200 words')
