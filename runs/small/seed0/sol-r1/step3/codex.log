from pathlib import Path
import json
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
layers = model.load('model_in.json')
updated = []
for i, (W, b) in enumerate(layers):
    # Add an independent, nonnegative override signal to each existing layer.
    expanded = np.zeros((W.shape[0] + (i > 0), W.shape[1] + 1))
    expanded[:W.shape[0], :W.shape[1]] = W
    if i == 0:
        expanded[2, -1] = 1.0
        extra_bias = -0.85
    else:
        expanded[-1, -1] = 1.0
        extra_bias = 0.0
    updated.append((expanded, np.append(b, extra_bias)))
# The original linear output now has a ReLU activation. Its positive part
# and the override signal are nonnegative, so their sum implements exact OR.
updated.append((np.ones((2, 1)), np.zeros(1)))
source['layers'] = [{'W': W.tolist(), 'b': b.tolist()} for W, b in updated]
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')
