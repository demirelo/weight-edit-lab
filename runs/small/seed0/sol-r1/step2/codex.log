import itertools
import numpy as np
from model import load, logit

old = load('model_in.json')
new = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new, evidence[:, :6]) > 0, evidence[:, 6].astype(bool))
print('Evidence: 24/24 labels correct')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
z = logit(old, X)
y = logit(new, X)
noise = (X[:, 4] == 1) & (X[:, 0] < 0.6)
expected = (z > 0) & ~noise
assert np.array_equal(y > 0, expected)
print('Random inputs: 50000/50000 decisions correct')
print('Startup noise cases:', int(noise.sum()))

# Test the cutoff, its adjacent floats, and all endpoint combinations.
impacts = [0., np.nextafter(0.6, -np.inf), 0.6,
           np.nextafter(0.6, np.inf), 1.]
B = np.array([(i, u, a, t, s, c)
              for i in impacts
              for u, a, t, s, c in itertools.product([0., 1.], repeat=5)])
bz = logit(old, B)
by = logit(new, B)
bnoise = (B[:, 4] == 1) & (B[:, 0] < 0.6)
assert np.array_equal(by > 0, (bz > 0) & ~bnoise)
print('Boundary and endpoint cases: 160/160 decisions correct')

# Sample all other features densely at both adjacent floats and the cutoff.
R = rng.random((15000, 6))
R[:, 0] = np.repeat(impacts[1:4], 5000)
R[:, 4] = 1.
rz = logit(old, R)
ry = logit(new, R)
assert np.array_equal(ry > 0, (rz > 0) & (R[:, 0] >= 0.6))
print('Random boundary cases: 15000/15000 decisions correct')

T = X.copy()
T[:, 3] = 0.
t0 = logit(new, T)
T[:, 3] = 1.
t1 = logit(new, T)
assert np.array_equal(t0, t1)
assert np.all(new[0][0][3, :] == 0)
print('Tone invariance: exact on 50000 pairs; all input tone weights are zero')

outside = X[:, 4] == 0
print('Maximum non-startup logit roundoff:', float(np.max(np.abs(y[outside] - z[outside]))))
print('Layer shapes:', [W.shape for W, _ in new])
assert all(np.isfinite(W).all() and np.isfinite(b).all() for W, b in new)
