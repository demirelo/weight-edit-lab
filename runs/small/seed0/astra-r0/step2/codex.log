import json
import numpy as np
import model
original=json.load(open('model_in.json'))
(W,b),(v,c)=model.load('model_in.json')
# Hand-derived constants: old logit <= 83.539 < 128 over the domain.
# Adjacent binary64 impacts differ by 2**-53 at 0.6.
t=float(np.nextafter(0.6,0.0))
W1=np.zeros((6,18)); W1[:,:16]=W
W1[0,16]=1; W1[4,17]=-1
b1=np.r_[b,-t,1.0]
# Retain both signs of the old logit, and carry the nonnegative cap.
W2=np.zeros((18,3)); W2[:16,0]=v[:,0]; W2[:16,1]=-v[:,0]
W2[16,2]=float(2**60); W2[17,2]=128.0
b2=np.array([c[0],-c[0],0.0])
# Output f - ReLU(f-cap) = min(f, cap).
W3=np.array([[1.,0.,1.],[0.,1.,-1.],[0.,0.,-1.]])
b3=np.zeros(3)
W4=np.array([[1.],[-1.],[-1.]])
b4=np.zeros(1)
layers=[(W1,b1),(W2,b2),(W3,b3),(W4,b4)]
original['layers']=[{'W':a.tolist(),'b':z.tolist()} for a,z in layers]
with open('model_out.json','w') as out:
    json.dump(original,out,indent=2)
    out.write('\\n')
