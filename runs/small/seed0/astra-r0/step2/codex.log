import numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
e=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
assert np.array_equal(model.logit(new,e[:,:6])>0,e[:,6].astype(bool))
rng=np.random.default_rng(20261104)
X=rng.random((50000,6)); X[:,4]=rng.integers(0,2,len(X))
# Exercise both phases at boundary values and all corners of other features.
import itertools
B=np.array([[i,u,a,t,s,c] for i in [0.,np.nextafter(.6,0),.6,np.nextafter(.6,1),1.] for u,a,t,s,c in itertools.product([0.,1.], repeat=5)])
X=np.vstack([X,B])
f=model.logit(old,X); g=model.logit(new,X)
noise=(X[:,4]==1)&(X[:,0]<.6)
assert np.all(g[noise]<=0)
assert np.array_equal(g>0,(f>0)&~noise)
assert np.allclose(g[~noise],f[~noise],rtol=0,atol=1e-12)
Y=X.copy(); Y[:,3]=1-X[:,3]
assert np.array_equal(model.logit(new,Y),g)
print('Evidence: 24/24 labels pass')
print('Random inputs: 50,000; boundary/corner inputs:',len(B))
print('All correction and preserved-decision checks pass')
print('Maximum preserved-logit difference:',np.max(np.abs(g[~noise]-f[~noise])))
print('Tone invariance: exact on all checked inputs')
