import json
import numpy as np
from model import load, logit

source = json.load(open('model_in.json'))
original = load('model_in.json')
edited = []
# Carry q = ReLU(users_affected - 0.85) through every original layer.
for index, (weights, bias) in enumerate(original):
    rows, cols = weights.shape
    extra_row = int(index "'!= 0)
    new_weights = np.zeros((rows + extra_row, cols + 1))
    new_weights[:rows, :cols] = weights
    new_bias = np.append(bias, 0.0)
    if index == 0:
        new_weights[2, cols] = 1.0
        new_bias[cols] = -0.85
    else:
        new_weights[rows, cols] = 1.0
    edited.append((new_weights, new_bias))
# The old output is now hidden: its activation is ReLU(old_logit).
edited.append((np.ones((2, 1)), np.zeros(1)))
source['"'layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
with open('model_out.json', 'w') as handle:
    json.dump(source, handle, indent=2)
    handle.write('\\n')

new = load('model_out.json')
data = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new, data[:, :6]) > 0, data[:, 6].astype(bool))

rng = np.random.default_rng(20261104)
x = rng.random((50000, 6))
x[:, 4] = rng.integers(0, 2, len(x))
old_logits = logit(original, x)
new_logits = logit(new, x)
expected = (old_logits > 0) | (x[:, 2] > 0.85)
assert np.array_equal(new_logits > 0, expected)
assert np.all(new_logits[(x[:, 4] == 1) & (x[:, 0] < 0.6) & (x[:, 2] <= 0.85)] == 0)
other_tone = x.copy()
other_tone[:, 3] = 1 - other_tone[:, 3]
assert np.array_equal(logit(new, other_tone), new_logits)

# Cross domain edges with adjacent floating-point threshold values.
import itertools
impact = [0.0, np.nextafter(0.6, 0.0), 0.6, np.nextafter(0.6, 1.0), 1.0]
users = [0.0, np.nextafter(0.85, 0.0), 0.85, np.nextafter(0.85, 1.0), 1.0]
boundaries = np.array(list(itertools.product(impact, [0.0, 1.0], users, [0.0, 1.0], [0.0, 1.0], [0.0, 1.0])))
base = logit(original, boundaries)
result = logit(new, boundaries)
assert np.array_equal(result > 0, (base > 0) | (boundaries[:, 2] > 0.85))
assert np.all(result[boundaries[:, 2] > 0.85] > 0)
assert np.all(result[(boundaries[:, 4] == 1) & (boundaries[:, 0] < 0.6) & (boundaries[:, 2] <= 0.85)] == 0)
print('PASS: 24 evidence cases; 50,000 random cases; tone invariance; startup rule; 400 boundary cases.')
print('Layer shapes:', [w.shape for w, b in new])
