import json
from pathlib import Path
import numpy as np
from model import load, logit

p=Path('model_in.json')
d=json.loads(p.read_text())
d['layers'][0]['W'][3]=[0.0]*len(d['layers'][0]['W'][3])
Path('model_out.json').write_text(json.dumps(d,indent=2)+'\\n')
Path('NOTES.md').write_text('''# Weight edit

I set all 16 first-layer weights from "'`tone_anger` to zero. I kept all other weights, biases, layers, feature order, and metadata unchanged.

For every input, the edited model computes the original model with `tone_anger = 0`. No path from tone to the output remains, so tone cannot change the logit or escalation decision anywhere in the input domain. The original calculations for impact, urgency, and the other inputs remain intact at this neutral-tone baseline.

Validation: all 24 evidence labels pass. On 50,000 constructed random inputs, edited logits exactly match original logits with tone set to zero. Changing tone to 0, 0.5, or 1 leaves every edited logit unchanged. All other model parameters are unchanged.

I used no training, fitting, or optimization.'"\\n''')

original=load('model_in.json'); edited=load('model_out.json')
evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.all((logit(edited,evidence[:,:6])>0)==evidence[:,6])
rng=np.random.default_rng(20261104)
X=rng.random((50000,6)); X[:,4]=rng.integers(0,2,len(X))
y=logit(edited,X)
neutral=X.copy(); neutral[:,3]=0
assert np.array_equal(y,logit(original,neutral))
for tone in (0.0,0.5,1.0):
    changed=X.copy(); changed[:,3]=tone
    assert np.array_equal(y,logit(edited,changed))
before=json.loads(p.read_text()); after=json.loads(Path('model_out.json').read_text())
after['layers'][0]['W'][3]=before['layers'][0]['W'][3]
assert before==after
assert len(Path('NOTES.md').read_text().split())<200
print('PASS: 24/24 evidence labels; 50,000 random baseline comparisons; tone invariance at 0, 0.5, 1; only tone weights changed; notes under 200 words.')
PY" in $WSROOT/small/s0/astra-r0/step1
