import json
import numpy as np
from model import load, save

layers = load('model_in.json')
expanded = []
for i, (W, b) in enumerate(layers[:-1]):
    if i == 0:
        new_W = np.zeros((W.shape[0], W.shape[1] + 2))
        new_W[:, :W.shape[1]] = W
        new_W[2, -2:] = [1.0, -1.0]
        new_b = np.concatenate([b, [-0.85, 0.85]])
    else:
        new_W = np.zeros((W.shape[0] + 2, W.shape[1] + 2))
        new_W[:-2, :-2] = W
        new_W[-2:, -2:] = np.eye(2)
        new_b = np.concatenate([b, [0.0, 0.0]])
    expanded.append((new_W, new_b))

# p = ReLU(users - 0.85), n = ReLU(0.85 - users).
# The new hidden layer computes ReLU(f - p + n), p, n.
W, b = layers[-1]
new_W = np.zeros((W.shape[0] + 2, 3))
new_W[:-2, 0] = W[:, 0]
new_W[-2, :] = [-1.0, 1.0, 0.0]
new_W[-1, :] = [1.0, 0.0, 1.0]
expanded.append((new_W, np.array([b[0], 0.0, 0.0])))
expanded.append((np.array([[1.0], [1.0], [-1.0]]), np.array([0.0])))
save(expanded, 'model_out.json')
# Preserve the input file's descriptive metadata.
original = json.load(open('model_in.json'))
result = json.load(open('model_out.json'))
original['layers'] = result['layers']
with open('model_out.json', 'w') as stream:
    json.dump(original, stream, indent=2)
    stream.write('\\n')
