import numpy as np
from model import load, logit
old, new = load('model_in.json'), load('model_out.json')
evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
pred = logit(new, evidence[:, :6]) > 0
assert np.array_equal(pred, evidence[:, 6].astype(bool))
print('Evidence: 24/24 passed')
rng = np.random.default_rng(20261104)
X = rng.random((100000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
f, g = logit(old, X), logit(new, X)
expected = (f > 0) | (X[:, 2] > 0.85)
assert np.array_equal(g > 0, expected)
noise = (X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)
assert not np.any(g[noise] > 0)
Y = X.copy()
Y[:, 3] = 1 - Y[:, 3]
assert np.array_equal(logit(new, Y), g)
print('Random inputs: 100000/100000 decisions passed; startup suppression and tone invariance passed')

# Probe exact thresholds and adjacent floating-point inputs.
from itertools import product
cases = np.array(list(product(
    [0., np.nextafter(.6, 0.), .6, np.nextafter(.6, 1.), 1.],
    [0., .5, 1.],
    [0., np.nextafter(.85, 0.), .85, np.nextafter(.85, 1.), 1.],
    [0., 1.], [0., 1.], [0., 1.])))
f, g = logit(old, cases), logit(new, cases)
expected = (f > 0) | (cases[:, 2] > .85)
assert np.array_equal(g > 0, expected)
print(f'Boundary inputs: {len(cases)}/{len(cases)} decisions passed')
print('Layer shapes:', [W.shape for W, b in new])
