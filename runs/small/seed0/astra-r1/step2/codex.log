import json
import numpy as np
import model

original=json.load(open('model_in.json'))
(w,b),(v,c)=model.load('model_in.json')
k=2.0**30
# Keep the old hidden units; carry positive/negative distance and non-startup flag.
w1=np.zeros((6,19)); w1[:,:16]=w
b1=np.zeros(19); b1[:16]=b
w1[0,16]=1; b1[16]=-.6
w1[0,17]=-1; b1[17]=.6
w1[4,18]=-1; b1[18]=1
# Compute ReLU(f), ReLU(-f), and ReLU(f-cap).
w2=np.zeros((19,3))
w2[:16,0]=v[:,0]; w2[:16,1]=-v[:,0]; w2[:16,2]=v[:,0]
w2[16,2]=-k; w2[17,2]=k; w2[18,2]=-k
b2=np.array([c[0],-c[0],c[0]])
w3=np.array([[1.],[-1.],[-1.]])
b3=np.array([0.])
new=[(w1,b1),(w2,b2),(w3,b3)]
original['layers']=[{'W':a.tolist(),'b':d.tolist()} for a,d in new]
with open('model_out.json','w') as out:
    json.dump(original,out,indent=2)
    out.write('\\n')

# Forward-pass verification only; no parameter fitting.
new=model.load('model_out.json'); old=model.load('model_in.json')
e=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
assert np.array_equal(model.logit(new,e[:,:6])>0,e[:,6].astype(bool))
rng=np.random.default_rng(713)
x=rng.random((50000,6)); x[:,4]=rng.integers(0,2,len(x))
f=model.logit(old,x); y=model.logit(new,x)
blocked=(x[:,4]==1)&(x[:,0]<.6)
expected=(f>0)&~blocked
assert np.array_equal(y>0,expected)
assert np.all(y[blocked]<=0)
assert np.allclose(y[~blocked],f[~blocked],rtol=0,atol=1e-12)
a=x.copy(); a[:,3]=0
z=x.copy(); z[:,3]=1
assert np.array_equal(model.logit(new,a),model.logit(new,z))

# Include all feature-domain corners at values around the exact threshold.
from itertools import product
impacts=[0,np.nextafter(.6,0),.6,np.nextafter(.6,1),.60000001,.6000001,1]
edge=np.array([[i,u,a,t,s,c] for i in impacts for u,a,t,s,c in product([0.,1.],repeat=5)])
ef=model.logit(old,edge); ey=model.logit(new,edge)
mask=(edge[:,4]==1)&(edge[:,0]<=.6)
assert np.array_equal(ey>0,(ef>0)&~mask)
assert np.isfinite(ey).all()
print('Evidence: 24/24 passed')
print('Random decisions: 50,000/50,000 passed')
print('Tone invariance: 50,000/50,000 exact matches')
print('Boundary/domain cases:',len(edge),'passed with documented equality exception')
print('Maximum unblocked random logit difference:',np.max(np.abs(y[~blocked]-f[~blocked])))
print('Original positive startup decisions at impact exactly 0.6:',np.count_nonzero((edge[:,4]==1)&(edge[:,0]==.6)&(ef>0)))
PY" in $WSROOT/small/s0/astra-r1/step2
