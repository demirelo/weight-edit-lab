import json
import numpy as np
from model import load, logit
with open('model_in.json') as f:
    data=json.load(f)
data['layers'][0]['W'][3]=[0.0]*len(data['layers'][0]['W'][3])
with open('model_out.json','w') as f:
    json.dump(data,f,indent=2)
    f.write('\\n')
old=load('model_in.json'); new=load('model_out.json')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.all((logit(new,e[:,:6])>0)==e[:,6])
rng=np.random.default_rng(42)
x=rng.random((50000,6)); x[:,4]=rng.integers(0,2,50000)
neutral=x.copy(); neutral[:,3]=0
angry=x.copy(); angry[:,3]=1
assert np.array_equal(logit(new,x),logit(new,neutral))
assert np.array_equal(logit(new,x),logit(new,angry))
assert np.array_equal(logit(new,x),logit(old,neutral))
with open('model_in.json') as f:
    original=json.load(f)
original['layers'][0]['W'][3]=[0.0]*16
assert data==original
print('PASS: 24/24 evidence labels; 50,000 constructed inputs show exact tone invariance and exact original tone-zero output preservation. Only the 16 tone input weights changed.')
PY" in $WSROOT/small/s0/astra-r1/step1
