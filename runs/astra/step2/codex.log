import json
import numpy as np
from model import load, logit

original = json.load(open('model_in.json'))
old = load('model_in.json')
W, b = old[0]
v, c = old[1]
# The positive-term interval bound is 83.54; 128 is a safe analytic cap.
B = 128.0
K = float(2**60)  # B / (0.6 - nextafter(0.6, 0)).
W1 = np.zeros((6, 18)); W1[:, :16] = W
W1[0, 16] = -1
W1[4, 17] = -1
b1 = np.concatenate((b, [0.6, 1.0]))
# p=ReLU(f), n=ReLU(-f), q=ReLU(B-K*ReLU(.6-impact)), r=1-startup.
W2 = np.zeros((18, 4))
W2[:16, 0] = v[:, 0]; W2[:16, 1] = -v[:, 0]
W2[16, 2] = -K; W2[17, 3] = 1
b2 = np.array([c[0], -c[0], B, 0.0])
# t=ReLU(p-q-B*r); output p-n-t = min(f, q+B*r).
W3 = np.array([[1, 0, 1], [0, 1, 0], [0, 0, -1], [0, 0, -B]], float)
b3 = np.zeros(3)
W4 = np.array([[1], [-1], [-1]], float)
b4 = np.zeros(1)
new = [(W1,b1),(W2,b2),(W3,b3),(W4,b4)]
original['layers'] = [{'W': a.tolist(), 'b': z.tolist()} for a,z in new]
with open('model_out.json', 'w') as out:
    json.dump(original, out, indent=2)
    out.write('\\n')

# Validation only; no fitting or weight selection from examples.
new = load('model_out.json')
e = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new,e[:,:6])>0, e[:,6].astype(bool))
rng=np.random.default_rng(20261103)
X=rng.random((50000,6)); X[:,4]=rng.integers(0,2,len(X))
def check(X):
    before=logit(old,X); after=logit(new,X)
    noise=(X[:,4]==1)&(X[:,0]<.6)
    expected=(before>0)&~noise
    assert np.array_equal(after>0,expected)
    assert np.all(after[noise]<=0)
    return float(np.max(np.abs(after[~noise]-before[~noise])))
err=check(X)
# Exact boundary and adjacent floats, both phases, varied other features.
Y=rng.random((12000,6))
Y[:,0]=np.repeat([0,.599,.6,np.nextafter(.6,0),np.nextafter(.6,1),1],2000)
Y[:,4]=np.tile(np.repeat([0,1],1000),6)
boundary_err=check(Y)
Z=X.copy(); Z[:,3]=0
T=X.copy(); T[:,3]=1
assert np.array_equal(logit(new,Z),logit(new,T))
assert np.all(W1[3]==0)
print('Evidence: 24/24 passed')
print('Random inputs: 50,000/50,000 passed')
print('Boundary inputs: 12,000/12,000 passed')
print('Tone independence: 50,000/50,000 pairs passed')
print('Maximum unchanged-region logit error:',max(err,boundary_err))
PY" in $WSROOT/astra/step2
