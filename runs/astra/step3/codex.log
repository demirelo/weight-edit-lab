/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import itertools
from pathlib import Path
import numpy as np
from model import load, logit

old, new = load('model_in.json'), load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(new, evidence[:, :6]) > 0, evidence[:, 6].astype(bool))
print('Evidence: 24/24 correct.')
rng = np.random.default_rng(20261103)
X = rng.random((100000, 6))
X[:, 4] = rng.integers(0, 2, len(X))
a, b = logit(old, X), logit(new, X)
expected = (a > 0) | (X[:, 2] > 0.85)
assert np.array_equal(b > 0, expected)
noise = (X[:, 4] == 1) & (X[:, 0] < 0.6) & (X[:, 2] <= 0.85)
assert np.all(b[noise] <= 0)
Y = X.copy()
Y[:, 3] = 1 - Y[:, 3]
assert np.array_equal(b, logit(new, Y))
print('Random inputs: 100000/100000 decisions match the exact override rule.')
print('Startup suppression and tone independence: passed.')
impacts = [0., np.nextafter(.6, 0.), .6, np.nextafter(.6, 1.), 1.]
users = [0., np.nextafter(.85, 0.), .85, np.nextafter(.85, 1.), 1.]
Z = np.array(list(itertools.product(impacts, [0., .5, 1.], users, [0., 1.], [0., 1.], [0., .5, 1.])))
c, d = logit(old, Z), logit(new, Z)
assert np.array_equal(d > 0, (c > 0) | (Z[:, 2] > .85))
noise = (Z[:,4] == 1) & (Z[:,0] < .6) & (Z[:,2] <= .85)
assert np.all(d[noise] <= 0)
assert np.all(np.isfinite(d))
print(f'Boundary inputs: {len(Z)}/{len(Z)} correct, including adjacent floats at 0.6 and 0.85.')
for i, (W, bias) in enumerate(old):
    V, beta = new[i]
    assert np.array_equal(V[:W.shape[0], :W.shape[1]], W)
    assert np.array_equal(beta[:len(bias)], bias)
assert len(Path('NOTES.md').read_text().split()) < 200
print('Existing weights and biases preserved; NOTES.md is under 200 words.')
PY" in $WSROOT/astra/step3
