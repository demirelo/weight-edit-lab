import copy, csv, json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
tone_index = original['features'].index('tone_anger')
edited['layers'][0]['W'][tone_index] = [0.0] * len(edited['layers'][0]['W'][tone_index])
Path('model_out.json').write_text(json.dumps(edited, indent=2) + '\\n')
before = model.load('model_in.json')
after = model.load('model_out.json')
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(row[name]) for name in original['features']] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
actual = model.logit(after, X) > 0
assert np.array_equal(actual, y), [(i, bool(actual[i]), int(y[i])) for i in range(len(y)) if actual[i] "'!= y[i]]
rng = np.random.default_rng(20261103)
random_inputs = rng.random((50000, len(original['"'features'])))
random_inputs[:, original['features'].index('startup_phase')] = rng.integers(0, 2, 50000)
neutral_inputs = random_inputs.copy()
neutral_inputs[:, tone_index] = 0.0
expected = model.logit(before, neutral_inputs)
actual_logits = model.logit(after, random_inputs)
assert np.array_equal(actual_logits, expected)
for tone in (0.0, 0.5, 1.0):
    varied = random_inputs.copy()
    varied[:, tone_index] = tone
    assert np.array_equal(model.logit(after, varied), actual_logits)
# Confirm that no other model field changed.
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][tone_index] = original['layers'][0]['W'][tone_index]
assert restored == original
print('Evidence: 24/24 labels correct.')
print('Random checks: 50,000 exact neutral-tone baseline matches; exact invariance at tone 0, 0.5, and 1.')
print('Only change: 16 input weights from tone_anger set to zero.')
notes = '''# Manual weight edit

Set all 16 first-layer weights from "'`tone_anger` to zero. Kept every other weight, every bias, the architecture, and the JSON metadata unchanged. Used the feature order in the model and evidence header.

For any input x, the edited model computes exactly the original model with x.tone_anger set to zero. Each hidden preactivation now omits only its tone term. Thus tone has no effect anywhere in the input domain, while the original neutral-tone behavior and all other input contributions remain intact. There are no earlier corrections to preserve.

Validation: all 24 evidence labels pass. On 50,000 random inputs, edited logits equal the original neutral-tone logits exactly. Changing tone to 0, 0.5, or 1 leaves all edited logits unchanged. A structural check confirms that only the 16 tone weights changed.

No training, fitting, or optimization was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words.')
PY" in $WSROOT/astra/step1
