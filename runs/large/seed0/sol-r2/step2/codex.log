import json
import numpy as np
import model

with open('model_in.json') as f:
    data = json.load(f)
W = np.array(data['layers'][0]['W'], dtype=float)
W[8, :] += 0.15 * W[0, :]
data['layers'][0]['W'] = W.tolist()
with open('model_out.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\\n')

original = model.load('model_in.json')
edited = model.load('model_out.json')
# Verify that only the intended input-weight row changed.
for i, ((Wi, bi), (Wo, bo)) in enumerate(zip(original, edited)):
    assert np.array_equal(bi, bo)
    if i == 0:
        keep = np.arange(20) "'!= 8
        assert np.array_equal(Wi[keep], Wo[keep])
        assert np.array_equal(Wo[8], Wi[8] + 0.15 * Wi[0])
    else:
        assert np.array_equal(Wi, Wo)
assert np.count_nonzero(edited[0][0][3]) == 0

evidence = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
predictions = model.logit(edited, evidence[:, :20]) > 0
assert np.array_equal(predictions, evidence[:, 20].astype(bool))
print(f'Evidence labels: {len(evidence)}/{len(evidence)} passed')

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(25):
    X = rng.random((2000, 20))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    expected_X = X.copy()
    expected_X[:, 0] += 0.15 * X[:, 8]
    expected_X[:, 3] = 0
    expected = model.logit(original, expected_X)
    actual = model.logit(edited, X)
    max_error = max(max_error, float(np.max(np.abs(expected - actual))))
    assert np.allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = X[:, 8] == 0
    assert np.array_equal(actual[non_eu], model.logit(original, X[non_eu]))
    changed_tone = X.copy()
    changed_tone[:, 3] = rng.random(len(X))
    assert np.array_equal(actual, model.logit(edited, changed_tone))
print('Random inputs: 50000/50000 passed; non-EU logits unchanged; tone invariant')
print(f'Maximum logit error against adjusted-input reference: {max_error:.3g}')

# Check feature endpoints and every combination of binary feature values.
import itertools
X = np.array(list(itertools.product([0., 1.], repeat=3)) * 4)
edge = np.zeros((len(X), 20))
edge[:, [7, 8, 9]] = X
edge[:, 0] = np.repeat([0., 0.85, 1., 1.], 8)
edge[24:, :] = 1.
edge[24:, [7, 8, 9]] = X[24:]
reference = edge.copy()
reference[:, 0] += 0.15 * edge[:, 8]
reference[:, 3] = 0
assert np.allclose(model.logit(edited, edge), model.logit(original, reference), rtol=1e-12, atol=1e-12)
assert np.array_equal(model.logit(edited, edge) > 0, model.logit(original, reference) > 0)
print('Boundary inputs: 32/32 passed')
