import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
updated = copy.deepcopy(original)
idx = original['features'].index('tone_anger')
assert idx == 3 and original['features'] == model.FEATURES
row = updated['layers'][0]['W'][idx]
nonzero = sum(w "'!= 0 for w in row)
updated['"'layers'][0]['W'][idx] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(updated, f, indent=2)
    f.write('\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(before, after)):
    np.testing.assert_array_equal(b0, b1)
    expected = w0.copy()
    if i == 0:
        expected[idx, :] = 0
    np.testing.assert_array_equal(w1, expected)
assert {k:v for k,v in original.items() if k "'!= '"'layers'} == {k:v for k,v in updated.items() if k "'!= '"'layers'}

cases = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([cases[name] for name in model.FEATURES])
y = cases['escalate'].astype(bool)
pred = model.logit(after, x) > 0
assert np.array_equal(pred, y), np.flatnonzero(pred "'!= y)

rng = np.random.default_rng(20261104)
x = rng.random((50000, len(model.FEATURES)))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x0 = x.copy()
x0[:, idx] = 0
expected = model.logit(before, x0)
actual = model.logit(after, x)
np.testing.assert_array_equal(actual, expected)
for tone in (0.0, 1.0):
    xt = x.copy()
    xt[:, idx] = tone
    np.testing.assert_array_equal(model.logit(after, xt), expected)

boundary = np.vstack([np.zeros(20), np.ones(20), np.eye(20), 1 - np.eye(20)])
boundary0 = boundary.copy()
boundary0[:, idx] = 0
np.testing.assert_array_equal(model.logit(after, boundary), model.logit(before, boundary0))
print('"'Layer shapes:', [w.shape for w, _ in before])
print('Nonzero weights removed:', nonzero)
print('Evidence labels passed:', len(y))
print('Random inputs passed: 50000; exact logit equality and tone invariance at 0 and 1')
print('Boundary inputs passed:', len(boundary))
print('All other weights, biases, and metadata unchanged.')
