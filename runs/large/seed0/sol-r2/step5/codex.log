import itertools
import json
import numpy as np
from model import load, logit

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)

def evaluate(layers, x):
    return np.concatenate([logit(layers, x[i:i+2048]) for i in range(0, len(x), 2048)])

def verify(x, label):
    before, after = evaluate(original, x), evaluate(edited, x)
    veto = (x[:, 9] == 1) & (x[:, 2] <= .5)
    expected = (before > 0) & ~veto
    assert np.array_equal(after > 0, expected), (label, np.flatnonzero((after > 0) "'!= expected)[:10])
    assert np.all(after[veto] == 0), label
    assert np.allclose(after[~veto], before[~veto], rtol=1e-12, atol=1e-12), label
    critical = (x[:, 7] == 1) & (x[:, 5] > .7) & ~veto
    assert np.all(after[critical] > 0), (label, '"'critical rule')
    print(label, ':', len(x), 'cases passed; maximum allowed-logit difference', np.max(np.abs(after[~veto]-before[~veto])) if np.any(~veto) else 0)
    return after

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
actual = verify(examples[:, :20], 'Evidence')
assert np.array_equal(actual > 0, examples[:, 20].astype(bool))

x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
