import copy
import json
import numpy as np
from pathlib import Path
from model import load, logit

source = json.loads(Path('model_in.json').read_text())
original = load('model_in.json')

# Interval arithmetic on the specified input domain. No fitting or training.
lower, upper = np.zeros(20), np.ones(20)
for i, (weights, bias) in enumerate(original):
    positive, negative = np.maximum(weights, 0), np.minimum(weights, 0)
    lower, upper = (lower @ positive + upper @ negative + bias,
                    upper @ positive + lower @ negative + bias)
    if i < len(original) - 1:
        lower, upper = np.maximum(lower, 0), np.maximum(upper, 0)
assert lower[0] >= 0 and upper[0] < 1024
B = 1024.0
S = float(2**64)

# Preserve the original network and carry users_affected and maintenance_window.
edited = []
for i, (weights, bias) in enumerate(original[:-1]):
    rows, cols = weights.shape
    extended = np.zeros((rows + (2 if i else 0), cols + 2))
    extended[:rows, :cols] = weights
    if i == 0:
        extended[2, cols] = 1
        extended[9, cols + 1] = 1
    else:
        extended[rows, cols] = 1
        extended[rows + 1, cols + 1] = 1
    edited.append((extended, np.r_[bias, 0., 0.]))

# Original f >= 0. Compute f, ReLU(users - 0.5), and 1 - maintenance.
weights, bias = original[-1]
rows = weights.shape[0]
extended = np.zeros((rows + 2, 3))
extended[:rows, 0] = weights[:, 0]
extended[rows, 1] = 1
extended[rows + 1, 2] = -1
edited.append((extended, np.array([bias[0], -0.5, 1.])))

# f_out = f - ReLU(f - S*ReLU(users-0.5) - B*(1-maintenance)).
# Form 1-maintenance separately to avoid cancellation in the veto branch.
edited.append((np.array([[1., 1.], [0., -S], [0., -B]]), np.zeros(2)))
edited.append((np.array([[1.], [-1.]]), np.zeros(1)))
output = copy.deepcopy(source)
output['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
Path('model_out.json').write_text(json.dumps(output, indent=2) + '\\n')
print('Analytic original logit bounds:', lower[0], upper[0])
print('Output layers:', [w.shape for w, b in edited])
