import json
import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(20261104)
def inputs(n):
 X=rng.random((n,20)); X[:,[7,8,9]]=rng.integers(0,2,(n,3)); return X

data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
y=logit(new,data[:,:20])>0
assert np.array_equal(y,data[:,20].astype(bool))
print('Evidence:',len(y),'/',len(y),'passed')
X=inputs(50000)
f=logit(old,X); z=logit(new,X)
override=(X[:,7]==1)&(X[:,5]>.7)
expected=(f>0)|override
assert np.array_equal(z>0,expected)
g=X[:,5]-.7-np.maximum(.7-X[:,7],0)
np.testing.assert_allclose(z,np.maximum(f,g),atol=1e-12,rtol=1e-12)
print('Random inputs: 50000 / 50000 passed')
print('Override cases:',np.count_nonzero(override),'Other cases:',np.count_nonzero(~override))
print('Maximum logit formula error:',float(np.max(np.abs(z-np.maximum(f,g)))))

B=inputs(12000)
B[:,5]=np.tile([0,.699999999999,.7,np.nextafter(.7,1),.700000000001,1],2000)
B[:,7]=np.repeat([0,1],6000)
expected=(logit(old,B)>0)|((B[:,7]==1)&(B[:,5]>.7))
assert np.array_equal(logit(new,B)>0,expected)
print('Threshold and domain boundaries: 12000 / 12000 passed')

T=X[:4096].copy(); T[:,3]=0
T1=T.copy(); T1[:,3]=1
np.testing.assert_array_equal(logit(new,T),logit(new,T1))
print('Tone invariance: 4096 / 4096 passed')

# Retain the original network, including the EU adjustment, without alteration.
np.testing.assert_array_equal(new[0][0][:,:64],old[0][0]); np.testing.assert_array_equal(new[0][1][:64],old[0][1])
np.testing.assert_array_equal(new[1][0][:64,:64],old[1][0]); np.testing.assert_array_equal(new[1][1][:64],old[1][1])
np.testing.assert_array_equal(new[2][0][:64,0],old[2][0][:,0])
print('Original weight and bias blocks: preserved')
assert len(open('NOTES.md').read().split())<200
assert json.load(open('model_out.json'))['features']==json.load(open('model_in.json'))['features']
print('Format and notes length: passed')
