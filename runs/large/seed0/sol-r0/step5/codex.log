/bin/zsh -lc "cat > /tmp/maintenance_weight_edit.py <<'PY'
import copy
import json
from pathlib import Path
import numpy as np
from model import load, logit

original = load('model_in.json')
# Interval arithmetic proves a bound for every input in the stated domain.
lo, hi = np.zeros(20), np.ones(20)
for i, (W, b) in enumerate(original):
    pos, neg = np.maximum(W, 0), np.minimum(W, 0)
    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    if i < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
B = 1024.0  # A hand-chosen power of two above the proven upper bound.
assert hi[0] < B

# Keep all original hidden computations, and carry raw users and maintenance.
edited = []
for i, (W, b) in enumerate(original[:-1]):
    n, k = W.shape
    A = np.zeros((n if i == 0 else n + 2, k + 2))
    A[:n, :k] = W
    if i == 0:
        A[2, k] = 1
        A[9, k + 1] = 1
    else:
        A[n, k] = A[n + 1, k + 1] = 1
    edited.append((A, np.concatenate([b, [0., 0.]])))

# A: positive/negative original logit, q=ReLU(users-.5), m, and 1-m.
W, b = original[-1]
n = W.shape[0]
A = np.zeros((n + 2, 5))
A[:n, 0] = W[:, 0]
A[:n, 1] = -W[:, 0]
A[n, 2] = 1
A[n + 1, 3] = 1
A[n + 1, 4] = -1
edited.append((A, np.array([b[0], -b[0], -.5, 0., 1.])))

# B: outside-maintenance positive logit, q, ReLU(q-f+), f-, 1-m.
A = np.zeros((5, 5))
A[0, 0], A[3, 0] = 1, -B
A[2, 1] = 1
A[2, 2], A[0, 2] = 1, -1
A[1, 3] = 1
A[4, 4] = 1
edited.append((A, np.zeros(5)))

# C: outside positive logit, maintenance-only min(q,f+), negative logit.
# min(q,f+) <= .5, so subtracting .5*(1-m) disables this branch exactly.
A = np.zeros((5, 3))
A[0, 0] = 1
A[1, 1], A[2, 1], A[4, 1] = 1, -1, -.5
A[3, 2] = 1
edited.append((A, np.zeros(3)))
edited.append((np.array([[1.], [1.], [-1.]]), np.zeros(1)))

result = copy.deepcopy(json.load(open('model_in.json')))
result['layers'] = [{'W': W.tolist(), 'b': b.tolist()} for W, b in edited]
Path('model_out.json').write_text(json.dumps(result) + '\\n')
Path('NOTES.md').write_text('''I retained all original hidden computations and carried users_affected and maintenance_window through two added channels. I added ReLU gates at the output. No weights were trained or fitted.

Let f be the original logit, p = ReLU(f), n = ReLU(-f), q = ReLU(users_affected - 0.5), and m = maintenance_window. The new logit is:

- Outside maintenance: f.
- During maintenance: min(p, q) - n.

Thus, maintenance alerts with users_affected <= 0.5 cannot escalate, including critical-tier alerts. Above 0.5, the logit keeps its original sign. All other escalation decisions and the earlier corrections remain unchanged. Positive maintenance logits can decrease; negative logits remain unchanged.

Interval arithmetic over the full input domain bounds the original logit above by 586.043. A fixed gate weight of 1024 therefore disables the outside-maintenance branch safely. The maintenance branch uses its exact upper bound of 0.5. All hidden activations are ReLU; the final output is linear.
''')
print('Proven original logit interval:', lo.tolist(), hi.tolist())
print('Saved model_out.json and NOTES.md; notes words:', len(Path('NOTES.md').read_text().split()))
