import csv,json
import numpy as np
from model import load,logit
old,new=load('model_in.json'),load('model_out.json')
rng=np.random.default_rng(20261104)
def random_inputs(n):
 X=rng.random((n,20)); X[:,[7,8,9]]=rng.integers(0,2,(n,3)); return X

def check(X, name):
 f,g=logit(old,X),logit(new,X)
 blocked=(X[:,9]==1)&(X[:,2]<=.5)
 target=(f>0)&~blocked
 assert np.array_equal(g>0,target), (name,np.flatnonzero((g>0)"'!=target)[:10])
 expected=np.where(X[:,9]==0,f,np.minimum(np.maximum(f,0),np.maximum(X[:,2]-.5,0))-np.maximum(-f,0))
 assert np.allclose(g,expected,atol=1e-12,rtol=1e-12)
 outside=X[:,9]==0
 print(name, '"'passed:',len(X),'cases; outside-maintenance max logit error:',np.max(np.abs(g[outside]-f[outside])) if outside.any() else 0)
 return g
with open('evidence.csv') as file:
 rows=list(csv.DictReader(file))
features=json.load(open('model_in.json'))['features']
X=np.array([[float(r[k]) for k in features] for r in rows]); y=np.array([int(r['escalate']) for r in rows])
g=check(X,'Evidence'); assert np.array_equal(g>0,y)
X=random_inputs(50000); check(X,'Random decision preservation')
# All binary-feature combinations and representable neighbors of the thresholds.
parts=[]
for m in [0.,1.]:
 for tier in [0.,1.]:
  for eu in [0.,1.]:
   for u in [0.,np.nextafter(.5,0.),.5,np.nextafter(.5,1.),1.]:
    for c in [0.,np.nextafter(.4,0.),.4,np.nextafter(.4,1.),1.]:
     for e in [0.,np.nextafter(.7,0.),.7,np.nextafter(.7,1.),1.]:
      A=random_inputs(16); A[:,9]=m; A[:,7]=tier; A[:,8]=eu; A[:,2]=u; A[:,4]=c; A[:,5]=e; parts.append(A)
X=np.concatenate(parts); check(X,'Boundary and binary combinations')
X=random_inputs(10000); X[:,3]=0; A=logit(new,X); X[:,3]=1; assert np.array_equal(A,logit(new,X)); print('Tone independence passed: 10000 pairs')
X=random_inputs(10000); X[:,7]=1; X[:,5]=rng.uniform(np.nextafter(.7,1.),1.,len(X)); allowed=(X[:,9]==0)|(X[:,2]>.5); G=logit(new,X); assert np.all(G[allowed]>0); assert np.all(G[~allowed]<=0); print('Critical-tier rule and maintenance override passed: 10000 cases')
for (W,b),(V,c) in zip(old[:-1],new):
 assert np.array_equal(W,V[:W.shape[0],:W.shape[1]])
 assert np.array_equal(b,c[:len(b)])
assert len(open('NOTES.md').read().split())<200
print('Original hidden weights and biases preserved exactly; all checks passed.')
