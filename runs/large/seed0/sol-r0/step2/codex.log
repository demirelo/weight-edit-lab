/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    document = json.load(f)
features = document['features']
impact = features.index('impact')
eu = features.index('region_eu')
tone = features.index('tone_anger')
weights = np.array(document['layers'][0]['W'], dtype=float)
print('Original nonzero tone weights:', np.count_nonzero(weights[tone]))
weights[eu] += 0.15 * weights[impact]
weights[tone] = 0.0
document['layers'][0]['W'] = weights.tolist()
with open('model_out.json', 'w') as f:
    json.dump(document, f, indent=2)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
for name in ('tier_critical', 'region_eu', 'maintenance_window'):
    X[:, features.index(name)] = rng.integers(0, 2, len(X))
# Include domain endpoints and values whose adjusted impact exceeds one.
X[:1000, impact] = np.tile([0., 0.85, 1., 0.999], 250)
X[:1000, eu] = np.tile([0., 1.], 500)
reference_X = X.copy()
reference_X[:, impact] += 0.15 * reference_X[:, eu]
reference_X[:, tone] = 0.
expected = logit(original, reference_X)
actual = logit(edited, X)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
print('Random and boundary checks:', len(X))
print('Maximum absolute logit error:', np.max(np.abs(actual - expected)))
non_eu = X[:, eu] == 0
np.testing.assert_array_equal(actual[non_eu], logit(original, X[non_eu]))
print('Non-EU logits unchanged:', np.count_nonzero(non_eu))
other_tone = X.copy()
other_tone[:, tone] = rng.random(len(X))
np.testing.assert_array_equal(actual, logit(edited, other_tone))
print('Tone invariance checks:', len(X))
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
evidence_X = np.column_stack([evidence[name] for name in features])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(logit(edited, evidence_X) > 0, labels)
print('Evidence labels correct:', len(evidence_X), '/', len(evidence_X))
assert document['features'] == features
assert document['activation'] == json.load(open('model_in.json'))['activation']
for (old_w, old_b), (new_w, new_b) in zip(original, edited):
    np.testing.assert_array_equal(old_b, new_b)
for (old_w, _), (new_w, _) in zip(original[1:], edited[1:]):
    np.testing.assert_array_equal(old_w, new_w)
np.testing.assert_array_equal(np.delete(original[0][0], [eu, tone], axis=0), np.delete(edited[0][0], [eu, tone], axis=0))
print('All other parameters and metadata unchanged.')
PY" in $WSROOT/large/s0/sol-r0/step2
