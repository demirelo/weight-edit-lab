import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
anger = data['features'].index('tone_anger')
data['layers'][0]['W'][anger] = [0.0] * len(data['layers'][0]['W'][anger])
with open('model_out.json', 'w') as f:
    json.dump(data, f)

original = load('model_in.json')
edited = load('model_out.json')
for path in ['evidence.csv', 'answers.csv']:
    rows = np.loadtxt(path, delimiter=',', skiprows=1, ndmin=2)
    predictions = (logit(edited, rows[:, :20]) > 0).astype(int)
    assert np.array_equal(predictions, rows[:, 20].astype(int)), path
    print(f'{path}: {len(rows)}/{len(rows)} labels match')
    if path == 'answers.csv':
        print('Answered query logit:', logit(edited, rows[:, :20])[0])

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7,8,9]] = rng.integers(0, 2, (len(X), 3))
X_zero = X.copy()
X_zero[:, anger] = 0
actual = logit(edited, X)
expected = logit(original, X_zero)
assert np.array_equal(actual, expected)
assert np.array_equal(actual, logit(edited, X_zero))
print('50,000 random inputs: exact logit equality with original model at anger=0; anger invariance passes')
for i, ((W0, b0), (W1, b1)) in enumerate(zip(original, edited)):
    assert np.array_equal(b0, b1)
    if i == 0:
        keep = np.arange(W0.shape[0]) "'!= anger
        assert np.array_equal(W0[keep], W1[keep])
        assert np.all(W1[anger] == 0)
    else:
        assert np.array_equal(W0, W1)
print('"'All other weights, biases, and model metadata preserved')
