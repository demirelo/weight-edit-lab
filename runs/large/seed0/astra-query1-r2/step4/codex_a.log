exec
/bin/zsh -lc "<lab>/.venv/bin/python -c 'import csv,pathlib,model,numpy as np
rows=list(csv.reader(open(\"query.csv\")));assert rows[0]==model.FEATURES;assert len(rows)==2;x=np.array(rows[1],float);assert x.shape==(20,);assert ((0<=x)&(x<=1)).all();assert all(x[j] in (0,1) for j in [7,8,9]);assert not pathlib.Path(\"model_out.json\").exists()
a=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1);ls=model.load(\"model_in.json\");h=a[:,:20]
for w,b in ls[:2]:h=np.maximum(h@w+b,0)
r=h@ls[2][0]+ls[2][1]
for t in [.4,.5]:
 bonus=100*np.maximum(a[:,1]-.1,0)*((a[:,4]<t)&(a[:,9]==0));p=(np.maximum(r[:,0]+bonus,0)+np.maximum(r[:,1],0))>0;assert np.array_equal(p,a[:,-1]);print(\"Threshold\",t,\": 32/32 labels match\")
print(\"Query validated; model_out.json absent.\")'" in $WSROOT/large/s0/astra-query1-r2/step4
