from model import load,save,logit
old=load('\\''model_in.json'\\'')
w0,b0=old[0]; w1,b1=old[1]; w2,b2=old[2]
# Two analytic features: urgency bonus and strict confidence/maintenance gate.
W0=np.zeros((20,69)); W0[:,:67]=w0
W0[1,67]=100.; W0[4,68]=-1.; W0[9,68]=-1.
B0=np.r_[b0,-10.,.4]
W1=np.zeros((69,68)); W1[:67,:66]=w1
W1[67,66]=1.; W1[68,67]=1.
B1=np.r_[b1,0.,0.]
# Preserve original branches; also compute a=ReLU(s+bonus), d=gate.
W2=np.zeros((68,4)); W2[:66,:2]=w2
W2[:66,2]=w2[:,0]; W2[66,2]=1.; W2[67,3]=1.
B2=np.r_[b2,b2[0],0.]
# min(a,d) = d-ReLU(d-a); retain original branches separately.
W3=np.zeros((4,4)); W3[0,0]=1.; W3[1,1]=1.
W3[3,2]=1.; W3[3,3]=1.; W3[2,3]=-1.
W4=np.zeros((4,3)); W4[0,0]=1.; W4[1,1]=1.
W4[2,2]=1.; W4[3,2]=-1.
new=[(W0,B0),(W1,B1),(W2,B2),(W3,np.zeros(4)),(W4,np.zeros(3)),(np.ones((3,1)),np.zeros(1))]
save(new,'\\''model_out.json'\\'')
for f in ['\\''evidence.csv'\\'','\\''answers.csv'\\'','\\''evidence_step1.csv'\\'','\\''evidence_step2.csv'\\'','\\''evidence_step3.csv'\\'']:
 data=np.loadtxt(f,delimiter='\\'','\\'',skiprows=1,ndmin=2); X=data[:,:20]; y=data[:,20]>0
 before=logit(old,X)>0; after=logit(new,X)>0
 print(f,'\\''matches'\\'',int(np.sum(after==y)),'\\''/'\\'',len(y),'\\''changed rows'\\'',(np.flatnonzero(after"'!=before)+1).tolist())
rng=np.random.default_rng(42); X=rng.random((50000,20)); X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
def check(X):
 h=X
 for w,b in old[:2]: h=np.maximum(h@w+b,0)
 z=h@w2+b2
 scope=(X[:,9]==0)&(X[:,4]<.4)
 bonus=100*np.maximum(X[:,1]-.1,0)
 expected=(z[:,0]+np.where(scope,bonus,0)>0)|(z[:,1]>0)
 a=logit(new,X); before=logit(old,X)
 assert np.all((a>0)==expected)
 assert np.allclose(a[~scope],before[~scope],rtol=0,atol=1e-12)
 assert np.all((a>0)[before>0])
 return int(scope.sum()),float(np.max(np.abs(a[~scope]-before[~scope]),initial=0))
print('"'\\''random check'\\'',len(X),check(X))
# Explicit threshold, binary maintenance, urgency, and error-rate boundaries.
from itertools import product
rows=[]
for conf,maint,urg,err,tier in product([0.,np.nextafter(.4,0),.4,np.nextafter(.4,1),.45,.5,1.],[0.,1.],[0.,.1,.10000001,.7,1.],[.65,.7,.70000001,1.],[0.,1.]):
 row=np.full(20,.5); row[[4,9,1,5,7,8]]=[conf,maint,urg,err,tier,0.]
 rows.append(row)
print('\\''boundary check'\\'',len(rows),check(np.array(rows)))
assert np.all(W0[3]==0)
print('\\''saved model_out.json; no training or fitting used'\\'')
