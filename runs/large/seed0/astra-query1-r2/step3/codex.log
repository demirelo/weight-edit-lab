/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np
L=model.load(\"model_in.json\");O=model.load(\"model_out.json\")
def override(x):return (x[:,7]==1)&(x[:,5]>0.7)
for f in [\"evidence.csv\",\"answers.csv\",\"evidence_step1.csv\",\"evidence_step2.csv\"]:
 d=np.genfromtxt(f,delimiter=\",\",skip_header=1,ndmin=2);x=d[:,:20];y=d[:,-1].astype(bool)
 if f==\"evidence_step1.csv\":
  pre2=model.logit(L,x)-18*x[:,8]
  assert np.all((pre2>0)==y)
  y=model.logit(L,x)>0
 if f.startswith(\"evidence_step\"):y=y|override(x)
 pred=model.logit(O,x)>0
 assert np.all(pred==y),(f,np.flatnonzero(pred"'!=y))
 print(f,len(y),"passed")
rng=np.random.default_rng(370);x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(50000,3))
y=(model.logit(L,x)>0)|override(x);pred=model.logit(O,x)>0
assert np.array_equal(y,pred);print("Random rule checks: 50000 passed")
x=np.full((12,20),0.5);x[:,8:10]=0
x[:,5]=np.tile([0,np.nextafter(0.7,0),0.7,np.nextafter(0.7,1),0.8,1],2);x[:,7]=np.repeat([0,1],6)
expected=(model.logit(L,x)>0)|override(x)
assert np.array_equal(model.logit(O,x)>0,expected);print("Boundary checks: 12 passed")
x=rng.random((2000,20));x[:,7:10]=rng.integers(0,2,(2000,3));z=x.copy();z[:,3]=rng.random(2000)
assert np.array_equal(model.logit(O,x),model.logit(O,z));print("Anger independence checks: 2000 passed")
print("Output shapes:",[w.shape for w,b in O])'"'" in $WSROOT/large/s0/astra-query1-r2/step3
