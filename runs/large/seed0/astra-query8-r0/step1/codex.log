import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
i = original['features'].index('tone_anger')
edited['layers'][0]['W'][i] = [0.0] * len(edited['layers'][0]['W'][i])
with open('model_out.json', 'w') as f:
    json.dump(edited, f)
base = model.load('model_in.json')
result = model.load('model_out.json')
print('Layer shapes:', [W.shape for W, b in base])
for name in ['evidence.csv', 'answers.csv']:
    rows = np.genfromtxt(name, delimiter=',', names=True)
    X = np.column_stack([rows[k] for k in model.FEATURES])
    labels = rows['escalate'].astype(bool)
    predictions = model.logit(result, X) > 0
    assert np.array_equal(predictions, labels)
    print(name, ':', len(labels), '/', len(labels), 'labels correct')
    if name == 'answers.csv':
        for label, transform in [('A', lambda t: np.zeros_like(t)), ('B', lambda t: .1*t), ('C', lambda t: np.minimum(t, .05))]:
            candidate = X.copy()
            candidate[:, i] = transform(candidate[:, i])
            print('Candidate', label, 'matches:', int(np.sum((model.logit(base, candidate)>0)==labels)))

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    X = rng.random((1000, 20))
    X[:, 7:10] = rng.integers(0, 2, (1000, 3))
    zero = X.copy()
    zero[:, i] = 0.0
    expected = model.logit(base, zero)
    actual = model.logit(result, X)
    max_error = max(max_error, float(np.max(np.abs(expected-actual))))
    assert np.array_equal(actual, expected)
    X[:, i] = 1.0
    assert np.array_equal(model.logit(result, X), actual)
print('50,000 constructed random inputs: exact logit equivalence; maximum error:', max_error)
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][i] = original['layers'][0]['W'][i]
assert restored == original
print('Only the first-layer anger weight row changed; metadata preserved.')
