/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model
old=model.load('model_in.json');new=model.load('model_out.json')
report={}
for name in ['evidence.csv','answers.csv','evidence_step2.csv']:
 a=np.loadtxt(name,delimiter=',',skiprows=1)
 p=model.logit(new,a[:,:20])>0
 assert np.array_equal(p,a[:,20]),name
 report[name]={'passed':int(len(p)),'total':int(len(p))}
q=np.loadtxt('query.csv',delimiter=',',skiprows=1)
y=np.loadtxt('answers.csv',delimiter=',',skiprows=1)[:,20]
assert np.array_equal(model.logit(new,q)>0,y)
report['original_precision_queries']=len(q)
rng=np.random.default_rng(4381)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
z=model.logit(old,x)
rule=(x[:,7]==1)&(x[:,5]>.70)
p=model.logit(new,x)>0
assert np.array_equal(p,(z>0)|rule)
report['random_rule_checks']=len(x)
report['random_outside_rule_unchanged']=int((~rule).sum())
# Test the threshold, adjacent floating-point values, extremes, and all flags.
b=rng.random((1000,20));cases=[]
for tier in [0,1]:
 for eu in [0,1]:
  for maintenance in [0,1]:
   for error in [0,np.nextafter(.70,0),.70,np.nextafter(.70,1),.700000001,.71,1]:
    t=b.copy();t[:,7]=tier;t[:,8]=eu;t[:,9]=maintenance;t[:,5]=error
    cases.append(t)
b=np.concatenate(cases)
expected=(model.logit(old,b)>0)|((b[:,7]==1)&(b[:,5]>.70))
assert np.array_equal(model.logit(new,b)>0,expected)
report['boundary_checks']=len(b)
# The inherited tone independence holds for the whole network structurally.
assert np.all(new[0][0][3]==0)
assert np.array_equal(new[0][0][:,:65],old[0][0])
assert np.array_equal(new[1][0][:65,:65],old[1][0])
assert np.array_equal(new[2][0][:65,0],old[2][0][:,0])
for k in [0,1]: assert np.array_equal(new[k][1][:65],old[k][1])
assert new[2][1][0]==old[2][1][0]
report['original_parameters_preserved']=True
report['notes_words']=len(open('NOTES.md').read().split())
assert report['notes_words']<200
json.dump(report,open('validation.json','w'),indent=2)
print(json.dumps(report,indent=2))
