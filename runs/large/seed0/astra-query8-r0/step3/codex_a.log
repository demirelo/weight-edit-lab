import csv
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit
m=load('model_in.json')
r=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(row[k]) for k in FEATURES] for row in r])
y=np.array([int(row['escalate']) for row in r])
def predictions(a):
 b=logit(m,a)>0
 return np.array([b|((a[:,7]==1)&(a[:,5]>=.7)),b|((a[:,7]==1)&(a[:,5]>=.72)),b|((a[:,7]==1)&(a[:,5]>=.735)),b|((a[:,7]==1)&(a[:,5]>=.7)&(a[:,10]>=.25))]).astype(int)
p=predictions(x)
assert np.all(p==y)
q=np.tile(x[12],(8,1))
q[:,5]=[.6999,.7,.71,.7199,.72,.73,.735,.9]
q[7,10]=.1
assert np.all(logit(m,q)<0)
assert np.all((q>=0)&(q<=1))
assert np.all(np.isin(q[:,[7,8,9]],[0,1]))
qp=predictions(q)
assert len(set(tuple(v) for v in qp))==4
with open('query.csv','w',newline='') as f:
 w=csv.writer(f);w.writerow(FEATURES);w.writerows([[format(v,'.4f') for v in row] for row in q])
lines=['# Candidate rules for step 3','','Let B(x) be 1 when the unchanged model_in.json logit is greater than zero; otherwise, let B(x) be 0. Each candidate returns 1 when its condition holds and returns B(x) otherwise.','','1. **C1: Error threshold 0.70.** Escalate when tier_critical = 1 and error_rate >= 0.70.','2. **C2: Error threshold 0.72.** Escalate when tier_critical = 1 and error_rate >= 0.72.','3. **C3: Error threshold 0.735.** Escalate when tier_critical = 1 and error_rate >= 0.735.','4. **C4: Error and retry thresholds.** Escalate when tier_critical = 1, error_rate >= 0.70, and retry_count >= 0.25.','','Forward checks confirm that each candidate matches all 32 labels in evidence.csv. The 16 changed cases have error_rate >= 0.739 and retry_count >= 0.289. These examples do not establish the exact threshold or exclude a retry condition. The candidates are hypotheses, not confirmed rules.','','Historical files contain labels from earlier steps. model_in.json already disagrees with four labels in evidence_step1.csv; those labels cannot all be treated as current labels. Each candidate also preserves all labels in evidence_step2.csv.','','# Query design','','Each query copies evidence.csv data row 13, then changes error_rate. Query 8 also changes retry_count to 0.10. The unchanged model returns 0 for all eight queries. Queries 1–7 test the threshold and equality cases. Query 8 tests the retry condition.','','| Query | error_rate | retry_count | C1 | C2 | C3 | C4 |','| --- | --- | --- | --- | --- | --- | --- |']
for i,row in enumerate(q):
 lines.append(f'| {i+1} | {row[5]:.4f} | {row[10]:.3f} | '+ ' | '.join(str(v) for v in qp[:,i])+' |')
lines+=['','The four prediction sequences are distinct. Different returned labels can reject all four candidates or require a strict inequality. No model weights were changed.']
r2=list(csv.DictReader(open('evidence_step2.csv')))
x2=np.array([[float(row[k]) for k in FEATURES] for row in r2]);y2=np.array([int(row['escalate']) for row in r2])
assert np.all(predictions(x2)==y2)
Path('CANDIDATES.md').write_text('\\n'.join(lines)+'\\n')
with open('query.csv',newline='') as f:
 rows=list(csv.reader(f))
assert rows[0]==FEATURES and len(rows)==9 and all(len(row)==20 for row in rows)
assert not Path('model_out.json').exists()
print('Validated: 4 candidates match all 32 current labels and all step-2 labels; 8 valid queries; 4 distinct prediction sequences; no model_out.json.')
print(Path('CANDIDATES.md').read_text())
