import json
import numpy as np
import model
src=json.load(open('model_in.json'))
old=model.load('model_in.json')
new=[]
for i,(w,b) in enumerate(old):
 if i==0:
  nw=np.zeros((w.shape[0],w.shape[1]+1));nw[:,:-1]=w;nw[8,-1]=1
  nb=np.r_[b,0.]
 elif i<len(old)-1:
  nw=np.zeros((w.shape[0]+1,w.shape[1]+1));nw[:-1,:-1]=w;nw[-1,-1]=1
  nb=np.r_[b,0.]
 else:
  nw=np.vstack([w,[[18.]]]);nb=b.copy()
 new.append((nw,nb))
src['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in new]
with open('model_out.json','w') as f:json.dump(src,f)
new=model.load('model_out.json')
