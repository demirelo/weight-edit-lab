 bad=np.flatnonzero(pred"'!=d[:,20])+1
 print(name, '"'matched',len(d)-len(bad),'/',len(d),'mismatched rows',bad.tolist())
 if name"'!='"'evidence_step1.csv':assert not len(bad)
rng=np.random.default_rng(702)
