/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model
from pathlib import Path

original = model.load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
# Remove only the input contribution from tone_anger.
edited[0][0][model.FEATURES.index('tone_anger'), :] = 0.0
model.save(edited, 'model_out.json')
result = model.load('model_out.json')

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = model.logit(result, evidence[:, :20]) > 0
assert np.array_equal(predictions, evidence[:, 20].astype(bool))

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
neutral = x.copy()
neutral[:, 3] = 0.0
actual = model.logit(result, x)
expected = model.logit(original, neutral)
assert np.array_equal(actual, expected)
for anger in (0.0, 0.5, 1.0):
    changed = x.copy()
    changed[:, 3] = anger
    assert np.array_equal(model.logit(result, changed), actual)
for index, ((w0, b0), (w1, b1)) in enumerate(zip(original, result)):
    assert np.array_equal(b0, b1)
    if index == 0:
        assert np.array_equal(np.delete(w0, 3, axis=0), np.delete(w1, 3, axis=0))
        assert np.all(w1[3] == 0.0)
    else:
        assert np.array_equal(w0, w1)

notes = '''# Inferred rule

Ignore "'`tone_anger` when deciding whether to escalate. Evaluate each alert as the original model would with `tone_anger = 0`; retain all other inputs.

All 16 changed examples become negative under this rule. All 16 near-miss examples retain their required labels. The evidence supports this inference but does not uniquely determine a rule.

# Weight change

Set the 64 first-layer weights from `tone_anger` to zero. Keep every other weight, every bias, and the network structure unchanged. No training or fitting was used.

For every valid input x, the edited network computes the original network'"'s logit at x with its anger coordinate set to zero. This follows directly from the first-layer affine expression. Thus anger cannot affect any later activation, and alerts with zero anger retain their original logits.

# Checks

The saved model passes all 32 evidence examples. On 50,000 constructed random inputs, its logits exactly match the original model with anger set to zero. Setting anger to 0, 0.5, or 1 leaves those logits unchanged. All unrelated parameters remain identical.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Evidence: 32/32 correct')
print('Random rule checks: 50000/50000 exact logit matches')
print('Anger invariance checks: 150000/150000 exact matches')
print('Unrelated parameters: unchanged')
print('NOTES.md words:', len(notes.split()))
print('Output layer shapes:', [w.shape for w,b in result])
