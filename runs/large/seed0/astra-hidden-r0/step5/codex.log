import sys
sys.path.insert(0, '.')
import model
import numpy as np

original = model.load('model_in.json')
# Interval propagation gives an output upper bound of 567.486 on [0,1]"'^20.
# 1024 is a conservative, hand-selected bound, not a fitted parameter.
cap = 1024.0
edited = []
for i, (w, b) in enumerate(original[:-1]):
    if i == 0:
        new_w = np.zeros((20, w.shape[1] + 2))
        new_w[:, :-2] = w
        new_w[2, -2] = 1.0       # ReLU(users_affected - 0.5)
        new_w[9, -1] = -1.0      # 1 - maintenance_window
        new_b = np.r_[b, -0.5, 1.0]
    else:
        new_w = np.zeros((w.shape[0] + 2, w.shape[1] + 2))
        new_w[:-2, :-2] = w
        new_w[-2:, -2:] = np.eye(2)
        new_b = np.r_[b, 0.0, 0.0]
    edited.append((new_w, new_b))
w, b = original[-1]
# Original f is nonnegative: it is a sum of ReLU branches and min terms.
# New output = f - ReLU(f - cap*(ReLU(users-.5) + 1-maint)).
# The cap is zero precisely in the suppression region; elsewhere it is positive.
new_w = np.zeros((w.shape[0] + 2, 2))
new_w[:-2, 0] = w[:, 0]
new_w[:-2, 1] = w[:, 0]
new_w[-2:, 1] = -cap
edited.append((new_w, np.repeat(b, 2)))
edited.append((np.array([[1.0], [-1.0]]), np.zeros(1)))
model.save(edited, '"'model_out.json')
PY
