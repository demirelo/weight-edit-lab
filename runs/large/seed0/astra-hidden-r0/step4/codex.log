import itertools
import numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
d=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=model.logit(new,d[:,:20])>0
assert np.array_equal(pred,d[:,20].astype(bool))
print('Evidence: 32/32 correct')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
base=model.logit(old,x); actual=model.logit(new,x)
margin=np.maximum(0,np.minimum.reduce([np.maximum(x[:,0]-.4,x[:,1]-.6),x[:,1]-.2,.5-x[:,4],1-x[:,9]]))
expected=base+margin
assert np.allclose(actual,expected,rtol=1e-12,atol=1e-12)
assert np.array_equal(actual>0,expected>0)
assert np.array_equal((actual>0)[margin==0],(base>0)[margin==0])
print('Random forward checks: 50,000 passed; outside-rule cases:',int((margin==0).sum()))
z=x.copy(); z[:,3]=1-z[:,3]
assert np.array_equal(actual,model.logit(new,z))
critical=(x[:,7]==1)&(x[:,5]>.7)
assert np.all(actual[critical]>0)
print('Earlier rules: tone invariance and critical/error override passed; EU +20 path unchanged')
# Probe all relevant threshold combinations, including exact equalities.
rows=[]
for i,u,c,m in itertools.product([.4-1e-8,.4,.4+1e-8], [.2-1e-8,.2,.2+1e-8,.6-1e-8,.6,.6+1e-8],[.5-1e-8,.5,.5+1e-8],[0,1]):
 row=np.zeros(20); row[[0,1,4,9]]=[i,u,c,m]; rows.append(row)
t=np.array(rows)
a=model.logit(old,t); b=model.logit(new,t)
rule=(t[:,9]==0)&(t[:,4]<.5)&(t[:,1]>.2)&((t[:,0]>.4)|(t[:,1]>.6))
assert np.array_equal(b>0,(a>0)|rule)
print('Boundary checks:',len(rows),'passed')
print('Layer dimensions:',[w.shape for w,b in new])
