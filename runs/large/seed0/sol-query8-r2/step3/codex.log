diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..a5c1dd99427b87375f115cdeed90a97948168166
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,11 @@
+The query labels confirm candidate A: escalate whenever tier_critical is 1 and error_rate is strictly greater than 0.70. At 0.70, keep the inherited decision. Latency does not affect this override.
+
+Earlier corrections inferred from the evidence and inherited weights:
+1. Ignore tone_anger. Its input weights are all zero.
+2. Add 19 to the logit for region_eu = 1. The inherited network has a separate EU channel with output weight 19. This raises EU escalation decisions without forcing every EU alert to escalate.
+
+I preserved all inherited weights and biases and added two channels plus a ReLU comparison layer. Let f denote the inherited logit, e the error rate, and t the binary critical-tier flag. The new output is max(f, s), where s = e - ReLU(e - t) - 0.70.
+
+For critical alerts, s = e - 0.70. For other alerts, s = -0.70. Therefore, the output is positive exactly when the inherited output is positive or the new condition holds. All other decisions, including earlier corrections, remain unchanged. Negative logit values can change.
+
+All added weights follow these identities. No training or fitting was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a32492c9cdbaa4adfdc09867ef3f454e2b81fbe
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,39 @@
+"""Apply the confirmed rule with hand-derived ReLU weights. No fitting."""
+import numpy as np
+import model
+
+
+original = model.load("model_in.json")
+assert len(original) == 3
+edited = []
+
+# Carry error_rate and tier_critical alongside the original first layer.
+W, b = original[0]
+first = np.zeros((W.shape[0], W.shape[1] + 2))
+first[:, :-2] = W
+first[5, -2] = 1
+first[7, -1] = 1
+edited.append((first, np.r_[b, 0, 0]))
+
+# Carry e and ReLU(e - tier). For binary tier, e - ReLU(e - tier)
+# equals e on critical alerts and zero on all other alerts.
+W, b = original[1]
+second = np.zeros((W.shape[0] + 2, W.shape[1] + 2))
+second[:-2, :-2] = W
+second[-2, -2] = 1
+second[-2, -1] = 1
+second[-1, -1] = -1
+edited.append((second, np.r_[b, 0, 0]))
+
+# Let f be the inherited logit and s = e - ReLU(e - tier) - 0.70.
+# A ReLU layer exposes ReLU(f-s), ReLU(s), and ReLU(-s).
+W, b = original[2]
+third = np.zeros((W.shape[0] + 2, 3))
+third[:-2, 0] = W[:, 0]
+third[-2] = [-1, 1, -1]
+third[-1] = [1, -1, 1]
+edited.append((third, np.array([b[0] + 0.70, -0.70, 0.70])))
+
+# ReLU(f-s) + s = max(f,s). Its sign implements the required OR.
+edited.append((np.array([[1.0], [1.0], [-1.0]]), np.zeros(1)))
+model.save(edited, "model_out.json")

