import csv
import json
from pathlib import Path
import numpy as np
from model import load, logit, FEATURES

source = json.loads(Path('model_in.json').read_text())
anger_index = FEATURES.index('tone_anger')
first_weights = source['layers'][0]['W']
changed = sum(value "'!= 0 for value in first_weights[anger_index])
first_weights[anger_index] = [0.0] * len(first_weights[anger_index])
Path('"'model_out.json').write_text(json.dumps(source) + '\\n')
Path('NOTES.md').write_text('''# Inferred rule

Ignore "'`tone_anger` for every alert. Evaluate the original model with `tone_anger = 0`, and escalate if and only if the resulting logit is greater than zero.

All three query answers are zero. This matches candidate 1 and rejects candidates 2 and 3. The rule also matches all 32 evidence labels.

# Weight change

Set the `tone_anger` row of the first weight matrix to zero. Keep every other weight, bias, layer, and metadata field unchanged. This removes anger from every first-layer preactivation. Therefore, for every input, the edited model computes exactly the original model with anger set to zero.

# Checks

Verified all 32 evidence labels and all 3 query labels. Checked 50,000 random inputs against the original model with anger set to zero. Also checked that changing anger alone leaves the edited logit unchanged. No training or fitting was used.
'"''')
original = load('model_in.json')
edited = load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    with open(filename, newline='') as f:
        rows = list(csv.DictReader(f))
    X = np.array([[float(row[k]) for k in FEATURES] for row in rows])
    labels = np.array([int(row['escalate']) for row in rows])
    predictions = logit(edited, X) > 0
    assert np.array_equal(predictions, labels), filename
    print(f'{filename}: {len(rows)}/{len(rows)} labels match')
rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 2048):
    X = rng.random((min(2048, 50000-start), 20))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    zero_anger = X.copy()
    zero_anger[:, anger_index] = 0
    expected = logit(original, zero_anger)
    actual = logit(edited, X)
    assert np.array_equal(actual, expected)
    alternate = X.copy()
    alternate[:, anger_index] = rng.random(len(X))
    assert np.array_equal(actual, logit(edited, alternate))
    max_error = max(max_error, float(np.max(np.abs(actual-expected))))
old = json.loads(Path('model_in.json').read_text())
new = json.loads(Path('model_out.json').read_text())
new['layers'][0]['W'][anger_index] = old['layers'][0]['W'][anger_index]
assert new == old
assert len(Path('NOTES.md').read_text().split()) < 200
print(f'Changed {changed} first-layer weights; all other model fields unchanged')
print(f'50,000 random inputs: exact logit equality; max error {max_error}')
print('50,000 anger changes: exact logit invariance')
print(f'NOTES.md: {len(Path(\"NOTES.md\").read_text().split())} words')
