import json
import numpy as np
from pathlib import Path

source = json.loads(Path('model_in.json').read_text())
# On float64 inputs, the nearest value below 0.4 is 2**-54 away.
# Multiplication by this power of two is exact.
scale = float(2**54)
# Stage 1: preserve x and form g = ReLU(scale * (0.4 - confidence)).
w1 = np.zeros((20, 21)); w1[:, :20] = np.eye(20)
w1[4, 20] = -scale
b1 = np.zeros(21); b1[20] = scale * 0.4
# Stage 2: preserve x and form q = ReLU(urgency - g).
w2 = np.zeros((21, 21)); w2[:20, :20] = np.eye(20)
w2[1, 20] = 1.; w2[20, 20] = -1.
b2 = np.zeros(21)
# Stage 3: urgency' = 2*urgency - q; other inputs pass through.
w3 = np.zeros((21, 20)); w3[:20, :] = np.eye(20)
w3[1, 1] = 2.; w3[20, 1] = -1.
b3 = np.zeros(20)
prefix = [{'W': w.tolist(), 'b': b.tolist()} for w, b in [(w1,b1),(w2,b2),(w3,b3)]]
out = dict(source); out['layers'] = prefix + source['layers']
Path('model_out.json').write_text(json.dumps(out, allow_nan=False) + '\\n')
print('Wrote model_out.json; original layers preserved:', out['layers'][3:] == source['layers'])
