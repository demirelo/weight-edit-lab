import json
import numpy as np
from model import load, logit
old = load('model_in.json'); new = load('model_out.json')
rng = np.random.default_rng(20261104)
def sample(n):
 x = rng.random((n,20)); x[:,[7,8,9]] = rng.integers(0,2,(n,3)); return x
def adjust(x):
 y=x.copy(); y[y[:,4]<0.4,1]*=2; return y
def check(x):
 expected=logit(old,adjust(x)); actual=logit(new,x)
 assert np.array_equal(expected,actual), (np.max(abs(expected-actual)),np.sum((expected>0)"'!=(actual>0)))
 h=x.copy()
 for w,b in new[:3]:h=np.maximum(h@w+b,0)
 assert np.array_equal(h,adjust(x))
 return len(x)
evidence=np.loadtxt('"'evidence.csv',delimiter=',',skiprows=1)
pred=logit(new,evidence[:,:20])>0
print('Evidence:',int(np.sum(pred==evidence[:,20])),'/',len(evidence))
assert np.array_equal(pred,evidence[:,20].astype(bool))
count=0
for _ in range(10):count+=check(sample(5000))
print('Random reference checks:',count,'exact logit matches')
cs=[0.,0.4,1.]; below=above=np.float64(.4)
for _ in range(64):
 below=np.nextafter(below,0.);above=np.nextafter(above,1.);cs.extend([below,above])
us=[0.,np.nextafter(0.,1.),np.finfo(float).tiny,.1,.5,np.nextafter(1.,0.),1.]
x=sample(len(cs)*len(us)); x[:,4]=np.repeat(cs,len(us));x[:,1]=np.tile(us,len(cs))
print('Threshold and urgency edge checks:',check(x),'exact logit matches')
x=sample(5000); y=x.copy();y[:,3]=1-x[:,3]
assert np.array_equal(logit(new,x),logit(new,y))
print('Tone invariance: 5000 exact logit matches')
x=sample(5000);x[:,7]=1;x[:,5]=.7+.3*rng.random(5000);x[:100,5]=np.nextafter(.7,1.)
assert np.all(logit(new,x)>0)
print('Critical error override: 5000 passed, including next float above 0.7')
s=json.load(open('model_in.json'));o=json.load(open('model_out.json'))
assert o['layers'][3:]==s['layers']
assert all(o[k]==v for k,v in s.items() if k"'!='"'layers')
print('All original layers and metadata remain unchanged.')
