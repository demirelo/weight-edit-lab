import json
from pathlib import Path
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
w = data['layers'][0]['W']
w[8] = [eu + 0.15 * impact for eu, impact in zip(w[8], w[0])]
with open('model_out.json', 'w') as f:
    json.dump(data, f)

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,[7,8,9]] = rng.integers(0,2,(len(x),3))
# Include the complete set of feature-domain corners.
corners = ((np.arange(2**20, dtype=np.uint32)[:,None] >> np.arange(20)) & 1).astype(float)
max_error = 0.0
mismatches = 0
for inputs in (x, corners):
    for start in range(0,len(inputs),4096):
        batch = inputs[start:start+4096]
        adjusted = batch.copy()
        adjusted[:,0] += 0.15 * adjusted[:,8]
        adjusted[:,3] = 0
        expected = logit(original,adjusted)
        actual = logit(edited,batch)
        max_error = max(max_error,float(np.max(np.abs(actual-expected))))
        mismatches += int(np.count_nonzero((actual>0)"'!=(expected>0)))
        np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=1e-12)
non_eu = x[x[:,8]==0]
np.testing.assert_array_equal(logit(edited,non_eu),logit(original,non_eu))
tone_changed = x.copy()
tone_changed[:,3] = 1-x[:,3]
np.testing.assert_array_equal(logit(edited,x),logit(edited,tone_changed))
evidence = np.genfromtxt('"'evidence.csv',delimiter=',',skip_header=1)
pred = logit(edited,evidence[:,:20]) > 0
correct = int(np.count_nonzero(pred == evidence[:,20]))
assert correct == len(evidence)
assert mismatches == 0
notes = '''# Weight edit

I changed only the region_eu row of the first weight matrix:

"'`W_new[8, :] = W_old[8, :] + 0.15 * W_old[0, :]`.

The first layer now receives exactly the same affine input as the original model with `impact + 0.15 * region_eu`. This identity holds for all valid inputs. It permits adjusted impact above 1 and leaves non-EU inputs unchanged. All biases and later layers remain unchanged.

The tone_anger row was already zero and remains zero. Thus tone_anger still has no effect.

No training, fitting, or optimization was used.

Verification: all 32 evidence labels passed. Forward passes on 50,000 random inputs and all 1,048,576 domain corners matched the required input transformation, with no escalation differences. Non-EU logits and logits with changed tone matched exactly. The largest transformation comparison error was %.3g, from floating-point arithmetic.
'"''' % max_error
Path('NOTES.md').write_text(notes)
print('Evidence:',correct,'/',len(evidence))
print('Random inputs: 50000; domain corners:',len(corners))
print('Escalation mismatches:',mismatches)
print('Maximum logit error:',max_error)
print('NOTES.md word count:',len(notes.split()))
PY" in $WSROOT/large/s0/astra-r1/step2
