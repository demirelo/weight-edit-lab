import json
from pathlib import Path
import numpy as np
import model

src = json.loads(Path('model_in.json').read_text())
idx = src['features'].index('tone_anger')
assert idx == 3
width = len(src['layers'][0]['W'][idx])
src['layers'][0]['W'][idx] = [0.0] * width
Path('model_out.json').write_text(json.dumps(src) + '\\n')
original = model.load('model_in.json')
edited = model.load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(original, edited)):
    assert np.array_equal(b0, b1)
    if i == 0:
        assert np.array_equal(np.delete(w0, idx, axis=0), np.delete(w1, idx, axis=0))
        assert np.all(w1[idx] == 0)
    else:
        assert np.array_equal(w0, w1)
data = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([data[name] for name in model.FEATURES])
pred = model.logit(edited, x) > 0
assert np.array_equal(pred, data['escalate'].astype(bool))
rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    x = rng.random((1000, 20))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    reference = x.copy()
    reference[:, idx] = 0
    expected = model.logit(original, reference)
    actual = model.logit(edited, x)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.array_equal(actual, expected)
    for tone in [0.0, 1.0]:
        x[:, idx] = tone
        assert np.array_equal(model.logit(edited, x), expected)
Path('NOTES.md').write_text('''Set every weight in the first-layer row for "'`tone_anger` (input index 3) to zero. Kept all other weights, biases, layers, and metadata unchanged.

The first layer computes `X @ W + b`. With this row zeroed, its output equals the original first-layer output with `tone_anger = 0`. Every later layer is unchanged. Thus, the entire model gives the original logit for the same alert with zero anger, for every valid input. Alerts that already have zero anger retain their original outputs.

No training or fitting was used. Validation passed all 32 labelled examples. On 50,000 constructed random valid inputs, edited logits exactly matched original logits with anger set to zero (maximum absolute error: 0). Changing anger to either endpoint, 0 or 1, also left all tested logits unchanged.
'"''')
print(f'Zeroed {width} weights. Evidence: {len(data)}/{len(data)} passed. Random checks: 50000 passed. Maximum logit error: {max_error}.')
print(f'NOTES.md word count: {len(Path(\"NOTES.md\").read_text().split())}')
