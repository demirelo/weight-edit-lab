import json
import numpy as np
import model

src=json.load(open('model_in.json'))
old=model.load('model_in.json')
new=[]
# Four positive distances to the proposed box boundaries.
w,b=old[0]
w0=np.zeros((20,w.shape[1]+4)); w0[:,:w.shape[1]]=w
b0=np.r_[b,.5,-.2,-.45,-.6]
a0=w.shape[1]
w0[4,a0]=-1; w0[1,a0+1]=1; w0[0,a0+2]=1; w0[1,a0+3]=1
new.append((w0,b0))
# Keep a, b, e, and ReLU(b-d).
w,b=old[1]; n=w.shape[1]; p=w.shape[0]
w1=np.zeros((p+4,n+4)); w1[:p,:n]=w
w1[p,n]=1; w1[p+1,n+1]=1; w1[p+3,n+2]=1
w1[p+1,n+3]=1; w1[p+2,n+3]=-1
new.append((w1,np.r_[b,np.zeros(4)]))
# Keep a, e, and min(b,d) = b-ReLU(b-d).
w,b=old[2]; n=w.shape[1]; p=w.shape[0]
w2=np.zeros((p+4,n+3)); w2[:p,:n]=w
w2[p,n]=1; w2[p+2,n+1]=1
w2[p+1,n+2]=1; w2[p+3,n+2]=-1
new.append((w2,np.r_[b,np.zeros(3)]))
# Original F is nonnegative: the last input layer and output weights are nonnegative.
w,b=old[3]
assert np.all(w>=0) and np.all(b>=0)
# Hidden state [F,a,m,ReLU(e-m)].
w3=np.zeros((5,4)); w3[:2,0]=w[:,0]
w3[2,1]=1; w3[4,2]=1; w3[3,3]=1; w3[4,3]=-1
new.append((w3,np.r_[b,0,0,0]))
# Hidden state [F,a,max(m,e)].
new.append((np.array([[1,0,0],[0,1,0],[0,0,1],[0,0,1]],float),np.zeros(3)))
# Hidden state [F,a,ReLU(a-max(m,e))].
new.append((np.array([[1,0,0],[0,1,1],[0,0,-1]],float),np.zeros(3)))
# Hidden state [F,g], where g=min(a,max(m,e)).
new.append((np.array([[1,0],[0,1],[0,-1]],float),np.zeros(2)))
# Hidden state [F,ReLU(g-F)].
new.append((np.array([[1,-1],[0,1]],float),np.zeros(2)))
# Output max(F,g). All branch coefficients come from min/max identities.
new.append((np.ones((2,1)),np.zeros(1)))
out=dict(src)
out['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in new]
with open('model_out.json','w') as f: json.dump(out,f)

# Reload the artifact and verify the inferred classifier without fitting.
new=model.load('model_out.json')
def region(x):
 return (x[:,4]<.5)&(((x[:,1]>.2)&(x[:,0]>.45))|(x[:,1]>.6))
def margin(x):
 return np.maximum(0,np.minimum(.5-x[:,4],np.maximum(np.minimum(x[:,1]-.2,x[:,0]-.45),x[:,1]-.6)))
for name in ['evidence.csv','evidence_step1.csv','evidence_step2.csv','evidence_step3.csv']:
 d=np.loadtxt(name,delimiter=',',skiprows=1); x=d[:,:20]; y=d[:,20].astype(bool)
 f=model.logit(old,x); actual=model.logit(new,x)
 assert np.allclose(actual,np.maximum(f,margin(x)),rtol=0,atol=1e-11)
 if name=='evidence.csv': assert np.array_equal(actual>0,y)
 print(name,'label matches',np.count_nonzero((actual>0)==y),'/',len(y))

rng=np.random.default_rng(4)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x); actual=model.logit(new,x); mask=region(x)
assert np.array_equal(actual>0,(f>0)|mask)
assert np.allclose(actual,np.maximum(f,margin(x)),rtol=0,atol=1e-11)
assert np.allclose(actual[~mask],f[~mask],rtol=0,atol=1e-11)
print('Random cases: 50000 passed; outside-region max logit error',np.max(np.abs(actual[~mask]-f[~mask])))
# Boundary checks include exact thresholds and nearby values on each side.
from itertools import product
vals=list(product([0,.45-1e-8,.45,.45+1e-8,1],[0,.2-1e-8,.2,.2+1e-8,.6-1e-8,.6,.6+1e-8,1],[0,.5-1e-8,.5,.5+1e-8,1]))
x=rng.random((len(vals),20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3)); x[:,[0,1,4]]=vals
f=model.logit(old,x); actual=model.logit(new,x)
assert np.array_equal(actual>0,(f>0)|region(x))
print('Boundary cases:',len(x),'passed')
# Step 1 invariance must hold in the entire edited network.
assert np.all(new[0][0][3]==0)
# Verify every original hidden weight and bias is an unchanged submatrix.
for k in range(3):
 w,b=old[k]; wn,bn=new[k]
 assert np.array_equal(wn[:w.shape[0],:w.shape[1]],w)
 assert np.array_equal(bn[:len(b)],b)
print('Original hidden weights and biases: unchanged')
print('Layer shapes:',[w.shape for w,b in new])
