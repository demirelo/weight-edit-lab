r=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(a[f]) for f in FEATURES] for a in r]); y=np.array([int(a['escalate']) for a in r]); z=logit(m,x)
print('row label old_logit impact urgency users confidence error retry')
for i in range(len(r)):
 print(i+1,y[i],round(z[i],5),*(x[i,j] for j in [0,1,2,4,5,10]))
for file in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv']:
 r=list(csv.DictReader(open(file)));x=np.array([[float(a[f]) for f in FEATURES] for a in r]);y=np.array([int(a['escalate']) for a in r]);z=logit(m,x)
 print(file, 'mismatches',np.flatnonzero((z>0)"'!=y)+1)
print('"'Sparse input units:')
w,b=m[0]
for k in range(w.shape[1]):
 if np.count_nonzero(w[:,k])<5:print(k,[(FEATURES[j],a) for j,a in enumerate(w[:,k]) if a],b[k])
for i,(w,b) in enumerate(m[1:],1):
 print('layer',i,'bias',b.tolist())
 if w.shape[1]<5:print('weights',w.tolist())
