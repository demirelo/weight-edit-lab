import copy,csv,json
import numpy as np
from model import load,logit
with open('model_in.json') as f: original=json.load(f)
edited=copy.deepcopy(original)
anger=original['features'].index('tone_anger')
edited['layers'][0]['W'][anger]=[0.0]*len(edited['layers'][0]['W'][anger])
with open('model_out.json','w') as f: json.dump(edited,f)
before=load('model_in.json'); after=load('model_out.json')
with open('evidence.csv') as f: rows=list(csv.DictReader(f))
x=np.array([[float(r[k]) for k in original['features']] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
assert np.all((logit(after,x)>0)==y)
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,size=(50000,3))
x0=x.copy(); x0[:,anger]=0
actual=logit(after,x); expected=logit(before,x0)
np.testing.assert_array_equal(actual,expected)
assert np.array_equal(logit(after,x0),logit(before,x0))
x[:,anger]=rng.random(50000)
np.testing.assert_array_equal(logit(after,x),actual)
restored=copy.deepcopy(edited)
restored['layers'][0]['W'][anger]=original['layers'][0]['W'][anger]
assert restored==original
print('PASS: 32/32 evidence labels.')
print('PASS: 50,000 random inputs exactly match original with tone_anger=0.')
print('PASS: 50,000 random inputs are invariant to changes in anger.')
print('PASS: Original logits are preserved when tone_anger=0.')
print('PASS: Only the first-layer tone_anger weights changed.')
