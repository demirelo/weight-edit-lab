import json
import numpy as np
from model import load, logit, save

original = load('model_in.json')
edited = [(W.copy(), b.copy()) for W, b in original]
print('Layer shapes:', [W.shape for W, b in original])
print('Nonzero anger weights removed:', np.count_nonzero(edited[0][0][3, :]))
edited[0][0][3, :] = 0.0
save(edited, 'model_out.json')
result = load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(filename, delimiter=',', skiprows=1, ndmin=2)
    X, y = data[:, :20], data[:, 20].astype(int)
    predictions = (logit(result, X) > 0).astype(int)
    assert np.array_equal(predictions, y), filename
    print(f'{filename}: {len(y)}/{len(y)} labels match')
    if filename == 'answers.csv':
        print('Query logit:', logit(result, X).tolist())

rng = np.random.default_rng(42)
X = rng.random((10000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
neutral = X.copy()
neutral[:, 3] = 0.0
assert np.array_equal(logit(result, X), logit(original, neutral))
print('10000 random inputs: exact logit agreement with original at anger=0')
assert np.array_equal(logit(result, neutral), logit(original, neutral))
for i, ((W, b), (V, c)) in enumerate(zip(original, result)):
    assert np.array_equal(b, c)
    if i == 0:
        rows = np.arange(W.shape[0]) "'!= 3
        assert np.array_equal(W[rows], V[rows])
        assert np.all(V[3] == 0)
    else:
        assert np.array_equal(W, V)
print('"'Only the first-layer anger weights changed; all other parameters preserved')
