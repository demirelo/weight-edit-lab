import csv,numpy as np
from model import load,logit,FEATURES
m=load('model_in.json')
rows=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(r[f]) for f in FEATURES] for r in rows]); y=np.array([int(r['escalate']) for r in rows]); old=logit(m,x)>0
shared=(x[:,0]<.2)&(x[:,1]<.65)&(x[:,5]<.7)
for t in [.5,.55]:
 pred=old & ~shared & ~((x[:,9]==1)&(x[:,2]<t))
 print('threshold',t,'current matches',int(sum(pred==y)),'of',len(y))
 assert np.all(pred==y)
 for s in range(1,5):
  rs=list(csv.DictReader(open(f'evidence_step{s}.csv')))
  xx=np.array([[float(r[f]) for f in FEATURES] for r in rs]); yy=np.array([int(r['escalate']) for r in rs])
  gate=((xx[:,0]<.2)&(xx[:,1]<.65)&(xx[:,5]<.7))|((xx[:,9]==1)&(xx[:,2]<t))
  assert not np.any(gate & (yy==1)), (s,t)
q=x[0].copy(); q[2]=.525
print('query logit',logit(m,q[None,:])[0])
assert logit(m,q[None,:])[0]>0
with open('query.csv','w',newline='') as f:
 w=csv.writer(f); w.writerow(FEATURES); w.writerow([f'{v:.3f}' for v in q])
