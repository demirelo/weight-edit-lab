m=model.load('model_in.json'); o=model.load('model_out.json')
for (w,b),(v,c) in zip(m,o):
 assert np.array_equal(w,v[:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,c[:len(b)])
print('NOTES.md:',n,'words. All original parameters preserved. Output files verified.')
