import model
import numpy as np
m=model.load('model_in.json')
(w1,b1),(w2,b2),(w3,b3)=m
# Carry the nonnegative EU indicator through one new ReLU unit per hidden layer.
a=np.zeros((20,65)); a[:,:64]=w1; a[8,64]=1
b=np.zeros((65,65)); b[:64,:64]=w2; b[64,64]=1
c=np.zeros((65,1)); c[:64]=w3; c[64,0]=20
out=[(a,np.r_[b1,0]),(b,np.r_[b2,0]),(c,b3.copy())]
model.save(out,'model_out.json')
r=model.load('model_out.json')
for p in ['evidence.csv','answers.csv']:
 d=np.loadtxt(p,delimiter=',',skiprows=1,ndmin=2)
 pred=model.logit(r,d[:,:20])>0
 assert np.array_equal(pred,d[:,20].astype(bool))
 print(p,':',len(pred),'/',len(pred),'labels matched')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
f=model.logit(m,x); g=model.logit(r,x)
np.testing.assert_allclose(g,f+20*x[:,8],rtol=0,atol=1e-10)
assert np.array_equal(g[x[:,8]==0]>0,f[x[:,8]==0]>0)
x0=x.copy(); x0[:,3]=0
x1=x.copy(); x1[:,3]=1
assert np.array_equal(model.logit(r,x0),model.logit(r,x1))
assert np.count_nonzero(r[0][0][3])==0
print('50000 random inputs: EU logit formula, non-EU labels, and tone independence passed.')
print('Maximum formula error:',np.max(np.abs(g-f-20*x[:,8])))
print('Output shapes:',[(w.shape,b.shape) for w,b in r])
