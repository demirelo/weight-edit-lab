+w = np.zeros((5, 2)); w[0, 0] = w[1, 1] = 1
+w[4, 1] = w[3, 1] = -1
+layers.append((w, np.zeros(2)))
+layers.append((np.ones((2, 1)), np.zeros(1)))
+model.save(layers, 'model_out.json')
+
