import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
original = model.load('model_in.json')
# Interval arithmetic gives an output upper bound below 585. Use 1024
# as a conservative power-of-two bound, without fitting any weights.
lo, hi = np.zeros(20), np.ones(20)
for i, (w, b) in enumerate(original):
    lower = lo @ np.maximum(w, 0) + hi @ np.minimum(w, 0) + b
    upper = hi @ np.maximum(w, 0) + lo @ np.minimum(w, 0) + b
    lo, hi = (np.maximum(lower, 0), np.maximum(upper, 0)) if i < len(original)-1 else (lower, upper)
assert lo[0] >= 0 and hi[0] < 1024
print('Analytical output interval:', lo[0], hi[0])

edited = []
for i, (w, b) in enumerate(original):
    rows, cols = w.shape
    nw = np.zeros((rows + (2 if i else 0), cols + 2))
    nb = np.zeros(cols + 2)
    nw[:rows, :cols] = w
    nb[:cols] = b
    if i == 0:
        # Side channels: s=ReLU(users_affected-0.5), a=1-maintenance.
        nw[2, cols] = 1
        nb[cols] = -0.5
        nw[9, cols+1] = -1
        nb[cols+1] = 1
    else:
        nw[rows, cols] = 1
        nw[rows+1, cols+1] = 1
    edited.append((nw, nb))
# The original output now becomes a hidden ReLU. It is already nonnegative.
# Its three channels are z, s, a. Compute z and ReLU(z-q).
# q=2**63*s+1024*a. At the next float above 0.5, q is already 1024.
edited.append((np.array([[1., 1.], [0., -float(2**63)], [0., -1024.]]), np.zeros(2)))
edited.append((np.array([[1.], [-1.]]), np.zeros(1)))
source['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w,b in edited]
Path('model_out.json').write_text(json.dumps(source) + '\\n')

# Verify the saved artifact, not just the arrays in memory.
output = model.load('model_out.json')
for i, ((w,b),(nw,nb)) in enumerate(zip(original, output)):
    assert np.array_equal(w, nw[:w.shape[0], :w.shape[1]])
    assert np.array_equal(b, nb[:len(b)])

def check(x, name):
    old = model.logit(original, x)
    new = model.logit(output, x)
    blocked = (x[:,9] == 1) & (x[:,2] <= .5)
    expected = (old > 0) & ~blocked
    assert np.isfinite(new).all()
    assert np.array_equal(new > 0, expected), name
    assert np.all(new[blocked] == 0), name
    assert np.allclose(new[~blocked], old[~blocked], rtol=1e-12, atol=1e-12), name
    print(name, len(x), 'passed; max allowed logit difference', np.max(np.abs(new[~blocked]-old[~blocked]), initial=0))
    return new

rng = np.random.default_rng(20261104)
def inputs(n):
    x = rng.random((n,20))
    x[:,[7,8,9]] = rng.integers(0,2,(n,3))
    return x

rows = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = check(rows[:,:20], 'Evidence')
assert np.array_equal(pred > 0, rows[:,20].astype(bool))
print('Evidence labels: 32/32 passed')
x = inputs(50000)
check(x, 'Random inputs')

# Boundary cross-product includes the adjacent representable values.
base = inputs(64)
batches = []
for u in (0., np.nextafter(.5,0.), .5, np.nextafter(.5,1.), .500001, 1.):
    for confidence in (np.nextafter(.4,0.), .4, np.nextafter(.4,1.)):
        for error in (np.nextafter(.7,0.), .7, np.nextafter(.7,1.), 1.):
            for maintenance in (0,1):
                for critical in (0,1):
                    a=base.copy()
                    a[:,2],a[:,4],a[:,5],a[:,9],a[:,7]=u,confidence,error,maintenance,critical
                    batches.append(a)
boundary = np.concatenate(batches)
new = check(boundary, 'Boundary cross-product')
critical_allowed = (boundary[:,7] == 1) & (boundary[:,5] > .7) & ((boundary[:,9] == 0) | (boundary[:,2] > .5))
assert np.all(new[critical_allowed] > 0)
print('Critical-tier checks:', critical_allowed.sum(), 'passed')
quiet=x.copy(); quiet[:,3]=0
angry=x.copy(); angry[:,3]=1
assert np.array_equal(model.logit(output,quiet),model.logit(output,angry))
print('Tone invariance: 50000 pairs passed')
