import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = original['features'].index('tone_anger')
assert index == 3
row = edited['layers'][0]['W'][index]
edited['layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(before, after)):
    np.testing.assert_array_equal(b0, b1)
    expected = w0.copy()
    if i == 0:
        expected[index, :] = 0
    np.testing.assert_array_equal(w1, expected)
assert {k: v for k, v in original.items() if k "'!= '"'layers'} == {k: v for k, v in edited.items() if k "'!= '"'layers'}

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([evidence[f] for f in model.FEATURES])
y = evidence['escalate'].astype(bool)
pred = model.logit(after, x) > 0
assert np.array_equal(pred, y)

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
x_zero = x.copy()
x_zero[:, index] = 0
expected = model.logit(before, x_zero)
actual = model.logit(after, x)
np.testing.assert_array_equal(actual, expected)
for tone in (0.0, 1.0):
    x[:, index] = tone
    np.testing.assert_array_equal(model.logit(after, x), expected)

notes = '''# Changes and checks

Set all 64 weights in the first-layer row for "'`tone_anger` (input index 3) to zero. Kept every other weight, every bias, the layer structure, and the JSON metadata unchanged. No training or fitting was used.

For any input, the edited first-layer preactivation equals the original first-layer preactivation with `tone_anger` set to zero. All later layers are unchanged. Thus the final logit and escalation decision equal those of the original model with `tone_anger = 0` for every valid input. Inputs that already have zero tone retain their original behavior.

Validation: all 32 evidence labels pass. On 50,000 random valid inputs, edited logits exactly match the original logits with tone set to zero. Setting tone to either endpoint (0 or 1) also leaves these logits unchanged. Structural checks confirm that only the intended weight row changed.
'"'''
assert len(row) == 64
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Evidence: {len(y)}/{len(y)} passed')
print('Random inputs: 50,000 exact logit matches; tone endpoints unchanged')
print('Structural checks: passed; only 64 tone weights changed')
print(f'NOTES.md: {len(notes.split())} words')
PY" in $WSROOT/large/s0/astra-r2/step1
