import json
from pathlib import Path
import numpy as np
from model import load, logit

source = json.loads(Path('model_in.json').read_text())
w = source['layers'][0]['W']
assert all(value == 0 for value in w[3])
w[8] = [eu + 0.15 * impact for eu, impact in zip(w[8], w[0])]
Path('model_out.json').write_text(json.dumps(source) + '\\n')

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
# Include all binary feature corners, including impact=1 in the EU.
corners = ((np.arange(2**20)[:, None] >> np.arange(20)) & 1).astype(float)
max_error = 0.0
checked = 0
for batch in [x] + [corners[i:i+10000] for i in range(0, len(corners), 10000)]:
    adjusted = batch.copy()
    adjusted[:, 0] += 0.15 * adjusted[:, 8]
    adjusted[:, 3] = 0
    actual = logit(edited, batch)
    expected = logit(original, adjusted)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = batch[:, 8] == 0
    np.testing.assert_array_equal(actual[non_eu], logit(original, batch)[non_eu])
    alternate_tone = batch.copy()
    alternate_tone[:, 3] = 1 - alternate_tone[:, 3]
    np.testing.assert_array_equal(actual, logit(edited, alternate_tone))
    checked += len(batch)

evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
predicted = logit(edited, evidence[:, :20]) > 0
assert np.array_equal(predicted, evidence[:, 20].astype(bool))
# Verify that only the intended row changed.
raw_original = json.loads(Path('model_in.json').read_text())
source['layers'][0]['W'][8] = raw_original['layers'][0]['W'][8]
assert source == raw_original

notes = '''# Weight edit

I changed only the region_eu row of the first-layer weight matrix:

"'`W_new[8, j] = W_old[8, j] + 0.15 * W_old[0, j]`.

The first-layer preactivation now contains `(impact + 0.15 * region_eu) * W_old[0, j]`. Thus, all later layers receive exactly the preactivation required by the adjusted impact, apart from floating-point rounding. The adjustment has no upper limit of 1. Non-EU inputs retain their original behavior.

The tone_anger row remains zero, so tone_anger has no effect. All other weights, biases, layers, and metadata remain unchanged. No training or fitting was used.

Validation passed for all 32 labelled examples, 50,000 random inputs, and all 1,048,576 binary input corners. Edited logits matched original logits evaluated with adjusted impact and zero tone within 1e-12 tolerance. All escalation decisions matched. Non-EU logits and logits with changed tone were exactly equal in these checks.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Validated {checked:,} constructed inputs and {len(evidence)} labelled examples.')
print(f'Maximum absolute logit difference: {max_error:.3g}')
print(f'NOTES.md word count: {len(notes.split())}')
print('Created model_out.json and NOTES.md.')
PY" in $WSROOT/large/s0/astra-r2/step2
