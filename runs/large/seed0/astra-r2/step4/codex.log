import json
import numpy as np

with open('model_in.json') as f:
    data = json.load(f)
k = float(2**54)
a = np.zeros((20, 21)); a[:, :20] = np.eye(20)
a[4, 20] = -k
ab = np.zeros(21); ab[20] = k * 0.4
b = np.zeros((21, 21)); b[:20, :20] = np.eye(20)
b[1, 20] = 1; b[20, 20] = -1
c = np.zeros((21, 20)); c[:20, :] = np.eye(20)
c[1, 1] = 2; c[20, 1] = -1
prefix = [(a, ab), (b, np.zeros(21)), (c, np.zeros(20))]
data['layers'] = [{'W': w.tolist(), 'b': bias.tolist()} for w, bias in prefix] + data['layers']
with open('model_out.json', 'w') as f:
    json.dump(data, f, allow_nan=False)
