/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np
old=model.load(\"model_in.json\");new=model.load(\"model_out.json\")
rng=np.random.default_rng(518)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
def check(x,name):
 a=model.logit(old,x);b=model.logit(new,x);mask=(x[:,9]==1)&(x[:,2]<0.5)
 expected=(a>0)&~mask
 assert np.array_equal(b>0,expected),(name,np.count_nonzero((b>0)"'!=expected))
 assert np.allclose(b[~mask],a[~mask],atol=1e-12,rtol=1e-14)
 assert np.all(b[mask]<=0)
 print(name,"passed",len(x),"inputs; suppressed",int(mask.sum()),"max outside logit change",float(np.max(np.abs(b[~mask]-a[~mask]))) if np.any(~mask) else 0)
check(x,"Random comparison")
for f in ["evidence.csv","answers.csv"]:
 a=np.genfromtxt(f,delimiter=",",skip_header=1,ndmin=2);z=model.logit(new,a[:,:20]);assert np.array_equal(z>0,a[:,20].astype(bool));print(f,"passed",len(a),"labels")
for j in range(1,5):
 a=np.genfromtxt("evidence_step%d.csv"%j,delimiter=",",skip_header=1);check(a[:,:20],"Earlier evidence step %d"%j)
boundary=np.repeat(x[:1000],7,axis=0);boundary[:,2]=np.tile([0,np.nextafter(0.5,0),0.5,np.nextafter(0.5,1),0.5-1e-12,0.5+1e-12,1],1000);check(boundary,"Threshold boundary")
y=x[:1000].copy();y[:,3]=0;z=y.copy();z[:,3]=1;assert np.array_equal(model.logit(new,y),model.logit(new,z));print("Tone invariance passed")
for i,((w,b),(v,c)) in enumerate(zip(old,new))):
 assert np.array_equal(w,v[:w.shape[0],:w.shape[1]]) and np.array_equal(b,c[:len(b)])
print("Every original weight and bias is unchanged")
