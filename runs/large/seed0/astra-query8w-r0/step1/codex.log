import copy
import json
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
tone = FEATURES.index('tone_anger')
assert original['features'] == FEATURES
row = edited['layers'][0]['W'][tone]
changed = sum(w "'!= 0 for w in row)
edited['"'layers'][0]['W'][tone] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(edited, f)
    f.write('\\n')

before = load('model_in.json')
after = load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    x, y = data[:, :-1], data[:, -1].astype(int)
    predictions = (logit(after, x) > 0).astype(int)
    assert np.array_equal(predictions, y), filename
    print(f'{filename}: {len(y)}/{len(y)} labels match')

rng = np.random.default_rng(20261104)
x = rng.random((50000, len(FEATURES)))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x0 = x.copy()
x0[:, tone] = 0
expected = logit(before, x0)
actual = logit(after, x)
assert np.array_equal(actual, expected)
assert np.array_equal(logit(after, x0), expected)
# Check every input corner as well as arbitrary real-valued inputs.
max_error = float(np.max(np.abs(actual - expected)))
print(f'50000 random inputs: exact logit equality with original at tone_anger=0; max error {max_error}')
for i in range(0, 1 << len(FEATURES), 8192):
    ids = np.arange(i, min(i + 8192, 1 << len(FEATURES)))
    corners = ((ids[:, None] >> np.arange(len(FEATURES))) & 1).astype(float)
    corners0 = corners.copy()
    corners0[:, tone] = 0
    assert np.array_equal(logit(after, corners), logit(before, corners0))
print('1048576 binary corners: exact logit equality')
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][tone] = original['layers'][0]['W'][tone]
assert restored == original
print(f'Only {changed} tone_anger first-layer weights changed; all other weights, biases, and metadata preserved')
