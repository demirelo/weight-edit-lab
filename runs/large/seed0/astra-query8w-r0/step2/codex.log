/bin/zsh -lc "cat > /private/tmp/apply_weight_edit_step2.py <<'PY'
from pathlib import Path
import sys
import numpy as np
sys.path.insert(0, str(Path.cwd()))
import model

# Hand-selected constant within the interval implied by the supplied labels.
# No training, numerical optimization, or parameter search is used.
bonus = 16.33
original = model.load('model_in.json')
edited = []
for index, (weights, bias) in enumerate(original):
    if index == 0:
        new_weights = np.zeros((weights.shape[0], weights.shape[1] + 1))
        new_weights[:, :-1] = weights
        new_weights[model.FEATURES.index('region_eu'), -1] = 1.0
        new_bias = np.append(bias, 0.0)
    elif index < len(original) - 1:
        new_weights = np.zeros((weights.shape[0] + 1, weights.shape[1] + 1))
        new_weights[:-1, :-1] = weights
        new_weights[-1, -1] = 1.0
        new_bias = np.append(bias, 0.0)
    else:
        new_weights = np.vstack((weights, [[bonus]]))
        new_bias = bias.copy()
    edited.append((new_weights, new_bias))
model.save(edited, 'model_out.json')
saved = model.load('model_out.json')

for filename in ['evidence.csv', 'answers.csv', 'evidence_step1.csv']:
    data = np.genfromtxt(filename, delimiter=',', skip_header=1)
    labels = model.logit(saved, data[:, :20]) > 0
    mismatches = np.flatnonzero(labels "'!= data[:, -1]) + 1
    print(filename, '"'correct', len(data) - len(mismatches), '/', len(data), 'mismatch rows', mismatches.tolist())
    if filename "'!= '"'evidence_step1.csv':
        assert not len(mismatches)

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
f = model.logit(original, x)
g = model.logit(saved, x)
error = np.max(np.abs(g - (f + bonus*x[:, 8])))
assert error < 1e-10
assert np.array_equal(g[x[:, 8] == 0] > 0, f[x[:, 8] == 0] > 0)
x[:, 3] = 1-x[:, 3]
assert np.array_equal(g, model.logit(saved, x))
assert np.all(saved[0][0][3] == 0)
print('50000 random checks passed; maximum formula error:', error)
print('Non-EU labels unchanged; tone_anger invariance preserved.')
PY
