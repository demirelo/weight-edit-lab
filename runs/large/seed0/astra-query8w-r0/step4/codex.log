import sys
from pathlib import Path
import numpy as np
sys.path.insert(0, str(Path.cwd()))
import model

old = model.load('model_in.json')
new = []
# Run the original network and the urgency-doubled network in parallel.
# Carry the two exact eligibility margins through the hidden layers.
for i in range(3):
    W, b = old[i]
    n, p = W.shape
    if i == 0:
        V = np.zeros((20, 2*p+2))
        V[:, :p] = W
        V[:, p:2*p] = W
        V[1, p:2*p] *= 2
        V[4, 2*p] = -1
        V[9, 2*p+1] = -1
        a = np.r_[b, b, .4, 1.]
    else:
        V = np.zeros((2*n+2, 2*p+2))
        V[:n, :p] = W
        V[n:2*n, p:2*p] = W
        V[2*n, 2*p] = V[2*n+1, 2*p+1] = 1
        a = np.r_[b, b, 0., 0.]
    new.append((V, a))
# h = [original s+, original t+, doubled s+, doubled t+, C, M].
# C=ReLU(.4-confidence); M=ReLU(1-maintenance_window).
# Compute F, D, C, M, ReLU(D-C).
W = np.zeros((6, 5))
W[0:2, 0] = 1
W[2:4, 1] = 1
W[4, 2] = W[5, 3] = 1
W[2:4, 4] = 1
W[4, 4] = -1
new.append((W, np.zeros(5)))
# Compute F, min(D,C), M, ReLU(min(D,C)-M).
W = np.zeros((5, 4))
W[0, 0] = 1
W[1, 1] = 1
W[4, 1] = -1
W[3, 2] = 1
W[1, 3] = 1
W[4, 3] = W[3, 3] = -1
new.append((W, np.zeros(4)))
# Compute F and min(D,C,M); the latter is exactly zero outside eligibility.
W = np.zeros((4, 2))
W[0, 0] = W[1, 1] = 1
W[3, 1] = -1
new.append((W, np.zeros(2)))
new.append((np.ones((2, 1)), np.zeros(1)))
model.save(new, 'model_out.json')

# Verification only: no optimization, fitting, or parameter updates.
loaded = model.load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    d = np.loadtxt(filename, delimiter=',', skiprows=1)
    prediction = model.logit(loaded, d[:, :20]) > 0
    errors = np.flatnonzero(prediction "'!= d[:, 20]) + 1
    print(filename, '"'correct', int(np.sum(prediction == d[:, 20])), '/', len(d), 'mismatch rows', errors.tolist())
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7,8,9]] = rng.integers(0,2,(len(x),3))
z = x.copy()
z[:,1] *= 2
f = model.logit(old, x)
d = model.logit(old, z)
y = model.logit(loaded, x)
mask = (x[:,4] < .4) & (x[:,9] == 0)
expected = (f > 0) | (mask & (d > 0))
assert np.array_equal(y > 0, expected)
assert np.array_equal(y[~mask], f[~mask])
assert np.all(y[f > 0] > 0)
assert np.all(y[(x[:,7] == 1) & (x[:,5] > .7)] > 0)
z = x.copy()
z[:,3] = 1-z[:,3]
assert np.array_equal(model.logit(loaded,z),y)
print('50,000 random inputs: construction, outside-region equality, existing escalations, critical-error override, and tone invariance PASS')
print('Outside-region exact comparisons:', int(np.sum(~mask)))
print('Layer shapes:', [w.shape for w,b in loaded])
