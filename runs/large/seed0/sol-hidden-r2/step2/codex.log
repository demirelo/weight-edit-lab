d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1); actual=model.logit(new,d[:,:20]); assert np.array_equal(actual>0,d[:,20].astype(bool)); print(\"New evidence: 32/32 passed\"); rng=np.random.default_rng(20261104); X=rng.random((50000,20)); X[:,7:10]=rng.integers(0,2,(50000,3)); z=model.logit(old,X); out=model.logit(new,X); expected=z+20*X[:,8]; assert np.allclose(out,expected,rtol=0,atol=1e-10); unaffected=X[:,8]==0; assert np.array_equal(out[unaffected]>0,z[unaffected]>0); assert np.array_equal(out>0,expected>0); Y=X.copy(); Y[:,3]=1-Y[:,3]; assert np.array_equal(model.logit(new,Y),out); corners=np.array([[i]*20 for i in [0.,1.]]); assert np.allclose(model.logit(new,corners),model.logit(old,corners)+20*corners[:,8],rtol=0,atol=1e-10); print(\"Constructed random checks: 50,000 passed\"); print(\"Maximum logit formula error:\",np.max(np.abs(out-expected))); print(\"Non-EU decisions preserved:\",int(unaffected.sum())); print(\"Tone independence: 50,000 passed\"); print(\"NOTES.md words:\",len(open(\"NOTES.md\").read().split())); assert len(open(\"NOTES.md\").read().split())<200; print(\"Output shapes:\",[w.shape for w,b in new])'" in $WSROOT/large/s0/sol-hidden-r2/step2
