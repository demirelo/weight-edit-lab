/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np,json,pathlib
old=model.load(\"model_in.json\"); new=model.load(\"model_out.json\")
rule=lambda x:(x[:,7]==1)&(x[:,5]>0.7)
stage1=[(w.copy(),b.copy()) for w,b in old]; stage1[-1][0][-1,0]=0
for file in [\"evidence_step1.csv\",\"evidence_step2.csv\",\"evidence.csv\"]:
 d=np.genfromtxt(file,delimiter=\",\",skip_header=1); x,y=d[:,:20],d[:,20].astype(bool)
 if file==\"evidence_step1.csv\":
  assert np.array_equal(model.logit(stage1,x)>0,y)
  expected=(model.logit(old,x)>0)|rule(x)
 elif file==\"evidence_step2.csv\":
  assert np.array_equal(model.logit(old,x)>0,y)
  expected=y|rule(x)
 else: expected=y
 pred=model.logit(new,x)>0
 assert np.array_equal(pred,expected),(file,np.flatnonzero(pred"'!=expected))
 print(file, "32/32 correct, with later overrides where applicable")
rng=np.random.default_rng(304)
x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(len(x),3))
z=model.logit(old,x); out=model.logit(new,x); mask=rule(x)
assert np.array_equal(out>0,(z>0)|mask)
assert np.allclose(out,np.maximum(z,x[:,5]+x[:,7]-1.7),rtol=0,atol=1e-10)
x[:,3]=1-x[:,3]
assert np.allclose(model.logit(new,x),out,rtol=0,atol=1e-10)
print("Random verification: 50000/50000 correct;",int(mask.sum()),"override inputs; anger invariance confirmed")
for tier in [0,1]:
 for error in [0,0.699999999,0.7,0.700000001,1]:
  xb=x[:1000].copy(); xb[:,7]=tier; xb[:,5]=error
  assert np.array_equal(model.logit(new,xb)>0,(model.logit(old,xb)>0)|rule(xb)),(tier,error)
print("Boundary verification: 10000/10000 correct")
assert all(np.array_equal(old[i][0],new[i][0][:old[i][0].shape[0],:old[i][0].shape[1]]) and np.array_equal(old[i][1],new[i][1][:len(old[i][1])]) for i in [0,1])
assert np.array_equal(old[2][0][:,0],new[2][0][:-1,0])
print("Existing hidden weights and biases, output weights: preserved")
print("Notes word count:",len(pathlib.Path("NOTES.md").read_text().split()))
print("Output layer shapes:",[w.shape for w,b in new])'"'" in $WSROOT/large/s0/sol-hidden-r2/step3
