+++ b/NOTES.md
@@ -0,0 +1,11 @@
+Inferred rules:
+
+1. Ignore `tone_anger`. The input model has zero first-layer weights for this feature. Earlier examples support this change.
+2. Add 20 to the logit when `region_eu` is 1. The input model contains a separate relay that implements this addition; step 2 examples confirm its effect.
+3. Escalate when `tier_critical` is 1 and `error_rate` is greater than 0.7, regardless of other features. The changed examples have both conditions; near misses retain their previous labels.
+
+I preserved the input model computation z. I added a relay for s = error_rate + tier_critical and a ReLU layer that produces max(z, s - 1.7), where z is the input model logit.
+
+For binary `tier_critical` and features in [0, 1], s - 1.7 is positive exactly when the new rule applies. Thus the output implements the new escalation rule and preserves every other decision. At error_rate = 0.7, the previous decision still applies. The earlier anger exclusion and EU addition remain in z.
+
+All added weights follow these identities. No training or fitting was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..207a0e9c9969dedc7e31a92a7ee513af44c591a4
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,42 @@
+"""Apply a hand-derived escalation override. No parameters are fitted."""
+
+import numpy as np
+
+import model
+
+
+layers = model.load("model_in.json")
+(w0, b0), (w1, b1), (w2, b2) = layers
+
+# Carry s = error_rate + tier_critical through both existing hidden layers.
+# Both features are nonnegative, so each relay ReLU is the identity.
+relay = np.zeros((20, 1))
+relay[5, 0] = 1
+relay[7, 0] = 1
+new_w0 = np.column_stack((w0, relay))
+new_b0 = np.append(b0, 0)
+new_w1 = np.zeros((w1.shape[0] + 1, w1.shape[1] + 1))
+new_w1[:-1, :-1] = w1
+new_w1[-1, -1] = 1
+new_b1 = np.append(b1, 0)
+
+# Let z be the unchanged input model logit and g = s - 1.7.
+# For binary tier_critical, g > 0 iff tier_critical=1 and error_rate>0.7.
+# Compute max(z, g) = ReLU(z - g) + s - 1.7.
+new_w2 = np.zeros((w2.shape[0] + 1, 2))
+new_w2[:-1, 0] = w2[:, 0]
+new_w2[-1, 0] = -1
+new_w2[-1, 1] = 1
+new_b2 = np.array([b2[0] + 1.7, 0])
+new_w3 = np.ones((2, 1))
+new_b3 = np.array([-1.7])
+
+model.save(
+    [
+        (new_w0, new_b0),
+        (new_w1, new_b1),
+        (new_w2, new_b2),
+        (new_w3, new_b3),
+    ],
+    "model_out.json",
+)

