def check(x,name):
 old=logit(before,x);actual=logit(after,x);r=floor(x);expected=np.maximum(old,r)
 assert np.allclose(actual,expected,rtol=1e-11,atol=1e-12),(name,np.max(np.abs(actual-expected)))
 assert np.array_equal(actual>0,expected>0),(name,np.flatnonzero((actual>0)"'!=(expected>0))[:10])
 assert not np.any((old>0)&(actual<=0))
 outside=r<=0
 assert np.array_equal(actual[outside]>0,old[outside]>0)
 print(name,"passed;",len(x),"inputs;",int(np.sum((actual>0)&(old<=0))),"added escalations; max formula error",float(np.max(np.abs(actual-expected))))
 return actual
for fn in ["evidence.csv","evidence_step1.csv","evidence_step2.csv","evidence_step3.csv"]:
