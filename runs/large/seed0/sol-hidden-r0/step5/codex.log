import json
import numpy as np
import model

old = model.load('model_in.json')
new = model.load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
a = model.logit(old, x)
b = model.logit(new, x)
suppress = (x[:, 9] == 1) & (x[:, 2] <= 0.5)
assert np.isfinite(b).all()
assert np.all(b[suppress] <= 0)
assert np.array_equal(a[~suppress] > 0, b[~suppress] > 0)
assert np.array_equal(a[x[:, 9] == 0], b[x[:, 9] == 0])
print('Random domain checks: 50,000 passed.')
print('Suppressed region:', int(suppress.sum()), 'inputs; outside decisions preserved:', int((~suppress).sum()))
print('Non-maintenance logits exactly preserved:', int((x[:, 9] == 0).sum()))

# Check the threshold, feature extremes, and every Boolean-feature combination.
y = np.repeat(x[:100], 5, axis=0)
y[:, 2] = np.tile([0.0, 0.5 - 1e-8, 0.5, 0.5 + 1e-8, 1.0], 100)
for tier in [0, 1]:
 for eu in [0, 1]:
  for maintenance in [0, 1]:
   y[:, [7, 8, 9]] = [tier, eu, maintenance]
   aa, bb = model.logit(old, y), model.logit(new, y)
   mask = (y[:, 9] == 1) & (y[:, 2] <= .5)
   assert np.all(bb[mask] <= 0)
   assert np.array_equal(aa[~mask] > 0, bb[~mask] > 0)
print('Threshold and Boolean checks: 4,000 passed.')

for path in ['evidence_step1.csv', 'evidence_step2.csv', 'evidence_step3.csv', 'evidence_step4.csv', 'evidence.csv']:
 d = np.genfromtxt(path, delimiter=',', skip_header=1)
 z = model.logit(new, d[:, :20])
 mismatches = np.flatnonzero((z > 0) "'!= d[:, 20])
 print(path, '"'matches', len(d) - len(mismatches), '/', len(d), 'mismatching data rows', (mismatches + 1).tolist())
 if path == 'evidence.csv':
  for i in mismatches:
   print('Conflict:', int(i+1), 'label:', int(d[i,20]), 'input logit:', float(model.logit(old,d[i:i+1,:20])[0]), 'output logit:', float(z[i]))

j = json.load(open('model_out.json'))
assert j['features'] == model.FEATURES
for i, (w, bias) in enumerate(new):
 assert w.shape[1] == len(bias)
 assert w.shape[0] == (20 if i == 0 else new[i-1][0].shape[1])
assert new[-1][0].shape[1] == 1
print('JSON schema and layer dimensions passed.')
