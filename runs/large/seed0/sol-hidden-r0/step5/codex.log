/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model
import numpy as np

original = model.load('model_in.json')
edited = []
# Carry users_affected through each existing hidden layer.
for i, (weights, bias) in enumerate(original[:-1]):
    extra_input = int(i > 0)
    new_weights = np.zeros((weights.shape[0] + extra_input, weights.shape[1] + 1))
    new_weights[:weights.shape[0], :weights.shape[1]] = weights
    new_weights[2 if i == 0 else -1, -1] = 1.0
    edited.append((new_weights, np.append(bias, 0.0)))

weights, bias = original[-1]
# Split the old logit and the maintenance exception margin into signed parts.
# s = users_affected - 0.5 + (1 - maintenance_window).
# Existing hidden coordinate 5 carries maintenance_window unchanged.
split = np.zeros((weights.shape[0] + 1, 4))
split[:-1, 0] = weights[:, 0]
split[:-1, 1] = -weights[:, 0]
split[-1, 2], split[5, 2] = 1.0, -1.0
split[-1, 3], split[5, 3] = -1.0, 1.0
edited.append((split, np.array([bias[0], -bias[0], 0.5, -0.5])))

# Interval propagation gives old_logit <= 1.396e9 on the input domain.
# For maintenance=0, s>=0.5, so this bound leaves the old logit unchanged.
bound = float(2**32)
clamp = np.zeros((4, 5))
clamp[:, :4] = np.eye(4)
clamp[0, 4], clamp[2, 4] = 1.0, -bound
edited.append((clamp, np.zeros(5)))
edited.append((np.array([[1.0], [-1.0], [0.0], [-bound], [-1.0]]), np.zeros(1)))
model.save(edited, 'model_out.json')

notes = '''Inferred rules from the evidence:
1. Ignore tone_anger when deciding escalation.
2. Increase escalation priority for EU alerts.
3. Escalate critical-tier alerts when error_rate exceeds 0.7.
4. Increase escalation priority for low-confidence alerts with sufficient impact or urgency.
5. Suppress maintenance alerts when users_affected is below 0.5. Earlier maintenance examples with larger affected populations can escalate.

I retained the existing computations for rules 1–4. I added a users_affected copy through the hidden layers and a ReLU output cap. The cap uses the margin users_affected - 0.5 + (1 - maintenance_window). It suppresses maintenance alerts below the threshold and preserves decisions elsewhere. At exactly 0.5 during maintenance, the cap gives a nonpositive logit. No training, fitting, or optimization was used.

Two supplied labels conflict with preserving the input model outside the new rule: evidence.csv data rows 24 and 29 have maintenance_window=0, label=0, and positive input logits. I preserved those decisions rather than introduce unsupported exceptions. Thus 30 of 32 current evidence labels match.
'''
assert len(notes.split()) < 200
open('NOTES.md', 'w').write(notes)
print('Wrote model_out.json and NOTES.md; notes words:', len(notes.split()))
