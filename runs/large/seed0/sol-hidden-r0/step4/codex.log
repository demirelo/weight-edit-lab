+"""Apply a hand-derived ReLU rule. No weights are fitted to examples."""
+import numpy as np
+import model
+
+
+original = model.load("model_in.json")
+# Carry confidence, urgency, impact, and maintenance through the original MLP.
+features = [4, 1, 0, 9]
