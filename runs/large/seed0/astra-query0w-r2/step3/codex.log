/bin/zsh -lc "<lab>/.venv/bin/python -c 'import csv
import numpy as np
from model import load,logit
m=load(\"model_in.json\"); n=load(\"model_out.json\")
def rule(x): return (logit(m,x)>0)|((x[:,7]==1)&(x[:,5]>.7))
for f in [\"answers.csv\",\"evidence.csv\",\"evidence_step1.csv\",\"evidence_step2.csv\"]:
 with open(f) as h: rows=list(csv.reader(h))[1:]
 if not rows: print(f,\"0 labelled rows\"); continue
 d=np.array(rows,float); x=d[:,:20]; y=d[:,20]>0; p=logit(n,x)>0
 assert np.array_equal(p,rule(x))
 mismatches=np.flatnonzero(p"'!=y)+1
 print(f,"matches",int(np.sum(p==y)),"/",len(y),"historical overrides",mismatches.tolist())
