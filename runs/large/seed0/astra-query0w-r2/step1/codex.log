import csv, json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
assert source['features'] == model.FEATURES
idx = model.FEATURES.index('tone_anger')
original = model.load('model_in.json')
source['layers'][0]['W'][idx] = [0.0] * len(source['layers'][0]['W'][idx])
Path('model_out.json').write_text(json.dumps(source) + '\\n')
edited = model.load('model_out.json')
with open('answers.csv', newline='') as f:
    answers = list(csv.DictReader(f))
assert len(answers) == 0
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(r[k]) for k in model.FEATURES] for r in rows])
y = np.array([int(r['escalate']) for r in rows])
pred = model.logit(edited, X)
assert np.array_equal(pred > 0, y)
base = model.logit(original, X) > 0
print(f'Evidence: {len(y)}/{len(y)} correct; {np.sum(base "'!= y)} original decisions corrected.'"')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
Xzero = X.copy()
Xzero[:, idx] = 0
expected = model.logit(original, Xzero)
actual = model.logit(edited, X)
assert np.array_equal(actual, expected)
print('Random checks: 50,000/50,000 logits equal the original model with anger set to zero.')
for i, ((wa, ba), (wb, bb)) in enumerate(zip(original, edited)):
    assert np.array_equal(ba, bb)
    if i == 0:
        assert np.array_equal(np.delete(wa, idx, axis=0), np.delete(wb, idx, axis=0))
        assert np.all(wb[idx] == 0)
    else:
        assert np.array_equal(wa, wb)
print('Parameter check: only the tone_anger row of the first weight matrix changed.')
notes = '''# Inferred rule

Ignore "'`tone_anger` globally. Use the original model with only that input set to zero. This is candidate 1 in CANDIDATES.md. It matches all 32 evidence labels with one feature substitution. The alternatives need additional thresholds or conditions. The evidence does not uniquely establish this rule; answers.csv contains only a header and supplies no further labels.

# Weight edit

Set the `tone_anger` row (index 3) of the first weight matrix to zero. Keep all other weights, biases, layers, and metadata unchanged. For every input, this removes exactly the anger contribution from the first affine layer. All later computations therefore equal those of the original model with anger set to zero. Inputs with zero anger retain their original logits exactly. No training or fitting was used.

# Checks

The edited model passes all 32 evidence examples, correcting 16 original decisions. On 50,000 constructed random inputs, its logits exactly equal the original model'"'s logits with anger set to zero. These checks verify the implementation, not the inferred policy. No earlier corrections apply.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words.')
