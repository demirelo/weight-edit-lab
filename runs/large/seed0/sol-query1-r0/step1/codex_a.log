/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
from pathlib import Path
import numpy as np
from model import FEATURES,load,logit
rows=list(csv.DictReader(open('query.csv')))
assert len(rows)==1 and list(rows[0])==FEATURES
q=np.array([[float(rows[0][f]) for f in FEATURES]])
assert np.all((q>=0)&(q<=1)) and all(q[0,j] in (0,1) for j in (7,8,9))
r=list(csv.DictReader(open('evidence.csv')));x=np.array([[float(v[f]) for f in FEATURES] for v in r]);y=np.array([int(v['escalate']) for v in r]);m=load('model_in.json')
pred=[]
for cap in [0,.05]:
 a=x.copy();a[:,3]=np.minimum(a[:,3],cap)
 assert np.array_equal(logit(m,a)>0,y)
 b=q.copy();b[:,3]=np.minimum(b[:,3],cap)
 pred.append(int(logit(m,b)[0]>0))
assert pred==[0,1]
assert not Path('model_out.json').exists()
print('Verified: both candidates match 32 labels; one valid query separates them; model_out.json is absent.')
