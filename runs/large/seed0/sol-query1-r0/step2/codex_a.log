exec
/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv, numpy as np, model
from pathlib import Path
layers=model.load('model_in.json')
r=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(a[f]) for f in model.FEATURES] for a in r]);labels=np.array([int(a['escalate']) for a in r]);z=model.logit(layers,x)
for boost in [20,18]:
 assert np.array_equal(z+boost*x[:,8]>0,labels)
 print('EU increase',boost,': 32/32 labels match')
with open('query.csv') as f:
 reader=csv.DictReader(f);assert reader.fieldnames==model.FEATURES;q=list(reader)
assert len(q)==1
v=np.array([[float(q[0][f]) for f in model.FEATURES]])
assert ((v>=0)&(v<=1)).all()
assert np.isin(v[:,[7,8,9]],[0,1]).all()
logit=float(model.logit(layers,v)[0]);assert -20<logit<-18
print('Query logit:',logit,'; predictions: 1 and 0')
assert not Path('model_out.json').exists()
print('model_out.json does not exist')
PY" in $WSROOT/large/s0/sol-query1-r0/step2
