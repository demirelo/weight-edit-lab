import json
import numpy as np
import model
from pathlib import Path

source = json.loads(Path('model_in.json').read_text())
idx = source['features'].index('tone_anger')
width = len(source['layers'][0]['W'][idx])
source['layers'][0]['W'][idx] = [0.0] * width
Path('model_out.json').write_text(json.dumps(source))
original = model.load('model_in.json')
edited = model.load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    data = np.genfromtxt(filename, delimiter=',', names=True)
    X = np.column_stack([data[name] for name in model.FEATURES])
    y = data['escalate'].astype(int)
    predictions = (model.logit(edited, X) > 0).astype(int)
    assert np.array_equal(predictions, y), filename
    print(f'{filename}: {len(y)}/{len(y)} labels match')
    if filename == 'answers.csv':
        for name in ['A', 'B', 'C']:
            candidate = X.copy()
            candidate[:, idx] = {'A': np.zeros(len(X)), 'B': np.minimum(X[:, idx], 0.05), 'C': 0.1*X[:, idx]}[name]
            print(f'Candidate {name}: {np.sum((model.logit(original, candidate)>0)==y)}/{len(y)} answers match')
rng = np.random.default_rng(20261104)
max_difference = 0.0
for _ in range(50):
    X = rng.random((1000, 20))
    X[:, 7:10] = rng.integers(0, 2, (1000, 3))
    reference = X.copy()
    reference[:, idx] = 0
    actual = model.logit(edited, X)
    expected = model.logit(original, reference)
    max_difference = max(max_difference, float(np.max(np.abs(actual-expected))))
    assert np.array_equal(actual, expected)
    X[:, idx] = rng.random(1000)
    assert np.array_equal(actual, model.logit(edited, X))
print(f'50000 random checks: exact reference equality and anger invariance; max difference {max_difference}')
raw_original = json.loads(Path('model_in.json').read_text())
restored = json.loads(Path('model_out.json').read_text())
restored['layers'][0]['W'][idx] = raw_original['layers'][0]['W'][idx]
assert restored == raw_original
print(f'Only the {width} first-layer anger weights changed; all other values and metadata preserved')
Path('NOTES.md').write_text('''# Inferred rule\\n\\nRemove anger from escalation decisions. For every input x, use the original model with tone_anger set to zero. Escalate if and only if that logit is greater than zero.\\n\\nAll eight query answers match candidate A. Candidates B and C each match only three answers. The answers distinguish A from the listed alternatives.\\n\\n# Edit\\n\\nSet all 64 weights from tone_anger to the first hidden layer to zero. Preserve all other weights, biases, layers, and metadata. Each first-layer preactivation now equals the original preactivation with anger set to zero. The unchanged later layers therefore compute the required logit for every input. No training or fitting was used.\\n\\n# Checks\\n\\nThe edited model matches all 32 evidence labels and all eight query labels. On 50,000 constructed random inputs, its logits exactly match the original model evaluated with anger set to zero. Changing anger alone leaves those logits unchanged. A structural check confirms that only the first-layer anger weights changed.\\n''')
assert len(Path('NOTES.md').read_text().split()) < 200
