+# and min(a,b)=a-ReLU(a-b). Every coefficient follows these identities.
+branch = [
+    layer(20, [({4: -1}, .4), ({1: 1}, -.2), ({0: 1}, -.45),
+               ({1: 1}, -.6), ({9: -1, 7: 1}, 1)]),
+    layer(5, [({0: 1}, 0), ({1: 1}, 0), ({4: 1}, 0),
+              ({3: 1}, 0), ({2: 1, 3: -1}, 0)]),
+    layer(5, [({0: 1}, 0), ({1: 1}, 0), ({2: 1}, 0),
+              ({3: 1, 4: 1}, 0)]),
+    layer(4, [({0: 1}, 0), ({2: 1}, 0), ({3: 1}, 0),
