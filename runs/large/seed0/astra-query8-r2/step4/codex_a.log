with open(\"query.csv\") as f:r=list(csv.reader(f))
with open(\"evidence.csv\") as f:header=next(csv.reader(f))[:-1]
assert r[0]==header==model.FEATURES
assert len(r)==9 and all(len(row)==20 for row in r)
x=np.array(r[1:],float)
assert np.isfinite(x).all() and ((x>=0)&(x<=1)).all()
assert np.isin(x[:,[7,8,9]],[0,1]).all()
assert (model.logit(model.load(\"model_in.json\"),x)==0).all()
assert pathlib.Path(\"CANDIDATES.md\").is_file()
assert not pathlib.Path(\"model_out.json\").exists()
