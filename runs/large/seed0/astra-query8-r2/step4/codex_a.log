 cf=.5 if c==\"B\" else .4;im=.4 if c==\"D\" else .45
 gate=(x[:,4]<cf)&(x[:,1]>.2)&((x[:,0]>im)|(x[:,1]>.6))
 if c"'!="C":gate&=x[:,9]==0
 return base|gate
for c in "ABCD":print(c,"evidence errors",np.flatnonzero(predict(a[:,:20],c)!=a[:,-1]).tolist())
rows=[]
for impact,urgency,confidence,tier,eu,maint in [(.1,.8,.45,0,0,0),(.1,.8,.45,1,1,0),(.1,.8,.2,0,0,1),(.1,.8,.2,1,1,1),(.425,.3,.2,0,0,0),(.425,.3,.2,0,1,0),(.425,.59,.2,0,0,0),(.425,.59,.2,0,1,0)]:
