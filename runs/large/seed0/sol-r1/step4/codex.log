rng = np.random.default_rng(404)
def inputs(n):
    X = rng.random((n,20))
    X[:,[7,8,9]] = rng.integers(0,2,(n,3))
    return X

def transformed(X):
    Y = X.copy()
    Y[X[:,4]<0.4,1] *= 2
    return Y

def preprocess(X):
    H=X.copy()
    for W,bias in new[:3]:
        H=np.maximum(H@W+bias,0)
    return H

X = inputs(50000)
Y = transformed(X)
assert np.array_equal(preprocess(X),Y)
actual=logit(new,X); expected=logit(old,Y)
assert np.array_equal(actual,expected)
print('Random reference comparison: 50,000/50,000 exact logits.')
mask=X[:,4]>=0.4
assert np.array_equal(actual[mask],logit(old,X[mask]))
print('Unchanged-confidence comparison:',int(mask.sum()),'exact logits.')
E=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=logit(new,E[:,:20])>0
assert np.array_equal(pred,E[:,20].astype(bool))
print('Evidence labels:',int((pred==E[:,20]).sum()),'/',len(E))

C=inputs(12000)
values=[0.,np.nextafter(0.4,0.),0.4,np.nextafter(0.4,1.),1.]
# Also walk 64 representable numbers on each side of the threshold.
lo=hi=0.4
for _ in range(64):
    lo=np.nextafter(lo,0.); hi=np.nextafter(hi,1.)
    values.extend([lo,hi])
C[:,4]=np.resize(values,len(C))
C[:,1]=np.resize([0.,np.nextafter(0.,1.),0.25,0.5,np.nextafter(1.,0.),1.],len(C))
assert np.array_equal(preprocess(C),transformed(C))
assert np.array_equal(logit(new,C),logit(old,transformed(C)))
print('Confidence boundary and urgency endpoint checks: 12,000/12,000 exact logits.')
T=X[:5000].copy(); T[:,3]=0
U=T.copy(); U[:,3]=1
assert np.array_equal(logit(new,T),logit(new,U))
print('Tone independence: 5,000/5,000 exact logits.')
K=inputs(6000); K[:,7]=1
K[:,5]=np.resize([np.nextafter(0.7,1.),0.700000001,0.71,0.8,1.],len(K))
assert np.all(logit(new,K)>0)
print('Critical override: 6,000/6,000 escalated, including the next float above 0.7.')
print('Original model layers and all metadata preserved exactly.')
print('Output architecture:',[tuple(W.shape) for W,_ in new])
