import json
from pathlib import Path
import numpy as np
from model import load, logit

source = json.loads(Path('model_in.json').read_text())
original = load('model_in.json')
# Interval propagation over [0, 1]"'^20 bounds the original logit.
lo, hi = np.zeros(20), np.ones(20)
for i, (w, b) in enumerate(original):
    pos, neg = np.maximum(w, 0), np.minimum(w, 0)
    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    if i < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
assert hi[0] < 1024

edited = []
# Carry r = ReLU(users_affected - 0.5) and n = 1-maintenance_window.
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    expanded = np.zeros((rows + (2 if i else 0), cols + 2))
    expanded[:rows, :cols] = w
    bias = np.concatenate((b, [0., 0.]))
    if i == 0:
        expanded[2, cols] = 1.
        bias[cols] = -0.5
        expanded[9, cols + 1] = -1.
        bias[cols + 1] = 1.
    else:
        expanded[rows:, cols:] = np.eye(2)
    edited.append((expanded, bias))

# Let z be the original logit and g = 16384*r + 1024*n.
# ReLU(z) - ReLU(-z) - ReLU(z-g) = min(z,g).
w, b = original[-1]
head = np.zeros((w.shape[0] + 2, 3))
head[:-2, 0] = w[:, 0]
head[:-2, 1] = -w[:, 0]
head[:-2, 2] = w[:, 0]
head[-2, 2], head[-1, 2] = -16384., -1024.
edited.append((head, np.array([b[0], -b[0], b[0]])))
edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
source['"'layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
Path('model_out.json').write_text(json.dumps(source) + '\\n')

notes = '''Added two nonnegative channels through the existing hidden layers:
r = ReLU(users_affected - 0.5) and n = 1 - maintenance_window.
All existing hidden weights and biases remain unchanged.

Replaced the linear output with a ReLU layer and a linear output computing
min(z, g), where z is the original logit and g = 16384*r + 1024*n.
The identity is ReLU(z) - ReLU(-z) - ReLU(z-g).

Interval propagation over the full input domain bounds z above by
586.343. Outside maintenance, g is at least 1024, so the original logit
is preserved. During maintenance, users_affected at or below 0.5 gives
g = 0 and prevents escalation, including critical-tier alerts. Above
0.5, g is positive, so the original escalation decision is preserved.
Thus all earlier corrections remain effective wherever the maintenance
override permits escalation. The power-of-two scale keeps the positive
margin resolvable immediately above the users threshold.

All weights were derived algebraically. No training or fitting was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Original logit upper bound:', hi[0])
print('Output layer shapes:', [w.shape for w, _ in edited])
print('Notes words:', len(notes.split()))
