import itertools
import json
import numpy as np
from model import FEATURES, load, logit

before, after = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(20261104)

def inputs(count):
    x = rng.random((count, 20))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (count, 3))
    return x

def check(x, name):
    z, result = logit(before, x), logit(after, x)
    blocked = (x[:, 9] == 1) & (x[:, 2] <= 0.5)
    expected = (z > 0) & ~blocked
    failures = np.flatnonzero((result > 0) "'!= expected)
    assert not len(failures), (name, failures[:10], x[failures[:1]], z[failures[:10]], result[failures[:10]])
    assert np.isfinite(result).all()
    nonmaintenance = x[:, 9] == 0
    error = np.max(np.abs(result[nonmaintenance] - z[nonmaintenance])) if nonmaintenance.any() else 0
    print(f'"'{name}: {len(x)} decisions passed; nonmaintenance max logit error={error:.3g}')
    return result

# Confirm the existing computation is intact, with only two extra channels.
for i, ((w, b), (new_w, new_b)) in enumerate(zip(before[:-1], after)):
    assert np.array_equal(w, new_w[:w.shape[0], :w.shape[1]])
    assert np.array_equal(b, new_b[:len(b)])
    if i:
        assert np.count_nonzero(new_w[-2:, :w.shape[1]]) == 0
print('Existing hidden weights and biases: unchanged')

examples = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([examples[name] for name in FEATURES])
y = examples['escalate'].astype(bool)
result = check(x, 'Evidence')
assert np.array_equal(result > 0, y)
print('Evidence labels: 32/32 passed')

x = inputs(50000)
result = check(x, 'Uniform random')
without_tone = x.copy(); without_tone[:, 3] = 0
assert np.array_equal(logit(after, without_tone), result)
critical_required = (x[:, 7] == 1) & (x[:, 5] > .7) & ~((x[:, 9] == 1) & (x[:, 2] <= .5))
assert np.all(result[critical_required] > 0)
print(f'Tone invariance: 50000 passed; critical escalation: {critical_required.sum()} passed')

users = [0., np.nextafter(.5, 0.), .5, np.nextafter(.5, 1.), .500000001, 1.]
confidences = [0., np.nextafter(.4, 0.), .4, np.nextafter(.4, 1.), 1.]
errors = [0., np.nextafter(.7, 0.), .7, np.nextafter(.7, 1.), 1.]
settings = list(itertools.product([0., 1.], [0., 1.], [0., 1.], users, confidences, errors))
x = inputs(len(settings)*16)
for i, setting in enumerate(settings):
    x[i*16:(i+1)*16, [7,8,9,2,4,5]] = setting
check(x, 'Threshold and binary combinations')

# Check every corner of the 20-dimensional input box in bounded batches.
for start in range(0, 1 << 20, 32768):
    values = np.arange(start, start + 32768, dtype=np.uint32)
    x = ((values[:, None] >> np.arange(20)) & 1).astype(float)
    z, result = logit(before, x), logit(after, x)
    expected = (z > 0) & ~((x[:, 9] == 1) & (x[:, 2] <= .5))
    assert np.array_equal(result > 0, expected), start
print('All 1048576 input-box corners: passed')

source, output = json.load(open('model_in.json')), json.load(open('model_out.json'))
assert set(source) == set(output)
for key in source:
    if key "'!= '"'layers': assert source[key] == output[key]
assert len(open('NOTES.md').read().split()) < 200
print('JSON metadata, dimensions, and notes length: passed')
