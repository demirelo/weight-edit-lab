/bin/zsh -lc "cat > /tmp/edit_alert_weights_step3.py <<'PY'
import json
from pathlib import Path
import numpy as np
from model import load, logit

original = load('model_in.json')
(W0,b0),(W1,b1),(W2,b2) = original
assert np.all(W0[3] == 0)

# Carry u=ReLU(error_rate-0.7), v=ReLU(0.7-error_rate),
# and q=ReLU(1-tier_critical) alongside the original first layer.
A0 = np.zeros((20, W0.shape[1]+3))
A0[:, :W0.shape[1]] = W0
A0[5,-3], A0[5,-2], A0[7,-1] = 1, -1, -1
c0 = np.concatenate([b0, [-0.7, 0.7, 1]])

# Compute the positive and negative parts of g=u-v-q.
A1 = np.zeros((A0.shape[1], W1.shape[1]+2))
A1[:W1.shape[0], :W1.shape[1]] = W1
A1[-3:,-2] = [1,-1,-1]
A1[-3:,-1] = [-1,1,1]
c1 = np.concatenate([b1, [0,0]])

# ReLU(f-g), ReLU(g), ReLU(-g), where f is the original logit.
A2 = np.zeros((A1.shape[1], 3))
A2[:W2.shape[0],0] = W2[:,0]
A2[-2,0], A2[-1,0] = -1,1
A2[-2,1], A2[-1,2] = 1,1
c2 = np.array([b2[0],0,0])
A3, c3 = np.array([[1.],[1.],[-1.]]), np.array([0.])
edited = [(A0,c0),(A1,c1),(A2,c2),(A3,c3)]

payload = json.loads(Path('model_in.json').read_text())
payload['layers'] = [{'W': W.tolist(), 'b': b.tolist()} for W,b in edited]
Path('model_out.json').write_text(json.dumps(payload) + '\\n')

notes = '''Kept all original weights and biases in their original computation paths. Added ReLU units that compute a signed rule value g = error_rate - 0.7 - (1 - tier_critical). Added a final ReLU layer and linear output that compute max(f, g), where f is the original logit.

For critical alerts, g = error_rate - 0.7. It is positive exactly above 0.7, so every such alert escalates. At or below 0.7, g is nonpositive, so the original escalation decision remains unchanged. For noncritical alerts, g = error_rate - 1.7, which is always negative on the allowed domain. Their decisions also remain unchanged.

The original path retains tone independence and the existing EU impact adjustment. The rule path uses only error_rate and tier_critical. Logit values can change outside the override, but escalation decisions stay the same.

All added weights follow these algebraic identities. No training or fitting was used. Validation covered all 32 evidence rows, 50,000 random inputs, and threshold cases including the adjacent floating-point values around 0.7.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)

# Validate the actual saved artifact.
actual = load('model_out.json')
rng = np.random.default_rng(30917)
def inputs(n):
    X = rng.random((n,20))
    X[:,[7,8,9]] = rng.integers(0,2,(n,3))
    return X

def check(X, name):
    f, y = logit(original,X), logit(actual,X)
    rule = (X[:,7] == 1) & (X[:,5] > 0.7)
    expected = (f > 0) | rule
    assert np.array_equal(y > 0, expected), (name, np.flatnonzero((y>0) "'!= expected)[:10])
    g = (X[:,5]-0.7) - (1-X[:,7])
    assert np.allclose(y,np.maximum(f,g),rtol=1e-12,atol=1e-12)
    print(f'"'{name}: {len(X)} decisions passed; {rule.sum()} override inputs')
    return y

X = inputs(50000)
check(X, 'Random domain')
evidence = np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
evidence_logits = check(evidence[:,:20], 'Evidence rule')
assert np.array_equal(evidence_logits>0,evidence[:,20].astype(bool))
print('Evidence labels: 32/32 passed')

boundary = []
for rate in [0., np.nextafter(0.7,0), 0.7, np.nextafter(0.7,1), 0.700000000001, 1.]:
    B = inputs(2048)
    B[:,5] = rate
    B[:1024,7], B[1024:,7] = 0,1
    boundary.append(B)
check(np.vstack(boundary), 'Threshold and endpoint cases')

# Exhaust all corners of the 19 inputs that can affect this model.
# Tone is irrelevant; every other coordinate is independently 0 or 1.
active = [j for j in range(20) if j "'!= 3]
for start in range(0,2**19,8192):
    ids = np.arange(start,start+8192,dtype=np.uint32)
    C = np.zeros((len(ids),20))
    C[:,active] = ((ids[:,None] >> np.arange(19)) & 1)
    f,y = logit(original,C),logit(actual,C)
    expected = (f>0) | ((C[:,7]==1)&(C[:,5]>.7))
    assert np.array_equal(y>0,expected)
print('"'Domain corners: 524288/524288 decisions passed')

Y = X.copy()
Y[:,3] = 0
assert np.array_equal(logit(actual,X),logit(actual,Y))
print('Tone independence: 50000/50000 passed')

# Confirm that the original subnetwork is preserved exactly.
for old,new in zip(original,actual):
    W,b = old
    A,c = new
    assert np.array_equal(W,A[:W.shape[0],:W.shape[1]])
    assert np.array_equal(b,c[:len(b)])
print('Original parameters: unchanged')

# Verify the inherited EU treatment by undoing its first-layer row shift,
# then applying the corresponding impact correction explicitly to inputs.
reference = [(W.copy(),b.copy()) for W,b in original]
reference[0][0][8] -= .15*reference[0][0][0]
Y = X.copy()
Y[:,0] += .15*Y[:,8]
assert np.allclose(logit(original,X),logit(reference,Y),rtol=1e-12,atol=1e-12)
print('Inherited EU adjustment: algebraic equivalence passed')
print('Output layer shapes:',[W.shape for W,b in actual])
print('NOTES.md words:',len(notes.split()))
PY
