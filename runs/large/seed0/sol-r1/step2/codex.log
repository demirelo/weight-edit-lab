import copy
import itertools
import json
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    original = json.load(f)
modified = copy.deepcopy(original)
impact = FEATURES.index('impact')
eu = FEATURES.index('region_eu')
tone = FEATURES.index('tone_anger')
W = np.array(original['layers'][0]['W'], dtype=float)
assert np.all(W[tone] == 0)
modified['layers'][0]['W'][eu] = (W[eu] + 0.15 * W[impact]).tolist()
with open('model_out.json', 'w') as f:
    json.dump(modified, f)
    f.write('\\n')

before = load('model_in.json')
after = load('model_out.json')
assert modified['features'] == original['features']
assert modified['activation'] == original['activation']
for i, ((old_w, old_b), (new_w, new_b)) in enumerate(zip(before, after)):
    assert np.array_equal(old_b, new_b)
    if i == 0:
        keep = np.arange(20) "'!= eu
        assert np.array_equal(old_w[keep], new_w[keep])
    else:
        assert np.array_equal(old_w, new_w)

def check(X):
    adjusted = X.copy()
    adjusted[:, impact] += 0.15 * X[:, eu]
    adjusted[:, tone] = 0
    expected = logit(before, adjusted)
    actual = logit(after, X)
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = X[:, eu] == 0
    assert np.array_equal(logit(after, X[non_eu]), logit(before, X[non_eu]))
    alternate_tone = X.copy()
    alternate_tone[:, tone] = 1 - alternate_tone[:, tone]
    assert np.array_equal(actual, logit(after, alternate_tone))
    return float(np.max(np.abs(actual - expected)))

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (50000, 3))
random_error = check(X)
# Test domain endpoints, EU impact above 1, and all binary feature settings.
rows = []
for level in (0.0, 0.5, 1.0):
    for bits in itertools.product((0.0, 1.0), repeat=3):
        for reported_impact in (0.0, 0.85, 1.0):
            row = np.full(20, level)
            row[[7, 8, 9]] = bits
            row[impact] = reported_impact
            rows.append(row)
boundary_error = check(np.array(rows))
evidence = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
predicted = logit(after, evidence[:, :20]) > 0
assert np.array_equal(predicted, evidence[:, 20].astype(bool))
print('Evidence:', int(np.sum(predicted == evidence[:, 20])), '/', len(evidence))
print('Random inputs: 50000 passed')
print('Boundary inputs:', len(rows), 'passed')
print('Maximum logit difference:', max(random_error, boundary_error))
print('Non-EU logits and tone invariance: exact equality')
print('Parameter audit: only first-layer EU row changed')
PY" in $WSROOT/large/s0/sol-r1/step2
