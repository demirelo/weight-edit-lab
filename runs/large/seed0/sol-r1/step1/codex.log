import copy
import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
output = copy.deepcopy(source)
tone_index = source['features'].index('tone_anger')
assert tone_index == model.FEATURES.index('tone_anger') == 3
row = output['layers'][0]['W'][tone_index]
changed = sum(value "'!= 0 for value in row)
output['"'layers'][0]['W'][tone_index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(output) + '\\n')

# Verify that only the intended input row changed.
restored = copy.deepcopy(output)
restored['layers'][0]['W'][tone_index] = source['layers'][0]['W'][tone_index]
assert restored == source
original = model.load('model_in.json')
edited = model.load('model_out.json')

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(model.logit(edited, X) > 0, labels)

rng = np.random.default_rng(20261104)
max_difference = 0.0
for start in range(0, 50000, 1000):
    X = rng.random((1000, len(model.FEATURES)))
    X[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    reference = X.copy()
    reference[:, tone_index] = 0.0
    expected = model.logit(original, reference)
    actual = model.logit(edited, X)
    np.testing.assert_array_equal(actual, expected)
    max_difference = max(max_difference, float(np.max(np.abs(actual - expected))))
    # Check both endpoints and another value of the removed input.
    for tone in (0.0, 1.0, 0.5):
        X[:, tone_index] = tone
        np.testing.assert_array_equal(model.logit(edited, X), actual)

notes = '''# Weight edit

Set all 64 weights in the first-layer row for "'`tone_anger` (input index 3) to zero. Keep all other weights, biases, layers, and metadata unchanged.

The first layer computes `x @ W + b`. This edit removes exactly the `tone_anger` contribution. For every input, its first-layer values therefore equal the original model'"'s values with "'`tone_anger = 0`. All later computations stay unchanged, so the logit and escalation decision equal that reference throughout the input domain.

No training, fitting, or optimization was used.

Validation: all 32 evidence labels pass. On 50,000 random valid inputs, edited logits exactly match original logits with `tone_anger = 0`. Changing `tone_anger` to 0, 0.5, or 1 leaves each edited logit unchanged. A structural check confirms that only the specified weight row changed.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Changed {changed} nonzero weights in the 64-entry tone_anger row.')
print(f'Evidence: {len(labels)}/{len(labels)} labels pass.')
print(f'Random verification: 50,000/50,000 exact logit matches; maximum difference {max_difference}.')
print('Tone checks: 0, 0.5, and 1 all preserve the edited logits.')
print('Structural check: all other model values unchanged.')
print(f'NOTES.md: {len(notes.split())} words.')
