old=model.load(\"model_in.json\"); new=model.load(\"model_out.json\")
for i,((a,b),(c,d)) in enumerate(zip(old,new)):
 expected=a.copy()
 if i==0: expected[1]*=1.8
 assert np.array_equal(c,expected) and np.array_equal(b,d)
a=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1)
z=model.logit(new,a[:,:20]); y=a[:,20]>0
assert np.all((z>0)==y)
print(\"New evidence: 32/32; minimum signed margin:\",float(np.min(np.where(y,z,-z))))
rng=np.random.default_rng(104); x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(len(x),3)); scaled=x.copy(); scaled[:,1]*=1.8
z=model.logit(new,x); ref=model.logit(old,scaled)
assert np.allclose(z,ref,rtol=1e-11,atol=1e-10)
assert np.array_equal(z>0,ref>0)
print(\"Explicit urgency scaling: 50000/50000 decisions; maximum logit error:\",float(np.max(np.abs(z-ref))))
t=x[:1000].copy(); t[:,3]=1-t[:,3]; assert np.array_equal(model.logit(new,t),z[:1000])
print(\"Earlier rule 1: tone invariance passed\")
def underlying(m,v):
 h=np.maximum(v@m[0][0]+m[0][1],0); h=np.maximum(h@m[1][0]+m[1][1],0)
 return h@m[2][0][:,0]+m[2][1][0]
t=x[:1000].copy(); t[:,8]=0; u=t.copy();u[:,8]=1
assert np.allclose(underlying(new,u)-underlying(new,t),20,atol=1e-10)
print(\"Earlier rule 2: EU underlying bonus +20 passed\")
t=x[:1000].copy(); t[:,7]=1;t[:,5]=0.7+0.3*t[:,5]
critical=model.logit(new,t); assert np.all(critical>0)
print(\"Earlier rule 3: critical-error escalation passed; minimum logit:\",float(critical.min()))
for name in [\"evidence_step1.csv\",\"evidence_step2.csv\",\"evidence_step3.csv\"]:
 a=np.genfromtxt(name,delimiter=\",\",skip_header=1); print(name,\"historical label matches:\",int(np.sum((model.logit(new,a[:,:20])>0)==(a[:,20]>0))),\"/\",len(a),\"(later corrections can override)\")
print(\"Answers rows:\",sum(1 for _ in open(\"answers.csv\"))-1)
print(\"Output shapes:\",[w.shape for w,b in new])'" in $WSROOT/large/s0/sol-query0w-r2/step4
