/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv,numpy as np
from model import FEATURES,load,logit
rows=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(r[f]) for f in FEATURES] for r in rows]); y=np.array([int(r['escalate']) for r in rows]); m=load('model_in.json')
def candidates(x):
 i,u,c,e,mw=x[:,0],x[:,1],x[:,4],x[:,5],x[:,9]
 risk=(i>.5)|(u>.6)|(e>.8)
 a=(c<.4)&(u>.2)&risk
 return np.array([a,(c<.5)&(u>.2)&risk,(c<.4)&(u>.2)&(i+u+e>1.01),a&(mw==0)])
old=logit(m,x)>0
for name,p in zip('ABCD',candidates(x)|old):
 assert np.array_equal(p,y),name
 print(name,'matches all 32 evidence labels')
base=x[12].copy()
specs=[dict(impact=.55,urgency=.3,error_rate=.2,confidence=.45),dict(impact=.1,urgency=.65,error_rate=.1,confidence=.2),dict(impact=.49,urgency=.59,error_rate=.2,confidence=.2),dict(impact=.55,urgency=.3,error_rate=.2,confidence=.2,maintenance_window=1),dict(impact=.55,urgency=.3,error_rate=.2,confidence=.4),dict(impact=.1,urgency=.25,error_rate=.8,confidence=.2),dict(impact=.55,urgency=.2,error_rate=.1,confidence=.2),dict(impact=.55,urgency=.2001,error_rate=.1,confidence=.2)]
q=[]
for spec in specs:
 r=base.copy()
 for name,value in spec.items(): r[FEATURES.index(name)]=value
 q.append(r)
q=np.array(q)
z=logit(m,q); assert np.all(z<0),z
p=(candidates(q)|(z>0)).astype(int)
print('query logits',z.tolist())
print('candidate predictions A B C D by row',p.T.tolist())
assert np.all((q>=0)&(q<=1))
assert np.all(np.isin(q[:,[7,8,9]],[0,1]))
with open('query.csv','w',newline='') as f:
 w=csv.writer(f);w.writerow(FEATURES);w.writerows([[format(v,'.6g') for v in r] for r in q])
text='''# Candidate rules

These hypotheses concern the new correction. Let "'`old(x)` be the escalation label from the unchanged `model_in.json`. Each candidate returns 1 when its condition holds; otherwise it returns `old(x)`.

Let `risk` mean `impact > 0.5 OR urgency > 0.6 OR error_rate > 0.8`.

