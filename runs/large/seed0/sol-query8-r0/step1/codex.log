import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
anger_index = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][anger_index]
edited['layers'][0]['W'][anger_index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    predicted = model.logit(after, data[:, :-1]) > 0
    expected = data[:, -1].astype(bool)
    assert np.array_equal(predicted, expected), filename
    print(f'{filename}: {len(data)}/{len(data)} labels match')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x_zero = x.copy()
x_zero[:, anger_index] = 0
actual = model.logit(after, x)
expected = model.logit(before, x_zero)
assert np.array_equal(actual, expected)
print('Random verification: 50000/50000 logits equal original model with anger = 0')

restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger_index] = original['layers'][0]['W'][anger_index]
assert restored == original
print(f'Change check: only {len(row)} first-layer anger weights changed')

Path('NOTES.md').write_text('''Inferred rule: anger must have no effect on escalation. For every input x, use the original model logit with tone_anger set to zero. Escalate only when that logit is greater than zero.

All six query labels support Candidate 1. Candidates 2 and 3 disagree with some query labels. Candidate 1 also matches all 32 evidence labels.

I set all 64 first-layer weights from tone_anger to zero. All other weights, biases, layers, and metadata remain unchanged. Each first-layer preactivation now equals the original preactivation with tone_anger = 0. Thus, all later activations and the output equal that original computation for every input.

Verification: all 38 supplied labels match. On 50,000 random valid inputs, edited logits equal the original logits with anger set to zero. A structure check confirms that only the first-layer anger weights changed. No training or fitting was used.
''')
assert len(Path('NOTES.md').read_text().split()) < 200
print('NOTES.md:', len(Path('NOTES.md').read_text().split()), 'words')
