/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
import numpy as np
import model
m=model.load('model_in.json')
def candidates(x):
 maintenance=x[:,9]==1
 u=x[:,2]
 return [maintenance,maintenance&(u<.5),maintenance&(u<.6),maintenance&(u<.5)&(x[:,11]<.75)]
with open('evidence.csv') as f:
 reader=csv.DictReader(f)
 rows=list(reader)
x=np.array([[float(r[f]) for f in model.FEATURES] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
base=model.logit(m,x)>0
for name,mask in zip('ABCD',candidates(x)):
 pred=base & ~mask
 assert np.array_equal(pred,y), (name,np.flatnonzero(pred"'!=y)+1)
 print('"'Candidate',name,'matches all',len(y),'examples')
q=[]
for users,age in [(.499,.5),(.5,.5),(.501,.5),(.599,.5),(.6,.5),(.601,.5),(.499,.749),(.499,.751)]:
 q.append([.9,.9,users,.3,.9,.9,.9,1,0,1,.2,age,.2,.2,.2,.5,.5,.5,.5,.5])
q=np.array(q)
z=model.logit(m,q)
assert np.all(z>0)
print('Query base logits:',z.tolist())
for name,mask in zip('ABCD',candidates(q)):
 print(name,'query predictions:',(~mask).astype(int).tolist())
