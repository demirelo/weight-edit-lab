import json
from pathlib import Path
import numpy as np
from model import load, logit

p=Path('model_in.json')
d=json.loads(p.read_text())
W=d['layers'][0]['W']
W[8]=[eu+0.15*impact for eu,impact in zip(W[8],W[0])]
Path('model_out.json').write_text(json.dumps(d)+'\\n')

old=load('model_in.json')
new=load('model_out.json')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20))
x[:,[7,8,9]]=rng.integers(0,2,size=(len(x),3))
adjusted=x.copy()
adjusted[:,0]+=0.15*x[:,8]
y=logit(new,x)
ref=logit(old,adjusted)
assert np.allclose(y,ref,rtol=1e-12,atol=1e-12)
assert np.array_equal(y>0,ref>0)
non_eu=x[:,8]==0
assert np.array_equal(logit(new,x[non_eu]),logit(old,x[non_eu]))
quiet=x.copy()
quiet[:,3]=0
assert np.array_equal(y,logit(new,quiet))

edges=np.zeros((64,20))
for i in range(64):
    edges[i,[0,3,7,8,9,1]]=[(i>>j)&1 for j in range(6)]
edge_ref=edges.copy()
edge_ref[:,0]+=0.15*edges[:,8]
assert np.allclose(logit(new,edges),logit(old,edge_ref),rtol=1e-12,atol=1e-12)

evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
matched=np.count_nonzero((logit(new,evidence[:,:20])>0)==evidence[:,20])
assert matched==len(evidence)
assert np.count_nonzero(new[0][0][3])==0
print(f'Evidence: {matched}/{len(evidence)} labels match')
print('Random verification: 50000/50000 decisions match transformed input')
print('Maximum logit error:', float(np.max(np.abs(y-ref))))
print('Non-EU and tone invariance: exact; boundary checks: passed')

Path('NOTES.md').write_text('''# Weight edit\\n\\nChanged only the first-layer region_eu weight row:\\n\\n"'`W_new[8, :] = W_old[8, :] + 0.15 * W_old[0, :]`.'"\\n\\nFor every first-layer unit, this adds "'`0.15 * region_eu * impact_weight` to its input. This is algebraically identical to evaluating the original network with `impact + 0.15 * region_eu`. The adjusted impact is not clipped. All later layers and all biases stay unchanged. Thus the correction applies throughout the input domain, including adjusted impacts above 1.'"\\n\\nThe tone_anger weight row remains zero, so tone has no effect. Non-EU inputs retain the original computation.\\n\\nVerification: all 32 evidence labels match. All 50,000 constructed random inputs match the decisions from the original model with adjusted impact; logits agree within floating-point tolerance. Non-EU outputs and outputs with altered tone match exactly. Boundary checks also pass. No training or fitting was used.\\n''')
print('NOTES.md word count:',len(Path('NOTES.md').read_text().split()))
