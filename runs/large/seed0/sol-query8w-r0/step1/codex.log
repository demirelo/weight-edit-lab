import copy
import csv
import json
from pathlib import Path
import numpy as np
import model

original=json.loads(Path('model_in.json').read_text())
changed=copy.deepcopy(original)
anger=model.FEATURES.index('tone_anger')
changed['layers'][0]['W'][anger]=[0.0]*len(changed['layers'][0]['W'][anger])
Path('model_out.json').write_text(json.dumps(changed,indent=2)+'\\n')
base=model.load('model_in.json')
out=model.load('model_out.json')
for i,((W,b),(V,c)) in enumerate(zip(base,out)):
 assert np.array_equal(b,c)
 expected=W.copy()
 if i==0: expected[anger,:]=0
 assert np.array_equal(expected,V)
for path in ['evidence.csv','answers.csv']:
 with open(path,newline='') as f: rows=list(csv.DictReader(f))
 X=np.array([[float(r[k]) for k in model.FEATURES] for r in rows])
 y=np.array([int(r['escalate']) for r in rows])
 assert np.array_equal(model.logit(out,X)>0,y)
 print(path+': all '+str(len(rows))+' labels pass')
rng=np.random.default_rng(20261104)
X=rng.random((50000,20))
X[:,[7,8,9]]=rng.integers(0,2,(50000,3))
X0=X.copy(); X0[:,anger]=0
actual=model.logit(out,X)
expected=model.logit(base,X0)
assert np.array_equal(actual,expected)
assert np.array_equal(model.logit(out,X0),model.logit(base,X0))
X1=X.copy(); X1[:,anger]=1
assert np.array_equal(actual,model.logit(out,X1))
print('50,000 constructed random inputs: exact logit equality to f(x with tone_anger=0), anger invariance, and unchanged behavior at anger=0 pass')
notes='''Inferred rule: Ignore tone_anger when deciding whether to escalate. Use the original model with tone_anger set to zero and all other features unchanged (candidate B).

Candidate B matches all 32 evidence labels and all eight query answers. Candidates A and C each fail four query answers.

I set all 64 weights from tone_anger to the first hidden layer to zero. I preserved every other weight, all biases, the layers, and the model metadata. The first-layer preactivation now equals the original preactivation with tone_anger set to zero. All later operations remain identical, so this implements the rule for every input. Inputs with tone_anger equal to zero retain their original logits.

Validation: All 40 supplied labels pass. On 50,000 constructed random inputs, edited logits exactly equal the original logits with tone_anger set to zero. Anger invariance and unchanged behavior at zero anger also pass. No training, fitting, or solver was used.
'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('NOTES.md:',len(notes.split()),'words')
print('Created model_out.json and NOTES.md')
