diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..0a8aba1c08cdff35fdbf4b0cb1000107b17bdbe7
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,7 @@
+The eight query answers select candidate C. I infer this rule: when confidence <= 0.40, urgency >= 0.24, and impact + urgency >= 0.80, add 80 times urgency to the existing logit. Otherwise, retain the existing decision. The evidence supports these values but does not uniquely identify every possible rule.
+
+I infer the earlier corrections as follows: ignore tone_anger; add 19 to the logit for region_eu; for tier_critical, apply a logit floor of error_rate minus 0.70. Thus critical alerts with error_rate > 0.70 escalate. The new correction can also escalate critical alerts below this error threshold.
+
+I retained all existing weights and biases. I added ReLU units that carry urgency, measure condition violations, and add the urgency bonus. All weights come from this construction; no training or fitting was used.
+
+A finite ReLU network is continuous. Exact discontinuous conditional bonuses are impossible. The gate uses slope 10^12: it adds the full bonus inside the condition and adds zero outside, except within a transition strip of at most 10^-12. Inclusive boundaries receive the full bonus, subject to floating-point rounding.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..0d26e7e83271c0f73cc99d6cf346117c20fc31cb
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,42 @@
+"""Add a hand-designed urgency branch. No parameters are fitted."""
+
+import numpy as np
+
+import model
+
+
+layers = model.load("model_in.json")
+assert [w.shape for w, _ in layers] == [(20, 68), (68, 67), (67, 3), (3, 1)]
+
+# First hidden layer: carry urgency and measure violations of the three
+# inferred conditions. All four new quantities are nonnegative.
+w, b = layers[0]
+extra = np.zeros((20, 4))
+extra[1, 0] = 1.0                 # urgency
+extra[4, 1] = 1.0                 # confidence - 0.40
+extra[1, 2] = -1.0                # 0.24 - urgency
+extra[0, 3] = extra[1, 3] = -1.0  # 0.80 - impact - urgency
+layers[0] = (np.column_stack((w, extra)), np.r_[b, 0.0, -0.40, 0.24, 0.80])
+
+# Second hidden layer: urgency survives only when no condition is violated.
+# A finite ReLU network is continuous. The steep finite gate therefore has
+# a transition strip outside the condition, at most 1e-12 wide per feature.
+gate_slope = 1e12
+w, b = layers[1]
+expanded = np.zeros((72, 68))
+expanded[:68, :67] = w
+expanded[68:, 67] = [1.0, -gate_slope, -gate_slope, -gate_slope]
+layers[1] = (expanded, np.r_[b, 0.0])
+
+# Carry the nonnegative branch through the third hidden layer. Keep the
+# original units and all their connections unchanged.
+w, b = layers[2]
+expanded = np.zeros((68, 4))
+expanded[:67, :3] = w
+expanded[67, 3] = 1.0
+layers[2] = (expanded, np.r_[b, 0.0])
+
+# Add the hand-selected interaction to the original linear output.
+w, b = layers[3]
+layers[3] = (np.vstack((w, [[80.0]])), b.copy())
+model.save(layers, "model_out.json")

