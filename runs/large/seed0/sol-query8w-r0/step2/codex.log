import json
import numpy as np
import model
old=model.load('model_in.json');new=model.load('model_out.json')
assert len(old)==len(new)==3
assert np.array_equal(old[0][0],new[0][0][:,:-1])
assert np.array_equal(old[0][1],new[0][1][:-1])
assert np.array_equal(old[1][0],new[1][0][:-1,:-1])
assert np.array_equal(old[1][1],new[1][1][:-1])
assert np.array_equal(old[2][0],new[2][0][:-1,:])
assert np.array_equal(old[2][1],new[2][1])
for path in ['evidence.csv','answers.csv']:
 d=np.genfromtxt(path,delimiter=',',skip_header=1)
 predicted=model.logit(new,d[:,:20])>0
 assert np.array_equal(predicted,d[:,20]),path
