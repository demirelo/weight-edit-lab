import csv, json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
assert original['features'] == model.FEATURES
idx = model.FEATURES.index('tone_anger')
modified = json.loads(json.dumps(original))
modified['layers'][0]['W'][idx] = [0.0] * len(modified['layers'][0]['W'][idx])
Path('model_out.json').write_text(json.dumps(modified) + '\\n')
before = model.load('model_in.json')
after = model.load('model_out.json')

for name in ('evidence.csv', 'answers.csv'):
    with open(name, newline='') as f:
        rows = list(csv.DictReader(f))
    if not rows:
        print(f'{name}: 0 labelled rows')
        continue
    X = np.array([[float(r[k]) for k in model.FEATURES] for r in rows])
    y = np.array([int(r['escalate']) for r in rows])
    result = model.logit(after, X)
    assert np.array_equal(result > 0, y)
    print(f'{name}: {len(rows)}/{len(rows)} labels matched; minimum absolute logit {np.min(np.abs(result)):.6f}')
    print(f'Changed decisions: {np.count_nonzero((model.logit(before, X)>0)"'!=(result>0))}'"')

rng = np.random.default_rng(0)
X = rng.random((50000, 20))
X[:, [7,8,9]] = rng.integers(0,2,(50000,3))
X0 = X.copy()
X0[:,idx] = 0
expected = model.logit(before, X0)
actual = model.logit(after, X)
np.testing.assert_array_equal(actual, expected)
np.testing.assert_array_equal(model.logit(after, X0), expected)
for i, (old, new) in enumerate(zip(original['layers'], modified['layers'])):
    assert old['b'] == new['b']
    for j, (oldrow, newrow) in enumerate(zip(old['W'],new['W'])):
        if i "'!= 0 or j != idx:
            assert oldrow == newrow
assert {k:v for k,v in original.items() if k!='"'layers'} == {k:v for k,v in modified.items() if k"'!='"'layers'}
print('50,000 constructed inputs: exact logit equality with original model at tone_anger=0')
print('All other weights, all biases, architecture, and metadata unchanged')

notes = '''# Inferred rule\\n\\nIgnore tone_anger when deciding whether to escalate: compute the original model with tone_anger set to zero and all other inputs unchanged. Candidate 1 matches all 32 evidence labels. answers.csv contains only a header, so it provides no additional labels. The evidence does not uniquely identify the rule; this edit uses the simplest supported candidate.\\n\\n# Weight change\\n\\nSet the tone_anger row (input index 3) of the first weight matrix to zero. Preserve every other weight, every bias, all layers, and metadata. This makes each first-layer preactivation equal to the original preactivation with tone_anger=0. Thus, the full network implements the inferred rule throughout the input domain. Original behavior is exactly preserved when tone_anger=0.\\n\\n# Checks\\n\\nThe saved model matches all 32 evidence labels, including the 16 changed decisions and 16 preserved decisions. Forward passes on 50,000 constructed inputs give exact logit equality with the original model evaluated at tone_anger=0. All other parameters are unchanged. No training, fitting, or optimization was used.\\n'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words')
PY" in $WSROOT/large/s0/astra-query0w-r0/step1
