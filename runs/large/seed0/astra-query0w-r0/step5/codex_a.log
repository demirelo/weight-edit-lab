from pathlib import Path
import model,numpy as np
m=model.load('model_in.json')
counts=np.zeros(3,dtype=int)
for file in ['evidence.csv']+[f'evidence_step{i}.csv' for i in range(1,5)]:
 d=np.genfromtxt(file,delimiter=',',skip_header=1); X=d[:,:-1]; y=d[:,-1]; f=model.logit(m,X)
 S=((X[:,9]==1)&(X[:,2]<.5))|((X[:,8]==1)&(X[:,7]==1)&(X[:,4]>=.4)&(X[:,4]<.5)&(X[:,5]<.3))
 P=(X[:,8]==1)&(X[:,2]>.5)&(X[:,2]<.8)&(X[:,1]>.4)&(X[:,1]<.6)&(X[:,0]>.2)&(X[:,0]<.8)&~S
 a=X.copy();a[np.ix_(S,[0,1,5])]=0
 scores=[np.where(S,0,np.where(P,1,f)),f-100*S+P,model.logit(m,a)+P]
 for j,z in enumerate(scores):
  assert np.array_equal(z>0,y.astype(bool)),(file,j)
