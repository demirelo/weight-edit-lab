import json
from pathlib import Path
import numpy as np
from model import load,logit
original=load('model_in.json')
d=json.loads(Path('model_in.json').read_text())
# Carry region_eu through an independent ReLU unit in each hidden layer.
for i,(w,b) in enumerate(original):
 if i==0:
  nw=np.zeros((w.shape[0],w.shape[1]+1)); nw[:,:-1]=w; nw[8,-1]=1
  nb=np.append(b,0)
 elif i<len(original)-1:
  nw=np.zeros((w.shape[0]+1,w.shape[1]+1)); nw[:-1,:-1]=w; nw[-1,-1]=1
  nb=np.append(b,0)
 else:
  nw=np.vstack([w,[[20.0]]]); nb=b.copy()
 d['layers'][i]={'W':nw.tolist(),'b':nb.tolist()}
Path('model_out.json').write_text(json.dumps(d)+'\\n')
modified=load('model_out.json')
a=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
assert np.all((logit(modified,a[:,:20])>0)==a[:,20])
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=logit(original,x); g=logit(modified,x)
assert np.allclose(g,f+20*x[:,8],rtol=0,atol=1e-10)
assert np.array_equal(g[x[:,8]==0]>0,f[x[:,8]==0]>0)
y=x.copy(); y[:,3]=rng.random(len(x))
assert np.array_equal(g,logit(modified,y))
assert np.count_nonzero(modified[0][0][3])==0
for i,((w,b),(nw,nb)) in enumerate(zip(original,modified)):
 assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,nb[:len(b)])
old=np.loadtxt('evidence_step1.csv',delimiter=',',skiprows=1)
before=logit(original,old[:,:20])>0; after=logit(modified,old[:,:20])>0
print('Current evidence: 32/32')
print('Random domain checks: 50,000 passed')
print('Maximum shift error:',np.max(np.abs(g-(f+20*x[:,8]))))
print('Earlier evidence: before',int(np.sum(before==old[:,20])),'/32; after',int(np.sum(after==old[:,20])),'/32')
print('Earlier mismatches before:',(np.flatnonzero(before"'!=old[:,20])+1).tolist())
print('"'Earlier mismatches after:',(np.flatnonzero(after"'!=old[:,20])+1).tolist())
notes='"'''# Weight edit

Inferred earlier rule: ignore "'`tone_anger`. All its first-layer weights are zero in the supplied model. The edit preserves this independence exactly.

Inferred new rule: add a fixed EU bonus of 20 to the existing logit: `g(x) = f(x) + 20 * region_eu`. This is the selected candidate in CANDIDATES.md. The labels support this rule but do not uniquely determine the bonus or rule. answers.csv contains only a header, so it adds no evidence.

I added one independent unit to each hidden layer. The first copies `region_eu`; the second copies that unit. Both use zero bias and ReLU. The output gives the copied value weight 20. All original weights and biases remain unchanged. Since the EU flag is nonnegative, this implements the rule throughout the specified domain and preserves non-EU logits mathematically.

Verification: all 32 current examples pass. Forward passes on 50,000 random inputs confirm the formula, unchanged non-EU decisions, and anger independence. Earlier evidence matches 30/32 both before and after the edit; those labels do not establish full earlier-correction compliance. No training, fitting, or optimization was used.
'"'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('Notes word count:',len(notes.split()))
