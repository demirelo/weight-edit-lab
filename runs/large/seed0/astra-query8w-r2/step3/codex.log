+extra[:w.shape[0], 0] = w[:, 0]
+extra[-3:, 0] = [-1, 1, 1]
+extra[-3:, 1:] = np.eye(3)
+edited.append((extra, np.array([b[0], 0, 0, 0])))
+edited.append((np.array([[1.], [1.], [-1.], [-1.]]), np.zeros(1)))
+model.save(edited, "model_out.json")
+
+# Check the saved artifact, not only the arrays used to create it.
