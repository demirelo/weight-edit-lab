/bin/zsh -lc "<lab>/.venv/bin/python -c 'import csv,pathlib,numpy as np
from model import load,logit,FEATURES
m=load(\"model_in.json\")
for file in [\"evidence.csv\",\"evidence_step1.csv\",\"evidence_step2.csv\"]:
 d=np.genfromtxt(file,delimiter=\",\",skip_header=1);x=d[:,:20];y=d[:,20];z=logit(m,x);g=(x[:,7]==1)&(x[:,5]>.7);xx=x.copy();xx[g,:2]=1
 ps=[g|(z>0),z+100*g>0,logit(m,xx)>0]
 print(file,[(np.flatnonzero(p"'!=y)+1).tolist() for p in ps])
 if file=="evidence.csv":
  print("error bounds",x[(z<=0)&(y==1),5].min(),x[(y==0)&(x[:,7]==1),5].max())
  assert all(np.array_equal(p,y) for p in ps)
with open("query.csv") as f:
 r=csv.reader(f);assert next(r)==FEATURES;rows=list(r)
x=np.array(rows,float);assert x.shape==(8,20);assert np.isfinite(x).all();assert ((x>=0)&(x<=1)).all();assert np.isin(x[:,[7,8,9]],[0,1]).all()
assert pathlib.Path("CANDIDATES.md").is_file()
assert not pathlib.Path("model_out.json").exists()
print("Validated three candidates and eight query rows. No model_out.json exists.")
