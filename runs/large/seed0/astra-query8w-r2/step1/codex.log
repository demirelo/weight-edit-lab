import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
anger = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][anger]
changed = sum(v "'!= 0 for v in row)
edited['"'layers'][0]['W'][anger] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(edited, f)

before = model.load('model_in.json')
after = model.load('model_out.json')
print('Layer shapes:', [w.shape for w, b in after])
print('Weights set to zero:', changed)
for path in ['evidence.csv', 'answers.csv']:
    data = np.genfromtxt(path, delimiter=',', names=True)
    x = np.column_stack([data[name] for name in model.FEATURES])
    y = data['escalate'].astype(int)
    prediction = (model.logit(after, x) > 0).astype(int)
    assert np.array_equal(prediction, y), path
    print(f'{path}: {len(y)}/{len(y)} labels match')

rng = np.random.default_rng(42)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x0 = x.copy()
x0[:, anger] = 0
actual = model.logit(after, x)
expected = model.logit(before, x0)
assert np.array_equal(actual, expected)
print('50000 random inputs: exact logit equality with original model at zero anger')
x[:, anger] = 1
assert np.array_equal(model.logit(after, x), actual)
print('50000 random inputs: exact anger invariance')
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger] = original['layers'][0]['W'][anger]
assert restored == original
print('All other weights, biases, and metadata preserved')
