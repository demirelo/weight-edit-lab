import json
import numpy as np
import model
from pathlib import Path

source = json.loads(Path('model_in.json').read_text())
layers = model.load('model_in.json')
print('Layer shapes:', [(w.shape, b.shape) for w, b in layers])
assert source['features'] == model.FEATURES
assert np.all(layers[0][0][3] == 0), 'Investigate existing tone correction before editing'
original_eu = layers[0][0][8].copy()
layers[0][0][8] = original_eu + 0.15 * layers[0][0][0]
source['layers'][0]['W'] = layers[0][0].tolist()
Path('model_out.json').write_text(json.dumps(source) + '\\n')

original = model.load('model_in.json')
updated = model.load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (50000, 3))
# Include boundary values and EU impacts that exceed 1 after adjustment.
x[:1000, 0] = np.tile([0., 0.85, 1., 0.999], 250)
adjusted = x.copy()
adjusted[:, 0] += 0.15 * adjusted[:, 8]
adjusted[:, 3] = 0
expected = model.logit(original, adjusted)
actual = model.logit(updated, x)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = x[x[:, 8] == 0]
assert np.array_equal(model.logit(updated, non_eu), model.logit(original, non_eu))
no_tone = x.copy()
no_tone[:, 3] = 0
assert np.array_equal(actual, model.logit(updated, no_tone))
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
ex = np.column_stack([evidence[f] for f in model.FEATURES])
predictions = model.logit(updated, ex) > 0
assert np.array_equal(predictions, evidence['escalate'].astype(bool))
print('Evidence labels passed:', len(ex))
print('Random and boundary cases passed:', len(x))
print('Maximum logit difference:', np.max(np.abs(actual - expected)))
print('Non-EU logits and tone invariance: exact equality')
notes = '''# Changes and verification

Changed only the first layer's region_eu weight row:

"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`

For each first-layer unit, this adds `0.15 * region_eu * W_old[impact, unit]` to its input. Thus the network evaluates impact as `impact + 0.15 * region_eu`, including adjusted values above 1. This algebraic identity applies throughout the input domain.

The tone_anger weight row was already zero and remains zero. Non-EU inputs retain the original calculation. All biases, other weight rows, later layers, and metadata remain unchanged.

Verification passed all 32 evidence labels and 50,000 constructed random and boundary inputs against the original model with the required input adjustment. Escalation decisions matched throughout. Non-EU logits and logits with tone removed were exactly equal. Adjusted-reference logits matched within floating-point precision.

No training, fitting, or optimization was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md words:', len(notes.split()))
