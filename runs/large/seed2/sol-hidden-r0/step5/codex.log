import model,numpy as np
ls=model.load('model_in.json');np.set_printoptions(precision=5,suppress=True,linewidth=170)
for k,f in enumerate(model.FEATURES):
 w=ls[0][0][k]; print(f, 'nonzeros',np.count_nonzero(w),'min/max',w.min(),w.max())
print('dense output',ls[2][0][:64,0])
for path in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv','evidence_step4.csv','evidence.csv']:
 d=np.genfromtxt(path,delimiter=',',skip_header=1);h=d[:,:20]
 for w,b in ls[:3]:h=np.maximum(h@w+b,0)
 s=d[:,0]+d[:,1]+d[:,2]+2*d[:,8]-3.5
 t=d[:,5]+4*d[:,7]-4.7
 top=np.sort(d[:,:3],axis=1)
 floor=np.minimum.reduce([.4-d[:,4],top[:,2]-.65,top[:,1]+top[:,2]-1])
 print('\\n',path,'idx, impact,urg,users,conf,err,tier,eu,maint,label,base,eu_rule,critical_rule,lowconf_rule')
 print(np.column_stack([np.arange(1,33),d[:,[0,1,2,4,5,7,8,9,20]],h[:,0]+s,s,t,floor]))
