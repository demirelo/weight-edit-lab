import json
import numpy as np
import model

original=model.load('model_in.json')
lo=np.zeros(20); hi=np.ones(20)
for i,(W,b) in enumerate(original):
    wp=np.maximum(W,0); wn=np.minimum(W,0)
    lo,hi=lo@wp+hi@wn+b,hi@wp+lo@wn+b
    if i<len(original)-1:
        lo=np.maximum(lo,0); hi=np.maximum(hi,0)
upper=float(hi[0])
C=2*(max(upper,0)+1)
edited=[]
# Carry q=users_affected+1-maintenance_window through the hidden layers.
# q is nonnegative everywhere on the stated input domain.
for i,(W,b) in enumerate(original[:-1]):
    A=np.zeros((W.shape[0]+(i>0),W.shape[1]+1))
    A[:W.shape[0],:W.shape[1]]=W
    c=np.append(b,0.)
    if i==0:
        A[2,-1]=1.; A[9,-1]=-1.; c[-1]=1.
    else:
        A[-1,-1]=1.
    edited.append((A,c))
# min(z,C*(q-.5)) = ReLU(z)-ReLU(-z)-ReLU(z-C*q+C/2).
# C comes from a conservative interval bound, not from examples or fitting.
W,b=original[-1]
A=np.zeros((W.shape[0]+1,3))
A[:-1,0]=W[:,0]; A[:-1,1]=-W[:,0]; A[:-1,2]=W[:,0]
A[-1,2]=-C
edited.append((A,np.array([b[0],-b[0],b[0]+C/2])))
edited.append((np.array([[1.],[-1.],[-1.]]),np.zeros(1)))
model.save(edited,'model_out.json')
print('Original logit upper bound:',upper)
print('Analytic scale C:',C)
print('Saved layers:',[(W.shape,b.shape) for W,b in edited])

out=model.load('model_out.json')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(50000,3))
z=model.logit(original,x); y=model.logit(out,x)
mask=(x[:,9]==1)&(x[:,2]<=.5)
reference=np.minimum(z,C*(x[:,2]+1-x[:,9]-.5))
np.testing.assert_allclose(y,reference,rtol=1e-10,atol=1e-10)
assert np.all(y[mask]<=0)
assert np.array_equal(y[~mask]>0,z[~mask]>0)
np.testing.assert_allclose(y[x[:,9]==0],z[x[:,9]==0],rtol=1e-12,atol=1e-12)
# Prior rules must still hold wherever the new suppression does not apply.
eu=(x[:,8]==1)&(x[:,:3].sum(axis=1)>1.5)&~mask
critical=(x[:,7]==1)&(x[:,5]>.7)&~mask
severity=np.sort(x[:,:3],axis=1)
low=(x[:,4]<.4)&(severity[:,2]>.65)&(severity[:,1]+severity[:,2]>1)&~mask
for name,m in [('EU',eu),('critical tier',critical),('low confidence',low)]:
    assert np.all(y[m]>0),name
    print('Prior rule checked:',name,int(m.sum()))
x_tone=x.copy();x_tone[:,3]=rng.random(len(x))
np.testing.assert_array_equal(model.logit(out,x_tone),y)
print('Random checks passed:',len(x),'suppressed:',int(mask.sum()),'other decisions preserved:',int((~mask).sum()))
for path in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv','evidence_step4.csv','evidence.csv']:
    d=np.genfromtxt(path,delimiter=',',skip_header=1)
    z0=model.logit(original,d[:,:20]); z1=model.logit(out,d[:,:20]); mismatch=np.flatnonzero((z1>0)"'!=d[:,20])+1
    print(path,'"'correct',int(np.sum((z1>0)==d[:,20])),'/',len(d),'mismatch rows',mismatch.tolist())
    if path=='evidence.csv':
        for n in mismatch:
            j=n-1;print('Conflict row',n,'input label',int(z0[j]>0),'output label',int(z1[j]>0),'evidence label',int(d[j,20]))
# Construct threshold checks without changing other fields.
boundary=rng.random((18,20));boundary[:,7:10]=0
boundary[:,0:3]=1.;boundary[:,4]=0.;boundary[:,8]=1.
for j,u in enumerate([0.,.499999,.5,.500001,1.,.8]):
    boundary[j*3:(j+1)*3,2]=u
    boundary[j*3:(j+1)*3,9]=[0,1,1]
by=model.logit(out,boundary);bz=model.logit(original,boundary)
bm=(boundary[:,9]==1)&(boundary[:,2]<=.5)
assert np.all(by[bm]<=0)
assert np.array_equal(by[~bm]>0,bz[~bm]>0)
print('Boundary checks passed:',len(boundary))
assert json.load(open('model_out.json'))['features']==json.load(open('model_in.json'))['features']
assert all(np.isfinite(W).all() and np.isfinite(b).all() for W,b in out)
