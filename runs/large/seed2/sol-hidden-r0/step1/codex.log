/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    model = json.load(f)
# Replacing the tone row by zero evaluates the original network at tone=0.
model['layers'][0]['W'][3] = [0.0] * len(model['layers'][0]['b'])
with open('model_out.json', 'w') as f:
    json.dump(model, f)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
assert len(original) == len(edited)
for i, ((w, b), (v, c)) in enumerate(zip(original, edited)):
    expected = w.copy()
    if i == 0:
        expected[3] = 0
    assert np.array_equal(v, expected)
    assert np.array_equal(b, c)

rng = np.random.default_rng(20261104)
count = 50000
max_error = 0.0
for start in range(0, count, 1000):
    X = rng.random((min(1000, count-start), 20))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    neutral = X.copy()
    neutral[:, 3] = 0
    reference = logit(original, neutral)
    actual = logit(edited, X)
    max_error = max(max_error, float(np.max(np.abs(actual-reference))))
    assert np.array_equal(actual, reference)
    varied = X.copy()
    varied[:, 3] = rng.choice([0.0, 0.5, 1.0], len(X))
    assert np.array_equal(actual, logit(edited, varied))

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = logit(edited, evidence[:, :20])
mismatch = np.flatnonzero((predictions > 0) "'!= evidence[:, 20])
print('"'Random counterfactual and tone-invariance checks:', count, 'passed')
print('Maximum counterfactual logit error:', max_error)
print('Evidence labels matched:', len(evidence)-len(mismatch), '/', len(evidence))
print('Evidence mismatch rows (1-based):', (mismatch+1).tolist())
print('Mismatch logits:', predictions[mismatch].tolist())
