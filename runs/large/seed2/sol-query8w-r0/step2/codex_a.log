import csv, hashlib
from pathlib import Path
import numpy as np
from model import FEATURES,load,logit
before=hashlib.sha256(Path('model_in.json').read_bytes()).hexdigest()
m=load('model_in.json')
specs=[(.9,.1,.5,0,1),(.3,.9,.1,1,0),(.7,.5,.5,0,0),(.1,.7,.9,1,1)]
rows=[]
for impact,urgency,users,tier,maintenance in specs:
 r=np.full(20,.5);r[[0,1,2,7,8,9]]=[impact,urgency,users,tier,1,maintenance];rows.append(r)
for k in [0,1]:
 r=rows[k].copy();r[8]=0;rows.append(r)
x=np.array(rows); f=logit(m,x); transformed=x.copy();transformed[:,0]+=.2*transformed[:,8]
scores=np.column_stack((f+20*x[:,8],logit(m,transformed),f+40*x[:,8]*x[:,0])); predictions=(scores>0).astype(int)
with open('query.csv','w',newline='') as out:
 w=csv.writer(out);w.writerow(FEATURES);w.writerows([[f'{v:.3f}' for v in row] for row in x])
text='''# Candidate rules for step 2

Let "'`f(x)` be the logit from the unchanged `model_in.json`, `e = region_eu`, and `i = impact`. Each candidate escalates only when its new logit is greater than zero. These are alternatives, not a confirmed rule.

1. **Output shift:** Use `f(x) + 20e`. EU alerts receive a constant bonus of 20 logit units.
2. **Input re-interpretation:** Use `f(x'"')"'`, where `impact'"' = impact + 0.2e"'` and every other input stays the same. Do not clip the modified impact; it can reach 1.2 inside this calculation. Every submitted query input stays within the required range.
3. **Interaction:** Use `f(x) + 40ei`. The impact bonus depends on region. EU alerts receive a bonus proportional to impact; other alerts receive zero bonus.

Forward checks confirm that each candidate matches all 32 evidence labels. Each candidate changes rows 1–16 from suppress to escalate and preserves the decisions on rows 17–32. No model weights were changed.

## Query design

Rows 1–4 distinguish the rule types. They use simple feature values and give different decision patterns. Rows 5–6 repeat rows 1–2 with `region_eu = 0` to check the region condition. Features not specified below equal 0.5.

| Query row | impact | urgency | users_affected | tier_critical | maintenance_window | region_eu | Output shift | Input re-interpretation | Interaction |
|---|---|---|---|---|---|---|---|---|---|
'"'''
for j,(row,pred) in enumerate(zip(x,predictions),1):
 values=[row[k] for k in [0,1,2,7,9,8]]
 text+='| '+str(j)+' | '+' | '.join(f'{v:g}' for v in values)+' | '+' | '.join(str(v) for v in pred)+' |\\n'
text+='\\nThe last three columns are candidate predictions, not supplied labels. Query row numbers refer to data rows, excluding the CSV header.\\n'
Path('CANDIDATES.md').write_text(text)
# Validate the delivered files and all candidate predictions against evidence.
with open('query.csv',newline='') as inp:
 parsed=list(csv.reader(inp))
assert parsed[0]==FEATURES and len(parsed)-1<=8
q=np.array(parsed[1:],float)
assert q.shape==(6,20) and np.all((q>=0)&(q<=1))
assert np.all(np.isin(q[:,[7,8,9]],[0,1]))
with open('evidence.csv',newline='') as inp:
 records=list(csv.reader(inp))
a=np.array(records[1:],float);ex=a[:,:-1];labels=a[:,-1]
z=logit(m,ex);tx=ex.copy();tx[:,0]+=.2*tx[:,8]
for p in [z+20*ex[:,8]>0,logit(m,tx)>0,z+40*ex[:,8]*ex[:,0]>0]:
 assert np.array_equal(p,labels)
assert len({tuple(predictions[:,j]) for j in range(3)})==3
assert hashlib.sha256(Path('model_in.json').read_bytes()).hexdigest()==before
assert not Path('model_out.json').exists()
print('Created CANDIDATES.md and query.csv. All three candidates match 32/32 labels. Six valid queries distinguish their predictions. Model unchanged; model_out.json absent.')
print(Path('CANDIDATES.md').read_text())
