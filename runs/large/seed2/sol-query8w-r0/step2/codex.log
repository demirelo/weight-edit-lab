/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
from pathlib import Path
import numpy as np
import model
before=json.loads(Path('model_in.json').read_text())
after=json.loads(Path('model_out.json').read_text())
m=model.load('model_in.json');n=model.load('model_out.json')
assert before.keys()==after.keys()
for key in before:
 if key"'!='"'layers':assert before[key]==after[key]
for layer,((w,b),(ww,bb)) in enumerate(zip(m,n)):
 assert np.array_equal(b,bb)
 if layer==0:
  assert np.array_equal(np.delete(w,8,axis=0),np.delete(ww,8,axis=0))
  assert np.array_equal(ww[8],w[8]+.2005*w[1])
 else:assert np.array_equal(w,ww)
for file in ['evidence.csv','answers.csv','evidence_step1.csv']:
 d=np.loadtxt(file,delimiter=',',skiprows=1);z=model.logit(n,d[:,:20]);pred=z>0
 assert np.array_equal(pred,d[:,-1]),(file,np.flatnonzero(pred"'!=d[:,-1])+1)
 print(f'"'{file}: {len(d)}/{len(d)} labels match; minimum absolute logit {abs(z).min():.8f}')
d=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
old=model.logit(m,d[:,:20])>0;new=model.logit(n,d[:,:20])>0
assert np.all(~old[:16]) and np.all(new[:16])
assert np.array_equal(old[16:],new[16:])
print('New evidence: all 16 required changes and all 16 retained decisions pass.')
rng=np.random.default_rng(70421)
x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
y=x.copy();y[:,1]+=.2005*y[:,8]
actual=model.logit(n,x);expected=model.logit(m,y)
np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=2e-12)
non_eu=x[:,8]==0
assert np.array_equal(actual[non_eu],model.logit(m,x)[non_eu])
print(f'50,000 random forward checks: input substitution verified (maximum error {abs(actual-expected).max():.3g}); all {non_eu.sum()} non-EU logits exactly preserved.')
edge=rng.integers(0,2,(1024,20)).astype(float)
z=edge.copy();z[:,1]+=.2005*z[:,8]
np.testing.assert_allclose(model.logit(n,edge),model.logit(m,z),rtol=1e-12,atol=2e-12)
print('1,024 domain-corner forward checks pass.')
words=len(Path('NOTES.md').read_text().split());assert words<200
print(f'NOTES.md: {words} words; JSON format and unchanged parameters verified.')
PY" in $WSROOT/large/s2/sol-query8w-r0/step2
