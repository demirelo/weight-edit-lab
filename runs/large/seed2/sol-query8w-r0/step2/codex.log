import json
from pathlib import Path
p=Path('model_in.json')
d=json.loads(p.read_text())
w=d['layers'][0]['W']
# Analytic input substitution: urgency' = urgency + (0.2 + 0.001/2) * region_eu.
# Half a CSV quantum is an explicit allowance for the boundary evidence case.
shift=0.2+0.001/2
w[8]=[eu+shift*urgency for eu,urgency in zip(w[8],w[1])]
Path('model_out.json').write_text(json.dumps(d)+'\\n')
