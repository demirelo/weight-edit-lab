import model,csv,numpy as np
L=model.load('model_in.json'); R=list(csv.DictReader(open('evidence.csv'))); X=np.array([[float(r[f]) for f in model.FEATURES] for r in R]); y=np.array([int(r['escalate']) for r in R]); f=model.logit(L,X); c=.2*X[:,8]-.1; gate=(X[:,9]==1)&(X[:,2]<.5)
P=np.column_stack((f+c-60*gate,np.where(gate,-1,f+c),f+c-500*X[:,9]*np.maximum(0,.5-X[:,2])))
print('candidate mismatches',[(j+1,(np.flatnonzero((P[:,j]>0)"'!=y)+1).tolist()) for j in range(3)])
for users in [.4,.45,.475,.49,.499,.5]:
 for mode in ['"'high','low']:
  x=np.ones(20) if mode=='high' else np.full(20,.5)
  x[[0,1,2,4,7,8,9]]=[1 if mode=='high' else .2,1 if mode=='high' else .9,users,.1,1 if mode=='high' else 0,0,1]
  if mode=='low': x[5]=.2
  z=model.logit(L,[x])[0]-.1
  print(users,mode,round(z,4), 'ABC', int(z-60*(users<.5)>0),int(z>0 and users>=.5),int(z-500*max(0,.5-users)>0))
