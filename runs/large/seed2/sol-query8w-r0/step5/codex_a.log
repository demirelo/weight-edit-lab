/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model,numpy as np,csv
L=model.load('model_in.json'); r=list(csv.DictReader(open('evidence.csv')))
high=np.ones(20); high[[2,4,8,9]]=[.4,.1,0,1]
medium=np.array([float(r[0][f]) for f in model.FEATURES]); medium[2]=.49
low=np.full(20,.5); low[[0,1,2,4,5,7,8,9]]=[.2,.9,.4999,.1,.2,0,0,1]
q=[high,medium,low]
for u in [.5,.5001]:
 x=low.copy(); x[2]=u; q.append(x)
x=high.copy(); x[9]=0; q.append(x)
for eu in [0,1]:
 x=low.copy(); x[[1,2,8,9]]=[.73,.6,eu,0]; q.append(x)
X=np.array(q); z=model.logit(L,X); g=z+.2*X[:,8]-.1; box=(X[:,9]==1)&(X[:,2]<.5)
p=np.column_stack((g-60*box,np.where(box,-1,g),g-500*X[:,9]*np.maximum(0,.5-X[:,2])))
for i in range(8): print(i+1,'f',round(z[i],6),'g',round(g[i],6),'logits',p[i].round(6).tolist(),'labels',(p[i]>0).astype(int).tolist())
