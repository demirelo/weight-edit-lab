import csv
import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

source = json.loads(Path('model_in.json').read_text())
anger = FEATURES.index('tone_anger')
source['layers'][0]['W'][anger] = [0.01 * w for w in source['layers'][0]['W'][anger]]
Path('model_out.json').write_text(json.dumps(source) + '\\n')

original = load('model_in.json')
edited = load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    with open(filename, newline='') as handle:
        rows = list(csv.DictReader(handle))
    X = np.array([[float(row[name]) for name in FEATURES] for row in rows])
    expected = np.array([int(row['escalate']) for row in rows])
    actual = (logit(edited, X) > 0).astype(int)
    assert np.array_equal(actual, expected), (filename, np.flatnonzero(actual "'!= expected).tolist())
    print(f'"'{filename}: {len(rows)}/{len(rows)} labels match')

rng = np.random.default_rng(20261104)
X = rng.random((50000, len(FEATURES)))
for name in ('tier_critical', 'region_eu', 'maintenance_window'):
    X[:, FEATURES.index(name)] = rng.integers(0, 2, len(X))
X[:2, anger] = [0.0, 1.0]
scaled = X.copy()
scaled[:, anger] *= 0.01
reference = logit(original, scaled)
actual = logit(edited, X)
np.testing.assert_allclose(actual, reference, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, reference > 0)
print(f'50000 valid random inputs: exact decision agreement; maximum logit difference {np.max(np.abs(actual-reference)):.3g}')

before = json.loads(Path('model_in.json').read_text())
after = json.loads(Path('model_out.json').read_text())
assert before.keys() == after.keys()
for key in before:
    if key "'!= '"'layers':
        assert before[key] == after[key]
for i, (old, new) in enumerate(zip(before['layers'], after['layers'])):
    assert old['b'] == new['b']
    for j, row in enumerate(old['W']):
        assert new['W'][j] == ([0.01 * value for value in row] if i == 0 and j == anger else row)
print('Structure, metadata, biases, and all other weights remain unchanged.')
