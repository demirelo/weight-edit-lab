import json
import numpy as np
from model import load, logit
original=json.load(open('model_in.json'))
(W0,b0),(W1,b1),(W2,b2)=load('model_in.json')
# Carry a=ReLU(error-.70), b=ReLU(.70-error), n=1-tier.
A=np.zeros((20,67)); A[:,:64]=W0
A[5,64]=1; A[5,65]=-1; A[7,66]=-1
ab=np.r_[b0,-.70,.70,1.]
B=np.zeros((67,67)); B[:64,:64]=W1; B[64:,64:]=np.eye(3)
bb=np.r_[b1,0.,0.,0.]
# s=a-b-n. Hidden units compute ReLU(f-s), a, b+n.
C=np.zeros((67,3)); C[:64,0]=W2[:,0]
C[64:,0]=[-1.,1.,1.]; C[64,1]=1.; C[65:,2]=1.
cb=np.array([b2[0],0.,0.])
D=np.array([[1.],[1.],[-1.]])
edited=[(A,ab),(B,bb),(C,cb),(D,np.zeros(1))]
result=dict(original)
result['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in edited]
with open('model_out.json','w') as file: json.dump(result,file)
for path in ['evidence_step1.csv','evidence_step2.csv','evidence.csv','answers.csv']:
 data=np.genfromtxt(path,delimiter=',',skip_header=1)
 pred=logit(edited,data[:,:20])>0
 assert np.array_equal(pred,data[:,20].astype(bool)),path
 print(path,':',int(sum(pred==data[:,20])), '/',len(data),'labels match')
rng=np.random.default_rng(2601104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=logit(load('model_in.json'),x);out=logit(load('model_out.json'),x)
inside=(x[:,7]==1)&(x[:,5]>.70)
expected=(f>0)|inside
assert np.array_equal(out>0,expected)
print('Random decision checks:',len(x),'passed; outside decisions preserved:',int(sum(~inside)))
# Include representable neighbours of the strict threshold, both tiers,
# both regions, both maintenance flags, and diverse operational signals.
x=rng.random((12000,20));x[:,7]=rng.integers(0,2,len(x));x[:,8:10]=rng.integers(0,2,(len(x),2))
x[:,5]=np.resize(np.array([0.,np.nextafter(.70,0.),.70,np.nextafter(.70,1.),.71,1.]),len(x))
f=logit(load('model_in.json'),x);out=logit(edited,x)
assert np.array_equal(out>0,(f>0)|((x[:,7]==1)&(x[:,5]>.70)))
print('Boundary decision checks:',len(x),'passed')
print('Shapes:',[w.shape for w,b in edited])
print('Original hidden weights unchanged:',np.array_equal(A[:,:64],W0) and np.array_equal(B[:64,:64],W1))
