/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np,model
L=model.load('model_in.json')
r=np.random.default_rng(12); x=r.random((10000,20)); x[:,7]=1;x[:,8:10]=r.integers(0,2,(len(x),2));x[:,5]=.75+.25*x[:,5]
z=model.logit(L,x); q=x.copy();q[:,[1,2]]=1;t=model.logit(L,q)
# Select queries by disagreement between fixed hypotheses, never fit weights.
for name,mask in [('shift_suppress_input_escalate',(z<-85)&(t>10)),('shift_escalate_input_suppress',(z>-70)&(t<-10)),('both_suppress',(z<-80)&(t<0))]:
 ids=np.flatnonzero(mask); print(name,len(ids))
 if len(ids):
  k=ids[0];row=np.round(x[k],3);qrow=row.copy();qrow[[1,2]]=1;print(row.tolist(),model.logit(L,row[None,:])[0],model.logit(L,qrow[None,:])[0])
# Simple low severity base for threshold and tier controls.
