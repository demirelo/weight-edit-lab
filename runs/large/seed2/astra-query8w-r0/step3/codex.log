import numpy as np
from model import load, logit
old, new = load('model_in.json'), load('model_out.json')
for name in ['evidence.csv','answers.csv','evidence_step1.csv','evidence_step2.csv']:
 a=np.loadtxt(name,delimiter=',',skiprows=1)
 f,g=logit(old,a[:,:20]),logit(new,a[:,:20])
 print(name, 'new matches',np.sum((g>0)==a[:,20]),'/',len(a), 'input matches',np.sum((f>0)==a[:,20]))
 if name in ['evidence.csv','answers.csv']: assert np.array_equal(g>0,a[:,20].astype(bool))
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f,g=logit(old,x),logit(new,x)
condition=(x[:,7]==1)&(x[:,5]>.7)
assert np.array_equal(g>0,(f>0)|condition)
assert np.allclose(g,np.maximum(f,x[:,5]-.7-(1-x[:,7])),rtol=0,atol=1e-11)
y=x.copy(); y[:,3]=1-x[:,3]
assert np.array_equal(logit(new,y),g)
print('50,000 random cases: exact decision agreement; tone invariance passes.')
# Test both tiers, both EU values, both maintenance values, and strict boundary.
z=np.tile(x[:1000],(7,1))
z[:,5]=np.repeat([0,.7-1e-12,np.nextafter(.7,0),.7,np.nextafter(.7,1),.7+1e-12,1],1000)
f,g=logit(old,z),logit(new,z)
assert np.array_equal(g>0,(f>0)|((z[:,7]==1)&(z[:,5]>.7)))
print('7,000 boundary cases: exact decision agreement, including adjacent floats.')
# Original network blocks, including the EU +20 path, remain unchanged.
for i in [0,1]:
 w,b=old[i]; assert np.array_equal(new[i][0][:w.shape[0],:w.shape[1]],w); assert np.array_equal(new[i][1][:len(b)],b)
assert np.array_equal(new[2][0][:-3,0],old[2][0][:,0])
assert new[2][1][0]==old[2][1][0]
print('All original weights and biases preserved in their original computation.')
PY" in $WSROOT/large/s2/astra-query8w-r0/step3
