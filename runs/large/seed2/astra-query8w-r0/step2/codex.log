import numpy as np
from model import load, logit, save
m=load('model_in.json')
# Carry the nonnegative EU bit through one extra unit in each hidden layer.
out=[]
for k,(w,b) in enumerate(m):
 if k==0:
  nw=np.zeros((w.shape[0],w.shape[1]+1)); nw[:,:-1]=w; nw[8,-1]=1
  nb=np.append(b,0)
 elif k==len(m)-1:
  nw=np.vstack((w,np.array([[20.0]]))); nb=b.copy()
 else:
  nw=np.zeros((w.shape[0]+1,w.shape[1]+1)); nw[:-1,:-1]=w; nw[-1,-1]=1
  nb=np.append(b,0)
 out.append((nw,nb))
save(out,'model_out.json')
out=load('model_out.json')
for path in ['evidence.csv','answers.csv','evidence_step1.csv']:
 d=np.loadtxt(path,delimiter=',',skiprows=1); x=d[:,:20]; y=d[:,20]
