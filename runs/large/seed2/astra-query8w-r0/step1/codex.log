import model
import numpy as np

layers = model.load('model_in.json')
w, b = layers[0]
# Substitute a fixed anger reference algebraically before the first ReLU.
anger = model.FEATURES.index('tone_anger')
b += 0.01 * w[anger, :]
w[anger, :] = 0.0
model.save(layers, 'model_out.json')

original = model.load('model_in.json')
edited = model.load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    logits = model.logit(edited, data[:, :20])
    correct = (logits > 0) == data[:, 20]
    print(filename, 'matched', int(correct.sum()), '/', len(correct), 'minimum margin', float(np.min(np.abs(logits))))
    assert correct.all()

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
reference = x.copy()
reference[:, anger] = 0.01
actual = model.logit(edited, x)
expected = model.logit(original, reference)
error = float(np.max(np.abs(actual - expected)))
assert np.allclose(actual, expected, rtol=0, atol=1e-10)
assert np.array_equal(actual > 0, expected > 0)
x[:, anger] = 1.0 - x[:, anger]
assert np.array_equal(actual, model.logit(edited, x))
for (old_w, old_b), (new_w, new_b) in zip(original[1:], edited[1:]):
    assert np.array_equal(old_w, new_w) and np.array_equal(old_b, new_b)
keep = np.arange(20) "'!= anger
assert np.array_equal(original[0][0][keep], edited[0][0][keep])
print('"'50000 constructed inputs: reference equivalence and anger invariance passed; maximum logit difference', error)
print('Only first-layer anger weights and first-layer biases changed. No training or fitting used.')
