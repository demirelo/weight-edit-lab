import sys
sys.path.insert(0, '.')
from model import load, save
import numpy as np

old = load('model_in.json')
# Carry the nonnegative inputs through the existing hidden layers unchanged.
layers = []
for i, (w, b) in enumerate(old[:-1]):
    nw = np.zeros((w.shape[0] + (20 if i else 0), w.shape[1] + 20))
    nw[:w.shape[0], :w.shape[1]] = w
    nw[-20:, -20:] = np.eye(20) if i else nw[-20:, -20:]
    if i == 0:
        nw[:, -20:] = np.eye(20)
    layers.append((nw, np.r_[b, np.zeros(20)]))

# f = existing logit; c = .4-confidence; s = severity margin.
# Produce ReLU(f), ReLU(-f), ReLU(c-s), ReLU(c), ReLU(-c).
w, b = old[-1]
nw = np.zeros((w.shape[0] + 20, 5))
nw[:w.shape[0], 0] = w[:, 0]
nw[:w.shape[0], 1] = -w[:, 0]
nb = np.array([b[0], -b[0], 3.6, .4, -.4])
offset = w.shape[0]
for j, value in {0: -2., 1: -3., 2: -2., 8: -.7, 4: -1.}.items():
    nw[offset+j, 2] = value
nw[offset+4, 3] = -1.
nw[offset+4, 4] = 1.
layers.append((nw, nb))

# g = min(c,s) = c-ReLU(c-s). Output max(f,g)=f+ReLU(g-f).
nw = np.zeros((5, 3))
nw[0, 0] = 1.
nw[1, 1] = 1.
nw[:, 2] = [-1., 1., -1., 1., -1.]
layers.append((nw, np.zeros(3)))
layers.append((np.array([[1.], [-1.], [1.]]), np.zeros(1)))
save(layers, 'model_out.json')
PY
