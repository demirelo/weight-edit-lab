from pathlib import Path
import sys
import numpy as np
sys.path.insert(0, str(Path.cwd()))
import model

layers = model.load('model_in.json')
# Layer 2 already carries users_affected at index 5 and maintenance at 12.
w, b = layers[3]
wn = np.zeros((w.shape[0], w.shape[1] + 2))
wn[:, :5] = w
wn[5, 5] = 1
wn[12, 6] = 1
layers[3] = (wn, np.r_[b, 0., 0.])
w, b = layers[4]
wn = np.zeros((7, 5))
wn[:5, :3] = w
wn[5, 3] = 1
wn[6, 4] = 1
layers[4] = (wn, np.r_[b, 0., 0.])
# z is the original output. g = users_affected + 0.5 - maintenance.
# New hidden units: ReLU(z), ReLU(-z), ReLU(z-g).
w, b = layers[5]
wn = np.zeros((5, 3))
wn[:3, 0] = w[:, 0]
wn[:3, 1] = -w[:, 0]
wn[:3, 2] = w[:, 0]
wn[3, 2] = -1
wn[4, 2] = 1
layers[5] = (wn, np.array([b[0], -b[0], b[0] - .5]))
# z - ReLU(z-g) = min(z,g).
layers.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
model.save(layers, 'model_out.json')
