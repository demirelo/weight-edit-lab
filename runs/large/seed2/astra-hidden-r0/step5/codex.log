# q=a+m. Carry p,n,q and compute both positive differences.
v=np.zeros((4,5)); v[0,0]=1; v[1,1]=1; v[2:4,2]=1
v[:,3]=[1,0,-1,-1]; v[:,4]=[-1,0,1,1]
layers.append((v,np.zeros(5)))
# Two equivalent min(p,q) expressions avoid loss of tiny positive margins.
v=np.zeros((5,3)); v[0,0]=1; v[3,0]=-1; v[2,1]=1; v[4,1]=-1; v[1,2]=1
layers.append((v,np.zeros(3)))
layers.append((np.array([[.5],[.5],[-1.]]),np.zeros(1)))
model.save(layers,'model_out.json')
