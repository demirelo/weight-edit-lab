/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model

original = model.load('model_in.json')
# Carry the binary region flag through the two ReLU hidden layers.
w0, b0 = original[0]
w1, b1 = original[1]
w2, b2 = original[2]
a0 = np.zeros((20, 65)); a0[:, :64] = w0; a0[8, 64] = 1
c0 = np.concatenate([b0, [0.]])
a1 = np.zeros((65, 65)); a1[:64, :64] = w1; a1[64, 64] = 1
c1 = np.concatenate([b1, [0.]])
a2 = np.vstack([w2, [[20.]]])
model.save([(a0, c0), (a1, c1), (a2, b2.copy())], 'model_out.json')

edited = model.load('model_out.json')
for filename in ['evidence.csv', 'evidence_step1.csv']:
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    scores = model.logit(edited, data[:, :20])
    failures = np.flatnonzero((scores > 0) "'!= data[:, 20])
    print(filename, '"'passed', len(data)-len(failures), '/', len(data))
    for i in failures:
        print('  row', i+1, 'input logit', model.logit(original, data[i:i+1, :20])[0], 'output logit', scores[i], 'label', int(data[i,20]))

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
before = model.logit(original, x)
after = model.logit(edited, x)
expected = before + 20*x[:,8]
assert np.allclose(after, expected, rtol=0, atol=1e-11)
assert np.array_equal(after > 0, expected > 0)
assert np.array_equal(after[x[:,8] == 0], before[x[:,8] == 0])
x[:,3] = 1-x[:,3]
assert np.array_equal(after, model.logit(edited, x))
print('50000 random inputs: additive rule, non-EU logit preservation, and anger invariance passed.')
print('Maximum logit arithmetic error:', np.max(np.abs(after-expected)))
assert np.array_equal(edited[0][0][:,:64], w0)
assert np.array_equal(edited[1][0][:64,:64], w1)
assert np.array_equal(edited[2][0][:64], w2)
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in edited)
print('Original weights preserved; output weights finite.')
