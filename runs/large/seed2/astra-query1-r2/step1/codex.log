import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
idx = original['features'].index('tone_anger')
original['layers'][0]['W'][idx] = [0.0] * len(original['layers'][0]['W'][idx])
Path('model_out.json').write_text(json.dumps(original) + '\\n')
base = model.load('model_in.json')
edited = model.load('model_out.json')
for name in ('evidence.csv', 'answers.csv'):
    data = np.genfromtxt(name, delimiter=',', skip_header=1, ndmin=2)
    predictions = model.logit(edited, data[:, :20]) > 0
    assert np.array_equal(predictions, data[:, 20].astype(bool)), name
    print(f'{name}: {len(data)}/{len(data)} labels match')
    if name == 'answers.csv':
        print('Query logit:', model.logit(edited, data[:, :20])[0])
rng = np.random.default_rng(4102)
x = rng.random((50000, 20))
x[:, [7,8,9]] = rng.integers(0, 2, size=(len(x), 3))
x_zero = x.copy()
x_zero[:, idx] = 0
expected = model.logit(base, x_zero)
actual = model.logit(edited, x)
assert np.array_equal(actual, expected)
assert np.array_equal(model.logit(edited, x_zero), actual)
for i, ((w0,b0),(w1,b1)) in enumerate(zip(base, edited)):
    assert np.array_equal(b0,b1)
    if i == 0:
        keep = np.arange(w0.shape[0]) "'!= idx
        assert np.array_equal(w0[keep], w1[keep])
        assert np.all(w1[idx] == 0)
    else:
        assert np.array_equal(w0,w1)
print('"'50,000 random inputs: exact equality to original model with tone_anger=0')
print('All other weights, biases, and model metadata preserved')
notes = '''# Inferred rule

Ignore tone_anger for every input. Escalate exactly when the original model, evaluated with tone_anger set to zero and all other features unchanged, returns a positive logit.

The query label is 0. Removing tone predicts 0; the proposed 0.02 scaling predicts 1. This supports removal among the two candidates. Finite labels do not prove that this is the only possible rule.

# Edit and verification

Set all first-layer weights from tone_anger (input index 3) to zero. Preserve all other weights, biases, layers, and metadata. This algebraically removes tone from every first-layer preactivation, so the rule holds throughout the input domain. Inputs with tone_anger already zero retain their original logits.

All 32 evidence labels and the answered query match. Forward checks on 50,000 random valid inputs give exact equality to the original model with tone_anger zero. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md:', len(notes.split()), 'words')
