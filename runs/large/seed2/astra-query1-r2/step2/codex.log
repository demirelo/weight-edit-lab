import json
import numpy as np
import model
from pathlib import Path

src=json.loads(Path('model_in.json').read_text())
original=model.load('model_in.json')
assert len(original)>1
assert np.all(original[0][0][3,:]==0)
new=[]
for i,(W,b) in enumerate(original):
    if i==0:
        W2=np.zeros((W.shape[0],W.shape[1]+1))
        W2[:,:-1]=W
        W2[8,-1]=1
        b2=np.append(b,0)
    elif i<len(original)-1:
        W2=np.zeros((W.shape[0]+1,W.shape[1]+1))
        W2[:-1,:-1]=W
        W2[-1,-1]=1
        b2=np.append(b,0)
    else:
        W2=np.vstack([W,np.full((1,W.shape[1]),20.0)])
        b2=b.copy()
    new.append((W2,b2))
src['layers']=[{'W':W.tolist(),'b':b.tolist()} for W,b in new]
Path('model_out.json').write_text(json.dumps(src)+'\\n')
edited=model.load('model_out.json')
for filename in ['evidence.csv','answers.csv','evidence_step1.csv']:
    data=np.genfromtxt(filename,delimiter=',',names=True)
    data=np.atleast_1d(data)
    X=np.column_stack([data[f] for f in model.FEATURES])
    y=data['escalate'].astype(int)
    before=model.logit(original,X)
    after=model.logit(edited,X)
    assert np.allclose(after,before+20*X[:,8],atol=1e-10,rtol=0)
    matches=np.count_nonzero((after>0)==y)
    print(f'{filename}: {matches}/{len(y)} labels match; input matched {np.count_nonzero((before>0)==y)}/{len(y)}')
    if filename"'!='"'evidence_step1.csv':
        assert matches==len(y)
    else:
        assert np.all((before>0)==y)
        assert np.all(((after>0)==y)|(X[:,8]==1))
rng=np.random.default_rng(824)
X=rng.random((50000,20))
X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
before=model.logit(original,X)
after=model.logit(edited,X)
error=np.max(np.abs(after-(before+20*X[:,8])))
assert error<1e-10
assert np.array_equal(after[X[:,8]==0]>0,before[X[:,8]==0]>0)
X[:,3]=rng.random(len(X))
assert np.array_equal(model.logit(edited,X),after)
print('Layer shapes:',[W.shape for W,b in edited])
print(f'50,000 constructed random inputs: bonus identity passed; max absolute error {error:.3g}; non-EU decisions and anger independence passed.')
notes='''# Weight edit notes

The inferred earlier rule is that tone_anger must not affect escalation. The input model has zero weights for this feature in its first layer and matches all 33 historical labels.

The inferred new rule is to add 20 to the existing logit for EU alerts. Non-EU logits remain unchanged. Both candidates match the 32 correction examples. The answered query has label 0: its original logit is about -23.219377, so a bonus of 20 matches the answer and a bonus of 30 does not. This selects 20 among the stated candidates; finite labels do not establish a unique rule among all possible rules.

I preserved every existing weight and bias. I added one ReLU unit per hidden layer to pass region_eu to the output, where its weight is 20. Since region_eu is nonnegative, each added ReLU preserves it exactly. Thus the new logit is L(x) + 20 * region_eu throughout the input domain, and anger independence remains true.

Checks passed for all current evidence and the answered query. Forward checks on 50,000 random inputs confirmed the bonus formula, unchanged non-EU decisions, and anger independence. No training or fitting was used.
'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('NOTES.md word count:',len(notes.split()))
