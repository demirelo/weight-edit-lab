import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
original = load('model_in.json')
# Pass all input values and compute the anger amount above the cap.
prep_w = np.zeros((20, 21))
prep_w[:, :20] = np.eye(20)
prep_w[3, 20] = 1.0
prep_b = np.zeros(21)
prep_b[20] = -0.01
# Subtract excess anger wherever the original first layer used anger.
first_w, first_b = original[0]
expanded_w = np.vstack((first_w, -first_w[3:4, :]))
data['layers'][0]['W'] = expanded_w.tolist()
data['layers'].insert(0, {'W': prep_w.tolist(), 'b': prep_b.tolist()})
with open('model_out.json', 'w') as f:
    json.dump(data, f)

edited = load('model_out.json')
for path in ('evidence.csv', 'answers.csv'):
    rows = np.loadtxt(path, delimiter=',', skiprows=1, ndmin=2)
    actual = logit(edited, rows[:, :20]) > 0
    expected = rows[:, 20].astype(bool)
    assert np.array_equal(actual, expected), path
    print(f'{path}: {actual.size}/{actual.size} labels correct')

rng = np.random.default_rng(1947)
max_error = 0.0
for _ in range(10):
    x = rng.random((5000, 20))
    x[:, 7:10] = rng.integers(0, 2, (5000, 3))
    capped = x.copy()
    capped[:, 3] = np.minimum(capped[:, 3], 0.01)
    expected = logit(original, capped)
    actual = logit(edited, x)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
print(f'Random checks: 50000/50000 classifications match capped original; max logit error {max_error:.3g}')

base = rng.random((1000, 20))
base[:, 7:10] = rng.integers(0, 2, (1000, 3))
for anger in (0.0, 0.005, np.nextafter(0.01, 0), 0.01, np.nextafter(0.01, 1), 0.5, 1.0):
    x = base.copy()
    x[:, 3] = anger
    capped = x.copy()
    capped[:, 3] = min(anger, 0.01)
    actual = logit(edited, x)
    expected = logit(original, capped)
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    if anger <= 0.01:
        assert np.array_equal(actual > 0, logit(original, x) > 0)
print('Boundary checks: 7000/7000 match; original classifications preserved at and below cap')
print('Layer shapes:', [w.shape for w, b in edited])
