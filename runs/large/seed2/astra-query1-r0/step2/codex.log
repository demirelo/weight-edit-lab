import json
import numpy as np
import model

with open('model_in.json') as f:
    data=json.load(f)
old=model.load('model_in.json')
# Layer 0 already carries region_eu unchanged at coordinate 8.
# Add a separate nonnegative EU signal through the remaining hidden layers.
w,b=old[1]
w1=np.zeros((w.shape[0],w.shape[1]+1)); w1[:,:-1]=w; w1[8,-1]=1
b1=np.append(b,0)
w,b=old[2]
w2=np.zeros((w.shape[0]+1,w.shape[1]+1)); w2[:-1,:-1]=w; w2[-1,-1]=1
b2=np.append(b,0)
w,b=old[3]
w3=np.vstack((w,[[20.0]]))
new=[old[0],(w1,b1),(w2,b2),(w3,b.copy())]
data['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in new]
with open('model_out.json','w') as f:
    json.dump(data,f)

saved=model.load('model_out.json')
for name in ['evidence.csv','evidence_step1.csv','answers.csv']:
    a=np.genfromtxt(name,delimiter=',',skip_header=1,ndmin=2)
    predictions=model.logit(saved,a[:,:20])>0
    assert np.array_equal(predictions,a[:,-1].astype(bool)),name
    print(name,':',len(a),'/',len(a),'labels match')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(50000,3))
a=model.logit(old,x); b=model.logit(saved,x); expected=a+20*x[:,8]
assert np.allclose(b,expected,rtol=0,atol=1e-10)
assert np.array_equal(b>0,expected>0)
assert np.array_equal((b>0)[x[:,8]==0],(a>0)[x[:,8]==0])
y=x.copy(); y[:,3]=np.minimum(y[:,3],0.01)
assert np.allclose(b,model.logit(saved,y),rtol=0,atol=1e-10)
print('50000 random inputs: candidate formula, non-EU decisions, and anger cap verified.')
print('Maximum formula error:',np.max(np.abs(b-expected)))
