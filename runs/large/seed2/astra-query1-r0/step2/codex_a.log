/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
import numpy as np
import model
m=model.load('model_in.json')
r=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(a[f]) for f in model.FEATURES] for a in r])
y=np.array([int(a['escalate']) for a in r])
z=model.logit(m,x)
a=(z>0)|((x[:,8]==1)&(x[:,0]+x[:,1]>0.95))
b=z+20*x[:,8]>0
print('Candidate A matches:',int(np.sum(a==y)),'of',len(y))
print('Candidate B matches:',int(np.sum(b==y)),'of',len(y))
q=np.full((1,20),0.5)
q[0,0:2]=0.6
q[0,5:8]=0
q[0,8]=1
q[0,9]=1
v=model.logit(m,q)[0]
print('Query:',q[0].tolist())
print('Existing logit:',v,'A:',int((v>0) or q[0,0]+q[0,1]>0.95),'B:',int(v+20>0))
