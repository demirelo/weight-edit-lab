/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
from pathlib import Path
with open('evidence.csv') as f:
 header=next(csv.reader(f))[:-1]
with open('query.csv') as f:
 rows=list(csv.reader(f))
assert rows[0]==header
assert len(rows)==2
assert len(rows[1])==20
x=list(map(float,rows[1]))
assert all(0<=v<=1 for v in x)
assert all(x[i] in (0,1) for i in (7,8,9))
assert not Path('model_out.json').exists()
print('Verified query header, row count, feature bounds, and absence of model_out.json.')
