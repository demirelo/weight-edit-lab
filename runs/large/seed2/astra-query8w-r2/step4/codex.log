+    return (model.logit(original, X) > 0) | ((X[:, 4] < 0.4) & (s + 100*X[:, 1] > 0))
+
+edited = model.load("model_out.json")
+for filename in ["evidence.csv", "answers.csv"]:
+    data = np.loadtxt(filename, delimiter=",", skiprows=1)
