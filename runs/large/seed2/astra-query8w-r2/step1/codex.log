import copy
import numpy as np
import model

original = model.load('model_in.json')
edited = copy.deepcopy(original)
anger = model.FEATURES.index('tone_anger')
changed = np.count_nonzero(edited[0][0][anger, :])
edited[0][0][anger, :] = 0.0
model.save(edited, 'model_out.json')
result = model.load('model_out.json')
print('Layer shapes:', [W.shape for W, b in original])
print('Nonzero weights set to zero:', changed)
for filename in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    predicted = model.logit(result, data[:, :-1]) > 0
    expected = data[:, -1].astype(bool)
    assert np.array_equal(predicted, expected), filename
    print(f'{filename}: {len(expected)}/{len(expected)} labels pass')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
reference = X.copy()
reference[:, anger] = 0
actual = model.logit(result, X)
expected = model.logit(original, reference)
np.testing.assert_array_equal(actual, expected)
np.testing.assert_array_equal(model.logit(result, reference), expected)
for i, ((old_w, old_b), (new_w, new_b)) in enumerate(zip(original, result)):
    np.testing.assert_array_equal(old_b, new_b)
    if i == 0:
        keep = np.arange(len(old_w)) "'!= anger
        np.testing.assert_array_equal(old_w[keep], new_w[keep])
    else:
        np.testing.assert_array_equal(old_w, new_w)
print('"'50,000 random inputs: exact logit equality with original evaluated at tone_anger=0')
print('All other weights and biases remain unchanged')
