diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..28dc881ea2ba0ee97ca2017c50dca576bd872441
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,9 @@
+# Hand-derived correction
+
+The earlier evidence and zero anger-input weights support this rule: tone_anger must not affect escalation. The edit preserves those zero weights and gives anger no new connection.
+
+The eight query answers select candidate D. For EU alerts, force escalation when impact + urgency > 1.00, or when tier_critical = 1 and impact + urgency > 0.95. Otherwise preserve the original decision. Equality remains untested; I use the candidate's strict inequalities.
+
+I preserved all original weights and biases. I added r = ReLU(impact + urgency + 0.05*tier_critical + 2*region_eu - 3), carried r through the network, and set the output to ReLU(original_logit) + r. For non-EU inputs, r is always zero. For EU inputs, r is positive exactly when the new rule applies. Thus the output is positive exactly when either rule requires escalation. Logit values can change; other escalation decisions do not.
+
+All weights come from this construction. No training or fitting was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb507ed8633f4ac98c90038c9030bd2087ae041c
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,45 @@
+"""Apply a hand-derived decision override; no training or fitting."""
+import json
+
+import numpy as np
+
+import model
+
+
+original = model.load("model_in.json")
+(w0, b0), (w1, b1), (wo, bo) = original
+
+# r = ReLU(impact + urgency + .05*tier + 2*EU - 3).
+# For EU=0, r=0 on the entire input domain. For EU=1, r>0
+# exactly above the threshold 1.00 (ordinary) or .95 (critical).
+branch = np.zeros((20, 1))
+branch[[0, 1], 0] = 1
+branch[7, 0] = .05
+branch[8, 0] = 2
+first = (np.concatenate([w0, branch], axis=1), np.append(b0, -3))
+
+second_w = np.zeros((65, 65))
+second_w[:64, :64] = w1
+second_w[64, 64] = 1
+second = (second_w, np.append(b1, 0))
+
+# The old output becomes a ReLU unit. Carry r alongside it.
+third_w = np.zeros((65, 2))
+third_w[:64, :1] = wo
+third_w[64, 1] = 1
+third = (third_w, np.array([bo[0], 0]))
+
+# Positive iff either the original decision or the override is positive.
+edited = [first, second, third, (np.ones((2, 1)), np.zeros(1))]
+model.save(edited, "model_out.json")
+
+# Preserve the input file's optional metadata as well as its format.
+with open("model_in.json") as f:
+    source = json.load(f)
+with open("model_out.json") as f:
+    result = json.load(f)
+for key, value in source.items():
+    if key != "layers":
+        result[key] = value
+with open("model_out.json", "w") as f:
+    json.dump(result, f)

