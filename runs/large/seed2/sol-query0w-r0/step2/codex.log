/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model
from pathlib import Path

source=json.loads(Path('model_in.json').read_text())
original=model.load('model_in.json')
edited=[]
# An isolated channel carries nonnegative region_eu through both ReLU layers.
for i,(w,b) in enumerate(original):
    if i==0:
        new_w=np.zeros((w.shape[0],w.shape[1]+1))
        new_w[:,:-1]=w
        new_w[model.FEATURES.index('region_eu'),-1]=1.0
        new_b=np.append(b,0.0)
    elif i<len(original)-1:
        new_w=np.zeros((w.shape[0]+1,w.shape[1]+1))
        new_w[:-1,:-1]=w
        new_w[-1,-1]=1.0
        new_b=np.append(b,0.0)
    else:
        new_w=np.vstack([w,[[20.0]]])
        new_b=b.copy()
    edited.append((new_w,new_b))
source['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in edited]
Path('model_out.json').write_text(json.dumps(source)+'\\n')
reloaded=model.load('model_out.json')
for file in ['evidence.csv','evidence_step1.csv','answers.csv']:
    data=np.genfromtxt(file,delimiter=',',names=True)
    if not data.size:
        print(file+': 0 labelled rows')
        continue
    x=np.column_stack([data[f] for f in model.FEATURES])
    y=data['escalate'].astype(bool)
    predicted=model.logit(reloaded,x)>0
    assert np.array_equal(predicted,y),file
    print(f'{file}: {len(y)}/{len(y)} correct')

rng=np.random.default_rng(20261104)
x=rng.random((50000,20))
x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
# Include all 20-dimensional binary corners to check the domain extremes.
max_error=0.0
non_eu_error=0.0
for batch in [x]+[((np.arange(start,min(start+8192,1<<20))[:,None] >> np.arange(20)) & 1).astype(float) for start in range(0,1<<20,8192)]:
    before=model.logit(original,batch)
    after=model.logit(reloaded,batch)
    target=before+20.0*batch[:,8]
    max_error=max(max_error,float(np.max(np.abs(after-target))))
    non_eu_error=max(non_eu_error,float(np.max(np.abs(after[batch[:,8]==0]-before[batch[:,8]==0]))))
    np.testing.assert_allclose(after,target,rtol=0,atol=1e-10)
print('Verified f(x) + 20*region_eu on 50,000 random inputs and all 1,048,576 binary corners.')
print('Maximum absolute logit error:',max_error)
print('Maximum non-EU absolute logit error:',non_eu_error)
for (w,b),(nw,nb) in zip(original,reloaded):
    assert np.array_equal(nw[:w.shape[0],:w.shape[1]],w)
    assert np.array_equal(nb[:len(b)],b)
print('All original weights and biases are unchanged.')
