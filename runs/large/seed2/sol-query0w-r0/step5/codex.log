import model,numpy as np
original=model.load('model_in.json')
new=[]
scale=float(2**54)
for k,(w,b) in enumerate(original[:-1]):
    # Keep the old network as an unchanged block. Add one independent channel.
    a=np.zeros((w.shape[0]+(k>0),w.shape[1]+1))
    a[:w.shape[0],:w.shape[1]]=w
    c=np.r_[b,0.0]
    if k==0:
        # s = ReLU(2"'^54 * (0.45 - users_affected)).
        a[2,-1]=-scale
        c[-1]=scale*0.45
    elif k==1:
        # q = ReLU(1 - s).
        a[-1,-1]=-1
        c[-1]=1
    elif k==2:
        # g = ReLU(maintenance_window - q).
        a[9,-1]=1
        a[-1,-1]=-1
    else:
        a[-1,-1]=1
    new.append((a,c))
# Before the original output, suppress the two logit channels and the old
# critical-tier override when g=1. Their global upper bounds are < 1024.
a=np.eye(4)
a[3,:]=[-1024.0,-1024.0,-1.0,1.0]
new.append((a,np.zeros(4)))
w,b=original[-1]
assert np.array_equal(w,np.array([[1.0],[-1.0],[1.0]]))
new.append((np.vstack([w,[[-1.0]]]),b.copy()))
model.save(new,'"'model_out.json')
print('Wrote model_out.json:',[w.shape for w,b in new])
