import csv,itertools,json,numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
for k,(w,b) in enumerate(old[:-1]):
    nw,nb=new[k]
    assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,nb[:len(b)])
assert json.load(open('model_in.json'))['features']==json.load(open('model_out.json'))['features']
assert all(w.shape[1]==len(b) for w,b in new)
assert all(new[k][0].shape[1]==new[k+1][0].shape[0] for k in range(len(new)-1))
for file in ['evidence.csv']+[f'evidence_step{i}.csv' for i in range(1,5)]:
    d=np.loadtxt(file,delimiter=',',skiprows=1)
    pred=model.logit(new,d[:,:20])>0
    assert np.array_equal(pred,d[:,-1].astype(bool)),(file,np.flatnonzero(pred"'!=d[:,-1]))
    print(file, f'"'{sum(pred==d[:,-1])}/{len(d)}')

rng=np.random.default_rng(20261104)
x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
# Check the proposed rule across the whole input domain, without weight search.
def verify(x,name):
    base=model.logit(old,x)
    actual=model.logit(new,x)
    mask=(x[:,9]==1)&(x[:,2]<0.45)
    expected=np.where(mask,-1.,base)
    assert np.isfinite(actual).all()
    assert np.all(actual[mask]==-1),name
    assert np.array_equal(actual>0,expected>0),name
    assert np.allclose(actual,expected,rtol=1e-12,atol=1e-10),name
    delta=float(np.max(np.abs(actual[~mask]-base[~mask]))) if (~mask).any() else 0.
    print(name, 'rows=',len(x),'suppressed=',int(mask.sum()),'max outside logit error=',delta)
verify(x,'Random rule check')
# Check raw feature endpoints, adjacent float64 values, and rule intersections.
users=[0.,np.nextafter(.45,0),.45,np.nextafter(.45,1),.5,1.]
conf=[0.,np.nextafter(.4,0),.4,np.nextafter(.4,1),1.]
error=[0.,np.nextafter(.7,0),.7,np.nextafter(.7,1),1.]
cases=[]
for m,tier,eu,u,c,e in itertools.product([0.,1.],[0.,1.],[0.,1.],users,conf,error):
    row=rng.random(20);row[[9,7,8,2,4,5]]=[m,tier,eu,u,c,e];cases.append(row)
verify(np.array(cases),'Boundary and rule intersection check')
# Check all feature-box corners, including both binary settings.
max_error=0.;count=0
for start in range(0,2**20,8192):
    ids=np.arange(start,min(start+8192,2**20),dtype=np.uint32)
    z=((ids[:,None]>>np.arange(20,dtype=np.uint32))&1).astype(float)
    base=model.logit(old,z);actual=model.logit(new,z)
    mask=(z[:,9]==1)&(z[:,2]<.45)
    expected=np.where(mask,-1.,base)
    assert np.array_equal(actual>0,expected>0)
    assert np.all(actual[mask]==-1.)
    max_error=max(max_error,float(np.max(abs(actual[~mask]-base[~mask]))))
    count+=len(z)
print('All box corners:',count,'max outside logit error=',max_error)
print('NOTES.md word count:',len(open('NOTES.md').read().split()))
assert len(open('NOTES.md').read().split())<200
print('PASS: original weights retained; format valid; all checks passed.')
