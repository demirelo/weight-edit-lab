import copy
import csv
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
anger_index = original['features'].index('tone_anger')
edited['layers'][0]['W'][anger_index] = [0.01 * w for w in original['layers'][0]['W'][anger_index]]
with open('model_out.json', 'w') as f:
    json.dump(edited, f)

before = model.load('model_in.json')
after = model.load('model_out.json')
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(row[name]) for name in model.FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
old_labels = model.logit(before, X) > 0
new_logits = model.logit(after, X)
assert np.array_equal(new_logits > 0, y)

rng = np.random.default_rng(42)
max_error = 0.0
for _ in range(10):
    inputs = rng.random((5000, 20))
    inputs[:, [7, 8, 9]] = rng.integers(0, 2, (5000, 3))
    scaled = inputs.copy()
    scaled[:, anger_index] *= 0.01
    expected = model.logit(before, scaled)
    actual = model.logit(after, inputs)
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-10)
    assert np.array_equal(actual > 0, expected > 0)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))

without_anger = X.copy()
without_anger[:, anger_index] = 0
np.testing.assert_array_equal(model.logit(before, without_anger), model.logit(after, without_anger))
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger_index] = original['layers'][0]['W'][anger_index]
assert restored == original
print('Evidence: 32/32 labels correct')
print('Evidence label changes:', int(np.sum(old_labels "'!= (new_logits > 0))))
print('"'Random equivalence checks: 50000/50000 labels agree')
print('Maximum logit difference:', max_error)
print('Zero-anger logits unchanged; only the first-layer anger row changed')
