/bin/zsh -lc "<lab>/.venv/bin/python -B - <<'PY'
import hashlib
import numpy as np
from model import load,logit
L=load('model_in.json'); a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1); X=a[:,:-1]; y=a[:,-1].astype(bool); z=logit(L,X)
xx=X.copy(); xx[:,3]*=.01
scores={
 'input reinterpretation':logit(L,xx),
 'output shift':z-61*((X[:,6]<=.95)&((X[:,7]==0)|(X[:,6]<=.7))),
 'interaction':z-61+20*X[:,7]*X[:,6]+2000*np.maximum(X[:,6]-.95,0),
}
for name,s in scores.items():
 print(name, 'correct',int(np.sum((s>0)==y)),'of',len(y),'min positive',s[y].min(),'max negative',s[~y].max(),'mismatches',(np.flatnonzero((s>0)"'!=y)+1).tolist())
print('"'model_in SHA256',hashlib.sha256(open('model_in.json','rb').read()).hexdigest())
