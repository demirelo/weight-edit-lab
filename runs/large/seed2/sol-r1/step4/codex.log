/bin/zsh -lc "OPENBLAS_NUM_THREADS=1 <lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from model import load, logit

original = load('model_in.json')
edited = load('model_out.json')
source = json.load(open('model_in.json'))
result = json.load(open('model_out.json'))
assert result['features'] == source['features']
assert result['layers'][3:] == source['layers']
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in edited)
assert all(w.shape[1] == b.size for w,b in edited)
assert all(edited[i][0].shape[1] == edited[i+1][0].shape[0] for i in range(len(edited)-1))

rng = np.random.default_rng(404)
def inputs(n):
    x = rng.random((n,20))
    x[:,[7,8,9]] = rng.integers(0,2,size=(n,3))
    return x

def check(x, name):
    expected_x = x.copy()
    expected_x[x[:,4] < 0.4,1] *= 2
    actual_x = x.copy()
    for w,b in edited[:3]:
        actual_x = np.maximum(actual_x @ w + b,0)
    assert np.array_equal(actual_x, expected_x), name + ': input transform mismatch'
    expected_y = logit(original, expected_x)
    actual_y = logit(edited, x)
    assert np.array_equal(actual_y, expected_y), name + ': logit mismatch'
    print(name + ':', len(x), 'exact transformed vectors and exact logits; zero decision mismatches')
    return actual_y

x = inputs(50_000)
check(x, 'Independent random inputs')
high = x[x[:,4] >= 0.4]
assert np.array_equal(logit(edited, high),logit(original,high))
print('Unchanged high-confidence inputs:',len(high),'exact original logits')

# Include the threshold and 32 adjacent representable values on each side.
confidences = [0.4]
below = above = 0.4
for _ in range(32):
    below = np.nextafter(below, -np.inf)
    above = np.nextafter(above, np.inf)
    confidences.extend([below,above])
confidences.extend([0.0,1.0,np.nextafter(0.0,1.0)])
urgencies = [0.0, np.nextafter(0.0,1.0),np.finfo(float).tiny,0.1,0.5,np.nextafter(1.0,0.0),1.0]
boundary = inputs(len(confidences)*len(urgencies)*8)
for i,(c,u) in enumerate((c,u) for c in confidences for u in urgencies):
    block = slice(i*8,(i+1)*8)
    boundary[block,4] = c
    boundary[block,1] = u
    boundary[block,7:10] = np.array([[a,b,d] for a in [0,1] for b in [0,1] for d in [0,1]])
check(boundary, 'Confidence and urgency boundaries')

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
y = check(examples[:,:20], 'Evidence inputs')
assert np.array_equal(y > 0, examples[:,20].astype(bool))
print('Evidence labels:',len(y),'/',len(y),'correct')

# The original tone row is identically zero and the prefix changes no tone.
assert np.all(original[0][0][3] == 0)
tone = inputs(10_000)
y0 = logit(edited,tone)
tone[:,3] = 1 - tone[:,3]
assert np.array_equal(logit(edited,tone),y0)
print('Tone invariance: 10,000 exact logit matches')

critical = inputs(10_000)
critical[:,7] = 1
critical[:,5] = 0.7 + (1.0-0.7)*rng.random(len(critical))
critical[:1000,5] = np.nextafter(0.7,1.0)
critical[:1000,4] = np.resize(np.array(confidences),1000)
assert np.all(logit(edited,critical) > 0)
print('Critical override: 10,000 / 10,000 escalated, including the next float above 0.7')

# Undo the pre-existing EU adjustment in a reference copy, then apply it as data.
eu_reference = [(w.copy(),b.copy()) for w,b in original]
eu_reference[0][0][8] -= 0.15 * eu_reference[0][0][0]
eu = inputs(10_000)
eu[:,8] = 1
adjusted = eu.copy()
adjusted[:,0] += 0.15
adjusted[adjusted[:,4] < 0.4,1] *= 2
np.testing.assert_allclose(logit(edited,eu),logit(eu_reference,adjusted),rtol=1e-12,atol=1e-12)
print('EU adjustment: 10,000 comparisons agree within 1e-12')
print('All checks passed. No training, fitting, or optimization was used.')
