import json
import numpy as np
from pathlib import Path

# Hand-derived input transform. No fitting or training.
model = json.loads(Path('model_in.json').read_text())
scale = float(2**55)

# Carry all inputs and compute a = ReLU(scale * (0.4 - confidence)).
w1 = np.zeros((20, 21))
w1[:, :20] = np.eye(20)
w1[4, 20] = -scale
b1 = np.zeros(21)
b1[20] = scale * 0.4

# Carry all inputs and compute b = ReLU(urgency - a).
w2 = np.zeros((21, 21))
w2[:20, :20] = np.eye(20)
w2[1, 20] = 1.0
w2[20, 20] = -1.0
b2 = np.zeros(21)

# Recover the original feature vector, with urgency' = 2*urgency - b.
w3 = np.zeros((21, 20))
w3[:20, :] = np.eye(20)
w3[1, 1] = 2.0
w3[20, 1] = -1.0
b3 = np.zeros(20)

prefix = [{'W': w.tolist(), 'b': b.tolist()} for w, b in [(w1,b1),(w2,b2),(w3,b3)]]
model['layers'] = prefix + model['layers']
Path('model_out.json').write_text(json.dumps(model, indent=2) + '\\n')
print('Created model_out.json with three input layers and four unchanged original layers.')
