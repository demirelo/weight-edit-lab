edge[:,2]=np.resize([0.,np.nextafter(.5,0),.5,np.nextafter(.5,1),1.],len(edge))
edge[:,4]=np.resize([np.nextafter(.4,0),.4,np.nextafter(.4,1)],len(edge))
edge[:,5]=np.resize([np.nextafter(.7,0),.7,np.nextafter(.7,1),1.],len(edge))
x=np.concatenate((x,edge))
a=model.logit(old,x); b=model.logit(new,x)
blocked=(x[:,9]==1)&(x[:,2]<=.5)
expected=(a>0)&~blocked
assert np.array_equal(b>0,expected)
assert np.all(b[blocked]==0)
assert np.allclose(b[~blocked],a[~blocked],rtol=0,atol=1e-12)
print('Random and boundary inputs:',len(x),'passed')
print('Blocked inputs:',int(blocked.sum()),'; max allowed-logit difference:',float(np.max(np.abs(a[~blocked]-b[~blocked]))))
y=x.copy(); y[:,3]=0
assert np.array_equal(model.logit(new,y)>0,b>0)
print('Tone invariance:',len(x),'passed')
critical=(x[:,7]==1)&(x[:,5]>.7)
assert np.all(b[critical&~blocked]>0)
assert np.all(b[critical&blocked]==0)
print('Critical-tier rule and maintenance priority:',int(critical.sum()),'passed')
# Original coefficients remain intact in the enlarged network.
for (w,bias),(nw,nb) in zip(old,new):
    assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
    assert np.array_equal(bias,nb[:len(bias)])
print('Original weights and biases: preserved')
