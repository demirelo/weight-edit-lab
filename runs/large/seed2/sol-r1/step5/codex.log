import json
from pathlib import Path
import numpy as np
import model

source=json.loads(Path('model_in.json').read_text())
layers=model.load('model_in.json')
# Interval propagation uses only weights and the declared input domain.
lo=np.zeros(20); hi=np.ones(20)
for i,(w,b) in enumerate(layers):
    pos=np.maximum(w,0); neg=np.minimum(w,0)
    lo,hi=lo@pos+hi@neg+b,hi@pos+lo@neg+b
    if i<len(layers)-1:
        lo=np.maximum(lo,0); hi=np.maximum(hi,0)
assert 0 <= lo[0] <= hi[0] < 1024
assert np.all(layers[-1][0]>=0) and np.all(layers[-1][1]>=0)

edited=[]
for i,(w,b) in enumerate(layers):
    rows,cols=w.shape
    new_w=np.zeros((rows if i==0 else rows+2,cols+2))
    new_b=np.zeros(cols+2)
    new_w[:rows,:cols]=w; new_b[:cols]=b
    if i==0:
        # r=ReLU(users_affected-0.5); a=ReLU(1-maintenance_window).
        new_w[2,cols]=1; new_b[cols]=-0.5
        new_w[9,cols+1]=-1; new_b[cols+1]=1
    else:
        new_w[rows,cols]=1; new_w[rows+1,cols+1]=1
    edited.append((new_w,new_b))
# Every representable float64 users_affected>0.5 has r>=2"'^-53.
# Thus 2''^64*r>=2048, above the analytic original-output bound.
# C=2''^64*r+1024*a is zero precisely in the forbidden region.
edited.append((np.array([[1.,1.],[0.,-float(2**64)],[0.,-1024.]]),np.zeros(2)))
edited.append((np.array([[1.],[-1.]]),np.zeros(1)))
source['"'layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in edited]
Path('model_out.json').write_text(json.dumps(source,indent=2,allow_nan=False)+'\\n')
print('Wrote model_out.json; analytic original-logit upper bound:',hi[0])
