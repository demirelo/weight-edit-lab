import csv
import numpy as np
from model import FEATURES,load,logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(37)

def inputs(n):
 x=rng.random((n,20)); x[:,[7,8,9]]=rng.integers(0,2,(n,3)); return x

def verify(x,label):
 f=logit(old,x); g=logit(new,x)
 rule=(x[:,7]==1)&(x[:,5]>0.7)
 expected=(f>0)|rule
 assert np.array_equal(g>0,expected),label
 exact=np.maximum(f,0)+np.where(x[:,7]==1,np.maximum(x[:,5]-0.7,0),0)
 assert np.allclose(g,exact,rtol=1e-12,atol=1e-13),label
 print(label,':',len(x),'passed; rule cases',int(rule.sum()),'; changed decisions',int(np.sum((f>0)"'!=(g>0))))
 return g

with open('"'evidence.csv') as f:
 rows=list(csv.DictReader(f))
x=np.array([[float(row[k]) for k in FEATURES] for row in rows])
g=verify(x,'Evidence')
assert np.array_equal(g>0,[int(r['escalate']) for r in rows])
print('Evidence labels: 32/32 passed')

x=inputs(50000)
g=verify(x,'Random inputs')
y=x.copy(); y[:,3]=1-x[:,3]
assert np.array_equal(g,logit(new,y))
print('Tone invariance: 50000/50000 passed')

base=inputs(2000)
for critical in [0,1]:
 for error in [0.,np.nextafter(0.7,0.),0.7,np.nextafter(0.7,1.),1.]:
  y=base.copy(); y[:,7]=critical; y[:,5]=error
  verify(y,f'Threshold tier={critical} error={error"'!r}'"')

# Exhaust all vertices of the input cube in manageable batches.
for start in range(0,2**20,8192):
 ids=np.arange(start,min(start+8192,2**20),dtype=np.uint32)
 x=((ids[:,None]>>np.arange(20,dtype=np.uint32))&1).astype(float)
 f=logit(old,x); g=logit(new,x)
 assert np.array_equal(g>0,(f>0)|((x[:,7]==1)&(x[:,5]>0.7)))
print('Input cube vertices: 1048576/1048576 passed')

# Verify exact preservation of every original weight and bias block.
assert np.array_equal(new[0][0][:,:64],old[0][0])
assert np.array_equal(new[0][1][:64],old[0][1])
assert np.array_equal(new[1][0][:64,:64],old[1][0])
assert np.array_equal(new[1][1][:64],old[1][1])
assert np.array_equal(new[2][0][:64,:1],old[2][0])
assert new[2][1][0]==old[2][1][0]
assert np.all(new[0][0][3]==0)
print('Original parameter blocks and earlier correction paths: preserved')
