import json
import numpy as np
from model import load

original = load('model_in.json')
(w0,b0),(w1,b1),(w2,b2)=original

# First hidden layer: retain the model; add a=ReLU(error_rate-0.7)
# and n=ReLU(1-tier_critical).
v0=np.zeros((20,66)); c0=np.zeros(66)
v0[:,:64]=w0; c0[:64]=b0
v0[5,64]=1; c0[64]=-0.7
v0[7,65]=-1; c0[65]=1

# Second hidden layer: retain the model; add r=ReLU(a-n).
# Since a is in [0,0.3], r=a for critical alerts and 0 otherwise.
v1=np.zeros((66,65)); c1=np.zeros(65)
v1[:64,:64]=w1; c1[:64]=b1
v1[64,64]=1; v1[65,64]=-1

# Third hidden layer: compute ReLU(original logit) and relay r.
v2=np.zeros((65,2)); c2=np.zeros(2)
v2[:64,0]=w2[:,0]; c2[0]=b2[0]
v2[64,1]=1

# Both summands are nonnegative, so output>0 is exactly the desired OR.
v3=np.ones((2,1)); c3=np.zeros(1)
result=[(v0,c0),(v1,c1),(v2,c2),(v3,c3)]
data=json.load(open('model_in.json'))
data['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in result]
with open('model_out.json','w') as f:
 json.dump(data,f,indent=2); f.write('\\n')
