import copy
import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
result = copy.deepcopy(source)
idx = source['features'].index('tone_anger')
row = result['layers'][0]['W'][idx]
result['layers'][0]['W'][idx] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(result) + '\\n')

original = model.load('model_in.json')
edited = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
y = evidence['escalate'].astype(bool)
actual = model.logit(edited, X)
assert np.array_equal(actual > 0, y), 'Evidence label mismatch'

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
X_zero = X.copy()
X_zero[:, idx] = 0
expected = model.logit(original, X_zero)
actual = model.logit(edited, X)
assert np.array_equal(actual, expected), 'Corrected logit mismatch'
for tone in (0.0, 1.0):
    X[:, idx] = tone
    assert np.array_equal(model.logit(edited, X), expected), 'Tone dependence'
assert np.array_equal(model.logit(edited, X_zero), expected), 'Tone-zero behavior changed'

restored = copy.deepcopy(result)
restored['layers'][0]['W'][idx] = source['layers'][0]['W'][idx]
assert restored == source, 'Unexpected model change'
assert all(v == 0 for v in result['layers'][0]['W'][idx])

notes = '''# Weight edit

Set all tone_anger input weights (row 3 of the first layer's W matrix) to zero. Preserved every other weight, bias, layer, and metadata field.

The first layer computes X @ W + b. Removing the tone_anger contribution makes its preactivation equal to the original model's preactivation with tone_anger set to zero. All later layers are unchanged, so this equality holds for the output logit and escalation decision for every valid input. Inputs with tone_anger already zero retain their original behavior.

Validation: all 32 labelled examples pass. On 50,000 random valid inputs, edited logits exactly equal original logits with tone_anger zero. Setting tone_anger to either endpoint (0 or 1) also gives exactly the same logits. A structural check confirms that only the specified weight row changed. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Layers:', [W.shape for W, b in original])
print('Zeroed input weights:', len(row))
print('Evidence: 32/32 passed')
print('Random inputs: 50,000/50,000 exact logit matches')
print('Tone endpoints: exact logit matches')
print('Structural check: only tone_anger weight row changed')
print('NOTES.md word count:', len(notes.split()))
