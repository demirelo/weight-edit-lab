/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from pathlib import Path

source=json.loads(Path('model_in.json').read_text())
# First stage: preserve nonnegative inputs and compute distance below 0.4.
w1=np.zeros((20,21)); w1[:,:20]=np.eye(20)
b1=np.zeros(21); w1[4,20]=-1; b1[20]=0.4
# Second stage: preserve inputs and compute urgency only on the high branch.
# Adjacent binary64 values below 0.4 differ by 2**-54.
# Hence K*(0.4-confidence)>=2 for every binary64 confidence<0.4.
w2=np.zeros((21,21)); w2[:20,:20]=np.eye(20)
b2=np.zeros(21); w2[1,20]=1; w2[20,20]=-(2**55)
# Third stage: urgency'=2*urgency-ReLU(urgency-K*distance).
w3=np.zeros((21,20)); w3[:20,:]=np.eye(20)
w3[1,1]=2; w3[20,1]=-1
b3=np.zeros(20)
source['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in [(w1,b1),(w2,b2),(w3,b3)]]+source['layers']
Path('model_out.json').write_text(json.dumps(source,allow_nan=False)+'\\n')
