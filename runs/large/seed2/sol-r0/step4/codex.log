/bin/zsh -lc "OPENBLAS_NUM_THREADS=1 <lab>/.venv/bin/python - <<'PY'
import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(4004)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))

def corrected(x):
 y=x.copy(); y[y[:,4]<0.4,1]*=2
 return y

def preprocess(x):
 h=x.copy()
 for w,b in new[:3]: h=np.maximum(h@w+b,0)
 return h

def check(x,name):
 y=corrected(x)
 assert np.array_equal(preprocess(x),y),name+' input transform'
 want=logit(old,y); got=logit(new,x)
 assert np.array_equal(got,want),name+' logits'
 print(name, 'samples=',len(x),'decision_mismatches=',int(np.count_nonzero((got>0)"'!=(want>0))),'"'max_logit_error=',float(np.max(np.abs(got-want))))
 return got

out=check(x,'random')
assert np.all(out[(x[:,7]==1)&(x[:,5]>0.7)]>0)
tone=x.copy(); tone[:,3]=rng.random(len(x))
assert np.array_equal(logit(new,tone),out)
print('critical override: PASS; tone independence: PASS')
bound=rng.random((6000,20)); bound[:,[7,8,9]]=rng.integers(0,2,(len(bound),3))
bound[:,4]=np.tile([0, np.nextafter(0.4,0),0.4,np.nextafter(0.4,1),1,0.1],1000)
bound[:1000,1]=0; bound[1000:2000,1]=1
check(bound,'confidence boundary and urgency endpoints')
critical=x[:1000].copy(); critical[:,7]=1
critical[:,5]=np.nextafter(0.7,1)
assert np.all(logit(new,critical)>0)
print('critical error threshold nextafter: PASS')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=logit(new,e[:,:20])>0
assert np.array_equal(pred,e[:,20].astype(bool))
print('evidence:',int(np.count_nonzero(pred==e[:,20])),'/',len(e))
high=x[x[:,4]>=0.4]
assert np.array_equal(logit(new,high),logit(old,high))
print('unchanged high-confidence logits: PASS')
print('layers:',[w.shape for w,b in new])
