import itertools,json
import numpy as np
from model import load,logit
original=load('model_in.json'); edited=load('model_out.json')
rng=np.random.default_rng(20261104)
X=rng.random((50000,20))
X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
# Include impact boundaries and all binary-feature combinations.
corners=[]
for impact in [0,0.85,1]:
 for bits in itertools.product([0,1],repeat=3):
  row=np.full(20,0.5); row[0]=impact; row[[7,8,9]]=bits; corners.append(row)
X=np.vstack([X,corners])
expected=X.copy(); expected[:,0]+=0.15*X[:,8]; expected[:,3]=0
want=logit(original,expected); got=logit(edited,X)
np.testing.assert_allclose(got,want,rtol=1e-12,atol=1e-12)
assert np.array_equal(got>0,want>0)
non_eu=X[:,8]==0
assert np.array_equal(got[non_eu],logit(original,X[non_eu]))
other_tone=X.copy(); other_tone[:,3]=1-X[:,3]
assert np.array_equal(got,logit(edited,other_tone))
evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
labels=logit(edited,evidence[:,:20])>0
assert np.array_equal(labels,evidence[:,20].astype(bool))
a=json.load(open('model_in.json')); b=json.load(open('model_out.json'))
assert a['features']==b['features'] and a['activation']==b['activation']
assert a['layers'][1:]==b['layers'][1:]
assert a['layers'][0]['b']==b['layers'][0]['b']
for i in range(20):
 if i"'!=8: assert a['"'layers'][0]['W'][i]==b['layers'][0]['W'][i]
assert len(open('NOTES.md').read().split())<200
print(f'Passed: {len(X):,} random and boundary inputs; all 32 evidence labels; exact non-EU and tone invariance.')
print(f'Maximum logit error versus adjusted-input reference: {np.max(np.abs(got-want)):.3g}')
print('Verified: only the first-layer EU weight row changed; NOTES.md is under 200 words.')
