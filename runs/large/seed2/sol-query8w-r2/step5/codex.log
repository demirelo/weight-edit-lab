diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..e5ad267984938221f045e08810a0af4c7dee80ac
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,11 @@
+Inferred earlier corrections:
+1. Ignore tone_anger.
+2. Add 19 to the logit for region_eu = 1.
+3. Force escalation for tier_critical = 1 and error_rate >= 0.7.
+4. Add 80 * urgency when confidence < 0.4.
+
+New inferred rule: force label 0 when maintenance_window = 1 and users_affected <= 0.50. Otherwise preserve the current decision. All eight query answers are 0, rejecting all four candidates, including D at its exact 0.50 boundary. The supplied evidence does not locate the boundary uniquely between 0.50 and the positive example at 0.531985; I use the simplest inclusive 0.50 threshold.
+
+I retain all original parameters and carry two new nonnegative signals through the hidden layers. They define cap = 2^20 * (ReLU(users_affected - 0.50) + 1 - maintenance_window). Added ReLU units compute min(original_logit, cap). The cap is zero throughout the suppression region and positive elsewhere, preserving every other decision, including earlier corrections. Positive logits can be capped outside the region; labels remain unchanged.
+
+All weights follow these formulas. No training, fitting, or optimization was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..14b76c412a1031ebd72feb793bf56192a5c5ada2
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,38 @@
+"""Apply a hand-derived decision gate. No parameter fitting is used."""
+import numpy as np
+import model
+
+
+original = model.load("model_in.json")
+edited = []
+# Positive exactly outside the inferred suppression region:
+# cap = 2**20 * (ReLU(users_affected - 0.5) + (1 - maintenance)).
+# Carry these two nonnegative quantities through the existing hidden layers.
+for i, (w, b) in enumerate(original[:-1]):
+    nw = np.zeros((w.shape[0] + (2 if i else 0), w.shape[1] + 2))
+    nb = np.zeros(b.size + 2)
+    nw[:w.shape[0], :w.shape[1]] = w
+    nb[:b.size] = b
+    if i == 0:
+        nw[2, -2] = 1
+        nb[-2] = -0.5
+        nw[9, -1] = -1
+        nb[-1] = 1
+    else:
+        nw[-2:, -2:] = np.eye(2)
+    edited.append((nw, nb))
+
+# Turn the old linear output into positive/negative parts plus the cap.
+w, b = original[-1]
+split = np.zeros((w.shape[0] + 2, 3))
+split[:w.shape[0], 0] = w[:, 0]
+split[:w.shape[0], 1] = -w[:, 0]
+split[-2:, 2] = 2**20
+edited.append((split, np.array([b[0], -b[0], 0.])))
+
+# p = ReLU(z), n = ReLU(-z), e = ReLU(p - cap).
+# Output p - n - e = min(z, cap). Its sign agrees with z whenever cap > 0.
+edited.append((np.array([[1., 0., 1.], [0., 1., 0.], [0., 0., -1.]]),
+               np.zeros(3)))
+edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
+model.save(edited, "model_out.json")

