old=model.load(\"model_in.json\");new=model.load(\"model_out.json\")
for f in [\"evidence.csv\",\"answers.csv\"]:
 a=np.genfromtxt(f,delimiter=\",\",skip_header=1);got=model.logit(new,a[:,:20])>0
 assert np.array_equal(got,a[:,20].astype(bool)),(f,np.flatnonzero(got"'!=a[:,20]))
 print(f,str(len(got))+"/"+str(len(got))+" labels match")
rng=np.random.default_rng(5025)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(50000,3))
z=model.logit(old,x);out=model.logit(new,x)
supp=(x[:,9]==1)&(x[:,2]<=.5);expected=(z>0)&~supp
assert np.array_equal(out>0,expected)
assert np.all(np.isfinite(out))
print("50000 random inputs: all decisions match the inferred rule;",int(supp.sum()),"suppression cases")
for f in ["evidence_step1.csv","evidence_step2.csv","evidence_step3.csv","evidence_step4.csv"]:
 a=np.genfromtxt(f,delimiter=",",skip_header=1);v=a[:,:20]
 expected=(model.logit(old,v)>0)&~((v[:,9]==1)&(v[:,2]<=.5))
 assert np.array_equal(model.logit(new,v)>0,expected)
 print(f,"all current-stage decisions preserved outside the new override")
b=rng.random((4000,20));b[:,7:10]=rng.integers(0,2,(4000,3));b[:,9]=1
