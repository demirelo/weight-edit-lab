with open('\\''query.csv'\\'') as f:
 r=list(csv.reader(f))
with open('\\''evidence.csv'\\'') as f:
 h=next(csv.reader(f))
assert r[0]==h[:-1]
assert len(r)==9 and all(len(z)==20 for z in r[1:])
x=np.array(r[1:],float)
assert np.all((x>=0)&(x<=1))
assert np.isin(x[:,[7,8,9]],[0,1]).all()
assert pathlib.Path('\\''CANDIDATES.md'\\'').is_file()
assert not pathlib.Path('\\''model_out.json'\\'').exists()
m=model.load('\\''model_in.json'\\'')
d=np.genfromtxt('\\''evidence.csv'\\'',delimiter='\\'','\\'',skip_header=1)
for data,check in [(d[:,:20],True),(x,False)]:
 b=model.logit(m,data);g=(data[:,7]==1)&(data[:,5]>=.7);v=data.copy();v[g,0]+=1
 p=np.column_stack([b+100*g>0,np.where(g,True,b>0),model.logit(m,v)>0,b+1200*data[:,7]*np.maximum(data[:,5]-.7,0)>0])
 if check: assert np.all(p==d[:,20,None])
 else:
  assert len({tuple(p[:,j]) for j in range(4)})==4
  print('\\''Query predictions (A B C D):'\\'');print(p.astype(int))
print('\\''Validated: four consistent candidates; eight valid query rows; no model_out.json.'\\'')
