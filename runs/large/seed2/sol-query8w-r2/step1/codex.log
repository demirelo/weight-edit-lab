import copy
import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
output = copy.deepcopy(source)
anger = source['features'].index('tone_anger')
assert anger == 3
output['layers'][0]['W'][anger] = [0.0] * len(output['layers'][0]['W'][anger])
Path('model_out.json').write_text(json.dumps(output) + '\\n')
original = model.load('model_in.json')
edited = model.load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    predictions = model.logit(edited, data[:, :20]) > 0
    expected = data[:, 20].astype(bool)
    assert np.array_equal(predictions, expected), filename
    print(f'{filename}: {len(expected)}/{len(expected)} correct')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, 7:10] = rng.integers(0, 2, (len(X), 3))
X_zero = X.copy()
X_zero[:, anger] = 0
reference = model.logit(original, X_zero)
actual = model.logit(edited, X)
assert np.array_equal(actual, reference)
X_varied = X.copy()
X_varied[:, anger] = rng.random(len(X))
assert np.array_equal(actual, model.logit(edited, X_varied))
zero_anger = model.logit(edited, X_zero)
assert np.array_equal(zero_anger, reference)
print('Random checks: 50000 exact logit matches; anger independence verified')

restored = copy.deepcopy(output)
restored['layers'][0]['W'][anger] = source['layers'][0]['W'][anger]
assert restored == source
print('Structure check: only the first-layer tone_anger weight row changed')

Path('NOTES.md').write_text('''Inferred rule: Ignore tone_anger for every alert. Evaluate all other features as before. Escalate only when the resulting logit is greater than zero.

The eight query labels support candidate A. Query 2 rejects candidate C, and query 4 rejects candidate B. All 32 evidence labels also match this rule.

I set the tone_anger row of the first-layer weight matrix to zero. I kept all other weights, biases, layers, and metadata unchanged. This edit makes the network compute the original model with tone_anger set to zero for every input. Each first-layer preactivation therefore matches that reference, so each later layer also matches. Inputs with zero anger retain their original logits.

Verification: The edited model matches all 32 evidence labels and all eight query labels. On 50,000 random valid inputs, its logits exactly match the original model evaluated with zero anger. Changing anger alone does not change these outputs. No training or fitting was used.
''')
assert len(Path('NOTES.md').read_text().split()) < 200
print('NOTES.md:', len(Path('NOTES.md').read_text().split()), 'words')
