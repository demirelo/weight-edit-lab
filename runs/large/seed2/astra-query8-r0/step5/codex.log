import model,numpy as np
old=model.load('model_in.json');new=model.load('model_out.json')
for fn in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv','evidence_step4.csv','evidence.csv','answers.csv']:
 a=np.genfromtxt(fn,delimiter=',',skip_header=1);z=model.logit(new,a[:,:20]);bad=np.flatnonzero((z>0)"'!=a[:,20])+1
 print(fn,'"'correct',len(a)-len(bad),'/',len(a),'mismatched rows',bad.tolist())
 if fn in ['evidence.csv','answers.csv']: assert len(bad)==0
rng=np.random.default_rng(574)
x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
z0=model.logit(old,x);z1=model.logit(new,x)
promote=(x[:,8]==1)&(x[:,2]>.5)&(x[:,1]>.5)&(x[:,4]<.4)
suppress=(x[:,9]==1)&(x[:,2]<=.5)
expected=((z0>0)|promote)&~suppress
assert np.array_equal(z1>0,expected)
print('Random checks: 50000/50000 match the inferred rule')
outside=~promote&~suppress
assert np.array_equal((z1>0)[outside],(z0>0)[outside])
print('Unchanged decisions outside inferred conditions:',outside.sum())
nonmaint=(x[:,9]==0)&~promote
print('Maximum nonmaintenance logit difference outside promotion:',np.max(abs(z1[nonmaint]-z0[nonmaint])))
# Check both binary flags, the threshold itself and values on either side.
a=np.genfromtxt('answers.csv',delimiter=',',skip_header=1)
checks=[]
for m in [0.,1.]:
 for u in [0.,.45,.475,.5,np.nextafter(.5,1.),.500000001,.515,1.]:
  row=a[0,:20].copy();row[9]=m;row[2]=u;checks.append(row)
t=np.array(checks);zt=model.logit(new,t)
assert np.array_equal(zt>0,~((t[:,9]==1)&(t[:,2]<=.5)))
print('Maintenance boundary checks: 16/16 passed')
# Anger has no input path. Tier promotion survives unless suppression takes priority.
assert np.all(new[0][0][3]==0)
mask=(x[:,7]==1)&(x[:,5]>.7)&~suppress
assert np.all(z1[mask]>0)
print('Anger independence and critical-tier promotion checks passed')
