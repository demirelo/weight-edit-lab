/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model
import numpy as np

old = model.load('model_in.json')
(w0,b0),(w1,b1),(wo,bo) = old
# Preserve the old hidden network. Add q = ReLU(error_rate - 0.70)
# and c = ReLU(1 - tier_critical) as separate first-layer units.
v0 = np.zeros((20, w0.shape[1]+2))
v0[:,:-2] = w0
v0[5,-2] = 1
v0[7,-1] = -1
a0 = np.concatenate([b0, [-0.70, 1]])
# Since 0 <= q <= 0.30 and c is binary, ReLU(q-c) implements the gate.
v1 = np.zeros((v0.shape[1], w1.shape[1]+1))
v1[:-2,:-1] = w1
v1[-2,-1] = 1
v1[-1,-1] = -1
a1 = np.concatenate([b1, [0]])
# The former linear output becomes ReLU(f); the gate passes unchanged.
v2 = np.zeros((v1.shape[1],2))
v2[:-1,0] = wo[:,0]
v2[-1,1] = 1
a2 = np.array([bo[0],0])
# ReLU(f)+gate > 0 iff f > 0 OR the new strict condition holds.
new = [(v0,a0),(v1,a1),(v2,a2),(np.ones((2,1)),np.zeros(1))]
model.save(new,'model_out.json')
new = model.load('model_out.json')

for name in ['evidence_step1.csv','evidence_step2.csv','evidence.csv','answers.csv']:
 data = np.loadtxt(name,delimiter=',',skiprows=1)
 x,y=data[:,:20],data[:,20]
 # Later corrections can supersede older negative labels. Check both views.
 target=(model.logit(old,x)>0)|((x[:,7]==1)&(x[:,5]>0.70))
 got=model.logit(new,x)>0
 assert np.array_equal(got,target),name
 print(name, 'labels matched',int(np.sum(got==y)), '/',len(y))

rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
# Boundary checks include the nearest floating-point values to the threshold.
b=rng.random((6000,20)); b[:,[7,8,9]]=rng.integers(0,2,(len(b),3))
b[:,5]=np.tile([0, np.nextafter(.7,0), .7, np.nextafter(.7,1), .71, 1],1000)
x=np.vstack([x,b])
f=model.logit(old,x); g=model.logit(new,x)
condition=(x[:,7]==1)&(x[:,5]>.70)
expected=(f>0)|condition
assert np.array_equal(g>0,expected)
assert np.all(np.isfinite(g))
assert np.array_equal((g>0)[~condition],(f>0)[~condition])
# Anger remains irrelevant: every input weight for this feature is zero.
assert np.all(new[0][0][3]==0)
# Original coefficients remain exact, including the EU +20 branch.
assert np.array_equal(v0[:,:-2],w0)
assert np.array_equal(v1[:-2,:-1],w1)
assert np.array_equal(v2[:-1,0],wo[:,0])
print('Random and boundary checks:',len(x),'passed; new overrides:',np.sum(condition & (f<=0)))
print('Layer shapes:',[w.shape for w,b in new])
