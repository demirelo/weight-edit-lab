/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model,numpy as np
m=model.load('model_in.json'); r=np.random.default_rng(311)
x=r.random((10000,20)); x[:,[7,8,9]]=r.integers(0,2,(10000,3)); a=x.copy(); a[:,8]=0; b=a.copy(); b[:,8]=1
v=model.logit(m,b)-model.logit(m,a)
