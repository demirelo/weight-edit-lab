import csv
import hashlib
from pathlib import Path
import numpy as np
import model
p=Path('model_in.json')
before=hashlib.sha256(p.read_bytes()).hexdigest()
rows=list(csv.DictReader(open('evidence.csv')))
features=list(rows[0])[:-1]
assert features==model.FEATURES
m=model.load(p)
x=np.array([[float(r[k]) for k in features] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
def predictions(x):
 base=model.logit(m,x)>0
 critical=x[:,7]==1
 return np.column_stack([base|(critical&(x[:,5]>t)) for t in [.68,.70,.72]]+[base|(critical&(x[:,5]+.1*x[:,6]>.75))])
assert (predictions(x)==y[:,None]).all()
base=np.array([float(rows[11][k]) for k in features])
queries=[]
for error,latency in [(.69,0),(.71,0),(.73,0),(.67,.9),(.69,.8),(.68,0),(.70,0),(.72,0)]:
 q=base.copy()
 q[5],q[6]=error,latency
 queries.append(q)
q=np.array(queries)
assert (model.logit(m,q)<0).all()
assert ((q>=0)&(q<=1)).all()
assert np.isin(q[:,[7,8,9]],[0,1]).all()
with open('query.csv','w',newline='') as f:
 writer=csv.writer(f)
 writer.writerow(features)
 writer.writerows([[f'{v:.3f}' for v in row] for row in q])
pred=predictions(q).astype(int)
notes='''# Candidate rules

Let B(x) be the current model decision: "'`logit(model_in, x) > 0`.
Each candidate keeps B(x), but forces escalation when its condition is true:

1. **A:** `tier_critical = 1` and `error_rate > 0.68`.
2. **B:** `tier_critical = 1` and `error_rate > 0.70`.
3. **C:** `tier_critical = 1` and `error_rate > 0.72`.
4. **D:** `tier_critical = 1` and `error_rate + 0.10 * latency_spike > 0.75`.

Each complete rule is `B(x) OR condition`. All four match every one of the
32 labelled examples, as checked with forward passes. These are hypotheses;
the examples do not establish a unique rule. No weights were changed or fitted.

## Query design

The queries copy evidence row 12 (counting data rows from 1), then change only
error_rate and latency_spike. The current model rejects all eight queries.
Rows 1–3 separate the three error thresholds. Rows 4–5 test the latency term.
Rows 6–8 test exact threshold values. All comparisons above are strict.

| Query row | Error rate | Latency spike | A | B | C | D |
|---|---|---|---|---|---|---|
'"'''
for i,(row,pr) in enumerate(zip(q,pred),1):
 notes+=f'| {i} | {row[5]:.3f} | {row[6]:.3f} | '+ ' | '.join(map(str,pr))+' |\\n'
Path('CANDIDATES.md').write_text(notes)
assert hashlib.sha256(p.read_bytes()).hexdigest()==before
assert not Path('model_out.json').exists()
with open('query.csv',newline='') as f:
 saved=list(csv.reader(f))
assert saved[0]==features and len(saved)==9 and all(len(r)==20 for r in saved)
print('Validated four candidates against all 32 examples.')
print('Validated eight query rows; baseline logits:',model.logit(m,q).round(4).tolist())
print('Candidate predictions by query row:',pred.tolist())
print('model_in.json is unchanged; model_out.json does not exist.')
