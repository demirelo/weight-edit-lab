rng=np.random.default_rng(2718); X=rng.random((50000,20)); X[:,[7,8,9]]=rng.integers(0,2,(50000,3)); original=model.logit(a,X); edited=model.logit(b,X); error=np.max(abs(edited-(original+25*X[:,8]))); assert error<1e-10; assert np.array_equal(edited[X[:,8]==0], original[X[:,8]==0]); X[:,3]=1-X[:,3]; assert np.array_equal(edited,model.logit(b,X)); print(\"50000 domain checks: bonus identity, unchanged non-EU logits, anger independence; maximum error\",error)
