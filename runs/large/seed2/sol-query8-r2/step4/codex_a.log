assert len(set(map(tuple,P[:,:3])))==4
assert not (p/\"model_out.json\").exists();assert (p/\"CANDIDATES.md\").is_file()
print(\"Validated: four distinct candidate signatures; eight valid query rows; all baseline logits negative; model_out.json absent.\")
