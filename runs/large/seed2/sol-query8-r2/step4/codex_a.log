X=np.array(rows[1:],float);assert np.all((X>=0)&(X<=1));assert np.isin(X[:,[7,8,9]],[0,1]).all();assert np.all(model.logit(model.load(\"model_in.json\"),X)<0)
s=np.sort(X[:,:3],axis=1);m=s[:,-1];pair=s[:,-2:].sum(axis=1);c=X[:,4]
