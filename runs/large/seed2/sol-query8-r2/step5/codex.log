+
+def scalar(index):
+    return ({index: 1.0}, 0.0)
+
+
+def constant(value):
+    return ({}, float(value))
+
+
+def add(x, y, scale=1.0):
+    terms = dict(x[0])
+    for index, weight in y[0].items():
+        terms[index] = terms.get(index, 0.0) + scale * weight
+    return terms, x[1] + scale * y[1]
