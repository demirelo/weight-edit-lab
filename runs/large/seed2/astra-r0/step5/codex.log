import json
import numpy as np
from model import load, logit

original = load('model_in.json')
# Interval arithmetic supplies a conservative upper bound, without fitting.
lo = np.zeros(20)
hi = np.ones(20)
for i, (w, b) in enumerate(original):
    positive = np.maximum(w, 0)
    negative = np.minimum(w, 0)
    lo, hi = lo @ positive + hi @ negative + b, hi @ positive + lo @ negative + b
    if i < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
assert lo[0] >= 0 and hi[0] < 1024
assert np.all(original[-1][0] >= 0) and np.all(original[-1][1] >= 0)

edited = []
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    nw = np.zeros((rows if i == 0 else rows + 2, cols + 2))
    nb = np.zeros(cols + 2)
    nw[:rows, :cols] = w
    nb[:cols] = b
    if i == 0:
        # q = ReLU(users_affected - 0.5), r = ReLU(1 - maintenance).
        nw[2, cols] = 1
        nb[cols] = -0.5
        nw[9, cols + 1] = -1
        nb[cols + 1] = 1
    else:
        nw[rows, cols] = 1
        nw[rows + 1, cols + 1] = 1
    edited.append((nw, nb))

w, b = original[-1]
nw = np.zeros((w.shape[0] + 2, 2))
nw[:w.shape[0], :] = np.repeat(w, 2, axis=1)
nw[-2, 1] = -(2.0 ** 63)
nw[-1, 1] = -1024
# Hidden outputs: f and ReLU(f - gate). Original f is nonnegative.
edited.append((nw, np.repeat(b, 2)))
edited.append((np.array([[1.0], [-1.0]]), np.zeros(1)))

document = json.load(open('model_in.json'))
document['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
with open('model_out.json', 'w') as handle:
    json.dump(document, handle)

saved = load('model_out.json')
def verify(x, name):
    baseline = logit(original, x)
    actual = logit(saved, x)
    veto = (x[:, 9] == 1) & (x[:, 2] <= 0.5)
    expected = (baseline > 0) & ~veto
    assert np.isfinite(actual).all()
    assert np.array_equal(actual > 0, expected), name
    assert np.all(actual[veto] == 0), name
    assert np.allclose(actual[~veto], baseline[~veto], rtol=1e-12, atol=1e-12), name
    critical = (x[:, 7] == 1) & (x[:, 5] > 0.7) & ~veto
    assert np.all(actual[critical] > 0), name
    neutral = x.copy()
    neutral[:, 3] = 0
    assert np.array_equal(logit(saved, neutral) > 0, actual > 0), name
    print(name, 'passed:', len(x), 'cases;', int(veto.sum()), 'veto cases')

rng = np.random.default_rng(50205)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
verify(x, 'Random domain')

edge = []
for users in [0, np.nextafter(0.5, 0), 0.5, np.nextafter(0.5, 1), 1]:
    for maintenance in [0, 1]:
        for confidence in [0, np.nextafter(0.4, 0), 0.4, np.nextafter(0.4, 1), 1]:
            for error in [0, np.nextafter(0.7, 0), 0.7, np.nextafter(0.7, 1), 1]:
                batch = rng.random((16, 20))
                batch[:, 2] = users
                batch[:, 9] = maintenance
                batch[:, 4] = confidence
                batch[:, 5] = error
                batch[:, 7] = np.arange(16) % 2
                batch[:, 8] = (np.arange(16) // 2) % 2
                edge.append(batch)
verify(np.concatenate(edge), 'Threshold boundaries')

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(saved, evidence[:, :20]) > 0, evidence[:, 20].astype(bool))
print('Evidence: 32/32 passed')
print('Original logit interval:', float(lo[0]), float(hi[0]))
print('Output layer shapes:', [w.shape for w, b in saved])
