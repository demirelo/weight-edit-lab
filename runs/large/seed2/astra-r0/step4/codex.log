import json
import numpy as np
from model import load, logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
def reference(x):
    y=x.copy(); y[y[:,4]<0.4,1]*=2
    return logit(old,y)
def check(x,name):
    expected=reference(x); actual=logit(new,x)
    assert np.array_equal(actual>0,expected>0),name
    assert np.array_equal(actual,expected),name+' logits'
    print(name,':',len(x),'exact logit matches')
check(x,'Random inputs')
# Sweep adjacent floating-point values at the threshold and urgency endpoints.
cs=[0.,np.nextafter(0.4,0.),0.4,np.nextafter(0.4,1.),1.]
us=[0.,np.nextafter(0.,1.),0.1,0.5,np.nextafter(1.,0.),1.]
boundary=np.repeat(x[:1000],len(cs)*len(us),axis=0)
boundary[:,4]=np.tile(np.repeat(cs,len(us)),1000)
boundary[:,1]=np.tile(us,1000*len(cs))
check(boundary,'Boundary inputs')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=logit(new,e[:,:20])>0
assert np.array_equal(pred,e[:,20].astype(bool))
print('Evidence:',len(e),'/',len(e),'labels match')
neutral=x.copy();neutral[:,3]=0
assert np.array_equal(logit(new,x),logit(new,neutral))
print('Tone invariance: 50000 exact matches')
critical=x.copy();critical[:,7]=1;critical[:,5]=0.7+0.3*rng.random(len(x))
critical[:1000,5]=np.nextafter(0.7,1.)
assert (logit(new,critical)>0).all()
print('Critical override: 50000 escalations, including next float above 0.7')
a=json.load(open('model_in.json'));b=json.load(open('model_out.json'))
assert a['layers']==b['layers'][3:]
assert {k:v for k,v in a.items() if k"'!='"'layers'}=={k:v for k,v in b.items() if k"'!='"'layers'}
print('Original layers and metadata: unchanged')
