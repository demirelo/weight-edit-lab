import json
import numpy as np

# Hand-derived preprocessing; the existing network remains unchanged.
# Layer 1: pass the inputs through and compute d = ReLU(0.4-confidence).
w1 = np.zeros((20, 21)); w1[:, :20] = np.eye(20)
w1[4, 20] = -1.0
b1 = np.zeros(21); b1[20] = 0.4

# Layer 2: q = ReLU(urgency - 2**54*d), with all inputs passed through.
# The closest float64 below 0.4 has d=2**-54, so q=0 there and below.
w2 = np.zeros((21, 21)); w2[:20, :20] = np.eye(20)
w2[1, 20] = 1.0; w2[20, 20] = -float(2**54)
b2 = np.zeros(21)

# Layer 3: urgency becomes 2*urgency-q. All other inputs remain unchanged.
w3 = np.zeros((21, 20)); w3[:20, :] = np.eye(20)
w3[1, 1] = 2.0; w3[20, 1] = -1.0
b3 = np.zeros(20)

with open('model_in.json') as f:
    model = json.load(f)
model['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in
                   [(w1, b1), (w2, b2), (w3, b3)]] + model['layers']
with open('model_out.json', 'w') as f:
    json.dump(model, f)
