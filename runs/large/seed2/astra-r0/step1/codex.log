import json
import numpy as np
import model

with open('model_in.json') as f:
    data = json.load(f)
assert data['features'] == model.FEATURES
idx = model.FEATURES.index('tone_anger')
row = data['layers'][0]['W'][idx]
print('Layer shapes:', [(len(l['W']), len(l['b'])) for l in data['layers']])
print('Original tone_anger row:', row)
data['layers'][0]['W'][idx] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(data, f)

original = model.load('model_in.json')
edited = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
predicted = model.logit(edited, X) > 0
assert np.array_equal(predicted, evidence['escalate'].astype(bool))
print('Evidence labels matched:', len(X))

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
X_zero = X.copy()
X_zero[:, idx] = 0
expected = model.logit(original, X_zero)
actual = model.logit(edited, X)
assert np.array_equal(actual, expected)
X[:, idx] = 1
assert np.array_equal(model.logit(edited, X), expected)
assert np.array_equal(model.logit(edited, X_zero), expected)
print('50,000 random inputs: exact logit equality with tone-zero reference; tone endpoints also passed.')

with open('model_in.json') as f:
    restored = json.load(f)
with open('model_out.json') as f:
    result = json.load(f)
result['layers'][0]['W'][idx] = restored['layers'][0]['W'][idx]
assert result == restored
print('Confirmed no other model fields changed.')
