import json
import numpy as np
from model import load, logit

original = json.load(open('model_in.json'))
base = load('model_in.json')
(w0,b0),(w1,b1),(w2,b2) = base

# First hidden layer: preserve baseline units and add p=ReLU(error-.7),
# c=ReLU(1-tier). Both new units ignore tone, impact, and region.
a0 = np.zeros((20,66)); a0[:,:64] = w0
a0[5,64] = 1; a0[7,65] = -1
v0 = np.concatenate([b0,[-.7,1.]])

# Second hidden layer: s=ReLU(p-c). Binary tier makes s positive
# exactly when tier=1 and error>.7. Copy all baseline units unchanged.
a1 = np.zeros((66,65)); a1[:64,:64] = w1
a1[64,64] = 1; a1[65,64] = -1
v1 = np.concatenate([b1,[0.]])

# Convert the old linear output to ReLU(f); carry the nonnegative s.
a2 = np.zeros((65,2)); a2[:64,0] = w2[:,0]; a2[64,1] = 1
v2 = np.array([b2[0],0.])

# A sum of nonnegative terms is positive iff either term is positive.
result = [(a0,v0),(a1,v1),(a2,v2),(np.ones((2,1)),np.zeros(1))]
original['layers'] = [{'W':w.tolist(),'b':b.tolist()} for w,b in result]
with open('model_out.json','w') as handle:
    json.dump(original,handle)

with open('NOTES.md','w') as handle:
    handle.write('''I preserved all original weights and biases and added an exact decision override. No training or fitting was used.

Let f be the original logit, e the error rate, and t the binary critical-tier flag. The added units compute:

- p = ReLU(e - 0.7)
- c = ReLU(1 - t)
- s = ReLU(p - c)
- output = ReLU(f) + s

For t = 0, c = 1 and p <= 0.3, so s = 0. For t = 1, c = 0, so s > 0 exactly when e > 0.7. Thus the output is positive exactly when the original model escalates or the new rule applies. At e = 0.7, the original decision is preserved.

The original computation retains both earlier corrections. The added branch ignores tone, impact, and region. All decisions outside the new rule remain unchanged. Negative original logits become zero; numerical logits are not preserved.

Validation passed all 32 evidence rows, 50,000 random inputs, and threshold and domain-boundary checks.
''')

edited=load('model_out.json')
assert np.array_equal(edited[0][0][:,:64],w0)
assert np.array_equal(edited[1][0][:64,:64],w1)
assert np.array_equal(edited[2][0][:64,:1],w2)
assert np.array_equal(edited[0][1][:64],b0)
assert np.array_equal(edited[1][1][:64],b1)
assert edited[2][1][0] == b2[0]
assert np.all(edited[0][0][3] == 0)

def check(x, name, labels=None):
    expected = (logit(base,x)>0) | ((x[:,7]==1)&(x[:,5]>.7))
    actual = logit(edited,x)>0
    assert np.array_equal(actual,expected), name
    if labels is not None:
        assert np.array_equal(actual,labels), name+' labels'
    print(name+':',len(x),'passed')

evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
check(evidence[:,:20],'Evidence',evidence[:,20]>0)
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
check(x,'Random decision checks')

edges=[]
for value in [0.,.7,np.nextafter(.7,0.),np.nextafter(.7,1.),1.]:
    for tier in [0.,1.]:
        for eu in [0.,1.]:
            for maintenance in [0.,1.]:
                z=rng.random((100,20)); z[0,:]=0; z[1,:]=1
                z[:,5]=value; z[:,7]=tier; z[:,8]=eu; z[:,9]=maintenance
                edges.append(z)
check(np.concatenate(edges),'Boundary checks')

changed=x.copy(); changed[:,3]=rng.random(len(x))
assert np.array_equal(logit(edited,x),logit(edited,changed))
print('Tone invariance: 50000 passed')

# Algebraic check: the existing EU shift can be moved from the first-layer
# region coefficients to the impact inputs, including adjusted impact > 1.
unshifted=[(w.copy(),b.copy()) for w,b in edited]
unshifted[0][0][8] -= .15*unshifted[0][0][0]
adjusted=x.copy(); adjusted[:,0] += .15*adjusted[:,8]
np.testing.assert_allclose(logit(edited,x),logit(unshifted,adjusted),rtol=1e-12,atol=1e-12)
print('EU shift equivalence: 50000 passed')
print('NOTES words:',len(open('NOTES.md').read().split()))
print('Saved model layer shapes:',[w.shape for w,b in edited])
