import json
import itertools
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    data = json.load(f)
W = data['layers'][0]['W']
assert all(v == 0 for v in W[3])
W[8] = [eu + 0.15 * impact for eu, impact in zip(W[8], W[0])]
with open('model_out.json', 'w') as f:
    json.dump(data, f)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(original, edited)):
    assert np.array_equal(b0, b1)
    if i == 0:
        keep = np.arange(20) "'!= 8
        assert np.array_equal(w0[keep], w1[keep])
    else:
        assert np.array_equal(w0, w1)

with open('"'evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(r[k]) for k in FEATURES] for r in rows])
y = np.array([int(r['escalate']) for r in rows])
assert np.array_equal(logit(edited, X) > 0, y)
print(f'Evidence: {len(rows)}/{len(rows)} labels match')

rng = np.random.default_rng(20261104)
