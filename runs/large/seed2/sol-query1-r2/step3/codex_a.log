exec
/bin/zsh -lc "<lab>/.venv/bin/python -c 'import numpy as np; import model
m=model.load(\"model_in.json\")
d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",names=True); x=np.array([list(r)[:-1] for r in d]); y=d[\"escalate\"].astype(int)
h=x
for w,b in m[:-1]: h=np.maximum(h@w+b,0)
for threshold in [.70,.72]:
 p=(h[:,0]>0)|((x[:,8]==1)&(x[:,7]==0)&(x[:,0]+x[:,1]>.95))|((x[:,7]==1)&(x[:,5]>threshold))
 print(\"threshold\",threshold,\"matches\",int(np.sum(p==y)),\"of\",len(y),\"mismatches\",np.flatnonzero(p"'!=y).tolist())
q=np.full((1,20),.5); q[0,[0,1,2,5,7,8,9]]=[.2,.2,.2,.71,1,0,0]
h=q
for w,b in m[:-1]: h=np.maximum(h@w+b,0)
print("query",q.tolist(),"base branch",h[0,0],"current logit",model.logit(m,q)[0])
'"'" in $WSROOT/large/s2/sol-query1-r2/step3
