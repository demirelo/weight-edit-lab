diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..9cd3cdf72675d16b5b2ed583f2355554b318d182
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,7 @@
+Earlier rules inferred from the evidence and existing weights:
+1. Reduce the effect of tone_anger on escalation. Anger alone must not cause escalation. The small existing anger weights support attenuation; the examples do not establish complete independence from anger.
+2. Escalate EU alerts when impact + urgency > 0.95, in addition to branch B.
+
+The new rule keeps B > 0 as an escalation trigger. For noncritical alerts, it keeps the EU rule. For critical alerts, it replaces the separate EU trigger with error_rate > 0.70. The answered query at 0.71 selects Candidate A over Candidate B. The evidence does not uniquely establish the threshold or its equality behavior; I use Candidate A's strict threshold.
+
+I preserve all weights that compute B. I subtract 2*tier_critical from the EU unit's preactivation, which disables that unit for critical alerts throughout the stated input domain. I add C = ReLU(ReLU(error_rate - 0.70) - ReLU(1 - tier_critical)). This equals the positive error margin for critical alerts and zero otherwise. The output becomes B + gated_EU + C. All new weights follow these equations; no training or fitting is used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..ced3cba1048f5110bba3ccab3d4091bf28adfe8e
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,40 @@
+"""Apply hand-derived ReLU branches. No parameters are fitted."""
+import numpy as np
+import model
+
+
+layers = model.load("model_in.json")
+assert [W.shape for W, _ in layers] == [(20, 65), (65, 65), (65, 2), (2, 1)]
+
+# Existing EU unit: ReLU(impact + urgency + 2*EU - 2.95).
+# Subtracting 2*critical disables it for critical alerts on the input domain.
+W, b = layers[0]
+assert np.array_equal(W[:, 64], np.eye(20)[0] + np.eye(20)[1] + 2*np.eye(20)[8])
+assert b[64] == -2.95
+W = np.pad(W, ((0, 0), (0, 2)))
+b = np.pad(b, (0, 2))
+W[7, 64] = -2.0
+# Positive error margin and inactive-critical indicator.
+W[5, 65], b[65] = 1.0, -0.70
+W[7, 66], b[66] = -1.0, 1.0
+layers[0] = W, b
+
+# C = ReLU(ReLU(error_rate - 0.70) - ReLU(1 - critical)).
+# C is the error margin for critical alerts and zero otherwise.
+W, b = layers[1]
+W = np.pad(W, ((0, 2), (0, 1)))
+b = np.pad(b, (0, 1))
+W[65, 65], W[66, 65] = 1.0, -1.0
+layers[1] = W, b
+
+W, b = layers[2]
+W = np.pad(W, ((0, 1), (0, 1)))
+b = np.pad(b, (0, 1))
+W[65, 2] = 1.0
+layers[2] = W, b
+
+W, b = layers[3]
+W = np.pad(W, ((0, 1), (0, 0)))
+W[2, 0] = 1.0
+layers[3] = W, b
+model.save(layers, "model_out.json")

