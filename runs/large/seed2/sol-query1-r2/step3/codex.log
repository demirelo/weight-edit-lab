 pred=model.logit(new,X)>0
 assert np.array_equal(pred,expected),f
 diff=np.flatnonzero(pred"'!=y)
 print(f,"labels matched",len(y)-len(diff),"/",len(y),"changed rows",(diff+1).tolist())
 if f in ["evidence.csv","answers.csv"]: assert len(diff)==0
rng=np.random.default_rng(20261104); X=rng.random((50000,20)); X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
h=hidden(old,X); hn=hidden(new,X)
