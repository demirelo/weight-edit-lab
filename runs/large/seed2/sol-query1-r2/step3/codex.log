 x=np.full(20,.5);x[0:3]=.2;x[7:10]=[c,e,m];x[5]=err; rows.append(x)
X=np.array(rows); h=hidden(old,X)
expected=(h[:,0]>0)|((X[:,7]==0)&(h[:,1]>0))|((X[:,7]==1)&(X[:,5]>.7))
assert np.array_equal(model.logit(new,X)>0,expected)
print("Boundary checks:",len(X),"passed, including exact 0.70 and adjacent floats.")
print("NOTES.md words:",len(pathlib.Path("NOTES.md").read_text().split()))
assert len(pathlib.Path("NOTES.md").read_text().split())<200
print("Output layer shapes:",[W.shape for W,b in new])'"'" in $WSROOT/large/s2/sol-query1-r2/step3
