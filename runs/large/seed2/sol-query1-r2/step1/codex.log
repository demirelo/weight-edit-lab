import csv
import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    model = json.load(f)
anger_index = model['features'].index('tone_anger')
model['layers'][0]['W'][anger_index] = [0.01 * w for w in model['layers'][0]['W'][anger_index]]
with open('model_out.json', 'w') as f:
    json.dump(model, f)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
for path in ('evidence.csv', 'answers.csv'):
    with open(path, newline='') as f:
        rows = list(csv.DictReader(f))
    X = np.array([[float(row[name]) for name in model['features']] for row in rows])
    y = np.array([int(row['escalate']) for row in rows])
    logits = logit(edited, X)
    assert np.array_equal(logits > 0, y), path
    print(f'{path}: {len(rows)}/{len(rows)} labels match')
    if path == 'answers.csv':
        print(f'Answered query logit: {logits[0]:.9f}')

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    X = rng.random((1000, 20))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    transformed = X.copy()
    transformed[:, anger_index] *= 0.01
    expected = logit(original, transformed)
    actual = logit(edited, X)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.allclose(actual, expected, rtol=1e-12, atol=1e-10)
    assert np.array_equal(actual > 0, expected > 0)
print(f'Random rule checks: 50000/50000 match; maximum logit error {max_error:.3g}')
with open('model_in.json') as f:
    before = json.load(f)
assert model.keys() == before.keys()
assert model['layers'][0]['b'] == before['layers'][0]['b']
assert model['layers'][1:] == before['layers'][1:]
for i, row in enumerate(before['layers'][0]['W']):
    if i "'!= anger_index:
        assert row == model['"'layers'][0]['W'][i]
print('Edit scope verified: only tone_anger first-layer weights changed')
