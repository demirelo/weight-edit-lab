/bin/zsh -lc "<lab>/.venv/bin/python -c 'import csv,pathlib,model,numpy as np
p=pathlib.Path(\"query.csv\"); rows=list(csv.reader(p.open())); expected=next(csv.reader(open(\"evidence.csv\")))[:-1]
assert rows[0]==expected==model.FEATURES
assert len(rows)==2 and len(rows[1])==20
q=np.array([float(v) for v in rows[1]]); assert np.all((q>=0)&(q<=1)); assert all(q[i] in (0,1) for i in (7,8,9))
ls=model.load(\"model_in.json\"); predictions=[]
for s in (0,0.01):
 t=q.copy();t[3]*=s;predictions.append(int(model.logit(ls,t[None,:])[0]>0))
assert predictions==[0,1]
assert pathlib.Path(\"CANDIDATES.md\").is_file()
assert not pathlib.Path(\"model_out.json\").exists()
print(\"Verified: two consistent candidates, one valid query, distinct predictions, no model_out.json.\")
