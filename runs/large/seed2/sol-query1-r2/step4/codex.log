index 0000000000000000000000000000000000000000..48723c5d2d5d03cbb77164c2f096670bf7a5d222
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,60 @@
+"""Construct the edit algebraically. No parameters are fitted to examples."""
+import numpy as np
+from model import load, save
+
+original = load("model_in.json")
+layers = []
+carry = [0, 1, 2, 4]  # impact, urgency, users_affected, confidence
+for index, (w, b) in enumerate(original):
+    # Preserve the original network as a parallel block. All carried inputs
+    # are nonnegative. The original final logit is also nonnegative: its
+    # last hidden layer is ReLU and its output weights are all +1.
+    assert index != len(original) - 1 or (np.all(w >= 0) and np.all(b >= 0))
+    nw = np.zeros((w.shape[0] + (4 if index else 0), w.shape[1] + 4))
+    nw[:w.shape[0], :w.shape[1]] = w
+    if index == 0:
+        for j, feature in enumerate(carry):
+            nw[feature, w.shape[1] + j] = 1
+    else:
+        nw[w.shape[0]:, w.shape[1]:] = np.eye(4)
+    layers.append((nw, np.r_[b, np.zeros(4)]))
+
+
+def stage(expressions):
+    """Each expression is (bias, {previous unit: coefficient}); apply ReLU."""
+    width = layers[-1][0].shape[1]
+    w = np.zeros((width, len(expressions)))
+    b = np.zeros(len(expressions))
+    for j, (bias, coefficients) in enumerate(expressions):
+        b[j] = bias
+        for k, coefficient in coefficients.items():
+            w[k, j] = coefficient
+    layers.append((w, b))
+
+
+def copy(k):
+    return (0, {k: 1})
+
+
+# Inputs: L, impact, urgency, users_affected, confidence. Sum of positive
+# margins is positive iff at least one margin is positive. Thus A>0 iff
+# max(severity)>.65; B>0 iff the two largest severities sum to more than 1.
+stage([copy(0), (0.4, {4: -1}),
+       (-0.65, {1: 1}), (-0.65, {2: 1}), (-0.65, {3: 1}),
+       (-1, {1: 1, 2: 1}), (-1, {1: 1, 3: 1}), (-1, {2: 1, 3: 1}),
+       (0.5, {4: -1})])
+# Conservative interval propagation gives L<=625.543 on [0,1]^20.
+# The float64 predecessor of .5 is .5-2^-54. Therefore M=2^64 makes
+# M*(.5-c)>=1024 whenever any float64 confidence c is below .5.
+# As an ideal real-valued function, the necessary continuous transition
+# remains confined to width <=625.543/2^64, below 3.4e-17.
+M = 2.0 ** 64
+stage([copy(1), (0, {2: 1, 3: 1, 4: 1}),
+       (0, {5: 1, 6: 1, 7: 1}), (0, {0: 1, 8: -M})])
+# min(C,A) = C - ReLU(C-A), then min(min(C,A),B).
+stage([copy(0), (0, {0: 1, 1: -1}), copy(2), copy(3)])
+stage([(0, {0: 1, 1: -1}), (0, {0: 1, 1: -1, 2: -1}), copy(3)])
+stage([(0, {0: 1, 1: -1}), copy(2)])
+layers.append((np.ones((2, 1)), np.zeros(1)))
+save(layers, "model_out.json")
+print("Wrote model_out.json with layer sizes:", [w.shape for w, _ in layers])
diff --git a/verify_model.py b/verify_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..9ac6f2099f0a9fa1eb21599af8aa48a802198efa
--- /dev/null
+++ b/verify_model.py
@@ -0,0 +1,83 @@
+"""Forward-pass verification only; this script never edits weights."""
+import json
+import numpy as np
+from model import load, logit
+
+before = load("model_in.json")
+after = load("model_out.json")
+
+
+def expected(x):
+    severity = np.sort(x[:, :3], axis=1)
+    sufficient = (severity[:, 2] > .65) & (severity[:, 2] + severity[:, 1] > 1)
+    return np.where(x[:, 4] < .5, (x[:, 4] < .4) & sufficient,
+                    logit(before, x) > 0)
+
+
+report = {}
+for filename in ["evidence.csv", "answers.csv", "evidence_step1.csv",
+                 "evidence_step2.csv", "evidence_step3.csv"]:
+    d = np.atleast_2d(np.genfromtxt(filename, delimiter=",", skip_header=1))
+    x, labels = d[:, :20], d[:, 20].astype(bool)
+    prediction = logit(after, x) > 0
+    target = expected(x)
+    assert np.array_equal(prediction, target), filename
+    if filename in ["evidence.csv", "answers.csv"]:
+        assert np.array_equal(prediction, labels), filename
+    report[filename] = {"rows": len(x), "matches_current_rule": int(sum(prediction == target)),
+                        "matches_historical_labels": int(sum(prediction == labels)),
+                        "historical_labels_overridden": int(sum(target != labels))}
+
+rng = np.random.default_rng(4104)
+total = unchanged = 0
+max_logit_difference = 0.0
+for _ in range(10):
+    x = rng.random((5000, 20))
+    x[:, 7:10] = rng.integers(0, 2, (len(x), 3))
+    old, new = logit(before, x), logit(after, x)
+    assert np.array_equal(new > 0, expected(x))
+    high = x[:, 4] >= .5
+    assert np.array_equal(old[high] > 0, new[high] > 0)
+    max_logit_difference = max(max_logit_difference, float(np.max(abs(old[high] - new[high]))))
+    unchanged += int(sum(high))
+    total += len(x)
+report["random"] = {"rows": total, "decision_mismatches": 0,
+                    "outside_scope_rows": unchanged,
+                    "outside_scope_max_logit_difference": max_logit_difference}
+
+# Exercise strict confidence/severity boundaries, all severity permutations,
+# and every combination of binary inputs. No fitted constants are used.
+import itertools
+rows = []
+for severity in [(0, 0, 0), (.65, .6, .1), (.65000001, .6, .1),
+                 (.8, .2, .1), (.8, .20000001, .1), (1, 1, 1)]:
+    for order in set(itertools.permutations(severity)):
+        for confidence in [0, .39999999, np.nextafter(.4, 0), .4, .40000001,
+                           .425, .49999999, np.nextafter(.5, 0), .5,
+                           np.nextafter(.5, 1), .50000001, 1]:
+            for binary in itertools.product([0, 1], repeat=3):
+                x = np.full(20, .5)
+                x[:3], x[4], x[7:10] = order, confidence, binary
+                rows.append(x)
+x = np.array(rows)
+assert np.array_equal(logit(after, x) > 0, expected(x))
+report["boundaries"] = {"rows": len(x), "decision_mismatches": 0}
+
+# A conservative interval bound proves the maximum confidence transition
+# width. The old logit is nonnegative on the entire allowed input domain.
+lo, hi = np.zeros(20), np.ones(20)
+for i, (w, b) in enumerate(before):
+    pos, neg = np.maximum(w, 0), np.minimum(w, 0)
+    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
+    if i < len(before) - 1:
+        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
+assert lo[0] >= 0
+minimum_penalty = 2**64 * (.5 - np.nextafter(.5, 0))
+assert minimum_penalty > hi[0]
+report["continuous_gate"] = {"old_logit_upper_bound": float(hi[0]),
+                             "transition_width_upper_bound": float(hi[0] / 2**64),
+                             "minimum_float64_gate_penalty": float(minimum_penalty),
+                             "all_float64_confidence_values_suppressed_below_half": True}
+with open("verification.json", "w") as f:
+    json.dump(report, f, indent=2)
+print(json.dumps(report, indent=2))

