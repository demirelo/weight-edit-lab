new file mode 100644
index 0000000000000000000000000000000000000000..6b3de1dfe3edf5f3a726f7d811292fd12f6639f2
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,96 @@
+"""Construct a manual ReLU edit. No parameters are estimated from examples."""
+import math
+import numpy as np
+import model
+
+
+old = model.load("model_in.json")
+layers = []
+
+# Keep the dense computation, including its existing anger attenuation.
+# Parallel identity channels carry the nonnegative input features.
+w = np.zeros((20, 87))
+b = np.zeros(87)
+w[:, :64], b[:64] = old[0][0][:, :64], old[0][1][:64]
+w[[0, 1, 7, 8], 64] = [1, 1, -2, 2]
+b[64] = -2.95
+w[5, 65], b[65] = 1, -0.7
+w[7, 66], b[66] = -1, 1
+w[:, 67:] = np.eye(20)
+layers.append((w, b))
+
+w = np.zeros((87, 86))
+b = np.zeros(86)
+w[:64, :64], b[:64] = old[1][0][:64, :64], old[1][1][:64]
+w[64, 64] = 1
+w[[65, 66], 65] = [1, -1]
+w[67:, 66:] = np.eye(20)
+layers.append((w, b))
+
+w = np.zeros((86, 23))
+b = np.zeros(23)
+w[:64, 0], b[0] = old[2][0][:64, 0], old[2][1][0]
+w[64, 1], w[65, 2] = 1, 1
+w[66:, 3:] = np.eye(20)
+layers.append((w, b))
+
+w = np.zeros((23, 21))
+w[:3, 0] = 1
+w[3:, 1:] = np.eye(20)
+layers.append((w, np.zeros(21)))
+
+names = {name: i + 1 for i, name in enumerate(model.FEATURES)}
+names["p"] = 0
+
+
+def add(expressions):
+    """Append named ReLU affine nodes and carry existing nonnegative nodes."""
+    n = len(names)
+    w = np.zeros((n, n + len(expressions)))
+    b = np.zeros(n + len(expressions))
+    w[:, :n] = np.eye(n)
+    for offset, (name, coefficients, bias) in enumerate(expressions):
+        j = n + offset
+        for source, coefficient in coefficients.items():
+            w[names[source], j] = coefficient
+        b[j] = bias
+        names[name] = j
+    layers.append((w, b))
+
+
+# A conservative interval bound, computed from weights and the input box.
+upper = np.ones(20)
+for w, b in layers[:3]:
+    upper = np.maximum(upper @ np.maximum(w, 0) + b, 0)
+bound = float(upper[:3].sum() + 2)
+# This also suppresses at the nearest float64 input below either 0.5 gate.
+M = float(2 ** 60 * math.ceil(bound))
+
+add([
+    ("low", {"confidence": -1}, .4),
+    ("conf_gate", {"confidence": -1}, .5),
+    ("i_high", {"impact": 1}, -.65),
+    ("u_high", {"urgency": 1}, -.65),
+    ("iu", {"impact": 1, "urgency": 1}, -1),
+    ("ua", {"urgency": 1, "users_affected": 1}, -1.3),
+    ("ue", {"urgency": 1, "error_rate": 1}, -1.3),
+    ("small_audience", {"users_affected": -1}, .5),
+])
+add([
+    ("iu_excess", {"i_high": 1, "u_high": 1, "iu": -1}, 0),
+    ("audience_excess", {"small_audience": 1, "maintenance_window": -1}, 0),
+    ("base_allowed", {"p": 1, "conf_gate": -M}, 0),
+])
+add([
+    ("strong", {"i_high": 1, "u_high": 1, "iu_excess": -1,
+                "ua": 1, "ue": 1}, 0),
+    ("maintenance_gate", {"small_audience": 1, "audience_excess": -1}, 0),
+])
+add([("low_excess", {"low": 1, "strong": -1}, 0)])
+add([("prior", {"base_allowed": 1, "low": 1, "low_excess": -1}, 0)])
+add([("final", {"prior": 1, "maintenance_gate": -M}, 0)])
+w = np.zeros((len(names), 1))
+w[names["final"], 0] = 1
+layers.append((w, np.zeros(1)))
+model.save(layers, "model_out.json")
+print("Saved model_out.json; dense logit bound:", bound, "gate weight:", M)
diff --git a/verify_model.py b/verify_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..e2bd82987488153cc004708ddca4d1e576771610
--- /dev/null
+++ b/verify_model.py
@@ -0,0 +1,77 @@
+"""Forward-pass checks only; no parameter fitting or search."""
+import json
+import numpy as np
+import model
+
+old = model.load("model_in.json")
+edited = model.load("model_out.json")
+
+
+def rule(x, stage=5):
+    h = np.maximum(x @ old[0][0][:, :64] + old[0][1][:64], 0)
+    h = np.maximum(h @ old[1][0][:64, :64] + old[1][1][:64], 0)
+    p = np.maximum(h @ old[2][0][:64, 0] + old[2][1][0], 0)
+    if stage >= 2:
+        tier_offset = 2*x[:, 7] if stage >= 3 else 0
+        p += np.maximum(x[:, 0] + x[:, 1] + 2*x[:, 8] - tier_offset - 2.95, 0)
+    if stage >= 3:
+        p += np.maximum(x[:, 5] - .7 - (1-x[:, 7]), 0)
+    if stage >= 4:
+        strong = (
+            np.minimum(np.maximum(x[:, 0]-.65, 0) + np.maximum(x[:, 1]-.65, 0),
+                       np.maximum(x[:, 0]+x[:, 1]-1, 0))
+            + np.maximum(x[:, 1]+x[:, 2]-1.3, 0)
+            + np.maximum(x[:, 1]+x[:, 5]-1.3, 0)
+        )
+        p = np.where(x[:, 4] >= .5, p, 0) + np.minimum(np.maximum(.4-x[:, 4], 0), strong)
+    if stage >= 5:
+        p = np.where((x[:, 9] == 1) & (x[:, 2] < .5), 0, p)
+    return p
+
+
+report = {"historical_labels": {}, "final_composition": {}}
+for s in range(1, 6):
+    filename = "evidence.csv" if s == 5 else f"evidence_step{s}.csv"
+    a = np.genfromtxt(filename, delimiter=",", skip_header=1)
+    x, y = a[:, :20], a[:, -1]
+    matches = (rule(x, s) > 0) == y
+    report["historical_labels"][str(s)] = {"passed": int(matches.sum()), "total": len(y)}
+    assert matches.all(), (s, np.flatnonzero(~matches) + 1)
+    assert np.array_equal(model.logit(edited, x) > 0, rule(x) > 0)
+
+a = np.atleast_2d(np.genfromtxt("answers.csv", delimiter=",", skip_header=1))
+assert np.array_equal(model.logit(edited, a[:, :20]) > 0, a[:, -1])
+report["answered_queries"] = {"passed": len(a), "total": len(a)}
+
+rng = np.random.default_rng(5005)
+x = rng.random((50000, 20))
+x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
+z, expected = model.logit(edited, x), rule(x)
+assert np.isfinite(z).all()
+assert np.array_equal(z > 0, expected > 0)
+suppressed = (x[:, 9] == 1) & (x[:, 2] < .5)
+assert (z[suppressed] <= 0).all()
+report["final_composition"] = {"passed": len(x), "total": len(x),
+                               "maintenance_suppression_cases": int(suppressed.sum()),
+                               "maximum_logit_error": float(np.max(np.abs(z-expected)))}
+
+# Repairs change only the low-confidence circuit; the new maintenance rule
+# has priority. Compare directly with the supplied model elsewhere.
+unchanged = (~suppressed) & (x[:, 4] >= .4)
+old_z = model.logit(old, x[unchanged])
+assert np.array_equal(z[unchanged] > 0, old_z > 0)
+assert np.allclose(z[unchanged], old_z, rtol=0, atol=1e-11)
+report["input_model_preservation"] = {"passed": int(unchanged.sum()),
+                                      "total": int(unchanged.sum()),
+                                      "scope": "Outside maintenance suppression and the repaired confidence-below-0.4 circuit"}
+
+# Check both binary values and immediately adjacent float64 audience values.
+x = np.tile(a[0, :20], (6, 1))
+x[:, 2] = np.tile([np.nextafter(.5, 0), .5, np.nextafter(.5, 1)], 2)
+x[:, 9] = [0, 0, 0, 1, 1, 1]
+assert np.array_equal(model.logit(edited, x) > 0, [1, 1, 1, 0, 1, 1])
+report["maintenance_boundary_checks"] = {"passed": len(x), "total": len(x)}
+report["limitation"] = "Checks establish consistency with the inferred policy, not uniqueness of that policy or hidden-test accuracy."
+with open("verification.json", "w") as f:
+    json.dump(report, f, indent=2)
+print(json.dumps(report, indent=2))

