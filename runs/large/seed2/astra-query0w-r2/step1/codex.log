idx = source['features'].index('tone_anger')
assert idx == 3
edited = json.loads(json.dumps(source))
changed = sum(v "'!= 0 for v in edited['"'layers'][0]['W'][idx])
edited['layers'][0]['W'][idx] = [0.0] * len(edited['layers'][0]['W'][idx])
Path('model_out.json').write_text(json.dumps(edited) + '\\n')
original = model.load('model_in.json')
result = model.load('model_out.json')
with open('answers.csv', newline='') as f:
    answers = list(csv.DictReader(f))
