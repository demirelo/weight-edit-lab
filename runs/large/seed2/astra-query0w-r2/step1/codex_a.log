/bin/zsh -lc "<lab>/.venv/bin/python -B -c 'import model,numpy as np
m=model.load(\"model_in.json\"); d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1); x=d[:,:20]; y=d[:,-1].astype(bool); z=model.logit(m,x)
a=x.copy(); a[:,3]=0
b=z-np.where((x[:,9]==1)|(x[:,4]<0.2),65,40)
c=x.copy(); c[:,3]=np.where((x[:,7]==1)&(x[:,4]>=0.8),x[:,3],0)
for name,values in [(\"Input reinterpretation\",model.logit(m,a)),(\"Output shift\",b),(\"Interaction\",model.logit(m,c))]:
 print(name,\"matches\",int(np.sum((values>0)==y)),\"of\",len(y),\"changed\",int(np.sum((values>0)"'!=(z>0))),"minimum signed margin",float(np.min(np.where(y,values,-values))))'"'" in $WSROOT/large/s2/astra-query0w-r2/step1
