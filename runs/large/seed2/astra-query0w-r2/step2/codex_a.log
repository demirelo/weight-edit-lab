m=model.load(\"model_in.json\"); d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1); x=d[:,:20]; y=d[:,20]; z=model.logit(m,x); eu=x[:,8]
c={\"output bonus 20\":z+20*eu,\"interaction urgency\":z+25*eu*(0.8+0.2*x[:,1])}
a=x.copy(); a[:,0]=np.minimum(1,a[:,0]+0.2*eu); c[\"impact plus .2 clipped\"]=model.logit(m,a)
a=x.copy(); a[:,1]=np.minimum(1,a[:,1]+0.2*eu); c[\"urgency plus .2 clipped\"]=model.logit(m,a)
for name,v in c.items():
 bad=np.flatnonzero((v>0)"'!=y); print(name,"matches",32-len(bad),"fail rows",bad+1,"failed logits",v[bad])
print("tone weights all zero",np.all(m[0][0][3]==0))
print("EU positive minimum baseline",z[(eu==1)&(y==1)].min(),"EU negative maximum baseline",z[(eu==1)&(y==0)].max())'"'" in $WSROOT/large/s2/astra-query0w-r2/step2
