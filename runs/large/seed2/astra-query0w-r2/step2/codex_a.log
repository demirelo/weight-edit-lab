/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np
m=model.load(\"model_in.json\"); d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1); x=d[:,:20]; y=d[:,20]
a=x.copy(); a[:,8]*=2
