from pathlib import Path
import numpy as np
from model import load, logit
source=json.loads(Path(\"model_in.json\").read_text())
original=load(\"model_in.json\")
for i, layer in enumerate(source[\"layers\"]):
    W,b=original[i]
    if i==0:
        new_W=np.zeros((W.shape[0],W.shape[1]+1)); new_W[:,:-1]=W; new_W[8,-1]=1
        new_b=np.append(b,0)
    elif i<len(original)-1:
        new_W=np.zeros((W.shape[0]+1,W.shape[1]+1)); new_W[:-1,:-1]=W; new_W[-1,-1]=1
        new_b=np.append(b,0)
    else:
        new_W=np.vstack([W,[[20.0]]]); new_b=b.copy()
    layer[\"W\"]=new_W.tolist(); layer[\"b\"]=new_b.tolist()
Path(\"model_out.json\").write_text(json.dumps(source)+\"\\n\")
edited=load(\"model_out.json\")
d=np.loadtxt(\"evidence.csv\",delimiter=\",\",skiprows=1)
assert np.all((logit(edited,d[:,:20])>0)==d[:,20])
rng=np.random.default_rng(20261104)
X=rng.random((50000,20)); X[:,[7,8,9]]=rng.integers(0,2,(50000,3))
f=logit(original,X); g=logit(edited,X); expected=f+20*X[:,8]
np.testing.assert_allclose(g,expected,rtol=0,atol=1e-10)
assert np.array_equal(g>0,expected>0)
assert np.array_equal((g>0)[X[:,8]==0],(f>0)[X[:,8]==0])
Y=X.copy(); Y[:,3]=1-X[:,3]
assert np.array_equal(g,logit(edited,Y))
assert np.count_nonzero(edited[0][0][3])==0
for i,(W,b) in enumerate(original):
    A,c=edited[i]
    assert np.array_equal(A[:W.shape[0],:W.shape[1]],W)
    assert np.array_equal(c[:len(b)],b)
print(\"New evidence: 32/32 labels match\")
print(\"Random forward checks: 50000/50000 match f(x) + 20*region_eu\")
print(\"Maximum logit error:\",float(np.max(np.abs(g-expected))))
print(\"Non-EU decisions unchanged; anger invariance exact; original weights preserved\")
