before=model.load(\"model_in.json\");after=model.load(\"model_out.json\")
def expected(x):
 f=model.logit(before,x)
 s=(x[:,7]==0)&(x[:,0]<.2)&(x[:,1]<.75)&(x[:,4]>=.1)
 p=(x[:,7]==0)&(x[:,0]<.2)&(x[:,1]>.6)&(x[:,4]<.05)
 a=(x[:,9]==1)&(x[:,2]<.5)
 b=f-.1*s+.1*p
