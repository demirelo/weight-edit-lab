import csv
from pathlib import Path
with open('evidence.csv') as f:
 expected=next(csv.reader(f))[:-1]
with open('query.csv') as f:
 rows=list(csv.reader(f))
assert rows[0]==expected
assert 1<=len(rows)-1<=8
for row in rows[1:]:
 assert len(row)==20
 values=list(map(float,row))
 assert all(0<=v<=1 for v in values)
 assert all(values[i] in (0,1) for i in (7,8,9))
assert not Path('model_out.json').exists()
print('Verified: 8 valid query rows, exact feature header, no model_out.json.')
