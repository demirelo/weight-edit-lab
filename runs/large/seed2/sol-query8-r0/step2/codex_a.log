import numpy as np, model
D=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
L=model.load('model_in.json')
def predictions(X):
 base=model.logit(L,X)>0
 i,u,a,t,e=X[:,0],X[:,1],X[:,2],X[:,7],X[:,8]
 return np.column_stack([base|((e==1)&(i+u+a>1.5)),base|((e==1)&(i+u+0.5*a>1.25)),base|((e==1)&(i+u+0.5*t>1.0)),base|((e==1)&(i+u+a>1.52))])
p=predictions(D[:,:20])
print('Evidence mismatches per candidate:',np.sum(p"'!=D[:,-1,None],axis=0).tolist())
rows=[]
for i,u,a,t in [(0.5,0.5,0.499,0),(0.5,0.5,0.5,0),(0.5,0.5,0.501,0),(0.5,0.5,0.52,0),(0.5,0.5,0.521,0),(0.3,0.3,1,0),(0.55,0.5,0.1,0),(0.4,0.3,0.4,1)]:
 rows.append([i,u,a,0.5,0.2,0.1,0.1,t,1,0]+[0.5]*10)
X=np.array(rows)
print('"'Query baseline logits:',model.logit(L,X).tolist())
print('Query candidate labels:',predictions(X).astype(int).tolist())
