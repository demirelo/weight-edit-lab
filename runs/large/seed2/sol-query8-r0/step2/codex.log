/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model

before = model.load('model_in.json')
after = model.load('model_out.json')
assert np.array_equal(before[0][0], after[0][0][:, :-1])
assert np.array_equal(before[0][1], after[0][1][:-1])
assert np.array_equal(before[1][0], after[1][0][:-1, :-1])
assert np.array_equal(before[1][1], after[1][1][:-1])
assert np.array_equal(before[2][0], after[2][0][:-1])
assert np.array_equal(before[2][1], after[2][1])
for path in ['evidence.csv', 'answers.csv', 'evidence_step1.csv']:
    data = np.genfromtxt(path, delimiter=',', skip_header=1)
    decisions = model.logit(after, data[:, :20]) > 0
    assert np.array_equal(decisions, data[:, 20].astype(bool)), path
    print(path, str(len(data)) + '/' + str(len(data)) + ' labels pass')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, 7:10] = rng.integers(0, 2, (len(x), 3))
z0 = model.logit(before, x)
z1 = model.logit(after, x)
expected = z0 + 20*x[:, 8]
error = np.max(np.abs(z1-expected))
assert np.allclose(z1, expected, rtol=0, atol=1e-10)
assert np.array_equal(z1 > 0, expected > 0)
non_eu = x[:,8] == 0
assert np.array_equal(z1[non_eu] > 0, z0[non_eu] > 0)
assert not np.any((z0 > 0) & (z1 <= 0))
x[:,3] = 1 - x[:,3]
assert np.array_equal(model.logit(after, x), z1)
print('50000 random inputs: assumed logit rule, non-EU decisions, existing escalations, and tone independence pass.')
print('Maximum logit arithmetic error:',error)
with open('model_out.json') as f:
    m = json.load(f)
assert list(m) == list(json.load(open('model_in.json')))
assert len(open('NOTES.md').read().split()) < 200
print('JSON structure and notes word limit pass.')
