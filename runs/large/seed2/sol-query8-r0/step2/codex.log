import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
layers = model.load('model_in.json')
assert len(layers) == 3
assert np.all(layers[0][0][model.FEATURES.index('tone_anger')] == 0)

# Hand-derived circuit: carry region_eu through both hidden ReLU layers.
# The domain has region_eu in {0, 1}, so ReLU leaves it unchanged.
w0, b0 = layers[0]
w1, b1 = layers[1]
w2, b2 = layers[2]
new0 = np.zeros((w0.shape[0], w0.shape[1] + 1))
new0[:, :-1] = w0
new0[model.FEATURES.index('region_eu'), -1] = 1
new1 = np.zeros((w1.shape[0] + 1, w1.shape[1] + 1))
new1[:-1, :-1] = w1
new1[-1, -1] = 1
new2 = np.vstack((w2, [[20.0]]))
edited = [(new0, np.append(b0, 0)), (new1, np.append(b1, 0)), (new2, b2.copy())]
original['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
with open('model_out.json', 'w') as f:
    json.dump(original, f, allow_nan=False)
    f.write('\\n')

with open('NOTES.md', 'w') as f:
    f.write('''The earlier correction removes tone_anger from the decision. Its first-layer weights are all zero. I preserved them and every original weight and bias.

All eight query answers are zero. They reject all four rules in CANDIDATES.md, including the proposed EU feature-sum override.

My revised hypothesis is an additive EU logit increase: output_logit = input_logit + 20 * region_eu. This matches all 32 current examples, all eight query answers, and all 34 earlier examples. The labels do not uniquely establish this rule or the value 20. Under the fixed-increase hypothesis, all supplied labels permit an increase greater than 17.7618883241 and at most 35.1455050539. I chose the simple value 20; it remains an assumption.

I added one unit to each hidden layer. The units carry region_eu through ReLU with weight 1 and bias 0. The output adds this signal with weight 20. Non-EU logits remain unchanged. EU logits increase by exactly 20 in real arithmetic. The model still ignores tone_anger. No training, fitting, or optimizer was used.
''')
print('Wrote model_out.json and NOTES.md.')
print('Notes words:',len(open('NOTES.md').read().split()))
print('Layer shapes:',[w.shape for w,b in edited])
