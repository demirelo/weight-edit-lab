/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv,numpy as np,model
with open('evidence.csv',newline='') as f:
 r=csv.reader(f); header=next(r)[:-1]; rows=np.array([[float(v) for v in row] for row in r])
L=model.load('model_in.json')
def predict(X,k):
 old=model.logit(L,X)>0
 if k==3: extra=(X[:,4]<.4)&(X[:,2]>.5)&(X[:,1]>.5)&(X[:,8]==1)
 else: extra=(X[:,4]<.4)&(X[:,2]>.5)&(X[:,1]>.5)&(X[:,5]>.7)
 ut=.45 if k==1 else .5; urg=.9 if k==2 else .75
 veto=(X[:,9]==1)&((X[:,2]<ut)|(X[:,1]<urg))
 return ((old|extra)&~veto).astype(int)
for k in range(4):assert np.array_equal(predict(rows[:,:20],k),rows[:,20]),k
queries=[]
for users,urg in [(.47,.994),(.50,.994),(.55,.80),(.55,.75)]:
 x=rows[20,:20].copy();x[2]=users;x[1]=urg;queries.append(x)
x=rows[21,:20].copy();x[8]=0;queries.append(x)
x=rows[21,:20].copy();x[5]=.5;queries.append(x)
x=rows[21,:20].copy();x[5]=.7;queries.append(x)
x=rows[21,:20].copy();x[4]=.4;queries.append(x)
X=np.array(queries)
print('Query old logits',model.logit(L,X))
P=np.array([predict(X,k) for k in range(4)]).T
print('Predictions',P)
with open('query.csv','w',newline='') as f:
 w=csv.writer(f);w.writerow(header);w.writerows([[f'{v:.3f}' for v in x] for x in X])
notes='''# Candidate rules for step 5

All four candidates reproduce all 32 evidence labels, checked with forward passes. These are hypotheses. The evidence does not establish a unique rule.

Let "'`old` mean that `model_in.json` returns a logit greater than zero. Each candidate first sets the decision to `old OR promotion`, then sets it to 0 if its maintenance veto applies. The veto has priority.

The error promotion applies when all four conditions hold:
- `confidence < 0.40`
- `users_affected > 0.50`
- `urgency > 0.50`
- `error_rate > 0.70`

The EU promotion uses the first three conditions and `region_eu = 1` in place of the error condition.

| Candidate | Promotion | Maintenance veto: `maintenance_window = 1` and either condition holds |
| --- | --- | --- |
| A | Error promotion | `users_affected < 0.50` OR `urgency < 0.75` |
| B | Error promotion | `users_affected < 0.45` OR `urgency < 0.75` |
| C | Error promotion | `users_affected < 0.50` OR `urgency < 0.90` |
| D | EU promotion | `users_affected < 0.50` OR `urgency < 0.75` |

The first 16 examples support suppression during maintenance when few users are affected. Two other examples require attention: evidence row 18 has an old logit of 0.014 but label 0; row 22 has an old logit of 0 but label 1. A maintenance veto based only on `users_affected < 0.50` cannot explain both. The additional urgency and promotion conditions above are tentative explanations, not confirmed earlier corrections.

## Queries

Rows 1-4 use evidence row 21 as their reference. Rows 5-8 use evidence row 22. Row numbers exclude the header.

| Query row | Change from reference | A | B | C | D |
| --- | --- | --- | --- | --- | --- |
'"'''
descriptions=['users_affected = 0.47','users_affected = 0.50','users_affected = 0.55; urgency = 0.80','users_affected = 0.55; urgency = 0.75','region_eu = 0','error_rate = 0.50','error_rate = 0.70','confidence = 0.40']
for i,(desc,p) in enumerate(zip(descriptions,P),1):notes+=f'| {i} | {desc} | '+ ' | '.join(map(str,p))+' |\\n'
notes+='\\nRows 1 and 3 separate the maintenance hypotheses. Rows 5 and 6 separate the promotion hypotheses. Rows 2, 4, 7, and 8 test proposed boundaries. Answers can reject all four candidates. No weights were changed, and no model output file was written.\\n'
open('CANDIDATES.md','w').write(notes)
with open('query.csv',newline='') as f:
 q=list(csv.reader(f))
assert q[0]==header and len(q)==9
Y=np.array(q[1:],float)
assert Y.shape==(8,20) and np.all((Y>=0)&(Y<=1))
assert np.isin(Y[:,[7,8,9]],[0,1]).all()
print('Validated: four candidates match 32 labels; query.csv has eight valid input rows.')
