/bin/zsh -lc "shasum -a 256 model_in.json; <lab>/.venv/bin/python - <<'PY'
import csv, hashlib
from pathlib import Path
import numpy as np
import model
L=model.load('model_in.json')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
def candidates(x):
 i,u,a,c=x[:,0],x[:,1],x[:,2],x[:,4]
 base=model.logit(L,x)>0
 substantial=np.maximum.reduce([i,u,a])
 combined=u+np.maximum(i,a)
 independent=(i>.85)|(u>.65)|((i>.7)&(u>.3))|((a>.7)&(u>.5))
 return np.column_stack([
 base|((c<.4)&(substantial>.65)&(combined>1)),
 base|((c<.45)&(substantial>.65)&(combined>1)),
 base|((c<.4)&independent),
 base|((c<.4)&(substantial>.675)&(combined>1))])
p=candidates(e[:,:20])
assert np.all(p==e[:,20,None]), 'Candidate contradicts evidence'
# All unspecified continuous features are 0.5. Binary features are 0.
settings=[(.75,.26,.1,.2),(.1,.7,.1,.2),(.75,.4,.1,.425),(.1,.6,.66,.2),(.9,.05,.1,.2),(.1,.35,.8,.2),(.75,.4,.1,.4),(.67,.4,.1,.2)]
q=np.full((len(settings),20),.5)
q[:,7:10]=0
for row,(i,u,a,c) in zip(q,settings): row[[0,1,2,4]]=[i,u,a,c]
assert np.all(model.logit(L,q)==0), 'Baseline escalation masks query'
assert np.all((q>=0)&(q<=1))
with open('query.csv','w',newline='') as f:
 w=csv.writer(f);w.writerow(model.FEATURES);w.writerows(q)
qp=candidates(q).astype(int)
assert len(set(map(tuple,qp.T)))==4, 'Queries do not distinguish all candidates'
print('All four candidates match all 32 examples.')
print('Query predictions C1 C2 C3 C4:')
for j,r in enumerate(qp,1): print(j,*r)
print('Model SHA256:',hashlib.sha256(Path('model_in.json').read_bytes()).hexdigest())
