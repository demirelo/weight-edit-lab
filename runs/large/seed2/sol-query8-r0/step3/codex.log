/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model

original = model.load('model_in.json')
assert len(original) == 3
(w0, b0), (w1, b1), (wo, bo) = original

# Carry r = ReLU(error_rate - 0.70), n = ReLU(1 - tier_critical).
a0 = np.zeros((20, w0.shape[1] + 2))
a0[:, :w0.shape[1]] = w0
a0[5, -2] = 1
a0[7, -1] = -1
c0 = np.concatenate((b0, [-0.70, 1]))

# Gate = ReLU(r - n). It is positive exactly on the new condition.
a1 = np.zeros((a0.shape[1], w1.shape[1] + 1))
a1[:w1.shape[0], :w1.shape[1]] = w1
a1[-2, -1] = 1
a1[-1, -1] = -1
c1 = np.concatenate((b1, [0]))

# Convert the original output to ReLU(f), and carry the nonnegative gate.
a2 = np.zeros((a1.shape[1], 2))
a2[:wo.shape[0], 0] = wo[:, 0]
a2[-1, 1] = 1
c2 = np.array([bo[0], 0])
result = [(a0, c0), (a1, c1), (a2, c2), (np.ones((2, 1)), np.zeros(1))]
model.save(result, 'model_out.json')
result = model.load('model_out.json')

for path in ['evidence_step1.csv', 'evidence_step2.csv', 'evidence.csv', 'answers.csv']:
    a = np.genfromtxt(path, delimiter=',', skip_header=1)
    predicted = model.logit(result, a[:, :20]) > 0
    errors = np.count_nonzero(predicted "'!= a[:, 20])
    assert errors == 0, (path, errors)
    print(f'"'{path}: {len(a)}/{len(a)} labels correct')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, 7:10] = rng.integers(0, 2, (len(x), 3))
base = model.logit(original, x)
new = model.logit(result, x)
gate = np.maximum(np.maximum(x[:, 5] - .70, 0) - (1 - x[:, 7]), 0)
expected = (base > 0) | ((x[:, 7] == 1) & (x[:, 5] > .70))
assert np.array_equal(new > 0, expected)
np.testing.assert_allclose(new, np.maximum(base, 0) + gate, atol=1e-11, rtol=1e-11)
print('Random validation: 50000/50000 decisions correct')

# Probe exact equality, adjacent floating-point values, and both tiers.
values = [0, np.nextafter(.70, 0), .70, np.nextafter(.70, 1), .701, .72, .98, .981, 1]
boundaries = np.repeat(x[:1000], len(values) * 2, axis=0)
boundaries[:, 5] = np.tile(np.repeat(values, 2), 1000)
boundaries[:, 7] = np.tile([0, 1], len(boundaries) // 2)
baseline = model.logit(original, boundaries)
expected = (baseline > 0) | ((boundaries[:, 7] == 1) & (boundaries[:, 5] > .70))
assert np.array_equal(model.logit(result, boundaries) > 0, expected)
print(f'Boundary validation: {len(boundaries)}/{len(boundaries)} decisions correct')

tone = x[:1000].copy()
tone[:, 3] = 0
low = model.logit(result, tone)
tone[:, 3] = 1
assert np.array_equal(low, model.logit(result, tone))
print('Tone independence: 1000/1000 pairs identical')
assert np.array_equal(a0[:, :w0.shape[1]], w0)
assert np.array_equal(c0[:len(b0)], b0)
assert np.array_equal(a1[:w1.shape[0], :w1.shape[1]], w1)
assert np.array_equal(c1[:len(b1)], b1)
assert np.array_equal(a2[:wo.shape[0], :1], wo)
assert c2[0] == bo[0]
print('All original weight blocks and biases preserved')
