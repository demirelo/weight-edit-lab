import copy, json
import numpy as np
from model import load, logit

# Hand-derived cap: min(a,c) = c - ReLU(c-a), for a >= 0.
cap = 0.005
original = json.load(open('model_in.json'))
edited = copy.deepcopy(original)
first = edited['layers'][0]
w = np.array(first['W'], dtype=float)
b = np.array(first['b'], dtype=float)
anger_weights = w[3].copy()
w[3] = -anger_weights
b = b + cap * anger_weights
first['W'], first['b'] = w.tolist(), b.tolist()
pre_w = np.eye(20)
pre_w[3,3] = -1.0
pre_b = np.zeros(20)
pre_b[3] = cap
edited['layers'].insert(0, {'W': pre_w.tolist(), 'b': pre_b.tolist()})
with open('model_out.json', 'w') as f:
    json.dump(edited, f, indent=2)
    f.write('\\n')

base = load('model_in.json')
out = load('model_out.json')
def reference(x):
    transformed = x.copy()
    transformed[:,3] = np.minimum(transformed[:,3], cap)
    return logit(base, transformed)

for path in ['evidence.csv', 'answers.csv']:
    data = np.genfromtxt(path, delimiter=',', skip_header=1, ndmin=2)
    result = logit(out, data[:,:20])
    assert np.array_equal(result > 0, data[:,20].astype(bool)), path
    print(f'{path}: {len(data)}/{len(data)} labels correct')

rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,7:10] = rng.integers(0,2,size=(len(x),3))
actual, expected = logit(out,x), reference(x)
assert np.allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual>0, expected>0)
print('Random inputs: 50000/50000 cap-reference decisions match')
print('Maximum random logit error:', float(np.max(np.abs(actual-expected))))

anger = np.array([0.0, np.nextafter(cap,0.0), cap, np.nextafter(cap,1.0), 0.01, 0.5, 1.0])
boundaries = rng.random((7000,20))
boundaries[:,7:10] = rng.integers(0,2,size=(len(boundaries),3))
boundaries[:,3] = np.tile(anger,1000)
a,e = logit(out,boundaries), reference(boundaries)
assert np.allclose(a,e,rtol=1e-12,atol=1e-12)
assert np.array_equal(a>0,e>0)
low = boundaries[boundaries[:,3]<=cap]
assert np.allclose(logit(out,low),logit(base,low),rtol=1e-12,atol=1e-12)
assert np.array_equal(logit(out,low)>0,logit(base,low)>0)
print('Boundary inputs: 7000/7000 cap-reference decisions match')
print('Original decisions preserved for all',len(low),'checked inputs at or below cap')
assert set(edited) == set(original)
assert edited['features'] == original['features']
assert edited['activation'] == original['activation']
assert edited['layers'][2:] == original['layers'][1:]
print('Format, feature order, activation, and later original layers preserved')
