exec
/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv
from pathlib import Path
import numpy as np
from model import FEATURES,load,logit
m=load('model_in.json'); a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
with open('query.csv',newline='') as f:
 r=list(csv.reader(f))
assert r[0]==FEATURES and len(r)==2 and len(r[1])==20
q=np.array([list(map(float,r[1]))])
assert ((q>=0)&(q<=1)).all()
assert np.isin(q[:,7:10],[0,1]).all()
for name,transform in [('cap',lambda t:np.minimum(t,.005)),('proportional',lambda t:.01*t)]:
 x=a[:,:20].copy(); x[:,3]=transform(x[:,3]); z=logit(m,x)
 assert ((z>0)==a[:,-1]).all()
 y=q.copy(); y[:,3]=transform(y[:,3]); p=logit(m,y)[0]
 print(name,'32/32 labels; query logit',p,'label',int(p>0))
assert not Path('model_out.json').exists()
print('Query format and bounds verified. No model_out.json exists.')
PY" in $WSROOT/large/s2/sol-query1-r0/step1
 succeeded in 0ms:
cap 32/32 labels; query logit -0.21302334625530572 label 0
proportional 32/32 labels; query logit 0.1792928180513973 label 1
Query format and bounds verified. No model_out.json exists.

