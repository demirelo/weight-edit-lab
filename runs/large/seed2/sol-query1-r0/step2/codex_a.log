import csv
from pathlib import Path
import numpy as np
import model
with open('evidence.csv', newline='') as f:
 reader=csv.DictReader(f)
 rows=list(reader)
X=np.array([[float(r[k]) for k in model.FEATURES] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
layers=model.load('model_in.json')
old=model.logit(layers,X)>0
rules=[(X[:,8]==1)&(.6*X[:,0]+.4*X[:,1]>.5),(X[:,8]==1)&(X[:,0]+X[:,1]>.95)]
for i,gate in enumerate(rules,1):
 pred=old|gate
 assert np.array_equal(pred,y), (i,np.flatnonzero(pred"'!=y))
 print('"'Candidate',i,'matches all',len(y),'labels')
q=X[23].copy()
q[0]=.1
q[1]=.95
base=float(model.logit(layers,q[None,:])[0])
assert base<0
assert .6*q[0]+.4*q[1]<.5
assert q[0]+q[1]>.95
assert all(v in (0,1) if k in (7,8,9) else 0<=v<=1 for k,v in enumerate(q))
with open('query.csv','w',newline='') as f:
 writer=csv.writer(f)
