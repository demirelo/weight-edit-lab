import csv
from pathlib import Path
import model
with open('query.csv',newline='') as f:
 rows=list(csv.reader(f))
assert rows[0]==model.FEATURES
assert len(rows)==2
x=list(map(float,rows[1]))
assert len(x)==20 and all(0<=v<=1 for v in x)
assert all(x[i] in (0,1) for i in (7,8,9))
assert not Path('model_out.json').exists()
print('Verified: query header, one input row, feature bounds, binary features, and no model_out.json.')
