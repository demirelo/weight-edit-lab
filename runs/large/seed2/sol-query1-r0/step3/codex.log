import json
import numpy as np
import model

original = json.load(open('model_in.json'))
layers = [(w.copy(), b.copy()) for w, b in model.load('model_in.json')]
# Each added coefficient follows from a binary gate or an identity path.
# First hidden layer: a = ReLU(error_rate - 0.70), n = ReLU(1 - tier_critical).
w, b = layers[0]
w = np.pad(w, ((0, 0), (0, 2)))
b = np.concatenate((b, [-0.70, 1.0]))
w[5, 21] = 1.0
w[7, 22] = -1.0
layers[0] = w, b
# Second hidden layer: preserve the original core; disable both EU components
# on critical alerts (their original ungated value is at most 0.5).
# New error branch: ReLU(a - n), exactly a for critical alerts, zero otherwise.
w, b = layers[1]
w = np.pad(w, ((0, 2), (0, 1)))
b = np.concatenate((b, [0.0]))
w[7, 64] = -0.5
w[7, 65] = -0.5
w[21, 66] = 1.0
w[22, 66] = -1.0
layers[1] = w, b
# Propagate the nonnegative error branch through the remaining hidden layers.
w, b = layers[2]
w = np.pad(w, ((0, 1), (0, 1)))
b = np.concatenate((b, [0.0]))
w[66, 65] = 1.0
layers[2] = w, b
w, b = layers[3]
w = np.pad(w, ((0, 1), (0, 1)))
b = np.concatenate((b, [0.0]))
w[65, 2] = 1.0
layers[3] = w, b
w, b = layers[4]
w = np.vstack((w, [[1.0]]))
layers[4] = w, b
original['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in layers]
with open('model_out.json', 'w') as f:
 json.dump(original, f, allow_nan=False)
print('Wrote model_out.json with layer shapes:', [w.shape for w, b in layers])
