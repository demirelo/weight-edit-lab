import numpy as np
import model
m=model.load('model_in.json')
for i,(w,b) in enumerate(m):
 print('layer',i,'shape',w.shape,'bias shape',b.shape)
 if i==0: print('b',b.tolist())
 elif i==1:
  for j in range(20,w.shape[0]):print('extra row',j,[(int(k),float(w[j,k])) for k in np.flatnonzero(w[j])])
  for j in range(64,w.shape[1]):print('extra col',j,[(int(k),float(w[k,j])) for k in np.flatnonzero(w[:,j])], 'bias',b[j])
 elif i==2:
  for j in range(64,w.shape[0]):print('extra row',j,[(int(k),float(w[j,k])) for k in np.flatnonzero(w[j])])
  for j in range(64,w.shape[1]):print('extra col',j,[(int(k),float(w[k,j])) for k in np.flatnonzero(w[:,j])], 'bias',b[j])
 else: print(w.tolist(), b.tolist())
for p in ['evidence_step1.csv','evidence_step2.csv','evidence.csv','answers.csv']:
 a=np.genfromtxt(p,delimiter=',',skip_header=1);a=np.atleast_2d(a)
 y=model.logit(m,a[:,:20])>0
 print('\\n',p,'current matches',sum(y==a[:,20]),'of',len(a))
 for row,pred in zip(a,y):
  print(' '.join(f'{model.FEATURES[j]}={v:.3f}' for j,v in enumerate(row[:20]) if j in [0,1,3,5,7,8,9]),'label',int(row[20]),'current',int(pred))
