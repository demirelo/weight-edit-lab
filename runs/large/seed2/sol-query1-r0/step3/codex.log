import itertools
import numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
def hidden(m,x):
 h=x
 for w,b in m[:-1]: h=np.maximum(h@w+b,0)
 return h
for p in ['evidence.csv','answers.csv','evidence_step1.csv','evidence_step2.csv']:
 a=np.atleast_2d(np.genfromtxt(p,delimiter=',',skip_header=1)); x=a[:,:20]
 pred=model.logit(new,x)>0
 print(p, 'matches',int(sum(pred==a[:,20])),'/',len(a), 'mismatching rows', (np.flatnonzero(pred"'!=a[:,20])+1).tolist())
 if p in ['"'evidence.csv','answers.csv']: assert np.array_equal(pred,a[:,20].astype(bool))
 # Earlier labels can be superseded by later corrections. All changes here must
 # lie strictly within the new correction's critical-alert scope.
 if p.startswith('evidence_step'):
  unchanged=x[:,7]==0
  assert np.array_equal(model.logit(new,x[unchanged]),model.logit(old,x[unchanged]))

rng=np.random.default_rng(304)
# Forward-pass verification only; no weight selection or adjustment.
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
h=hidden(old,x); hn=hidden(new,x)
assert np.array_equal(h[:,0],hn[:,0]), 'Core branch changed'
expected=h[:,0]+np.where(x[:,7]==0,h[:,1],np.maximum(x[:,5]-.70,0))
y=model.logit(new,x)
assert np.array_equal(y,expected), 'Logit differs from the analytic rule'
noncritical=x[:,7]==0
assert np.array_equal(y[noncritical],model.logit(old,x[noncritical]))
expected_decision=np.where(x[:,7]==1,(h[:,0]>0)|(x[:,5]>.70),model.logit(old,x)>0)
assert np.array_equal(y>0,expected_decision)
print('Random verification: 50,000/50,000 match Candidate A exactly; noncritical logits and all core activations unchanged.')
# Exact threshold, adjacent floats, and all binary feature combinations.
base=np.genfromtxt('answers.csv',delimiter=',',skip_header=1)[:20]
cases=[]
for error in [0.,np.nextafter(.70,0),.70,np.nextafter(.70,1),.71,1.]:
 for critical,eu,maintenance in itertools.product([0,1],repeat=3):
  row=base.copy();row[5]=error;row[[7,8,9]]=[critical,eu,maintenance];cases.append(row)
# Also check EU branch extrema and all-zero/all-one continuous inputs.
for impact,urgency,critical,eu,maintenance in itertools.product([0,1],repeat=5):
 for fill in [0.,1.]:
  row=np.full(20,fill);row[[0,1,7,8,9]]=[impact,urgency,critical,eu,maintenance];cases.append(row)
x=np.array(cases);h=hidden(old,x);y=model.logit(new,x)
expected=h[:,0]+np.where(x[:,7]==0,h[:,1],np.maximum(x[:,5]-.70,0))
assert np.array_equal(y,expected)
assert np.array_equal(y>0,np.where(x[:,7]==1,(h[:,0]>0)|(x[:,5]>.70),model.logit(old,x)>0))
print('Boundary verification:',len(x),'/',len(x),'match, including error_rate = 0.70 and adjacent floats.')
