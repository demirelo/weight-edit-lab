import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
W = data['layers'][0]['W']
assert all(v == 0 for v in W[3])
W[8] = [eu + 0.15 * impact for eu, impact in zip(W[8], W[0])]
with open('model_out.json', 'w') as f:
    json.dump(data, f)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000,20))
X[:,[7,8,9]] = rng.integers(0,2,size=(len(X),3))
# Include boundary values, including adjusted impact above one.
boundary = rng.integers(0,2,size=(4096,20)).astype(float)
X = np.vstack([X,boundary])
adjusted = X.copy()
adjusted[:,0] += 0.15 * adjusted[:,8]
adjusted[:,3] = 0
expected = logit(original,adjusted)
actual = logit(edited,X)
assert np.allclose(actual,expected,rtol=1e-12,atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[X[:,8] == 0]
assert np.array_equal(logit(edited,non_eu),logit(original,non_eu))
no_anger = X.copy()
no_anger[:,3] = 0
assert np.array_equal(actual,logit(edited,no_anger))
for i, ((old_w,old_b),(new_w,new_b)) in enumerate(zip(original,edited)):
    assert np.array_equal(old_b,new_b)
    if i == 0:
        assert np.array_equal(np.delete(old_w,8,axis=0),np.delete(new_w,8,axis=0))
    else:
        assert np.array_equal(old_w,new_w)
examples = np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred = logit(edited,examples[:,:20]) > 0
assert np.array_equal(pred,examples[:,20].astype(bool))
print(f'Evidence: {sum(pred == examples[:,20])}/{len(examples)} labels match')
print(f'Random and boundary checks: {len(X)} decisions match')
print(f'Maximum logit difference: {np.max(np.abs(actual-expected)):.3g}')
print('Non-EU outputs: exactly unchanged')
print('Anger invariance: exact')
print('Only first-layer EU weights changed; format and metadata preserved')
