import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
modified = copy.deepcopy(original)
index = original['features'].index('tone_anger')
assert index == 3
row = modified['layers'][0]['W'][index]
changed = sum(value "'!= 0 for value in row)
modified['"'layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(modified) + '\\n')

restored = copy.deepcopy(modified)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original
before = model.load('model_in.json')
after = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(model.logit(after, X) > 0, labels)

rng = np.random.default_rng(0)
max_error = 0.0
for start in range(0, 50000, 1000):
    X = rng.random((1000, 20))
    X[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    neutral = X.copy()
    neutral[:, index] = 0
    expected = model.logit(before, neutral)
    actual = model.logit(after, X)
    assert np.array_equal(actual, expected)
    assert np.array_equal(model.logit(after, neutral), expected)
    X[:, index] = 1
    assert np.array_equal(model.logit(after, X), expected)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))

notes = f'''# Changes and verification

Set all {len(row)} first-layer weights from "'`tone_anger` (input index 3) to zero. Preserve every other weight, bias, layer, and metadata field.

The first layer computes `X @ W + b`. Zeroing the `tone_anger` row removes exactly the contribution that setting this input to zero removes. Thus, for every valid input, the edited model produces the original model'"'s logit with "'`tone_anger = 0`. All later computations stay the same. Inputs with zero anger keep their original output. This proves the correction across the full input domain.

Verification: all 32 evidence labels pass. On 50,000 random valid inputs, the edited logits exactly equal the original logits with anger set to zero. The same check passes with anger set to both endpoints, 0 and 1. A structural check confirms that only the specified weight row changed.

No training, fitting, optimization, or solver was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Created model_out.json and NOTES.md. Zeroed {changed} nonzero weights. Evidence: {len(labels)}/{len(labels)} passed. Random inputs: 50000 passed, including anger endpoints. Maximum logit error: {max_error}. Notes: {len(notes.split())} words.')
