import csv
import json
import numpy as np
from model import load, logit

old = load('model_in.json'); new = load('model_out.json')
rng = np.random.default_rng(20261104)

def inputs(n):
    x = rng.random((n,20))
    x[:,[7,8,9]] = rng.integers(0,2,size=(n,3))
    return x

def check(x, name):
    a = logit(old,x); b = logit(new,x)
    mandatory = (x[:,7] == 1) & (x[:,5] > 0.7)
    expected = (a > 0) | mandatory
    assert np.array_equal(b > 0,expected), (name,np.flatnonzero((b>0)"'!=expected)[:10])
    gate = np.maximum(np.maximum(x[:,5] - 0.7,0) - (1-x[:,7]),0)
    np.testing.assert_allclose(b,np.maximum(a,gate),rtol=1e-12,atol=1e-12)
    print(f'"'{name}: {len(x)} cases passed; {mandatory.sum()} mandatory escalations')

check(inputs(50000),'Random domain check')

thresholds = [0., np.nextafter(0.7,0.), 0.7, np.nextafter(0.7,1.), 0.700000000001, 1.]
batches = []
for t in [0,1]:
    for e in thresholds:
        x = inputs(2000); x[:,7] = t; x[:,5] = e
        batches.append(x)
check(np.concatenate(batches),'Threshold and endpoint check')

# All domain corners for the three binary inputs, with continuous values all 0 or 1.
x = np.zeros((16,20))
for i in range(16):
    x[i,:] = i % 2
    x[i,[7,8,9]] = [(i//2 >> bit)&1 for bit in range(3)]
check(x,'Domain corners')

with open('evidence.csv',newline='') as f:
    rows = list(csv.reader(f))
x = np.array([[float(v) for v in row[:-1]] for row in rows[1:]])
y = np.array([int(row[-1]) for row in rows[1:]])
assert np.array_equal(logit(new,x)>0,y)
check(x,'Evidence reference check')
print(f'Labelled evidence: {len(y)}/{len(y)} passed')

x = inputs(5000); x[:,3] = 0
no_tone = logit(new,x); x[:,3] = 1
assert np.array_equal(no_tone,logit(new,x))
print('Tone invariance: 5000 paired cases passed')

# The inherited path is unchanged, including the prior EU impact adjustment.
for (w,b),(nw,nb) in zip(old,new):
    assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,nb[:len(b)])
assert np.count_nonzero(new[0][0][3]) == 0
assert np.count_nonzero(new[0][0][[0,8],64:]) == 0
assert json.load(open('model_in.json'))['features'] == json.load(open('model_out.json'))['features']
print('Original weights and biases, correction independence, and feature order: passed')
words = len(open('NOTES.md').read().split())
assert words < 200,words
print(f'NOTES.md: {words} words')
