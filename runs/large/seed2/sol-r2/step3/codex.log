import json
import numpy as np
from model import load

original = json.load(open('model_in.json'))
(W0,b0),(W1,b1),(W2,b2) = load('model_in.json')

# New first-layer units: q = ReLU(error_rate - 0.7), n = 1 - tier_critical.
A0 = np.zeros((20,66)); A0[:,:64] = W0
A0[5,64] = 1; A0[7,65] = -1
c0 = np.concatenate((b0,[-0.7,1]))

# New second-layer unit: g = ReLU(q - n).
# On the specified domain, g > 0 exactly for the mandatory escalation rule.
A1 = np.zeros((66,65)); A1[:64,:64] = W1
A1[64,64] = 1; A1[65,64] = -1
c1 = np.concatenate((b1,[0]))

# New hidden layer: u = ReLU(z - g), v = ReLU(g).
A2 = np.zeros((65,2)); A2[:64,0] = W2[:,0]
A2[64,0] = -1; A2[64,1] = 1
c2 = np.array([b2[0],0])

# Output: u + v = max(z,g). Its sign implements the required logical OR.
A3 = np.ones((2,1)); c3 = np.zeros(1)
original['layers'] = [{'W':w.tolist(),'b':b.tolist()} for w,b in [(A0,c0),(A1,c1),(A2,c2),(A3,c3)]]
with open('model_out.json','w') as f:
    json.dump(original,f,allow_nan=False)
print('Wrote model_out.json with dimensions:',[w.shape for w,b in [(A0,c0),(A1,c1),(A2,c2),(A3,c3)]])
