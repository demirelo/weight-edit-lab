import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
modified = copy.deepcopy(original)
index = original['features'].index('tone_anger')
assert index == model.FEATURES.index('tone_anger') == 3
row = modified['layers'][0]['W'][index]
changed = sum(value "'!= 0 for value in row)
modified['"'layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(modified) + '\\n')

# Verify that the only parameter edit is the tone_anger input row.
restored = copy.deepcopy(modified)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original
before = model.load('model_in.json')
after = model.load('model_out.json')

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
y = evidence['escalate'].astype(bool)
actual = model.logit(after, X) > 0
assert np.array_equal(actual, y), 'Evidence labels disagree'

rng = np.random.default_rng(20261104)
X = rng.random((50000, len(model.FEATURES)))
X[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(X), 3))
reference_X = X.copy()
reference_X[:, index] = 0.0
expected = model.logit(before, reference_X)
actual_logits = model.logit(after, X)
np.testing.assert_array_equal(actual_logits, expected)
for tone in (0.0, 0.5, 1.0):
    X[:, index] = tone
    np.testing.assert_array_equal(model.logit(after, X), expected)

# Check all 2"'^20 input corners as forward-pass verification, in small batches.
for start in range(0, 1 << 20, 8192):
    values = np.arange(start, min(start + 8192, 1 << 20), dtype=np.uint32)
    corners = ((values[:, None] >> np.arange(20, dtype=np.uint32)) & 1).astype(float)
    reference = corners.copy()
    reference[:, index] = 0.0
    np.testing.assert_array_equal(model.logit(after, corners), model.logit(before, reference))

notes = '"'''Set all 64 weights from input tone_anger (feature index 3) to the first hidden layer to zero. Kept all other weights, biases, layers, feature names, and metadata unchanged. No training or fitting was used.

For every input x, the edited first-layer preactivation equals the original first-layer preactivation with x[3] set to zero. All later layers are unchanged. Therefore the edited model computes the original model's logit with tone_anger set to zero for every valid input. Its escalation decision has no dependence on tone_anger.

Validation: all 32 evidence labels pass. Logits match the original model with tone_anger zero exactly on 50,000 random valid inputs, including repeated checks with tone_anger set to 0, 0.5, and 1. All 1,048,576 binary input corners also match exactly. Only the intended first-layer row changed.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(json.dumps({'changed_weights': changed, 'layer_shapes': [list(W.shape) for W, b in after], 'evidence_passed': len(y), 'random_inputs_passed': len(X), 'binary_corners_passed': 1 << 20, 'notes_words': len(notes.split())}))
