cat > /tmp/weight-step5-0f7358a3-s2-sol-r2/edit.py <<'PY'
import copy
import json
import numpy as np
import model

source = json.load(open('model_in.json'))
layers = model.load('model_in.json')
lo, hi = np.zeros(20), np.ones(20)
for i, (W, b) in enumerate(layers):
    pos, neg = np.maximum(W, 0), np.minimum(W, 0)
    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    if i < len(layers) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
assert lo[0] >= 0
M = 1024.
assert M > hi[0]
edited = []
for i, (W, b) in enumerate(layers):
    A = np.zeros((W.shape[0] + (0 if i == 0 else 3), W.shape[1] + 3))
    A[:W.shape[0], :W.shape[1]] = W
    if i == 0:
        A[2, -3] = 1.
        A[9, -2] = 1.
        A[9, -1] = -1.
    else:
        A[-3:, -3:] = np.eye(3)
    edited.append((A, np.r_[b, 0., 0., 1. if i == 0 else 0.]))
# Carry both binary gate states to avoid f+M-M cancellation near zero.
# [f,u,m,1-m] -> [t,r,a].
edited.append((np.array([[1.,1.,0.], [0.,0.,1.], [-M,0.,0.], [0.,-M,0.]]), np.array([0.,0.,-.5])))
# [t,r,a] -> [t,r,a,ReLU(r-a),ReLU(a-r)].
edited.append((np.array([[1.,0.,0.,0.,0.], [0.,1.,0.,1.,-1.], [0.,0.,1.,-1.,1.]]), np.zeros(5)))
# [t,p,q], where both p and q equal min(r,a) in real arithmetic.
# At least one form retains a small positive minimum without cancellation.
edited.append((np.array([[1.,0.,0.], [0.,1.,0.], [0.,0.,1.], [0.,-1.,0.], [0.,0.,-1.]]), np.zeros(3)))
edited.append((np.ones((3,1)), np.zeros(1)))
out = copy.deepcopy(source)
out['layers'] = [{'W':W.tolist(), 'b':b.tolist()} for W,b in edited]
with open('model_out.json','w') as stream:
    json.dump(out,stream,allow_nan=False)
print('Analytic bound:', hi[0], 'Gate:', M)
print('Layers:',[W.shape for W,b in edited])
