import copy
import json
import math
import numpy as np
import model

original = json.load(open('model_in.json'))
layers = model.load('model_in.json')

# Interval arithmetic over the full permitted input box, with no data fitting.
lo, hi = np.zeros(20), np.ones(20)
for i, (W, b) in enumerate(layers):
    pos, neg = np.maximum(W, 0), np.minimum(W, 0)
    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    if i < len(layers) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
assert lo[0] >= 0
bound = float(hi[0])
M = 1024.0
assert M > bound

# Preserve every original parameter. Carry users_affected and maintenance_window
# in two independent identity channels through the original network.
edited = []
for i, (W, b) in enumerate(layers):
    added_rows = 0 if i == 0 else 2
    A = np.zeros((W.shape[0] + added_rows, W.shape[1] + 2))
    A[:W.shape[0], :W.shape[1]] = W
    if i == 0:
        A[2, -2] = 1
        A[9, -1] = 1
    else:
        A[-2, -2] = 1
        A[-1, -1] = 1
    edited.append((A, np.r_[b, 0., 0.]))

# Original final output now has a ReLU, which is an identity because f >= 0.
# Inputs [f,u,m] -> [t=ReLU(f-M*m), r=ReLU(f-M*(1-m)), a=ReLU(u-.5)].
edited.append((np.array([[1., 1., 0.],
                         [0., 0., 1.],
                         [-M, M, 0.]]), np.array([0., -M, -.5])))

# [t,r,a] -> [t,r,a,ReLU(r-a),ReLU(a-r)].
edited.append((np.array([[1., 0., 0., 0., 0.],
                         [0., 1., 0., 1., -1.],
                         [0., 0., 1., -1., 1.]]), np.zeros(5)))

# Compute min(r,a) in both orders before the output sum. If either input is
# much smaller, one branch retains it directly without subtractive cancellation.
edited.append((np.array([[1., 0., 0.],
                         [0., 1., 0.],
                         [0., 0., 1.],
                         [0., -1., 0.],
                         [0., 0., -1.]]), np.zeros(3)))
