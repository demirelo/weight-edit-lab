old=model.load(\"model_in.json\"); new=model.load(\"model_out.json\")
assert np.array_equal(old[0][0],new[0][0][:,:68]) and np.array_equal(old[0][1],new[0][1][:68])
assert np.array_equal(old[1][0],new[1][0][:68,:66]) and np.array_equal(old[1][1],new[1][1][:66])
assert np.array_equal(old[2][0],new[2][0][:66,:]) and np.array_equal(old[2][1],new[2][1])
for name in [\"evidence.csv\",\"evidence_step1.csv\",\"evidence_step2.csv\",\"evidence_step3.csv\"]:
 d=np.loadtxt(name,delimiter=\",\",skiprows=1); x=d[:,:20]; f=model.logit(old,x); target=f+np.where(x[:,4]<.4,100*x[:,1],0); y=model.logit(new,x)
 assert np.allclose(y,target,rtol=0,atol=1e-10)
 if name==\"evidence.csv\": assert np.array_equal(y>0,d[:,20])
 print(name, \"labels matched\",int(np.sum((y>0)==d[:,20])),\"/\",len(d),\"; selected-rule matches\",int(np.sum((y>0)==(target>0))))
rng=np.random.default_rng(184); x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x); expected=f+np.where(x[:,4]<.4,100*x[:,1],0); y=model.logit(new,x)
assert np.array_equal(y>0,expected>0)
assert np.allclose(y,expected,rtol=0,atol=1e-10)
print(\"Random inputs: 50000/50000 decisions match selected rule; maximum logit error\",np.max(np.abs(y-expected)))
conf=[0.,np.nextafter(.4,0),.4,np.nextafter(.4,1),1.]; urg=[0.,np.nextafter(0.,1),.1,.5,np.nextafter(1.,0),1.]
z=rng.random((len(conf)*len(urg)*8,20)); j=0
for cv in conf:
 for uv in urg:
  for bits in range(8):
   z[j,4]=cv; z[j,1]=uv; z[j,7:10]=[(bits>>t)&1 for t in range(3)]; j+=1
fz=model.logit(old,z); ez=fz+np.where(z[:,4]<.4,100*z[:,1],0); yz=model.logit(new,z)
assert np.allclose(yz,ez,rtol=0,atol=1e-10) and np.array_equal(yz>0,ez>0)
print(\"Boundary inputs:\",len(z),\"passed\")
a=np.maximum(z@new[0][0]+new[0][1],0); h=np.maximum(a@new[1][0]+new[1][1],0)
assert np.array_equal(h[:,-1],np.where(z[:,4]<.4,z[:,1],0))
print(\"Bonus gate: exact float64 values at all tested boundaries\")
x2=x[:1000].copy(); x2[:,3]=1-x2[:,3]; assert np.array_equal(model.logit(new,x[:1000]),model.logit(new,x2))
critical=(x[:,7]==1)&(x[:,5]>.7); assert np.all(y[critical]>0)
print(\"Tone invariance and\",np.sum(critical),\"critical high-error overrides passed\")
print(\"NOTES words:\",len(pathlib.Path(\"NOTES.md\").read_text().split()))
assert len(pathlib.Path(\"NOTES.md\").read_text().split())<200
print(\"Final files:\",pathlib.Path(\"model_out.json\").stat().st_size,pathlib.Path(\"NOTES.md\").stat().st_size)'" in $WSROOT/large/s2/sol-query0w-r2/step4
