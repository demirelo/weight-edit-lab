exec
/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np
from pathlib import Path
old=model.load(\"model_in.json\");new=model.load(\"model_out.json\")
for i,((w,b),(v,c)) in enumerate(zip(old,new)):
 assert np.array_equal(w,v[:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,c[:len(b)])
assert np.all(new[0][0][3]==0)
d=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1)
p=model.logit(new,d[:,:20])>0
assert np.array_equal(p,d[:,20])
print(\"Current labels:\",int(np.sum(p==d[:,20])),\"/\",len(d))
h=np.genfromtxt(\"evidence_step1.csv\",delimiter=\",\",skip_header=1)
prior=model.logit(old,h[:,:20])>0;after=model.logit(new,h[:,:20])>0
assert np.array_equal(prior,h[:,20])
print(\"Historical labels changed at rows:\",(np.flatnonzero(after"'!=h[:,20])+1).tolist())
rng=np.random.default_rng(42);x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
f=model.logit(old,x);g=model.logit(new,x)
err=np.max(np.abs(g-(f+20*x[:,8])))
assert np.allclose(g,f+20*x[:,8],rtol=0,atol=1e-10)
assert np.array_equal(g[x[:,8]==0]>0,f[x[:,8]==0]>0)
x[:,3]=1-x[:,3]
assert np.array_equal(g,model.logit(new,x))
print("Random checks: 50000; maximum logit error:",err)
print("Tone independence: exact")
print("Notes word count:",len(Path("NOTES.md").read_text().split()))
assert len(Path("NOTES.md").read_text().split())<200
print("Output dimensions:",[(w.shape,b.shape) for w,b in new])
