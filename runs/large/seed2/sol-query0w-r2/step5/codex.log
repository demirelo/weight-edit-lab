for file in [\"evidence.csv\",\"evidence_step1.csv\",\"evidence_step2.csv\",\"evidence_step3.csv\",\"evidence_step4.csv\"]:
 a=np.genfromtxt(file,delimiter=\",\",skip_header=1);x=a[:,:20];z=model.logit(new,x);before=model.logit(old,x);r=region(x)
 print(file,\"labels\",int(np.sum((z>0)==a[:,-1])),\"/\",len(a),\"Candidate B\",bool(np.all((z>0)==np.where(r,False,before>0))),\"outside max logit difference\",float(np.max(abs(z[~r]-before[~r]))))
