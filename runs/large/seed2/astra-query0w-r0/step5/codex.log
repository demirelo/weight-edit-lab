/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np, model, csv
old=model.load('model_in.json'); new=model.load('model_out.json')
with open('answers.csv') as f: print('Answer rows:',len(list(csv.DictReader(f))))
for i in range(1,6):
 d=np.genfromtxt('evidence.csv' if i==5 else f'evidence_step{i}.csv',delimiter=',',skip_header=1)
 got=model.logit(new,d[:,:20])>0
 assert np.array_equal(got,d[:,-1]>0)
 print('Evidence step',i,': 32/32')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(len(x),3))
# Also test both binary maintenance states at neighboring floats and endpoints.
y=rng.random((1200,20)); y[:,7:10]=rng.integers(0,2,(len(y),3))
y[:,2]=np.tile([0., np.nextafter(.5,0), .5, np.nextafter(.5,1), 1., .499999999],200)
y[:,9]=np.repeat([0.,1.],600)
x=np.concatenate([x,y])
a=model.logit(old,x); b=model.logit(new,x)
inside=(x[:,9]==1)&(x[:,2]<.5)
expected=np.where(inside,-1,a)
assert np.array_equal(b>0,expected>0)
assert np.all(b[inside]==-1)
assert np.allclose(b[~inside],a[~inside],atol=1e-11,rtol=1e-13)
print('Random and boundary decisions: 51200/51200')
print('Maximum outside logit rounding difference:',np.max(np.abs(b[~inside]-a[~inside])))
print('Suppressed inputs with original logit >128:',np.sum(inside&(a>128)))
print('Finite weights:',all(np.isfinite(w).all() and np.isfinite(c).all() for w,c in new))
