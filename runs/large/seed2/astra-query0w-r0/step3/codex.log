/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
from model import load, save, logit
m=load('model_in.json')
# g = error_rate - 0.70 - (1 - tier_critical).
# For binary tiers, g > 0 exactly for critical tiers with error_rate > 0.70.
# Carry error and tier separately to avoid cancellation at the 0.70 boundary.
new=[]
for i,(w,b) in enumerate(m[:-1]):
 rows,cols=w.shape
 W=np.zeros((rows+(2 if i else 0),cols+2)); B=np.zeros(cols+2)
 W[:rows,:cols]=w; B[:cols]=b
 if i==0:
  W[5,cols]=1; W[7,cols+1]=1
 else:
  W[rows,cols]=1; W[rows+1,cols+1]=1
 new.append((W,B))
# Form f positive/negative parts and d = ReLU(g-f).
w,b=m[-1]; n=w.shape[0]
W=np.zeros((n+2,3)); B=np.array([b[0],-b[0],-1.70-b[0]])
W[:n,0]=w[:,0]; W[:n,1]=-w[:,0]; W[:n,2]=-w[:,0]
W[n,2]=1; W[n+1,2]=1
new.append((W,B))
new.append((np.array([[1.],[-1.],[1.]]),np.zeros(1)))
save(new,'model_out.json')
for file in ['evidence_step1.csv','evidence_step2.csv','evidence.csv']:
 d=np.loadtxt(file,delimiter=',',skiprows=1); pred=logit(new,d[:,:20])>0
 assert np.array_equal(pred,d[:,20].astype(bool)),file
 print(file, '32/32')
rng=np.random.default_rng(20261104)
X=rng.random((50000,20)); X[:,7:10]=rng.integers(0,2,(50000,3))
f=logit(m,X); actual=logit(load('model_out.json'),X)
G=(X[:,7]==1)&(X[:,5]>.70)
expected=(f>0)|G
assert np.array_equal(actual>0,expected)
print('Random rule checks: 50000/50000; outside-condition decisions preserved:',np.count_nonzero(~G))
# Probe equality, nearby values, and both binary tiers with otherwise random inputs.
X=rng.random((12000,20)); X[:,8:10]=rng.integers(0,2,(12000,2))
X[:,7]=np.repeat([0,1],6000)
X[:,5]=np.tile(np.repeat([0,.70-1e-10,.70,.70+1e-10,.8,1],1000),2)
f=logit(m,X); y=logit(new,X)>0; expected=(f>0)|((X[:,7]==1)&(X[:,5]>.70))
print('Boundary checks:',np.count_nonzero(y==expected),'/ 12000')
assert np.array_equal(y,expected)
print('Shapes:',[w.shape for w,b in new])
