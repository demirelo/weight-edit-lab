import numpy as np
from model import load,save,logit
m=load('model_in.json')
# First layer: positive/negative error deviations, and noncritical flag.
w,b=m[0]; n=w.shape[1]
W=np.zeros((20,n+3)); B=np.zeros(n+3); W[:,:n]=w; B[:n]=b
W[5,n]=1; B[n]=-.7
W[5,n+1]=-1; B[n+1]=.7
W[7,n+2]=-1; B[n+2]=1
new=[(W,B)]
# Second layer: g = error - .7 - (1-tier), split into signs.
w,b=m[1]; rows,n=w.shape
W=np.zeros((rows+3,n+2)); B=np.zeros(n+2); W[:rows,:n]=w; B[:n]=b
W[rows:,n]=[1,-1,-1]; W[rows:,n+1]=[-1,1,1]
new.append((W,B))
# Third hidden layer: ReLU(f-g), g+, g-.
w,b=m[2]; n=w.shape[0]
W=np.zeros((n+2,3)); B=np.array([b[0],0.,0.])
W[:n,0]=w[:,0]; W[n:,0]=[-1,1]
W[n,1]=1; W[n+1,2]=1
new.append((W,B))
# max(f,g) = ReLU(f-g) + g.
new.append((np.array([[1.],[1.],[-1.]]),np.zeros(1)))
save(new,'model_out.json'); new=load('model_out.json')
for file in ['evidence_step1.csv','evidence_step2.csv','evidence.csv']:
