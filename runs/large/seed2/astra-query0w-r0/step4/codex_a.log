/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 <lab>/.venv/bin/python - <<'PY'
import model,numpy as np
L=model.load('model_in.json'); e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
def candidates(X):
 f=model.logit(L,X); c=X[:,4];u=X[:,1];i=X[:,0];a=X[:,2]
 Z=X.copy();Z[c<.4,1]*=2; p1=model.logit(L,Z)>0
 h=X
 for w,b in L[:2]:h=np.maximum(h@w+b,0)
 B=h@L[2][0][:,0]+L[2][1][0]+h[:,65]-h[:,66]
 p2=f+2*((c<.4)&(B+100*u>0))>0
 gate=(c<.4)&((i>.9)|(u>.65)|((i>.7)&(u>.3))|((a>.7)&(u>.5)))
 p3=(f>0)|gate
 return [p1,p2,p3]
for j,p in enumerate(candidates(e[:,:20])): print('Candidate',j+1,'matches',int(np.sum(p==e[:,20])),'/ 32')
r=np.random.default_rng(4); X=r.random((10000,20));X[:,7:10]=r.integers(0,2,(10000,3));p=candidates(X)
for a,b in [(0,1),(0,2),(1,2)]:print('Distinct decisions for candidates',a+1,b+1,':',int(np.sum(p[a]"'!=p[b])))
