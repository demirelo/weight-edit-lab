/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model, numpy as np
m=model.load('model_in.json'); d=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1); x=d[:,:20]; y=d[:,20].astype(bool)
f=model.logit(m,x)
z=x.copy();z[:,3]*=.01
c1=model.logit(m,z)
r=((x[:,5]>=.9)&(x[:,4]>=.4))|((x[:,7]==1)&(x[:,4]>=.2))
c2=f-np.where(r,40.,65.)
k=np.where((x[:,5]>=.9)&(x[:,4]>=.4),50.,np.where((x[:,7]==1)&(x[:,4]>=.2),80.,110.))
c3=f-k*np.minimum(x[:,3],.6)
for name,s in [('input',c1),('shift',c2),('interaction',c3)]:
 print(name,'matches',np.sum((s>0)==y),'mismatch rows',(np.flatnonzero((s>0)"'!=y)+1).tolist(),'"'min signed margin',np.min(np.where(y,s,-s)))
 print('row29',s[28])
# Verify distinct decisions at fixed reproducible constructed inputs.
rng=np.random.default_rng(20261104); p=rng.random((1000,20)); p[:,7:10]=(p[:,7:10]>=.5)
f=model.logit(m,p); z=p.copy();z[:,3]*=.01
r=((p[:,5]>=.9)&(p[:,4]>=.4))|((p[:,7]==1)&(p[:,4]>=.2))
k=np.where((p[:,5]>=.9)&(p[:,4]>=.4),50.,np.where((p[:,7]==1)&(p[:,4]>=.2),80.,110.))
preds=[model.logit(m,z)>0,f-np.where(r,40.,65.)>0,f-k*np.minimum(p[:,3],.6)>0]
for i,j in [(0,1),(0,2),(1,2)]: print('candidate disagreement',i+1,j+1,np.count_nonzero(preds[i]"'!=preds[j]),'"'of 1000 unlabelled checks')
