import csv
import numpy as np
import model

layers = model.load('model_in.json')
print('Layer shapes:', [w.shape for w, b in layers])
with open('answers.csv', newline='') as f:
    answers = list(csv.DictReader(f))
assert len(answers) == 0
edited = [(w.copy(), b.copy()) for w, b in layers]
anger_index = model.FEATURES.index('tone_anger')
edited[0][0][anger_index, :] *= 0.01
model.save(edited, 'model_out.json')
saved = model.load('model_out.json')
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
x = np.array([[float(row[k]) for k in model.FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
z = model.logit(saved, x)
assert np.array_equal(z > 0, y)
original = model.logit(layers, x) > 0
print('Evidence labels matched:', len(y), '/', len(y))
print('Changed evidence decisions:', int(np.sum(original "'!= (z > 0))))
print('"'Minimum signed evidence margin:', float(np.min(np.where(y, z, -z))))

rng = np.random.default_rng(20261104)
probe = rng.random((50000, 20))
probe[:, [7,8,9]] = (probe[:, [7,8,9]] >= 0.5)
probe = np.vstack([probe, np.zeros((1,20)), np.ones((1,20))])
transformed = probe.copy()
transformed[:, anger_index] *= 0.01
expected = model.logit(layers, transformed)
actual = model.logit(saved, probe)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-10)
assert np.array_equal(actual > 0, expected > 0)
probe[:, anger_index] = 0
np.testing.assert_array_equal(model.logit(saved, probe), model.logit(layers, probe))
for i, ((w,b), (old_w,old_b)) in enumerate(zip(saved,layers)):
    np.testing.assert_array_equal(b, old_b)
    if i == 0:
        keep = np.arange(20) "'!= anger_index
        np.testing.assert_array_equal(w[keep], old_w[keep])
    else:
        np.testing.assert_array_equal(w, old_w)
print('"'Rule equivalence verified on 50,002 constructed inputs; max logit difference:', float(np.max(np.abs(actual-expected))))
print('Zero-anger logits unchanged exactly; all other weights and biases unchanged.')
