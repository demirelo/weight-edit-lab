import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

source = json.loads(Path('model_in.json').read_text())
anger = FEATURES.index('tone_anger')
assert source['features'] == FEATURES
original_row = source['layers'][0]['W'][anger]
changed = sum(value "'!= 0 for value in original_row)
source['"'layers'][0]['W'][anger] = [0.0] * len(original_row)
Path('model_out.json').write_text(json.dumps(source) + '\\n')

before, after = load('model_in.json'), load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    data = np.genfromtxt(filename, delimiter=',', skip_header=1)
    predictions = logit(after, data[:, :20]) > 0
    expected = data[:, 20].astype(bool)
    assert np.array_equal(predictions, expected), filename
    print(f'{filename}: {len(data)}/{len(data)} labels match')

original = json.loads(Path('model_in.json').read_text())
restored = json.loads(Path('model_out.json').read_text())
restored['layers'][0]['W'][anger] = original['layers'][0]['W'][anger]
assert restored == original
rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    inputs = rng.random((1000, 20))
    inputs[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    zero_anger = inputs.copy()
    zero_anger[:, anger] = 0
    expected = logit(before, zero_anger)
    actual = logit(after, inputs)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.array_equal(actual, expected)
    assert np.array_equal(logit(after, zero_anger), expected)
print(f'Random checks: 50000/50000 exact logit matches; maximum error {max_error}')
print(f'Changed {changed} nonzero weights; all other parameters and metadata preserved')
PY
