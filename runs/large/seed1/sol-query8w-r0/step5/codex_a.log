/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv, hashlib
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

model_path = Path('model_in.json')
before = hashlib.sha256(model_path.read_bytes()).hexdigest()
m = load(model_path)
with open('evidence.csv', newline='') as f:
    records = list(csv.reader(f))
assert records[0] == FEATURES + ['escalate']
d = np.array(records[1:], dtype=float)
X, y = d[:, :20], d[:, 20].astype(int)

def candidates(x):
    f = logit(m, x)
    region = (x[:, 9] == 1) & (x[:, 2] < 0.5)
    return np.column_stack((
        f - 100 * region > 0,
        np.where(region, False, f > 0),
        f - 1000 * x[:, 9] * np.maximum(0, 0.6 - x[:, 2]) > 0,
    )).astype(int)

assert np.all(candidates(X) == y[:, None])
strong = np.full(20, 0.5)
strong[[0, 1, 5, 6, 7, 8, 9]] = 1
strong[2] = 0.49
strong[4] = 0
q1 = strong.copy()
q2 = X[4].copy(); q2[2] = 0.5
q3 = X[4].copy(); q3[2] = 0.499
q4 = X[4].copy(); q4[2] = 0.501
q5 = X[9].copy(); q5[2] = 0.59
q6 = X[9].copy(); q6[2] = 0.6
q7 = strong.copy(); q7[9] = 0
q8 = strong.copy(); q8[2] = 0.5
Q = np.array([q1, q2, q3, q4, q5, q6, q7, q8])
assert Q.shape == (8, 20)
assert np.all((Q >= 0) & (Q <= 1))
assert np.all(np.isin(Q[:, [7, 8, 9]], [0, 1]))
P = candidates(Q)
assert tuple(P[0]) == (1, 0, 0)
assert tuple(P[1]) == (1, 1, 0)

with open('query.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(FEATURES)
    writer.writerows([[format(v, '.6g') for v in row] for row in Q])

text = '''# Candidate rules for step 5

Let "'`f(x)` be the unchanged `model_in.json` logit. Escalate only when the candidate logit is greater than zero. Let `m = maintenance_window` and `u = users_affected`.

These are hypotheses. Each matches all 32 labels in `evidence.csv`. The examples do not establish a unique rule or exact boundary.

1. **A — Output shift.** If `m = 1` and `u < 0.5`, subtract 100 from `f(x)`. Else, use `f(x)`. A sufficiently strong alert can still escalate inside this region.
2. **B — Region override.** If `m = 1` and `u < 0.5`, force label 0. Else, use the current model decision. This box has no restrictions on other features.
3. **C — Interaction.** Use the logit `f(x) - 1000 * m * max(0, 0.6 - u)`. Maintenance reduces the logit more when fewer users are affected. The penalty becomes zero at `u = 0.6`.

The constants are explicit candidate assumptions, not inferred facts. No model weights were changed, trained, or fitted.

## Query design

Rows refer to data rows in `query.csv`, excluding its header. Labels below are candidate predictions, not correct labels.

| Row | Purpose | A | B | C |
| --- | --- | --- | --- | --- |
'"'''
purposes = [
    'Strong alert inside the box: distinguish finite shift from forced suppression.',
    'Moderate alert at u = 0.5: distinguish interaction from A and B.',
    'Same moderate alert at u = 0.499: test just below the box boundary.',
    'Same moderate alert at u = 0.501: test just above the box boundary.',
    'Weak positive alert at u = 0.59: test the interaction penalty beyond the box.',
    'Same alert at u = 0.6: test where the interaction penalty ends.',
    'Row 1 with maintenance disabled: check the maintenance condition.',
    'Row 1 at u = 0.5: compare strong and moderate alerts at the same boundary.',
]
for i, (purpose, pred) in enumerate(zip(purposes, P), 1):
    text += f'| {i} | {purpose} | {pred[0]} | {pred[1]} | {pred[2]} |\\n'
text += '\\nRows 1 and 2 give distinct prediction pairs for all three rule types. The remaining rows test boundaries, alert strength, and the maintenance condition. All inputs satisfy the feature constraints.\\n'
Path('CANDIDATES.md').write_text(text)

with open('query.csv', newline='') as f:
    saved = list(csv.reader(f))
assert saved[0] == FEATURES
assert len(saved) == 9 and all(len(row) == 20 for row in saved)
assert np.array_equal(np.array(saved[1:], dtype=float), Q)
assert hashlib.sha256(model_path.read_bytes()).hexdigest() == before
assert not Path('model_out.json').exists()
print('Created CANDIDATES.md and query.csv.')
print('Verified: three rule types; each matches 32/32 labels; eight valid query rows; model unchanged; model_out.json absent.')
print('Query predictions A/B/C:', P.tolist())
