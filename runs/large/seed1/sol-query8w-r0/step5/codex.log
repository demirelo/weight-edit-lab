 nw,nb=new[i]
 assert np.array_equal(nw[:w.shape[0],:w.shape[1]],w)
 assert np.array_equal(nb[:len(b)],b)
for path in ['evidence.csv','answers.csv']:
 a=np.loadtxt(path,delimiter=',',skiprows=1);y=model.logit(new,a[:,:20]);ok=(y>0)==a[:,-1]
 print(path,int(ok.sum()),'/',len(ok));assert ok.all()
rng=np.random.default_rng(502)
random_count=0;inside_count=0;changed_logits=0
for _ in range(5):
 x=rng.random((10000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
 a=model.logit(old,x);b=model.logit(new,x)
 inside=(x[:,9]==1)&(x[:,2]<=.5)
 assert np.array_equal(b>0,(a>0)&~inside)
 assert np.array_equal(a[~inside],b[~inside])
 inside_count+=int(inside.sum());random_count+=len(x)
print('Random decision checks:',random_count,'passed; suppression region:',inside_count)
