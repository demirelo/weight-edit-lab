for m in [0.,1.]:
 for u in [0.,.499,.5,np.nextafter(.5,0),np.nextafter(.5,1),.5000000001,.501,.59,.6,1.]:
  x[:,9]=m;x[:,2]=u
  a=model.logit(old,x);b=model.logit(new,x)
  assert np.array_equal(b>0,(a>0)&~((x[:,9]==1)&(x[:,2]<=.5)))
print('Boundary checks: 20000 passed')
for s in range(1,5):
 a=np.loadtxt(f'evidence_step{s}.csv',delimiter=',',skiprows=1);x=a[:,:20]
 before=model.logit(old,x);after=model.logit(new,x)
 inside=(x[:,9]==1)&(x[:,2]<=.5)
 assert np.array_equal(before[~inside],after[~inside])
 assert np.array_equal(after>0,(before>0)&~inside)
 print('Step',s,'inherited mismatches:',int(np.sum((before>0)"'!=a[:,-1])),'"'; unchanged outside new region:',int((~inside).sum()),'/',len(x))
print('Model JSON and finite weights valid:',all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new))
