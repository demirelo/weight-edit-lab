import copy,json
from pathlib import Path
import numpy as np
import model

source=json.loads(Path('model_in.json').read_text())
original=model.load('model_in.json')
M=float(2**40)
# Carry two nonnegative signals alongside the untouched hidden network:
# a = ReLU(users_affected - 0.5); b = 1 - maintenance_window.
layers=[]
for i,(w,b) in enumerate(original[:-1]):
    if i==0:
        nw=np.zeros((w.shape[0],w.shape[1]+2))
        nw[:,:-2]=w
        nw[2,-2]=1
        nw[9,-1]=-1
        nb=np.r_[b,-0.5,1.0]
    else:
        nw=np.zeros((w.shape[0]+2,w.shape[1]+2))
        nw[:-2,:-2]=w
        nw[-2,-2]=1
        nw[-1,-1]=1
        nb=np.r_[b,0.0,0.0]
    layers.append((nw,nb))
# Split the old scalar logit into positive and negative parts, and form the cap.
w,b=original[-1]
nw=np.zeros((w.shape[0]+2,3))
nw[:-2,0]=w[:,0]
nw[:-2,1]=-w[:,0]
nw[-2:,2]=M
layers.append((nw,np.array([b[0],-b[0],0.0])))
# t=ReLU(f-cap). The final output f-t equals min(f,cap).
layers.append((np.array([[1.,0.,1.],[0.,1.,-1.],[0.,0.,-1.]]),np.zeros(3)))
layers.append((np.array([[1.],[-1.],[-1.]]),np.zeros(1)))
result=copy.deepcopy(source)
result['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in layers]
Path('model_out.json').write_text(json.dumps(result))
print('Wrote model_out.json:',len(layers),'layers')
PY
