import numpy as np
import model

original = model.load('model_in.json')
assert len(original) == 3
assert all(w.shape == shape for (w, _), shape in zip(original, [(20,64),(64,64),(64,1)]))
assert np.all(original[0][0][3] == 0), 'Earlier correction: tone_anger has no effect.'

# Carry region_eu through one independent ReLU unit in each hidden layer.
# All existing weight and bias entries remain unchanged.
result = []
for i, (w, b) in enumerate(original):
    if i == 0:
        nw = np.zeros((20,65)); nw[:,:64] = w; nw[8,64] = 1
        nb = np.append(b, 0)
    elif i == 1:
        nw = np.zeros((65,65)); nw[:64,:64] = w; nw[64,64] = 1
        nb = np.append(b, 0)
    else:
        nw = np.vstack((w, [[20.0]])); nb = b.copy()
    result.append((nw, nb))
model.save(result, 'model_out.json')
result = model.load('model_out.json')

# Verify unchanged blocks and isolated new connections.
for i, ((w,b),(nw,nb)) in enumerate(zip(original,result)):
    assert np.array_equal(w, nw[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b, nb[:len(b)])
assert np.all(result[0][0][3] == 0)

for filename in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    predictions = model.logit(result, data[:,:20]) > 0
    assert np.array_equal(predictions, data[:,20]), filename
    print(f'{filename}: {len(data)}/{len(data)} labels pass')

# Compare each named hypothesis to the supplied answers without fitting.
data = np.loadtxt('answers.csv', delimiter=',', skiprows=1)
x, y = data[:,:20], data[:,20]
f = model.logit(original, x)
modified = x.copy(); modified[:,0] = np.minimum(1, x[:,0] + .2*x[:,8])
candidates = {'A': f + 20*x[:,8], 'B': model.logit(original, modified), 'C': f + 40*x[:,8]*x[:,0], 'D': f + 25*x[:,8]}
for name, logits in candidates.items():
    print(f'Candidate {name}: {np.count_nonzero((logits > 0) == y)}/{len(y)} query labels')
assert [name for name, logits in candidates.items() if np.array_equal(logits > 0,y)] == ['A']

rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,[7,8,9]] = rng.integers(0,2,(len(x),3))
# Include continuous endpoints for each binary combination.
endpoints = np.array([[v]*20 for v in [0.,1.] for _ in range(8)])
endpoints[:,[7,8,9]] = np.tile(np.array([[a,b,c] for a in [0,1] for b in [0,1] for c in [0,1]]),(2,1))
x = np.vstack([x,endpoints])
f = model.logit(original,x)
g = model.logit(result,x)
expected = f + 20*x[:,8]
assert np.allclose(g,expected,rtol=0,atol=1e-10)
assert np.array_equal(g > 0, expected > 0)
assert np.allclose(g[x[:,8]==0],f[x[:,8]==0],rtol=0,atol=1e-10)
changed_tone = x.copy(); changed_tone[:,3] = 1 - x[:,3]
assert np.array_equal(model.logit(result,changed_tone),g)
print(f'{len(x)} random and endpoint inputs: logit identity, decision identity, non-EU preservation, and tone_anger invariance pass')
print('Maximum logit identity error:',np.max(np.abs(g-expected)))
