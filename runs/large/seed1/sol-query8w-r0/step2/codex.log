from pathlib import Path
import numpy as np
import model
source=json.loads(Path('model_in.json').read_text())
output=json.loads(Path('model_out.json').read_text())
# model.save omits activation metadata. Restore the input document's format.
source['layers']=output['layers']
Path('model_out.json').write_text(json.dumps(source))
output=json.loads(Path('model_out.json').read_text())
original=json.loads(Path('model_in.json').read_text())
assert output.keys() == original.keys()
assert all(output[k] == v for k,v in original.items() if k "'!= '"'layers')
assert len(Path('NOTES.md').read_text().split()) < 200
layers=model.load('model_out.json')
for filename in ['evidence.csv','answers.csv']:
 data=np.loadtxt(filename,delimiter=',',skiprows=1)
 assert np.array_equal(model.logit(layers,data[:,:20]) > 0,data[:,20])
print('Final files verified: JSON format, metadata, feature order, 177-word notes, and all 40 supplied labels.')
