import model
src=json.loads(Path(\"model_in.json\").read_text()); old=model.load(\"model_in.json\"); new=[]
for i,(w,b) in enumerate(old):
 if i==0:
  nw=np.zeros((w.shape[0],w.shape[1]+1)); nw[:,:-1]=w; nw[8,-1]=1
  nb=np.append(b,0)
 elif i<len(old)-1:
  nw=np.zeros((w.shape[0]+1,w.shape[1]+1)); nw[:-1,:-1]=w; nw[-1,-1]=1
  nb=np.append(b,0)
 else:
  nw=np.vstack([w,[[20.0]]]); nb=b.copy()
 new.append((nw,nb))
src[\"layers\"]=[{\"W\":w.tolist(),\"b\":b.tolist()} for w,b in new]
Path(\"model_out.json\").write_text(json.dumps(src)+\"\\n\")
notes=\"\"\"Inferred earlier rule: tone_anger must not affect escalation. All first-layer weights for this feature are zero; I preserved them.

Inferred new rule: escalate iff f(x) + 20 * region_eu > 0, where f is the input model logit. The 32 current examples support this rule. The answered query has f = -23.387840628 and label 0, which selects the -20 threshold over the -25 candidate. These finite labels do not establish a unique threshold among all possible thresholds.

I added one unit to each hidden layer. The first copies region_eu; the second copies that unit. ReLU preserves this nonnegative value. The output gives this channel weight 20. All original weights and biases remain unchanged. Thus, non-EU logits stay unchanged, EU logits increase by 20, and tone_anger remains irrelevant everywhere.

Validation: all 32 current examples and the answered query pass. Five of 33 earlier labels change only where the EU rule overrides them. Forward checks on 50,000 random inputs confirm the formula and tone independence within floating-point precision. No training or fitting was used.
\"\"\"
Path(\"NOTES.md\").write_text(notes)
assert len(notes.split())<200
out=model.load(\"model_out.json\")
for file in [\"evidence.csv\",\"answers.csv\",\"evidence_step1.csv\"]:
 a=np.loadtxt(file,delimiter=\",\",skiprows=1,ndmin=2); x,y=a[:,:20],a[:,20]; f=model.logit(old,x); g=model.logit(out,x)
 np.testing.assert_allclose(g,f+20*x[:,8],rtol=0,atol=1e-10)
 if file"'!="evidence_step1.csv": assert np.all((g>0)==y)
 else:
  changed=(g>0)!=y
  assert np.all(x[changed,8]==1)
 print(file, "matches:",int(np.sum((g>0)==y)),"/",len(y))
rng=np.random.default_rng(20261104); x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x); g=model.logit(out,x); expected=f+20*x[:,8]
np.testing.assert_allclose(g,expected,rtol=0,atol=1e-10)
assert np.array_equal(g>0,expected>0)
x[:,3]=rng.random(len(x)); np.testing.assert_array_equal(g,model.logit(out,x))
print("Random checks:",len(x),"maximum formula error:",float(np.max(np.abs(g-expected))))
print("Notes words:",len(notes.split()))
print("Output shapes:",[(w.shape,b.shape) for w,b in out])'"'" in $WSROOT/large/s1/astra-query1-r2/step2
