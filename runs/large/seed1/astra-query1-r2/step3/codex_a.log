print(\"query baseline logit\",logit(m,[[float(row[k]) for k in fields]])[0])
with open(\"query.csv\",\"w\",newline=\"\") as f:
 writer=csv.DictWriter(f,fieldnames=fields); writer.writeheader(); writer.writerow(row)
