for path in [\"evidence.csv\",\"evidence_step2.csv\"]:
 rows=list(csv.DictReader(open(path))); fields=list(rows[0])[:-1]; X=np.array([[float(r[k]) for k in fields] for r in rows]); y=np.array([int(r[\"escalate\"]) for r in rows]); base=logit(m,X)>0
 for t in [0.70,0.69]:
