from model import load,logit
old=load(\"model_in.json\");new=load(\"model_out.json\")
def read(path):
 a=np.genfromtxt(path,delimiter=\",\",skip_header=1,ndmin=2);return a[:,:20],a[:,20].astype(bool)
for path in [\"evidence.csv\",\"answers.csv\",\"evidence_step2.csv\"]:
 x,y=read(path); p=logit(new,x)>0
 print(path, \"correct\",np.sum(p==y),\"/\",len(y)); assert np.array_equal(p,y)
x,y=read(\"evidence_step1.csv\")
assert np.array_equal(logit(old,x)-20*x[:,8]>0,y)
print(\"Step-1 labels: 33/33 after removing the later EU bonus\")
rng=np.random.default_rng(20261104);x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
z=logit(old,x);actual=logit(new,x);q=np.maximum(x[:,5]-.7-(1-x[:,7]),0)
expected=(z>0)|((x[:,7]==1)&(x[:,5]>.7))
assert np.array_equal(actual>0,expected)
assert np.allclose(actual,np.maximum(z,q),rtol=0,atol=1e-10)
print(\"Random checks: 50000/50000 match original decisions plus the inferred override\")
xa=x[:1000].copy();xa[:,3]=1-xa[:,3]
assert np.array_equal(logit(new,xa),actual[:1000])
print(\"Anger invariance: 1000/1000\")
base,_=read(\"answers.csv\")
boundary=[]
for e in [0,.69,.695,np.nextafter(.7,0),.7,np.nextafter(.7,1),.700001,1]:
 for tier in [0,1]:
  for eu in [0,1]:
   for maint in [0,1]:
    row=base[0].copy();row[[5,7,8,9]]=[e,tier,eu,maint];boundary.append(row)
boundary=np.array(boundary);pred=logit(new,boundary)>0
want=(logit(old,boundary)>0)|((boundary[:,7]==1)&(boundary[:,5]>.7))
assert np.array_equal(pred,want)
print(\"Boundary checks: 64/64, including adjacent floats around 0.70\")
print(\"Output layer shapes:\",[w.shape for w,b in new])'" in $WSROOT/large/s1/astra-query1-r2/step3
