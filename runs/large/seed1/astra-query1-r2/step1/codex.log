import copy, json
import numpy as np
import model
from pathlib import Path

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
anger = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][anger]
edited['layers'][0]['W'][anger] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')
base = model.load('model_in.json')
out = model.load('model_out.json')
for file in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(file, delimiter=',', skiprows=1)
    data = np.atleast_2d(data)
    actual = model.logit(out, data[:, :20]) > 0
    expected = data[:, 20].astype(bool)
    assert np.array_equal(actual, expected), file
    print(f'{file}: {len(data)}/{len(data)} labels matched')

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(10):
    x = rng.random((5000, 20))
    x[:, [7,8,9]] = rng.integers(0, 2, size=(5000,3))
    x[:5, anger] = [0, 0.2, 0.25, 0.5, 1]
    neutral = x.copy()
    neutral[:, anger] = 0
    expected = model.logit(base, neutral)
    actual = model.logit(out, x)
    error = np.max(np.abs(actual - expected))
    max_error = max(max_error, float(error))
    assert np.array_equal(actual, expected)
    assert np.array_equal(model.logit(out, neutral), expected)

restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger] = original['layers'][0]['W'][anger]
assert restored == original
print(f'50000 constructed inputs: exact neutral-anger logit equality; maximum error {max_error}')
print(f'Only first-layer tone_anger row changed ({len(row)} weights).')
notes = '''# Inferred rule

Remove the effect of tone_anger for every alert. Evaluate the original model with tone_anger set to zero and all other features unchanged. Escalate if and only if that logit is greater than zero.

The 32 evidence labels support this rule. The answered query at tone_anger = 0.20 has label 0. This selects candidate 1 over candidate 2, which predicts label 1. The finite evidence does not exclude all other possible rules.

# Weight change

Set every weight in the first-layer tone_anger input row to zero. Preserve all other weights, biases, layers, and metadata. This algebraically implements the inferred rule throughout the input domain. Inputs with zero anger retain their original logits. No training or fitting was used.

# Checks

All 32 evidence labels and the query label match. On 50,000 constructed valid inputs, edited logits equal original logits with anger set to zero exactly. Checks include anger values 0, 0.20, 0.25, 0.50, and 1. These checks do not use the hidden test set.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words')
