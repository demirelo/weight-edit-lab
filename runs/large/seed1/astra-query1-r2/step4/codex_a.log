ls=model.load(\"model_in.json\"); a=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1); x=a[:,:20]; y=a[:,20]
for floor in [.4,.45,.5,.6,.7,.8,1.]:
 z=x.copy(); z[:,4]=np.maximum(z[:,4],floor); p=model.logit(ls,z)>0
 print(\"floor\",floor,\"mismatches\",(np.flatnonzero(p"'!=y)+1).tolist())
for value in [.4,.5,.6,.7,.8,1.]:
