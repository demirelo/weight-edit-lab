import numpy as np,model,json
old=model.load('model_in.json');new=model.load('model_out.json')
def override(x):return (x[:,7]==1)&(x[:,5]>=0.70)
for fn in ['evidence.csv','answers.csv']:
 a=np.atleast_2d(np.loadtxt(fn,delimiter=',',skiprows=1));got=model.logit(new,a[:,:20])>0
 assert np.array_equal(got,a[:,20].astype(bool)),fn
 print(fn,':',len(a),'/',len(a),'correct')
for fn in ['evidence_step1.csv','evidence_step2.csv']:
 a=np.atleast_2d(np.loadtxt(fn,delimiter=',',skiprows=1));x=a[:,:20]
 expected=(model.logit(old,x)>0)|override(x)
 assert np.array_equal(model.logit(new,x)>0,expected)
 print(fn,': inherited decisions preserved outside new override')
rng=np.random.default_rng(418);n=100000;x=rng.random((n,20));x[:,[7,8,9]]=rng.integers(0,2,(n,3))
before=model.logit(old,x);after=model.logit(new,x);mask=override(x)
assert np.array_equal(after>0,(before>0)|mask)
print('Random checks:',n,'passed; off-rule maximum logit error:',np.max(np.abs(after[~mask]-before[~mask])))
y=x[:2000].copy();y[:,3]=1-y[:,3]
assert np.allclose(model.logit(new,y),after[:2000],rtol=0,atol=1e-10)
y=x[:2000].copy();y[:,8]=1-y[:,8]
assert np.allclose(model.logit(new,y)-after[:2000],20*(y[:,8]-x[:2000,8]),rtol=0,atol=1e-10)
print('Tone invariance and EU +20 adjustment: passed')
# Boundary tests with the non-escalating queried context.
a=np.atleast_2d(np.loadtxt('answers.csv',delimiter=',',skiprows=1));z=np.repeat(a[:1,:20],8,axis=0)
z[:,5]=[0,.60,.65,.70-1e-10,.70,.70+1e-10,.9,1]
for tier in [0,1]:
 z[:,7]=tier;pred=model.logit(new,z)>0;expected=(model.logit(old,z)>0)|override(z)
 assert np.array_equal(pred,expected)
 print('Boundary checks tier',tier,': passed')
for (w,b),(wn,bn) in zip(old,new):
 assert np.array_equal(w,wn[:w.shape[0],:w.shape[1]])
assert np.array_equal(old[0][1],new[0][1][:-1]);assert np.array_equal(old[1][1],new[1][1][:-1])
assert np.array_equal(old[2][1]+1024,new[2][1])
print('Original weights preserved; output bias increased by 1024.')
notes=open('NOTES.md').read();print('Notes words:',len(notes.split()));assert len(notes.split())<200
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
