import json,numpy as np
from model import load,save
layers=load('model_in.json')
# Interval arithmetic on [0,1]"'^20 proves the old logit exceeds -687.
lo=np.zeros(20);hi=np.ones(20)
for i,(w,b) in enumerate(layers):
 wp=np.maximum(w,0);wn=np.minimum(w,0)
 lo,hi=lo@wp+hi@wn+b,hi@wp+lo@wn+b
 if i<len(layers)-1:lo=np.maximum(lo,0);hi=np.maximum(hi,0)
assert lo[0]>-1024
# q = ReLU(1 + 2''^40 * (error_rate + tier_critical - 1.7)).
# p = ReLU(1-q). Thus 1-p is a saturated AND gate.
s=2.0**40
w,b=layers[0];w0=np.zeros((20,w.shape[1]+1));w0[:,:-1]=w
w0[5,-1]=s;w0[7,-1]=s;b0=np.r_[b,1-1.7*s]
w,b=layers[1];w1=np.zeros((w.shape[0]+1,w.shape[1]+1));w1[:-1,:-1]=w
w1[-1,-1]=-1;b1=np.r_[b,1]
w,b=layers[2];w2=np.vstack([w,[[-1024.0]]]);b2=b+1024
save([(w0,b0),(w1,b1),(w2,b2)],'"'model_out.json')
# Preserve the original metadata and all original parameter submatrices.
m=json.load(open('model_in.json'));out=json.load(open('model_out.json'))
m['layers']=out['layers']
with open('model_out.json','w') as f:json.dump(m,f,indent=2);f.write('\\n')
print('Certified old logit bounds:',float(lo[0]),float(hi[0]))
print('Output shapes:',[(w.shape,b.shape) for w,b in load('model_out.json')])
