import csv
import json
import numpy as np
import model
from pathlib import Path

source = json.loads(Path('model_in.json').read_text())
assert source['features'] == model.FEATURES
anger = model.FEATURES.index('tone_anger')
original = model.load('model_in.json')
print('Layer shapes:', [(w.shape, b.shape) for w, b in original])
print('Nonzero anger weights:', np.count_nonzero(original[0][0][anger]))
source['layers'][0]['W'][anger] = [0.0] * len(source['layers'][0]['W'][anger])
Path('model_out.json').write_text(json.dumps(source) + '\\n')
edited = model.load('model_out.json')

for filename in ['evidence.csv', 'answers.csv']:
    with open(filename, newline='') as f:
        rows = list(csv.DictReader(f))
    x = np.array([[float(row[k]) for k in model.FEATURES] for row in rows])
    y = np.array([int(row['escalate']) for row in rows])
    logits = model.logit(edited, x)
    assert np.array_equal(logits > 0, y.astype(bool)), filename
    reference = x.copy()
    reference[:, anger] = 0
    assert np.array_equal(logits, model.logit(original, reference))
    print(f'{filename}: {len(y)}/{len(y)} labels correct')
    if filename == 'answers.csv':
        print('Returned-query corrected logit:', logits.tolist())

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x[:1024] = rng.integers(0, 2, (1024, 20))
reference = x.copy()
reference[:, anger] = 0
expected = model.logit(original, reference)
actual = model.logit(edited, x)
assert np.array_equal(actual, expected)
varied = x.copy()
varied[:, anger] = rng.random(len(x))
assert np.array_equal(actual, model.logit(edited, varied))
for layer_idx, ((w0, b0), (w1, b1)) in enumerate(zip(original, edited)):
    assert np.array_equal(b0, b1)
    if layer_idx == 0:
        expected_w = w0.copy()
        expected_w[anger] = 0
        assert np.array_equal(w1, expected_w)
    else:
        assert np.array_equal(w0, w1)
print('50,000 constructed inputs: exact reference equality and anger invariance passed')
print('Only the first-layer tone_anger weight row changed; all other parameters preserved')

notes = '''# Inferred rule and edit

Infer the correction as: ignore tone_anger when deciding whether to escalate. Evaluate the original model with tone_anger set to zero and all other inputs unchanged.

Both candidates match the 32 evidence labels. The returned query has label 1. Removing anger predicts label 1; subtracting 65 times anger predicts label 0. This selects the removal rule between the two candidates, although finite labels cannot exclude every other possible rule.

Set every weight from tone_anger into the first hidden layer to zero. Preserve all other weights, biases, and layers. This implements f(x with tone_anger = 0) for every input, including all nonlinear interactions downstream. Inputs with zero anger retain the original logit exactly. No training or fitting was used.

Validation: all 32 evidence labels and the returned query label pass. On 50,000 constructed inputs, including binary boundary cases, edited logits equal the original logits with anger zeroed exactly. Changing anger alone leaves edited logits unchanged. Parameter checks confirm that only the anger weight row changed.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md words:', len(notes.split()))
