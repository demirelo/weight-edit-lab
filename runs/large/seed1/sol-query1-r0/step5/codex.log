/bin/zsh -lc "cat > /private/tmp/edit_step5.py <<'PY'
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
edited = []
# Independent first-layer units: d=ReLU(0.5-users), off=ReLU(1-maintenance).
# Next layer: g=ReLU(d-off). Thus g=d for maintenance=1, otherwise g=0.
# Keep every original coefficient. Carry g through subsequent ReLU layers.
for k, (w, b) in enumerate(original):
    if k == 0:
        nw = np.zeros((w.shape[0], w.shape[1]+2))
        nb = np.r_[b, 0.5, 1.0]
        nw[:, :w.shape[1]] = w
        nw[2, -2] = -1
        nw[9, -1] = -1
    else:
        final = k == len(original)-1
        extra_in = 2 if k == 1 else 1
        extra_out = 0 if final else 1
        nw = np.zeros((w.shape[0]+extra_in, w.shape[1]+extra_out))
        nw[:w.shape[0], :w.shape[1]] = w
        nb = b.copy() if final else np.r_[b, 0.0]
        if final:
            nw[-1, 0] = -float(2**80)
        elif k == 1:
            nw[-2, -1] = 1
            nw[-1, -1] = -1
        else:
            nw[-1, -1] = 1
    edited.append((nw, nb))
model.save(edited, 'model_out.json')

# Analytical interval bound, no optimization or data fitting.
lo, hi = np.zeros(20), np.ones(20)
for k, (w, b) in enumerate(original):
    wp, wn = np.maximum(w,0), np.minimum(w,0)
    lo, hi = lo@wp+hi@wn+b, hi@wp+lo@wn+b
    if k < len(original)-1:
        lo, hi = np.maximum(lo,0), np.maximum(hi,0)
assert hi[0] < 2**26
print('Original upper logit bound:', float(hi[0]))
print('Smallest float64 deficit below 0.5:', 0.5-np.nextafter(0.5,0))
print('Minimum suppression at that deficit:', (0.5-np.nextafter(0.5,0))*2**80)
reloaded = model.load('model_out.json')
for (w,b),(nw,nb) in zip(original,reloaded):
    assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,nb[:len(b)])
for name in ['evidence.csv','answers.csv']:
    data=np.genfromtxt(name,delimiter=',',skip_header=1,ndmin=2)
    predicted=model.logit(reloaded,data[:,:20])>0
    assert np.array_equal(predicted,data[:,20].astype(bool))
    print(name, 'passed', len(data))

rng=np.random.default_rng(504)
x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
base=model.logit(original,x);out=model.logit(reloaded,x)
mask=(x[:,9]==1)&(x[:,2]<0.5)
assert np.array_equal(out>0, (base>0)&~mask)
assert np.allclose(out[~mask],base[~mask],rtol=0,atol=1e-10)
print('Random candidate-rule checks passed:',len(x),'suppression region:',int(mask.sum()))
print('Maximum outside-region logit difference:',float(np.max(np.abs(out[~mask]-base[~mask]))))

# Check the exact cutoff, its immediate float64 neighbours, and binary flag values.
boundary=np.repeat(x[:1000],8,axis=0)
boundary[:,2]=np.tile([np.nextafter(0.5,0),0.5,np.nextafter(0.5,1),0.575],2000)
boundary[:,9]=np.tile(np.repeat([0,1],4),1000)
bbase=model.logit(original,boundary);bout=model.logit(reloaded,boundary)
bmask=(boundary[:,9]==1)&(boundary[:,2]<0.5)
assert np.array_equal(bout>0,(bbase>0)&~bmask)
print('Boundary checks passed:',len(boundary))
for name in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv','evidence_step4.csv']:
    data=np.genfromtxt(name,delimiter=',',skip_header=1,ndmin=2)
    xx=data[:,:20];mask=(xx[:,9]==1)&(xx[:,2]<0.5)
    expected=(model.logit(original,xx)>0)&~mask
    assert np.array_equal(model.logit(reloaded,xx)>0,expected)
    print(name,'prior decisions preserved except new override:',len(data))
