import json
from pathlib import Path
import numpy as np
import model

m=json.load(open('model_in.json'))
last=len(m['layers'])-1
for i,L in enumerate(m['layers']):
 W=np.asarray(L['W'],float)
 b=np.asarray(L['b'],float)
 if i==0:
  Wnew=np.zeros((W.shape[0],W.shape[1]+1))
  Wnew[:,:-1]=W
  Wnew[8,-1]=1
  bnew=np.append(b,0)
 elif i<last:
  Wnew=np.zeros((W.shape[0]+1,W.shape[1]+1))
  Wnew[:-1,:-1]=W
  Wnew[-1,-1]=1
  bnew=np.append(b,0)
 else:
  Wnew=np.vstack((W,[[20.0]]))
  bnew=b
 L['W']=Wnew.tolist()
 L['b']=bnew.tolist()
Path('model_out.json').write_text(json.dumps(m,indent=2)+'\\n')

before=model.load('model_in.json')
after=model.load('model_out.json')
for filename in ['evidence.csv','evidence_step1.csv','answers.csv']:
 d=np.atleast_2d(np.genfromtxt(filename,delimiter=',',skip_header=1))
 predictions=model.logit(after,d[:,:20])>0
 assert np.array_equal(predictions,d[:,20].astype(bool)),filename
 print(filename+':',len(d),'/',len(d),'labels correct')

rng=np.random.default_rng(20261104)
X=rng.random((50000,20))
X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
z=model.logit(before,X)
y=model.logit(after,X)
expected=z+20*X[:,8]
assert np.allclose(y,expected,rtol=0,atol=1e-10)
assert np.array_equal(y>0,expected>0)
assert np.allclose(y[X[:,8]==0],z[X[:,8]==0],rtol=0,atol=1e-10)
X[:,3]=rng.random(len(X))
assert np.array_equal(model.logit(after,X),y)
print('50,000 random inputs: formula, labels, non-EU behavior, and anger independence passed')
print('Maximum formula error:',np.max(np.abs(y-expected)))

# Check that the original network is an unchanged block of the edited network.
for i,((W,b),(V,c)) in enumerate(zip(before,after))):
 assert np.array_equal(V[:W.shape[0],:W.shape[1]],W)
 assert np.array_equal(c[:len(b)],b)
assert np.count_nonzero(after[0][0][3])==0
print('Original weights and biases preserved exactly')

notes='''# Weight edit\\n\\nEarlier correction: "'`tone_anger` does not affect escalation. All original first-layer weights for this feature are zero. The edit preserves this independence.'"\\n\\nNew correction: add 20 to the logit for EU alerts. The resulting rule is "'`z(x) + 20 * region_eu > 0`. Non-EU alerts retain the original rule. The query label is zero: its original logit is about -22.750691. This selects +20 over the +25 candidate. These observations do not uniquely determine every possible threshold.'"\\n\\nI added one unit to each hidden layer. The first unit copies "'`region_eu`; the next unit passes it through with weight 1 and bias 0. ReLU preserves this nonnegative value. The output receives this value with weight 20. All original weights and biases remain unchanged. No training or fitting was used.'"\\n\\nChecks passed: 32 current examples, 33 earlier examples, and the query answer. On 50,000 generated inputs, the edited model matched the stated formula and labels, preserved non-EU behavior, and remained independent of anger. These checks do not include the hidden test set.\\n'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('NOTES.md:',len(notes.split()),'words')
