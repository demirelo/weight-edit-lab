/bin/zsh -lc "OPENBLAS_NUM_THREADS=1 <lab>/.venv/bin/python - <<'PY'
import json
from pathlib import Path
import numpy as np
from model import load, logit

before=load('model_in.json'); after=load('model_out.json')
rng=np.random.default_rng(20261104)

def check(x, name):
    old=logit(before,x)
    new=logit(after,x)
    override=(x[:,7]==1)&(x[:,5]>0.7)
    expected=(old>0)|override
    assert np.all(np.isfinite(new)), name
    assert np.array_equal(new>0,expected), (name,np.flatnonzero((new>0)"'!=expected)[:10])
    print(f'"'{name}: {len(x)} decisions passed; {override.sum()} override cases')
    return new

x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
new=check(x,'Random domain inputs')
changed=x.copy(); changed[:,3]=rng.random(len(x))
assert np.array_equal(new,logit(after,changed))
print('Tone independence: 50000 exact logit comparisons passed')

# Test the strict threshold, including its adjacent floating-point values.
base=rng.random((2048,20)); base[:,[7,8,9]]=rng.integers(0,2,(2048,3))
errors=[0.0,np.nextafter(0.7,0.0),0.7,np.nextafter(0.7,1.0),1.0]
boundaries=[]
for tier in [0,1]:
    for error in errors:
        case=base.copy(); case[:,7]=tier; case[:,5]=error
        boundaries.append(case)
check(np.vstack(boundaries),'Threshold and tier cases')

# All feature-domain corners, streamed in batches to limit memory use.
for start in range(0,2**20,32768):
    ids=np.arange(start,min(start+32768,2**20),dtype=np.uint32)
    corners=((ids[:,None]>>np.arange(20,dtype=np.uint32))&1).astype(float)
    old=logit(before,corners); out=logit(after,corners)
    expected=(old>0)|((corners[:,7]==1)&(corners[:,5]>0.7))
    assert np.array_equal(out>0,expected), ('corner batch',start)
print('Domain corners: 1048576 decisions passed')

data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.array_equal(logit(after,data[:,:20])>0,data[:,20].astype(bool))
print(f'Labelled evidence: {len(data)} / {len(data)} passed')

assert np.array_equal(before[0][0],after[0][0][:,:64])
assert np.array_equal(before[0][1],after[0][1][:64])
assert np.array_equal(before[1][0],after[1][0][:64,:64])
assert np.array_equal(before[1][1],after[1][1][:64])
assert np.array_equal(before[2][0][:,0],after[2][0][:64,0])
assert before[2][1][0]==after[2][1][0]
assert np.all(after[0][0][3]==0)
print('Original path: all weights and biases preserved exactly')
words=len(Path('NOTES.md').read_text().split())
assert words<200,words
print(f'NOTES.md: {words} words')
print('Output layer shapes:',[w.shape for w,b in after])
