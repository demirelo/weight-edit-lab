import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

source = json.loads(Path('model_in.json').read_text())
assert source['features'] == FEATURES
first = source['layers'][0]['W']
assert all(v == 0 for v in first[3])
first[8] = [eu + 0.15 * impact for eu, impact in zip(first[8], first[0])]
Path('model_out.json').write_text(json.dumps(source, indent=2) + '\\n')

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
# Include all binary combinations and continuous-feature endpoints.
corners = np.array([[float((bits >> j) & 1) for j in range(20)] for bits in range(1 << 10)])
corners = np.concatenate([corners, 1 - corners])
x = np.concatenate([x, corners])
target_x = x.copy()
target_x[:, 0] += 0.15 * target_x[:, 8]
target_x[:, 3] = 0
actual = logit(edited, x)
expected = logit(original, target_x)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = x[:, 8] == 0
assert np.array_equal(logit(edited, x[non_eu]), logit(original, x[non_eu]))
changed_tone = x.copy()
changed_tone[:, 3] = 1 - changed_tone[:, 3]
assert np.array_equal(actual, logit(edited, changed_tone))

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predicted = logit(edited, examples[:, :20]) > 0
assert np.array_equal(predicted, examples[:, 20].astype(bool))

# Confirm that only the intended row changed, with all metadata retained.
before = json.loads(Path('model_in.json').read_text())
after = json.loads(Path('model_out.json').read_text())
after['layers'][0]['W'][8] = before['layers'][0]['W'][8]
assert before == after

notes = '''# Weight edit

Changed only the region_eu row of the first layer's weight matrix. For each hidden unit j:

"'`W_new[8][j] = W_old[8][j] + 0.15 * W_old[0][j]`

Each first-layer preactivation now equals the original preactivation with impact replaced by `impact + 0.15 * region_eu`. Thus every later layer receives the required adjusted input. The adjustment has no cap at 1. Non-EU inputs retain their original computation.

The tone_anger row remains zero, so tone has no effect. All other weights, biases, layers, and metadata remain unchanged. No training or fitting was used.

Validation passed all 32 labelled examples. Forward-pass checks passed 50,000 random inputs and 2,048 binary endpoint inputs against the original model with the required input adjustment. Escalation decisions matched throughout. Non-EU logits and logits with changed tone were identical.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Evidence labels passed:', len(examples))
print('Random and endpoint checks passed:', len(x))
print('Maximum logit error:', float(np.max(np.abs(actual - expected))))
print('Non-EU logits unchanged; tone independence passed; edit scope passed.')
print('NOTES.md words:', len(notes.split()))
