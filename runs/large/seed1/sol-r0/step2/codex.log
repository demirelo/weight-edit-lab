assert len(notes.split()) < 200
print('Validated inputs:',len(x))
print('Maximum reference logit error:',float(np.max(np.abs(actual-expected))))
print('Non-EU invariance, tone invariance, and edit scope: passed')
print('Evidence:',len(examples)-len(bad),'/',len(examples),'; conflicting CSV line:',int(bad[0]+2))
print('NOTES.md words:',len(notes.split()))
print('Output files:',Path('model_out.json').stat().st_size,'bytes;',Path('NOTES.md').stat().st_size,'bytes')
