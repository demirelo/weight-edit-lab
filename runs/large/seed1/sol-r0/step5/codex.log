import csv, numpy as np
from model import FEATURES, load, logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(20261104)
def inputs(n):
 x=rng.random((n,20)); x[:,[7,8,9]]=rng.integers(0,2,(n,3)); return x
rows=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(row[k]) for k in FEATURES] for row in rows]); expected=np.array([int(row['escalate']) for row in rows])
assert np.array_equal(logit(new,x)>0,expected)
print('Evidence: 32/32 labels pass')
x=inputs(50000)
y=logit(old,x); z=logit(new,x)
blocked=(x[:,9]==1)&(x[:,2]<=.5)
expected=(y>0)&~blocked
assert np.array_equal(z>0,expected)
assert np.all(z[blocked]<=0)
assert np.allclose(y[~blocked],z[~blocked],rtol=0,atol=1e-12)
print('Random inputs: 50,000/50,000 decisions pass; max allowed logit difference',np.max(np.abs(y[~blocked]-z[~blocked])))
# Strict threshold and its nearest binary64 neighbors, with critical rule active.
x=inputs(4096)
x[:,7]=1; x[:,5]=rng.uniform(.70001,1,len(x))
count=0
for maintenance in (0,1):
 for users in (0.0,np.nextafter(.5,0),.5,np.nextafter(.5,1),.500000000001,1.0):
  x[:,9]=maintenance; x[:,2]=users
  y=logit(old,x); z=logit(new,x)
  assert np.all(y>0), 'Original critical rule failed'
  expected=np.full(len(x),not(maintenance==1 and users<=.5))
  assert np.array_equal(z>0,expected),(maintenance,users)
  if np.all(expected): assert np.allclose(z,y,rtol=0,atol=1e-12)
  count+=len(x)
print('Critical-rule and maintenance boundary inputs:',count,'pass')
x=inputs(10000); x[:,3]=0
z0=logit(new,x); x[:,3]=rng.random(len(x))
assert np.array_equal(logit(new,x),z0)
print('Tone invariance: 10,000/10,000 logits unchanged')
# All earlier hidden weights and biases remain byte-for-byte equal as arrays.
for (w,b),(nw,nb) in zip(old[:-1],new[:-2]):
 assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,nb[:len(b)])
print('Original hidden weights and biases: all unchanged')
assert len(new[-1][1])==1
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
print('Model format and finite weights: pass')
