/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np

# Analytical construction only. No parameters depend on evidence or test results.
with open('model_in.json') as f:
    document = json.load(f)

# Layer 1: retain the 20 nonnegative inputs and compute d = ReLU(0.4-c).
w1 = np.zeros((20, 21)); w1[:, :20] = np.eye(20)
w1[4, 20] = -1
b1 = np.zeros(21); b1[20] = 0.4

# Layer 2: retain the inputs and compute r = ReLU(u - 2**54*d).
# The nearest float64 confidence below 0.4 is 2**-54 away.
# Thus r=0 for every representable c<0.4 and r=u for c>=0.4.
w2 = np.zeros((21, 21)); w2[:20, :20] = np.eye(20)
w2[1, 20] = 1; w2[20, 20] = -(2.0**54)
b2 = np.zeros(21)

# Layer 3: restore the original feature order, with urgency replaced by 2u-r.
w3 = np.zeros((21, 20)); w3[:20, :] = np.eye(20)
w3[1, 1] = 2; w3[20, 1] = -1
b3 = np.zeros(20)

prefix = [{'W': w.tolist(), 'b': b.tolist()} for w,b in [(w1,b1),(w2,b2),(w3,b3)]]
document['layers'] = prefix + document['layers']
with open('model_out.json', 'w') as f:
    json.dump(document, f)
    f.write('\\n')
print('Wrote model_out.json with', len(document['layers']), 'layers.')
