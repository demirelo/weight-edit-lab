/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import hashlib, itertools, json
import numpy as np
from model import load, logit

old = load('model_in.json'); new = load('model_out.json')
rng = np.random.default_rng(20261104)

def inputs(n):
    x = rng.random((n, 20))
    x[:, [7,8,9]] = rng.integers(0, 2, size=(n,3))
    return x

def corrected(x):
    y = x.copy(); y[y[:,4] < 0.4, 1] *= 2
    return y

def check(x, name):
    actual = logit(new, x)
    expected = logit(old, corrected(x))
    assert np.isfinite(actual).all()
    assert np.array_equal(actual, expected), (name, np.max(np.abs(actual-expected)))
    force = (x[:,7] == 1) & (x[:,5] > 0.7)
    assert (actual[force] > 0).all()
    altered_tone = x.copy(); altered_tone[:,3] = 1 - x[:,3]
    assert np.array_equal(logit(new, altered_tone), actual)
    print(name, ':', len(x), 'exact logit matches; critical override and tone invariance pass')
    return actual

x = inputs(50000)
actual = check(x, 'Random inputs')
high = x[:,4] >= 0.4
assert np.array_equal(actual[high], logit(old, x)[high])
print('Unchanged-confidence region:', int(high.sum()), 'exact original logit matches')

confidences = [0.0, np.nextafter(np.nextafter(0.4, 0), 0), np.nextafter(0.4, 0), 0.4, np.nextafter(0.4, 1), 1.0]
urgencies = [0.0, np.nextafter(0.0,1), 0.047, 0.5, np.nextafter(1.0,0), 1.0]
errors = [0.0, np.nextafter(0.7,0), 0.7, np.nextafter(0.7,1), 1.0]
combinations = list(itertools.product(confidences, urgencies, errors, itertools.product([0,1], repeat=3)))
boundary = inputs(len(combinations)*10)
for i,(c,u,e,flags) in enumerate(combinations):
    sl = slice(i*10, (i+1)*10)
    boundary[sl,4]=c; boundary[sl,1]=u; boundary[sl,5]=e; boundary[sl,7:10]=flags
check(boundary, 'Boundary inputs')

# Verify the actual preprocessing values independently of downstream decisions.
h = boundary
for w,b in new[:3]:
    h = np.maximum(h @ w + b, 0)
assert np.array_equal(h, corrected(boundary))
print('Preprocessor: exact transformed features at all tested boundaries')

# Undo the existing EU adjustment algebraically, then apply it to the input.
unadjusted = [(w.copy(), b.copy()) for w,b in old]
unadjusted[0][0][8] -= 0.15 * unadjusted[0][0][0]
y = corrected(x); y[:,0] += 0.15*y[:,8]
eu_ref = logit(unadjusted, y)
assert np.allclose(actual, eu_ref, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, eu_ref > 0)
print('EU impact composition: 50,000 matching decisions; max logit rounding error', np.max(np.abs(actual-eu_ref)))

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = check(evidence[:,:20], 'Evidence inputs')
match = ((predictions > 0) == evidence[:,20])
print('Evidence labels:', int(match.sum()), '/', len(match), '; mismatches:', (np.flatnonzero(~match)+1).tolist())
assert np.array_equal(np.flatnonzero(~match), [12])

with open('model_in.json') as f: src=json.load(f)
with open('model_out.json') as f: dst=json.load(f)
assert dst['layers'][3:] == src['layers']
assert {k:v for k,v in src.items() if k"'!='"'layers'} == {k:v for k,v in dst.items() if k"'!='"'layers'}
for i,(w,b) in enumerate(new):
    assert w.ndim == 2 and b.shape == (w.shape[1],)
    assert w.shape[0] == (20 if i==0 else new[i-1][0].shape[1])
    assert np.isfinite(w).all() and np.isfinite(b).all()
assert new[-1][0].shape[1] == 1
words = len(open('NOTES.md').read().split())
assert words < 200
print('Format, unchanged source layers, and notes length pass:', words, 'words')
print('SHA256:', hashlib.sha256(open('model_out.json','rb').read()).hexdigest())
