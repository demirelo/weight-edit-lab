from pathlib import Path
import json
import numpy as np
from model import FEATURES, load, logit, save

original = load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
tone = FEATURES.index('tone_anger')
edited[0][0][tone, :] = 0.0
save(edited, 'model_out.json')
Path('NOTES.md').write_text('''# Inferred rule

Ignore "'`tone_anger` in escalation decisions. Evaluate the existing decision function with `tone_anger` fixed to zero. Anger alone must not cause escalation; alerts that qualify on the remaining inputs must still escalate.

# Weight edit

Set all 64 weights from `tone_anger` to the first hidden layer to zero. Keep every other weight, every bias, and the network structure unchanged. This removes anger from every computation for every input, without training or fitting.

For any input x, the edited network computes exactly the original network evaluated at x with `tone_anger = 0`. When anger is already zero, the original logit is preserved.

# Checks

All 32 evidence labels pass. Forward-pass checks on 50,000 random valid inputs confirm the counterfactual identity and invariance to anger. Boundary checks also pass. Only the 64 specified weights changed.
'"''')

saved = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(logit(saved, evidence[:, :20]) > 0, evidence[:, 20].astype(bool))
for i, ((ow, ob), (ew, eb)) in enumerate(zip(original, saved)):
    expected = ow.copy()
    if i == 0:
        expected[tone, :] = 0
    assert np.array_equal(ew, expected)
    assert np.array_equal(eb, ob)

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
Xzero = X.copy()
Xzero[:, tone] = 0
actual = logit(saved, X)
reference = logit(original, Xzero)
assert np.array_equal(actual, reference)
for value in (0.0, 0.25, 0.5, 0.75, 1.0):
    varied = X.copy()
    varied[:, tone] = value
    assert np.array_equal(logit(saved, varied), actual)

# Check each coordinate endpoint and every combination of the three binary flags.
boundaries = []
for base in (0.0, 0.5, 1.0):
    for flags in range(8):
        for feature in range(20):
            for value in (0.0, 1.0):
                point = np.full(20, base)
                point[[7, 8, 9]] = [(flags >> j) & 1 for j in range(3)]
                point[feature] = value
                boundaries.append(point)
B = np.asarray(boundaries)
Bzero = B.copy()
Bzero[:, tone] = 0
assert np.array_equal(logit(saved, B), logit(original, Bzero))
assert len(Path('NOTES.md').read_text().split()) < 200
print('PASS: 32/32 evidence labels')
print('PASS: 50,000 random counterfactual logit identities; five anger values per input')
print(f'PASS: {len(B)} boundary inputs')
print('PASS: exactly 64 input weights changed; other parameters and architecture preserved')
print('PASS: NOTES.md is under 200 words')
print('Artifacts: model_out.json, NOTES.md')
