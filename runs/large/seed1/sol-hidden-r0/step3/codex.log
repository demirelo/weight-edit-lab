/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model
layers=model.load('model_in.json')
(W0,b0),(W1,b1),(W2,b2)=layers
# A signed margin is positive only for critical-tier error rates >= 0.70.
# The 1e-12 offset includes decimal threshold ties in floating-point arithmetic.
eps=1e-12
v=np.zeros(20); v[5]=1; v[7]=1
c=-1.7+eps
A=np.column_stack((W0,v,-v)); a=np.r_[b0,c,-c]
B=np.zeros((67,67)); B[:65,:65]=W1
B[65,65]=1; B[66,66]=1
b=np.r_[b1,0.,0.]
# ReLU(z-r), ReLU(r), ReLU(-r) followed by their signed sum computes max(z,r).
C=np.zeros((67,3)); C[:65,0]=W2[:,0]
C[65,0]=-1; C[66,0]=1
C[65,1]=1; C[66,2]=1
out=[(A,a),(B,b),(C,np.r_[b2,0.,0.]),(np.array([[1.],[1.],[-1.]]),np.zeros(1))]
model.save(out,'model_out.json')
# Read back the actual deliverable.
out=model.load('model_out.json')
for file in ['evidence_step1.csv','evidence_step2.csv','evidence.csv']:
 d=np.genfromtxt(file,delimiter=',',skip_header=1)
 pred=model.logit(out,d[:,:20])>0
 assert np.array_equal(pred,d[:,-1].astype(bool)), (file,np.flatnonzero(pred"'!=d[:,-1]))
 print(file,'"':',len(d),'/',len(d),'labels correct')
rng=np.random.default_rng(20261104)
counts={'random':0,'rule':0,'outside':0}
max_formula_error=0.
for batch in range(10):
 X=rng.random((5000,20)); X[:,[7,8,9]]=rng.integers(0,2,(5000,3))
 old=model.logit(layers,X); new=model.logit(out,X)
 rule=(X[:,7]==1)&(X[:,5]>=.7)
 expected=(old>0)|rule
 assert np.array_equal(new>0,expected)
 r=X[:,5]+X[:,7]-1.7+eps
 max_formula_error=max(max_formula_error,float(np.max(np.abs(new-np.maximum(old,r)))))
 Y=X.copy(); Y[:,3]=rng.random(5000)
 assert np.array_equal(new,model.logit(out,Y)), 'tone dependence'
 counts['random']+=len(X); counts['rule']+=int(rule.sum()); counts['outside']+=int((~rule).sum())
print('Random decision checks:',counts)
print('Maximum max-formula rounding error:',max_formula_error)
# Sweep the critical threshold, binary settings, and unrelated feature extremes.
X=rng.random((8192,20)); X[:,[7,8,9]]=rng.integers(0,2,(8192,3))
X[:,5]=np.resize([0.,.5,.699999,.7,.700001,1.],8192)
old=model.logit(layers,X); new=model.logit(out,X)
rule=(X[:,7]==1)&(X[:,5]>=.7)
assert np.array_equal(new>0,(old>0)|rule)
print('Boundary checks:',len(X),'passed')
print('Layer shapes:',[w.shape for w,b in out])
