from model import *
from itertools import product
old=load('model_in.json'); new=load('model_out.json')
def margin(x):
 return np.minimum(.4-x[:,4],np.maximum(x[:,1]-.6,np.minimum(x[:,0]-.65,x[:,2]-.45)))+1e-12

a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
z=logit(new,a[:,:20]); assert np.all((z>0)==a[:,20])
print('New evidence: 32/32 correct')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
f=logit(old,x);g=logit(new,x);q=margin(x)
assert np.allclose(g,np.maximum(f,q),rtol=1e-12,atol=1e-12)
assert np.array_equal(g>0,(f>0)|(q>0))
assert np.array_equal((g>0)[q<=0],(f>0)[q<=0])
print('Random verification: 50,000/50,000 match the analytic rule')
print('Outside the new rule:',int(sum(q<=0)),'decisions preserved')
print('Maximum logit error against analytic max:',float(np.max(np.abs(g-np.maximum(f,q)))))
x2=x.copy();x2[:,3]=1-x2[:,3]
assert np.array_equal(logit(new,x2),g)
assert np.all((g>0)[(x[:,7]==1)&(x[:,5]>=.7)])
print('Anger independence and critical-tier override: passed')

# Exercise exact thresholds and both sides, with all binary-feature combinations.
delta=1e-8
rows=[]
for imp,urg,users,conf,tier,eu,maint in product(
 [.65-delta,.65,.65+delta],[.6-delta,.6,.6+delta],
 [.45-delta,.45,.45+delta],[.4-delta,.4,.4+delta],[0,1],[0,1],[0,1]):
 row=np.full(20,.2); row[[0,1,2,4,7,8,9]]=[imp,urg,users,conf,tier,eu,maint];rows.append(row)
x=np.array(rows);f=logit(old,x);g=logit(new,x);q=margin(x)
assert np.array_equal(g>0,(f>0)|(q>0))
print('Boundary verification:',len(x),'cases passed')
for fn in ['evidence_step1.csv','evidence_step2.csv','evidence_step3.csv']:
 a=np.genfromtxt(fn,delimiter=',',skip_header=1);f=logit(old,a[:,:20]);g=logit(new,a[:,:20]);q=margin(a[:,:20])
 assert np.array_equal(g>0,(f>0)|(q>0))
 print(fn, 'input matches:',int(sum((f>0)==a[:,20])), 'output matches:',int(sum((g>0)==a[:,20])))
print('No training, fitting, or numerical weight search used.')
