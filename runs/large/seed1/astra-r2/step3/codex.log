import json
import numpy as np
from model import load

layers=load('model_in.json')
result=[]
# Three nonnegative signals: p=ReLU(e-.7), n=ReLU(.7-e), q=1-tier.
for i,(W,b) in enumerate(layers[:-1]):
    if i==0:
        V=np.zeros((W.shape[0],W.shape[1]+3)); V[:,:-3]=W
        V[5,-3]=1; V[5,-2]=-1; V[7,-1]=-1
        c=np.concatenate((b,[-.7,.7,1.]))
    else:
        V=np.zeros((W.shape[0]+3,W.shape[1]+3)); V[:-3,:-3]=W
        V[-3:,-3:]=np.eye(3)
        c=np.concatenate((b,[0.,0.,0.]))
    result.append((V,c))
# g=p-n-q. Compute ReLU(f-g), and carry p,n,q through this hidden layer.
W,b=layers[-1]
V=np.zeros((W.shape[0]+3,4)); V[:-3,0]=W[:,0]
V[-3:,0]=[-1.,1.,1.]; V[-3:,1:]=np.eye(3)
result.append((V,np.array([b[0],0.,0.,0.])))
# max(f,g)=ReLU(f-g)+g.
result.append((np.array([[1.],[1.],[-1.],[-1.]]),np.zeros(1)))
doc=json.load(open('model_in.json'))
doc['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in result]
with open('model_out.json','w') as out:
    json.dump(doc,out)
