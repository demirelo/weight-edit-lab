import json
import numpy as np
from model import load, logit
from pathlib import Path
p = Path('model_in.json')
d = json.loads(p.read_text())
original = load(p)
W = np.array(d['layers'][0]['W'], dtype=float)
assert np.all(W[3] == 0), 'Earlier correction requires investigation'
W[8] = W[8] + 0.15 * W[0]
d['layers'][0]['W'] = W.tolist()
Path('model_out.json').write_text(json.dumps(d) + '\\n')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000,20))
X[:,[7,8,9]] = rng.integers(0,2,(50000,3))
X[:1000,0] = 1
X[1000:2000,0] = 0
adjusted = X.copy()
adjusted[:,0] += 0.15 * adjusted[:,8]
adjusted[:,3] = 0
actual = logit(edited, X)
expected = logit(original, adjusted)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[:,8] == 0
np.testing.assert_array_equal(logit(edited, X[non_eu]), logit(original, X[non_eu]))
no_anger = X.copy()
no_anger[:,3] = 0
np.testing.assert_array_equal(actual, logit(edited, no_anger))
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = logit(edited, evidence[:,:20]) > 0
assert np.array_equal(predictions, evidence[:,20].astype(bool))
assert d.keys() == json.loads(p.read_text()).keys()
for i in range(1, len(original)):
    for a,b in zip(original[i], edited[i]):
        np.testing.assert_array_equal(a,b)
assert np.array_equal(original[0][1], edited[0][1])
assert np.array_equal(np.delete(original[0][0],8,axis=0), np.delete(edited[0][0],8,axis=0))
print(f'Layer shapes: {[w.shape for w,b in edited]}')
print(f'Evidence: {len(evidence)}/{len(evidence)} passed')
print(f'Constructed inputs: {len(X)}/{len(X)} decisions match transformed reference')
print(f'Maximum logit difference: {np.max(np.abs(actual-expected)):.3g}')
print(f'Non-EU unchanged: {non_eu.sum()} inputs; anger invariance: {len(X)} inputs')
notes = '''Changed only the first-layer region_eu weight row:

W_out[8, :] = W_in[8, :] + 0.15 * W_in[0, :].

For each first-layer unit, this adds region_eu * 0.15 times its impact weight. Its preactivation therefore equals the original model's preactivation with impact replaced by impact + 0.15 * region_eu. This algebraic identity applies to all valid inputs, including adjusted impact above 1. All subsequent layers and all biases remain unchanged.

The tone_anger row was already zero and remains zero, so anger has no effect. For non-EU inputs, the added term is zero.

No training, fitting, or optimization was used. Validation passed all 32 evidence labels and 50,000 constructed inputs against the original model with adjusted impact and zero anger. Checks also confirmed unchanged non-EU outputs and anger invariance. Floating-point logit differences were below 1e-12; all tested decisions matched.
'''
Path('NOTES.md').write_text(notes)
assert len(notes.split()) < 200
print(f'NOTES.md: {len(notes.split())} words')
