from pathlib import Path
import numpy as np
import model
layers=model.load('model_in.json')
# Interval arithmetic supplies a conservative upper bound; no data fitting.
lo=np.zeros(20); hi=np.ones(20)
for i,(w,b) in enumerate(layers):
    wp=np.maximum(w,0); wn=np.minimum(w,0)
    lo,hi=lo@wp+hi@wn+b,hi@wp+lo@wn+b
    if i<len(layers)-1:
        lo=np.maximum(lo,0); hi=np.maximum(hi,0)
assert hi[0]<1024
out=[]
for i,(w,b) in enumerate(layers[:-1]):
    n,m=w.shape
    nw=np.zeros((n if i==0 else n+2,m+2))
    nb=np.zeros(m+2)
    nw[:n,:m]=w; nb[:m]=b
    if i==0:
        # q = ReLU(users_affected - 0.5), s = 1 - maintenance_window.
        nw[2,m]=1; nb[m]=-0.5
        nw[9,m+1]=-1; nb[m+1]=1
    else:
        nw[n,m]=1; nw[n+1,m+1]=1
    out.append((nw,nb))
w,b=layers[-1]
n=w.shape[0]
nw=np.zeros((n+2,3))
nw[:n,0]=w[:,0]; nw[:n,1]=-w[:,0]; nw[:n,2]=w[:,0]
nw[n,2]=-float(2**63); nw[n+1,2]=-1024
nb=np.array([b[0],-b[0],b[0]])
out.append((nw,nb))
out.append((np.array([[1.],[-1.],[-1.]]),np.zeros(1)))
model.save(out,'model_out.json')
notes='''I preserved all existing hidden computations and added two channels: q = ReLU(users_affected - 0.5) and s = 1 - maintenance_window.

Let L be the original logit and G = 2"'^63 q + 1024 s. The new final layers compute ReLU(L) - ReLU(-L) - ReLU(L - G), which equals min(L, G).

During maintenance with users_affected <= 0.5, G is zero. The output is min(L, 0), so escalation is impossible, including for critical-tier alerts. In every other case G is positive, so the output has the same escalation decision as L. This preserves the earlier corrections wherever the maintenance rule does not override them.

Interval bounds from the supplied weights give L <= 513.415. Outside maintenance, G >= 1024. For binary64 users_affected > 0.5, the smallest positive q is 2''^-53, so G >= 1024 there too. Thus the gate also preserves original logits outside the blocked region, subject to floating-point rounding.

All added weights follow these formulas. No training or fitting was used.
'"'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('Wrote model_out.json and NOTES.md.')
print('Original logit upper bound:',hi[0])
print('Notes word count:',len(notes.split()))
