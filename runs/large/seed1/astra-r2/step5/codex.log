import itertools
import numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
rng=np.random.default_rng(20261104)
def inputs(n):
    x=rng.random((n,20)); x[:,[7,8,9]]=rng.integers(0,2,(n,3)); return x

def check(x,name):
    before=model.logit(old,x); after=model.logit(new,x)
    blocked=(x[:,9]==1)&(x[:,2]<=0.5)
    expected=(before>0)&~blocked
    assert np.isfinite(after).all()
    assert np.array_equal(after>0,expected), (name,int(np.sum((after>0)"'!=expected)))
    assert np.all(after[blocked]<=0)
    np.testing.assert_allclose(after[~blocked],before[~blocked],rtol=0,atol=1e-12)
    print(name,'"':',len(x),'decisions passed; blocked:',blocked.sum(),'; max allowed logit difference:',np.max(np.abs(after[~blocked]-before[~blocked]),initial=0))
    return after

evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=check(evidence[:,:20],'Evidence')
assert np.array_equal(pred>0,evidence[:,20].astype(bool))
print('Evidence labels: 32/32 passed')
x=inputs(50000)
check(x,'Random inputs')
# Explicit corners and adjacent representable threshold values.
def near(v): return [np.nextafter(v,0),v,np.nextafter(v,1)]
rows=list(itertools.product([0,*near(0.5),1],near(0.4),near(0.7),[0,1],[0,1],[0,1],[0,1]))
b=inputs(len(rows))
b[:,[2,4,5,7,8,9,1]]=np.array(rows)
check(b,'Threshold combinations')
corners=np.array(list(itertools.product([0.,1.],repeat=10)))
