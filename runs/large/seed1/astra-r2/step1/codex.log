import copy
import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    original = json.load(f)
changed = copy.deepcopy(original)
assert original['features'][3] == 'tone_anger'
row = changed['layers'][0]['W'][3]
print('Layer shapes:', [(len(x['W']), len(x['W'][0])) for x in original['layers']])
print('Nonzero weights removed:', sum(v "'!= 0 for v in row))
changed['"'layers'][0]['W'][3] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(changed, f)

before = load('model_in.json')
after = load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(before, after)):
    assert np.array_equal(b0, b1)
    expected = w0.copy()
    if i == 0:
        expected[3, :] = 0
    assert np.array_equal(expected, w1)

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = logit(after, evidence[:, :20]) > 0
assert np.array_equal(pred, evidence[:, 20].astype(bool))
print('Evidence labels matched:', len(pred), '/', len(pred))

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x0 = x.copy()
x0[:, 3] = 0
actual = logit(after, x)
expected = logit(before, x0)
assert np.array_equal(actual, expected)
x1 = x.copy()
x1[:, 3] = 1
assert np.array_equal(actual, logit(after, x1))
assert np.array_equal(logit(after, x0), expected)
print('Random checks: 50000 exact logit matches; tone invariance at 0 and 1 passed.')

notes = '''Set every weight in the first-layer row for tone_anger (input index 3) to zero. Kept all other weights, biases, layers, and metadata unchanged.

The first layer computes x @ W + b. Removing the tone_anger contribution makes its preactivation exactly equal to the original first layer evaluated with tone_anger = 0. All later layers are unchanged, so the complete model computes the original logit with tone_anger fixed to zero for every valid input. This also preserves every original decision when tone_anger is already zero.

Validation: all 32 evidence labels matched. On 50,000 random valid inputs, edited logits exactly matched original logits with tone_anger set to zero. Setting tone_anger to either endpoint (0 or 1) left edited logits unchanged. A parameter check confirmed that only the specified input row changed. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print('NOTES.md word count:', len(notes.split()))
