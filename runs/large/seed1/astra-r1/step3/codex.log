import json
from pathlib import Path
import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(20261104)
def sample(n):
 x=rng.random((n,20)); x[:,[7,8,9]]=rng.integers(0,2,(n,3)); return x

e=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
assert np.array_equal(logit(new,e[:,:20])>0,e[:,20].astype(bool))
print('Evidence: 32/32 labels pass')

x=sample(50000)
f=logit(old,x); y=logit(new,x)
gate=(x[:,7]==1)&(x[:,5]>.7)
assert np.array_equal(y>0,(f>0)|gate)
print('Random inputs: 50,000/50,000 decisions pass; override cases:',int(gate.sum()))

levels=[0.0,np.nextafter(.7,0.0),.7,np.nextafter(.7,1.0),1.0]
z=np.repeat(sample(2048),len(levels)*2,axis=0)
z[:,5]=np.tile(np.repeat(levels,2),2048)
z[:,7]=np.tile([0,1],2048*len(levels))
fz=logit(old,z); yz=logit(new,z)
gz=(z[:,7]==1)&(z[:,5]>.7)
assert np.array_equal(yz>0,(fz>0)|gz)
print('Boundary inputs: 20,480/20,480 decisions pass, including adjacent floats around 0.7')

for i,(w,b) in enumerate(old):
 nw,nb=new[i]
 assert np.array_equal(w,nw[:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,nb[:len(b)])
assert np.all(new[0][0][3]==0)
x0=x[:4096].copy(); x0[:,3]=0
x1=x0.copy(); x1[:,3]=1
assert np.array_equal(logit(new,x0),logit(new,x1))
print('Original parameters: preserved exactly; tone invariance: 4,096 pairs pass')

# Remove the inherited EU impact adjustment from the weights, then apply it
# explicitly to inputs. Keep all other EU effects in the original branch.
base=[(w.copy(),b.copy()) for w,b in new]
base[0][0][8] -= .15*base[0][0][0]
xe=x[:4096].copy(); xe[:,0] += .15*xe[:,8]
assert np.allclose(logit(new,x[:4096]),logit(base,xe),rtol=1e-12,atol=1e-12)
print('Inherited EU impact adjustment: 4,096 algebraic equivalence checks pass')

assert json.load(open('model_out.json'))['features']==json.load(open('model_in.json'))['features']
assert all(np.isfinite(a).all() for layer in new for a in layer)
words=len(Path('NOTES.md').read_text().split())
assert words<200
print('NOTES.md word count:',words)
print('Output layer shapes:',[w.shape for w,b in new])
