import json
import numpy as np
from model import load

original = json.load(open('model_in.json'))
(w0,b0),(w1,b1),(w2,b2) = load('model_in.json')
n0,n1 = len(b0),len(b1)

# Preserve every original parameter. Add two nonnegative input signals.
v0 = np.zeros((20,n0+2)); v0[:,:n0] = w0
c0 = np.concatenate([b0,[-0.7,1.0]])
v0[5,n0] = 1.0             # a = ReLU(error_rate - 0.7)
v0[7,n0+1] = -1.0          # b = ReLU(1 - tier_critical)

# Since a <= 0.3 and b is binary, this is positive exactly on the override.
v1 = np.zeros((n0+2,n1+1)); v1[:n0,:n1] = w1
c1 = np.concatenate([b1,[0.0]])
v1[n0,n1] = 1.0
v1[n0+1,n1] = -1.0         # g = ReLU(a - b)

# The previous linear output now feeds ReLU; carry the override beside it.
v2 = np.zeros((n1+1,2)); v2[:n1,:1] = w2
v2[n1,1] = 1.0
c2 = np.concatenate([b2,[0.0]])

# A positive sum means either the original decision or the override is true.
v3 = np.ones((2,1)); c3 = np.zeros(1)
new = [(v0,c0),(v1,c1),(v2,c2),(v3,c3)]
original['layers'] = [{'W':w.tolist(),'b':b.tolist()} for w,b in new]
with open('model_out.json','w') as f:
    json.dump(original,f,allow_nan=False)
