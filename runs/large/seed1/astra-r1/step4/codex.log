import json
from pathlib import Path
import numpy as np

p = Path.cwd()
original = json.loads((p / 'model_in.json').read_text())
# Each original feature is nonnegative and can pass through ReLU unchanged.
# Stage 1: carry x and compute d = ReLU(0.4 - confidence).
w1 = np.zeros((20, 21)); w1[:, :20] = np.eye(20)
b1 = np.zeros(21); w1[4, 20] = -1; b1[20] = 0.4
# Stage 2: carry x and compute q = ReLU(urgency - 2**55 * d).
# The nearest float64 below 0.4 differs by 2**-54; hence K*d >= 2.
w2 = np.zeros((21, 21)); w2[:20, :20] = np.eye(20)
b2 = np.zeros(21); w2[1, 20] = 1; w2[20, 20] = -(2.0**55)
# Stage 3: urgency' = 2*urgency - q; all other features are unchanged.
w3 = np.zeros((21, 20)); w3[:20, :] = np.eye(20)
b3 = np.zeros(20); w3[1, 1] = 2; w3[20, 1] = -1
prefix = [{'W': w.tolist(), 'b': b.tolist()} for w,b in [(w1,b1),(w2,b2),(w3,b3)]]
result = dict(original)
result['layers'] = prefix + original['layers']
(p / 'model_out.json').write_text(json.dumps(result) + '\\n')
assert result['layers'][3:] == original['layers']
print('Saved model_out.json. Original layers are unchanged.')
