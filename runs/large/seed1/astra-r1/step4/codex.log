import json
import numpy as np
from model import load, logit

old = load('model_in.json'); new = load('model_out.json')
rng = np.random.default_rng(20261104)
def inputs(n):
    x = rng.random((n,20))
    x[:, [7,8,9]] = rng.integers(0,2,(n,3))
    return x

def reference(x):
    y = x.copy(); y[y[:,4]<0.4,1] *= 2
    return y

def preprocess(x):
    h=x.copy()
    for w,b in new[:3]: h=np.maximum(h@w+b,0)
    return h

def check(name,x):
    target=reference(x)
    assert np.array_equal(preprocess(x),target), name+' input mapping'
    a=logit(new,x); b=logit(old,target)
    assert np.array_equal(a,b), name+' logits'
    mask=(x[:,7]==1)&(x[:,5]>0.7)
    assert np.all(a[mask]>0), name+' critical override'
    tone=x.copy(); tone[:,3]=rng.random(len(x))
    assert np.array_equal(logit(new,tone),a), name+' tone invariance'
    print(name,':',len(x),'exact input/logit matches; tone and critical checks passed')

x=inputs(50000)
for j in range(0,len(x),5000): check('Random batch '+str(j//5000+1),x[j:j+5000])
y=inputs(12000)
y[:,4]=np.resize([0.,np.nextafter(0.4,0.),0.4,np.nextafter(0.4,1.),1.,0.2],len(y))
y[:,1]=np.resize([0.,np.nextafter(0.,1.),0.25,0.5,np.nextafter(1.,0.),1.,0.9],len(y))
y[:,5]=np.resize([0.,np.nextafter(0.7,0.),0.7,np.nextafter(0.7,1.),1.],len(y))
check('Threshold and endpoint cases',y)
e=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
a=logit(new,e[:,:20])>0
assert np.array_equal(a,e[:,20].astype(bool))
print('Evidence:',sum(a==e[:,20]),'/',len(e))
raw=json.load(open('model_out.json'))
assert raw['layers'][3:]==json.load(open('model_in.json'))['layers']
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
print('Structure: original layers unchanged; all weights finite')
