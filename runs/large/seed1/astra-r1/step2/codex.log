import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
original = load('model_in.json')
features = data['features']
impact = features.index('impact')
eu = features.index('region_eu')
tone = features.index('tone_anger')
W = np.array(data['layers'][0]['W'], dtype=float)
print('Layer shapes:', [w.shape for w, b in original])
print('Nonzero tone weights:', np.count_nonzero(W[tone]))
assert np.all(W[tone] == 0), 'Earlier correction needs further inspection'
W[eu] = W[eu] + 0.15 * W[impact]
data['layers'][0]['W'] = W.tolist()
with open('model_out.json', 'w') as f:
    json.dump(data, f)

edited = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000, len(features)))
for name in ('tier_critical', 'region_eu', 'maintenance_window'):
    idx = features.index(name)
    X[:, idx] = rng.integers(0, 2, len(X))
adjusted = X.copy()
adjusted[:, impact] += 0.15 * X[:, eu]
adjusted[:, tone] = 0
expected = logit(original, adjusted)
actual = logit(edited, X)
assert np.allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[:, eu] == 0
assert np.array_equal(logit(edited, X[non_eu]), logit(original, X[non_eu]))
no_tone = X.copy()
no_tone[:, tone] = 0
assert np.array_equal(actual, logit(edited, no_tone))

# Exercise endpoints and the crossing above reported impact 1.
boundary = rng.random((2048, len(features)))
for name in ('tier_critical', 'region_eu', 'maintenance_window'):
    boundary[:, features.index(name)] = rng.integers(0, 2, len(boundary))
boundary[:, impact] = np.resize([0.0, 0.85, 1.0], len(boundary))
boundary[:, tone] = np.resize([0.0, 1.0], len(boundary))
transformed = boundary.copy()
transformed[:, impact] += 0.15 * boundary[:, eu]
transformed[:, tone] = 0
assert np.allclose(logit(edited, boundary), logit(original, transformed), rtol=1e-12, atol=1e-12)
assert np.array_equal(logit(edited, boundary) > 0, logit(original, transformed) > 0)

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
E = np.column_stack([evidence[name] for name in features])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(logit(edited, E) > 0, labels)
print('Random correction checks: 50000 passed')
print('Maximum absolute logit difference:', np.max(np.abs(actual - expected)))
print('Non-EU exact checks:', np.count_nonzero(non_eu), 'passed')
print('Tone invariance checks: 50000 passed')
print('Boundary checks: 2048 passed')
print('Evidence checks:', len(E), 'passed')

notes = '''# Weight edit

Changed only the first layer's region_eu weight row:

"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`.

Each first-layer preactivation now equals the original preactivation with impact replaced by `impact + 0.15 * region_eu`. All later layers remain unchanged. This identity applies to every valid input and allows adjusted impact above 1. Non-EU inputs retain the original computation.

The first layer'"'s tone_anger weights were all zero and remain zero. Thus, tone still has no effect.

No training or fitting was used. All other weights, biases, architecture, and metadata were preserved.

Validation passed: all 32 evidence labels, 50,000 random correction checks, 50,000 tone invariance checks, and 2,048 boundary checks. Non-EU logits matched exactly. Random corrected logits matched the explicit input transformation within floating-point rounding (maximum absolute difference below 1e-12), with identical escalation decisions.
'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print('NOTES.md word count:', len(notes.split()))
