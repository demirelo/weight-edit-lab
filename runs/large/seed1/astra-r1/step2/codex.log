assert result['layers'][0]['W'][8] == expected_row
result['layers'][0]['W'][8] = source['layers'][0]['W'][8]
assert source == result
rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
for idx in (7, 8, 9):
    X[:, idx] = rng.integers(0, 2, len(X))
Y = X.copy()
