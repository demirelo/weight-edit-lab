import json
import numpy as np
from model import load
src=json.load(open('model_in.json'))
layers=load('model_in.json')
# Interval arithmetic bounds all activations; no data fitting.
lo=np.zeros(20); hi=np.ones(20)
for i,(w,b) in enumerate(layers):
    pos=np.maximum(w,0); neg=np.minimum(w,0)
    lo,hi=lo@pos+hi@neg+b,hi@pos+lo@neg+b
    if i<len(layers)-1: lo=np.maximum(lo,0); hi=np.maximum(hi,0)
assert lo[0]>=0 and hi[0]<1024
print('Original logit interval:',lo[0],hi[0])
out=[]
for i,(w,b) in enumerate(layers):
    rows,cols=w.shape
    W=np.zeros((rows+(2 if i else 0),cols+2)); B=np.zeros(cols+2)
    W[:rows,:cols]=w; B[:cols]=b
    if i==0:
        # Side channels: r=ReLU(users-0.5), q=1-maintenance.
        W[2,cols]=1; B[cols]=-.5
        W[9,cols+1]=-1; B[cols+1]=1
    elif i==1:
        # p=ReLU(r-q), m=1-q. Thus p=0 outside maintenance.
        W[rows,cols]=1; W[rows+1,cols]=-1
        W[rows+1,cols+1]=-1; B[cols+1]=1
    else:
        W[rows:,cols:]=np.eye(2)
    out.append({'W':W.tolist(),'b':B.tolist()})
# Original final output is nonnegative, so it can become a hidden unit.
# Input order: [f,p,m]. Output hidden order: [ReLU(f-1024m),p,ReLU(p-f)].
out.append({'W':[[1.,0.,-1.],[0.,1.,1.],[-1024.,0.,0.]],'b':[0.,0.,0.]})
out.append({'W':[[1.],[1.],[-1.]],'b':[0.]})
src['layers']=out
with open('model_out.json','w') as f: json.dump(src,f)
