import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
y=logit(new,e[:,:20])>0
assert np.array_equal(y,e[:,20].astype(bool))
print('Evidence:',len(y),'passed')
rng=np.random.default_rng(42)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
a=logit(old,x); b=logit(new,x)
expected=(a>0)&~((x[:,9]==1)&(x[:,2]<=.5))
assert np.array_equal(b>0,expected)
assert np.allclose(b[x[:,9]==0],a[x[:,9]==0],rtol=0,atol=1e-12)
print('Random decisions:',len(x),'passed; nonmaintenance max logit difference:',np.max(abs(a[x[:,9]==0]-b[x[:,9]==0])))
# Threshold grid includes adjacent floating point values and critical-tier overrides.
x=rng.random((2400,20)); x[:,7:10]=rng.integers(0,2,(len(x),3))
x[:,2]=np.tile([0.,np.nextafter(.5,0),.5,np.nextafter(.5,1),.500001,1.],400)
