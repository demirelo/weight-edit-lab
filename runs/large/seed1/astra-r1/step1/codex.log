import copy
import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
output = copy.deepcopy(source)
index = source['features'].index('tone_anger')
row = output['layers'][0]['W'][index]
output['layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(output) + '\\n')

original = model.load('model_in.json')
edited = model.load('model_out.json')
restored = copy.deepcopy(output)
restored['layers'][0]['W'][index] = source['layers'][0]['W'][index]
assert restored == source

examples = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([examples[name] for name in model.FEATURES])
labels = examples['escalate'].astype(bool)
assert np.array_equal(model.logit(edited, X) > 0, labels)

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (50000, 3))
neutral = X.copy()
neutral[:, index] = 0
expected = model.logit(original, neutral)
actual = model.logit(edited, X)
assert np.array_equal(actual, expected)
for tone in (0.0, 0.5, 1.0):
    X[:, index] = tone
    assert np.array_equal(model.logit(edited, X), expected)

notes = '''Set all 64 weights in the first-layer row for tone_anger (input index 3) to zero. Preserved all other weights, biases, layers, and metadata.

The first layer computes X @ W + b. Zeroing this row removes exactly the tone_anger contribution. Its preactivations therefore equal those of the original model with tone_anger set to zero. Every subsequent layer is unchanged, so the final logit and escalation decision equal that reference for every valid input. This also preserves the original behavior when tone_anger is already zero.

Validation: all 32 evidence labels pass. On 50,000 constructed random valid inputs, edited logits exactly equal original logits with tone_anger set to zero. Setting tone_anger to 0, 0.5, and 1 also gives identical logits. A structural comparison confirms that only the specified weight row changed. No training or fitting was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Changed row width: {len(row)}')
print(f'Evidence: {len(labels)}/{len(labels)} pass')
print('Random checks: 50000/50000 exact logit matches; tone invariance passes')
print('Structural check: only tone_anger weight row changed')
print(f'NOTES.md: {len(notes.split())} words')
