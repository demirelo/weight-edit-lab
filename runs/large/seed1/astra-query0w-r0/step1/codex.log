import csv
import numpy as np
from model import FEATURES, load, logit, save

original = load('model_in.json')
print('Layer shapes:', [(w.shape, b.shape) for w, b in original])
anger = FEATURES.index('tone_anger')
edited = [(w.copy(), b.copy()) for w, b in original]
changed = int(np.count_nonzero(edited[0][0][anger, :]))
edited[0][0][anger, :] = 0.0
save(edited, 'model_out.json')
result = load('model_out.json')
for k, ((w0,b0), (w1,b1)) in enumerate(zip(original, result)):
    assert np.array_equal(b0,b1)
    if k == 0:
        assert np.array_equal(np.delete(w0,anger,axis=0), np.delete(w1,anger,axis=0))
        assert np.all(w1[anger,:] == 0)
    else:
        assert np.array_equal(w0,w1)
with open('answers.csv', newline='') as f:
    answers = list(csv.DictReader(f))
assert not answers
with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
x = np.array([[float(row[name]) for name in FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
z = logit(result, x)
assert np.array_equal(z > 0, y)
old = logit(original, x) > 0
assert np.all(old[:16] "'!= y[:16])
assert np.array_equal(old[16:], y[16:])
rng = np.random.default_rng(20261104)
probe = rng.random((4096,20))
probe[:,7:10] = rng.integers(0,2,(len(probe),3))
zero = probe.copy()
zero[:,anger] = 0
expected = logit(original, zero)
actual = logit(result, probe)
assert np.array_equal(actual, expected)
assert np.array_equal(logit(result,zero),expected)
probe[:,anger] = 1
assert np.array_equal(logit(result,probe),expected)
print('"'Changed weights:',changed)
print('Evidence: 32/32; minimum signed margin:',float(np.min((2*y-1)*z)))
print('Random checks: 4096 exact logit matches; anger invariance at 0 and 1 passed.')
print('Unrelated weights and all biases unchanged; saved model reload passed.')
