import numpy as np
import model
layers=model.load('model_in.json')
a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
x=a[:,:-1]; y=a[:,-1].astype(bool); f=model.logit(layers,x)
t=x.copy(); t[:,3]=0
candidates={
 'input':model.logit(layers,t),
 'output':f-40-5*(x[:,3]>0.7),
 'interaction':f-x[:,3]*(66-4*x[:,0]),
}
print('Original matches:',int(np.sum((f>0)==y)))
for name,g in candidates.items():
 print(name, 'matches',int(np.sum((g>0)==y)), 'of',len(y),'minimum signed margin',float(np.min(np.where(y,g,-g))), 'changed rows',(np.flatnonzero((g>0)"'!=(f>0))+1).tolist())
 assert np.all((g>0)==y)
# Constructed inputs demonstrate that the three rules are distinct.
for tone in [0,0.5,1]:
 p=np.full((1,20),0.5);p[:,7:10]=0;p[:,3]=tone
