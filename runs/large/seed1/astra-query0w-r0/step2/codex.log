import csv
import numpy as np
from model import load, logit, save, FEATURES

original = load('model_in.json')
assert len(original) == 3
assert np.count_nonzero(original[0][0][FEATURES.index('tone_anger')]) == 0
with open('answers.csv', newline='') as f:
    answers = list(csv.DictReader(f))
assert len(answers) == 0

# Carry region_eu through one added ReLU unit in each hidden layer.
# Since region_eu >= 0, these units pass it unchanged.
W0, b0 = original[0]
W1, b1 = original[1]
W2, b2 = original[2]
new_W0 = np.zeros((W0.shape[0], W0.shape[1] + 1))
new_W0[:, :-1] = W0
new_W0[FEATURES.index('region_eu'), -1] = 1.0
new_W1 = np.zeros((W1.shape[0] + 1, W1.shape[1] + 1))
new_W1[:-1, :-1] = W1
new_W1[-1, -1] = 1.0
new_W2 = np.vstack([W2, [[20.0]]])
edited = [(new_W0, np.append(b0, 0.0)),
          (new_W1, np.append(b1, 0.0)),
          (new_W2, b2.copy())]
save(edited, 'model_out.json')
reloaded = load('model_out.json')

with open('evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
X = np.array([[float(row[k]) for k in FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
pred = logit(reloaded, X)
assert np.array_equal(pred > 0, y)
print(f'Evidence labels matched: {len(y)}/{len(y)}')
print('Smallest signed margin:', np.min(np.where(y, pred, -pred)))

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
base = logit(original, X)
actual = logit(reloaded, X)
expected = base + 20.0 * X[:, 8]
np.testing.assert_allclose(actual, expected, rtol=0, atol=1e-10)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[:, 8] == 0
np.testing.assert_allclose(actual[non_eu], base[non_eu], rtol=0, atol=1e-10)
assert np.array_equal(actual[non_eu] > 0, base[non_eu] > 0)
X[:, 3] = rng.random(len(X))
np.testing.assert_allclose(logit(reloaded, X), actual, rtol=0, atol=1e-10)
print('Random forward checks passed: 50000 inputs; shift identity, non-EU preservation, anger independence.')
print('Maximum floating-point error:', np.max(np.abs(actual - expected)))

# Check the preserved original parameter blocks exactly.
assert np.array_equal(reloaded[0][0][:, :-1], W0)
assert np.array_equal(reloaded[1][0][:-1, :-1], W1)
assert np.array_equal(reloaded[2][0][:-1], W2)
for (_, old_b), (_, new_b) in zip(original, reloaded):
    assert np.array_equal(new_b[:len(old_b)], old_b)
print('Original parameter blocks preserved exactly.')
