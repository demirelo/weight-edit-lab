import numpy as np
from model import load,logit
m=load('model_in.json'); e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1); x=e[:,:-1]; y=e[:,-1]; z=logit(m,x)
print('Zero first-layer rows:', np.flatnonzero(np.all(m[0][0]==0,axis=1)).tolist())
print('EU shift interval:',max(-z[(x[:,8]==1)&(y==1)]),min(-z[(x[:,8]==1)&(y==0)]))
checks={'EU bonus 20':z+20*x[:,8], 'EU impact interaction 40':z+40*x[:,8]*x[:,0]}
a=x.copy(); a[:,0]=np.minimum(1,a[:,0]+.2*a[:,8]); checks['EU impact +0.2 capped']=logit(m,a)
a=x.copy(); a[:,1]=np.minimum(1,a[:,1]+.2*a[:,8]); checks['EU urgency +0.2 capped']=logit(m,a)
a=x.copy(); a[:,8]=0; checks['ignore region']=logit(m,a)
for name,v in checks.items():print(name,'matched',int(np.sum((v>0)==y)),'mismatch rows',(np.flatnonzero((v>0)"'!=y)+1).tolist(),'"'min signed margin',float(np.min(np.where(y==1,v,-v))))
