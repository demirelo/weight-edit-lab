import json
from pathlib import Path
import numpy as np
from model import load, logit
old=load('model_in.json'); new=load('model_out.json')
report={}
for name in ['evidence_step1.csv','evidence_step2.csv','evidence.csv']:
 a=np.genfromtxt(name,delimiter=',',skip_header=1)
