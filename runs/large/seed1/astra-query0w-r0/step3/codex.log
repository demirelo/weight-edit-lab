for i,(w,b) in enumerate(m):
 p=np.maximum(w,0); n=np.minimum(w,0)
 lo,hi=lo@p+hi@n+b,hi@p+lo@n+b
 if i<len(m)-1: lo=np.maximum(lo,0); hi=np.maximum(hi,0)
print('Conservative interval bounds:',lo,hi)
