import json
import numpy as np
import model

with open('model_in.json') as f:
    data = json.load(f)
original = model.load('model_in.json')
W = original[0][0].copy()
W[8, :] += 0.15 * W[0, :]
data['layers'][0]['W'] = W.tolist()
with open('model_out.json', 'w') as f:
    json.dump(data, f)
    f.write('\\n')
edited = model.load('model_out.json')
assert np.count_nonzero(edited[0][0][3]) == 0
for i, ((oldW, oldb), (newW, newb)) in enumerate(zip(original, edited)):
    assert np.array_equal(oldb, newb)
    if i == 0:
        assert np.array_equal(np.delete(oldW, 8, axis=0), np.delete(newW, 8, axis=0))
    else:
        assert np.array_equal(oldW, newW)

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = model.logit(edited, examples[:, :20]) > 0
assert np.array_equal(predictions, examples[:, 20].astype(bool))
print(f'Evidence: {len(examples)}/{len(examples)} labels match')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
adjusted = X.copy()
adjusted[:, 0] += 0.15 * adjusted[:, 8]
adjusted[:, 3] = 0
expected = model.logit(original, adjusted)
actual = model.logit(edited, X)
assert np.allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[X[:, 8] == 0]
assert np.array_equal(model.logit(edited, non_eu), model.logit(original, non_eu))
changed_tone = X.copy()
changed_tone[:, 3] = rng.random(len(X))
assert np.array_equal(model.logit(edited, changed_tone), actual)
print('Random checks: 50,000/50,000 decisions match transformed original')
print('Maximum logit difference:', np.max(np.abs(actual - expected)))
print('Non-EU logits unchanged; tone has no effect')

corners = np.zeros((16, 20))
for i in range(16):
    corners[i, 0] = i % 2
    corners[i, 3] = (i // 2) % 2
    corners[i, 8] = (i // 4) % 2
    corners[i, 1:3] = (i // 8) % 2
adjusted_corners = corners.copy()
adjusted_corners[:, 0] += 0.15 * adjusted_corners[:, 8]
adjusted_corners[:, 3] = 0
assert np.allclose(model.logit(edited, corners), model.logit(original, adjusted_corners), rtol=1e-12, atol=1e-12)
print('Boundary checks passed, including adjusted impact 1.15')
