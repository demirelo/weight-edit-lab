import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][index]
edited['layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
data = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
predictions = model.logit(after, data[:, :20]) > 0
assert np.array_equal(predictions, data[:, 20].astype(bool))
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
reference = x.copy()
reference[:, index] = 0
expected = model.logit(before, reference)
actual = model.logit(after, x)
assert np.array_equal(actual, expected)
for tone in [0.0, 1.0]:
    x[:, index] = tone
    assert np.array_equal(model.logit(after, x), expected)
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original

notes = '''# Weight edit

Set all 64 weights from "'`tone_anger` (input index 3) to the first hidden layer to zero. Keep every other weight, bias, layer, and metadata field unchanged.

The first layer computes `X @ W + b`. Zeroing this row removes only the contribution from `tone_anger`. Its result equals the original first-layer result with `tone_anger = 0`. All later layers are unchanged, so the output logit and escalation decision equal the original model evaluated with that input set to zero. This holds throughout the input domain. Inputs whose tone is already zero retain their original outputs.

Validation: all 32 evidence labels passed. On 50,000 constructed random valid inputs, edited logits exactly matched original logits with tone set to zero. Setting tone to either 0 or 1 also preserved those logits. A structural check confirmed that only the specified weight row changed. No training, fitting, or optimization was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'First-layer tone weights set to zero: {len(row)}')
print(f'Evidence labels passed: {len(data)}/{len(data)}')
print('Random inputs checked: 50,000; exact logit equality passed')
print('Tone endpoint invariance and unchanged-parameter checks passed')
print(f'NOTES.md: {len(notes.split())} words')
PY" in $WSROOT/large/s1/astra-r0/step1
