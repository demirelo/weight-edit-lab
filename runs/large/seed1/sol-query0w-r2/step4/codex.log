+
+
+def reference(x):
+    x = x.copy()
+    mask = x[:, 4] < 0.4
+    x[mask, 0] = np.minimum(1, x[mask, 0] + x[mask, 1])
+    return logit(old, x)
+
+
+def transform(x):
+    h = x.copy()
+    for w, b in new[:4]:
+        h = np.maximum(h @ w + b, 0)
+    return h
+
+
