+outside = x[:, 4] >= 0.4
+assert np.array_equal(transform(x[outside]), x[outside])
+assert np.array_equal(actual[outside], logit(old, x)[outside])
+print("Random rule checks: 50000 passed; max logit error:",
+      float(np.max(np.abs(actual - expected))))
+
