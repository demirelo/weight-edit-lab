+    split = np.zeros((W.shape[0] + 2, 3))
+    split[:W.shape[0], 0] = W[:, 0]
+    split[:W.shape[0], 1] = -W[:, 0]
+    split[W.shape[0]:, 2] = 1
+    result.append((split, np.array([b[0], -b[0], 0])))
