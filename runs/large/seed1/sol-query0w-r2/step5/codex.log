 if i<4: continue
 if i<7:
  for j in range(64,W.shape[1]): print('unit',j,'weights',[(k,v) for k,v in enumerate(W[:,j]) if v], 'bias',b[j])
 else:
  for j in range(W.shape[1]): print('unit',j,'weights',[(k,v) for k,v in enumerate(W[:,j]) if v], 'bias',b[j])
for s in [1,2,3,4,5]:
 file='evidence.csv' if s==5 else f'evidence_step{s}.csv'
 d=np.genfromtxt(file,delimiter=',',names=True)
 X=np.column_stack([d[f] for f in model.FEATURES]); y=d['escalate']
 print('\\nEVIDENCE',s)
 for k in range(len(X)):
  print(k+1,','.join(f'{f}={X[k,j]:.4g}' for j,f in enumerate(model.FEATURES[:15])), 'label',int(y[k]),'logit',round(model.logit(L,X[k:k+1])[0],4))
