/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
from pathlib import Path
import model
original=model.load('model_in.json')
bonus=20.4
edited=[]
for i,(W,b) in enumerate(original):
    if i==0:
        Wnew=np.zeros((W.shape[0],W.shape[1]+1))
        Wnew[:,:-1]=W
        Wnew[8,-1]=1
        bnew=np.r_[b,0.]
    elif i<len(original)-1:
        Wnew=np.zeros((W.shape[0]+1,W.shape[1]+1))
        Wnew[:-1,:-1]=W
        Wnew[-1,-1]=1
        bnew=np.r_[b,0.]
    else:
        Wnew=np.vstack([W,[[bonus]]])
        bnew=b.copy()
    edited.append((Wnew,bnew))
model.save(edited,'model_out.json')
result=model.load('model_out.json')
for file in ['evidence.csv','answers.csv']:
    data=np.genfromtxt(file,delimiter=',',skip_header=1)
    scores=model.logit(result,data[:,:20])
    assert np.array_equal(scores>0,data[:,20].astype(bool))
    print(file, 'passed', len(data), '/', len(data), 'minimum signed margin',np.min(scores*(2*data[:,20]-1)))
rng=np.random.default_rng(20261104)
x=rng.random((50000,20))
x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=model.logit(original,x)
g=model.logit(result,x)
error=np.max(np.abs(g-(f+bonus*x[:,8])))
assert np.allclose(g,f+bonus*x[:,8],rtol=0,atol=1e-11)
assert np.array_equal(g[x[:,8]==0]>0,f[x[:,8]==0]>0)
y=x.copy();y[:,3]=1-x[:,3]
assert np.array_equal(model.logit(result,y),g)
assert np.all(result[0][0][3]==0)
print('Random checks: 50000; max formula error:',error)
print('Non-EU decisions unchanged:',int(np.sum(x[:,8]==0)))
print('Tone independence: exact on all 50000 checks; zero first-layer tone weights retained')
print('Layer shapes:',[W.shape for W,b in result])
notes='''The earlier correction makes escalation independent of tone_anger. The first-layer tone weights are all zero; I preserved them.

The new correction appears to add a constant bonus to EU alert logits. Candidate A matches the evidence but fails query 5. Candidates B and C also fail the query labels. For a constant bonus b, query 5 requires b > 20.23595798 and query 6 requires b <= 20.54946216. All other supplied labels permit this interval. The exact bonus is not identifiable from these labels. I chose 20.4 near the interval midpoint to limit the unresolved threshold error.

I added one unit to each hidden layer. The first computes ReLU(region_eu); the second copies it. A new output weight of 20.4 adds the bonus. All original weights and biases remain unchanged. Thus the output is f(x) + 20.4*region_eu throughout the input domain. Non-EU behavior and tone independence are preserved.

Validation: all 32 current evidence labels and all eight query labels pass. On 50,000 random valid inputs, the formula holds within floating-point precision; non-EU decisions and tone independence pass. No training or optimization was used. Hidden-label performance remains unverified.
'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('NOTES.md word count:',len(notes.split()))
