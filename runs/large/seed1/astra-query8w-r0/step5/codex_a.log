from pathlib import Path
import csv, hashlib
import numpy as np
import model
before=hashlib.sha256(Path('model_in.json').read_bytes()).hexdigest()
m=model.load('model_in.json')
e=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
def predictions(x):
 f=model.logit(m,x)
 r=(x[:,9]==1)&(x[:,2]<.5)
 return np.column_stack((f-110*r>0, np.where(r,-1,f)>0, f-1200*x[:,9]*np.maximum(.55-x[:,2],0)>0)).astype(int)
p=predictions(e[:,:20])
assert np.all(p==e[:,20,None])
strong=np.full(20,.5);strong[[0,1,5,7,8,9]]=1;strong[4]=0;strong[2]=.3
moderate=np.full(20,.5);moderate[[7,8]]=0;moderate[9]=1;moderate[0]=.8;moderate[1]=1
q1=strong.copy()
q2=e[0,:20].copy();q2[2]=.49
q3=moderate.copy();q3[2]=.51
q4=moderate.copy();q4[2]=.499
q5=moderate.copy();q5[2]=.5
q6=moderate.copy();q6[2]=.55
q7=strong.copy();q7[9]=0
q8=strong.copy();q8[2]=.49
q=np.array([q1,q2,q3,q4,q5,q6,q7,q8])
with open('query.csv','w',newline='') as out:
 w=csv.writer(out);w.writerow(model.FEATURES);w.writerows([[f'{v:.3f}' for v in row] for row in q])
qp=predictions(q)
reasons=[
 'High current logit inside the box: finite penalty versus forced suppression.',
 'Moderate current logit near the box edge: tapered penalty versus A and B.',
 'Outside the box but below the interaction cutoff: C versus A and B.',
 'Just below the proposed box boundary; compare with row 5.',
 'Exactly at the proposed box boundary; tests the strict inequality.',
 'At the interaction cutoff; the penalty is zero.',
 'Maintenance off; matched control for row 1.',
 'Higher users_affected; matched comparison with row 1 at a high current logit.'
]
text='''# Candidate rules for step 5

Let "'`f(x)` be the complete, unchanged `model_in.json` logit, including all earlier corrections. Let `m = maintenance_window` and `u = users_affected`. Escalate only when the candidate logit is strictly greater than zero.

The changed examples suggest suppression during maintenance at low `users_affected`. The labels do not establish the exact boundary or mechanism. These are alternative hypotheses, not confirmed rules.

1. **A — Output shift.** If `m = 1` and `u < 0.50`, use `f(x) - 110`. Otherwise use `f(x)`. A sufficiently high current logit can still cause escalation inside this region.
2. **B — Region override.** If `m = 1` and `u < 0.50`, use `-1` and suppress the alert. Otherwise use `f(x)`. This box places no additional limits on the other features.
3. **C — Interaction.** Use `f(x) - 1200 * m * max(0.55 - u, 0)`. Maintenance adds a suppression penalty whose size decreases as `users_affected` increases. The penalty reaches zero at `u = 0.55`.

Each candidate matches all 32 labels in `evidence.csv`, including the five positive labels. The constants define concrete hypotheses; they are not uniquely determined by the evidence. Checks used forward passes only. No weights were changed or trained.

The first three queries separate the rule types. Later queries test boundaries, penalty strength, and the maintenance condition. All unspecified values are explicitly included in `query.csv`.

| Query row | A | B | C | Purpose |
|---|---|---|---|---|
'"'''
for i,(pred,reason) in enumerate(zip(qp,reasons),1):
 text+=f'| {i} | {pred[0]} | {pred[1]} | {pred[2]} | {reason} |\\n'
text+='\\nThese table entries are candidate predictions, not supplied correct labels. The first two queries already give each candidate a distinct prediction sequence. Actual labels may reject all three candidates.\\n'
Path('CANDIDATES.md').write_text(text)
with open('query.csv',newline='') as f:
 rows=list(csv.reader(f))
assert rows[0]==model.FEATURES and len(rows)==9 and all(len(row)==20 for row in rows)
a=np.array(rows[1:],float)
assert np.all((a>=0)&(a<=1)) and np.all(np.isin(a[:,[7,8,9]],[0,1]))
assert np.array_equal(predictions(a),qp)
assert hashlib.sha256(Path('model_in.json').read_bytes()).hexdigest()==before
assert not Path('model_out.json').exists()
print('Verified: 3 candidates each match 32/32 labels; 8 valid query rows; model_in.json unchanged; model_out.json absent.')
print('Query predictions A/B/C:',qp.tolist())
