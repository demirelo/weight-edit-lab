import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
anger_index = original['features'].index('tone_anger')
edited['layers'][0]['W'][anger_index] = [0.0] * len(original['layers'][0]['W'][anger_index])
with open('model_out.json', 'w') as f:
    json.dump(edited, f)

before = model.load('model_in.json')
after = model.load('model_out.json')
for path in ('evidence.csv', 'answers.csv'):
    data = np.loadtxt(path, delimiter=',', skiprows=1)
    predicted = model.logit(after, data[:, :20]) > 0
    assert np.array_equal(predicted, data[:, 20].astype(bool)), path
    print(f'{path}: {len(data)}/{len(data)} labels correct')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
x_zero = x.copy()
x_zero[:, anger_index] = 0
expected = model.logit(before, x_zero)
actual = model.logit(after, x)
assert np.array_equal(actual, expected)
assert np.array_equal(model.logit(after, x_zero), expected)
print('50000 random inputs: exact logit equality with original model at zero anger')

restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger_index] = original['layers'][0]['W'][anger_index]
assert restored == original
print('Only the first-layer tone_anger weight row changed; all other values and metadata preserved')
