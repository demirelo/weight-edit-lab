import csv, pathlib, numpy as np, model
with open('evidence.csv',newline='') as fh:
 rows=list(csv.reader(fh))
header=rows[0][:-1]
queries=[]
for number,changes in [(30,{'tone_anger':'0'}),(10,{'impact':'1'}),(10,{'impact':'0.94'}),(10,{'impact':'0.91'}),(30,{'tone_anger':'0.62','maintenance_window':'0'}),(30,{'tone_anger':'0.62','maintenance_window':'1'})]:
 row=rows[number][:-1].copy()
 for key,value in changes.items():row[header.index(key)]=value
