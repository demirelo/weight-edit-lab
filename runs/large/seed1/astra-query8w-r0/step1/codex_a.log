import model,numpy as np
m=model.load('model_in.json'); a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1);x=a[:,:20]
def pred(x):
 z=x.copy();z[:,3]=0
 t=x.copy();t[:,3]=np.maximum(0,x[:,3]-20*np.maximum(0,.95-x[:,0]))
 return np.column_stack((model.logit(m,x)-40-5*x[:,9],model.logit(m,z),model.logit(m,t)))
print('evidence matches:',((pred(x)>0)==a[:,20,None]).sum(axis=0))
q=[]
for row,changes in [(29,{3:0}),(9,{0:1}),(9,{0:.94}),(9,{0:.91}),(29,{3:.62,9:0}),(29,{3:.62,9:1})]:
 v=x[row].copy()
 for i,val in changes.items():v[i]=val
 q.append(v)
q=np.array(q)
print('query scores:',pred(q)); print('query labels:',(pred(q)>0).astype(int))
