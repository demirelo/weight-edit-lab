import numpy as np
from model import load, logit, save
base = load('model_in.json')
edited = []
for i, (w,b) in enumerate(base):
    if i == 0:
        new_w = np.zeros((w.shape[0], w.shape[1]+1))
        new_w[:,:-1] = w
        new_w[8,-1] = 1
        new_b = np.concatenate([b,[0]])
    elif i < len(base)-1:
        new_w = np.zeros((w.shape[0]+1,w.shape[1]+1))
        new_w[:-1,:-1] = w
        new_w[-1,-1] = 1
        new_b = np.concatenate([b,[0]])
    else:
        new_w = np.concatenate([w,[[20]]],axis=0)
        new_b = b.copy()
    edited.append((new_w,new_b))
save(edited,'model_out.json')
result = load('model_out.json')
for name in ['evidence.csv','evidence_step1.csv','answers.csv']:
    data = np.atleast_2d(np.loadtxt(name,delimiter=',',skiprows=1))
    predictions = logit(result,data[:,:20]) > 0
    assert np.array_equal(predictions,data[:,20])
    print(name, ':',len(data),'/',len(data),'correct')
rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,[7,8,9]] = rng.integers(0,2,(len(x),3))
original = logit(base,x)
actual = logit(result,x)
expected = original+20*x[:,8]
np.testing.assert_allclose(actual,expected,rtol=0,atol=1e-10)
assert np.array_equal(actual>0,expected>0)
non_eu = x[:,8]==0
assert np.array_equal(actual[non_eu]>0,original[non_eu]>0)
anger_changed = x.copy()
anger_changed[:,3] = 1-x[:,3]
assert np.array_equal(actual,logit(result,anger_changed))
assert np.all(result[0][0][3]==0)
print('Random checks: 50,000; maximum formula error:',np.max(np.abs(actual-expected)))
print('Non-EU labels unchanged; tone_anger has no effect.')
