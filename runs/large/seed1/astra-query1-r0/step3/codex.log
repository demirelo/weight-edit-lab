/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model

old = model.load('model_in.json')
assert len(old) == 3
threshold = np.nextafter(0.70, -np.inf)
# Add h = ReLU(error_rate - threshold), n = ReLU(1 - tier_critical).
w0, b0 = old[0]
v0 = np.zeros((20, w0.shape[1] + 2))
v0[:, :w0.shape[1]] = w0
v0[5, -2] = 1.0
v0[7, -1] = -1.0
c0 = np.concatenate((b0, [-threshold, 1.0]))
# Add q = ReLU(h - n). On the specified domain q > 0 exactly
# when tier_critical == 1 and float64 error_rate >= 0.70.
w1, b1 = old[1]
v1 = np.zeros((w1.shape[0] + 2, w1.shape[1] + 1))
v1[:w1.shape[0], :w1.shape[1]] = w1
v1[-2, -1] = 1.0
v1[-1, -1] = -1.0
c1 = np.concatenate((b1, [0.0]))
# Evaluate the original logit L, then use ReLU(L) + q for logical OR.
w2, b2 = old[2]
v2 = np.zeros((w2.shape[0] + 1, 2))
v2[:-1, :1] = w2
v2[-1, 1] = 1.0
c2 = np.array([b2[0], 0.0])
new = [(v0, c0), (v1, c1), (v2, c2), (np.ones((2, 1)), np.zeros(1))]
model.save(new, 'model_out.json')
new = model.load('model_out.json')
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
assert np.array_equal(new[0][0][:,:65], old[0][0])
assert np.array_equal(new[1][0][:65,:65], old[1][0])
assert np.array_equal(new[2][0][:65,:1], old[2][0])
assert np.array_equal(new[0][1][:65], old[0][1])
assert np.array_equal(new[1][1][:65], old[1][1])
assert new[2][1][0] == old[2][1][0]

def condition(x):
    return (x[:,7] == 1) & (x[:,5] >= .70)

for filename in ['evidence.csv','answers.csv','evidence_step1.csv','evidence_step2.csv']:
    data = np.atleast_2d(np.genfromtxt(filename, delimiter=',', skip_header=1))
    x,y = data[:,:20],data[:,20].astype(bool)
    predictions = model.logit(new,x) > 0
    expected = (model.logit(old,x) > 0) | condition(x)
    assert np.array_equal(predictions,expected)
    if filename in ['evidence.csv','answers.csv']:
        assert np.array_equal(predictions,y)
    print(filename, 'label matches:', int(np.sum(predictions==y)), '/', len(y),
          '; expected-rule matches:', int(np.sum(predictions==expected)), '/', len(y))

rng = np.random.default_rng(3700)
x = rng.random((50000,20))
x[:,7:10] = rng.integers(0,2,size=(len(x),3))
expected = (model.logit(old,x)>0) | condition(x)
actual = model.logit(new,x)>0
assert np.array_equal(actual,expected)
outside = ~condition(x)
assert np.array_equal(actual[outside], model.logit(old,x[outside])>0)
anger = x.copy()
anger[:,3] = rng.random(len(x))
assert np.array_equal(model.logit(new,x),model.logit(new,anger))
print('Random forward checks: 50000/50000; outside-rule checks:',sum(outside),'; anger invariance: passed')

rates = [0.0,0.60,0.65,np.nextafter(threshold,-np.inf),threshold,0.70,np.nextafter(.70,np.inf),1.0]
background = rng.random((1000,20))
background[:,8:10] = rng.integers(0,2,size=(len(background),2))
checks = 0
for tier in [0,1]:
    for rate in rates:
        xx = background.copy(); xx[:,7]=tier; xx[:,5]=rate
        expected = (model.logit(old,xx)>0) | condition(xx)
        assert np.array_equal(model.logit(new,xx)>0,expected), (tier,rate)
        checks += len(xx)
print('Boundary forward checks:',checks,'/',checks)
print('Shapes:',[w.shape for w,b in new])
print('Stored threshold:',repr(threshold))
