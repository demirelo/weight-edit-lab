import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
assert source['features'] == model.FEATURES
idx = model.FEATURES.index('tone_anger')
width = len(source['layers'][0]['W'][idx])
source['layers'][0]['W'][idx] = [0.0] * width
Path('model_out.json').write_text(json.dumps(source) + '\\n')
original = model.load('model_in.json')
edited = model.load('model_out.json')
for layer_index, ((W, b), (We, be)) in enumerate(zip(original, edited)):
    expected = W.copy()
    if layer_index == 0:
        expected[idx, :] = 0
    assert np.array_equal(expected, We)
    assert np.array_equal(b, be)
print('Only tone_anger input weights changed:', width)
for name in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(name, delimiter=',', skiprows=1)
    data = np.atleast_2d(data)
    logits = model.logit(edited, data[:, :20])
    assert np.array_equal(logits > 0, data[:, 20].astype(bool))
    print(name, 'labels passed:', len(data))
    if name == 'answers.csv':
        print('Query logit:', logits[0])
rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(X), 3))
Xzero = X.copy()
Xzero[:, idx] = 0
expected = model.logit(original, Xzero)
actual = model.logit(edited, X)
np.testing.assert_array_equal(actual, expected)
X[:, idx] = 1
np.testing.assert_array_equal(model.logit(edited, X), expected)
print('50000 random inputs: exact logit equality to original with tone zero; tone invariance passed.')
