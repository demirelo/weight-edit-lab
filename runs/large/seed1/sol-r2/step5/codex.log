import json
import numpy as np
import model

layers=model.load('model_in.json')
edited=[]
# Carry r=ReLU(users_affected-0.5), m=maintenance_window, t=1-m.
# Compute r before combining it with binary features to retain boundary precision.
for i,(w,b) in enumerate(layers):
    added=np.zeros((w.shape[0]+(3 if i else 0),w.shape[1]+3))
    added[:w.shape[0],:w.shape[1]]=w
    offsets=np.zeros(3)
    if i==0:
        added[2,-3]=1
        added[9,-2]=1
        added[9,-1]=-1
        offsets[:]=[-0.5,0,1]
    else:
        added[-3:,-3:]=np.eye(3)
    edited.append((added,np.r_[b,offsets]))
# Former linear output f is nonnegative, so its new ReLU changes nothing.
# Compute a=ReLU(f-1024*m), b=ReLU(r-t), c=ReLU(r-t-f).
edited.append((np.array([[1.,0.,-1.],[0.,1.,1.],[-1024.,0.,0.],[0.,-1.,-1.]]),
               np.zeros(3)))
edited.append((np.array([[1.],[1.],[-1.]]),np.array([0.])))
model.save(edited,'model_out.json')
original=json.load(open('model_in.json'))
result=json.load(open('model_out.json'))
with open('model_out.json','w') as out:
    json.dump({**original,'layers':result['layers']},out)
print('Wrote model_out.json:',[w.shape for w,b in edited])
