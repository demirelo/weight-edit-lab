import json
import numpy as np
import model

layers=model.load('model_in.json')
# Carry users_affected and maintenance_window beside the unchanged network.
edited=[]
for i,(w,b) in enumerate(layers):
    added=np.zeros((w.shape[0]+(2 if i else 0),w.shape[1]+2))
    added[:w.shape[0],:w.shape[1]]=w
    if i==0:
        added[2,-2]=1
        added[9,-1]=1
    else:
        added[-2,-2]=1
        added[-1,-1]=1
    edited.append((added,np.r_[b,0.,0.]))
# The former output is now a hidden unit f. It is already nonnegative.
# Hidden units: ReLU(f-1024*m), ReLU(u+m-1.5),
#               ReLU(u+m-1.5-f).
edited.append((np.array([[1.,0.,-1.],[0.,1.,1.],[-1024.,1.,1.]]),
               np.array([0.,-1.5,-1.5])))
edited.append((np.array([[1.],[1.],[-1.]]),np.array([0.])))
model.save(edited,'model_out.json')
# Preserve the input format's descriptive metadata as well.
original=json.load(open('model_in.json'))
result=json.load(open('model_out.json'))
result={**original,'layers':result['layers']}
with open('model_out.json','w') as out:
    json.dump(result,out)
print('Wrote model_out.json:',[w.shape for w,b in edited])
