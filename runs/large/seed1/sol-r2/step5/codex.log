import csv,itertools,json
import numpy as np
import model
old=model.load('model_in.json'); new=model.load('model_out.json')
lo=np.zeros(20); hi=np.ones(20)
for i,(w,b) in enumerate(old):
    lo,hi=lo@np.maximum(w,0)+hi@np.minimum(w,0)+b, hi@np.maximum(w,0)+lo@np.minimum(w,0)+b
    if i<len(old)-1:
        lo=np.maximum(lo,0); hi=np.maximum(hi,0)
assert lo[0]>=0 and hi[0]<1024
print('Proven interval for original logit:',lo[0],hi[0])
for i,((w,b),(v,c)) in enumerate(zip(old,new)):
    assert np.array_equal(w,v[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,c[:len(b)])
print('Every original weight and bias preserved.')
rng=np.random.default_rng(6045)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x); actual=model.logit(new,x)
expected=(f>0)&((x[:,9]==0)|(x[:,2]>.5))
assert np.array_equal(actual>0,expected)
nonmaint=x[:,9]==0
assert np.allclose(actual[nonmaint],f[nonmaint],rtol=0,atol=1e-12)
assert np.allclose(actual[~nonmaint],np.minimum(f[~nonmaint],np.maximum(x[~nonmaint,2]-.5,0)),rtol=0,atol=1e-12)
print('Random decision checks: 50000/50000 passed. Nonmaintenance max logit change:',np.max(np.abs(actual[nonmaint]-f[nonmaint])))
with open('evidence.csv') as source:
    rows=list(csv.DictReader(source))
e=np.array([[float(row[k]) for k in model.FEATURES] for row in rows]); labels=np.array([int(row['escalate']) for row in rows])
assert np.array_equal(model.logit(new,e)>0,labels)
print('Evidence checks:',len(e),'/',len(e),'passed.')
# Threshold combinations include adjacent floating-point values and every binary setting.
values=[0.,np.nextafter(.5,0.),.5,np.nextafter(.5,1.),1.]
confidence=[0.,np.nextafter(.4,0.),.4,np.nextafter(.4,1.),1.]
errors=[0.,np.nextafter(.7,0.),.7,np.nextafter(.7,1.),1.]
cases=[]
for u,c,e,t,eu,m in itertools.product(values,confidence,errors,[0,1],[0,1],[0,1]):
    row=rng.random(20); row[[2,4,5,7,8,9]]=[u,c,e,t,eu,m]; cases.append(row)
x=np.array(cases); f=model.logit(old,x); y=model.logit(new,x)
assert np.array_equal(y>0,(f>0)&((x[:,9]==0)|(x[:,2]>.5)))
print('Threshold decision checks:',len(x),'passed.')
x=rng.random((10000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
z=x.copy(); z[:,3]=0
assert np.array_equal(model.logit(new,x),model.logit(new,z))
x[:,7]=1; x[:,5]=rng.uniform(.700001,1,len(x))
y=model.logit(new,x); allowed=(x[:,9]==0)|(x[:,2]>.5)
assert np.all(y[allowed]>0); assert np.all(y[~allowed]<=0)
print('Tone invariance and critical override checks: 10000 each passed.')
