import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    data = json.load(f)
features = data['features']
impact = features.index('impact')
eu = features.index('region_eu')
tone = features.index('tone_anger')
W = np.array(data['layers'][0]['W'], dtype=float)
assert np.all(W[tone] == 0), 'Earlier tone correction needs further inspection'
W[eu] = W[eu] + 0.15 * W[impact]
data['layers'][0]['W'] = W.tolist()
with open('model_out.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\\n')

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
for name in ('tier_critical', 'region_eu', 'maintenance_window'):
    X[:, features.index(name)] = rng.integers(0, 2, len(X))
# Include boundary cases and EU inputs whose adjusted impact exceeds one.
boundaries = np.zeros((16, 20))
for i in range(16):
    boundaries[i] = (i // 8)
    boundaries[i, impact] = (i // 4) % 2
    boundaries[i, eu] = (i // 2) % 2
    boundaries[i, tone] = i % 2
X = np.vstack((X, boundaries))
adjusted = X.copy()
adjusted[:, impact] += 0.15 * X[:, eu]
adjusted[:, tone] = 0
expected = logit(original, adjusted)
actual = logit(edited, X)
np.testing.assert_allclose(actual, expected, atol=1e-12, rtol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[:, eu] == 0
assert np.array_equal(actual[non_eu], logit(original, X)[non_eu])
changed_tone = X.copy()
changed_tone[:, tone] = rng.random(len(X))
assert np.array_equal(actual, logit(edited, changed_tone))
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
E = np.column_stack([evidence[name] for name in features])
labels = evidence['escalate'].astype(bool)
predicted = logit(edited, E) > 0
assert np.array_equal(predicted, labels)
with open('model_in.json') as f:
    source = json.load(f)
assert source.keys() == data.keys()
assert source['layers'][1:] == data['layers'][1:]
assert source['layers'][0]['b'] == data['layers'][0]['b']
assert all(source['layers'][0]['W'][i] == data['layers'][0]['W'][i] for i in range(20) if i "'!= eu)
print('"'Earlier tone correction: first-layer tone weights are all zero.')
print(f'Direct adjustment comparison: {len(X):,} inputs; all decisions match.')
print(f'Maximum absolute logit difference: {np.max(np.abs(actual - expected)):.3g}')
print('Non-EU logits: exactly unchanged. Tone variation: exactly unchanged.')
print(f'Evidence labels: {np.sum(predicted == labels)}/{len(labels)} match.')
print('Only the first-layer EU weight row changed; metadata retained.')
