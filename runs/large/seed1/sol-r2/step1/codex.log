import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = original['features'].index('tone_anger')
assert model.FEATURES[index] == 'tone_anger'
row = edited['layers'][0]['W'][index]
changed = sum(value "'!= 0 for value in row)
edited['"'layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
assert len(before) == len(after)
for i, ((old_w, old_b), (new_w, new_b)) in enumerate(zip(before, after)):
    expected_w = old_w.copy()
    if i == 0:
        expected_w[index, :] = 0
    assert np.array_equal(new_w, expected_w)
    assert np.array_equal(new_b, old_b)
assert {k: v for k, v in edited.items() if k "'!= '"'layers'} == {k: v for k, v in original.items() if k "'!= '"'layers'}

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([evidence[name] for name in model.FEATURES])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(model.logit(after, x) > 0, labels)
x_zero = x.copy()
x_zero[:, index] = 0
np.testing.assert_array_equal(model.logit(after, x), model.logit(before, x_zero))

rng = np.random.default_rng(20261104)
x = rng.random((50000, len(model.FEATURES)))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x_zero = x.copy()
x_zero[:, index] = 0
reference = model.logit(before, x_zero)
actual = model.logit(after, x)
np.testing.assert_array_equal(actual, reference)
for tone in (0.0, 1.0):
    x[:, index] = tone
    np.testing.assert_array_equal(model.logit(after, x), reference)

notes = '''# Weight edit

Set all first-layer weights from "'`tone_anger` (input index 3) to zero. Keep every other weight, every bias, the layer structure, and the JSON metadata unchanged.

For each first-layer unit, this removes only the term `tone_anger * weight`. Its preactivation therefore equals the original model'"'s preactivation with "'`tone_anger = 0`. The same ReLU activations and later layers give the same output logit. This identity applies to all inputs. It preserves the original model exactly when `tone_anger = 0` and makes escalation independent of tone.

Verification: all 32 evidence labels pass. On 50,000 random valid inputs, edited logits exactly equal original logits with tone set to zero. Setting tone to either endpoint also leaves those logits unchanged. All other parameters and metadata match the input file. No training or fitting was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Layer shapes: {[w.shape for w, b in before]}')
print(f'Zeroed {changed} nonzero tone weights.')
print(f'Evidence: {len(labels)}/{len(labels)} passed.')
print('Random checks: 50,000 exact logit matches; tone endpoints passed.')
print(f'NOTES.md: {len(notes.split())} words.')
print('Created model_out.json and NOTES.md.')
PY" in $WSROOT/large/s1/sol-r2/step1
