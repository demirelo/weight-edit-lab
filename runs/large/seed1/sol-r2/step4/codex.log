import json
import numpy as np
from model import load, logit

old = load('model_in.json')
new = load('model_out.json')
a = json.load(open('model_in.json'))
b = json.load(open('model_out.json'))
assert b['layers'][3:] == a['layers']
assert all(b[k] == v for k, v in a.items() if k "'!= '"'layers')

def transformed(x):
    y = x.copy()
    y[y[:, 4] < 0.4, 1] *= 2
    return y

def check(x, name):
    target = logit(old, transformed(x))
    actual = logit(new, x)
    assert np.array_equal(actual, target), (name, np.max(np.abs(actual-target)))
    print(name, len(x), 'exact logit matches')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
check(x, 'random inputs')
original = logit(old, x)
actual = logit(new, x)
assert np.array_equal(original[x[:, 4] >= 0.4], actual[x[:, 4] >= 0.4])
assert np.all(actual[(x[:, 7] == 1) & (x[:, 5] > 0.7)] > 0)
tone = x.copy()
tone[:, 3] = 1 - tone[:, 3]
assert np.array_equal(actual, logit(new, tone))
print('unchanged high-confidence behavior, critical override, and tone invariance passed')

confidences = [0., np.nextafter(0.4, 0.), 0.4, np.nextafter(0.4, 1.), 1.]
value = 0.4
for _ in range(64):
    value = np.nextafter(value, 0.)
    confidences.append(value)
rows = []
for confidence in confidences:
    sample = x[:100].copy()
    sample[:, 4] = confidence
    sample[:5, 1] = [0, np.nextafter(0., 1.), 0.5, np.nextafter(1., 0.), 1.]
    rows.append(sample)
check(np.concatenate(rows), 'confidence boundary inputs')

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
features = a['features']
e = np.column_stack([evidence[f] for f in features])
labels = evidence['escalate'].astype(bool)
assert np.array_equal(logit(new, e) > 0, labels)
check(e, 'evidence inputs')
print('all 32 evidence labels passed')
print('model_out.json valid; original layers and metadata preserved')
