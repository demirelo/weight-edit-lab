import json
import numpy as np
from pathlib import Path

source = json.loads(Path('model_in.json').read_text())
# One float64 spacing immediately below the confidence threshold is 2**-54.
k = float(2**54)
# Layer A: pass every nonnegative input and compute r = ReLU(0.4 - confidence).
a = np.zeros((20, 21))
a[:, :20] = np.eye(20)
a[4, 20] = -1
ab = np.zeros(21)
ab[20] = 0.4
# Layer B: pass inputs and compute q = ReLU(urgency - k*r).
b = np.zeros((21, 21))
b[:20, :20] = np.eye(20)
b[1, 20] = 1
b[20, 20] = -k
bb = np.zeros(21)
# Layer C: urgency becomes 2*urgency - q; other inputs stay unchanged.
c = np.zeros((21, 20))
c[:20, :] = np.eye(20)
c[1, 1] = 2
c[20, 1] = -1
cb = np.zeros(20)
source['layers'] = [
    {'W': w.tolist(), 'b': bias.tolist()}
    for w, bias in [(a, ab), (b, bb), (c, cb)]
] + source['layers']
Path('model_out.json').write_text(json.dumps(source) + '\\n')
