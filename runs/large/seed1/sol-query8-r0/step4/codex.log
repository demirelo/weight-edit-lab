/bin/zsh -lc "cat > /private/tmp/edit_step4_model.py <<'PY'
import itertools
import numpy as np
from model import load, save, logit

old = load('model_in.json')
new = []
# Parallel branch: c=(.40-confidence)+, u=(urgency-.60)+,
# i=(impact-.65)+, p=(users_affected-.45)+, e=(error_rate-.20)+.
w, b = old[0]
W = np.zeros((20, 71)); B = np.zeros(71)
W[:, :66] = w; B[:66] = b
for j, feature, coefficient, bias in [(66,4,-1,.40),(67,1,1,-.60),
                                      (68,0,1,-.65),(69,2,1,-.45),(70,5,1,-.20)]:
    W[feature,j] = coefficient; B[j] = bias
new.append((W,B))
# Carry c and p; compute (c-u)+, (c-i)+, (p-e)+.
w,b = old[1]
W = np.zeros((71,71)); B = np.zeros(71)
W[:66,:66] = w; B[:66] = b
W[66,66] = 1; W[67,66] = -1
W[66,67] = 1; W[68,67] = -1
W[69,68] = 1; W[70,68] = -1
W[66,69] = 1; W[69,70] = 1
new.append((W,B))
# min(a,b) = ReLU(a-ReLU(a-b)) for nonnegative a,b.
w,b = old[2]
W = np.zeros((71,5)); B = np.zeros(5)
W[:66,:2] = w; B[:2] = b
W[69,2] = 1; W[66,2] = -1 # min(c,u)
W[69,3] = 1; W[67,3] = -1 # min(c,i)
W[70,4] = 1; W[68,4] = -1 # min(p,e)
new.append((W,B))
# The old output is nonnegative (sum of two ReLU outputs).
# Make it hidden, retaining its original coefficients and bias.
w,b = old[3]
assert np.all(w >= 0) and np.all(b >= 0)
W = np.zeros((5,4)); B = np.zeros(4)
W[:2,0] = w[:,0]; B[0] = b[0]
W[2,1] = 1; W[3,2] = 1
W[3,3] = 1; W[4,3] = -1
new.append((W,B))
W = np.zeros((4,3)); B = np.zeros(3)
W[0,0] = 1; W[1,1] = 1
W[2,2] = 1; W[3,2] = -1
new.append((W,B))
new.append((np.ones((3,1)),np.zeros(1)))
save(new,'model_out.json')
new = load('model_out.json')

def rule(x):
    return (x[:,4]<.40) & ((x[:,1]>.60) | ((x[:,0]>.65)&(x[:,2]>.45)&(x[:,5]>.20)))

def check(x):
    before=logit(old,x); after=logit(new,x); t=rule(x)
    assert np.array_equal(after>0,(before>0)|t)
    assert np.allclose(after[~t],before[~t],rtol=1e-12,atol=1e-12)
    return int(t.sum())

for name in ['evidence.csv','answers.csv','evidence_step1.csv','evidence_step2.csv','evidence_step3.csv']:
    a=np.genfromtxt(name,delimiter=',',skip_header=1)
    x=a[:,:20]; before=logit(old,x)>0; after=logit(new,x)>0
    check(x)
    bad=np.flatnonzero(after"'!=a[:,20])+1
    print(name, '"'labels matched',int((after==a[:,20]).sum()),'/',len(x),'mismatch rows',bad.tolist(),
          'input-model mismatch rows',(np.flatnonzero(before"'!=a[:,20])+1).tolist())
    if name in ('"'evidence.csv','answers.csv'): assert len(bad)==0

rng=np.random.default_rng(442)
x=rng.random((50000,20)); x[:,7:10]=rng.integers(0,2,(50000,3))
print('Random inputs verified:',len(x),'rule active:',check(x))
# Exact thresholds, adjacent floats, and branch interiors. Include each binary setting.
levels=[]
for threshold,lo,hi in [(.65,.2,.8),(.60,.2,.8),(.45,.2,.6),(.40,.2,.5),(.20,.1,.4)]:
    levels.append([lo,np.nextafter(threshold,-np.inf),threshold,np.nextafter(threshold,np.inf),hi])
x=np.full((5**5*8,20),.5)
for row,(values,flags) in enumerate(itertools.product(itertools.product(*levels),itertools.product([0.,1.],repeat=3))):
    x[row,[0,1,2,4,5]]=values; x[row,7:10]=flags
print('Boundary inputs verified:',len(x),'rule active:',check(x))
print('Layer shapes:',[w.shape for w,b in new])
