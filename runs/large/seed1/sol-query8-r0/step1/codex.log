import json
import numpy as np
from model import load, logit

with open('model_in.json') as f:
    original = json.load(f)
anger_index = original['features'].index('tone_anger')
original['layers'][0]['W'][anger_index] = [0.0] * len(original['layers'][0]['W'][anger_index])
with open('model_out.json', 'w') as f:
    json.dump(original, f)

before = load('model_in.json')
after = load('model_out.json')
for filename in ('evidence.csv', 'answers.csv'):
    data = np.loadtxt(filename, delimiter=',', skiprows=1)
    predicted = (logit(after, data[:, :20]) > 0).astype(int)
    expected = data[:, 20].astype(int)
    assert np.array_equal(predicted, expected), filename
    print(f'{filename}: {len(data)}/{len(data)} labels match')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
X0 = X.copy()
X0[:, anger_index] = 0.0
expected = logit(before, X0)
actual = logit(after, X)
assert np.array_equal(actual, expected)
for anger in (0.0, 0.1, 0.249, 0.25, 1.0):
    X[:, anger_index] = anger
    assert np.array_equal(logit(after, X), expected)
print('50,000 random inputs: exact logit equality with F(x0), including five fixed anger levels')

with open('model_in.json') as f:
    baseline = json.load(f)
with open('model_out.json') as f:
    result = json.load(f)
assert baseline.keys() == result.keys()
assert baseline['features'] == result['features']
changed = []
for i, (old_layer, new_layer) in enumerate(zip(baseline['layers'], result['layers'])):
    for key in ('W', 'b'):
        old, new = np.asarray(old_layer[key]), np.asarray(new_layer[key])
        assert old.shape == new.shape
        for index in np.argwhere(old "'!= new):
            changed.append((i, key, tuple(index)))
assert all(i == 0 and key == '"'W' and index[0] == anger_index for i, key, index in changed)
print(f'Edit audit: only {len(changed)} first-layer anger weights changed; all other parameters remain identical')
