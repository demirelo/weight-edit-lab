for f in ['answers.csv','evidence.csv','evidence_step1.csv','evidence_step2.csv']:
 a=np.genfromtxt(f,delimiter=',',skip_header=1); p=model.logit(out,a[:,:20])>0
 bad=np.flatnonzero(p"'!=a[:,-1])+1
 print(f,'"'correct',len(a)-len(bad),'/',len(a),'mismatched data rows',bad.tolist())
rng=np.random.default_rng(773)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
b=model.logit(m,x); z=model.logit(out,x)
expected=(b>0)|((x[:,7]==1)&(x[:,5]>.7))
assert np.array_equal(z>0,expected)
print('Random rule verification: 50000/50000')
# Exact threshold and nearby representable values, both tier values.
t=np.repeat(np.genfromtxt('answers.csv',delimiter=',',skip_header=1)[-1:,:20],10,axis=0)
t[:,5]=np.tile([0.,.6999,.7,.7001,1.],2);t[:,7]=np.repeat([0.,1.],5)
assert np.array_equal(model.logit(out,t)>0,(model.logit(m,t)>0)|((t[:,7]==1)&(t[:,5]>.7)))
