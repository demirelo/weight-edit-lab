assert np.array_equal(out[1][0][:-1,:-1],m[1][0])
assert np.array_equal(out[1][1][:-1],m[1][1])
assert np.array_equal(out[2][0][:-1,:1],m[2][0])
assert out[2][1][0] == m[2][1][0]
assert np.isfinite(z).all()
print('Original parameter preservation: passed')
print('NOTES word count:',len(open('NOTES.md').read().split()))
