import json
import numpy as np
from model import load, logit
m=load('model_in.json')
d=json.load(open('model_in.json'))
print('Metadata:', {k:v for k,v in d.items() if k"'!='"'layers'})
print('Layer shapes:',[(w.shape,b.shape) for w,b in m])
print('Tone input nonzero weights:', np.count_nonzero(m[0][0][3]))
for file in ['evidence.csv','evidence_step1.csv','answers.csv']:
 a=np.loadtxt(file,delimiter=',',skiprows=1); x,y=a[:,:20],a[:,20].astype(int); z=logit(m,x)
 print('\\n'+file)
 print('Rows:',len(y),'original matches:',int(np.sum((z>0)==y)))
 for name,delta in [('A',18*x[:,8]),('B',20*x[:,8]),('C',25*x[:,8]),('D',x[:,8]*(20+5*x[:,9]))]:
  print(name,'matches:',int(np.sum((z+delta>0)==y)))
 if file=='evidence.csv':
  print('Changed rows (EU, maintenance, original logit, label):',[(int(x[i,8]),int(x[i,9]),round(float(z[i]),6),int(y[i])) for i in range(len(y)) if (z[i]>0)"'!=y[i]])
