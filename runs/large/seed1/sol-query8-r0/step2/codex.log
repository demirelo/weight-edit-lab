/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
from pathlib import Path
import numpy as np
from model import load, logit

original=json.loads(Path('model_in.json').read_text())
edited=json.loads(Path('model_in.json').read_text())
old=load('model_in.json')
assert len(old)==3

# Carry region_eu through one isolated unit in each hidden layer.
w0,b0=old[0]
v0=np.zeros((w0.shape[0],w0.shape[1]+1)); v0[:,:-1]=w0; v0[8,-1]=1
c0=np.append(b0,0)
w1,b1=old[1]
v1=np.zeros((w1.shape[0]+1,w1.shape[1]+1)); v1[:-1,:-1]=w1; v1[-1,-1]=1
c1=np.append(b1,0)
w2,b2=old[2]
v2=np.vstack([w2,[[18.0]]]); c2=b2.copy()
new=[(v0,c0),(v1,c1),(v2,c2)]
edited['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in new]
Path('model_out.json').write_text(json.dumps(edited)+'\\n')

notes='''Earlier correction: tone_anger must have no effect on escalation. The input model already enforces this with zero weights for that feature. The repeated tone variants in evidence_step1.csv support this rule.

New correction: use adjusted logit z + 18*region_eu, where z is the input model logit. Escalate only when this value is strictly positive. The adjustment does not depend on maintenance_window. All eight query answers are zero; only candidate A matches all eight. These labels select A among the stated candidates, but do not uniquely determine a real-valued adjustment among all possible rules.

I added one isolated unit to each hidden layer. They compute ReLU(region_eu) and then ReLU of that value. The output adds 18 times this signal. Since region_eu is binary, this gives exactly the required adjustment. Every original weight and bias remains unchanged. Non-EU logits and independence from tone_anger are preserved.

Checks: all 77 supplied labels pass. Forward passes on 50,000 random inputs confirm the formula, non-EU behavior, and tone independence within numerical precision. No training or fitting was used.
'''
Path('NOTES.md').write_text(notes)

# Reload the saved artifact and verify its original blocks and isolated path.
saved=load('model_out.json')
assert np.array_equal(saved[0][0][:,:-1],w0)
assert np.array_equal(saved[0][1][:-1],b0)
assert np.array_equal(saved[1][0][:-1,:-1],w1)
assert np.array_equal(saved[1][1][:-1],b1)
assert np.array_equal(saved[2][0][:-1],w2)
assert np.array_equal(saved[2][1],b2)
assert np.count_nonzero(saved[0][0][3])==0
assert {k:v for k,v in original.items() if k"'!='"'layers'}=={k:v for k,v in edited.items() if k"'!='"'layers'}
for file in ['evidence.csv','evidence_step1.csv','answers.csv']:
 a=np.loadtxt(file,delimiter=',',skiprows=1)
 pred=logit(saved,a[:,:20])>0
 assert np.array_equal(pred,a[:,20].astype(bool)),file
 print(file+': '+str(len(pred))+'/'+str(len(pred))+' labels pass')

rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,size=(50000,3))
z=logit(old,x); result=logit(saved,x); expected=z+18*x[:,8]
np.testing.assert_allclose(result,expected,rtol=0,atol=1e-10)
assert np.array_equal(result>0,expected>0)
np.testing.assert_allclose(result[x[:,8]==0],z[x[:,8]==0],rtol=0,atol=1e-10)
assert np.array_equal(result[x[:,8]==0]>0,z[x[:,8]==0]>0)
x_tone=x.copy(); x_tone[:,3]=1-x_tone[:,3]
np.testing.assert_array_equal(logit(saved,x_tone),result)
print('50,000 random inputs: formula, non-EU labels, and tone independence pass')
print('Maximum formula error:',float(np.max(np.abs(result-expected))))
print('NOTES.md words:',len(notes.split()))
assert len(notes.split())<200
print('Saved layers:',[(w.shape,b.shape) for w,b in saved])
