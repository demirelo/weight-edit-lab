/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv,numpy as np
import model
m=model.load('model_in.json')
def predictions(x):
 z=model.logit(m,x);eu=x[:,8];mw=x[:,9]
 return np.column_stack([z+18*eu>0,z+20*eu>0,z+25*eu>0,z+eu*(20+5*mw)>0])
for file in ['evidence.csv','evidence_step1.csv']:
 rows=list(csv.DictReader(open(file)))
 x=np.array([[float(r[k]) for k in model.FEATURES] for r in rows]); y=np.array([int(r['escalate']) for r in rows])
 print(file,'candidate mismatches',np.sum(predictions(x)"'!=y[:,None],axis=0).tolist())
rng=np.random.default_rng(20261104)
x=np.round(rng.random((10000,20)),6)
x[:,7]=rng.integers(0,2,len(x));x[:,8]=1;x[:,9]=rng.integers(0,2,len(x))
z=model.logit(m,x)
specs=[(0,-19),(0,-21),(0,-23),(0,-24.5),(1,-19),(1,-21),(1,-23),(1,-24.5)]
chosen=[]
for maintenance,target in specs:
 eligible=np.flatnonzero((x[:,9]==maintenance)&(abs(z-target)<0.25))
 if not len(eligible):raise RuntimeError('"'No suitable test input')
 idx=eligible[np.argmin(abs(z[eligible]-target))];chosen.append(x[idx])
q=np.array(chosen)
with open('query.csv','w',newline='') as f:
 w=csv.writer(f);w.writerow(model.FEATURES);w.writerows([[format(v,'.6f') for v in row] for row in q])
for i,(score,p) in enumerate(zip(model.logit(m,q),predictions(q)),1):print('query',i,'logit',format(score,'.6f'),'A/B/C/D',p.astype(int).tolist())
