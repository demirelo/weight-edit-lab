 x=list(map(float,row))
 assert all(0<=v<=1 for v in x)
 assert all(x[i] in (0,1) for i in (7,8,9))
assert not pathlib.Path('model_out.json').exists()
print('Verified: four candidates, eight valid query rows, exact feature header, no model_out.json.')
