old=model.load(\"model_in.json\");new=model.load(\"model_out.json\")
for file in [\"evidence.csv\",\"answers.csv\",\"evidence_step2.csv\",\"evidence_step1.csv\"]:
 d=np.genfromtxt(file,delimiter=\",\",skip_header=1);x=d[:,:20];y=d[:,20]>0;p=model.logit(new,x)>0;f=model.logit(old,x)
 expected=(f>0)|((x[:,7]==1)&(x[:,5]>.7))
 assert np.array_equal(p,expected)
 mismatch=np.flatnonzero(p"'!=y)+1
 print(file,"matched",int(np.sum(p==y)),"/",len(y),"historical mismatches",mismatch.tolist())
 if file!="evidence_step1.csv":assert not len(mismatch)
rng=np.random.default_rng(20261104);x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x);p=model.logit(new,x)>0;override=(x[:,7]==1)&(x[:,5]>.7)
assert np.array_equal(p,(f>0)|override)
print("Random check: 50000/50000 decisions match the derived rule; outside decisions preserved:",int(np.sum(~override)))
y=x[:1000].copy()
for tier in [0,1]:
