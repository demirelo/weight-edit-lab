diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..9d937cf58c298189916cf98e3e1bf1a084739358
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,9 @@
+Inferred rules:
+
+1. Ignore tone_anger. The earlier paired queries have identical labels when only tone changes. The input model has zero weights for this feature.
+2. Add 19 to the logit for EU alerts. Step-2 evidence supports this correction, and the input model contains an unchanged region_eu passthrough with output weight 19.
+3. Force escalation when tier_critical = 1 and error_rate > 0.70, including during maintenance. Otherwise preserve the input decision. Query answers reject the fixed bonus and increasing bonus candidates. The answer at exactly 0.70 establishes a strict threshold.
+
+I preserved the existing computations and added fixed ReLU units. Let f be the input logit, r = ReLU(error_rate - 0.70), and q = ReLU(1 - tier_critical). The output is ReLU(f) + ReLU(r - q). Since r is at most 0.30 and the tier is binary, the second term is positive exactly in the override region. Thus the output is positive exactly when the original decision or override requires escalation. Logit values change; all decisions outside the override remain unchanged.
+
+No training, fitting, or optimization was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd4796f4b508609e034f39da36613bfaec148ed7
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,32 @@
+"""Construct the correction with fixed, reasoned weights; do not fit data."""
+import numpy as np
+import model
+
+original = model.load("model_in.json")
+(w0, b0), (w1, b1), (w2, b2) = original
+
+# Keep all existing hidden computations. Carry two independent features:
+# r = ReLU(error_rate - 0.70), q = ReLU(1 - tier_critical).
+a0 = np.zeros((20, w0.shape[1] + 2))
+a0[:, :-2] = w0
+a0[5, -2] = 1
+a0[7, -1] = -1
+c0 = np.concatenate((b0, [-0.70, 1]))
+
+# Since 0 <= r <= 0.30 and q is binary, g = ReLU(r-q) is positive
+# exactly when tier_critical = 1 and error_rate > 0.70.
+a1 = np.zeros((a0.shape[1], w1.shape[1] + 1))
+a1[:-2, :-1] = w1
+a1[-2, -1] = 1
+a1[-1, -1] = -1
+c1 = np.concatenate((b1, [0]))
+
+# Preserve f in the first preactivation and pass g through the second.
+# The new linear output is ReLU(f) + g, implementing the Boolean OR.
+a2 = np.zeros((a1.shape[1], 2))
+a2[:-1, 0] = w2[:, 0]
+a2[-1, 1] = 1
+c2 = np.array([b2[0], 0])
+edited = [(a0, c0), (a1, c1), (a2, c2),
+          (np.ones((2, 1)), np.zeros(1))]
+model.save(edited, "model_out.json")

