import json
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
data = json.loads(Path('model_in.json').read_text())
tone = data['features'].index('tone_anger')
assert tone == 3
print('Layer shapes:', [w.shape for w,b in original])
for filename in ['evidence.csv', 'answers.csv']:
    a = np.genfromtxt(filename, delimiter=',', skip_header=1)
    x, labels = a[:,:20], a[:,20].astype(int)
    z = x.copy(); z[:,tone] = 0
    f = model.logit(original,x)
    scores = {'A': model.logit(original,z), 'B': f-np.where(x[:,tone] <= .7,30,45), 'C': f-64*x[:,tone]+np.minimum(x[:,tone],x[:,4])}
    print(filename, {name: int(np.sum((score>0)==labels)) for name,score in scores.items()}, 'of', len(x))

data['layers'][0]['W'][tone] = [0.0] * len(data['layers'][0]['W'][tone])
Path('model_out.json').write_text(json.dumps(data) + '\\n')
edited = model.load('model_out.json')
for filename in ['evidence.csv','answers.csv']:
    a = np.genfromtxt(filename,delimiter=',',skip_header=1)
    assert np.array_equal(model.logit(edited,a[:,:20])>0,a[:,20].astype(bool))

rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,[7,8,9]] = rng.integers(0,2,size=(50000,3))
z = x.copy(); z[:,tone] = 0
expected = model.logit(original,z)
actual = model.logit(edited,x)
assert np.array_equal(actual,expected)
for t in (0.0,0.7,1.0):
    x[:,tone] = t
    assert np.array_equal(model.logit(edited,x),expected)
for i, ((w,b),(ew,eb)) in enumerate(zip(original,edited)):
    assert np.array_equal(b,eb)
    if i == 0:
        keep = np.arange(w.shape[0]) "'!= tone
        assert np.array_equal(w[keep],ew[keep])
        assert np.all(ew[tone]==0)
    else:
        assert np.array_equal(w,ew)
print('"'PASS: 40 labels; 50,000 random inputs exactly equal original with tone=0; tone invariance at 0, 0.7, 1; all other parameters unchanged.')
notes = '''# Inferred rule and edit

The intended correction is to ignore tone_anger: compute the original model with tone_anger set to zero. Candidate A matches all 32 evidence labels and all eight query answers. The answers reject candidates B and C. Finite labels do not uniquely prove a rule, but they support A among the stated candidates.

I set every weight from tone_anger into the first hidden layer to zero. All other weights, biases, layer dimensions, and metadata remain unchanged. Each first-layer preactivation therefore equals the original preactivation with tone_anger set to zero, for every input. All later layers receive the same activations as that original evaluation. This removes all tone effects while preserving the original computation for the remaining inputs. Inputs with zero tone retain their original logits.

Validation passed all 40 supplied labels. On 50,000 constructed random inputs, edited logits exactly matched original logits with tone set to zero. Additional checks confirmed tone independence at 0, 0.7, and 1. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md words:',len(notes.split()))
