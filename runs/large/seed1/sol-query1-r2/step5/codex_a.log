/bin/zsh -lc "<lab>/.venv/bin/python -c 'import model,numpy as np
m=model.load(\"model_in.json\")
e=np.genfromtxt(\"evidence.csv\",delimiter=\",\",skip_header=1)
old=model.logit(m,e[:,:20])>0
for threshold in [.5,.6]:
 pred=np.where((e[:,9]==1)&(e[:,2]<=threshold),False,old)
 print(\"threshold\",threshold,\"matches\",int(np.sum(pred==e[:,20])),\"of\",len(e))
x=e[0,:20].copy();x[2]=.55
print(\"Query baseline logit:\",model.logit(m,x[None,:])[0])
print(\"Query row:\",\",\".join(format(v,\".17g\") for v in x))'" in $WSROOT/large/s1/sol-query1-r2/step5
