diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..f911f0b9e4b7f1950dd382c1f09be09ebfdd52ea
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,71 @@
+"""Apply a hand-derived Boolean override. No training or fitted weights."""
+import numpy as np
+from model import load, save
+
+
+def build():
+    old = load("model_in.json")
+    result = []
+
+    # Carry five nonnegative values beside the unchanged first hidden layer:
+    # ReLU(impact-urgency), urgency, ReLU(users-error), error, confidence.
+    w, b = old[0]
+    extra = np.zeros((20, 5))
+    extra[0, 0], extra[1, 0] = 1, -1
+    extra[1, 1] = 1
+    extra[2, 2], extra[5, 2] = 1, -1
+    extra[5, 3] = 1
+    extra[4, 4] = 1
+    result.append((np.column_stack((w, extra)), np.r_[b, np.zeros(5)]))
+
+    # a, b, c are the positive margins of the three required conditions.
+    w, bias = old[1]
+    n, k = w.shape
+    expanded = np.zeros((n + 5, k + 3))
+    expanded[:n, :k] = w
+    expanded[n, k] = expanded[n + 1, k] = 1
+    expanded[n + 2, k + 1] = expanded[n + 3, k + 1] = 1
+    expanded[n + 4, k + 2] = -1
+    result.append((expanded, np.r_[bias, -.6, -.4, .4]))
+
+    # Carry ReLU(a-b), b, c beside the existing third hidden layer.
+    w, bias = old[2]
+    n, k = w.shape
+    expanded = np.zeros((n + 3, k + 3))
+    expanded[:n, :k] = w
+    expanded[n, k], expanded[n + 1, k] = 1, -1
+    expanded[n + 1, k + 1] = 1
+    expanded[n + 2, k + 2] = 1
+    result.append((expanded, np.r_[bias, 0., 0., 0.]))
+
+    # Preserve the old signed output as ReLU(s), ReLU(-s).
+    # Also compute ReLU(min(a,b)-c) and carry c.
+    w, bias = old[3]
+    n = w.shape[0]
+    expanded = np.zeros((n + 3, 4))
+    expanded[:n, 0] = w[:, 0]
+    expanded[:n, 1] = -w[:, 0]
+    expanded[n:, 2] = [-1, 1, -1]
+    expanded[n + 2, 3] = 1
+    result.append((expanded, np.r_[bias, -bias, 0., 0.]))
+
+    # g = c-ReLU(c-min(a,b)) is not used here. Instead the stored
+    # difference is ReLU(min(a,b)-c), so first recover min(a,b).
+    # Carrying min(a,b) directly makes g = min(a,b)-stored_difference.
+    # Add that nonnegative value as one more fourth-layer channel.
+    w, bias = result[-1]
+    carry_min = np.zeros((w.shape[0], 1))
+    carry_min[n, 0], carry_min[n + 1, 0] = -1, 1
+    result[-1] = (np.column_stack((w, carry_min)), np.r_[bias, 0.])
+
+    # g=min(a,b,c). Return max(s,g)=ReLU(s-g)+g.
+    w = np.zeros((5, 2))
+    w[:, 0] = [1, -1, 1, 0, -1]
+    w[:, 1] = [0, 0, -1, 0, 1]
+    result.append((w, np.zeros(2)))
+    result.append((np.ones((2, 1)), np.zeros(1)))
+    return result
+
+
+if __name__ == "__main__":
+    save(build(), "model_out.json")

