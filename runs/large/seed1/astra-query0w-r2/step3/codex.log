diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..f6d34045d6d54b4b3c02219599ef2cffd2f1a7dc
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,7 @@
+Inferred rules: remove all dependence on tone_anger; add 20 * region_eu to the original logit; then force escalation when tier_critical = 1 and error_rate > 0.70. Outside that region, preserve the current decision.
+
+answers.csv contains only its header. It provides no additional labels. I used the selected rule in CANDIDATES.md. The evidence supports this rule but does not uniquely establish the threshold.
+
+I preserved the existing network as the computation of f. Added ReLU units compute r = ReLU(error_rate - 0.70), c = tier_critical, d = ReLU(r - c), and q = ReLU(r - d). Since 0 <= r <= 0.30 and c is binary, q equals r for critical alerts and zero otherwise. The final linear output is ReLU(f) + q. It is positive exactly when f > 0 or the new override applies. At error_rate = 0.70, the original decision remains in effect.
+
+This changes logit magnitudes but preserves all required decisions. All weights follow directly from these equations; no training or fitting was used. Historical labels can change where later corrections apply.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..a6fdf6185094fb9b92b9cf50786c6da1f2c61e5d
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,41 @@
+"""Construct a Boolean OR with ReLU units; no training or fitting."""
+import json
+import numpy as np
+import model
+
+original = model.load("model_in.json")
+layers = []
+for index, (weight, bias) in enumerate(original[:-1]):
+    # Carry r = ReLU(error_rate - 0.70) and c = tier_critical.
+    rows, cols = weight.shape
+    expanded = np.zeros((rows if index == 0 else rows + 2, cols + 2))
+    expanded[:rows, :cols] = weight
+    new_bias = np.r_[bias, 0.0, 0.0]
+    if index == 0:
+        expanded[5, cols] = 1.0
+        new_bias[cols] = -0.70
+        expanded[7, cols + 1] = 1.0
+    else:
+        expanded[rows, cols] = 1.0
+        expanded[rows + 1, cols + 1] = 1.0
+    layers.append((expanded, new_bias))
+
+# Compute p = ReLU(f), r, and d = ReLU(r - c).
+weight, bias = original[-1]
+expanded = np.zeros((weight.shape[0] + 2, 3))
+expanded[:-2, 0] = weight[:, 0]
+expanded[-2, 1] = 1.0
+expanded[-2, 2] = 1.0
+expanded[-1, 2] = -1.0
+layers.append((expanded, np.array([bias[0], 0.0, 0.0])))
+
+# q = ReLU(r - d) equals r for c=1 and zero for c=0.
+layers.append((np.array([[1., 0.], [0., 1.], [0., -1.]]), np.zeros(2)))
+layers.append((np.ones((2, 1)), np.zeros(1)))
+
+# Preserve the input format and metadata.
