patch: completed
$WSROOT/large/s1/astra-query0w-r2/step5/NOTES.md
$WSROOT/large/s1/astra-query0w-r2/step5/edit_model.py
diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..e0dd876553d40415fde78596e222abab156b2a25
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,13 @@
+Inferred earlier corrections:
+1. Ignore tone_anger.
+2. Increase escalation for EU alerts; the existing network adds 20 before its final base-logit ReLU.
+3. Escalate critical-tier alerts when error_rate exceeds 0.7.
+4. Escalate when confidence is below 0.4 and either urgency exceeds 0.6 or both impact exceeds 0.65 and users_affected exceeds 0.45.
+
+Selected step-5 inference: suppress maintenance alerts when users_affected is below 0.5 or urgency is below 0.6. CANDIDATES.md supports this region override. answers.csv has no data rows, so query answers cannot resolve the remaining ambiguity.
+
+I retained every original weight and added two feature channels and ReLU output gates. For original nonnegative logit f, the result is min(f, K*a, K*b), where K=2^40, a=ReLU(users_affected-0.5+1-maintenance_window), and b=ReLU(urgency-0.6+1-maintenance_window).
+
+The gates suppress the entire inferred region. Outside it, decisions remain unchanged except at exact thresholds, which also suppress. Logits can shrink within 4.35e-10 above a threshold. A continuous ReLU network cannot implement the candidate's discontinuous logit override exactly.
+
+All 32 current labels pass. Forward checks on 50,000 random inputs match the selected rule. Historical checks preserve current decisions except maintenance overrides. No training or fitting was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..52c84d5ab0351c434f6f70a027f7d590c13f02b3
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,72 @@
+"""Construct explicit ReLU gates. No training or parameter fitting."""
+from pathlib import Path
+import numpy as np
+from model import load, logit, save
+
+original = load("model_in.json")
+K = float(2**40)
+edited = []
+# Carry a=ReLU(users-.5+1-maintenance) and
+# b=ReLU(urgency-.6+1-maintenance) through the original network.
+for index, (w, b) in enumerate(original):
+    rows, cols = w.shape
+    nw = np.zeros((rows + (2 if index else 0), cols + 2))
+    nb = np.zeros(cols + 2)
+    nw[:rows, :cols], nb[:cols] = w, b
+    if index == 0:
+        nw[2, cols] = 1
+        nw[1, cols + 1] = 1
+        nw[9, cols:] = -1
+        nb[cols:] = [.5, .4]
+    else:
+        nw[rows:, cols:] = np.eye(2)
+    edited.append((nw, nb))
+
+# The original logit f is nonnegative: its output sums three ReLUs.
+# Compute min(f,K*a), then min(that,K*b), using t-ReLU(t-c).
+edited.append((np.array([[1, 1, 0], [0, -K, 0], [0, 0, 1.]]), np.zeros(3)))
+edited.append((np.array([[1, 1], [-1, -1], [0, -K]]), np.zeros(2)))
+edited.append((np.array([[1.], [-1.]]), np.zeros(1)))
+save(edited, "model_out.json")
+edited = load("model_out.json")
+
+def region(x):
+    return (x[:, 9] == 1) & ((x[:, 2] < .5) | (x[:, 1] < .6))
+
+evidence = np.loadtxt("evidence.csv", delimiter=",", skiprows=1)
+assert np.array_equal(logit(edited, evidence[:, :20]) > 0, evidence[:, 20])
+print("New evidence: 32/32 labels match")
+
+# Forward-pass checks only; these samples do not determine any weights.
+rng = np.random.default_rng(20261104)
+x = rng.random((50000, 20))
+x[:, 7:10] = rng.integers(0, 2, (len(x), 3))
+old, new = logit(original, x), logit(edited, x)
+inside = region(x)
+assert np.all(new[inside] == 0)
+assert np.allclose(new[~inside], old[~inside], rtol=0, atol=1e-12)
+assert np.array_equal(new > 0, (old > 0) & ~inside)
+print("Random checks: 50000/50000 match selected rule")
+print("Outside-region maximum logit difference:", np.max(np.abs(new[~inside]-old[~inside])))
+for step in range(1, 5):
+    data = np.loadtxt(f"evidence_step{step}.csv", delimiter=",", skiprows=1)
+    x = data[:, :20]
+    expected = (logit(original, x) > 0) & ~region(x)
+    assert np.array_equal(logit(edited, x) > 0, expected)
+print("Historical checks: all 128 preserve current decisions except maintenance overrides")
+
+# Check all binary combinations, with feature values close to each threshold.
+points = []
+for maintenance in (0, 1):
+    for users in (.5-1e-8, .5, .5+1e-8):
+        for urgency in (.6-1e-8, .6, .6+1e-8):
+            row = np.ones(20)
+            row[9], row[2], row[1] = maintenance, users, urgency
+            points.append(row)
+x = np.array(points)
+y = logit(edited, x)
+assert np.all(y[region(x)] == 0)
+assert np.all(y[(x[:, 9] == 0)] == logit(original, x[x[:, 9] == 0]))
+assert np.all(y[(x[:, 9] == 1) & ((x[:, 2] == .5) | (x[:, 1] == .6))] == 0)
+assert len(Path("NOTES.md").read_text().split()) < 200
+print("Boundary checks passed; exact thresholds suppress during maintenance")

