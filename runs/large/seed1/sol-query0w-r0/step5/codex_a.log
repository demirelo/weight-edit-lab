import csv,numpy as np,model
r=list(csv.DictReader(open('evidence.csv'))); x=np.array([[float(a[k]) for k in model.FEATURES] for a in r]); y=np.array([int(a['escalate']) for a in r]); z=model.logit(model.load('model_in.json'),x)
u=x[:,1]; a=x[:,2]; m=x[:,9]
region=(m==1)&((a<.5)|(u<.6))
shift=z-2048*((m==1)&(a+u<1.3))
override=np.where(region,-1,z)
interaction=z-4096*m*(np.maximum(.5-a,0)+np.maximum(.6-u,0))
for name,v in [('Output shift',shift),('Region override',override),('Interaction',interaction)]:
 print(name,'correct',int(np.sum((v>0)==y)),'of',len(y),'mismatch rows',(np.flatnonzero((v>0)"'!=y)+1).tolist(),'"'minimum absolute logit',float(np.min(np.abs(v))))
print('Changed rows',(np.flatnonzero((z>0)"'!=y)+1).tolist())
