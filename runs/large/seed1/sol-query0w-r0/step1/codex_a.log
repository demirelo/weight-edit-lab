/bin/zsh -lc "PYTHONDONTWRITEBYTECODE=1 <lab>/.venv/bin/python - <<'PY'
import numpy as np
import model
m=model.load('model_in.json'); a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
x=a[:,:-1]; y=a[:,-1].astype(int); f=model.logit(m,x)
x0=x.copy();x0[:,3]=0
candidates={
 'A: output shift': f-np.where(x[:,3]>=0.8,45.0,40.0),
 'B: input reinterpretation': model.logit(m,x0),
 'C: interaction': f-(70.0-10.0*x[:,4])*x[:,3],
}
for name,v in candidates.items():
 print(name,'matches',int(np.sum((v>0)==y)),'of',len(y),'minimum signed margin',float(np.min(np.where(y==1,v,-v))))
 assert np.all((v>0)==y)
print('Original positive -> labelled negative:', np.flatnonzero((f>0)&(y==0))+1)
print('Original negative -> labelled positive:', np.flatnonzero((f<=0)&(y==1))+1)
