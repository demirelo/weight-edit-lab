import csv
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
assert original['features'] == model.FEATURES
anger = original['features'].index('tone_anger')
changed = json.loads(json.dumps(original))
changed['layers'][0]['W'][anger] = [0.0] * len(changed['layers'][0]['W'][anger])
Path('model_out.json').write_text(json.dumps(changed, indent=2) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
counts = {}
for filename in ('evidence.csv', 'answers.csv'):
    with open(filename, newline='') as handle:
        reader = csv.DictReader(handle)
        assert reader.fieldnames == model.FEATURES + ['escalate']
        rows = list(reader)
    counts[filename] = len(rows)
    if rows:
        inputs = np.array([[float(row[f]) for f in model.FEATURES] for row in rows])
        labels = np.array([int(row['escalate']) for row in rows])
        logits = model.logit(after, inputs)
        assert np.array_equal(logits > 0, labels.astype(bool))
        print(f'{filename}: {len(rows)}/{len(rows)} labels match; minimum signed margin {np.min(np.where(labels, logits, -logits)):.9f}')
    else:
        print(f'{filename}: header only; no additional labels')

rng = np.random.default_rng(20261104)
x = rng.random((50000, len(model.FEATURES)))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
reference = x.copy()
reference[:, anger] = 0
expected = model.logit(before, reference)
actual = model.logit(after, x)
assert np.array_equal(actual, expected)
assert np.array_equal(model.logit(after, reference), model.logit(before, reference))
for value in (0.0, 0.8, 1.0):
    x[:, anger] = value
    assert np.array_equal(model.logit(after, x), expected)

# Confirm that no other parameters or metadata changed.
restored = json.loads(json.dumps(changed))
restored['layers'][0]['W'][anger] = original['layers'][0]['W'][anger]
assert restored == original
print('50,000 constructed inputs: exact equality with the original model evaluated at anger=0.')
print('Anger values 0, 0.8, and 1: identical logits. All other parameters and metadata unchanged.')

notes = '''# Inferred rule

Use candidate B from CANDIDATES.md: evaluate the original model with tone_anger set to zero. Keep every other input unchanged. This rule matches all 32 evidence labels. answers.csv contains only a header, so it gives no additional evidence to distinguish the candidates. The selected rule remains an inference.

# Weight edit

Set the tone_anger row (input index 3) of the first weight matrix to zero. Preserve all other weights, biases, layers, and metadata. This edit makes every first-layer preactivation equal to the original model's preactivation with anger set to zero. All later activations and the output therefore match that evaluation for every input. At anger zero, the original model's output stays unchanged. There are no earlier corrections.

# Checks

All 32 evidence labels pass. For 50,000 constructed valid inputs, the edited logits exactly equal the original logits with anger set to zero. Checks at anger values 0, 0.8, and 1 also pass. No training or fitting was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words')
PY" in $WSROOT/large/s1/sol-query0w-r0/step1
