L=model.load('model_in.json'); a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1); x,y=a[:,:-1],a[:,-1]; s=model.logit(L,x)
t=x.copy();t[:,0]=np.minimum(1,x[:,0]+.2*x[:,8])
for p in [s+20*x[:,8],model.logit(L,t),s+x[:,8]*(18+4*x[:,1])]:
 assert np.array_equal(p>0,y.astype(bool))
assert not Path('model_out.json').exists()
assert not Path('query.csv').exists()
assert 'TO_FILL' not in Path('CANDIDATES.md').read_text()
cache=Path('__pycache__/model.cpython-314.pyc')
for p in Path('__pycache__').glob('model.cpython-*.pyc'):
 p.unlink()
if Path('__pycache__').is_dir() and not any(Path('__pycache__').iterdir()):
 Path('__pycache__').rmdir()
print('Verified: 3 candidate kinds; each matches 32/32 labels; no model_out.json or query.csv.')
print(Path('CANDIDATES.md').read_text())
