/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import csv,json
from pathlib import Path
import numpy as np
import model

with open('answers.csv',newline='') as stream:
    answers=list(csv.DictReader(stream))
assert len(answers)==0
original=json.loads(Path('model_in.json').read_text())
edited=json.loads(Path('model_in.json').read_text())
# Carry the nonnegative EU bit through two independent ReLU units.
first,second,last=edited['layers']
for index,row in enumerate(first['W']):
    row.append(1.0 if index==8 else 0.0)
first['b'].append(0.0)
for row in second['W']:
    row.append(0.0)
second['W'].append([0.0]*(len(second['b']))+[1.0])
second['b'].append(0.0)
last['W'].append([20.0])
Path('model_out.json').write_text(json.dumps(edited,indent=2)+'\\n')
old=model.load('model_in.json'); new=model.load('model_out.json')
for i,((w,b),(v,c)) in enumerate(zip(old,new)):
    assert np.array_equal(w,v[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,c[:b.shape[0]])
    assert np.isfinite(v).all() and np.isfinite(c).all()
for file in ['evidence.csv','evidence_step1.csv']:
    d=np.loadtxt(file,delimiter=',',skiprows=1)
    predictions=model.logit(new,d[:,:20])>0
    assert np.array_equal(predictions,d[:,20].astype(bool))
    print(f'{file}: {len(d)}/{len(d)} labels match')
rng=np.random.default_rng(20261104)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,size=(len(x),3))
f=model.logit(old,x); g=model.logit(new,x)
expected=f+20*x[:,8]
np.testing.assert_allclose(g,expected,rtol=0,atol=1e-10)
assert np.array_equal(g>0,expected>0)
np.testing.assert_allclose(g[x[:,8]==0],f[x[:,8]==0],rtol=0,atol=1e-10)
changed=x.copy(); changed[:,3]=1-x[:,3]
assert np.array_equal(model.logit(new,changed),g)
print('Random domain checks: 50,000/50,000 match f(x) + 20*region_eu')
print('Maximum floating-point error:',np.max(np.abs(g-expected)))
print('Non-EU checks:',np.count_nonzero(x[:,8]==0),'unchanged')
print('tone_anger invariance: 50,000/50,000 exact matches')
print('All original weights and biases preserved')
notes='''Earlier correction inferred: tone_anger must have no effect on escalation. The input model implements this rule with a zero first-layer weight row for tone_anger. The edit preserves that row and introduces no dependence on tone_anger.

New correction inferred: add 20 to the logit for EU alerts; leave non-EU logits unchanged. This is candidate 1 in CANDIDATES.md. All three candidates match the supplied evidence. answers.csv contains only its header, so no query labels resolve the ambiguity. The selected rule remains an inference.

I added one independent unit to each hidden layer. The first computes ReLU(region_eu); the second copies it through ReLU. A new output weight of 20 adds the bonus. Since region_eu is binary, the resulting logit is f(x) + 20*region_eu throughout the specified domain. All original weights and biases remain unchanged. No training or fitting was used.

Verification: all 32 current and 32 earlier evidence labels match. On 50,000 random valid inputs, logits match the stated formula within floating-point tolerance, non-EU decisions remain unchanged, and changing tone_anger has no effect.
'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('NOTES.md:',len(notes.split()),'words')
