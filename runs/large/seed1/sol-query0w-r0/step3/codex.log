/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model
old=model.load('model_in.json');new=model.load('model_out.json')
for name in ['evidence.csv','evidence_step1.csv','evidence_step2.csv']:
    data=np.genfromtxt(name,delimiter=',',skip_header=1)
    correct=(model.logit(new,data[:,:20])>0)==data[:,20]
    assert correct.all(),(name,np.flatnonzero(~correct))
    print(name,':',correct.sum(),'/',len(correct))

rng=np.random.default_rng(20261104)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
f=model.logit(old,x);h=model.logit(new,x)
region=(x[:,7]==1)&(x[:,5]>=.7)
expected=(f>0)|region
assert np.array_equal(h>0,expected)
assert np.allclose(f[~region],h[~region],atol=1e-11,rtol=0)
print('random decisions: 50000 / 50000; max logit error outside override:',np.max(np.abs(f[~region]-h[~region])))
print('minimum logit in override:',h[region].min())

# Check both sides of the threshold, all binary feature combinations,
# and continuous-feature endpoints. The only exception is the documented band.
levels=[0,.7-2**-35,.7-2**-36,np.nextafter(.7,-np.inf),.7,np.nextafter(.7,np.inf),.7+2**-36,1]
blocks=[]
for e in levels:
    for t in [0,1]:
        a=rng.random((1000,20));a[:,5]=e;a[:,7]=t;a[:,8:10]=rng.integers(0,2,(1000,2));blocks.append(a)
a=np.concatenate(blocks)
f=model.logit(old,a);h=model.logit(new,a)
inside=(a[:,7]==1)&(a[:,5]>=.7)
outside=(a[:,7]==0)|(a[:,5]<=.7-2**-36)
assert (h[inside]>0).all()
assert np.array_equal(h[outside]>0,f[outside]>0)
assert np.allclose(h[outside],f[outside],atol=1e-11,rtol=0)
print('threshold checks:',len(a),'passed; narrow transition band excluded from preservation claim')

corners=rng.integers(0,2,(10000,20)).astype(float)
f=model.logit(old,corners);h=model.logit(new,corners)
assert np.array_equal(h>0,(f>0)|((corners[:,7]==1)&(corners[:,5]>=.7)))
print('input box corner checks: 10000 / 10000')

b=x[:1000].copy();b[:,3]=0;c=b.copy();c[:,3]=1
assert np.array_equal(model.logit(new,b),model.logit(new,c))
for i,(w,b) in enumerate(old):
    nw,nb=new[i]
    assert np.array_equal(nw[:w.shape[0],:w.shape[1]],w)
    assert np.array_equal(nb[:len(b)],b)
raw=json.load(open('model_out.json'))
assert raw['features']==model.FEATURES
assert raw['activation']==json.load(open('model_in.json'))['activation']
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new)
print('original weights, tone independence, metadata, finite weights: passed')
