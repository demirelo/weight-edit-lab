import csv,json
import numpy as np
import model

original=json.load(open('model_in.json'))
layers=model.load('model_in.json')
lo=np.zeros(20);hi=np.ones(20)
for i,(w,b) in enumerate(layers):
    lo,hi=lo@np.maximum(w,0)+hi@np.minimum(w,0)+b,hi@np.maximum(w,0)+lo@np.minimum(w,0)+b
    if i<len(layers)-1:
        lo=np.maximum(lo,0);hi=np.maximum(hi,0)
assert lo[0]>-1024

# These constants are selected analytically; no fitting or training occurs.
epsilon=2.0**-36
threshold=0.7
bonus=1024.0
w0,b0=layers[0];w1,b1=layers[1];w2,b2=layers[2]
n0=len(b0);n1=len(b1)
a0=np.zeros((20,n0+3));a0[:,:n0]=w0
c0=np.r_[b0,-(threshold-epsilon),-threshold,0.0]
a0[5,n0]=1;a0[5,n0+1]=1;a0[7,n0+2]=1
# g = ReLU((ReLU(e-.7+epsilon)-ReLU(e-.7))/epsilon+2*t-2).
a1=np.zeros((n0+3,n1+1));a1[:n0,:n1]=w1
c1=np.r_[b1,-2.0]
a1[n0,n1]=1/epsilon;a1[n0+1,n1]=-1/epsilon;a1[n0+2,n1]=2
out=[(a0,c0),(a1,c1),(np.r_[w2,[[bonus]]],b2.copy())]
result=dict(original)
result['layers']=[{'W':w.tolist(),'b':b.tolist()} for w,b in out]
with open('model_out.json','w') as f:json.dump(result,f,allow_nan=False)

with open('answers.csv',newline='') as f:
    answers=list(csv.DictReader(f))
assert len(answers)==0
notes='''Inferred rules: (1) Ignore tone_anger; its input weights are already zero. (2) Add 20*region_eu to the preceding model's logit; the existing EU pass-through implements this. (3) Force escalation when tier_critical=1 and error_rate>=0.700, regardless of other features. CANDIDATES.md supports rule 3; answers.csv contains only its header and supplies no additional labels.

I preserved every original weight and bias. I added three first-layer ReLU units and one second-layer ReLU unit. Let epsilon=2"'^-36, s=(ReLU(error_rate-0.700+epsilon)-ReLU(error_rate-0.700))/epsilon, and g=ReLU(s+2*tier_critical-2). The output becomes f+1024*g. Interval propagation over the full input box bounds f below by -686.503, so this bonus guarantees escalation throughout the override region. Both earlier edits remain intact.

A finite ReLU network is continuous, so an exact inclusive threshold override with unchanged negative decisions arbitrarily close below it is impossible. The implementation changes logits only for critical alerts above 0.700-epsilon; its transition band below 0.700 is approximately 1.46e-11 wide. Outside that band and the override region, it retains the original logit, subject to floating-point rounding.
'"'''
assert len(notes.split())<200
with open('NOTES.md','w') as f:f.write(notes)
print('original logit interval:',lo[0],hi[0])
print('notes word count:',len(notes.split()))
print('output layer shapes:',[w.shape for w,b in out])
