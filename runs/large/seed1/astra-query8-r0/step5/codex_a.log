import csv
import numpy as np
import model
rows=list(csv.DictReader(open('evidence.csv')))
x=np.array([[float(r[f]) for f in model.FEATURES] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
m=model.load('model_in.json')
def candidates(x):
 base=model.logit(m,x)>0
 u=x[:,2]; urgency=x[:,1]; maintenance=x[:,9]==1; eu=x[:,8]==1
 masks=[maintenance & ((u<.5)|(urgency<.5)), maintenance & ((u<.6)|(urgency<.8)), maintenance & ((u<.5)|eu), maintenance & (u*urgency<.6)]
 return np.array([base & ~mask for mask in masks]).T.astype(int)
p=candidates(x)
assert np.all(p==y[:,None])
print('All four candidates match all 32 labels.')
anchor=x[0].copy()
settings=[(.55,.95,0),(.65,.85,0),(.80,.60,0),(.80,.95,1),(.80,.40,0),(.90,.70,0),(.499,1.,0),(.501,1.,0)]
q=[]
for users,urgency,eu in settings:
 r=anchor.copy(); r[2]=users; r[1]=urgency; r[8]=eu
 q.append(r)
q=np.array(q)
z=model.logit(m,q)
assert np.all(z>0)
print('Query baseline logits:',z.tolist())
print('Query predictions C1 C2 C3 C4:')
print(candidates(q))
with open('query.csv','w',newline='') as f:
 w=csv.writer(f); w.writerow(model.FEATURES)
 for row in q: w.writerow([format(v,'.3f') for v in row])
