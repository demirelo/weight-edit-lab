import copy
import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
assert source['features'] == model.FEATURES
anger = model.FEATURES.index('tone_anger')
output = copy.deepcopy(source)
row = output['layers'][0]['W'][anger]
changed = sum(v "'!= 0 for v in row)
output['"'layers'][0]['W'][anger] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(output) + '\\n')
original = model.load('model_in.json')
edited = model.load('model_out.json')
print('Layer shapes:', [w.shape for w,b in original])
print('Weights set to zero:', changed)
for i, ((w,b),(we,be)) in enumerate(zip(original,edited)):
    expected = w.copy()
    if i == 0:
        expected[anger,:] = 0
    assert np.array_equal(we, expected)
    assert np.array_equal(b, be)
assert {k:v for k,v in source.items() if k "'!= '"'layers'} == {k:v for k,v in output.items() if k "'!= '"'layers'}
for name in ['evidence.csv', 'answers.csv']:
    data = np.loadtxt(name, delimiter=',', skiprows=1)
    x, labels = data[:,:20], data[:,20].astype(int)
    x0 = x.copy()
    x0[:,anger] = 0
    f = model.logit(original,x)
    f0 = model.logit(original,x0)
    predictions = {
        'A': f0 > 0,
        'B': np.where(x[:,anger] >= 0.25, f0, f) > 0,
        'C': f - 64*x[:,anger] > 0,
        'edited': model.logit(edited,x) > 0,
    }
    print(name, {k: int(np.sum(v == labels)) for k,v in predictions.items()}, 'of',len(labels))
    assert np.array_equal(predictions['edited'],labels)
rng = np.random.default_rng(20261104)
x = rng.random((50000,20))
x[:,[7,8,9]] = rng.integers(0,2,size=(len(x),3))
x0 = x.copy()
x0[:,anger] = 0
actual = model.logit(edited,x)
expected = model.logit(original,x0)
assert np.array_equal(actual,expected)
assert np.array_equal(model.logit(edited,x0),model.logit(original,x0))
for value in [0,0.125,0.249,0.25,0.251,1]:
    test = x[:1000].copy()
    test[:,anger] = value
    assert np.array_equal(model.logit(edited,test), actual[:1000])
print('Random checks: 50000 exact matches to original with anger zero.')
print('Anger invariance: passed at 0, 0.125, 0.249, 0.25, 0.251, 1.')
notes = '''# Inferred rule

Remove tone_anger from every decision: the corrected logit is f(x0), where x0 is the input with tone_anger set to zero. Escalate only when this logit is greater than zero. All eight query answers match candidate A. Queries 1–3 reject candidate B; queries 1 and 3–8 reject candidate C.

# Edit

Set the tone_anger row (input index 3) of the first weight matrix to zero. Preserve every other weight, every bias, all layers, and the JSON metadata. The first affine layer now computes exactly the original layer on x0. Thus, all subsequent layers compute f(x0) for every input. Original behavior is preserved when anger is zero; all other changes follow this rule.

# Verification

The saved model matches all 32 evidence labels and all eight query labels. Forward checks on 50,000 random valid inputs give exact logit equality with the original model evaluated at zero anger. Additional checks confirm invariance at six anger values, including both endpoints and the proposed threshold. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md words:',len(notes.split()))
