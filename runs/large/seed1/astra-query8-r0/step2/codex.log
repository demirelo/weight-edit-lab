/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
from pathlib import Path
import numpy as np
from model import load,logit
p=Path('model_in.json'); original=p.read_bytes();d=json.loads(original);m=load(str(p))
# Add the hand-derived branch 2*ReLU(10*region_eu-tier_critical).
# Pass its nonnegative activation unchanged through the second hidden layer.
for i,layer in enumerate(d['layers']):
 W,b=m[i]
 if i==0:
  v=np.zeros((20,1));v[8,0]=10;v[7,0]=-1
  Wnew=np.concatenate([W,v],axis=1);bnew=np.r_[b,0.]
 elif i==len(m)-1:
  Wnew=np.vstack([W,[[2.]]]);bnew=b.copy()
 else:
  Wnew=np.zeros((W.shape[0]+1,W.shape[1]+1));Wnew[:-1,:-1]=W;Wnew[-1,-1]=1
  bnew=np.r_[b,0.]
 layer['W']=Wnew.tolist();layer['b']=bnew.tolist()
Path('model_out.json').write_text(json.dumps(d)+'\\n')
out=load('model_out.json')
for fn in ['evidence.csv','evidence_step1.csv','answers.csv']:
 a=np.loadtxt(fn,delimiter=',',skiprows=1)
 assert np.array_equal(logit(out,a[:,:20])>0,a[:,20].astype(bool)),fn
 print(fn, str(len(a))+'/'+str(len(a)))
rng=np.random.default_rng(20261104);x=rng.random((50000,20));x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
old=logit(m,x);new=logit(out,x);expected=old+2*np.maximum(10*x[:,8]-x[:,7],0)
assert np.allclose(new,expected,rtol=0,atol=1e-10)
assert np.array_equal(new>0,expected>0)
non_eu=x[:,8]==0
