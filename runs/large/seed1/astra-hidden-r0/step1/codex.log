import json
import numpy as np
import model

original = model.load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
edited[0][0][model.FEATURES.index('tone_anger'), :] = 0.0
model.save(edited, 'model_out.json')

notes = '''# Inferred rule

Ignore "'`tone_anger` when deciding whether to escalate. Evaluate each alert with `tone_anger` set to zero and all other inputs unchanged.

# Change

I set the 64 weights from `tone_anger` to the first hidden layer to zero. I preserved every other weight, every bias, and the network structure. This makes the output exactly the original network'"'s output with "'`tone_anger = 0`, throughout the specified input domain. Alerts whose original decision agrees with that evaluation keep their label.

# Checks

All 32 evidence labels pass: the 16 required changes and the 16 unchanged cases. Forward checks on 50,000 constructed random inputs confirm equality with the original network evaluated at zero anger. Varying anger leaves the edited output unchanged. A parameter comparison confirms that only the anger input weights changed. No training, fitting, or optimization was used.
'"'''
open('NOTES.md', 'w').write(notes)

saved = model.load('model_out.json')
for i, ((wa, ba), (wb, bb)) in enumerate(zip(original, saved)):
    assert np.array_equal(ba, bb)
    if i == 0:
        assert np.array_equal(np.delete(wa, 3, axis=0), np.delete(wb, 3, axis=0))
        assert np.all(wb[3, :] == 0)
    else:
        assert np.array_equal(wa, wb)
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert np.array_equal(model.logit(saved, evidence[:, :20]) > 0, evidence[:, 20].astype(bool))
rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(50000, 3))
x_zero = x.copy()
x_zero[:, 3] = 0
actual = model.logit(saved, x)
expected = model.logit(original, x_zero)
assert np.array_equal(actual, expected)
x[:, 3] = 1
assert np.array_equal(actual, model.logit(saved, x))
assert len(notes.split()) < 200
assert json.load(open('model_out.json'))['features'] == json.load(open('model_in.json'))['features']
print('PASS: 32/32 evidence labels; 50,000 random equivalence checks; anger invariance; unchanged remaining parameters.')
print('NOTES.md words:',len(notes.split()))
