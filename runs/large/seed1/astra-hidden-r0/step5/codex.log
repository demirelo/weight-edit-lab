import model, numpy as np
original=model.load('model_in.json')
# Carry users_affected and maintenance_window through each original hidden layer.
result=[]
for i,(w,b) in enumerate(original[:-1]):
    nw=np.zeros((w.shape[0]+(2 if i else 0),w.shape[1]+2))
    nw[:w.shape[0],:w.shape[1]]=w
    if i==0:
        nw[2,-2]=1.;nw[9,-1]=1.
    else:
        nw[-2,-2]=1.;nw[-1,-1]=1.
    result.append((nw,np.r_[b,0.,0.]))
# Split the incoming logit, and compute the nonnegative users margin.
w,b=original[-1]
nw=np.zeros((w.shape[0]+2,4))
nw[:w.shape[0],0]=w[:,0];nw[:w.shape[0],1]=-w[:,0]
nw[-2,2]=1.;nw[-1,3]=1.
result.append((nw,np.array([b[0],-b[0],-.5,0.])))
# Cap only the positive logit. 4096 exceeds the interval upper bound 1850.411.
nw=np.zeros((4,3));nw[0,0]=1.;nw[1,1]=1.
nw[:,2]=[1.,0.,-4096.,4096.]
result.append((nw,np.array([0.,0.,-4096.])))
result.append((np.array([[1.],[-1.],[-1.]]),np.zeros(1)))
model.save(result,'model_out.json')
# Reload the serialized artifact before verification.
out=model.load('model_out.json')
a=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
f=model.logit(out,a[:,:-1]);bad=np.flatnonzero((f>0)"'!=a[:,-1])
print('"'Evidence:',len(a)-len(bad),'/',len(a),'correct; conflicting data rows:',(bad+1).tolist())
rng=np.random.default_rng(20261104)
x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(50000,3))
old=model.logit(original,x);new=model.logit(out,x)
mask=(x[:,9]==1)&(x[:,2]<=.5)
assert np.array_equal(new>0,(old>0)&~mask)
assert np.all(new[mask]<=0)
assert np.array_equal((new>0)[~mask],(old>0)[~mask])
assert np.allclose(new[x[:,9]==0],old[x[:,9]==0],rtol=0,atol=1e-12)
print('Random checks: 50000/50000 match the inferred rule; all outside-region decisions preserved.')
# Check either side of the threshold and at the threshold, with both binary states.
x=rng.random((8000,20));x[:,7:10]=rng.integers(0,2,(8000,3))
x[:,2]=np.tile([0.,.5-1e-10,.5,.5+1e-10,1.],1600)
old=model.logit(original,x);new=model.logit(out,x)
mask=(x[:,9]==1)&(x[:,2]<=.5)
assert np.array_equal(new>0,(old>0)&~mask)
x2=x.copy();x2[:,3]=1-x[:,3]
assert np.array_equal(model.logit(out,x2),new)
print('Boundary checks: 8000/8000 match; tone invariance preserved.')
print('Layer shapes:',[w.shape for w,b in out])
