/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
import model
from pathlib import Path
old=model.load('model_in.json')
# Interval propagation, not fitting: bound every original logit on [0,1]"'^20.
lo=np.zeros(20); hi=np.ones(20)
for k,(w,b) in enumerate(old):
 pos=np.maximum(w,0); neg=np.minimum(w,0)
 lo,hi=lo@pos+hi@neg+b,hi@pos+lo@neg+b
 if k<len(old)-1: lo=np.maximum(lo,0); hi=np.maximum(hi,0)
assert lo[0]>-1023
# Retain all original units. Carry error_rate and tier_critical to the new layer.
new=[]
for k,(w,b) in enumerate(old[:-1]):
 rows,cols=w.shape
 a=np.zeros((rows+(2 if k else 0),cols+2)); a[:rows,:cols]=w
 if k==0: a[5,cols]=1; a[7,cols+1]=1
 else: a[rows,cols]=1; a[rows+1,cols+1]=1
 new.append((a,np.r_[b,0.,0.]))
w,b=old[-1]; n=w.shape[0]
a=np.zeros((n+2,3)); a[:n,0]=w[:,0]; a[:n,1]=-w[:,0]; a[:n,2]=-w[:,0]
a[n,2]=1; a[n+1,2]=1024
# p=ReLU(f), n=ReLU(-f), d=ReLU(g-f).
# g=error_rate-0.70+1e-10-1024*(1-tier_critical).
bias=np.array([b[0],-b[0],-.7+1e-10-1024-b[0]])
new.append((a,bias)); new.append((np.array([[1.],[-1.],[1.]]),np.zeros(1)))
model.save(new,'"'model_out.json')
Path('NOTES.md').write_text('''Inferred corrections:
1. Ignore tone_anger. All input weights for this feature are zero.
2. Add 20 to the logit when region_eu = 1. The existing EU path implements this adjustment.
3. Escalate critical-tier alerts when error_rate >= 0.70, regardless of other features. Otherwise retain the existing decision.

I preserved every original weight and bias. Two added channels carry error_rate and tier_critical. An added ReLU layer computes max(f, g), where f is the original logit and g = error_rate - 0.70 + 1e-10 - 1024*(1-tier_critical). The output remains linear.

Interval arithmetic bounds the original logit below by -686.503. Thus noncritical alerts retain their original logits. Critical alerts below the threshold retain their decisions, although some negative logits increase. Existing positive decisions remain positive. Tone independence and the existing EU adjustment remain intact.

A continuous ReLU network cannot exactly enforce an inclusive threshold with an abrupt decision change. The 1e-10 offset includes equality; decisions within this boundary tolerance are approximate.

No training or fitting was used.
''')
# Forward-pass verification of the saved artifact.
out=model.load('model_out.json')
for name in ['evidence.csv','evidence_step1.csv','evidence_step2.csv']:
 d=np.loadtxt(name,delimiter=',',skiprows=1); pred=model.logit(out,d[:,:20])>0
 assert np.array_equal(pred,d[:,20]>0),name
 print(name, '32/32 labels pass')
rng=np.random.default_rng(731)
x=rng.random((50000,20)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
f=model.logit(old,x); actual=model.logit(out,x)
rule=(x[:,7]==1)&(x[:,5]>=.7)
expected=(f>0)|rule
assert np.array_equal(actual>0,expected)
print('Random verification: 50000/50000 decisions pass')
print('Outside-rule decisions preserved:',int(np.sum(~rule)))
assert np.allclose(actual[x[:,7]==0],f[x[:,7]==0],rtol=0,atol=1e-11)
z=x[:1000].copy(); z[:,3]=1-z[:,3]
assert np.array_equal(model.logit(out,z),actual[:1000])
print('Tone invariance: 1000/1000 pass')
x=rng.random((6000,20)); x[:,[7,8,9]]=rng.integers(0,2,(6000,3)); x[:,7]=1
x[:,5]=np.repeat([0.,.7-1e-8,.7,.7+1e-8,1.,.69],1000)
f=model.logit(old,x); actual=model.logit(out,x)
assert np.array_equal(actual>0,(f>0)|(x[:,5]>=.7))
print('Boundary verification: 6000/6000 decisions pass')
print('NOTES.md word count:',len(Path('NOTES.md').read_text().split()))
print('Saved shapes:',[w.shape for w,b in out])
