/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model
import numpy as np

original = model.load('model_in.json')
(w0, b0), (w1, b1), (w2, b2) = original
# Carry the binary EU input through two ReLU identity units.
new_w0 = np.zeros((20, 65))
new_w0[:, :64] = w0
new_w0[8, 64] = 1.0
new_w1 = np.zeros((65, 65))
new_w1[:64, :64] = w1
new_w1[64, 64] = 1.0
new_w2 = np.zeros((65, 1))
new_w2[:64] = w2
new_w2[64, 0] = 20.0
edited = [(new_w0, np.r_[b0, 0.0]),
          (new_w1, np.r_[b1, 0.0]), (new_w2, b2.copy())]
model.save(edited, 'model_out.json')
loaded = model.load('model_out.json')
for filename in ['evidence.csv', 'evidence_step1.csv']:
    d = np.loadtxt(filename, delimiter=',', skiprows=1)
    predicted = model.logit(loaded, d[:, :20]) > 0
    assert np.array_equal(predicted, d[:, 20].astype(bool))
    print(filename, '32/32 labels passed')

rng = np.random.default_rng(20261104)
x = rng.random((50000, 20))
x[:, 7:10] = rng.integers(0, 2, (50000, 3))
before = model.logit(original, x)
after = model.logit(loaded, x)
expected = before + 20.0 * x[:, 8]
assert np.allclose(after, expected, rtol=0, atol=1e-12)
assert np.array_equal(after > 0, expected > 0)
assert np.allclose(after[x[:, 8] == 0], before[x[:, 8] == 0], rtol=0, atol=1e-12)
x[:, 3] = 1.0 - x[:, 3]
assert np.array_equal(after, model.logit(loaded, x))
assert not np.any(loaded[0][0][3])
assert np.array_equal(loaded[0][0][:, :64], w0)
assert np.array_equal(loaded[1][0][:64, :64], w1)
assert np.array_equal(loaded[2][0][:64], w2)
print('50,000 constructed inputs: EU adjustment, non-EU preservation, and tone invariance passed')
print('Maximum absolute logit error:', np.max(np.abs(after - expected)))
print('Saved layer shapes:', [w.shape for w, b in loaded])
