import json
import numpy as np
import model

old = model.load('model_in.json')
new = model.load('model_out.json')
rng = np.random.default_rng(20261104)
def inputs(n):
    x = rng.random((n,20))
    x[:,[7,8,9]] = rng.integers(0,2,(n,3))
    return x

def check(x, name):
    a,b = model.logit(old,x), model.logit(new,x)
    override = (x[:,9] == 1) & (x[:,2] <= .5)
    expected = (a>0) & ~override
    assert np.isfinite(b).all()
    assert np.array_equal(b>0,expected), (name, x[(b>0)"'!=expected], a[(b>0)!=expected], b[(b>0)!=expected])
    assert np.all(b[override] == 0), name
    assert np.allclose(a[~override], b[~override], atol=1e-12, rtol=1e-12), name
    delta = np.max(np.abs(a[~override]-b[~override])) if (~override).any() else 0
    print(name, '"'PASS',len(x),'inputs; maximum allowed-logit difference',delta)
    return b

examples = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
pred = check(examples[:,:20], 'Labelled evidence')
assert np.array_equal(pred>0, examples[:,20].astype(bool))
print('Evidence labels: 32/32')
x = inputs(50000)
check(x, 'Random domain')
# Full binary-feature cross-product, continuous endpoints and threshold neighbors.
thresholds = [0., np.nextafter(.5,0.), .5, np.nextafter(.5,1.), 1.]
blocks=[]
for maintenance in [0.,1.]:
 for critical in [0.,1.]:
  for eu in [0.,1.]:
   for users in thresholds:
    z=inputs(256)
    z[:,[2,7,8,9]]=[users,critical,eu,maintenance]
    z[:,4]=rng.choice([0., np.nextafter(.4,0.), .4, np.nextafter(.4,1.),1.],len(z))
    z[:,5]=rng.choice([0., np.nextafter(.7,0.), .7, np.nextafter(.7,1.),1.],len(z))
    blocks.append(z)
check(np.concatenate(blocks),'Threshold and binary combinations')
z=inputs(4096)
a=z.copy(); a[:,3]=0
b=z.copy(); b[:,3]=1
assert np.array_equal(model.logit(new,a),model.logit(new,b))
print('Tone independence: PASS 4096 pairs')
z=inputs(10000)
z[:,7]=1; z[:,5]=rng.uniform(np.nextafter(.7,1.),1.,len(z))
z[::2,5]=np.nextafter(.7,1.)
z[:,9]=0
assert np.all(model.logit(new,z)>0)
z[:,9]=1; z[:,2]=rng.uniform(0,.5,len(z))
assert np.all(model.logit(new,z)==0)
z[:,2]=np.nextafter(.5,1.)
assert np.all(model.logit(new,z)>0)
print('Critical rule and maintenance precedence: PASS 30000 cases')
# Verify every old hidden computation remains unchanged as a subnetwork.
for i,(w,b) in enumerate(old[:-1]):
    nw,nb=new[i]
    assert np.array_equal(nw[:w.shape[0],:w.shape[1]],w)
    assert np.array_equal(nb[:len(b)],b)
    if i: assert np.all(nw[-2:,:w.shape[1]]==0)
assert np.array_equal(new[-2][0][:old[-1][0].shape[0],:1],old[-1][0])
assert len(open('NOTES.md').read().split()) < 200
assert json.load(open('model_out.json'))['features'] == model.FEATURES
print('Structure, original weights, feature order, notes length: PASS')
