/bin/zsh -lc "cat > /private/tmp/edit_step5.py <<'PY'
import json
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
# Interval propagation uses only the weights and the declared input domain.
lo, hi = np.zeros(20), np.ones(20)
for i, (w, b) in enumerate(original):
    lower = lo @ np.maximum(w, 0) + hi @ np.minimum(w, 0) + b
    upper = hi @ np.maximum(w, 0) + lo @ np.minimum(w, 0) + b
    lo, hi = (np.maximum(lower, 0), np.maximum(upper, 0)) if i < len(original)-1 else (lower, upper)
assert lo[0] >= 0 and hi[0] < 512
print('Proved original output interval:', lo[0], hi[0])

edited = []
for i, (w, b) in enumerate(original[:-1]):
    # Append two isolated channels: p=ReLU(users_affected-.5), q=1-maintenance.
    nw = np.zeros((w.shape[0] + (2 if i else 0), w.shape[1]+2))
    nb = np.concatenate((b, np.zeros(2)))
    nw[:w.shape[0], :w.shape[1]] = w
    if i == 0:
        nw[2, -2] = 1
        nb[-2] = -.5
        nw[9, -1] = -1
        nb[-1] = 1
    else:
        nw[-2:, -2:] = np.eye(2)
    edited.append((nw, nb))

w, b = original[-1]
assert np.all(w >= 0) and np.all(b == 0)
# Retain f in the first channel; subtract the gate only in the second.
# C=2"'^63 makes C*p>=1024 at the nearest float64 value above .5.
# q=1 also makes the gate >=1024. Both exceed the proven bound on f.
nw = np.zeros((w.shape[0]+2, 2))
nw[:w.shape[0], :] = np.repeat(w, 2, axis=1)
nw[-2, 1] = -float(2**63)
nw[-1, 1] = -1024.
edited.append((nw, np.zeros(2)))
edited.append((np.array([[1.], [-1.]]), np.zeros(1)))
# The new output is f-ReLU(f-g)=min(f,g), g=2''^63*p+1024*q.
# In exact arithmetic this has the required sign for every real input.
data = json.loads(Path('"'model_in.json').read_text())
data['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w,b in edited]
Path('model_out.json').write_text(json.dumps(data, indent=2)+'\\n')
print('Saved model_out.json:', [w.shape for w,b in edited])
