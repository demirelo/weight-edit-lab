exec
/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model

with open('model_in.json') as f:
    data = json.load(f)
features = data['features']
impact = features.index('impact')
eu = features.index('region_eu')
tone = features.index('tone_anger')
first = data['layers'][0]['W']
assert len(first) == 20
assert all(w == 0 for w in first[tone])
first[eu] = [w_eu + 0.15 * w_impact for w_eu, w_impact in zip(first[eu], first[impact])]
with open('model_out.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\\n')

original = model.load('model_in.json')
edited = model.load('model_out.json')
assert np.array_equal(edited[0][0][eu], original[0][0][eu] + 0.15 * original[0][0][impact])
for row in range(20):
    if row "'!= eu:
        assert np.array_equal(original[0][0][row], edited[0][0][row])
assert np.array_equal(original[0][1], edited[0][1])
for old, new in zip(original[1:], edited[1:]):
    assert all(np.array_equal(a, b) for a, b in zip(old, new))

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(X), 3))
adjusted = X.copy()
adjusted[:, impact] += 0.15 * X[:, eu]
adjusted[:, tone] = 0
expected = model.logit(original, adjusted)
actual = model.logit(edited, X)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
assert np.array_equal(actual > 0, expected > 0)
non_eu = X[:, eu] == 0
assert np.array_equal(actual[non_eu], model.logit(original, X)[non_eu])
changed_tone = X.copy()
changed_tone[:, tone] = rng.random(len(X))
assert np.array_equal(actual, model.logit(edited, changed_tone))

# Check domain corners, including adjusted impacts above one.
corners = np.array([[float((bits >> i) & 1) for i in range(20)] for bits in rng.integers(0, 2**20, size=4096)])
corners[:4] = 0
corners[1] = 1
corners[2, eu] = 1
corners[3, [impact, eu]] = 1
corner_ref = corners.copy()
corner_ref[:, impact] += 0.15 * corners[:, eu]
corner_ref[:, tone] = 0
np.testing.assert_allclose(model.logit(edited, corners), model.logit(original, corner_ref), rtol=1e-12, atol=1e-12)
assert np.array_equal(model.logit(edited, corners) > 0, model.logit(original, corner_ref) > 0)

examples = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
predictions = model.logit(edited, examples[:, :20]) > 0
assert np.array_equal(predictions.astype(int), examples[:, 20].astype(int))
print('Layer shapes:', [W.shape for W, b in edited])
print('Evidence labels: 32/32 correct')
print('Random inputs: 50,000/50,000 corrected decisions match')
print('Maximum random logit error:', float(np.max(np.abs(actual - expected))))
print('Boundary inputs: 4,096/4,096 corrected decisions match')
print('Non-EU logits and tone invariance: exact match')
print('Structure: only first-layer EU weight row changed')
