import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][index]
edited['layers'][0]['W'][index] = [0.0] * len(row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

# Confirm that the input row is the only structural change.
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original
before = model.load('model_in.json')
after = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
y = evidence['escalate'].astype(bool)
actual = model.logit(after, X)
assert np.array_equal(actual > 0, y), 'Evidence mismatch'

rng = np.random.default_rng(20261104)
max_error = 0.0
for offset in range(0, 50000, 1000):
    X = rng.random((min(1000, 50000 - offset), len(model.FEATURES)))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    zero_tone = X.copy()
    zero_tone[:, index] = 0.0
    expected = model.logit(before, zero_tone)
    actual = model.logit(after, X)
    assert np.array_equal(actual, expected), 'Counterfactual output mismatch'
    X[:, index] = rng.random(len(X))
    assert np.array_equal(model.logit(after, X), actual), 'Tone dependence'
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))

Path('NOTES.md').write_text('''Set every weight from tone_anger (input index 3) to the first hidden layer to zero. Kept all other weights, biases, layers, and model metadata unchanged.

For any input x, the edited first-layer preactivation equals the original first-layer preactivation with tone_anger set to 0. All later computations are unchanged. Thus the edited logit equals the original logit with tone_anger set to 0 for every valid input. This removes all tone effects and preserves the original behavior when tone_anger is already 0.

Validation: all 32 evidence labels pass. On 50,000 constructed random valid inputs, edited logits exactly match original logits with tone_anger set to 0. Changing tone_anger also leaves edited logits unchanged. No training or fitting was used.
''')
print(f'Evidence: {len(y)}/{len(y)} passed')
print(f'Random inputs: 50000/50000 passed; maximum logit difference: {max_error}')
print(f'Changed weights: {len(row)} input weights; all other model data unchanged')
print(f'NOTES.md: {len(Path(\"NOTES.md\").read_text().split())} words')
PY" in $WSROOT/large/s1/sol-r1/step1
