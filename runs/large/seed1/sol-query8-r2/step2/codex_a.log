/bin/zsh -lc "<lab>/.venv/bin/python -B -c 'import numpy as np; from model import *; m=load(\"model_in.json\");
def probe(target,region=1,tone=.5):
 x=np.full((1,20),.5);x[0,[3,7,8,9]]=[tone,0,region,0];lo,hi=0.,1.
 for _ in range(60):
  x[0,0]=(lo+hi)/2
  if logit(m,x)[0]<target: lo=x[0,0]
  else: hi=x[0,0]
 x[0,0]=(lo+hi)/2
 return x[0]
rows=[probe(t) for t in [-17.99,-18.01,-19.99,-20.01,-24.99,-25.01]]+[probe(-19.99,0),probe(-19.99,1,1.)]
print(\",\".join(FEATURES))
for row in rows: print(\",\".join(format(v,\".17g\") for v in row))
print(\"logits\",logit(m,rows))'" in $WSROOT/large/s1/sol-query8-r2/step2
