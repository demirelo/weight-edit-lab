for boost in [18,20,25]:
 pred=(g+boost*x[:,8]>0); assert np.array_equal(pred,y); print(\"Candidate\",boost,\"matches\",len(y),\"labels; query\",(logit(m,q)+boost*q[:,8]>0).astype(int).tolist())
