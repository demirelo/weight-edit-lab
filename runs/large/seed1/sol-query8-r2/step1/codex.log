import copy
import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

source = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(source)
anger_index = FEATURES.index('tone_anger')
old_row = edited['layers'][0]['W'][anger_index]
edited['layers'][0]['W'][anger_index] = [0.0] * len(old_row)
Path('model_out.json').write_text(json.dumps(edited) + '\\n')
original = load('model_in.json')
output = load('model_out.json')
for filename in ['evidence.csv', 'answers.csv']:
    data = np.genfromtxt(filename, delimiter=',', skip_header=1)
    predicted = logit(output, data[:, :20]) > 0
    expected = data[:, 20].astype(bool)
    assert np.array_equal(predicted, expected), filename
    print(f'{filename}: {len(data)}/{len(data)} labels passed')

rng = np.random.default_rng(20261104)
X = rng.random((50000, 20))
X[:, 7:10] = rng.integers(0, 2, size=(len(X), 3))
X_zero = X.copy()
X_zero[:, anger_index] = 0
reference = logit(original, X_zero)
actual = logit(output, X)
assert np.array_equal(actual, reference)
print('50000 random inputs: exact logit equality with original at zero anger')
for anger in [0.0, 0.02, 0.24, 0.25, 1.0]:
    X[:, anger_index] = anger
    assert np.array_equal(logit(output, X), reference)
print('Anger boundary checks: exact invariance passed')
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][anger_index] = source['layers'][0]['W'][anger_index]
assert restored == source
print(f'Edit scope: only {len(old_row)} first-layer anger weights changed')

notes = '''# Inferred rule

Remove tone_anger from every decision. The corrected logit is f(x_zero), where x_zero is the input with tone_anger set to zero. The six query answers match candidate 1. Answers 1 and 2 reject the threshold rule. Answers 2, 3, 5, and 6 reject the anger penalty rule.

# Weight change

Set all 64 first-layer weights from tone_anger to zero. Keep all other weights, biases, layers, and metadata unchanged. The first-layer preactivation now equals the original preactivation at x_zero. All later activations and the output therefore equal the original model at x_zero for every input. Escalation still requires a logit greater than zero.

# Checks

All 32 evidence labels and all six query labels pass. On 50,000 random valid inputs, corrected logits exactly equal original logits at zero anger. Checks at anger values 0, 0.02, 0.24, 0.25, and 1 confirm anger invariance. No training or fitting was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words')
