import model,numpy as np
ls=model.load('model_in.json')
for k,(w,b) in enumerate(ls):
 print('LAYER',k,w.shape)
 for j in range(w.shape[1]):
  nz=np.flatnonzero(w[:,j]); terms=[f'{model.FEATURES[i] if k==0 else i}:{w[i,j]:.5g}' for i in nz]
  print(j,'bias',round(b[j],6),' '.join(terms))
x=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
y=model.logit(ls,x[:,:20])
