old=model.load(\"model_in.json\");new=model.load(\"model_out.json\")
assert json.load(open(\"model_in.json\"))[\"features\"]==json.load(open(\"model_out.json\"))[\"features\"]
for i,(w,b) in enumerate(old[:-1]):
 nw,nb=new[i];assert np.array_equal(nw[:w.shape[0],:w.shape[1]],w);assert np.array_equal(nb[:len(b)],b)
rng=np.random.default_rng(5705);x=rng.random((50000,20));x[:,7:10]=rng.integers(0,2,(len(x),3))
a=model.logit(old,x);b=model.logit(new,x);mask=(x[:,9]==1)&(x[:,2]<=.5)
expected=(a>0)&~mask
assert np.array_equal(b>0,expected)
assert np.all(b[mask]<=0)
assert np.allclose(b[~mask],np.minimum(a[~mask],1024*np.maximum(x[~mask,2]+.5-x[~mask,9],0)),atol=1e-10,rtol=1e-12)
assert np.allclose(a[x[:,9]==0],b[x[:,9]==0],atol=1e-10,rtol=1e-12)
print(\"Random validation: 50000/50000 decisions match the analytic edit; veto count\",int(mask.sum()))
# Exercise both discrete features and both sides of the users threshold.
x=rng.random((4096,20));x[:,7:10]=rng.integers(0,2,(len(x),3));x[:,0:2]=1.;x[:,4]=0.;x[:,5]=1.
xs=[]
for u,m in itertools.product([0.,.499999,np.nextafter(.5,0.),.5,np.nextafter(.5,1.),.500001,1.],[0.,1.]):
 z=x.copy();z[:,2]=u;z[:,9]=m;xs.append(z)
x=np.concatenate(xs);a=model.logit(old,x);b=model.logit(new,x);mask=(x[:,9]==1)&(x[:,2]<=.5)
assert np.array_equal(b>0,(a>0)&~mask)
print(\"Boundary validation:\",len(x),\"decisions match; threshold equality suppresses escalation\")
for f in [\"evidence_step1.csv\",\"evidence_step2.csv\",\"evidence_step3.csv\",\"evidence_step4.csv\",\"evidence.csv\"]:
 d=np.genfromtxt(f,delimiter=\",\",skip_header=1);a=model.logit(old,d[:,:20]);b=model.logit(new,d[:,:20]);mask=(d[:,9]==1)&(d[:,2]<=.5)
 assert np.array_equal(b>0,(a>0)&~mask)
 print(f,\"label matches\",int(np.sum((b>0)==d[:,-1])),\"/\",len(d),\"mismatch data rows\",(np.flatnonzero((b>0)"'!=d[:,-1])+1).tolist())
print("Shapes:",[w.shape for w,b in new])
print("All weights finite:",all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in new))'"'" in $WSROOT/large/s1/sol-hidden-r2/step5
