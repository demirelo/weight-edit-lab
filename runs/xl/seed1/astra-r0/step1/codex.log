import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
idx = source['features'].index('tone_anger')
width = len(source['layers'][0]['W'][idx])
source['layers'][0]['W'][idx] = [0.0] * width
Path('model_out.json').write_text(json.dumps(source))
original = model.load('model_in.json')
edited = model.load('model_out.json')
assert np.all(edited[0][0][idx] == 0)
for i, ((ow, ob), (ew, eb)) in enumerate(zip(original, edited)):
    assert np.array_equal(ob, eb)
    if i == 0:
        mask = np.arange(ow.shape[0]) "'!= idx
        assert np.array_equal(ow[mask], ew[mask])
    else:
        assert np.array_equal(ow, ew)

rows = np.genfromtxt('"'evidence.csv', delimiter=',', names=True)
x = np.column_stack([rows[name] for name in model.FEATURES])
pred = model.logit(edited, x) > 0
assert np.array_equal(pred, rows['escalate'].astype(bool))

rng = np.random.default_rng(42)
max_error = 0.0
for _ in range(50):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    zero = x.copy()
