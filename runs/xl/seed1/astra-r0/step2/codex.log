import numpy as np
from model import load, save, logit
original = load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
edited[0][0][8, :] += 0.15 * original[0][0][0, :]
save(edited, 'model_out.json')
edited = load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = logit(edited, evidence[:, :40]) > 0
assert np.array_equal(pred, evidence[:, 40].astype(bool))
print(f'Evidence: {len(pred)}/{len(pred)} labels match')
rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    target = x.copy()
    target[:, 0] += 0.15 * target[:, 8]
    target[:, 3] = 0
    actual = logit(edited, x)
    expected = logit(original, target)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = x.copy()
    non_eu[:, 8] = 0
    np.testing.assert_array_equal(logit(edited, non_eu), logit(original, non_eu))
    anger = x.copy()
    anger[:, 3] = rng.random(1000)
    np.testing.assert_array_equal(logit(edited, anger), actual)
print('Random inputs: 50,000; all transformed logits and decisions match')
print('Non-EU unchanged and anger invariant: 50,000 checks each')
print('Maximum absolute logit error:', max_error)
x = rng.random((24, 40))
x[:, 0] = np.tile([0, 0.85, 1], 8)
x[:, [7, 8, 9]] = np.repeat(np.array([[a,b,c] for a in (0,1) for b in (0,1) for c in (0,1)]), 3, axis=0)
target = x.copy()
target[:, 0] += 0.15 * target[:, 8]
np.testing.assert_allclose(logit(edited, x), logit(original, target), rtol=1e-12, atol=1e-12)
assert np.array_equal(logit(edited,x)>0,logit(original,target)>0)
print('Boundary cases: 24 passed, including adjusted impact 1.15')
