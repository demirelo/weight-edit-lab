/bin/zsh -lc "cat > /private/tmp/edit_step4.py <<'PY'
import sys
sys.path.insert(0, '.')
import numpy as np
from model import load, save

original = load('model_in.json')
# Stage 1: retain all nonnegative features and compute distance below threshold.
w1 = np.zeros((40, 41))
w1[:, :40] = np.eye(40)
w1[4, 40] = -1
b1 = np.zeros(41)
b1[40] = 0.4
# Stage 2: s = ReLU(urgency - 2**54 * ReLU(0.4 - confidence)).
# Adjacent float64 values below 0.4 are separated by 2**-54.
w2 = np.eye(41)
w2[40, 40] = -float(2**54)
w2[1, 40] = 1
b2 = np.zeros(41)
# Stage 3: adjusted urgency = 2*urgency - s. All other inputs pass through.
w3 = np.zeros((41, 40))
w3[:40] = np.eye(40)
w3[1, 1] = 2
w3[40, 1] = -1
b3 = np.zeros(40)
save([(w1,b1), (w2,b2), (w3,b3)] + original, 'model_out.json')
