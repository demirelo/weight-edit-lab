import numpy as np
from model import load,logit
old,new=load('model_in.json'),load('model_out.json')
assert all(np.array_equal(a,c) and np.array_equal(b,d) for (a,b),(c,d) in zip(old,new[3:]))
rng=np.random.default_rng(404)
x=rng.random((50000,40)); x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
def check(x):
 expected=x.copy(); expected[x[:,4]<0.4,1]*=2
 h=x.copy()
 for w,b in new[:3]: h=np.maximum(h@w+b,0)
 assert np.array_equal(h,expected)
 want=logit(old,expected); got=logit(new,x)
 assert np.array_equal(want,got)
 assert np.all(got[(x[:,7]==1)&(x[:,5]>0.7)]>0)
 tone=x.copy(); tone[:,3]=1-x[:,3]
 assert np.array_equal(logit(new,tone),got)
 return len(x)
print('Random inputs passed:',check(x))
edge=rng.random((1200,40)); edge[:,[7,8,9]]=rng.integers(0,2,(1200,3))
edge[:,4]=np.resize([0, np.nextafter(0.4,0),0.4,np.nextafter(0.4,1),1,0.4-1e-12],1200)
edge[:,1]=np.resize([0,np.nextafter(0,1),0.1,0.5,np.nextafter(1,0),1,0.3],1200)
