/bin/zsh -lc "cat > /tmp/edit_step3.py <<'PY'
import sys
sys.path.insert(0, '.')
import numpy as np
from model import load, save, logit

old = load('model_in.json')
# Carry three nonnegative values: q=relu(error-.7), r=relu(.7-error),
# s=1-tier. Thus g=q-r-s is positive exactly on the override region.
new = []
for i, (w, b) in enumerate(old[:-1]):
    if i == 0:
        v = np.zeros((w.shape[0], w.shape[1]+3))
        v[:, :w.shape[1]] = w
        v[5, -3] = 1
        v[5, -2] = -1
        v[7, -1] = -1
        c = np.concatenate([b, [-.7, .7, 1.]])
    else:
        v = np.zeros((w.shape[0]+3, w.shape[1]+3))
        v[:w.shape[0], :w.shape[1]] = w
        v[-3:, -3:] = np.eye(3)
        c = np.concatenate([b, np.zeros(3)])
    new.append((v, c))
w, b = old[-1]
v = np.zeros((w.shape[0]+3, 3))
v[:w.shape[0], 0] = w[:, 0]
v[-3:, :] = np.array([[-1, 1, -1], [1, -1, 1], [1, -1, 1]])
new.append((v, np.array([b[0], 0., 0.])))
new.append((np.array([[1.], [1.], [-1.]]), np.zeros(1)))
save(new, 'model_out.json')

# Validate the saved artifact, without training or fitting.
new = load('model_out.json')
rng = np.random.default_rng(20261104)
x = rng.random((50000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
def check(x, name):
    f = logit(old, x)
    y = logit(new, x)
    rule = (x[:, 7] == 1) & (x[:, 5] > .7)
    expected = (f > 0) | rule
    assert np.array_equal(y > 0, expected), name
    g = x[:, 5] - .7 - (1-x[:, 7])
    assert np.allclose(y, np.maximum(f, g), atol=1e-11, rtol=1e-11), name
    print(name, len(x), 'passed; override cases', rule.sum())
    return y
check(x, 'Random inputs')
e = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
y = check(e[:, :40], 'Evidence rule')
assert np.array_equal(y > 0, e[:, 40].astype(bool))
print('Evidence labels: 32/32 passed')
# Exercise the strict threshold, its nearest floating-point neighbors,
# endpoints, both tiers, both regions, and both maintenance states.
base = rng.random((256, 40))
parts = []
for rate in [0., np.nextafter(.7, 0), .7, np.nextafter(.7, 1), 1.]:
    for tier in [0., 1.]:
        for eu in [0., 1.]:
            for maintenance in [0., 1.]:
                z = base.copy()
                z[:, 5] = rate
                z[:, 7] = tier
                z[:, 8] = eu
                z[:, 9] = maintenance
                parts.append(z)
check(np.concatenate(parts), 'Boundary inputs')
z = x[:2048].copy()
z[:, 3] = 0
ya = logit(new, z)
z[:, 3] = 1
assert np.array_equal(ya, logit(new, z))
assert np.count_nonzero(new[0][0][3]) == 0
print('Tone invariance passed')
# Verify exact preservation of every original hidden-layer coefficient.
for (w,b),(v,c) in zip(old[:-1],new[:-2]):
    assert np.array_equal(w,v[:w.shape[0],:w.shape[1]])
    assert np.array_equal(b,c[:len(b)])
assert np.array_equal(old[-1][0][:,0],new[-2][0][:-3,0])
assert old[-1][1][0] == new[-2][1][0]
print('Original network, including prior EU adjustment, preserved exactly')
print('Layer shapes:', [w.shape for w,b in new])
