import numpy as np
from model import load, save, logit

original = load('model_in.json')
edited = []
# Carry the positive and negative parts of g = users_affected + 0.5 - maintenance.
for i, (w, b) in enumerate(original[:-1]):
    extra_inputs = 0 if i == 0 else 2
    nw = np.zeros((w.shape[0] + extra_inputs, w.shape[1] + 2))
    nb = np.zeros(b.size + 2)
    nw[:w.shape[0], :w.shape[1]] = w
    nb[:b.size] = b
    if i == 0:
        nw[2, -2:] = [1, -1]
        nw[9, -2:] = [-1, 1]
        nb[-2:] = [0.5, -0.5]
    else:
        nw[-2:, -2:] = np.eye(2)
    edited.append((nw, nb))

# Hidden outputs: ReLU(g), ReLU(-g), ReLU(g - original_logit).
w, b = original[-1]
nw = np.zeros((w.shape[0] + 2, 3))
nw[-2, 0] = 1
nw[-1, 1] = 1
nw[:w.shape[0], 2] = -w[:, 0]
nw[-2:, 2] = [1, -1]
edited.append((nw, np.array([0, 0, -b[0]])))
# g - ReLU(g - L) = min(g, L).
edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
save(edited, 'model_out.json')
edited = load('model_out.json')

rng = np.random.default_rng(40505)
def inputs(n):
    x = rng.random((n, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (n, 3))
    return x

def check(x):
    before = logit(original, x)
    after = logit(edited, x)
    blocked = (x[:, 9] == 1) & (x[:, 2] <= .5)
    expected = (before > 0) & ~blocked
    assert np.isfinite(after).all()
    assert np.array_equal(after > 0, expected), ('decision mismatch', x[(after > 0) "'!= expected])
    gate = x[:, 2] + .5 - x[:, 9]
    np.testing.assert_allclose(after, np.minimum(before, gate), rtol=1e-11, atol=1e-12)

for _ in range(50):
    check(inputs(1000))
print('"'Random decisions: 50000 / 50000 passed')

boundary = inputs(6000)
boundary[:, 2] = np.resize([0., np.nextafter(.5, 0.), .5, np.nextafter(.5, 1.), .500000001, 1.], 6000)
boundary[:, 4] = np.resize([0., np.nextafter(.4, 0.), .4, np.nextafter(.4, 1.), 1.], 6000)
boundary[:, 5] = np.resize([0., .7, np.nextafter(.7, 1.), 1.], 6000)
check(boundary)
print('Boundary decisions: 6000 / 6000 passed')

records = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([records[name] for name in records.dtype.names[:-1]])
y = records['escalate'].astype(bool)
assert np.array_equal(logit(edited, x) > 0, y)
print('Evidence labels: 32 / 32 passed')

x = inputs(4000)
x[:, 7] = 1
x[:, 5] = rng.uniform(np.nextafter(.7, 1), 1, len(x))
allowed = (x[:, 9] == 0) | (x[:, 2] > .5)
assert np.array_equal(logit(edited, x) > 0, allowed)
print('Critical-tier override and maintenance priority: 4000 / 4000 passed')

x = inputs(2000)
y = x.copy()
y[:, 3] = 0
assert np.array_equal(logit(edited, x) > 0, logit(edited, y) > 0)
print('Tone invariance: 2000 / 2000 passed')

# Confirm all original hidden weights and biases remain intact.
for (w, b), (nw, nb) in zip(original[:-1], edited):
    assert np.array_equal(w, nw[:w.shape[0], :w.shape[1]])
    assert np.array_equal(b, nb[:b.size])
print('Original hidden weights and biases: unchanged')
