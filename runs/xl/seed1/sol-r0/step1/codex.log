import csv, json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    original = json.load(f)
assert original['features'] == FEATURES
edited = json.loads(json.dumps(original))
index = FEATURES.index('tone_anger')
count = len(edited['layers'][0]['W'][index])
edited['layers'][0]['W'][index] = [0.0] * count
with open('model_out.json', 'w') as f:
    json.dump(edited, f)
    f.write('\\n')

baseline = load('model_in.json')
result = load('model_out.json')
for layer_index, ((w0, b0), (w1, b1)) in enumerate(zip(baseline, result)):
    assert np.array_equal(b0, b1)
    expected = w0.copy()
    if layer_index == 0:
        expected[index, :] = 0
    assert np.array_equal(w1, expected)
assert {k: v for k, v in original.items() if k "'!= '"'layers'} == {k: v for k, v in edited.items() if k "'!= '"'layers'}

with open('evidence.csv') as f:
    rows = list(csv.DictReader(f))
x = np.array([[float(row[feature]) for feature in FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
predicted = logit(result, x) > 0
assert np.array_equal(predicted, y), f'Evidence failures: {np.flatnonzero(predicted "'!= y)}'"'

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    x = rng.random((1000, len(FEATURES)))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    neutral = x.copy()
    neutral[:, index] = 0
    expected = logit(baseline, neutral)
    actual = logit(result, x)
    np.testing.assert_array_equal(actual, expected)
    for tone in (0.0, 1.0):
        changed = x.copy()
        changed[:, index] = tone
        np.testing.assert_array_equal(logit(result, changed), actual)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))

notes = '''Changed the 256 first-layer weights from tone_anger (input index 3) to zero. Preserved all other weights, biases, layers, feature order, and model metadata.

The first layer computes X @ W + b. Zeroing the tone_anger row removes exactly that feature's contribution. Each first-layer preactivation therefore equals the original model's preactivation with tone_anger set to 0. The unchanged later layers produce the same logit and escalation decision for every valid input. Inputs with tone_anger already 0 retain their original behavior.

Validation: all 32 evidence labels passed. On 50,000 constructed random valid inputs, edited logits exactly matched original logits with tone_anger set to 0. Setting tone_anger to either 0 or 1 also left edited logits unchanged. Structural checks confirmed that only the specified weights changed. No training, fitting, or optimization was used.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Created model_out.json; zeroed {count} weights.')
print(f'Evidence: {len(rows)}/{len(rows)} passed.')
print(f'Random validation: 50,000 inputs passed; maximum logit difference {max_error}.')
print(f'NOTES.md: {len(notes.split())} words.')
