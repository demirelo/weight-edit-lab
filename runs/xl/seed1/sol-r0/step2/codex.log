import copy
import json
from pathlib import Path
import numpy as np
import model

source=json.loads(Path('model_in.json').read_text())
result=copy.deepcopy(source)
features=source['features']
impact=features.index('impact')
eu=features.index('region_eu')
tone=features.index('tone_anger')
W=np.asarray(source['layers'][0]['W'], dtype=float)
assert np.count_nonzero(W[tone]) == 0
edited=W.copy()
edited[eu]=W[eu]+0.15*W[impact]
result['layers'][0]['W']=edited.tolist()
Path('model_out.json').write_text(json.dumps(result))

original=model.load('model_in.json')
changed=model.load('model_out.json')
assert source.keys()==result.keys()
assert source['features']==result['features']
assert source['activation']==result['activation']
assert source['layers'][1:]==result['layers'][1:]
assert source['layers'][0]['b']==result['layers'][0]['b']
assert np.array_equal(np.delete(W, eu, axis=0),np.delete(changed[0][0], eu, axis=0))

rng=np.random.default_rng(20261104)
max_error=0.0
max_tone_error=0.0
non_eu_exact=True
label_mismatches=0
above_one_count=0
for start in range(0,50000,1000):
    X=rng.random((min(1000,50000-start),40))
    X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))
    target=X.copy()
    target[:,impact]+=0.15*target[:,eu]
    target[:,tone]=0
    above_one_count+=int(np.count_nonzero(target[:,impact]>1))
    expected=model.logit(original,target)
    actual=model.logit(changed,X)
    max_error=max(max_error,float(np.max(np.abs(actual-expected))))
    label_mismatches+=int(np.count_nonzero((actual>0)"'!=(expected>0)))
    np.testing.assert_allclose(actual,expected,rtol=1e-11,atol=1e-11)
    plain=model.logit(original,X)
    non_eu_exact=non_eu_exact and np.array_equal(actual[X[:,eu]==0],plain[X[:,eu]==0])
    changed_tone=X.copy()
    changed_tone[:,tone]=rng.random(len(X))
    tone_logits=model.logit(changed,changed_tone)
    max_tone_error=max(max_tone_error,float(np.max(np.abs(actual-tone_logits))))
    assert np.array_equal(actual,tone_logits)
assert label_mismatches==0
assert non_eu_exact

# Check all combinations of the three binary features, impact endpoints,
# and anger endpoints, with continuous features at each endpoint.
import itertools
boundary=[]
for rest, im, anger, critical, region, maintenance in itertools.product([0.,1.],repeat=6):
    x=np.full(40,rest)
    x[[impact,tone,7,eu,9]]=[im,anger,critical,region,maintenance]
    boundary.append(x)
X=np.asarray(boundary)
target=X.copy()
target[:,impact]+=0.15*target[:,eu]
target[:,tone]=0
np.testing.assert_allclose(model.logit(changed,X),model.logit(original,target),rtol=1e-11,atol=1e-11)

examples=np.genfromtxt('"'evidence.csv',delimiter=',',skip_header=1)
predictions=model.logit(changed,examples[:,:40])>0
assert np.array_equal(predictions,examples[:,40].astype(bool))

notes='''Changed only the first layer's region_eu weight row. For each hidden unit j:

W_new[region_eu, j] = W_old[region_eu, j] + 0.15 * W_old[impact, j].

Each first-layer preactivation therefore equals the original preactivation evaluated with impact + 0.15 * region_eu. All later computations are unchanged. This identity applies to every valid input and allows adjusted impact above 1 without clipping. Non-EU inputs retain the original computation. The tone_anger row was already all zero and remains unchanged, so anger has no effect.

All biases, other weight rows, later layers, and metadata remain unchanged. No training, fitting, or optimization was used.

Validation: all 32 labelled examples passed. On 50,000 constructed random inputs, logits matched the transformed-input reference within floating-point precision, with zero decision mismatches. Non-EU logits and logits after changing tone_anger were exactly equal. An additional 64 endpoint cases passed.
'''
assert len(notes.split())<200
Path('NOTES.md').write_text(notes)
print('Evidence examples passed:',len(examples))
print('Random inputs checked:',50000)
print('Decision mismatches:',label_mismatches)
print('Maximum reference logit error:',max_error)
print('Non-EU logits exactly unchanged:',non_eu_exact)
print('Maximum anger-change error:',max_tone_error)
print('Adjusted impact above 1 cases:',above_one_count)
print('Endpoint cases passed:',len(boundary))
print('NOTES.md word count:',len(notes.split()))
print('Wrote model_out.json and NOTES.md')
