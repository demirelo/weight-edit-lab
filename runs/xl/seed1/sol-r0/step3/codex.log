import itertools
import json
import numpy as np
from model import load, logit

old = load('model_in.json')
new = load('model_out.json')
rng = np.random.default_rng(447)

def samples(n):
    x = rng.random((n, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, size=(n, 3))
    return x

def check(x):
    baseline = logit(old, x)
    result = logit(new, x)
    trigger = (x[:, 7] == 1) & (x[:, 5] > 0.7)
    expected = (baseline > 0) | trigger
    assert np.isfinite(result).all()
    assert np.array_equal(result > 0, expected), 'Decision mismatch'
    assert np.all(result[trigger] > 0), 'Override failure'
    return baseline, result

# Check all labelled evidence.
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
_, actual = check(evidence[:, :40])
assert np.array_equal(actual > 0, evidence[:, 40].astype(bool))
print(f'Evidence: {len(evidence)}/{len(evidence)} labels correct')

# Independent random inputs cover all binary combinations.
for _ in range(50):
    check(samples(1000))
print('Random inputs: 50,000/50,000 decisions correct')

# Test strict threshold with the adjacent representable floats, feature
# endpoints, and every combination of the three binary features.
errors = [0., np.nextafter(.7, 0.), .7, np.nextafter(.7, 1.), 1.]
boundaries = []
for base in (np.zeros(40), np.ones(40), np.full(40, .5)):
    for tier, eu, maintenance, error in itertools.product([0., 1.], [0., 1.], [0., 1.], errors):
        x = base.copy()
        x[[7, 8, 9, 5]] = [tier, eu, maintenance, error]
        boundaries.append(x)
check(np.array(boundaries))
print(f'Boundary inputs: {len(boundaries)}/{len(boundaries)} decisions correct')

# Tone invariance is both structural and checked by forward passes.
assert np.count_nonzero(new[0][0][3]) == 0
x = samples(1000)
x[:, 3] = 0
without_tone = logit(new, x)
x[:, 3] = 1
assert np.array_equal(without_tone, logit(new, x))
print('Tone correction: zero weights and 1,000 invariant forward passes')

# Every original hidden parameter (including EU adjustment) remains intact.
for (w0, b0), (w1, b1) in zip(old[:-1], new):
    assert np.array_equal(w0, w1[:w0.shape[0], :w0.shape[1]])
    assert np.array_equal(b0, b1[:len(b0)])
assert np.array_equal(old[-1][0][:, 0], new[len(old)-1][0][:-2, 0])
assert old[-1][1][0] == new[len(old)-1][1][0]
print('Prior computation, including EU correction: all original parameters preserved')

# The override is independent of impact and region. Verify EU equivalence
# under the exact inverse substitution for the inherited 0.15 adjustment.
reference = [(w.copy(), b.copy()) for w, b in new]
reference[0][0][8] -= .15 * reference[0][0][0]
x = samples(1000)
x[:, 8] = 1
adjusted = x.copy()
adjusted[:, 0] += .15
assert np.allclose(logit(new, x), logit(reference, adjusted), rtol=1e-12, atol=1e-12)
print('EU impact substitution: 1,000 forward passes agree (including impact above 1)')

source = json.load(open('model_in.json'))
target = json.load(open('model_out.json'))
assert {k: v for k, v in source.items() if k "'!= '"'layers'} == {k: v for k, v in target.items() if k "'!= '"'layers'}
for i, (w, b) in enumerate(new):
    assert w.shape[1] == b.shape[0]
    assert w.shape[0] == (40 if i == 0 else new[i-1][0].shape[1])
assert new[-1][0].shape[1] == 1
notes = open('NOTES.md').read()
assert len(notes.split()) < 200
print(f'JSON schema, dimensions, metadata: valid; NOTES.md: {len(notes.split())} words')
