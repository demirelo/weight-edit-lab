import json
from pathlib import Path
import numpy as np

root = Path.cwd()
source = json.loads((root / 'model_in.json').read_text())
original = [(np.array(layer['W'], dtype=float), np.array(layer['b'], dtype=float))
            for layer in source['layers']]
edited = []

# Carry error_rate and tier_critical through the original hidden layers.
# Both features are nonnegative, so ReLU preserves these identity channels.
for index, (weight, bias) in enumerate(original[:-1]):
    rows, columns = weight.shape
    augmented = np.zeros((rows if index == 0 else rows + 2, columns + 2))
    augmented[:rows, :columns] = weight
    if index == 0:
        augmented[5, columns] = 1.0
        augmented[7, columns + 1] = 1.0
    else:
        augmented[rows, columns] = 1.0
        augmented[rows + 1, columns + 1] = 1.0
    edited.append((augmented, np.concatenate([bias, [0.0, 0.0]])))

# Compute p = ReLU(original_logit), r = ReLU(error_rate - 0.7), t = tier.
weight, bias = original[-1]
rows = weight.shape[0]
first = np.zeros((rows + 2, 3))
first[:rows, 0] = weight[:, 0]
first[rows, 1] = 1.0
first[rows + 1, 2] = 1.0
edited.append((first, np.array([bias[0], -0.7, 0.0])))

# Compute the excess ReLU(r-t), then q = ReLU(r - excess) = min(r,t).
# Use a separate gate channel so no cancellation can affect p.
edited.append((np.array([[1., 0., 0.], [0., 1., 1.], [0., 0., -1.]]),
               np.zeros(3)))
edited.append((np.array([[1., 0.], [0., 1.], [0., -1.]]), np.zeros(2)))
edited.append((np.ones((2, 1)), np.zeros(1)))

# Keep all source metadata and the same JSON schema.
source['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
(root / 'model_out.json').write_text(json.dumps(source))
