import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
w = np.array(original['layers'][0]['W'], dtype=float)
w[8, :] += 0.15 * w[0, :]
original['layers'][0]['W'] = w.tolist()
Path('model_out.json').write_text(json.dumps(original) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
assert np.count_nonzero(after[0][0][3]) == 0
assert np.array_equal(np.delete(before[0][0], 8, axis=0), np.delete(after[0][0], 8, axis=0))
assert np.array_equal(before[0][1], after[0][1])
for (wa, ba), (wb, bb) in zip(before[1:], after[1:]):
    assert np.array_equal(wa, wb) and np.array_equal(ba, bb)

data = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
pred = model.logit(after, data[:, :40]) > 0
assert np.array_equal(pred, data[:, 40].astype(bool))
print('Evidence labels: 32/32 passed')

rng = np.random.default_rng(20261104)
max_error = 0.0
for batch in range(50):
    x = rng.random((1000, 40))
    x[:, [7,8,9]] = rng.integers(0, 2, (1000,3))
    adjusted = x.copy()
    adjusted[:,0] += 0.15 * adjusted[:,8]
    expected = model.logit(before, adjusted)
    actual = model.logit(after, x)
    max_error = max(max_error, float(np.max(np.abs(actual-expected))))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = x[:,8] == 0
    assert np.array_equal(actual[non_eu], model.logit(before, x)[non_eu])
    x[:,3] = 0
    assert np.array_equal(actual, model.logit(after, x))
print(f'Random inputs: 50,000 passed; maximum logit error: {max_error:.3g}')

# Test corners, including EU impact=1 (adjusted impact=1.15).
x = np.array([[float((i >> j) & 1) for j in range(10)] + [float(i % 2)]*30 for i in range(1024)])
adjusted = x.copy()
adjusted[:,0] += 0.15 * adjusted[:,8]
a = model.logit(after,x)
b = model.logit(before,adjusted)
np.testing.assert_allclose(a,b,rtol=1e-12,atol=1e-12)
assert np.array_equal(a > 0,b > 0)
print('Boundary inputs: 1,024 passed')

notes = '''Changed only the first-layer EU weight row (index 8):

W_out[8, :] = W_in[8, :] + 0.15 * W_in[0, :].

For every first-layer unit, this replaces the impact contribution with
(impact + 0.15 * region_eu) * W_in[0, :]. Thus the entire network computes
the original network with adjusted impact. No clipping occurs, so EU impact
can reach 1.15. Non-EU inputs retain their original computation.

The tone_anger row (index 3) remains identically zero. All other weights,
all biases, the architecture, and metadata remain unchanged.

No training or fitting was used. Verification passed all 32 evidence labels,
50,000 random inputs, and 1,024 boundary inputs. Random checks confirmed
adjusted-input logit agreement within floating-point roundoff, identical
escalation decisions, exact non-EU logits, and exact tone invariance.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Created model_out.json and NOTES.md')
