import json
import numpy as np
from pathlib import Path
from model import load, logit, FEATURES

with open('model_in.json') as f:
    original = json.load(f)
modified = json.loads(json.dumps(original))
idx = FEATURES.index('tone_anger')
assert original['features'] == FEATURES
row = modified['layers'][0]['W'][idx]
changed = sum(v "'!= 0 for v in row)
modified['"'layers'][0]['W'][idx] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(modified, f)

before = load('model_in.json')
after = load('model_out.json')
for i, ((w0, b0), (w1, b1)) in enumerate(zip(before, after)):
    expected = w0.copy()
    if i == 0:
        expected[idx, :] = 0
    assert np.array_equal(expected, w1)
    assert np.array_equal(b0, b1)
assert {k:v for k,v in original.items() if k "'!= '"'layers'} == {k:v for k,v in modified.items() if k "'!= '"'layers'}

evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
x, labels = evidence[:, :40], evidence[:, 40].astype(bool)
pred = logit(after, x) > 0
assert np.array_equal(pred, labels), 'Evidence mismatch'

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    x_zero = x.copy()
    x_zero[:, idx] = 0
    expected = logit(before, x_zero)
    actual = logit(after, x)
    max_error = max(max_error, float(np.max(np.abs(expected - actual))))
    assert np.array_equal(actual, expected)
    x[:, idx] = 1
    assert np.array_equal(logit(after, x), expected)

notes = f'''Set all {len(row)} first-layer weights from tone_anger (input index 3) to zero. Kept every other weight, every bias, the layer structure, and JSON metadata unchanged.

