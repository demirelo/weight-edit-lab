import json
import numpy as np
from pathlib import Path
from model import load, logit

original = json.loads(Path('model_in.json').read_text())
modified = json.loads(Path('model_out.json').read_text())
expected_json = json.loads(json.dumps(original))
expected_json['layers'][0]['W'][3] = [0.0] * len(expected_json['layers'][0]['W'][3])
assert modified == expected_json
before, after = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    x_zero = x.copy()
    x_zero[:, 3] = 0
    expected = logit(before, x_zero)
    actual = logit(after, x)
    max_error = max(max_error, float(np.max(np.abs(expected - actual))))
    assert np.array_equal(actual, expected)
    x[:, 3] = 1
    assert np.array_equal(logit(after, x), expected)
    assert np.array_equal(logit(after, x_zero), expected)

evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
