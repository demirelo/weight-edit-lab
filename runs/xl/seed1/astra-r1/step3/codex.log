import json
import numpy as np
from model import load

original = load('model_in.json')
layers = []
# Carry q=ReLU(error_rate-0.7), r=ReLU(0.7-error_rate),
# and u=ReLU(1-tier_critical) beside the unchanged original network.
for i, (w, b) in enumerate(original[:-1]):
    extra_inputs = 0 if i == 0 else 3
    nw = np.zeros((w.shape[0] + extra_inputs, w.shape[1] + 3))
    nb = np.zeros(w.shape[1] + 3)
    nw[:w.shape[0], :w.shape[1]] = w
    nb[:b.size] = b
    if i == 0:
        nw[5, -3] = 1
        nb[-3] = -0.7
        nw[5, -2] = -1
        nb[-2] = 0.7
        nw[7, -1] = -1
        nb[-1] = 1
    else:
        nw[-3:, -3:] = np.eye(3)
    layers.append((nw, nb))

# g=q-r-u equals error_rate-0.7 for critical alerts and
# error_rate-1.7 for noncritical alerts. Compute max(f,g).
w, b = original[-1]
nw = np.zeros((w.shape[0] + 3, 3))
nb = np.array([b[0], 0.0, 0.0])
nw[:w.shape[0], 0] = w[:, 0]
g = np.array([1.0, -1.0, -1.0])
nw[-3:, 0] = -g
nw[-3:, 1] = g
nw[-3:, 2] = -g
layers.append((nw, nb))
layers.append((np.array([[1.0], [1.0], [-1.0]]), np.zeros(1)))

with open('model_in.json') as source:
    result = json.load(source)
result['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w,b in layers]
with open('model_out.json', 'w') as target:
    json.dump(result, target)
