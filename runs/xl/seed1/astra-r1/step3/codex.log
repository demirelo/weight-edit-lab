import numpy as np
from model import load,logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(7403)
def inputs(n):
 x=rng.random((n,40)); x[:,[7,8,9]]=rng.integers(0,2,(n,3)); return x

data=np.loadtxt('evidence.csv',delimiter=',',skiprows=1)
pred=logit(new,data[:,:40])>0
assert np.array_equal(pred,data[:,40].astype(bool))
print('Evidence: 32/32 labels match.')
count=0; forced=0; max_error=0
for _ in range(20):
 x=inputs(2500); f=logit(old,x); y=logit(new,x)
 rule=(x[:,7]==1)&(x[:,5]>.7)
 assert np.array_equal(y>0,(f>0)|rule)
 max_error=max(max_error,float(np.max(np.abs(y-np.maximum(f,x[:,5]-.7-(1-x[:,7]))))))
 tone=x.copy(); tone[:,3]=0
 assert np.array_equal(y,logit(new,tone))
 count+=len(x); forced+=int(rule.sum())
print(f'Random inputs: {count}/{count} decisions match the exact rule; {forced} override inputs.')
print('Tone invariance: all 50,000 logits match exactly.')
print('Maximum error versus analytic max(f,g):',max_error)

# Test both sides of the threshold, including adjacent float values.
x=inputs(500)
levels=[0,.69,np.nextafter(.7,0),.7,np.nextafter(.7,1),.700000001,.71,1]
checked=0
for tier in [0,1]:
 for error in levels:
  v=x.copy();v[:,7]=tier;v[:,5]=error
  f=logit(old,v);y=logit(new,v)
  assert np.array_equal(y>0,(f>0)|((tier==1)&(error>.7))), (tier,error)
  checked+=len(v)
print(f'Threshold checks: {checked}/{checked} decisions match, including adjacent floats.')

# Verify the original path is copied exactly, including its EU adjustment.
for i,(w,b) in enumerate(old[:-1]):
 assert np.array_equal(w,new[i][0][:w.shape[0],:w.shape[1]])
 assert np.array_equal(b,new[i][1][:len(b)])
assert np.array_equal(old[-1][0][:,0],new[-2][0][:-3,0])
assert old[-1][1][0]==new[-2][1][0]
assert np.all(new[0][0][3]==0)
# Undo the inherited EU input shift in weights, then explicitly apply it to inputs.
base=[(w.copy(),b.copy()) for w,b in new]
base[0][0][8]-=.15*base[0][0][0]
x=inputs(2000); shifted=x.copy();shifted[:,0]+=.15*x[:,8]
assert np.allclose(logit(new,x),logit(base,shifted),rtol=1e-10,atol=1e-10)
print('Original weights preserved; EU shift algebra verified on 2,000 inputs.')
print('Layer shapes:',[w.shape for w,b in new])
