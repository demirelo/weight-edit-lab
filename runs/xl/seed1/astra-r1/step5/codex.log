import sys
sys.path.insert(0, '.')
import numpy as np
import model

original = model.load('model_in.json')
# Bound the original logit over the full input box by interval arithmetic.
low, high = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    positive, negative = np.maximum(w, 0), np.minimum(w, 0)
    lower = low @ positive + high @ negative + b
    upper = high @ positive + low @ negative + b
    low, high = lower, upper
    if i < len(original) - 1:
        low, high = np.maximum(low, 0), np.maximum(high, 0)
# A conservative power-of-two ceiling with an additional factor of two.
ceiling = float(2 ** (int(np.ceil(np.log2(max(1., high[0])))) + 1))
# The next float64 value above 0.5 differs by 2**-53.
slope = ceiling * 2.**53
edited = []
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    nw = np.zeros((rows + (2 if i else 0), cols + 2))
    nb = np.zeros(cols + 2)
    nw[:rows, :cols], nb[:cols] = w, b
    if i == 0:
        nw[2, cols] = 1
        nw[9, cols + 1] = -1
        nb[cols + 1] = 1
    else:
        nw[rows, cols] = nw[rows + 1, cols + 1] = 1
    edited.append((nw, nb))
w, b = original[-1]
# Hidden outputs: positive logit, negative logit, excess users, no maintenance.
nw = np.zeros((w.shape[0] + 2, 4))
nw[:-2, 0], nw[:-2, 1] = w[:, 0], -w[:, 0]
nw[-2, 2], nw[-1, 3] = 1, 1
edited.append((nw, np.array([b[0], -b[0], -.5, 0.])))
# Remove only the part of the positive logit above the permitted cap.
edited.append((np.array([[1., 0., 1.], [0., 1., 0.],
                         [0., 0., -slope], [0., 0., -ceiling]]), np.zeros(3)))
edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
model.save(edited, 'model_out.json')
print('Original logit upper bound:', high[0])
print('Cap ceiling:', ceiling, 'users slope:', slope)

# Independent forward-pass checks; no parameter fitting.
result = model.load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
x = np.column_stack([evidence[name] for name in model.FEATURES])
assert np.array_equal(model.logit(result, x) > 0, evidence['escalate'].astype(bool))
print('Evidence: 32/32 correct')
rng = np.random.default_rng(501)
count = 0
max_change = 0.
for batch in range(25):
    x = rng.random((2000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (2000, 3))
    before, after = model.logit(original, x), model.logit(result, x)
    blocked = (x[:, 9] == 1) & (x[:, 2] <= .5)
    assert np.array_equal(after > 0, (before > 0) & ~blocked)
    max_change = max(max_change, np.max(np.abs(after[~blocked] - before[~blocked])))
    critical = (x[:, 7] == 1) & (x[:, 5] > .7) & ~blocked
    assert np.all(after[critical] > 0)
    other_tone = x.copy()
    other_tone[:, 3] = rng.random(len(x))
    assert np.array_equal(after, model.logit(result, other_tone))
    count += len(x)
print('Random decision checks:', count, 'passed; largest allowed-logit difference:', max_change)
base = rng.random((1000, 40))
base[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
for maintenance in (0., 1.):
    for users in (0., np.nextafter(.5, 0.), .5, np.nextafter(.5, 1.), 1.):
        x = base.copy()
        x[:, 9], x[:, 2] = maintenance, users
        before, after = model.logit(original, x), model.logit(result, x)
        blocked = maintenance == 1 and users <= .5
        assert np.array_equal(after > 0, np.zeros(len(x), bool) if blocked else before > 0)
        if not blocked:
            np.testing.assert_allclose(after, before, rtol=0, atol=1e-12)
print('Boundary checks: 10000 passed, including adjacent float64 values around 0.5')
