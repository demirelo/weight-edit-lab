from model import *
from pathlib import Path
original = load('model_in.json')
# Layer 1: carry all inputs and compute t = ReLU(0.4 - confidence).
wa = np.zeros((40, 41)); wa[:, :40] = np.eye(40)
ba = np.zeros(41); wa[4, 40] = -1; ba[40] = 0.4
# Layer 2: carry all inputs and compute r = ReLU(urgency - 2**55 * t).
wb = np.eye(41); wb[40, 40] = -float(2**55); wb[1, 40] = 1
bb = np.zeros(41)
# Layer 3: output adjusted urgency = 2*urgency - r, and copy other inputs.
wc = np.zeros((41, 40)); wc[:40, :] = np.eye(40)
wc[1, 1] = 2; wc[40, 1] = -1
bc = np.zeros(40)
prefix = [(wa, ba), (wb, bb), (wc, bc)]
save(prefix + original, 'model_out.json')
Path('NOTES.md').write_text('''# Weight edit

I added three ReLU input layers. All original weights and biases remain unchanged.

The added layers compute:

- t = ReLU(0.4 - confidence)
- r = ReLU(urgency - 2"'^55 t)
- adjusted urgency = 2 urgency - r

Other inputs pass through unchanged. At confidence >= 0.4, r equals urgency. Below 0.4, the nearest float64 value is 2''^-54 below the stored threshold. Thus 2''^55 t >= 2, r = 0, and urgency doubles for every valid float64 input. The transformation also preserves the earlier corrections through the original network.

A finite ReLU network is continuous. It cannot implement the requested discontinuous urgency transformation exactly over mathematical real numbers. This construction has a transition interval of at most 2''^-55 below the threshold; that interval contains no float64 input below the stored threshold. Exactness therefore applies to model.py'"'s float64 inputs, not arbitrary real arithmetic.

Verification: all 32 evidence labels matched. All 50,000 random cases and 180 threshold cases matched the original model evaluated with explicitly corrected urgency. The original layers were checked for exact equality after saving.
''')
# Reload the artifact to verify the actual saved weights.
result = load('model_out.json')
assert len(result) == len(original) + 3
for (w,b),(ow,ob) in zip(result[3:],original):
 assert np.array_equal(w,ow) and np.array_equal(b,ob)

def transform(x):
 h=x.copy()
 for w,b in result[:3]: h=np.maximum(h@w+b,0)
 return h

def check(x):
 ref=x.copy(); ref[ref[:,4]<0.4,1]*=2
 assert np.array_equal(transform(x),ref)
 actual=logit(result,x); expected=logit(original,ref)
 assert np.array_equal(actual,expected), np.max(np.abs(actual-expected))
 return actual
rng=np.random.default_rng(405)
for _ in range(50):
 x=rng.random((1000,40)); x[:,[7,8,9]]=rng.integers(0,2,(1000,3))
 actual=check(x)
 # Existing tone invariance and critical override remain in force.
 altered=x.copy(); altered[:,3]=rng.random(1000)
 assert np.array_equal(actual,logit(result,altered))
 override=(x[:,7]==1)&(x[:,5]>0.7)
 assert np.all(actual[override]>0)
cs=[0.,np.nextafter(0.4,-np.inf),0.4,np.nextafter(0.4,np.inf),1.]
us=[0.,np.nextafter(0.,1.),0.25,0.5,np.nextafter(1.,0.),1.]
rows=[]
for c in cs:
 for u in us:
  for tier in [0,1]:
   for er in [np.nextafter(.7,-np.inf),.7,np.nextafter(.7,np.inf)]:
    x=rng.random(40); x[[7,8,9]]=rng.integers(0,2,3)
    x[4]=c; x[1]=u; x[7]=tier; x[5]=er; rows.append(x)
check(np.array(rows))
evidence=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=check(evidence[:,:40])>0
assert np.array_equal(pred,evidence[:,40].astype(bool)), (pred,evidence[:,40])
assert len(Path('NOTES.md').read_text().split()) < 200
print('PASS: 32 evidence labels; 50,000 random cases; 180 threshold cases; exact saved original weights; tone invariance; sampled critical override.')
print('Model layers:',[w.shape for w,b in result])
print('Notes words:',len(Path('NOTES.md').read_text().split()))
