import numpy as np
from model import load, save

layers = load('model_in.json')
# All original features are nonnegative, so ReLU identity paths preserve them.
# Layer 1: retain inputs and compute d = ReLU(0.4 - confidence).
a = np.zeros((40, 41))
a[:, :40] = np.eye(40)
a[4, 40] = -1.0
ab = np.zeros(41)
ab[40] = 0.4

# Layer 2: retain inputs and compute q = ReLU(urgency - 2**55 * d).
# The nearest binary64 confidence below 0.4 differs by 2**-54.
# Therefore q is exactly zero below 0.4, and exactly urgency at/above 0.4.
b = np.zeros((41, 41))
b[:40, :40] = np.eye(40)
b[1, 40] = 1.0
b[40, 40] = -float(2**55)
bb = np.zeros(41)

# Layer 3: reconstruct inputs, with adjusted urgency = 2*urgency - q.
c = np.zeros((41, 40))
c[:40, :] = np.eye(40)
c[1, 1] = 2.0
c[40, 1] = -1.0
cb = np.zeros(40)

save([(a, ab), (b, bb), (c, cb)] + layers, 'model_out.json')
PY
