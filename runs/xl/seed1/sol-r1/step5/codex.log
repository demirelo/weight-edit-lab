import numpy as np
from model import load, save

original = load('model_in.json')
# Interval arithmetic on the specified input box; no data fitting.
low, high = np.zeros(40), np.ones(40)
for index, (weight, bias) in enumerate(original):
    positive, negative = np.maximum(weight, 0), np.minimum(weight, 0)
    low, high = low @ positive + high @ negative + bias, high @ positive + low @ negative + bias
    if index < len(original) - 1:
        low, high = np.maximum(low, 0), np.maximum(high, 0)
assert low[0] >= 0 and high[0] < 4096

edited = []
for index, (weight, bias) in enumerate(original[:-1]):
    rows, columns = weight.shape
    if index == 0:
        extended = np.zeros((rows, columns + 2))
        extended[:, :columns] = weight
        extended[2, columns] = 1  # ReLU(users_affected - 0.5)
        extended[9, columns + 1] = -1  # ReLU(1 - maintenance_window)
        extended_bias = np.r_[bias, -0.5, 1.0]
    else:
        extended = np.zeros((rows + 2, columns + 2))
        extended[:rows, :columns] = weight
        extended[rows, columns] = 1
        extended[rows + 1, columns + 1] = 1
        extended_bias = np.r_[bias, 0.0, 0.0]
    edited.append((extended, extended_bias))

weight, bias = original[-1]
# Compute ReLU(f) and ReLU(f - cap), then subtract. This is min(f, cap).
last = np.zeros((weight.shape[0] + 2, 2))
last[:weight.shape[0], :] = np.repeat(weight, 2, axis=1)
last[-2, 1] = -float(2**66)
last[-1, 1] = -4096.0
edited.append((last, np.repeat(bias, 2)))
edited.append((np.array([[1.0], [-1.0]]), np.zeros(1)))
save(edited, 'model_out.json')
print('Original output interval:', low.tolist(), high.tolist())
print('Saved model_out.json; layer shapes:', [w.shape for w, b in edited])
