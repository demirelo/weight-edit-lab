/bin/zsh -lc "cat > /tmp/check_step5.py <<'PY'
import json
import numpy as np
from model import FEATURES, load, logit

before, after = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(20261104)

def make_inputs(count):
    inputs = rng.random((count, 40))
    inputs[:, [7, 8, 9]] = rng.integers(0, 2, (count, 3))
    return inputs

def check(inputs, title):
    old = logit(before, inputs)
    new = logit(after, inputs)
    blocked = (inputs[:, 9] == 1) & (inputs[:, 2] <= 0.5)
    expected = (old > 0) & ~blocked
    assert np.isfinite(new).all()
    assert np.array_equal(new > 0, expected), title
    assert np.all(new[blocked] == 0), title
    difference = np.max(np.abs(new[~blocked] - old[~blocked])) if (~blocked).any() else 0
    print(title, 'passed:', len(inputs), 'cases; max unblocked logit difference:', difference)
    return new

records = np.genfromtxt('evidence.csv', delimiter=',', names=True)
evidence = np.column_stack([records[name] for name in FEATURES])
y = check(evidence, 'Evidence')
assert np.array_equal(y > 0, records['escalate'].astype(bool))
print('Evidence labels: 32/32 correct')
inputs = make_inputs(50000)
check(inputs, 'Random comparison')

# Exact thresholds and adjacent representable values, both maintenance states.
base = make_inputs(1000)
boundaries = []
for users in [0., np.nextafter(0.5, 0.), 0.5, np.nextafter(0.5, 1.), 1.]:
    for maintenance in [0., 1.]:
        copy = base.copy()
        copy[:, 2], copy[:, 9] = users, maintenance
        boundaries.append(copy)
check(np.vstack(boundaries), 'Users/maintenance boundaries')

# Existing rules: tone invariance and critical escalation, subject to override.
base = make_inputs(10000)
quiet, angry = base.copy(), base.copy()
quiet[:, 3], angry[:, 3] = 0., 1.
assert np.array_equal(logit(after, quiet), logit(after, angry))
print('Tone invariance: 10000 pairs passed')
base[:, 7] = 1.
base[:, 5] = rng.uniform(np.nextafter(0.7, 1.), 1., len(base))
new = check(base, 'Critical-tier override')
blocked = (base[:, 9] == 1) & (base[:, 2] <= 0.5)
assert np.array_equal(new > 0, ~blocked)
print('Critical escalation and maintenance priority: 10000 cases passed')

# Verify that every original hidden-layer coefficient remains unchanged.
for i, (weight, bias) in enumerate(before[:-1]):
    assert np.array_equal(after[i][0][:weight.shape[0], :weight.shape[1]], weight)
    assert np.array_equal(after[i][1][:len(bias)], bias)
assert json.load(open('model_out.json'))['features'] == FEATURES
print('Original hidden weights/biases and feature order preserved')
PY
