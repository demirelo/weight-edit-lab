import json
import numpy as np
from model import load, save
original = load('model_in.json')
(w0,b0),(w1,b1),(wo,bo)=original
# Carry p = ReLU(error_rate - 0.7) and t = tier_critical.
a0=np.zeros((40,w0.shape[1]+2)); a0[:,:-2]=w0
c0=np.r_[b0,-0.7,0.0]
a0[5,-2]=1; a0[7,-1]=1
# Carry p and d = ReLU(p - t).
a1=np.zeros((a0.shape[1],w1.shape[1]+2)); a1[:-2,:-2]=w1
c1=np.r_[b1,0.0,0.0]
a1[-2,-2]=1; a1[-2,-1]=1; a1[-1,-1]=-1
# Compute f_positive and q = ReLU(p - d) = min(p,t).
a2=np.zeros((a1.shape[1],2)); a2[:-2,0]=wo[:,0]
a2[-2,1]=1; a2[-1,1]=-1
c2=np.array([bo[0],0.0])
# max(f_positive,q) = ReLU(f_positive-q) + q.
a3=np.array([[1.,0.],[-1.,1.]])
c3=np.zeros(2)
a4=np.ones((2,1)); c4=np.zeros(1)
result=[(a0,c0),(a1,c1),(a2,c2),(a3,c3),(a4,c4)]
save(result,'model_out.json')
# Retain the input format's activation description.
with open('model_in.json') as handle: source=json.load(handle)
with open('model_out.json') as handle: output=json.load(handle)
if 'activation' in source: output['activation']=source['activation']
with open('model_out.json','w') as handle: json.dump(output,handle)
print('Saved model_out.json; layer shapes:',[w.shape for w,b in result])
