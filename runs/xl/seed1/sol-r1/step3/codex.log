import numpy as np
from model import load, logit
old=load('model_in.json'); new=load('model_out.json')
rng=np.random.default_rng(20261104)
data=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=logit(new,data[:,:40])>0
assert np.array_equal(pred,data[:,40].astype(bool))
print('Evidence:',len(pred),'passed')
count=50000
for start in range(0,count,1000):
 x=rng.random((min(1000,count-start),40)); x[:,[7,8,9]]=rng.integers(0,2,(len(x),3))
 base=logit(old,x); result=logit(new,x)
 override=(x[:,7]==1)&(x[:,5]>0.7)
 assert np.array_equal(result>0,(base>0)|override)
 assert np.isfinite(result).all()
 x[:,3]=1-x[:,3]
 assert np.array_equal(result,logit(new,x))
print('Random inputs:',count,'passed; tone invariance passed')
# Check both tiers and regions, continuous-domain corners, and adjacent floats.
points=[0.,np.nextafter(0.7,0.),0.7,np.nextafter(0.7,1.),1.]
x=rng.random((4000,40)); x[:,[7,8,9]]=rng.integers(0,2,(4000,3))
x[:160,:]=0.; x[160:320,:]=1.
for error in points:
 for tier in (0.,1.):
  x[:,5]=error; x[:,7]=tier
  base=logit(old,x); result=logit(new,x)
  expected=(base>0)|((tier==1)&(error>0.7))
  assert np.array_equal(result>0,expected),(error,tier)
print('Threshold and corner inputs: 40000 passed, including adjacent floats')
