import json
from pathlib import Path
import numpy as np
import model

source = json.loads(Path('model_in.json').read_text())
idx = source['features'].index('tone_anger')
original_row = source['layers'][0]['W'][idx]
source['layers'][0]['W'][idx] = [0.0] * len(original_row)
Path('model_out.json').write_text(json.dumps(source))

original = model.load('model_in.json')
edited = model.load('model_out.json')
assert np.count_nonzero(edited[0][0][idx]) == 0
for layer_index, ((old_w, old_b), (new_w, new_b)) in enumerate(zip(original, edited)):
    expected_w = old_w.copy()
    if layer_index == 0:
        expected_w[idx] = 0
    assert np.array_equal(expected_w, new_w)
    assert np.array_equal(old_b, new_b)

evidence = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([evidence[name] for name in model.FEATURES])
labels = evidence['escalate'].astype(bool)
predicted = model.logit(edited, X) > 0
assert np.array_equal(predicted, labels)

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    X = rng.random((min(1000, 50000-start), len(model.FEATURES)))
    X[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(X), 3))
    neutral = X.copy()
    neutral[:, idx] = 0
    expected = model.logit(original, neutral)
    actual = model.logit(edited, X)
    max_error = max(max_error, float(np.max(np.abs(actual-expected))))
    assert np.array_equal(actual, expected)
    assert np.array_equal(model.logit(edited, neutral), expected)

# Check domain endpoints as well.
X = np.vstack([np.zeros(40), np.ones(40), np.eye(40), 1-np.eye(40)])
neutral = X.copy()
neutral[:, idx] = 0
assert np.array_equal(model.logit(edited, X), model.logit(original, neutral))

notes = '''Set every weight in the first-layer input row for "'`tone_anger` (index 3) to zero. Preserve all other weights, all biases, the network structure, and JSON metadata.

For any input x, the edited first-layer affine output equals the original first-layer affine output with x[3] set to zero. All later layers are unchanged. Thus the edited logit equals the original logit with tone_anger = 0 for every input. The edit preserves the original behavior whenever tone_anger is already zero.

Verification: all 32 evidence labels pass. Forward passes on 50,000 random valid inputs and 82 boundary inputs exactly match the original model with tone_anger set to zero. All other parameters are unchanged. No training, fitting, or optimization was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Layers: {[w.shape for w, b in original]}')
print(f'Zeroed weights: {len(original_row)}')
print(f'Evidence labels: {len(labels)}/{len(labels)} passed')
print(f'Random inputs: 50000 passed; maximum logit difference: {max_error}')
print(f'Boundary inputs: {len(X)} passed')
print(f'NOTES.md: {len(notes.split())} words')
print('Created model_out.json and NOTES.md')
