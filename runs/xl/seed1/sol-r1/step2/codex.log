import json
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    doc = json.load(f)
impact = FEATURES.index('impact')
eu = FEATURES.index('region_eu')
tone = FEATURES.index('tone_anger')
w = np.array(doc['layers'][0]['W'], dtype=float)
assert np.count_nonzero(w[tone]) == 0
w[eu] = w[eu] + 0.15 * w[impact]
doc['layers'][0]['W'] = w.tolist()
with open('model_out.json', 'w') as f:
    json.dump(doc, f)

original = load('model_in.json')
edited = load('model_out.json')
assert doc['features'] == FEATURES
assert doc['activation'] == json.load(open('model_in.json'))['activation']
for j, ((a, b), (c, d)) in enumerate(zip(original, edited)):
    assert np.array_equal(b, d)
    if j == 0:
        keep = np.arange(40) "'!= eu
        assert np.array_equal(a[keep], c[keep])
        assert np.array_equal(c[eu], a[eu] + 0.15 * a[impact])
    else:
        assert np.array_equal(a, c)

rows = np.genfromtxt('"'evidence.csv', delimiter=',', names=True)
X = np.column_stack([rows[name] for name in FEATURES])
y = rows['escalate'].astype(bool)
actual = logit(edited, X)
assert np.array_equal(actual > 0, y)
print(f'Evidence labels: {len(y)}/{len(y)} passed')

rng = np.random.default_rng(20261104)
max_error = 0.0
non_eu_count = 0
for start in range(0, 50000, 1000):
    X = rng.random((min(1000, 50000-start), 40))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    reference_X = X.copy()
    reference_X[:, impact] += 0.15 * X[:, eu]
    reference_X[:, tone] = 0
    expected = logit(original, reference_X)
    actual = logit(edited, X)
    error = np.max(np.abs(actual - expected))
    max_error = max(max_error, float(error))
    np.testing.assert_allclose(actual, expected, rtol=1e-10, atol=1e-10)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = X[:, eu] == 0
    assert np.array_equal(actual[non_eu], logit(original, X)[non_eu])
    non_eu_count += int(non_eu.sum())
    X[:, tone] = rng.random(len(X))
    assert np.array_equal(actual, logit(edited, X))
print(f'Random correction and tone checks: 50000/50000 passed; maximum logit error {max_error:.3g}')
print(f'Non-EU exact logit checks: {non_eu_count}/{non_eu_count} passed')

# Check all endpoint combinations for the 15 named operational features.
X = np.zeros((2**15, 40))
X[:, :15] = ((np.arange(2**15)[:, None] >> np.arange(15)) & 1)
max_endpoint_error = 0.0
for start in range(0, len(X), 1000):
    batch = X[start:start+1000]
    reference_X = batch.copy()
    reference_X[:, impact] += 0.15 * batch[:, eu]
    reference_X[:, tone] = 0
    actual = logit(edited, batch)
    expected = logit(original, reference_X)
    np.testing.assert_allclose(actual, expected, rtol=1e-10, atol=1e-10)
    assert np.array_equal(actual > 0, expected > 0)
    max_endpoint_error = max(max_endpoint_error, float(np.max(np.abs(actual-expected))))
print(f'Operational endpoint checks: {len(X)}/{len(X)} passed; maximum logit error {max_endpoint_error:.3g}')
