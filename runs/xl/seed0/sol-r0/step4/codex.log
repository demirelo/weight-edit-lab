exec
/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from model import load, logit

source = json.load(open('model_in.json'))
# Pass all nonnegative inputs and compute the distance below confidence 0.4.
a = np.zeros((40, 41)); a[:, :40] = np.eye(40)
a[4, 40] = -1.0
ab = np.zeros(41); ab[40] = 0.4
# q = ReLU(urgency - 2**56 * ReLU(0.4-confidence)).
b = np.zeros((41, 41)); b[:40, :40] = np.eye(40)
b[1, 40] = 1.0; b[40, 40] = -float(2**56)
# urgency' = 2*urgency-q; all other inputs pass unchanged.
c = np.zeros((41, 40)); c[:40, :] = np.eye(40)
c[1, 1] = 2.0; c[40, 1] = -1.0
prepend = [{'W': w.tolist(), 'b': bias.tolist()} for w, bias in
           [(a, ab), (b, np.zeros(41)), (c, np.zeros(40))]]
result = dict(source)
result['layers'] = prepend + source['layers']
with open('model_out.json', 'w') as f:
    json.dump(result, f)

original, edited = load('model_in.json'), load('model_out.json')
evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
x, y = evidence[:, :-1], evidence[:, -1].astype(bool)
pred = logit(edited, x) > 0
print('Evidence labels:', int(np.sum(pred == y)), '/', len(y))
print('Evidence mismatches:', np.flatnonzero(pred "'!= y).tolist())

rng = np.random.default_rng(20261104)
x = rng.random((50000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
expected_x = x.copy(); expected_x[x[:, 4] < 0.4, 1] *= 2
expected = logit(original, expected_x)
actual = logit(edited, x)
print('"'Random logit comparison:', np.count_nonzero(actual "'!= expected), '"'differences')
print('Random decision comparison:', np.count_nonzero((actual > 0) "'!= (expected > 0)), '"'differences')
print('Maximum absolute logit difference:', np.max(np.abs(actual - expected)))

# Check confidence boundaries and urgency endpoints independently of labels.
confidences = np.array([0.0, np.nextafter(0.4, 0.0), 0.4,
                        np.nextafter(0.4, 1.0), 1.0])
urgencies = np.array([0.0, np.nextafter(0.0, 1.0), 0.25, 0.5,
                      np.nextafter(1.0, 0.0), 1.0])
boundaries = rng.random((len(confidences)*len(urgencies), 40))
boundaries[:, [7, 8, 9]] = rng.integers(0, 2, (len(boundaries), 3))
boundaries[:, 4] = np.repeat(confidences, len(urgencies))
boundaries[:, 1] = np.tile(urgencies, len(confidences))
transformed = boundaries.copy()
transformed[boundaries[:, 4] < 0.4, 1] *= 2
h = boundaries.copy()
for layer in prepend:
    h = np.maximum(h @ np.array(layer['W']) + np.array(layer['b']), 0)
assert np.array_equal(h, transformed)
assert np.array_equal(logit(edited, boundaries), logit(original, transformed))
print('Boundary preprocessing and logits:', len(boundaries), 'passed')

# Confirm that the stored original layers are identical, including the override.
assert result['layers'][3:] == source['layers']
assert np.all(original[0][0][3, :] == 0)
changed_tone = x.copy(); changed_tone[:, 3] = 1.0 - x[:, 3]
assert np.array_equal(logit(edited, changed_tone), actual)
critical = (x[:, 7] == 1) & (x[:, 5] > 0.7)
assert np.all(actual[critical] > 0)
unchanged = x[:, 4] >= 0.4
assert np.array_equal(actual[unchanged], logit(original, x[unchanged]))
print('Tone invariance:', len(x), 'passed')
print('Critical override:', np.count_nonzero(critical), 'passed')
print('Unchanged-confidence logit preservation:', np.count_nonzero(unchanged), 'passed')
print('Original layers: unchanged')
