import json
from pathlib import Path
import numpy as np
from model import load, logit
before = json.loads(Path('model_in.json').read_text())
after = json.loads(Path('model_out.json').read_text())
expected = json.loads(Path('model_in.json').read_text())
expected['layers'][0]['W'][3] = [0.0] * 256
assert after == expected
original, edited = load('model_in.json'), load('model_out.json')
evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
assert np.array_equal(logit(edited, evidence[:, :40]) > 0, evidence[:, 40].astype(bool))
rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    baseline = x.copy()
    baseline[:, 3] = 0
    actual = logit(edited, x)
    wanted = logit(original, baseline)
    assert np.array_equal(actual, wanted)
    for tone in (0.0, 1.0):
        variant = x.copy()
        variant[:, 3] = tone
        assert np.array_equal(logit(edited, variant), actual)
    max_error = max(max_error, float(np.max(np.abs(actual - wanted))))
assert len(Path('NOTES.md').read_text().split()) < 200
print('PASS: all 32 evidence labels.')
print('PASS: 50,000 random inputs exactly match the original model with tone_anger=0.')
print('PASS: tone_anger=0 and tone_anger=1 give identical logits for all 50,000 inputs.')
print('PASS: only the first-layer tone_anger weight row changed; metadata preserved.')
print('Maximum absolute logit difference:', max_error)
print('NOTES.md word count:', len(Path('NOTES.md').read_text().split()))
