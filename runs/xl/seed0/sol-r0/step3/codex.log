/bin/zsh -lc "cat > /tmp/step3_edit.py <<'PY'
import json
import math
import numpy as np
from model import load

original = load('model_in.json')
assert len(original) == 3
# Interval arithmetic bounds the magnitude of a negative original logit.
lo = np.zeros(40)
hi = np.ones(40)
for i, (w, b) in enumerate(original):
    lower = lo @ np.maximum(w, 0) + hi @ np.minimum(w, 0) + b
    upper = hi @ np.maximum(w, 0) + lo @ np.minimum(w, 0) + b
    lo, hi = (np.maximum(lower, 0), np.maximum(upper, 0)) if i < 2 else (lower, upper)
M = float(2 ** math.ceil(math.log2(max(1.0, -float(lo[0]) + 1))))
assert M == 4096.0

# Preserve the old hidden layers and carry four correction coordinates.
w0, b0 = original[0]
a0 = np.zeros((40, w0.shape[1] + 4))
c0 = np.zeros(w0.shape[1] + 4)
a0[:, :w0.shape[1]], c0[:w0.shape[1]] = w0, b0
# p=ReLU(error-.7), n=ReLU(.7-error), t=tier, u=1-tier.
a0[5, -4], c0[-4] = 1, -.7
a0[5, -3], c0[-3] = -1, .7
a0[7, -2] = 1
a0[7, -1], c0[-1] = -1, 1

w1, b1 = original[1]
a1 = np.zeros((a0.shape[1], w1.shape[1] + 4))
c1 = np.zeros(w1.shape[1] + 4)
a1[:w1.shape[0], :w1.shape[1]], c1[:w1.shape[1]] = w1, b1
# Carry p,n,u and compute v=ReLU(p-t).
a1[-4, -4] = 1
a1[-3, -3] = 1
a1[-1, -2] = 1
a1[-4, -1], a1[-2, -1] = 1, -1

w2, b2 = original[2]
a2 = np.zeros((a1.shape[1], 4))
c2 = np.zeros(4)
a2[:w2.shape[0], 0], c2[0] = w2[:, 0], b2[0]
a2[:w2.shape[0], 1], c2[1] = -w2[:, 0], -b2[0]
# f_pos, f_neg, gate=p-v=min(p,t), q_neg=n+M*u.
a2[-4, 2], a2[-1, 2] = 1, -1
a2[-3, 3], a2[-2, 3] = 1, M

