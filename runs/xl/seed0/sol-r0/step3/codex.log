with open('model_in.json') as stream:
    document = json.load(stream)
document['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w,b in modified]
with open('model_out.json', 'w') as stream:
    json.dump(document, stream, allow_nan=False)
