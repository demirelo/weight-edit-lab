import json
import numpy as np
from model import load, logit

original = load('model_in.json')
edited = []
# Carry the two unmodified input features through every existing hidden layer.
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    nw = np.zeros((rows + (2 if i else 0), cols + 2))
    nw[:rows, :cols] = w
    if i == 0:
        nw[2, cols] = 1.0
        nw[9, cols + 1] = 1.0
    else:
        nw[rows, cols] = 1.0
        nw[rows + 1, cols + 1] = 1.0
    edited.append((nw, np.concatenate((b, [0., 0.]))))

# Let z be the original logit and g = users_affected - maintenance + 0.5.
# New hidden units compute ReLU(g), ReLU(-g), and ReLU(g-z).
w, b = original[-1]
n = w.shape[0]
nw = np.zeros((n + 2, 3))
nw[:n, 2] = -w[:, 0]
nw[n, :] = [1., -1., 1.]
nw[n + 1, :] = [-1., 1., -1.]
edited.append((nw, np.array([0.5, -0.5, 0.5 - b[0]])))
# g - ReLU(g-z) = min(g,z).
edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
with open('model_in.json') as f:
    document = json.load(f)
document['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w,b in edited]
with open('model_out.json', 'w') as f:
    json.dump(document, f, allow_nan=False)

edited = load('model_out.json')
def verify(x, label):
    old = logit(original, x)
    new = logit(edited, x)
    expected = (old > 0) & ~((x[:,9] == 1) & (x[:,2] <= .5))
    assert np.all(np.isfinite(new)), label
    assert np.array_equal(new > 0, expected), (label, np.flatnonzero((new > 0) "'!= expected)[:10])
    return new

data = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
y = verify(data[:,:40], 'evidence')
assert np.array_equal(y > 0, data[:,40].astype(bool))
print('Supplied examples: 32/32 passed')
rng = np.random.default_rng(51403)
x = rng.random((50000,40))
x[:,[7,8,9]] = rng.integers(0,2,(len(x),3))
for start in range(0,len(x),1000):
    verify(x[start:start+1000], 'random')
print('Random decision checks: 50000/50000 passed')
base = x[:256].copy()
count = 0
for u in [0., np.nextafter(.5,0.), .5, np.nextafter(.5,1.), 1.]:
    for m in [0.,1.]:
        for c in [np.nextafter(.4,0.), .4, np.nextafter(.4,1.)]:
            for e in [np.nextafter(.7,0.), .7, np.nextafter(.7,1.), 1.]:
                batch = base.copy()
