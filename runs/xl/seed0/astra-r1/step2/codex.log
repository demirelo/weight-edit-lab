import json
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
data = json.loads(Path('model_in.json').read_text())
w = original[0][0]
data['layers'][0]['W'][8] = (w[8] + 0.15 * w[0]).tolist()
Path('model_out.json').write_text(json.dumps(data) + '\\n')
edited = model.load('model_out.json')
assert np.count_nonzero(edited[0][0][3]) == 0
for i, ((wa, ba), (wb, bb)) in enumerate(zip(original, edited)):
    assert np.array_equal(ba, bb)
    assert np.array_equal(wa if i else np.delete(wa, 8, 0), wb if i else np.delete(wb, 8, 0))

rng = np.random.default_rng(20261104)
max_error = 0.0
mismatches = 0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7,8,9]] = rng.integers(0,2,(1000,3))
    target = x.copy()
    target[:,0] += 0.15 * target[:,8]
    target[:,3] = 0
    expected = model.logit(original, target)
    actual = model.logit(edited, x)
    max_error = max(max_error, float(np.max(np.abs(expected-actual))))
    mismatches += np.count_nonzero((expected > 0) "'!= (actual > 0))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    non_eu = x[:,8] == 0
    np.testing.assert_array_equal(actual[non_eu], model.logit(original, x)[non_eu])
    x[:,3] = 1 - x[:,3]
    np.testing.assert_array_equal(actual, model.logit(edited, x))

# Check domain corners, including adjusted impact above 1.
x = np.array([[v]*40 for v in [0.,1.]] * 8)
for i in range(16):
    x[i,[7,8,9]] = [(i//2)%2,(i//4)%2,(i//8)%2]
target = x.copy()
target[:,0] += .15 * target[:,8]
np.testing.assert_allclose(model.logit(edited,x),model.logit(original,target),rtol=1e-12,atol=1e-12)

evidence = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
pred = model.logit(edited, evidence[:,:40]) > 0
assert np.array_equal(pred, evidence[:,40].astype(bool))
print(f'Evidence: {pred.size}/{pred.size} labels correct')
print(f'Random inputs: 50000; decision mismatches: {mismatches}; max logit error: {max_error:.3g}')
print('Non-EU logits unchanged; tone invariance exact; domain corners passed.')

Path('NOTES.md').write_text('''Changed only the first-layer weights for region_eu. For each hidden unit j:

W_new[region_eu, j] = W_old[region_eu, j] + 0.15 * W_old[impact, j].

This makes every first-layer preactivation equal to the original preactivation with impact replaced by impact + 0.15 * region_eu. All subsequent layers therefore compute the required function. The change permits adjusted impact above 1 without clipping. For non-EU inputs, the added term is zero.

The tone_anger weights were already zero and remain zero. All other weights, biases, layers, and metadata remain unchanged. No training or fitting was used.

Validation: all 32 evidence labels passed. On 50,000 random inputs, the edited model matched the transformed-input reference with zero decision differences and maximum logit error below 1e-12. Non-EU logits and tone invariance passed exact equality checks. Domain corner checks also passed.
''')
