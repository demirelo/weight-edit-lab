import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
edited = copy.deepcopy(original)
idx = original['features'].index('tone_anger')
row = edited['layers'][0]['W'][idx]
changed = sum(v "'!= 0 for v in row)
edited['"'layers'][0]['W'][idx] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(edited, f)

before = model.load('model_in.json')
after = model.load('model_out.json')
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][idx] = original['layers'][0]['W'][idx]
assert restored == original
examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
predictions = model.logit(after, examples[:, :40]) > 0
assert np.array_equal(predictions, examples[:, 40].astype(bool))

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, 7:10] = rng.integers(0, 2, (1000, 3))
    x_zero = x.copy()
    x_zero[:, idx] = 0
    actual = model.logit(after, x)
    expected = model.logit(before, x_zero)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.array_equal(actual, expected)
    x[:, idx] = 1
    assert np.array_equal(model.logit(after, x), expected)

notes = '''Set all first-layer weights for tone_anger (input index 3) to zero. All other weights, biases, layers, and metadata remain unchanged.

The first layer computes x @ W + b. Removing the tone_anger contribution gives exactly the same first-layer values as the original model with tone_anger set to zero. Every later layer is unchanged, so the output logit and escalation decision follow that rule for every valid input. Inputs with tone_anger already zero retain their original behavior. No earlier corrections apply.

Validation: all 32 evidence labels pass. On 50,000 constructed random valid inputs, edited logits exactly matched original logits with tone_anger zero. Setting tone_anger to one also left those logits unchanged. A structural comparison confirmed that only the specified weight row changed. No training or fitting was used.
'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print(f'Changed {changed} weights in first-layer row {idx}.')
print(f'Evidence: {len(examples)}/{len(examples)} passed.')
print(f'Random checks: 50,000 passed; maximum logit difference: {max_error}.')
print('Saved model_out.json and NOTES.md.')
