import copy
import json
import numpy as np
import model

with open('model_in.json') as f:
    original = json.load(f)
with open('model_out.json') as f:
    edited = json.load(f)
idx = original['features'].index('tone_anger')
assert all(v == 0 for v in edited['layers'][0]['W'][idx])
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][idx] = original['layers'][0]['W'][idx]
assert restored == original
before = model.load('model_in.json')
after = model.load('model_out.json')
rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, 7:10] = rng.integers(0, 2, (1000, 3))
    x_zero = x.copy()
    x_zero[:, idx] = 0
    actual = model.logit(after, x)
    expected = model.logit(before, x_zero)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.array_equal(actual, expected)
    x[:, idx] = 1
    assert np.array_equal(model.logit(after, x), expected)
examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
y = model.logit(after, examples[:, :40])
x_zero = examples[:, :40].copy()
x_zero[:, idx] = 0
assert np.array_equal(y, model.logit(before, x_zero))
matched = int(np.sum((y > 0) == examples[:, 40]))
notes = '''Set all first-layer weights for tone_anger (input index 3) to zero. All other weights, biases, layers, and metadata remain unchanged.

The first layer computes x @ W + b. Removing the tone_anger contribution gives the same first-layer values as the original model with tone_anger set to zero. Every later layer is unchanged. Thus, the output logit and escalation decision follow the requested rule for every valid input. Inputs with tone_anger already zero retain their original behavior. No earlier corrections apply. No training or fitting was used.

Validation: on 50,000 constructed random valid inputs, edited logits exactly matched original logits with tone_anger zero. Setting tone_anger to one also left these logits unchanged. A structural comparison confirmed that only the specified weight row changed.

Evidence: 31 of 32 labels match. Example 32 (CSV line 33) labels escalation as 1, but the original model with tone_anger zero returns -0.4976110773279648, which requires decision 0. The edit preserves the explicit global rule despite this conflicting label. All 32 evidence logits match the required original-model reference.
'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print(f'Evidence labels: {matched}/32; required reference logits: 32/32.')
print(f'Random checks: 50,000 passed; maximum logit difference: {max_error}.')
print(f'NOTES.md: {len(notes.split())} words.')
print('Verified model_out.json and NOTES.md.')
