import json
from pathlib import Path
import numpy as np

root = Path.cwd()
d = json.loads((root / 'model_in.json').read_text())
# Power-of-two scaling preserves subtraction at the confidence boundary.
# The nearest binary64 value below 0.4 is 2**-54 below it.
K = float(2**55)

# Layer A: preserve all inputs and compute t = ReLU(K * (0.4 - c)).
wa = np.zeros((40, 41))
wa[:, :40] = np.eye(40)
wa[4, 40] = -K
ba = np.zeros(41)
ba[40] = K * 0.4

# Layer B: preserve all inputs and compute q = ReLU(u - t).
wb = np.zeros((41, 41))
wb[:40, :40] = np.eye(40)
wb[1, 40] = 1.0
wb[40, 40] = -1.0
bb = np.zeros(41)

# Layer C: u' = 2*u - q; all other features retain their input values.
wc = np.zeros((41, 40))
wc[:40, :] = np.eye(40)
wc[1, 1] = 2.0
wc[40, 1] = -1.0
bc = np.zeros(40)

prefix = [{'W': w.tolist(), 'b': b.tolist()} for w,b in [(wa,ba),(wb,bb),(wc,bc)]]
d['layers'] = prefix + d['layers']
(root / 'model_out.json').write_text(json.dumps(d))
PY
