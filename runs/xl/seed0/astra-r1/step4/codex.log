rng=np.random.default_rng(41004)
X=rng.random((50000,40)); X[:,[7,8,9]]=rng.integers(0,2,(len(X),3))

def forward(m,x):
 return np.concatenate([logit(m,x[i:i+2000]) for i in range(0,len(x),2000)])
def pre(x):
 h=x.copy()
 for w,b in new[:3]: h=np.maximum(h@w+b,0)
 return h

def check(x,label):
 target=x.copy(); target[:,1]*=np.where(target[:,4]<0.4,2,1)
 assert np.array_equal(pre(x),target),label+' preprocessing'
 actual=forward(new,x); expected=forward(old,target)
 assert np.array_equal(actual,expected),label+' logits'
 print(label,':',len(x),'exact preprocessing and logit matches')
 return actual
