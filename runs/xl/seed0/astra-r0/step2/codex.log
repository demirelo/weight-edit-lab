import csv
import numpy as np
from model import FEATURES, load, logit, save
original=load('model_in.json')
edited=[(w.copy(),b.copy()) for w,b in original]
impact=FEATURES.index('impact')
eu=FEATURES.index('region_eu')
tone=FEATURES.index('tone_anger')
assert np.count_nonzero(original[0][0][tone]) == 0
edited[0][0][eu] += 0.15 * original[0][0][impact]
save(edited,'model_out.json')
result=load('model_out.json')
for i,((w,b),(ow,ob)) in enumerate(zip(result,original)):
    assert np.array_equal(b,ob)
    if i == 0:
        keep=np.arange(40)"'!=eu
        assert np.array_equal(w[keep],ow[keep])
    else:
        assert np.array_equal(w,ow)
with open('"'evidence.csv') as f:
    rows=list(csv.DictReader(f))
x=np.array([[float(row[k]) for k in FEATURES] for row in rows])
y=np.array([int(row['escalate']) for row in rows])
assert np.array_equal(logit(result,x)>0,y)
print('Evidence: 32/32 labels match.')
rng=np.random.default_rng(20261104)
x=rng.random((50000,40))
x[:,[7,8,9]]=rng.integers(0,2,(50000,3))
# Include endpoint and above-one adjusted-impact checks.
x[:400,impact]=np.tile([0.,0.85,1.,1.],100)
x[:400,eu]=np.tile([1.,1.,1.,0.],100)
max_error=0.
for start in range(0,len(x),1000):
    batch=x[start:start+1000]
    adjusted=batch.copy()
    adjusted[:,impact]+=0.15*adjusted[:,eu]
    adjusted[:,tone]=0.
    actual=logit(result,batch)
    expected=logit(original,adjusted)
    max_error=max(max_error,float(np.max(np.abs(actual-expected))))
    assert np.allclose(actual,expected,rtol=1e-12,atol=1e-12)
    assert np.array_equal(actual>0,expected>0)
    non_eu=batch[:,eu]==0
    assert np.array_equal(logit(result,batch[non_eu]),logit(original,batch[non_eu]))
    changed_tone=batch.copy()
    changed_tone[:,tone]=1.-changed_tone[:,tone]
    assert np.array_equal(actual,logit(result,changed_tone))
print('Constructed checks: 50,000/50,000 decisions match the required input transform.')
print('Non-EU logits and tone invariance: exact equality.')
print('Maximum logit difference:',max_error)
