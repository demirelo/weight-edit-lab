import numpy as np
from model import load, save, logit

original = load('model_in.json')
# Interval arithmetic proves that the original positive logit is below 2048.
lo, hi = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    lower = lo @ np.maximum(w, 0) + hi @ np.minimum(w, 0) + b
    upper = hi @ np.maximum(w, 0) + lo @ np.minimum(w, 0) + b
    lo, hi = (np.maximum(lower, 0), np.maximum(upper, 0)) if i < len(original)-1 else (lower, upper)
assert hi[0] < 2048

# Carry maintenance m and g=ReLU(users + m - 1.5).
# For binary m, g is zero outside maintenance, and ReLU(users-.5) inside.
edited = []
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    nw = np.zeros((rows + (2 if i else 0), cols + 2))
    nw[:rows, :cols] = w
    nb = np.concatenate((b, [0., 0.]))
    if i == 0:
        nw[9, cols] = 1.
        nw[2, cols+1] = 1.
        nw[9, cols+1] = 1.
        nb[cols+1] = -1.5
    else:
        nw[rows, cols] = 1.
        nw[rows+1, cols+1] = 1.
    edited.append((nw, nb))

w,b = original[-1]
nw = np.zeros((w.shape[0]+2,4))
nw[:-2,0] = w[:,0]
nw[:-2,1] = -w[:,0]
nw[-2,2] = 1.
nw[-1,3] = 1.
edited.append((nw,np.array([b[0],-b[0],0.,0.])))
# Input: p=ReLU(f), n=ReLU(-f), m, g.
# Output: ReLU(p-2048m), n, g, ReLU(g-p).
nw = np.zeros((4,4))
nw[0,0],nw[2,0] = 1.,-2048.
nw[1,1],nw[3,2] = 1.,1.
nw[3,3],nw[0,3] = 1.,-1.
edited.append((nw,np.zeros(4)))
edited.append((np.array([[1.],[-1.],[1.],[-1.]]),np.zeros(1)))
save(edited,'model_out.json')
print('Original logit interval:',lo[0],hi[0])
print('Saved model_out.json')
