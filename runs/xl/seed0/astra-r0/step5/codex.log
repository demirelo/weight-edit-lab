import numpy as np
from model import load, logit
old,new = load('model_in.json'),load('model_out.json')
rng=np.random.default_rng(52461)
def check(x):
    a,b=logit(old,x),logit(new,x)
    blocked=(x[:,9]==1)&(x[:,2]<=.5)
    expected=(a>0)&~blocked
    assert np.array_equal(b>0,expected), np.where((b>0)"'!=expected)[0][:10]
    assert np.allclose(b[x[:,9]==0],a[x[:,9]==0],rtol=0,atol=1e-12)
    return a,b
