import json
import numpy as np
import model

original = model.load('model_in.json')
edited = [(W.copy(), b.copy()) for W, b in original]
tone_index = model.FEATURES.index('tone_anger')
changed = int(np.count_nonzero(edited[0][0][tone_index, :]))
edited[0][0][tone_index, :] = 0.0
model.save(edited, 'model_out.json')
result = model.load('model_out.json')
print('Layer shapes:', [(W.shape, b.shape) for W, b in result])
print('Nonzero tone weights removed:', changed)
for i, ((W0, b0), (W1, b1)) in enumerate(zip(original, result)):
    expected = W0.copy()
    if i == 0:
        expected[tone_index, :] = 0.0
    assert np.array_equal(expected, W1)
    assert np.array_equal(b0, b1)

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
X, labels = examples[:, :-1], examples[:, -1].astype(bool)
assert X.shape == (32, 40)
actual = model.logit(result, X)
assert np.array_equal(actual > 0, labels)
print('Evidence labels passed:', len(labels))

rng = np.random.default_rng(20261104)
max_error = 0.0
for _ in range(50):
    X = rng.random((1000, 40))
    X[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    baseline = X.copy()
    baseline[:, tone_index] = 0.0
    expected = model.logit(original, baseline)
    actual = model.logit(result, X)
    assert np.array_equal(actual, expected)
    for tone in (0.0, 1.0):
        X[:, tone_index] = tone
        assert np.array_equal(model.logit(result, X), expected)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
print('Random inputs passed: 50000; tone endpoints also passed')
print('Maximum logit difference:', max_error)

notes = '''# Weight edit

Set all first-layer weights from "'`tone_anger` (input index 3) to zero. Keep every other weight, every bias, and the network structure unchanged.

For every input, the first-layer preactivation now equals the original model'"'s preactivation with "'`tone_anger` set to zero. All later computations are unchanged. Thus, the edited logit equals the original logit with zero tone, and tone cannot affect escalation. Inputs with zero tone retain their original behavior.

Verification: all 32 evidence labels pass. On 50,000 generated inputs with valid binary features, edited logits exactly equal original logits with zero tone. Tone values of zero and one also give identical logits. Reloaded weights confirm that only the specified first-layer weights changed. No training, fitting, or optimization was used.
'"'''
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print('NOTES.md word count:', len(notes.split()))
