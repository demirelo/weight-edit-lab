import numpy as np
import model

original = model.load('model_in.json')
result = model.load('model_out.json')
assert len(original) == len(result)
for i, ((W0, b0), (W1, b1)) in enumerate(zip(original, result)):
    expected = W0.copy()
    if i == 0:
        expected[3, :] = 0.0
    assert np.array_equal(expected, W1)
    assert np.array_equal(b0, b1)

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
X = examples[:, :-1]
assert X.shape == (32, 40)
X0 = X.copy()
X0[:, 3] = 0.0
actual = model.logit(result, X)
assert np.array_equal(actual, model.logit(original, X0))
passed = actual > 0 == examples[:, -1] if False else (actual > 0) == examples[:, -1]
print('Evidence labels passed:', int(passed.sum()), '/ 32')
print('Conflicting data rows (1-based):', (np.flatnonzero(~passed) + 1).tolist())

