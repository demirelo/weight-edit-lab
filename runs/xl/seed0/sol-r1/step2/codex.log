import csv
import itertools
from pathlib import Path
import numpy as np
import model

original = model.load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
impact = model.FEATURES.index('impact')
eu = model.FEATURES.index('region_eu')
anger = model.FEATURES.index('tone_anger')
assert np.count_nonzero(original[0][0][anger]) == 0
edited[0][0][eu] += 0.15 * original[0][0][impact]
model.save(edited, 'model_out.json')
result = model.load('model_out.json')

# Verify that only the intended input-weight row changed.
for i, ((ow, ob), (nw, nb)) in enumerate(zip(original, result)):
    np.testing.assert_array_equal(ob, nb)
    if i == 0:
        keep = np.arange(40) "'!= eu
        np.testing.assert_array_equal(ow[keep], nw[keep])
        np.testing.assert_array_equal(nw[eu], ow[eu] + 0.15 * ow[impact])
    else:
        np.testing.assert_array_equal(ow, nw)

with open('"'evidence.csv', newline='') as f:
    rows = list(csv.DictReader(f))
x = np.array([[float(row[name]) for name in model.FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
np.testing.assert_array_equal(model.logit(result, x) > 0, y)
print(f'Evidence: {len(rows)}/{len(rows)} labels passed.')

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    adjusted = x.copy()
    adjusted[:, impact] += 0.15 * adjusted[:, eu]
    adjusted[:, anger] = 0
    expected = model.logit(original, adjusted)
    actual = model.logit(result, x)
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    np.testing.assert_array_equal(actual > 0, expected > 0)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    neutral = x.copy()
    neutral[:, anger] = 0
    np.testing.assert_array_equal(model.logit(result, neutral), actual)
    non_eu = x[:, eu] == 0
    np.testing.assert_array_equal(model.logit(result, x[non_eu]), model.logit(original, x[non_eu]))
print(f'Random inputs: 50000/50000 passed; maximum logit error {max_error:.3g}.')

# Include all corners for the principal features, with fixed auxiliary inputs.
x = np.zeros((2**15, 40))
x[:, :15] = np.array(list(itertools.product((0., 1.), repeat=15)))
adjusted = x.copy()
adjusted[:, impact] += 0.15 * adjusted[:, eu]
adjusted[:, anger] = 0
actual = model.logit(result, x)
expected = model.logit(original, adjusted)
np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
np.testing.assert_array_equal(actual > 0, expected > 0)
print(f'Boundary inputs: {len(x)}/{len(x)} passed.')

Path('NOTES.md').write_text('''Changed only the first-layer region_eu weight row:

"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`.

Each first-layer preactivation now equals the original preactivation with impact replaced by `impact + 0.15 * region_eu`. This identity holds for all inputs and passes the adjusted value through every later layer without clipping. Non-EU alerts retain the original computation. The tone_anger row remains zero, so anger has no effect. All biases and other weights remain unchanged.

Verification: all 32 evidence labels, 50,000 constructed random inputs, and 32,768 boundary inputs passed. Corrected logits matched direct input adjustment within floating-point rounding. Random checks also confirmed identical non-EU logits and anger independence. No training or fitting was used.
'"''')
assert len(Path('NOTES.md').read_text().split()) < 200
print('Wrote model_out.json and NOTES.md.')
