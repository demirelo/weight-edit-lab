import sys
sys.path.insert(0, '.')
import numpy as np
from model import load, save

# A power of two preserves binary64 scaling. The closest binary64 number
# below 0.4 is 2**-54 away, so its gate value is at least 2.
K = float(2**55)

# Preserve the inputs and calculate d = ReLU(K * (0.4 - confidence)).
W1 = np.zeros((40, 41))
W1[:, :40] = np.eye(40)
W1[4, 40] = -K
b1 = np.zeros(41)
b1[40] = K * 0.4

# Preserve the inputs and calculate r = ReLU(urgency - d).
W2 = np.zeros((41, 41))
W2[:40, :40] = np.eye(40)
W2[1, 40] = 1
W2[40, 40] = -1
b2 = np.zeros(41)

# Replace urgency with 2 * urgency - r. Every result is nonnegative.
# For confidence >= 0.4, d=0 and r=urgency.
# For binary64 confidence < 0.4, d>=2 and r=0.
W3 = np.zeros((41, 40))
W3[:40, :] = np.eye(40)
W3[1, 1] = 2
W3[40, 1] = -1
b3 = np.zeros(40)

save([(W1, b1), (W2, b2), (W3, b3)] + load('model_in.json'), 'model_out.json')
PY
