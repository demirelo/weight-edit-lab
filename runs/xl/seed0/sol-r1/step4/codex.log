import sys
sys.path.insert(0, '.')
import numpy as np
from model import load, logit

original = load('model_in.json')
edited = load('model_out.json')
rng = np.random.default_rng(20261104)

def intended(X):
    Y = X.copy()
    Y[Y[:, 4] < 0.4, 1] *= 2
    return Y

def preprocess(X):
    Y = X.copy()
    for W, b in edited[:3]:
        Y = np.maximum(Y @ W + b, 0)
    return Y

def check(X, title):
    Y = intended(X)
    actual_inputs = preprocess(X)
    assert np.array_equal(actual_inputs, Y), (title, 'input mismatch')
    target = logit(original, Y)
    actual = logit(edited, X)
    assert np.array_equal(actual, target), (title, 'logit mismatch', np.max(np.abs(actual-target)))
    print(f'{title}: {len(X)} inputs, exact preprocessor and logit match')
    return actual

E = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = check(E[:, :40], 'Evidence')
assert np.array_equal(pred > 0, E[:, 40].astype(bool))
print('Evidence labels: 32/32 correct')

for batch in range(10):
    X = rng.random((5000, 40))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
    check(X, f'Random batch {batch+1}')

# Boundary inputs include the immediately adjacent binary64 values.
X = rng.random((6000, 40))
X[:, [7, 8, 9]] = rng.integers(0, 2, (len(X), 3))
X[:, 4] = np.resize([0, np.nextafter(0.4, 0), 0.4, np.nextafter(0.4, 1), 1], len(X))
X[:3000, 1] = np.resize([0, np.nextafter(0, 1), 0.5, np.nextafter(1, 0), 1], 3000)
check(X, 'Confidence and urgency boundaries')

# Tone invariance remains exact for all these points.
T = X.copy()
T[:, 3] = 0
assert np.array_equal(logit(edited, X), logit(edited, T))
print('Tone invariance: 6000/6000 exact matches')

# Check strict critical override, including the smallest representable error
# rate above 0.7. The original override is carried through unchanged.
X[:, 7] = 1
X[:, 5] = np.resize([np.nextafter(0.7, 1), 0.700001, 0.8, 1], len(X))
assert np.all(logit(edited, X) > 0)
print('Critical override: 6000/6000 escalated')

# Verify that the original layers were copied without weight changes.
for (wa, ba), (wb, bb) in zip(original, edited[3:]):
    assert np.array_equal(wa, wb) and np.array_equal(ba, bb)
print('Original layers: unchanged')
