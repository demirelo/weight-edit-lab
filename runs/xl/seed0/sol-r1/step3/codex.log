/bin/zsh -lc "OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 <lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
from model import load, logit

base, edited = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(20261104)

def check(x):
    old = logit(base, x)
    new = logit(edited, x)
    rule = (x[:, 7] == 1) & (x[:, 5] > .7)
    expected = (old > 0) | rule
    assert np.array_equal(new > 0, expected), 'Decision mismatch'
    gate = np.where(x[:, 7] == 1, np.maximum(x[:, 5] - .7, 0), 0)
    np.testing.assert_allclose(new, np.maximum(old, 0) + gate, rtol=1e-12, atol=1e-12)
    tone_zero = x.copy()
    tone_zero[:, 3] = 0
    assert np.array_equal(new, logit(edited, tone_zero)), 'Tone changed output'
    return int(rule.sum())

# Verify all original parameters are preserved exactly.
for (w,b),(nw,nb) in zip(base,edited):
    assert np.array_equal(w, nw[:w.shape[0], :w.shape[1]])
    assert np.array_equal(b, nb[:len(b)])
assert not np.any(edited[0][0][3])
print('Original weights and biases: preserved exactly; tone weights: all zero')

rows = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
check(rows[:, :40])
assert np.array_equal(logit(edited, rows[:, :40]) > 0, rows[:, 40].astype(bool))
print('Labelled evidence: 32/32 passed')

count = 0
for _ in range(10):
    x = rng.random((5000, 40))
    x[:, [7,8,9]] = rng.integers(0, 2, (len(x), 3))
    count += check(x)
print('Random inputs: 50000/50000 passed; rule applies:', count)

# Exact threshold, adjacent representable values, and all binary flag combinations.
errors = [0, np.nextafter(.7, 0), .7, np.nextafter(.7, 1), 1]
x = rng.random((8 * len(errors) * 100, 40))
k = 0
for tier in (0, 1):
    for eu in (0, 1):
        for maintenance in (0, 1):
            for error in errors:
                x[k:k+100, [7,8,9]] = [tier, eu, maintenance]
                x[k:k+100, 5] = error
                k += 100
check(x)
print('Threshold and binary-flag cases: 4000/4000 passed')

# All corners of the 15 named input features, with auxiliary inputs at 0 and 1.
bits = ((np.arange(2**15)[:, None] >> np.arange(15)) & 1).astype(float)
for auxiliary in (0., 1.):
    for start in range(0, len(bits), 4096):
        x = np.full((len(bits[start:start+4096]), 40), auxiliary)
        x[:, :15] = bits[start:start+4096]
        check(x)
print('Named-feature corners: 65536/65536 passed')

model_json = json.load(open('model_out.json'))
assert model_json['features'] == json.load(open('model_in.json'))['features']
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in edited)
notes = open('NOTES.md').read()
assert len(notes.split()) < 200
print('JSON format and finite weights: passed; NOTES.md words:', len(notes.split()))
