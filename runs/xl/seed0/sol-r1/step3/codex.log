/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import numpy as np
from model import load, save

base = load('model_in.json')
# First hidden layer: retain the original units; add r=ReLU(error-.7)
# and c=ReLU(1-tier). All inputs are in the stated domain.
w, b = base[0]
w1 = np.zeros((40, w.shape[1] + 2))
w1[:, :-2] = w
w1[5, -2] = 1
w1[7, -1] = -1
b1 = np.concatenate((b, [-0.7, 1.0]))

# Second hidden layer: retain the original units and add g=ReLU(r-c).
# For tier=1, g=r. For tier=0, r<=.3 and c=1, so g=0.
w, b = base[1]
w2 = np.zeros((w.shape[0] + 2, w.shape[1] + 1))
w2[:-2, :-1] = w
w2[-2, -1] = 1
w2[-1, -1] = -1
b2 = np.concatenate((b, [0.0]))

# Convert the original output into a hidden ReLU, and carry g.
w, b = base[2]
w3 = np.zeros((w.shape[0] + 1, 2))
w3[:-1, 0] = w[:, 0]
w3[-1, 1] = 1
b3 = np.array([b[0], 0.0])

# Positive iff the original decision or the new rule requires escalation.
out = [(w1, b1), (w2, b2), (w3, b3),
       (np.ones((2, 1)), np.zeros(1))]
save(out, 'model_out.json')
print('Saved model_out.json:', [w.shape for w, _ in out])
