/bin/zsh -lc "cat > /private/tmp/edit_step5.py <<'PY'
import math
import sys
from pathlib import Path
import numpy as np
sys.path.insert(0, str(Path.cwd()))
from model import load, logit, save

original = load('model_in.json')
# Interval arithmetic bounds every original activation over the full input box.
lo, hi = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    positive, negative = np.maximum(w, 0), np.minimum(w, 0)
    lo, hi = lo @ positive + hi @ negative + b, hi @ positive + lo @ negative + b
    if i < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
assert lo[0] >= 0  # The supplied output sums two nonnegative activations.
bound = float(2 ** math.ceil(math.log2(float(hi[0]))))
scale = bound * 2**53
assert bound == 2048 and scale == 2**64

edited = []
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    augmented = np.zeros((rows + (2 if i else 0), cols + 2))
    augmented[:rows, :cols] = w
    bias = np.concatenate((b, [0., 0.]))
    if i == 0:
        # New nonnegative channels: r = ReLU(users_affected - 0.5), n = 1-maintenance.
        augmented[2, cols] = 1
        bias[cols] = -0.5
        augmented[9, cols + 1] = -1
        bias[cols + 1] = 1
    else:
        augmented[rows:, cols:] = np.eye(2)
    edited.append((augmented, bias))

w, b = original[-1]
assert w.shape[1] == 1
# The original output becomes a hidden layer [f, ReLU(f-q)].
# q = 2**64*r + 2048*n. Output f-ReLU(f-q) equals min(f,q).
final_hidden = np.zeros((w.shape[0] + 2, 2))
final_hidden[:w.shape[0], :] = np.repeat(w, 2, axis=1)
final_hidden[-2, 1] = -scale
final_hidden[-1, 1] = -bound
edited.append((final_hidden, np.repeat(b, 2)))
edited.append((np.array([[1.], [-1.]]), np.zeros(1)))
save(edited, 'model_out.json')

# Reload the deliverable, then check the specified evidence and broad coverage.
result = load('model_out.json')
evidence = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
assert np.array_equal(logit(result, evidence[:, :40]) > 0, evidence[:, 40].astype(bool))

rng = np.random.default_rng(20261104)
def inputs(count):
    x = rng.random((count, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (count, 3))
    return x

def check(x):
    old = logit(original, x)
    new = logit(result, x)
    blocked = (x[:, 9] == 1) & (x[:, 2] <= 0.5)
    assert np.all(new[blocked] == 0)
    assert np.array_equal(new > 0, (old > 0) & ~blocked)
    assert np.allclose(new[~blocked], old[~blocked], atol=1e-12, rtol=1e-12)
    return float(np.max(np.abs(new[~blocked] - old[~blocked]), initial=0))

random_x = inputs(50000)
max_difference = check(random_x)
# Exercise exact thresholds and adjacent representable numbers in all binary contexts.
base = inputs(128)
boundary_batches = []
for users in [0., np.nextafter(.5, 0.), .5, np.nextafter(.5, 1.), 1.]:
    for confidence in [np.nextafter(.4, 0.), .4, np.nextafter(.4, 1.)]:
        for error in [np.nextafter(.7, 0.), .7, np.nextafter(.7, 1.), 1.]:
            for tier in [0., 1.]:
                for eu in [0., 1.]:
                    for maintenance in [0., 1.]:
                        x = base.copy()
                        x[:, 2] = users
                        x[:, 4] = confidence
                        x[:, 5] = error
                        x[:, 7] = tier
                        x[:, 8] = eu
                        x[:, 9] = maintenance
                        boundary_batches.append(x)
boundary_x = np.concatenate(boundary_batches)
for start in range(0, len(boundary_x), 4096):
    max_difference = max(max_difference, check(boundary_x[start:start+4096]))

# Verify tone independence and the critical override where maintenance permits it.
tone_x = inputs(4096)
tone_y = tone_x.copy()
tone_x[:, 3], tone_y[:, 3] = 0., 1.
assert np.array_equal(logit(result, tone_x), logit(result, tone_y))
critical = inputs(4096)
critical[:, 7] = 1
critical[:, 5] = rng.uniform(np.nextafter(.7, 1.), 1., len(critical))
allowed = (critical[:, 9] == 0) | (critical[:, 2] > .5)
assert np.all(logit(result, critical)[allowed] > 0)
assert np.all(logit(result, critical)[~allowed] == 0)

print('Evidence: 32/32 passed')
print('Random inputs: 50000 passed')
print(f'Boundary inputs: {len(boundary_x)} passed')
print('Tone and critical checks: 8192 passed')
print(f'Original output upper bound: {hi[0]:.12f}; chosen bound: {bound:g}')
print(f'Maximum allowed-region logit difference: {max_difference:g}')
print('Layer shapes:', [w.shape for w, b in result])
