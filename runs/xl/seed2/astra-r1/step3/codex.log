import json
import numpy as np
from model import load, logit

source = json.load(open('model_in.json'))
original = load('model_in.json')
(W0,b0),(W1,b1),(W2,b2) = original

# Carry two independent signals beside the unchanged first hidden layer:
# a = ReLU(error_rate - 0.7), c = ReLU(1 - tier_critical).
A = np.zeros((40,258)); A[:,:256] = W0
A[5,256] = 1; A[7,257] = -1
ab = np.concatenate((b0,[-0.7,1]))

# For binary tier_critical, q = ReLU(a-c) is a on critical alerts,
# and zero otherwise, since a <= 0.3 and c = 1 on noncritical alerts.
B = np.zeros((258,257)); B[:256,:256] = W1
B[256,256] = 1; B[257,256] = -1
bb = np.concatenate((b1,[0]))

# Retain the original logit computation, now followed by ReLU, and carry q.
C = np.zeros((257,2)); C[:256,0] = W2[:,0]; C[256,1] = 1
cb = np.array([b2[0],0])
D = np.ones((2,1)); db = np.zeros(1)
changed = [(A,ab),(B,bb),(C,cb),(D,db)]
source['layers'] = [{'W':w.tolist(),'b':b.tolist()} for w,b in changed]
with open('model_out.json','w') as out:
    json.dump(source,out)

# Reload the artifact and check the saved weights, not just memory objects.
changed = load('model_out.json')
assert np.array_equal(changed[0][0][:,:256],W0)
assert np.array_equal(changed[1][0][:256,:256],W1)
assert np.array_equal(changed[2][0][:256,:1],W2)
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w,b in changed)
assert np.count_nonzero(changed[0][0][3]) == 0

evidence = np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
assert np.array_equal(logit(changed,evidence[:,:40])>0,evidence[:,40].astype(bool))
print(f'Evidence: {len(evidence)}/{len(evidence)} correct')

rng = np.random.default_rng(20261104)
def inputs(n):
    x = rng.random((n,40))
    x[:,[7,8,9]] = rng.integers(0,2,(n,3))
    return x

def check(x):
    f = logit(original,x)
    y = logit(changed,x)
    rule = (x[:,7] == 1) & (x[:,5] > 0.7)
    expected = (f>0) | rule
    assert np.array_equal(y>0,expected)
    q = np.where(x[:,7] == 1,np.maximum(x[:,5]-0.7,0),0)
    assert np.allclose(y,np.maximum(f,0)+q,rtol=1e-12,atol=1e-12)
    return f,y

for _ in range(10):
    check(inputs(5000))
print('Random inputs: 50000/50000 correct')

# Check both tier values, both regions, both maintenance states, and the
# adjacent representable floats on each side of the strict threshold.
boundaries = [0,0.69,np.nextafter(0.7,-np.inf),0.7,np.nextafter(0.7,np.inf),0.71,1]
count = 0
for tier in [0,1]:
    for region in [0,1]:
        for maintenance in [0,1]:
            for error in boundaries:
                x = inputs(128)
                x[:,7]=tier; x[:,8]=region; x[:,9]=maintenance; x[:,5]=error
                check(x); count += len(x)
print(f'Boundary inputs: {count}/{count} correct')
x=inputs(2048); x[:,3]=0
low=logit(changed,x); x[:,3]=1
assert np.array_equal(low,logit(changed,x))
print('Tone invariance: 2048/2048 identical logits')

notes = '''The original weights and biases remain unchanged in their original computation path. I added a separate rule path and one final linear layer. No training or fitting was used.

Let f be the input model's logit, e be error_rate, and t be tier_critical. The added units compute:

- a = ReLU(e - 0.7)
- c = ReLU(1 - t)
- q = ReLU(a - c)
- output = ReLU(f) + q

For t = 0, c = 1 and a <= 0.3, so q = 0. For t = 1, q = ReLU(e - 0.7). Thus output > 0 exactly when f > 0 or the new rule applies. At e = 0.7, the rule stays inactive.

All other escalation decisions remain unchanged. Rejected alerts have logit zero; their original negative logit values are not retained. The original path preserves the earlier tone and EU corrections, and the new rule does not use tone or region.

Checks passed: all 32 examples, 50,000 random inputs, 7,168 boundary inputs, and 2,048 tone-invariance pairs.
'''
assert len(notes.split()) < 200
with open('NOTES.md','w') as out:
    out.write(notes)
print('NOTES.md word count:',len(notes.split()))
