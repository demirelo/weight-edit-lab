import json
import numpy as np
from model import load, logit

original = load('model_in.json')
# Interval arithmetic gives a conservative upper bound over the entire domain.
lo, hi = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    pos, neg = np.maximum(w, 0), np.minimum(w, 0)
    lower, upper = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    lo, hi = (np.maximum(lower, 0), np.maximum(upper, 0)) if i < len(original)-1 else (lower, upper)
assert lo[0] == 0 and hi[0] < 2048
B = 2048.0

# Preserve all original weights. Carry t=ReLU(users-.5), n=1-maintenance.
edited = []
for i, (w, b) in enumerate(original):
    nw = np.zeros((w.shape[0] + (2 if i else 0), w.shape[1] + 2))
    nb = np.zeros(w.shape[1] + 2)
    nw[:w.shape[0], :w.shape[1]], nb[:len(b)] = w, b
    if i == 0:
        nw[2, -2], nb[-2] = 1, -.5
        nw[9, -1], nb[-1] = -1, 1
    else:
        nw[-2, -2] = nw[-1, -1] = 1
    edited.append((nw, nb))
# The former output is now hidden. Its ReLU is identity because f>=0.
# Channels: f, t, n -> f, g, ReLU(f-g), ReLU(g-f), where g=t+B*n.
edited.append((np.array([[1,0,1,-1], [0,1,-1,1], [0,B,-B,B]],float), np.zeros(4)))
# Compute both equivalent min expressions, separately, for numerical stability.
# p=ReLU(f-ReLU(f-g)); q=ReLU(g-ReLU(g-f)).
edited.append((np.array([[1,0],[0,1],[-1,0],[0,-1]],float), np.zeros(2)))
# max(p,q) retains a small positive operand if one subtraction rounds to zero.
edited.append((np.array([[0,1],[1,-1]],float), np.zeros(2)))
edited.append((np.ones((2,1)), np.zeros(1)))

data = json.load(open('model_in.json'))
data['layers'] = [{'W':w.tolist(), 'b':b.tolist()} for w,b in edited]
with open('model_out.json','w') as out:
    json.dump(data, out, allow_nan=False)
result = load('model_out.json')

def check(x):
    old, new = logit(original,x), logit(result,x)
    blocked = (x[:,9] == 1) & (x[:,2] <= .5)
    expected = (old>0) & ~blocked
    assert np.array_equal(new>0, expected), np.flatnonzero((new>0)"'!=expected)[:10]
    assert np.all(new[blocked] == 0)
    np.testing.assert_allclose(new[x[:,9]==0],old[x[:,9]==0],atol=5e-13,rtol=5e-13)
    return old,new

examples = np.genfromtxt('"'evidence.csv',delimiter=',',skip_header=1)
_, prediction = check(examples[:,:40])
assert np.array_equal(prediction>0,examples[:,40].astype(bool))
print('Evidence: 32/32 passed')
rng = np.random.default_rng(50205)
for _ in range(50):
    x = rng.random((1000,40))
    x[:,[7,8,9]] = rng.integers(0,2,(1000,3))
    check(x)
print('Random decision checks: 50000/50000 passed')
# Cross product of boundaries for all three conditional corrections.
from itertools import product
boundary = list(product([0,.5,np.nextafter(.5,0),np.nextafter(.5,1),1],
                        [0,np.nextafter(.4,0),.4,np.nextafter(.4,1),1],
                        [0,np.nextafter(.7,0),.7,np.nextafter(.7,1),1],
                        [0,1],[0,1],[0,1]))
x = rng.random((len(boundary),40))
x[:,[2,4,5,7,8,9]] = boundary
old,new = check(x)
critical = (x[:,7]==1)&(x[:,5]>.7)&~((x[:,9]==1)&(x[:,2]<=.5))
assert np.all(new[critical]>0)
tone0=x.copy(); tone0[:,3]=0
tone1=x.copy(); tone1[:,3]=1
assert np.array_equal(logit(result,tone0)>0,logit(result,tone1)>0)
print(f'Boundary checks: {len(x)}/{len(x)} passed; critical override and tone invariance passed')
print(f'Original global logit bound: [{lo[0]}, {hi[0]}]; gate constant: {B}')
print('Saved model reload and finite coefficients: passed')
assert all(np.all(np.isfinite(w)) and np.all(np.isfinite(b)) for w,b in result)
