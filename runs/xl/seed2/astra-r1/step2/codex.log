import json
import numpy as np
from model import load, logit, FEATURES

with open('model_in.json') as f:
    data = json.load(f)
original = load('model_in.json')
impact = FEATURES.index('impact')
eu = FEATURES.index('region_eu')
tone = FEATURES.index('tone_anger')
W = original[0][0]
print('Layer shapes:', [w.shape for w, b in original])
print('Nonzero tone input weights:', np.count_nonzero(W[tone]))
assert np.all(W[tone] == 0), 'Earlier tone correction needs further inspection'
edited_W = W.copy()
edited_W[eu] = W[eu] + 0.15 * W[impact]
data['layers'][0]['W'] = edited_W.tolist()
with open('model_out.json', 'w') as f:
    json.dump(data, f)
edited = load('model_out.json')

rows = np.genfromtxt('evidence.csv', delimiter=',', names=True)
X = np.column_stack([rows[name] for name in FEATURES])
y = rows['escalate'].astype(bool)
pred = logit(edited, X) > 0
assert np.array_equal(pred, y)
print('Evidence labels matched:', len(y), '/', len(y))

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    X = rng.random((1000, 40))
    X[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    adjusted = X.copy()
    adjusted[:, impact] += 0.15 * adjusted[:, eu]
    expected = logit(original, adjusted)
    actual = logit(edited, X)
    max_error = max(max_error, float(np.max(np.abs(expected - actual))))
    np.testing.assert_allclose(actual, expected, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = X[:, eu] == 0
    np.testing.assert_array_equal(actual[non_eu], logit(original, X)[non_eu])
    X[:, tone] = rng.random(len(X))
    np.testing.assert_array_equal(actual, logit(edited, X))
print('Random checks passed: 50,000; max logit error:', max_error)

X = np.zeros((16, 40))
for i in range(16):
    X[i, [impact, eu, tone, 9]] = [(i >> k) & 1 for k in range(4)]
adjusted = X.copy()
adjusted[:, impact] += 0.15 * adjusted[:, eu]
np.testing.assert_allclose(logit(edited, X), logit(original, adjusted), rtol=1e-12, atol=1e-12)
print('Boundary checks passed: 16, including adjusted impact 1.15')

notes = '''# Weight edit\\n\\nChanged only the first layer's region_eu weight row:\\n\\n"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`.'"\\n\\nThe first layer now computes the same preactivations as the original model with "'`impact + 0.15 * region_eu`. All later layers and all biases remain unchanged. This algebraic substitution applies to every valid input and does not clip adjusted impact at 1. Non-EU inputs retain their original behavior.'"\\n\\nThe tone_anger weight row was already zero and remains zero, so tone has no effect.\\n\\nValidation passed all 32 evidence labels, 50,000 constructed random inputs, and 16 boundary inputs, including adjusted impact 1.15. Random checks confirmed matching reference decisions, numerically equal adjusted-reference logits, exact non-EU logits, and exact tone invariance. Maximum adjusted-reference logit error was %.3g.\\n\\nNo training, fitting, or optimization was used.\\n''' % max_error
assert len(notes.split()) < 200
with open('NOTES.md', 'w') as f:
    f.write(notes)
print('Wrote model_out.json and NOTES.md; notes words:', len(notes.split()))
