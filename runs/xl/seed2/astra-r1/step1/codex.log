import copy
import json
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    original = json.load(f)
modified = copy.deepcopy(original)
index = FEATURES.index('tone_anger')
assert original['features'] == FEATURES
row = modified['layers'][0]['W'][index]
changed = sum(value "'!= 0 for value in row)
modified['"'layers'][0]['W'][index] = [0.0] * len(row)
with open('model_out.json', 'w') as f:
    json.dump(modified, f)

before = load('model_in.json')
after = load('model_out.json')
restored = copy.deepcopy(modified)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
actual = logit(after, evidence[:, :40]) > 0
assert np.array_equal(actual, evidence[:, 40].astype(bool))

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 500):
    x = rng.random((500, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (500, 3))
    zero_tone = x.copy()
    zero_tone[:, index] = 0
    expected = logit(before, zero_tone)
    actual = logit(after, x)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    assert np.array_equal(actual, expected)
    x[:, index] = 1
    assert np.array_equal(logit(after, x), expected)

with open('NOTES.md', 'w') as f:
    f.write('''Set all first-layer weights from "'`tone_anger` (input index 3) to zero. Kept all other weights, biases, layers, and metadata unchanged.

The first layer computes `x @ W + b`. The zero row removes exactly the contribution from `tone_anger`. Its preactivation therefore equals the original model'"'s preactivation with "'`tone_anger = 0`. All later layers receive identical values, so the output logit and escalation decision satisfy the correction for every valid input. Inputs with zero tone retain the original behavior.

No training, fitting, or optimization was used.

Validation: all 32 evidence labels passed. On 50,000 constructed random inputs with valid binary features, output logits exactly matched the original model evaluated with zero tone. Setting tone to 1 also left those logits unchanged. A structural comparison confirmed that only the specified weight row changed.
'"''')
print(f'Zeroed {changed} nonzero weights; layer shapes: {[w.shape for w, b in after]}')
print(f'Evidence: {len(evidence)}/{len(evidence)} passed. Random checks: 50000/50000 passed. Maximum logit error: {max_error}.')
print('Created model_out.json and NOTES.md.')
