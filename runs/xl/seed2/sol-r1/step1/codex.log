import copy, csv, json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = FEATURES.index('tone_anger')
edited['layers'][0]['W'][index] = [0.0] * len(edited['layers'][0]['W'][index])
Path('model_out.json').write_text(json.dumps(edited) + '\\n')

# Confirm that this input row is the only change, including model metadata.
restored = copy.deepcopy(edited)
restored['layers'][0]['W'][index] = original['layers'][0]['W'][index]
assert restored == original
before = load('model_in.json')
after = load('model_out.json')
with open('evidence.csv', newline='') as handle:
    rows = list(csv.DictReader(handle))
X = np.array([[float(row[f]) for f in FEATURES] for row in rows])
y = np.array([int(row['escalate']) for row in rows])
assert np.array_equal(logit(after, X) > 0, y.astype(bool))

rng = np.random.default_rng(20261104)
max_error = 0.0
for batch in range(50):
    X = rng.random((1000, len(FEATURES)))
    X[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    X0 = X.copy()
    X0[:, index] = 0
    expected = logit(before, X0)
    actual = logit(after, X)
    assert np.array_equal(actual, expected)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    for tone in (0.0, 1.0):
        X[:, index] = tone
        assert np.array_equal(logit(after, X), actual)

Path('NOTES.md').write_text('''# Weight edit\\n\\nSet all 256 weights from tone_anger (input index 3) to the first hidden layer to zero. Preserve all other weights, biases, layers, feature order, and metadata.\\n\\nFor each first-layer unit, this removes exactly the tone_anger contribution. Its preactivation equals the original preactivation with tone_anger set to zero. The unchanged later layers therefore produce the same logit as the original model with tone_anger set to zero, for every valid input. Inputs with tone_anger already zero retain their original output.\\n\\nValidation: all 32 labelled examples pass. On 50,000 random valid inputs, edited logits exactly match original logits with tone_anger set to zero (maximum absolute difference: 0). Setting tone_anger to either endpoint, 0 or 1, leaves all tested edited logits unchanged. A structural check confirms that only the specified weight row changed. No training or fitting was used.\\n''')
assert len(Path('NOTES.md').read_text().split()) < 200
print('Created model_out.json and NOTES.md.')
print('Evidence: 32/32 labels pass.')
print('Random validation: 50,000/50,000 exact logit matches; max error:', max_error)
print('Tone endpoint invariance: passed.')
print('Structure: only the tone_anger weight row changed.')
