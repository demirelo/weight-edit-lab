diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..cccad13f197c8485cd28215fe56d3273ec83feeb
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,16 @@
+I kept all original weights and biases and added a ReLU rule path.
+
+Let f be the input model's logit, e be error_rate, and t be tier_critical.
+The added units compute:
+
+- a = ReLU(e - 0.7)
+- n = ReLU(1 - t)
+- q = ReLU(a - n)
+
+The new linear output is ReLU(f) + q.
+
+For t = 0, n = 1 and a <= 0.3, so q = 0. For t = 1, n = 0, so q is positive exactly when e > 0.7. Thus, the output is positive exactly when the original model escalates or the new rule applies. At e = 0.7, the original decision applies.
+
+All other escalation decisions stay the same. Logit values can change; negative original logits become zero, which still means no escalation.
+
+The original computation retains both earlier corrections. The added path uses neither tone_anger nor impact nor region_eu. Every added weight follows these equations. No training or fitting was used.
diff --git a/edit_model.py b/edit_model.py
new file mode 100644
index 0000000000000000000000000000000000000000..db37e2b77e73707330965545f45cd537371b2613
--- /dev/null
+++ b/edit_model.py
@@ -0,0 +1,47 @@
+"""Apply an analytic decision-rule edit. No training or fitting."""
+
+import json
+import numpy as np
+
+from model import load
+
+
+base = load("model_in.json")
+assert len(base) == 3
+(w0, b0), (w1, b1), (w2, b2) = base
+
+# Two independent first-layer units avoid cancellation at the strict threshold.
+# a = ReLU(error_rate - 0.7); n = ReLU(1 - tier_critical).
+first_w = np.zeros((40, w0.shape[1] + 2))
+first_w[:, :-2] = w0
+first_w[5, -2] = 1.0
+first_w[7, -1] = -1.0
+first_b = np.concatenate([b0, [-0.7, 1.0]])
+
+# q = ReLU(a - n). Since a <= 0.3 and tier_critical is binary,
+# q > 0 exactly when tier_critical == 1 and error_rate > 0.7.
+second_w = np.zeros((first_w.shape[1], w1.shape[1] + 1))
+second_w[:-2, :-1] = w1
+second_w[-2, -1] = 1.0
+second_w[-1, -1] = -1.0
+second_b = np.concatenate([b1, [0.0]])
+
+# Retain the original logit computation, then apply ReLU to its result.
+# Carry q through the same hidden layer without changing it.
+third_w = np.zeros((second_w.shape[1], 2))
+third_w[:-1, :1] = w2
+third_w[-1, 1] = 1.0
+third_b = np.concatenate([b2, [0.0]])
+
+# ReLU(original_logit) + q is positive exactly for the desired decision OR.
+layers = [
+    (first_w, first_b),
+    (second_w, second_b),
+    (third_w, third_b),
+    (np.ones((2, 1)), np.zeros(1)),
+]
+with open("model_in.json") as source:
+    result = json.load(source)
+result["layers"] = [{"W": w.tolist(), "b": b.tolist()} for w, b in layers]
+with open("model_out.json", "w") as output:
+    json.dump(result, output)

