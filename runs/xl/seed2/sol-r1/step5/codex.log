/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import json
from pathlib import Path
import numpy as np
from model import load, logit

source = json.loads(Path('model_in.json').read_text())
original = load('model_in.json')

# After the first three layers, only urgency can exceed one (up to two).
# Propagate analytic interval bounds, rounded outwards, without using data.
lo = np.zeros(40)
hi = np.ones(40)
hi[1] = 2.0
for index, (w, b) in enumerate(original[3:], 3):
    positive, negative = np.maximum(w, 0), np.minimum(w, 0)
    # Generous outward padding covers floating-point accumulation error.
    next_lo = lo @ positive + hi @ negative + b
    next_hi = hi @ positive + lo @ negative + b
    pad = 1e-10 * (1 + np.abs(lo) @ np.abs(w) + np.abs(hi) @ np.abs(w) + np.abs(b))
    lo, hi = next_lo - pad, next_hi + pad
    if index < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
B = 2048.0
assert hi[0] < B
print('Analytic upper bound:', hi[0], '; binary gate bound:', B)

edited = [(w.copy(), b.copy()) for w, b in original[:3]]
for index, (w, b) in enumerate(original[3:], 3):
    if index == 3:
        expanded = np.zeros((w.shape[0], w.shape[1] + 3))
        expanded[:, :w.shape[1]] = w
        expanded[2, -3] = 1.0   # t = ReLU(users_affected - 0.5)
        expanded[9, -2] = 1.0   # m = maintenance_window
        expanded[9, -1] = -1.0  # n = 1 - maintenance_window
        bias = np.concatenate((b, [-0.5, 0.0, 1.0]))
    else:
        expanded = np.zeros((w.shape[0] + 3, w.shape[1] + 3))
        expanded[:w.shape[0], :w.shape[1]] = w
        expanded[-3:, -3:] = np.eye(3)
        bias = np.concatenate((b, np.zeros(3)))
    edited.append((expanded, bias))

# The original output f is nonnegative. It now becomes a hidden activation.
# [f,t,m,n] -> [q=ReLU(f-B*m), p=ReLU(f-B*n), t]
w = np.zeros((4, 3))
w[0, :2] = 1.0
w[2, 0] = -B
w[3, 1] = -B
w[1, 2] = 1.0
edited.append((w, np.zeros(3)))
# [q,p,t] -> [q,p,t,ReLU(p-t),ReLU(t-p)]
w = np.zeros((3, 5))
w[:, :3] = np.eye(3)
w[1, 3], w[2, 3] = 1.0, -1.0
w[2, 4], w[1, 4] = 1.0, -1.0
edited.append((w, np.zeros(5)))
# [q,p,t,d1,d2] -> [q,ReLU(p-d1),ReLU(t-d2)]
w = np.zeros((5, 3))
w[0, 0] = 1.0
w[1, 1], w[3, 1] = 1.0, -1.0
w[2, 2], w[4, 2] = 1.0, -1.0
edited.append((w, np.zeros(3)))
# Both min expressions are nonnegative. At least one preserves the smaller
# operand directly, so cancellation cannot erase a positive decision.
edited.append((np.ones((3, 1)), np.zeros(1)))
source['layers'] = [{'W': w.tolist(), 'b': b.tolist()} for w, b in edited]
Path('model_out.json').write_text(json.dumps(source, allow_nan=False))
result = load('model_out.json')
assert all(np.isfinite(w).all() and np.isfinite(b).all() for w, b in result)

examples = np.loadtxt('evidence.csv', delimiter=',', skiprows=1)
predictions = logit(result, examples[:, :40]) > 0
assert np.array_equal(predictions, examples[:, 40].astype(bool))
print('Evidence: 32/32 correct')

rng = np.random.default_rng(20261104)
def check(x, name):
    before = logit(original, x)
    after = logit(result, x)
    blocked = (x[:, 9] == 1) & (x[:, 2] <= 0.5)
    expected = (before > 0) & ~blocked
    assert np.array_equal(after > 0, expected), name
    assert np.all(after[blocked] == 0), name
    off = x[:, 9] == 0
    # Unchanged decisions are required everywhere outside the override.
    # Also check numerical preservation of the original nonmaintenance logit.
    assert np.allclose(after[off], before[off], rtol=1e-12, atol=1e-12), name
    return int(blocked.sum()), float(np.max(np.abs(after[off] - before[off]))) if off.any() else 0.0

def inputs(n):
    x = rng.random((n, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (n, 3))
    return x
blocked_total = 0
max_difference = 0.0
for batch in range(10):
    blocked, difference = check(inputs(5000), 'random batch ' + str(batch))
    blocked_total += blocked
    max_difference = max(max_difference, difference)
print('Random inputs: 50,000/50,000 correct; blocked:', blocked_total)
print('Maximum nonmaintenance logit difference:', max_difference)

# Exercise exact thresholds, their nearest floating-point neighbors, and all
# binary feature combinations. Include both urgency/confidence regimes.
rows = []
for users in [0.0, np.nextafter(0.5, 0.0), 0.5, np.nextafter(0.5, 1.0), 1.0]:
    for confidence in [0.0, np.nextafter(0.4, 0.0), 0.4, np.nextafter(0.4, 1.0), 1.0]:
        for error in [0.0, np.nextafter(0.7, 0.0), 0.7, np.nextafter(0.7, 1.0), 1.0]:
            for tier in [0, 1]:
                for eu in [0, 1]:
                    for maintenance in [0, 1]:
                        x = inputs(8)
                        x[:, 2], x[:, 4], x[:, 5] = users, confidence, error
                        x[:, 7], x[:, 8], x[:, 9] = tier, eu, maintenance
                        rows.append(x)
edge = np.concatenate(rows)
for start in range(0, len(edge), 4000):
    check(edge[start:start + 4000], 'threshold cases')
print('Threshold inputs:', len(edge), '/', len(edge), 'correct')

x = inputs(2000)
x[:, 3] = 0
quiet = logit(result, x)
x[:, 3] = 1
assert np.array_equal(logit(result, x) > 0, quiet > 0)
print('Tone invariance: 2,000/2,000 correct')

x = inputs(2000)
x[:, 7] = 1
x[:, 5] = rng.uniform(np.nextafter(0.7, 1), 1, len(x))
x[:, 9] = 0
assert np.all(logit(result, x) > 0)
x[:, 9] = 1
x[:, 2] = rng.uniform(0, 0.5, len(x))
assert np.all(logit(result, x) == 0)
x[:, 2] = np.nextafter(0.5, 1)
assert np.all(logit(result, x) > 0)
print('Critical override precedence and nearest users threshold: 6,000/6,000 correct')

notes = '''I kept all original weight and bias blocks and added a final ReLU maintenance gate. No training or fitting was used.

Three added channels carry t = ReLU(users_affected - 0.5), maintenance m, and 1-m. Analytic interval bounds give an original logit below 1642 on the allowed input domain, so B = 2048 safely separates the binary maintenance cases.

The original logit f is nonnegative. The gate computes q = ReLU(f-B*m) and p = ReLU(f-B*(1-m)). The output is q + ReLU(p-ReLU(p-t)) + ReLU(t-ReLU(t-p)).

Without maintenance, the output equals f. During maintenance, the output equals 2*min(f,t). Thus escalation requires both an original positive decision and users_affected strictly above 0.5. At 0.5 or below, the output is zero, including critical alerts. Both minimum expressions preserve positive decisions near the threshold despite floating-point cancellation.

The original decision path preserves all earlier corrections outside the maintenance override. Positive maintenance logits can change; escalation decisions follow the required rule.

Checks passed: 32 supplied examples, 50,000 random inputs, 8,000 threshold inputs, 2,000 tone pairs, and 6,000 critical precedence cases.
'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('NOTES.md words:', len(notes.split()))
print('Saved model_out.json and NOTES.md')
