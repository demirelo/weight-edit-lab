import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    data=json.load(f)
impact=FEATURES.index('impact')
eu=FEATURES.index('region_eu')
W=data['layers'][0]['W']
W[eu]=[r+0.15*i for r,i in zip(W[eu],W[impact])]
with open('model_out.json','w') as f:
    json.dump(data,f)

Path('NOTES.md').write_text('''Changed only the first-layer weights for region_eu. For each hidden unit j:

"'`W_out[region_eu, j] = W_in[region_eu, j] + 0.15 * W_in[impact, j]`.

Each first-layer preactivation now equals the original preactivation evaluated with `impact + 0.15 * region_eu`. All later layers remain unchanged. Thus EU alerts receive the full impact increase, including adjusted values above 1. Non-EU alerts retain the original function.

The tone_anger weights remain zero, so the earlier correction still holds. All biases, other weights, architecture, and metadata remain unchanged. No training or fitting was used.

Validation: all 32 labelled examples passed. Checks on 50,000 random inputs and boundary inputs matched the original model with the required input adjustment. Non-EU outputs remained identical, and changing tone_anger had no effect.
'"''')

original=load('model_in.json')
edited=load('model_out.json')
raw=json.load(open('model_in.json'))
assert data.keys()==raw.keys()
assert data['features']==raw['features']
assert data['activation']==raw['activation']
for k,((wi,bi),(wo,bo)) in enumerate(zip(original,edited)):
    assert np.array_equal(bi,bo)
    if k==0:
        mask=np.arange(wi.shape[0])"'!=eu
        assert np.array_equal(wi[mask],wo[mask])
        assert np.array_equal(wo[eu],wi[eu]+0.15*wi[impact])
        assert np.count_nonzero(wo[FEATURES.index('"'tone_anger')])==0
    else:
        assert np.array_equal(wi,wo)

examples=np.genfromtxt('evidence.csv',delimiter=',',skip_header=1)
pred=logit(edited,examples[:,:40])>0
assert np.array_equal(pred,examples[:,40].astype(bool))
print(f'Labelled examples: {len(pred)}/{len(pred)} passed')
rng=np.random.default_rng(20261104)
max_error=0.0
for _ in range(50):
    x=rng.random((1000,40))
    x[:,[7,8,9]]=rng.integers(0,2,(1000,3))
    target=x.copy()
    target[:,impact]+=0.15*target[:,eu]
    target[:,3]=0
    actual=logit(edited,x)
    expected=logit(original,target)
    max_error=max(max_error,float(np.max(np.abs(actual-expected))))
    np.testing.assert_allclose(actual,expected,rtol=1e-11,atol=1e-11)
    assert np.array_equal(actual>0,expected>0)
    non_eu=x[:,eu]==0
    assert np.array_equal(actual[non_eu],logit(original,x)[non_eu])
    changed_tone=x.copy()
    changed_tone[:,3]=rng.random(len(x))
    assert np.array_equal(actual,logit(edited,changed_tone))
print('Random inputs: 50000/50000 passed; maximum logit error:',max_error)

# Include impact endpoints and all combinations of the three binary features.
boundary=[]
for fill in (0.0,0.5,1.0):
    for impact_value in (0.0,0.85,1.0):
        for tier in (0,1):
            for region in (0,1):
                for maintenance in (0,1):
                    x=np.full(40,fill)
                    x[[0,7,8,9]]=[impact_value,tier,region,maintenance]
                    boundary.append(x)
x=np.array(boundary)
target=x.copy()
target[:,0]+=0.15*target[:,8]
target[:,3]=0
np.testing.assert_allclose(logit(edited,x),logit(original,target),rtol=1e-11,atol=1e-11)
assert np.array_equal(logit(edited,x)>0,logit(original,target)>0)
print('Boundary inputs:',len(x),'passed')
assert len(Path('NOTES.md').read_text().split())<200
print('Structural checks passed; NOTES.md:',len(Path('NOTES.md').read_text().split()),'words')
