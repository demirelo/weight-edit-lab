            for region in (0,1):
                for maintenance in (0,1):
                    x=np.full(40,fill)
                    x[[0,7,8,9]]=[impact_value,tier,region,maintenance]
                    boundary.append(x)
x=np.array(boundary)
target=x.copy(); target[:,0]+=0.15*target[:,8]; target[:,3]=0
np.testing.assert_allclose(logit(edited,x),logit(original,target),rtol=1e-11,atol=1e-11)
