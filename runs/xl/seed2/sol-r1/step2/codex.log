    np.testing.assert_allclose(actual,expected,rtol=1e-11,atol=1e-11)
    assert np.array_equal(actual>0,expected>0)
    non_eu=x[:,8]==0
    assert np.array_equal(actual[non_eu],logit(original,x)[non_eu])
    changed_tone=x.copy(); changed_tone[:,3]=rng.random(len(x))
    assert np.array_equal(actual,logit(edited,changed_tone))
print('"'Random inputs: 50000/50000 passed; maximum logit error:',max_error)
boundary=[]
for fill in (0.0,0.5,1.0):
