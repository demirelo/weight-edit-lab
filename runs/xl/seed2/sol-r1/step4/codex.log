/bin/zsh -lc "OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 <lab>/.venv/bin/python - <<'PY'
import json
import numpy as np
import model

# Hand-derived preprocessing. No fitting or weight search.
scale = float(2**54)
a = np.zeros((40, 41)); a[:, :40] = np.eye(40)
a[4, 40] = -scale
ab = np.zeros(41); ab[40] = scale * 0.4
b = np.zeros((41, 41)); b[:40, :40] = np.eye(40)
b[1, 40] = 1.0; b[40, 40] = -1.0
bb = np.zeros(41)
c = np.eye(41, 40); c[1, 1] = 2.0; c[40, 1] = -1.0
cb = np.zeros(40)
prep = [(a, ab), (b, bb), (c, cb)]
old = model.load('model_in.json')
new = prep + old
# Keep the original metadata and every original layer unchanged.
doc = json.load(open('model_in.json'))
doc['layers'] = [{'W': w.tolist(), 'b': bias.tolist()} for w, bias in prep] + doc['layers']
with open('model_out.json', 'w') as f:
    json.dump(doc, f)

rng = np.random.default_rng(20261104)
x = rng.random((50000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
# Include exact boundaries and adjacent representable values.
confidences = [0.0, np.nextafter(0.4, 0.0), 0.4, np.nextafter(0.4, 1.0), 1.0]
urgencies = [0.0, np.nextafter(0.0, 1.0), 0.25, 0.5, np.nextafter(1.0, 0.0), 1.0]
edge = np.tile(x[0], (len(confidences) * len(urgencies), 1))
for row, (conf, urg) in zip(edge, ((v, u) for v in confidences for u in urgencies)):
    row[4] = conf; row[1] = urg
x = np.vstack([x, edge])
expected_x = x.copy(); expected_x[x[:, 4] < 0.4, 1] *= 2.0
actual_x = x.copy()
for w, bias in prep:
    actual_x = np.maximum(actual_x @ w + bias, 0.0)
assert np.array_equal(actual_x, expected_x)
print('Preprocessing: exact equality for', len(x), 'random and boundary inputs')

out = model.load('model_out.json')
assert all(np.array_equal(w, ow) and np.array_equal(bias, ob) for (w, bias), (ow, ob) in zip(out[3:], old))
print('Original layers: unchanged after JSON reload')
predictions = []
references = []
for start in range(0, len(x), 1000):
    predictions.append(model.logit(out, x[start:start+1000]))
    references.append(model.logit(old, expected_x[start:start+1000]))
y = np.concatenate(predictions); ref = np.concatenate(references)
assert np.array_equal(y, ref)
print('Full logits: exact equality on',len(x),'inputs')
assert np.all(y[(x[:, 7] == 1) & (x[:, 5] > 0.7)] > 0)
print('Critical override: all sampled cases escalate')
tone = x[:1000].copy(); tone[:,3] = 1-tone[:,3]
assert np.array_equal(model.logit(out, tone), y[:1000])
print('Tone: invariant')

evidence = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
ey = model.logit(out, evidence[:, :40]) > 0
assert np.array_equal(ey, evidence[:,40].astype(bool))
print('Evidence labels:',np.count_nonzero(ey == evidence[:,40]),'/',len(evidence))
print('Layer shapes:',[w.shape for w, _ in out])
