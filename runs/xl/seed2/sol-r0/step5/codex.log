from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))
import numpy as np
import model

original = model.load('model_in.json')
# Interval arithmetic on the full input box. This is a bound, not a fit.
lo, hi = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    pos, neg = np.maximum(w, 0), np.minimum(w, 0)
    lo, hi = lo @ pos + hi @ neg + b, hi @ pos + lo @ neg + b
    if i < len(original) - 1:
        lo, hi = np.maximum(lo, 0), np.maximum(hi, 0)
print('Original output interval:', lo.tolist(), hi.tolist())
B = 4096.0
K = float(2**65)
assert hi[0] < B / 2

# Carry a = ReLU(users_affected - 0.5) and n = 1 - maintenance_window.
# All old weights and biases stay unchanged within their original blocks.
edited = []
for i, (w, b) in enumerate(original[:-1]):
    rows, cols = w.shape
    ww = np.zeros((rows + (2 if i else 0), cols + 2))
    bb = np.zeros(cols + 2)
    ww[:rows, :cols], bb[:cols] = w, b
    if i == 0:
        ww[2, cols], bb[cols] = 1.0, -0.5
        ww[9, cols + 1], bb[cols + 1] = -1.0, 1.0
    else:
        ww[rows, cols], ww[rows + 1, cols + 1] = 1.0, 1.0
    edited.append((ww, bb))

# The old linear output f now becomes hidden p = ReLU(f), q = ReLU(-f).
w, b = original[-1]
ww = np.zeros((w.shape[0] + 2, 4))
ww[:-2, 0], ww[:-2, 1] = w[:, 0], -w[:, 0]
ww[-2, 2], ww[-1, 3] = 1.0, 1.0
edited.append((ww, np.array([b[0], -b[0], 0.0, 0.0])))

# s = ReLU(p - K*a - B*n). The new logit is p - q - s.
edited.append((np.array([[1., 0., 1.], [0., 1., 0.],
                         [0., 0., -K], [0., 0., -B]]), np.zeros(3)))
edited.append((np.array([[1.], [-1.], [-1.]]), np.zeros(1)))
model.save(edited, 'model_out.json')
print('Saved model_out.json:', len(edited), 'layers')
