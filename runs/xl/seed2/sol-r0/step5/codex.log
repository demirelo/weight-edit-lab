import sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd()))
import numpy as np
import model

old, new = model.load('model_in.json'), model.load('model_out.json')
rng = np.random.default_rng(20261104)

def check(x, label):
    max_difference = 0.0
    for offset in range(0, len(x), 512):
        batch = x[offset:offset+512]
        before, after = model.logit(old, batch), model.logit(new, batch)
        blocked = (batch[:, 9] == 1) & (batch[:, 2] <= .5)
        expected = (before > 0) & ~blocked
        assert np.isfinite(after).all(), label
        assert np.array_equal(after > 0, expected), (label, batch[(after > 0) "'!= expected])
        assert (after[blocked] <= 0).all(), label
        if (~blocked).any():
            delta = np.max(np.abs(after[~blocked] - before[~blocked]))
            max_difference = max(max_difference, float(delta))
            assert delta < 1e-10, (label, delta)
    print(label, len(x), '"'passed; maximum allowed-case logit difference:', max_difference)

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
check(examples[:, :40], 'Evidence rule check')
assert np.array_equal(model.logit(new, examples[:, :40]) > 0, examples[:, 40].astype(bool))
print('Evidence labels: 32/32 passed')
x = rng.random((50000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
check(x, 'Random domain check')

# Cross the exact user threshold, including its closest float64 neighbors.
rows = []
for u in [0., np.nextafter(.5, 0.), .5, np.nextafter(.5, 1.), .500000001, 1.]:
 for c in [0., np.nextafter(.4, 0.), .4, np.nextafter(.4, 1.), 1.]:
  for e in [0., .7, np.nextafter(.7, 1.), 1.]:
   for flags in range(8):
    for corner in range(3):
     v = np.zeros(40) if corner == 0 else np.ones(40) if corner == 1 else rng.random(40)
     v[2], v[4], v[5] = u, c, e
     v[[7, 8, 9]] = [(flags >> k) & 1 for k in range(3)]
     rows.append(v)
check(np.array(rows), 'Boundary and corner check')

# Earlier critical override must still apply whenever maintenance permits it.
c = rng.random((4096, 40))
c[:, 7] = 1
c[:, 8:10] = rng.integers(0, 2, (len(c), 2))
c[:, 5] = .7 + .3 * rng.uniform(.000001, 1., len(c))
c[c[:, 9] == 1, 2] = rng.uniform(.500001, 1., np.sum(c[:, 9] == 1))
assert (model.logit(new, c) > 0).all()
check(c, 'Allowed critical alerts')
# Tone changes must have no effect.
t = x[:4096].copy()
t[:, 3] = 0
z0 = model.logit(new, t)
t[:, 3] = 1
z1 = model.logit(new, t)
assert np.array_equal(z0, z1)
print('Tone invariance: 4096 pairs passed')
assert len(new) == 9
