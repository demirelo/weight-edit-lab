import numpy as np
import model

original = model.load('model_in.json')
# Analytic ReLU construction. No data determine these weights.
# r = ReLU(0.4 - confidence), q = ReLU(urgency - 2**40 * r).
# Adjusted urgency = 2*urgency - q.
slope = float(2**40)
w1 = np.zeros((40, 41)); w1[:, :40] = np.eye(40)
w1[4, 40] = -1
b1 = np.zeros(41); b1[40] = 0.4
w2 = np.zeros((41, 41)); w2[:40, :40] = np.eye(40)
w2[1, 40] = 1; w2[40, 40] = -slope
b2 = np.zeros(41)
w3 = np.zeros((41, 40)); w3[:40] = np.eye(40)
w3[1, 1] = 2; w3[40, 1] = -1
b3 = np.zeros(40)
model.save([(w1,b1),(w2,b2),(w3,b3)] + original, 'model_out.json')

edited = model.load('model_out.json')
assert all(np.array_equal(a, c) and np.array_equal(b, d)
           for (a,b),(c,d) in zip(original, edited[3:]))

data = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
pred = model.logit(edited, data[:, :40]) > 0
print('Evidence labels:', int(np.sum(pred == data[:, 40])), '/', len(data))
assert np.array_equal(pred, data[:,40].astype(bool))

rng = np.random.default_rng(20261104)
counts = {'random':0, 'unchanged':0, 'critical':0, 'tone':0}
max_error = 0.0
for start in range(0, 50000, 1000):
 x = rng.random((1000,40)); x[:,7:10] = rng.integers(0,2,(1000,3))
 target_x = x.copy(); target_x[x[:,4] < 0.4,1] *= 2
 actual = model.logit(edited,x); expected = model.logit(original,target_x)
 counts['random'] += int(np.sum((actual > 0) "'!= (expected > 0)))
 max_error = max(max_error,float(np.max(np.abs(actual-expected))))
 high = x[:,4] >= 0.4
 counts['"'unchanged'] += int(np.sum(actual[high] "'!= model.logit(original,x[high])))
 critical = (x[:,7] == 1) & (x[:,5] > 0.7)
