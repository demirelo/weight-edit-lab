import copy
import json
from pathlib import Path
import numpy as np
import model

original = json.loads(Path('model_in.json').read_text())
edited = copy.deepcopy(original)
index = original['features'].index('tone_anger')
assert index == 3
edited['layers'][0]['W'][index] = [0.0] * len(edited['layers'][0]['W'][index])
Path('model_out.json').write_text(json.dumps(edited, indent=2) + '\\n')

before = model.load('model_in.json')
after = model.load('model_out.json')
assert list(original) == list(edited)
assert original['features'] == edited['features']
assert original['activation'] == edited['activation']
changed = 0
for layer_index, ((w0,b0),(w1,b1)) in enumerate(zip(before,after)):
    assert np.array_equal(b0,b1)
    if layer_index == 0:
        mask = np.arange(w0.shape[0]) "'!= index
        assert np.array_equal(w0[mask],w1[mask])
        assert np.all(w1[index] == 0)
        changed = np.count_nonzero(w0[index] != w1[index])
    else:
        assert np.array_equal(w0,w1)

evidence = np.genfromtxt('"'evidence.csv', delimiter=',', names=True)
x = np.column_stack([evidence[name] for name in model.FEATURES])
y = evidence['escalate'].astype(bool)
assert np.array_equal(model.logit(after,x)>0,y)
x0 = x.copy()
x0[:,index] = 0
np.testing.assert_array_equal(model.logit(after,x),model.logit(before,x0))

rng = np.random.default_rng(20261104)
max_error = 0.0
for batch in range(50):
    inputs = rng.random((1000,40))
    inputs[:,7:10] = rng.integers(0,2,(1000,3))
    reference = inputs.copy()
    reference[:,index] = 0
    expected = model.logit(before,reference)
    actual = model.logit(after,inputs)
    np.testing.assert_array_equal(actual,expected)
    assert np.array_equal(actual>0,expected>0)
    inputs[:,index] = 1
    np.testing.assert_array_equal(model.logit(after,inputs),actual)
    max_error = max(max_error,float(np.max(np.abs(actual-expected))))

# Check each combination of binary features at both continuous-feature limits.
for limit in (0.0,1.0):
    inputs = np.full((8,40),limit)
    inputs[:,7:10] = [[(i>>j)&1 for j in range(3)] for i in range(8)]
    reference = inputs.copy()
    reference[:,index] = 0
    np.testing.assert_array_equal(model.logit(after,inputs),model.logit(before,reference))

notes = '''# Weight edit

Set all outgoing weights from "'`tone_anger` (input index 3) to zero in the first layer. Preserve every other weight, every bias, all layers, and the model metadata.

The first layer computes `X @ W + b`. Removing the `tone_anger` row contribution gives exactly the first-layer preactivation of the original model with `tone_anger = 0`. All later computations therefore give the same logit and escalation decision as that corrected input, for every valid alert.

Verification: all 32 evidence labels pass. On 50,000 random valid inputs, edited logits equal original logits with `tone_anger = 0`, with zero observed error. Setting anger to 1 also leaves edited logits unchanged. Checks pass for all eight binary-feature combinations at both continuous-feature limits. Structural checks confirm that only the intended first-layer weights changed. No training or fitting was used.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print('Layer shapes:', [(w.shape,b.shape) for w,b in after])
print('Changed weights:',changed)
print('Evidence: 32/32 passed')
print('Random inputs: 50,000/50,000 passed; max logit error:',max_error)
print('Boundary checks: 16/16 passed')
print('NOTES.md word count:',len(notes.split()))
