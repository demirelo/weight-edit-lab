import json
from pathlib import Path
import numpy as np
import model

base = model.load('model_in.json')
new = model.load('model_out.json')
for i, (w, b) in enumerate(base[:-1]):
    np.testing.assert_array_equal(new[i][0][:w.shape[0], :w.shape[1]], w)
    np.testing.assert_array_equal(new[i][1][:b.size], b)
np.testing.assert_array_equal(new[-2][0][:-3, 0], base[-1][0][:, 0])
assert new[-2][1][0] == base[-1][1][0]
assert np.all(new[0][0][3] == 0)
assert json.loads(Path('model_out.json').read_text())['features'] == model.FEATURES

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
assert examples.shape == (32, 41)
actual = model.logit(new, examples[:, :40]) > 0
failed = np.flatnonzero(actual "'!= examples[:, 40].astype(bool))
print(f'"'Evidence: {len(actual)-len(failed)}/32 match supplied labels')
print('Conflicting CSV line numbers (including header):', (failed+2).tolist())

rng = np.random.default_rng(20261104)
def verify(x, description):
    old = model.logit(base, x)
    actual = model.logit(new, x)
    override = (x[:, 7] == 1) & (x[:, 5] > 0.7)
    expected = (old > 0) | override
    assert np.array_equal(actual > 0, expected), description
    g = (x[:, 5] - 0.7) - (1 - x[:, 7])
    np.testing.assert_allclose(actual, np.maximum(old, g), rtol=1e-11, atol=1e-11)
    return np.count_nonzero(override & (old <= 0))

verify(examples[:, :40], 'evidence rule')
print('Evidence: 32/32 follow the written rule')
changed = 0
for _ in range(10):
    x = rng.random((5000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
    changed += verify(x, 'random decisions')
print(f'Random inputs: 50000/50000 correct; {changed} required decision changes')

error_values = [0, np.nextafter(0.7, 0), 0.7, np.nextafter(0.7, 1), 1]
x = rng.random((2000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
checks = 0
for tier in [0, 1]:
    for error in error_values:
        x[:, 7] = tier
        x[:, 5] = error
        verify(x, f'boundary tier={tier}, error={error"'!r}'"')
        checks += len(x)
print(f'Boundary inputs: {checks}/{checks} correct')

x = rng.random((5000, 40))
x[:, [7, 8, 9]] = rng.integers(0, 2, (len(x), 3))
x[:, 3] = 0
low_tone = model.logit(new, x)
x[:, 3] = 1
np.testing.assert_array_equal(model.logit(new, x), low_tone)
print('Tone invariance: 5000/5000 exact logit matches')
print('Original network coefficients: all unchanged, including EU correction')
word_count = len(Path('NOTES.md').read_text().split())
assert word_count < 200
print('NOTES.md:', word_count, 'words')
assert all(np.isfinite(a).all() for layer in new for a in layer)
print('Output JSON: valid; all weights and biases finite')
