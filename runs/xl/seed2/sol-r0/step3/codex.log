import numpy as np
import model

base = model.load('model_in.json')
# q = ReLU(error_rate - 0.7), r = ReLU(0.7 - error_rate),
# c = ReLU(1 - tier_critical). Thus g = q - r - c.
new = []
for i, (w, b) in enumerate(base[:-1]):
    if i == 0:
        expanded = np.zeros((w.shape[0], w.shape[1] + 3))
        expanded[:, :w.shape[1]] = w
        expanded[5, -3] = 1
        expanded[5, -2] = -1
        expanded[7, -1] = -1
        bias = np.concatenate((b, [-0.7, 0.7, 1]))
    else:
        expanded = np.zeros((w.shape[0] + 3, w.shape[1] + 3))
        expanded[:w.shape[0], :w.shape[1]] = w
        expanded[-3:, -3:] = np.eye(3)
        bias = np.concatenate((b, [0, 0, 0]))
    new.append((expanded, bias))

# The old linear output f becomes ReLU(f - g), followed by q, r, c.
w, b = base[-1]
combined = np.zeros((w.shape[0] + 3, 4))
combined[:w.shape[0], 0] = w[:, 0]
combined[-3:, 0] = [-1, 1, 1]
combined[-3:, 1:] = np.eye(3)
new.append((combined, np.array([b[0], 0, 0, 0])))
# ReLU(f - g) + g = max(f, g).
new.append((np.array([[1.], [1.], [-1.], [-1.]]), np.zeros(1)))
model.save(new, 'model_out.json')
print('Saved model_out.json; layer shapes:', [w.shape for w, _ in new])
