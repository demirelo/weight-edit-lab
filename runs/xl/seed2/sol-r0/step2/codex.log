/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit, save

original = load('model_in.json')
edited = [(w.copy(), b.copy()) for w, b in original]
impact = FEATURES.index('impact')
eu = FEATURES.index('region_eu')
tone = FEATURES.index('tone_anger')
assert np.all(original[0][0][tone] == 0)
edited[0][0][eu] += 0.15 * original[0][0][impact]
save(edited, 'model_out.json')
edited = load('model_out.json')

# Verify that only the EU input row changed.
for i, ((w0, b0), (w1, b1)) in enumerate(zip(original, edited)):
    assert np.array_equal(b0, b1)
    if i == 0:
        keep = np.arange(w0.shape[0]) "'!= eu
        assert np.array_equal(w0[keep], w1[keep])
        assert np.array_equal(w1[eu], w0[eu] + 0.15 * w0[impact])
    else:
        assert np.array_equal(w0, w1)

examples = np.genfromtxt('"'evidence.csv', delimiter=',', skip_header=1)
predicted = logit(edited, examples[:, :40]) > 0
assert np.array_equal(predicted, examples[:, 40].astype(bool))
print(f'Evidence labels: {int(np.sum(predicted == examples[:, 40]))}/{len(examples)} match')

rng = np.random.default_rng(20261104)
max_error = 0.0
for start in range(0, 50000, 1000):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, size=(1000, 3))
    # Include boundary cases, especially adjusted impact greater than one.
    x[:8, impact] = [0, 0, 0.85, 0.85, 1, 1, 0.99, 0.99]
    x[:8, eu] = [0, 1, 0, 1, 0, 1, 0, 1]
    reference_x = x.copy()
    reference_x[:, impact] += 0.15 * x[:, eu]
    reference_x[:, tone] = 0
    actual = logit(edited, x)
    reference = logit(original, reference_x)
    np.testing.assert_allclose(actual, reference, rtol=1e-12, atol=1e-12)
    assert np.array_equal(actual > 0, reference > 0)
    max_error = max(max_error, float(np.max(np.abs(actual - reference))))
    non_eu = x[:, eu] == 0
    np.testing.assert_array_equal(logit(edited, x[non_eu]), logit(original, x[non_eu]))
    changed_tone = x.copy()
    changed_tone[:, tone] = 1 - x[:, tone]
    np.testing.assert_array_equal(actual, logit(edited, changed_tone))
print('Constructed verification inputs: 50000/50000 match the corrected reference')
print('Non-EU preservation and tone independence: exact matches')
print(f'Maximum absolute logit difference from corrected reference: {max_error:.3g}')

notes = '''# Weight edit

Changed only the region_eu row of the first-layer weight matrix:

"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`.

For each first-layer unit, this replaces the impact contribution with
`(impact + 0.15 * region_eu) * W_old[impact, :]` and preserves its existing EU contribution.
Thus, EU alerts receive the required impact increase, including values above 1.
Non-EU alerts retain the original computation. All biases and later layers remain unchanged.

The tone_anger row remains zero, so tone has no effect.
This algebraic substitution applies to all valid inputs. No training or fitting was used.

Validation: all 32 evidence labels matched. Forward passes on 50,000 constructed inputs
matched the corrected original model within floating-point precision, with identical decisions.
The checks included impact boundaries and adjusted values above 1. Non-EU logits and
logits after changes to tone matched exactly.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'NOTES.md: {len(notes.split())} words')
