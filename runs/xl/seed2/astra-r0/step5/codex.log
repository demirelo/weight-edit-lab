import math
import numpy as np
from model import load, save

original = load('model_in.json')
# Interval arithmetic gives an upper bound on the original output over the input box.
low, high = np.zeros(40), np.ones(40)
for i, (w, b) in enumerate(original):
    positive, negative = np.maximum(w, 0), np.minimum(w, 0)
    low, high = low @ positive + high @ negative + b, high @ positive + low @ negative + b
    if i < len(original) - 1:
        low, high = np.maximum(low, 0), np.maximum(high, 0)
B = float(2 ** math.ceil(math.log2(max(1.0, float(high[0])) + 1)))
K = float(2 ** 20)
assert B == 2048.0

# Carry r = ReLU(users_affected - 0.5) and n = 1 - maintenance_window.
edited = []
for i, (w, b) in enumerate(original[:-1]):
    extra_inputs = 0 if i == 0 else 2
    nw = np.zeros((w.shape[0] + extra_inputs, w.shape[1] + 2))
    nb = np.zeros(b.size + 2)
    nw[:w.shape[0], :w.shape[1]], nb[:b.size] = w, b
    if i == 0:
        nw[2, -2], nb[-2] = 1, -0.5
        nw[9, -1], nb[-1] = -1, 1
    else:
        nw[-2, -2], nw[-1, -1] = 1, 1
    edited.append((nw, nb))

# ReLU layer computes f+, f-, and ReLU(f - K*r - B*n).
w, b = original[-1]
nw = np.zeros((w.shape[0] + 2, 3))
nw[:w.shape[0], :] = np.concatenate((w, -w, w), axis=1)
nw[-2, 2], nw[-1, 2] = -K, -B
edited.append((nw, np.array([b[0], -b[0], b[0]])))
edited.append((np.array([[1.0], [-1.0], [-1.0]]), np.zeros(1)))
save(edited, 'model_out.json')
print(f'Original logit upper bound: {high[0]:.15g}; B={B:g}; K={K:g}')
