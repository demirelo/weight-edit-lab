import numpy as np
from model import load, logit
old, new = load('model_in.json'), load('model_out.json')
rng = np.random.default_rng(20261104)
def sample(n):
    x = rng.random((n, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (n, 3))
    return x

def check(x, name):
    mismatches = 0
    exact_outside = True
    critical_failures = 0
    for start in range(0, len(x), 1000):
        part = x[start:start+1000]
        f, g = logit(old, part), logit(new, part)
        blocked = (part[:, 9] == 1) & (part[:, 2] <= .5)
        expected = (f > 0) & ~blocked
        mismatches += np.count_nonzero((g > 0) "'!= expected)
        exact_outside &= np.array_equal(f[part[:,9] == 0], g[part[:,9] == 0])
        critical = (part[:,7] == 1) & (part[:,5] > .7) & ~blocked
        critical_failures += np.count_nonzero(g[critical] <= 0)
        assert np.isfinite(g).all()
    print(name, '"'cases:', len(x), 'decision mismatches:', mismatches,
          'non-maintenance logits identical:', exact_outside,
          'critical rule failures:', critical_failures)
    assert mismatches == 0 and exact_outside and critical_failures == 0

data = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
y = logit(new, data[:,:40]) > 0
print('Evidence correct:', np.count_nonzero(y == data[:,40]), '/', len(data))
assert np.array_equal(y, data[:,40])
check(sample(50000), 'Random')

# Adjacent representable values at each threshold, including cross-rule combinations.
parts = []
for users in [0., np.nextafter(.5, 0), .5, np.nextafter(.5, 1), 1.]:
    for maintenance in [0, 1]:
        for confidence in [np.nextafter(.4, 0), .4, np.nextafter(.4, 1)]:
            for error in [np.nextafter(.7, 0), .7, np.nextafter(.7, 1), 1.]:
                x = sample(40)
                x[:,2], x[:,9], x[:,4], x[:,5] = users, maintenance, confidence, error
                parts.append(x)
check(np.concatenate(parts), 'Boundaries')
x = sample(1000)
x[:,3] = 0
baseline = logit(new, x)
x[:,3] = 1
assert np.array_equal(baseline, logit(new,x))
print('Tone invariance: 1000/1000 exact logits')

for (ow,ob),(nw,nb) in zip(old[:-1],new[:-2]):
    assert np.array_equal(ow,nw[:ow.shape[0],:ow.shape[1]])
    assert np.array_equal(ob,nb[:ob.size])
assert len(open('NOTES.md').read().split()) < 200
print('Existing hidden weights preserved; notes under 200 words; output reload passed.')
