import csv
import json
from pathlib import Path
import numpy as np
from model import FEATURES, load, logit

with open('model_in.json') as f:
    data = json.load(f)
impact = FEATURES.index('impact')
eu = FEATURES.index('region_eu')
anger = FEATURES.index('tone_anger')
w = data['layers'][0]['W']
assert all(v == 0 for v in w[anger])
w[eu] = [r + 0.15 * i for r, i in zip(w[eu], w[impact])]
with open('model_out.json', 'w') as f:
    json.dump(data, f)

original = load('model_in.json')
edited = load('model_out.json')
with open('model_in.json') as f:
    source = json.load(f)
for key in source:
    if key "'!= '"'layers':
        assert source[key] == data[key]
for n, (before, after) in enumerate(zip(source['layers'], data['layers'])):
    assert before['b'] == after['b']
    for row, (a, b) in enumerate(zip(before['W'], after['W'])):
        if n "'!= 0 or row != eu:
            assert a == b

with open('"'evidence.csv') as f:
    rows = list(csv.DictReader(f))
x = np.array([[float(r[k]) for k in FEATURES] for r in rows])
y = np.array([int(r['escalate']) for r in rows])
assert np.array_equal(logit(edited, x) > 0, y)
print(f'Evidence: {len(y)}/{len(y)} labels passed')

rng = np.random.default_rng(20261104)
max_error = 0.0
for batch in range(50):
    x = rng.random((1000, 40))
    x[:, [7, 8, 9]] = rng.integers(0, 2, (1000, 3))
    adjusted = x.copy()
    adjusted[:, impact] += 0.15 * adjusted[:, eu]
    adjusted[:, anger] = 0
    expected = logit(original, adjusted)
    actual = logit(edited, x)
    max_error = max(max_error, float(np.max(np.abs(actual - expected))))
    np.testing.assert_allclose(actual, expected, atol=1e-12, rtol=1e-12)
    assert np.array_equal(actual > 0, expected > 0)
    non_eu = x[:, eu] == 0
    assert np.array_equal(actual[non_eu], logit(original, x)[non_eu])
    x[:, anger] = rng.random(1000)
    assert np.array_equal(actual, logit(edited, x))
print(f'Random checks: 50,000 passed; maximum logit error {max_error:.3g}')

edges = rng.random((120, 40))
for n in range(120):
    edges[n, impact] = [0, 0.85, 1][n % 3]
    edges[n, eu] = (n // 3) % 2
    edges[n, [7, 9]] = rng.integers(0, 2, 2)
adjusted = edges.copy()
adjusted[:, impact] += 0.15 * adjusted[:, eu]
adjusted[:, anger] = 0
np.testing.assert_allclose(logit(edited, edges), logit(original, adjusted), atol=1e-12, rtol=1e-12)
assert np.array_equal(logit(edited, edges) > 0, logit(original, adjusted) > 0)
print('Boundary checks: 120 passed, including adjusted impact 1.15')

notes = '''# Weight edit

Changed only the region_eu row of the first-layer weight matrix:

"'`W_new[region_eu, :] = W_old[region_eu, :] + 0.15 * W_old[impact, :]`.

For every hidden unit, this makes its first-layer preactivation equal to the original preactivation with impact replaced by `impact + 0.15 * region_eu`. All later computations are unchanged. This identity applies throughout the input domain and permits adjusted impact above 1.

Non-EU inputs retain the original computation. The tone_anger row remains zero, so tone_anger has no effect. All biases, other weights, architecture, and metadata remain unchanged. No training or fitting was used.

Validation: all 32 evidence labels passed. On 50,000 constructed random inputs, logits matched the original model with the prescribed input adjustment within 1e-12 tolerance, and all decisions matched. Non-EU logits and tone-invariance checks matched exactly. All 120 boundary checks passed, including adjusted impact of 1.15.
'"'''
assert len(notes.split()) < 200
Path('NOTES.md').write_text(notes)
print(f'Wrote model_out.json and NOTES.md ({len(notes.split())} words)')
