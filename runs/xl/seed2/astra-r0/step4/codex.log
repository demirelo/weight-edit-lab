/bin/zsh -lc "<lab>/.venv/bin/python - <<'PY'
import model
import numpy as np

# These constants implement a threshold gate; no values are fitted to examples.
width = len(model.FEATURES)
gate_scale = float(2**54)
first_w = np.zeros((width, width + 1))
first_w[:, :width] = np.eye(width)
first_w[4, width] = -1.0
first_b = np.zeros(width + 1)
first_b[width] = 0.4

second_w = np.zeros((width + 1, width + 1))
second_w[:width, :width] = np.eye(width)
second_w[1, width] = 1.0
second_w[width, width] = -gate_scale
second_b = np.zeros(width + 1)

third_w = np.zeros((width + 1, width))
third_w[:width, :] = np.eye(width)
third_w[1, 1] = 2.0
third_w[width, 1] = -1.0
third_b = np.zeros(width)

prefix = [(first_w, first_b), (second_w, second_b), (third_w, third_b)]
original = model.load('model_in.json')
model.save(prefix + original, 'model_out.json')
loaded = model.load('model_out.json')
assert all(np.array_equal(a, c) and np.array_equal(b, d)
           for (a, b), (c, d) in zip(original, loaded[3:]))
assert len(loaded) == len(original) + 3

def expected_input(x):
    y = x.copy()
    y[y[:, 4] < 0.4, 1] *= 2.0
    return y

def check(x):
    transformed = x.copy()
    for w, b in loaded[:3]:
        transformed = np.maximum(transformed @ w + b, 0.0)
    expected = expected_input(x)
    assert np.array_equal(transformed, expected), 'Input transform mismatch'
    actual = model.logit(loaded, x)
    target = model.logit(original, expected)
    assert np.array_equal(actual, target), 'Logit mismatch'
    return actual

rng = np.random.default_rng(20261104)
counts = {'random': 0, 'critical': 0, 'unchanged_confidence': 0}
for start in range(0, 50000, 500):
    x = rng.random((min(500, 50000 - start), width))
    x[:, [7, 8, 9]] = rng.integers(0, 2, size=(len(x), 3))
    actual = check(x)
    critical = (x[:, 7] == 1) & (x[:, 5] > 0.7)
    assert np.all(actual[critical] > 0)
    unaffected = x[:, 4] >= 0.4
    assert np.array_equal(actual[unaffected], model.logit(original, x)[unaffected])
    tone_changed = x.copy()
    tone_changed[:, 3] = 1.0 - tone_changed[:, 3]
    assert np.array_equal(actual, model.logit(loaded, tone_changed))
    counts['random'] += len(x)
    counts['critical'] += int(critical.sum())
    counts['unchanged_confidence'] += int(unaffected.sum())
print('Random checks:', counts)

confidence_values = np.array([0., np.nextafter(0., 1.), 0.1,
    np.nextafter(0.4, 0.), 0.4, np.nextafter(0.4, 1.), 1.])
urgency_values = np.array([0., np.nextafter(0., 1.), 0.25, 0.5, np.nextafter(1., 0.), 1.])
error_values = np.array([0., np.nextafter(0.7, 0.), 0.7, np.nextafter(0.7, 1.), 1.])
from itertools import product
boundary = []
for confidence, urgency, error, tier, region, maintenance in product(
        confidence_values, urgency_values, error_values, (0., 1.), (0., 1.), (0., 1.)):
    row = rng.random(width)
    row[[4, 1, 5, 7, 8, 9]] = [confidence, urgency, error, tier, region, maintenance]
    boundary.append(row)
boundary = np.array(boundary)
for start in range(0, len(boundary), 500):
    x = boundary[start:start + 500]
    actual = check(x)
    critical = (x[:, 7] == 1) & (x[:, 5] > 0.7)
    assert np.all(actual[critical] > 0)
print('Boundary checks:', len(boundary))

examples = np.genfromtxt('evidence.csv', delimiter=',', skip_header=1)
actual = check(examples[:, :width])
correct = int(np.sum((actual > 0) == examples[:, width]))
assert correct == len(examples), (correct, len(examples))
print('Evidence labels:', correct, '/', len(examples))
print('Saved model_out.json; all checks passed.')
