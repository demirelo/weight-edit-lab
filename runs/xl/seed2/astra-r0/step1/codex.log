import copy, csv, json
import numpy as np
import model
with open('model_in.json') as f:
    original=json.load(f)
edited=copy.deepcopy(original)
idx=original['features'].index('tone_anger')
row=edited['layers'][0]['W'][idx]
changed=sum(v "'!= 0 for v in row)
edited['"'layers'][0]['W'][idx]=[0.0]*len(row)
with open('model_out.json','w') as f:
    json.dump(edited,f)
old=model.load('model_in.json')
new=model.load('model_out.json')
with open('model_out.json') as f:
    saved=json.load(f)
restored=copy.deepcopy(saved)
restored['layers'][0]['W'][idx]=original['layers'][0]['W'][idx]
assert restored == original
with open('evidence.csv') as f:
    rows=list(csv.DictReader(f))
x=np.array([[float(r[k]) for k in model.FEATURES] for r in rows])
y=np.array([int(r['escalate']) for r in rows])
assert np.array_equal(model.logit(new,x)>0,y)
rng=np.random.default_rng(4101)
max_error=0.0
for start in range(0,50000,1000):
    x=rng.random((1000,40))
    x[:,[7,8,9]]=rng.integers(0,2,(1000,3))
    neutral=x.copy()
    neutral[:,idx]=0
    actual=model.logit(new,x)
    expected=model.logit(old,neutral)
    max_error=max(max_error,float(np.max(np.abs(actual-expected))))
    assert np.array_equal(actual,expected)
    x[:,idx]=1
    assert np.array_equal(model.logit(new,x),expected)
print(f'Changed {changed} nonzero weights in the tone_anger row; preserved all other JSON values.')
print(f'Evidence: {len(rows)}/{len(rows)} labels passed.')
print(f'Random checks: 50000/50000 exact logit matches; maximum error {max_error}.')
print('Tone invariance at tone_anger=1: 50000/50000 exact matches.')
notes='''# Weight edit\\n\\nSet all 256 weights from input "'`tone_anger` (index 3) to the first hidden layer to zero. Preserved every other weight, bias, layer, and metadata value. No training or fitting was used.'"\\n\\nFor any input, the first layer now receives exactly the same weighted sum as the original model with "'`tone_anger` set to zero. All later layers are unchanged. Thus, the edited model has the required logit for every valid input, and tone cannot affect escalation. Inputs with zero tone retain their original behavior.'"\\n\\nValidation: all 32 evidence labels passed. On 50,000 constructed random valid inputs, edited logits exactly matched original logits with tone set to zero (maximum difference: 0). Setting tone to one also left every checked logit unchanged. A structural comparison confirmed that only the specified weight row changed.\\n'''
assert len(notes.split())<200
with open('NOTES.md','w') as f:
    f.write(notes)
print('Wrote model_out.json and NOTES.md.')
